#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_mathfis
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=08:00:00
#PBS -o /scratch/weiliu87/logs/onereplay/
#
# =============================================================================
# NUS Hopper (PBS + Singularity): 采集 F_math（数学域的对角经验 Fisher）
#   EWC 数学线的第一步。本脚本**只**采 F_math，不混合、不训练、不扫 λ。
#
# -----------------------------------------------------------------------------
# 为什么不采 F_if
#   ${IF_FISHER} 已经存在（作业 2944210），就是跑出 IF 线 cs_ewc_lam3e2_seed1 的
#   那一份：20,000 行，mean magnitude 9.98e-2，池指纹与 C_if 一致。
#   复用它不是为了省 18 分钟，是为了可比性。C_mix 的构成是
#       C_if  : FLAN 20k gold target, max_len 512,  右截断（01 号没传 truncation_side）
#       C_math: MetaMath 自蒸馏,      max_len 2048, 左截断（31 号显式传了）
#   只要 F_mix 用「现有 F_if + 本脚本的 F_math」，F_mix 里每一处不对称都精确镜像
#   C_mix 里已有的同一处，EWC vs OneReplay 就只差「哪个矩阵」这一个变量。
#   反之把 F_if 重采成 512 左截断，它会比 C_if 更「干净」，差异里就混进了协议差。
#
# -----------------------------------------------------------------------------
# 采集参数必须逐字对齐 31 号 Step2 的 collect_cov，不只是 max_len
#   collect_fisher 有三个默认值与 31 号不同，且都不会报错：
#     --truncation_side   31 号 left        默认空（跟随 tokenizer = 右）
#     --require_target    31 号 1           默认 0
#     --sample_shuffle    31 号 0           默认 1
#   本脚本把三个都显式传上。2048 下 MetaMath 最长 2008，右截断其实不触发，但传上
#   才是「与 C_math 同协议」，而且与训练期的左截断一致。
#   其余对齐项：自蒸馏 glob（canonical + rephrased 两个视角一起读，不是原始
#   MetaMath 池）、inputs/targets 列名、chat template、max_samples 0（全池）、
#   q_proj,v_proj、use_bf16 0。
#
#   thinking：collect_fisher 没有 --enable_thinking / --concat_prompt_target，但
#   example_to_prompt_text 用的是 getattr(args, "enable_thinking", 0) == 1，缺参数
#   时等于 0，与 31 号定稿的 THINKING=0 一致。将来要采 thinking 版本的 F，得先给
#   collect_fisher 补这两个开关。
#
# -----------------------------------------------------------------------------
# 为什么 batch_size 不可配（也不出现在下面）
#   Fisher 要 per-example 梯度：先平方再累加。梯度累积算的是 (Σg)² 而不是 Σg²，
#   会静默估成另一个矩阵。collect_fisher.py 把 batch_size 写死为 1。
#
# 成本
#   F_if 实测 55 ms/条、平均总长约 110 token。MetaMath 自蒸馏平均总长 425 token、
#   25,114 行，外推 **约 1.5-2.5 h**。显存不紧张：select_target_weights 已把非目标
#   参数的 requires_grad 关掉（这也是 F_if 只花 18 min 的原因），qv 档累加器
#   0.66 GiB 放 GPU，fp32 模型 6.9 GB，2048 token 的 fp32 logits 约 1.2 GB。
#   collect_fisher 不支持断点续跑，所以 walltime 给到 8 h 一次跑完。
#
# 采完要看的三个诊断（Step 2 会打印并断言）
#   zero_supervision_rows  必须是 0。F_if 有 1,408 行（7.04%）因右截断吃掉回答而
#                          贡献 0；F_math 在 2048 左截断下不该有任何一行如此。
#                          这一项非 0 基本等于 truncation_side 没传上。
#   ess_ratio              F_if 只有 2,547/20,000 = 0.127，即那份 F 实际只靠 ~2.5k
#                          条样本。F_math 的长度分布更集中，应该更好；两域 ESS 不
#                          对等这件事要写进结果。
#   prompt_prefix_mismatches  Qwen3 模板在 add_generation_prompt=True 时会插入空的
#                          <think></think>，若与完整渲染对不上，mask 会退化成更短的
#                          前缀，导致部分 prompt token 被当成 supervised、F 虚高。
#                          应接近 0。
#
#   还会打印 mean(F_math)/mean(F_if) 的实测比值。F 是序列求和（reduction="sum"），
#   mean(F) ∝ T^a、a∈[1,2]，按 24.1 vs 357.1 的 supervised token 均值预测这个比值
#   落在 15-220 倍。这个数决定后面 F_mix 的权重怎么定——C 是 token 均值所以裸的
#   0.5/0.5 就是等权，F 不是，必须先按尺度归一。本脚本只测不混。
#
# -----------------------------------------------------------------------------
# 前置条件
#   1) ${DISTILL_GLOB} = results/replay/metamath_cmath_30k_*_selfdistill_seed1.jsonl
#      （31 号 Step1 的产物，canonical + rephrased）
#   2) ${MATH_COV} = results/cov/cov_math_metamath30k_qv.pt
#      （31 号 Step2 的产物；只用来读它 metadata 里的池指纹做校验）
#   3) mkdir -p /scratch/weiliu87/logs/onereplay   # qsub 之前必须存在，且在仓库外
#
# 用法（开关都走 qsub -v，不用改文件；外层会转发进容器）
#   qsub onereplay/pbs/46_math_fisher.pbs                    # 全量采集
#   qsub -v DRY_RUN=1 onereplay/pbs/46_math_fisher.pbs       # 只跑 Step 0，几十秒纯 CPU
#   qsub -v SMOKE_ROWS=200 onereplay/pbs/46_math_fisher.pbs  # 冒烟：约 1 min，产物另存
#                                                            # _smoke200 后缀，不覆盖正式文件
#   qsub -v FORCE=1 onereplay/pbs/46_math_fisher.pbs         # 正式产物已存在时强制重采
#   默认行为：产物已存在则跳过采集，但仍跑 Step 2 自检
#
#   建议顺序：先 DRY_RUN=1 确认指纹与 C_math 对得上（这一步失败就不用往下走了），
#   再 SMOKE_ROWS=200 确认模型能加载、诊断字段都在，最后交全量。
#
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/46_math_fisher.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME RESULTS_ROOT DATASET_CACHE
    DRY_RUN FORCE SMOKE_ROWS
    SEED SAMPLE_SEED FISHER_MAXLEN TARGET_MODULES FISHER_DEVICE USE_BF16 LOG_EVERY
    VIEW_PREFIX DISTILL_DIR DISTILL_GLOB
    MATH_COV MATH_FISHER IF_FISHER
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：那会把当前 shell 替换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的采集。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

# ---- 项目路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
export HF_DATASETS_CACHE="${DATASET_CACHE}"

# ---- 开关 ----
DRY_RUN="${DRY_RUN:-0}"
FORCE="${FORCE:-0}"
# >0 只取前 N 行做冒烟测试。产物另存 _smoke 后缀，且指纹不匹配只警告不中断
# （截了行的池当然和 C_math 的指纹不同）。
SMOKE_ROWS="${SMOKE_ROWS:-0}"

# ---- 采集参数：与 31 号 Step2 的 collect_cov 逐字对齐 ----
SEED="${SEED:-1}"
SAMPLE_SEED="${SAMPLE_SEED:-1}"
FISHER_MAXLEN="${FISHER_MAXLEN:-2048}"     # 必须等于 31 号的 MAXLEN
TARGET_MODULES="${TARGET_MODULES:-q_proj,v_proj}"
USE_BF16="${USE_BF16:-0}"                  # fp32：梯度先被平方，bf16 的 8 位尾数会留下噪声底
FISHER_DEVICE="${FISHER_DEVICE:-cuda}"     # qv 档累加器 0.66 GiB，放 GPU
LOG_EVERY="${LOG_EVERY:-1000}"

# ---- 语料与产物 ----
VIEW_PREFIX="${VIEW_PREFIX:-metamath_cmath_30k}"
DISTILL_DIR="${DISTILL_DIR:-${RESULTS_ROOT}/replay}"
DISTILL_GLOB="${DISTILL_GLOB:-${DISTILL_DIR}/${VIEW_PREFIX}_*_selfdistill_seed${SAMPLE_SEED}.jsonl}"
MATH_COV="${MATH_COV:-${RESULTS_ROOT}/cov/cov_math_metamath30k_qv.pt}"
MATH_FISHER="${MATH_FISHER:-${RESULTS_ROOT}/fisher/fisher_math_metamath30k_qv.pt}"
IF_FISHER="${IF_FISHER:-${RESULTS_ROOT}/fisher/fisher_flan_chat_20k_qv.pt}"

# 冒烟产物换名，避免把 200 行的 F 写成正式文件
MAX_SAMPLES=0
if (( SMOKE_ROWS > 0 )); then
  MAX_SAMPLES="${SMOKE_ROWS}"
  MATH_FISHER="${MATH_FISHER%.pt}_smoke${SMOKE_ROWS}.pt"
  echo "SMOKE_ROWS=${SMOKE_ROWS}：只采前 ${SMOKE_ROWS} 行，产物 -> ${MATH_FISHER}"
fi

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
mkdir -p "$(dirname "${MATH_FISHER}")" "${DATASET_CACHE}"

echo "DISTILL_GLOB = ${DISTILL_GLOB}"
echo "MATH_COV     = ${MATH_COV}"
echo "MATH_FISHER  = ${MATH_FISHER}"
echo "IF_FISHER    = ${IF_FISHER}"
echo "max_len=${FISHER_MAXLEN} modules=${TARGET_MODULES} use_bf16=${USE_BF16} max_samples=${MAX_SAMPLES}"

# ===========================================================================
# Step 0: 前置检查（纯 CPU，几十秒）
#   语料在不在，以及本脚本选出的行是否与 C_math 看到的行逐字相同。
#   指纹对不上就说明 F 和 C 消费的旧知识不同，EWC vs OneReplay 的对比不成立，
#   所以这里直接停下，而不是烧掉两小时之后才发现。
# ===========================================================================
echo "==== Step 0: 前置检查 ===="
# glob 要留给 python 展开，这里只确认至少匹配到一个文件。
if ! compgen -G "${DISTILL_GLOB}" > /dev/null; then
  echo "缺 MetaMath 自蒸馏语料: ${DISTILL_GLOB}（31 号 Step1 的产物）"
  exit 1
fi
for f in ${DISTILL_GLOB}; do echo "  语料: ${f}"; done

FISHER_FINGERPRINT=$(python -m onereplay.scripts.check_old_knowledge_pool \
  --data_files "${DISTILL_GLOB}" --dataset_split train \
  --cache_dir "${DATASET_CACHE}" \
  --input_column inputs --target_column targets \
  --require_target 1 \
  --max_samples "${MAX_SAMPLES}" --sample_shuffle 0 --sample_seed "${SAMPLE_SEED}" \
  --label fisher_math | tail -n 1)
echo "${FISHER_FINGERPRINT}"
# 输出形如 "fisher_math rows=25114 fingerprint=abc..."
FISHER_HASH="${FISHER_FINGERPRINT##*fingerprint=}"

# 传给 Step 2 的期望指纹。留空 = 不校验（没有 C_math 或冒烟模式）。
EXPECT_FINGERPRINT=""

if [[ -f "${MATH_COV}" ]]; then
  COV_HASH="$(python -m onereplay.scripts.inspect_fisher \
    --path "${MATH_COV}" --print_meta pool_fingerprint)"
  for key in pool_rows max_len truncation_side require_target target_modules; do
    echo "  C_math ${key} = $(python -m onereplay.scripts.inspect_fisher \
      --path "${MATH_COV}" --print_meta "${key}" 2>/dev/null || echo '<未记录>')"
  done
  echo "C_math pool fingerprint = ${COV_HASH}"
  if [[ "${FISHER_HASH}" != "${COV_HASH}" ]]; then
    echo "指纹不一致:"
    echo "  fisher ${FISHER_HASH}"
    echo "  cov    ${COV_HASH}"
    if (( SMOKE_ROWS > 0 )); then
      echo "SMOKE_ROWS>0：截了行的池当然和全池指纹不同，冒烟模式下只警告。"
    else
      echo "F 与 C 必须消费同一批旧知识，否则 EWC vs OneReplay 的对比被数据差异污染。"
      echo "检查 DISTILL_GLOB / require_target / sample_shuffle / max_samples 是否与 31 号一致。"
      exit 1
    fi
  else
    echo "指纹一致: ${FISHER_HASH}"
    # Step 0 证明的是「选出来的行」一致；Step 2 再拿它比一次 F_math 里实际记下的
    # 指纹，把「采集器消费的行」也钉住。
    EXPECT_FINGERPRINT="${COV_HASH}"
  fi
else
  echo "警告: 找不到 C_math (${MATH_COV})，跳过指纹校验。"
  echo "  没有这一步就无法证明 F_math 和 C_math 看的是同一批行，出结果前要补上。"
fi

if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只做前置检查，不采集"
  echo "Job finished at: $(date)"
  exit 0
fi

if [[ "${FORCE}" != "1" && -f "${MATH_FISHER}" ]]; then
  echo "跳过采集：${MATH_FISHER} 已存在（FORCE=1 可强制重采）"
  echo "仍会跑下面的自检。"
else
  # =========================================================================
  # Step 1: 采集 F_math
  #   三个显式传上的参数就是 collect_fisher 默认值与 31 号不同的那三个：
  #   truncation_side / require_target / sample_shuffle。
  # =========================================================================
  echo "==== Step 1: collect F_math -> ${MATH_FISHER} ===="
  python -m onereplay.scripts.collect_fisher \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    --seed "${SAMPLE_SEED}" \
    --use_bf16 "${USE_BF16}" \
    --data_files "${DISTILL_GLOB}" --dataset_split train \
    --cache_dir "${DATASET_CACHE}" \
    --input_column inputs --target_column targets \
    --use_chat_template 1 --include_target_in_chat 1 \
    --require_target 1 \
    --max_samples "${MAX_SAMPLES}" \
    --sample_shuffle 0 --sample_seed "${SAMPLE_SEED}" \
    --max_len "${FISHER_MAXLEN}" \
    --truncation_side left \
    --target_modules "${TARGET_MODULES}" \
    --fisher_device "${FISHER_DEVICE}" \
    --log_every "${LOG_EVERY}" \
    --output_path "${MATH_FISHER}"
fi

# ===========================================================================
# Step 2: 自检
#   把上面那些「传错了也不报错」的参数逐条比对 F_math 里实际记下的 metadata，
#   顺带打印要写进结果的诊断。
#   --expect_zero_supervision_rows 0 是本次最该盯的一条：左截断保住的是回答结尾，
#     所以不该有任何一行没有 supervised token，非 0 基本等于 truncation_side 没传上。
#   --expect_pool_fingerprint 把 Step 0 的结论钉到采集器实际消费的行上（Step 0 校验
#     的是「选出来的行」，这里校验的是「采进去的行」）。
#   --reference 顺带打印 mean(F_math)/mean(F_if)，那个比值决定 F_mix 的权重，
#     但本脚本只测不混。
# ===========================================================================
echo "==== Step 2: 自检 ===="
python -m onereplay.scripts.inspect_fisher \
  --path "${MATH_FISHER}" \
  --expect_max_len "${FISHER_MAXLEN}" \
  --expect_truncation_side left \
  --expect_target_modules "${TARGET_MODULES}" \
  --expect_require_target 1 \
  --expect_sample_shuffle 0 \
  --expect_use_bf16 "${USE_BF16}" \
  --expect_zero_supervision_rows 0 \
  --expect_pool_fingerprint "${EXPECT_FINGERPRINT}" \
  --reference "${IF_FISHER}" \
  --strict 1

set +x
echo "========================================================================"
echo "产物: ${MATH_FISHER}"
echo "下一步（本脚本不做）:"
echo "  1) 按上面 mean(F_math)/mean(F_if) 的实测比值定 F_mix 的权重"
echo "  2) 写 onereplay/mix_fishers.py 生成 F_mix"
echo "  3) λ 必须重扫：λ=3e2 是对 mean(F_if)=9.98e-2 调的，不能直接搬"
echo "Job finished at: $(date)"
