#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N fin_cf
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# finance 线第一步：在 Qwen2.5-1.5B-Instruct base 上采三域 gold C 与对角 F
#
#   qsub -v DRY_RUN=0 onereplay/pbs/93_finance_gold_cf.pbs                 # 三域 C+F
#   qsub -v DRY_RUN=0,WHAT=cov    onereplay/pbs/93_finance_gold_cf.pbs     # 只采 C
#   qsub -v DRY_RUN=0,WHAT=fisher onereplay/pbs/93_finance_gold_cf.pbs     # 只采 F
#   qsub -v DRY_RUN=0,WHAT=fisher,DO_IF=1,DO_MATH=0,DO_CODE=0 <本脚本>      # 一次一个域
#   qsub -v DRY_RUN=0,WHAT=none   onereplay/pbs/93_finance_gold_cf.pbs     # 只跑诊断
#   qsub -v DRY_RUN=0,FORCE_PREP=1 <本脚本>                                 # 重切池/val
#
# 产物是 95 号的全部旧知识输入：
#   三份 C 与三份 F（if / math / code，单域臂）
#   一份 C_mix 与一份 F_mix（0.5 math + 0.5 code，mix 臂）
#   每个域一份池文件（C / F / replay 三者共用）和一份 val 切片（算 old_val_loss）
# 本脚本只切分、采集、合成和诊断，不训练、不评测。
#
# -----------------------------------------------------------------------------
# 这条线是什么：主实验的骨架换一个载体
#
#   主实验（68/69/81/82/83 号）= Qwen3-8B + LoRA + DialogSum 当新任务，
#   用 C_if / C_math / C_code 分别保护三种通用能力。
#   本线        = Qwen2.5-1.5B-Instruct + **全量 SFT** + finance 当新任务，
#   保护的域、四条臂、比较口径全部不变，只换模型、换训练方式、换新任务。
#
#   所以旧知识那一侧的语料参数**逐字照抄 68/69 号**，一个字都不改：改了就不再是
#   "同一批旧知识换个载体"，而是又多了一个变量。
#
# -----------------------------------------------------------------------------
# 与 68/69 号的差异，每一条都是刻意的
#
#   模型      Qwen3-8B -> Qwen2.5-1.5B-Instruct（28 层 / hidden 1536 /
#             intermediate 8960 / vocab 151936 / kv_heads 2）
#
#   层覆盖    七类 all-linear -> **七类 + lm_head**
#             理由是训练方式变了。68 号那边是 LoRA，只有挂了 adapter 的层会动，
#             lm_head 根本不在可训练集合里；这条线是全量 SFT，每个参数都会动，
#             输出头不约束就等于留了一个不受罚的自由方向。90/91/92 那条全量 SFT
#             线也是这个口径，与它保持一致。
#             !! Qwen2.5-1.5B 是 tie_word_embeddings=true，lm_head.weight 和
#             embed_tokens.weight 是同一个张量，所以约束 lm_head 等于连输入嵌入
#             一起约束。功能上不报错（snapshot_reference_weights 按 storage 去重，
#             不会把同一个张量算两遍从而悄悄把那一层的 λ 翻倍），但 Step 3 会把
#             lm_head 的 tr(C)/d 和其余层并排打出来 —— 如果它高几个数量级，那
#             "λ 主要压在输出头上"这件事必须写进结果，而不是藏在"all-linear +
#             lm_head"这个说法里。
#
#   采集对象  base，不是 specialist
#             正则项是 λ tr(ΔW C ΔWᵀ)，ΔW = W - W_ref，而这条线的 W_ref 就是
#             Qwen2.5-1.5B-Instruct 本身（95 号从它起训）。91 号默认在 specialist
#             上采是因为那条线的 W_ref 是阶段一的 checkpoint，这里不是。
#
#   累加设备  device（--cov_accum_device device）
#             1.5B 的 C 只有 9.85 GiB，整份放得下卡，hook 不必每个 batch 往主机
#             搬 X^T X。收尾时逐层搬回主机再落盘。
#
#   结果目录  ${REPO_ROOT}/results_finance_Qwen2.5-1.5B-Instruct/{cov,fisher}
#             与 8B 主实验、与 90/91/92 的 specialist 线都彻底隔离。
#             注意**语料**仍然读 8B 主实验那批（见下一条）。
#
# -----------------------------------------------------------------------------
# !! 语料从哪来：三个池都是现成的，与模型无关
#   if    ${FLAN_DIR}/train/*.jsonl 的 inputs/targets 两列，FLAN 的 targets 本身
#         就是 gold，20000 行随机子集。
#   math  1.7B 那批自蒸馏 jsonl 的 **gold_targets** 列，两个视角一起读。
#   code  同上，OPC-edu 那一份。
#
#   generate_replay_targets.py 给每行都写了 gold_targets，那是数据集自带的解答、
#   与生成它的模型无关；而且**池子在生成那一步就已经切好了**（文件名里的 30k /
#   20k 就是当时的 --pool_size），所以这里读整份文件即可，不需要重新切池、不需要
#   1.5B 自己生成。这也正是 68/69 号 math/code 那两段 --max_samples 0 的含义：
#   "把已经切好的那 20k/30k 整份读完"，不是"读原始数据集的全量"。
#
#   因此 POOL_ROOT 指向 ${REPO_ROOT}/results（只读，1.7B 那批的产物），
#   RESULTS_ROOT 指向本线自己的目录（只写）。别混。
#
# -----------------------------------------------------------------------------
# !! 池与 val 切片：切分落到磁盘上，不靠传参
#   95 号每个 epoch 会在被保护的那个域上算一条交叉熵（old_val_loss），它的前提
#   是那批行**没有任何一条臂训过**。这件事靠传参做不到，两个原因：
#
#     1) data/replay.py 的 load_self_distilled_pool 不吃 --replay_pool_size，
#        它整份读完（那个函数的前提是"池在上游已经切好了"）。所以 replay 臂
#        没法靠一个 flag 排掉尾部那几百行。
#     2) math 和 code 的池不是"shuffle 后取前 N"来的：prepare_opc_ccode 用的是
#        rng.sample(deduped, 20000)，prepare_metamath_cmath 是按 source 加权、
#        按 question 去重的分层抽样。"池后面那一段"这个概念在这两个域上不存在。
#
#   所以 Step 1 按 68/69 的源口径把每个域读出来，切成两个文件落盘：
#       ${SPLIT_DIR}/<domain>_pool.jsonl      C / F / replay 三者共用
#       ${SPLIT_DIR}/<domain>_val<N>.jsonl    末尾 OLD_VAL_ROWS 行，谁都不训
#   之后所有下游一律读物化后的文件。谁训了哪些行于是变成 wc -l 能查的事，
#   而不是关于两个 shuffle 能不能对上的推理。
#
#   代价：池比 68/69 少 OLD_VAL_ROWS 行（默认 500，math 约 1.9%、code 2.5%、
#   if 2.5%）。C 和 F 都是均值（C 按 token、F 按样本），少这几百行只影响估计
#   方差、不影响量级。报结果时把这个数写上。
#
#   物化还顺带消掉一个坑：新池不带 truncated 列，--replay_drop_truncated 传错
#   也不会再悄悄丢掉 13% 的行。列名同时归一成 inputs / gold_targets，三个域
#   之后的参数因此完全相同。
#
# -----------------------------------------------------------------------------
# !! mix：一份矩阵同时保两个域（Step 4）
#   0.5 C_math + 0.5 C_code 与 0.5 F_math + 0.5 F_code，各合成一份，给 95 号的
#   DOMAIN=mix 用。replay 那一侧对应的是把两个池按 0.5/0.5 混进每个 micro-batch，
#   由 95 号自己做。三条臂因此在 mix 上也是"同一批旧知识的三种用法"。
#
#   只在 math 与 code 之间混，if 进不来：它的 maxlen 是 512 而那两个是 1024，
#   而 train.py 的 --replay_max_len 是全局唯一的，混进来必然有一个域的口径是错的。
#
# -----------------------------------------------------------------------------
# !! C 和 F 必须同池，所以两段共用同一个 POOL_ARGS 数组
#   三条非 vanilla 臂的前提是"同一批旧知识的不同用法"。C 和 F 只要有一个字的数据
#   参数不同，EWC 与 OneReplay 的差别里就混进了"谁看的数据多"这个变量。
#
#   所以下面 pool_args_for 那个函数的输出**同时**喂给 collect_cov 和
#   collect_fisher，Step 3 再用 pool_fingerprint 把这件事钉死，不等就报错。
#
#   唯一没进共用数组的是 --sample_strategy uniform：collect_fisher 没有这个 flag，
#   传了会被 argparse 拒；而两边的 limit_dataset 都是 getattr(args,
#   "sample_strategy", "uniform")，缺省就是 uniform，所以省掉它两边取的是同一批行。
#
# -----------------------------------------------------------------------------
# maxlen 按域走，不按新任务走
#   if 512 / math 1024 / code 1024，逐字等于 68/69 号。
#
#   !! 不要把它们改成新任务的 1216。C 的 max_len 要对齐的是 **replay 臂读同一个
#   池时的 --replay_max_len**（95 号会拿 C 的 metadata 对表），不是新任务的长度
#   预算 —— 两者量的是不同的东西，前者决定"罚项编码了旧知识的多长一段"，后者
#   决定"新任务的行会不会被截断"。
#   改这个值必须三处同步：本文件、95 号的 REPLAY_MAXLEN、以及重采 C 和 F。
#
# -----------------------------------------------------------------------------
# COV_BATCH 怎么定：logits 是瓶颈
#   target_modules 里虽然有 lm_head，但 collect_cov 走的是完整前向，logits 无论
#   如何都要算。Qwen2.5 的 vocab 是 151936，logits 显存 = batch x len x 151936 x 2B，
#   按 batch x len 约 16K token 配平：
#       if   len 512  -> batch 32   （logits 4.98 GiB）
#       math len 1024 -> batch 16   （同上）
#       code len 1024 -> batch 16
#   采集期显存 = 3.1(权重 bf16) + 9.85(C fp32) + 5.0(logits) + 激活，约 20 GB。
#   C 是按 token 取的均值，batch 只影响累加顺序不影响结果，所以这个旋钮是安全的。
#
# -----------------------------------------------------------------------------
# 落盘体积（fp32）。Step 0 会从 config.json 现读维度算准确值再和 df 比
#   C 按**输入维度**的方阵存 -> down_proj (8960²) 独占八成，每域约 9.85 GiB
#   F 按**权重形状**存      -> lm_head (151936x1536) 独占约 890 MiB，每域约 6.0 GiB
#   三域 C+F 合计约 48 GiB。两者不是一回事，别拿一个的经验估另一个。
#
# -----------------------------------------------------------------------------
# 时间：C 便宜，F 是大头
#   C 只有前向；F 逐样本反向（collect_fisher 里 batch_size 写死 1，因为对 batch
#   求和再平方是 (Σg)² 而不是 Σg²，那是另一个矩阵，且不会报错）。
#   三域共约 66k 行，按 300 ms/样本估约 5.5 h，24 h 的 walltime 很宽松。
#   Step 0 会按 ETA_MS_PER_EXAMPLE 估并和 walltime 比，只警告不拦；真值看
#   collect_fisher 每 LOG_EVERY 条打印的 ms/example，拿它回来校准再投下一批。
#
#   !! F 没有断点续采。写到一半失败等于这个域全白跑，所以 Step 0 的磁盘预检是
#   硬拦截，不是警告。
#
# -----------------------------------------------------------------------------
# 投递前要有
#   1) ${MODEL_DIR}/Qwen2.5-1.5B-Instruct
#   2) ${FLAN_DIR}                                                （if 域语料）
#   3) ${POOL_ROOT}/replay/metamath_cmath_30k_*_selfdistill_seed1.jsonl （2 个文件）
#   4) ${POOL_ROOT}/replay/opc_edu_ccode_20k_selfdistill_seed1.jsonl
#   5) /scratch 剩余空间 > Step 0 报的预计写入量 + 20 GiB
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/93_finance_gold_cf.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_fincf_${JOBTAG}}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_fincf_${JOBTAG}}"
  EXTRA_BIND=""
fi

WHAT="${WHAT:-both}"

# =============================================================================
# 外层：裸计算节点，只负责起容器再把自己跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]]    || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_fincf_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME RESULTS_ROOT POOL_ROOT FLAN_DIR DATASET_CACHE
    COV_DIR FISHER_DIR
    WHAT DO_IF DO_MATH DO_CODE DO_DIAG DRY_RUN FORCE
    DO_PREP FORCE_PREP SPLIT_DIR OLD_VAL_ROWS
    DO_MIX FORCE_MIX MIX_DOMAINS MIX_WEIGHTS MIX_COV MIX_FISHER
    TARGET_MODULES SYSTEM_PROMPT SEED SAMPLE_SEED GOLD_COLUMN DEBUG_EXAMPLES
    COV_ACCUM_DEVICE COV_USE_BF16 FISHER_DEVICE FISHER_USE_BF16 LOG_EVERY
    FLAN_SAMPLES IF_MAXLEN IF_COV_BATCH
    MATH_VIEW_PREFIX MATH_MAXLEN MATH_COV_BATCH
    CODE_VIEW_PREFIX CODE_MAXLEN CODE_COV_BATCH
    IF_COV MATH_COV CODE_COV IF_FISHER MATH_FISHER CODE_FISHER
    ETA_MS_PER_EXAMPLE WALLTIME_HOURS
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e --nv -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：会把当前 shell 换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

cd "${REPO_ROOT}"

case "${WHAT}" in
  cov|fisher|both|none) ;;
  *) echo "WHAT 只能是 cov|fisher|both|none，当前 '${WHAT}'" >&2; exit 2 ;;
esac

# ---- 模型：本线的 W_ref，95 号从它起训 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen2.5-1.5B-Instruct}"

# ---- 目录：写本线自己的，读 1.7B 那批的池 ----
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_finance_${MODEL_NAME}}"
POOL_ROOT="${POOL_ROOT:-${REPO_ROOT}/results}"
FLAN_DIR="${FLAN_DIR:-${REPO_ROOT}/datasets/flan}"
COV_DIR="${COV_DIR:-${RESULTS_ROOT}/cov}"
FISHER_DIR="${FISHER_DIR:-${RESULTS_ROOT}/fisher}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
export HF_DATASETS_CACHE="${DATASET_CACHE}"

# ---- 阶段开关 ----
DRY_RUN="${DRY_RUN:-1}"
DO_IF="${DO_IF:-1}"
DO_MATH="${DO_MATH:-1}"
DO_CODE="${DO_CODE:-1}"
DO_DIAG="${DO_DIAG:-1}"
FORCE="${FORCE:-0}"              # 1 = 已有同名 .pt 也重采

# ---- 覆盖范围：必须与 95 号训练臂的 TARGET_MODULES 逐字一致，见文件头 ----
TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj,lm_head}"

# ---- 采集协议：逐字沿用 68/69 号 ----
SEED="${SEED:-1}"
SAMPLE_SEED="${SAMPLE_SEED:-1}"
GOLD_COLUMN="${GOLD_COLUMN:-gold_targets}"
DEBUG_EXAMPLES="${DEBUG_EXAMPLES:-2}"
# 三个旧知识池都是英文通用语料，没有任何一个域需要自定义 system；训练侧（95 号）
# 也是空。空不等于"没有 system turn"：chat_policy 在空串时不注入，Qwen2.5-Instruct
# 的模板于是用它自带的那条默认 system，采集期和训练期因此逐字相同。
SYSTEM_PROMPT="${SYSTEM_PROMPT:-}"

# C：hook 内部一律升 fp32 再累加，所以前向 bf16 不影响结果，只省显存和时间。
COV_USE_BF16="${COV_USE_BF16:-1}"
COV_ACCUM_DEVICE="${COV_ACCUM_DEVICE:-device}"
# F：梯度在到达累加器之前就被反向舍入过了，bf16 的 8 位尾数给每个平方梯度留约
# 1% 的噪声底，事后加宽救不回来。所以这里是 fp32，别为了提速改成 1。
FISHER_USE_BF16="${FISHER_USE_BF16:-0}"
FISHER_DEVICE="${FISHER_DEVICE:-cuda}"
LOG_EVERY="${LOG_EVERY:-500}"

# ---- 三个域的语料与长度预算，逐字等于 68/69 号 ----
FLAN_SAMPLES="${FLAN_SAMPLES:-20000}"
IF_MAXLEN="${IF_MAXLEN:-512}"
IF_COV_BATCH="${IF_COV_BATCH:-32}"

# math：两个视角一起读，少读一个就等于换了池
MATH_VIEW_PREFIX="${MATH_VIEW_PREFIX:-metamath_cmath_30k}"
MATH_MAXLEN="${MATH_MAXLEN:-1024}"
MATH_COV_BATCH="${MATH_COV_BATCH:-16}"
MATH_GLOB="${POOL_ROOT}/replay/${MATH_VIEW_PREFIX}_*_selfdistill_seed${SAMPLE_SEED}.jsonl"

CODE_VIEW_PREFIX="${CODE_VIEW_PREFIX:-opc_edu_ccode_20k}"
CODE_MAXLEN="${CODE_MAXLEN:-1024}"
CODE_COV_BATCH="${CODE_COV_BATCH:-16}"
CODE_FILE="${POOL_ROOT}/replay/${CODE_VIEW_PREFIX}_selfdistill_seed${SAMPLE_SEED}.jsonl"

# ---- 池/val 切分，见文件头第 4 条 ----
# 每个域从自己的池尾留出这么多行当 val，C / F / replay 三者都不碰它们。
OLD_VAL_ROWS="${OLD_VAL_ROWS:-500}"
SPLIT_DIR="${SPLIT_DIR:-${RESULTS_ROOT}/pools}"
SPLIT_MANIFEST="${SPLIT_DIR}/manifest.json"
DO_PREP="${DO_PREP:-1}"
FORCE_PREP="${FORCE_PREP:-0}"

# ---- mix：一份矩阵同时保两个域 ----
DO_MIX="${DO_MIX:-1}"
MIX_DOMAINS="${MIX_DOMAINS:-math,code}"
MIX_WEIGHTS="${MIX_WEIGHTS:-0.5,0.5}"
# qsub -v 自己按逗号切参数，所以从命令行传的时候只能写成 math:code / 0.25:0.75。
# 这里归一回逗号，95 号那边是同一行，两边的 MIX_TAG 才拼得出同一个文件名。
MIX_DOMAINS="${MIX_DOMAINS//:/,}"
MIX_WEIGHTS="${MIX_WEIGHTS//:/,}"
FORCE_MIX="${FORCE_MIX:-0}"

# ---- 产物。目录名里已经带了模型，文件名只区分域与池 ----
# _all 指的是本文件头那套覆盖：七类 all-linear + lm_head。
IF_COV="${IF_COV:-${COV_DIR}/cov_if_flan20k_all.pt}"
MATH_COV="${MATH_COV:-${COV_DIR}/cov_math_metamath30k_gold_all.pt}"
CODE_COV="${CODE_COV:-${COV_DIR}/cov_code_opcedu20k_gold_all.pt}"
IF_FISHER="${IF_FISHER:-${FISHER_DIR}/fisher_if_flan20k_all.pt}"
MATH_FISHER="${MATH_FISHER:-${FISHER_DIR}/fisher_math_metamath30k_gold_all.pt}"
CODE_FISHER="${CODE_FISHER:-${FISHER_DIR}/fisher_code_opcedu20k_gold_all.pt}"

# mix 的产物名把参与的域与权重都编进去，所以 0.5/0.5 与 0.25/0.75 是两个独立的
# 文件，不会互相覆盖。95 号按同一个式子推导路径，两边必须一致。
MIX_TAG="mix-$(printf '%s' "${MIX_DOMAINS//,/-}")-w$(printf '%s' "${MIX_WEIGHTS//,/-}")"
MIX_COV="${MIX_COV:-${COV_DIR}/cov_${MIX_TAG}_gold_all.pt}"
MIX_FISHER="${MIX_FISHER:-${FISHER_DIR}/fisher_${MIX_TAG}_gold_all.pt}"

# 1.2 s/样本是 8B @ 512 token 的实测值。1.5B 权重小 5 倍、长度大约 2 倍，先按
# 300 ms 估（比线性缩放保守）。只影响 Step 0 的耗时预警，估错不改变采集结果。
ETA_MS_PER_EXAMPLE="${ETA_MS_PER_EXAMPLE:-300}"
WALLTIME_HOURS="${WALLTIME_HOURS:-24}"

[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺基座模型: ${MODEL_DIR}/${MODEL_NAME}" >&2; exit 1; }
mkdir -p "${COV_DIR}" "${FISHER_DIR}" "${DATASET_CACHE}"

# Step 0 / Step 5 的内嵌 Python 靠 os.environ 读这些值。上面的赋值只建普通 shell
# 变量 —— 只有经 qsub -v 传进来的那几个才碰巧已经在环境里，其余会让 python 抛
# KeyError。全部显式 export，别依赖调用方传了什么。
export MODEL_DIR MODEL_NAME TARGET_MODULES COV_DIR FISHER_DIR
export WHAT DO_IF DO_MATH DO_CODE DO_MIX
export IF_COV MATH_COV CODE_COV IF_FISHER MATH_FISHER CODE_FISHER
export MIX_COV MIX_FISHER MIX_DOMAINS MIX_WEIGHTS
export ETA_MS_PER_EXAMPLE WALLTIME_HOURS

echo "========================================================================"
echo "finance 线 三域 gold C / F 采集"
echo "  模型     = ${MODEL_DIR}/${MODEL_NAME}   (base = 本线的 W_ref)"
echo "  采什么   = ${WHAT}"
echo "  层覆盖   = ${TARGET_MODULES}"
echo "  system   = '${SYSTEM_PROMPT}'（空 = 用模板自带的默认 system，与 95 号同值）"
echo "  语料池   = ${POOL_ROOT}/replay 与 ${FLAN_DIR}   (只读)"
echo "  产物     = ${COV_DIR}"
echo "             ${FISHER_DIR}"
echo "  if       = FLAN ${FLAN_SAMPLES} 行 / maxlen ${IF_MAXLEN} / cov batch ${IF_COV_BATCH}"
echo "             ${IF_COV}"
echo "             ${IF_FISHER}"
echo "  math     = ${MATH_GLOB}"
echo "             maxlen ${MATH_MAXLEN} / cov batch ${MATH_COV_BATCH}"
echo "             ${MATH_COV}"
echo "             ${MATH_FISHER}"
echo "  code     = ${CODE_FILE}"
echo "             maxlen ${CODE_MAXLEN} / cov batch ${CODE_COV_BATCH}"
echo "             ${CODE_COV}"
echo "             ${CODE_FISHER}"
echo "  C        = bf16 ${COV_USE_BF16} / accum ${COV_ACCUM_DEVICE}"
echo "  F        = bf16 ${FISHER_USE_BF16} / device ${FISHER_DEVICE} / batch 1（写死）"
echo "  切分     = 每域池尾留 ${OLD_VAL_ROWS} 行做 val（C/F/replay 都不碰）"
echo "             ${SPLIT_DIR}"
if [[ "${DO_MIX}" == "1" ]]; then
echo "  mix      = ${MIX_DOMAINS} @ ${MIX_WEIGHTS}"
echo "             ${MIX_COV}"
echo "             ${MIX_FISHER}"
fi
echo "  阶段     = prep:${DO_PREP} if:${DO_IF} math:${DO_MATH} code:${DO_CODE}"
echo "             mix:${DO_MIX} diag:${DO_DIAG}  DRY_RUN=${DRY_RUN}"
echo "========================================================================"

# ===========================================================================
# Step 0: 前置检查（纯 CPU）
#   1) 语料在不在，math 的 glob 必须展开成 2 个文件
#   2) 按 config.json 现读维度算落盘体积，和 df 剩余比 —— 不够直接退出
#   3) 打印各域行数与池指纹，F 的耗时按行数估
# ===========================================================================
echo
echo "==== Step 0: 前置检查 ===="

if [[ "${DO_IF}" == "1" ]]; then
  [[ -d "${FLAN_DIR}" ]] || { echo "缺 FLAN 语料: ${FLAN_DIR}" >&2; exit 1; }
fi
if [[ "${DO_CODE}" == "1" ]]; then
  [[ -f "${CODE_FILE}" ]] || { echo "缺 code 语料: ${CODE_FILE}" >&2; exit 1; }
fi

# glob 必须落到 2 个文件（canonical + rephrased）。少一个就等于换了池。
shopt -s nullglob
# shellcheck disable=SC2206
MATH_FILES=( ${MATH_GLOB} )
shopt -u nullglob
if [[ "${DO_MATH}" == "1" ]]; then
  echo "math glob 展开为 ${#MATH_FILES[@]} 个文件:"
  for f in "${MATH_FILES[@]}"; do echo "    ${f}"; done
  if [[ "${#MATH_FILES[@]}" -ne 2 ]]; then
    echo "!! math 语料应为 2 个视角（canonical + rephrased），实际 ${#MATH_FILES[@]} 个" >&2
    echo "   少读一个视角就等于换了池，与 68 号的 C_math 不再同源。停。" >&2
    exit 1
  fi
fi

DISK_PLAN=$(python - <<'PY'
import json, os, shutil, sys

model_dir = os.path.join(os.environ["MODEL_DIR"], os.environ["MODEL_NAME"])
with open(os.path.join(model_dir, "config.json"), encoding="utf-8") as fh:
    cfg = json.load(fh)

hidden = cfg["hidden_size"]
inter = cfg["intermediate_size"]
layers = cfg["num_hidden_layers"]
heads = cfg["num_attention_heads"]
kv_heads = cfg.get("num_key_value_heads", heads)
head_dim = cfg.get("head_dim", hidden // heads)
vocab = cfg["vocab_size"]

# C 存的是该层**输入**维度的方阵；F 存的是**权重形状**。两者量级完全不同，
# down_proj 在 C 里独占大头，lm_head 在 F 里独占大头。
cov_in = {
    "q_proj": hidden, "k_proj": hidden, "v_proj": hidden,
    "o_proj": heads * head_dim,
    "gate_proj": hidden, "up_proj": hidden, "down_proj": inter,
    "lm_head": hidden,
}
fisher_shape = {
    "q_proj": (heads * head_dim, hidden),
    "k_proj": (kv_heads * head_dim, hidden),
    "v_proj": (kv_heads * head_dim, hidden),
    "o_proj": (hidden, heads * head_dim),
    "gate_proj": (inter, hidden),
    "up_proj": (inter, hidden),
    "down_proj": (hidden, inter),
    "lm_head": (vocab, hidden),
}

targets = [m.strip() for m in os.environ["TARGET_MODULES"].split(",") if m.strip()]
unknown = [m for m in targets if m not in cov_in]
if unknown:
    print(f"未知模块名，无法估算体积: {unknown}", file=sys.stderr)
    raise SystemExit(2)

print(f"config: hidden={hidden} intermediate={inter} layers={layers} "
      f"kv_heads={kv_heads} head_dim={head_dim} vocab={vocab}")
print(f"层覆盖期望 = {sum(1 if m == 'lm_head' else layers for m in targets)} 层")

n_domains = sum(
    1 for key in ("DO_IF", "DO_MATH", "DO_CODE") if os.environ.get(key, "0") == "1"
)
what = os.environ["WHAT"]
need = 0

if what in ("cov", "both"):
    total = 0
    print("  ---- C（按输入维度的方阵）")
    for m in targets:
        size = cov_in[m] ** 2 * 4
        n = 1 if m == "lm_head" else layers
        total += size * n
        print(f"    {m:<10} in={cov_in[m]:>6}  {size/2**20:8.1f} MiB x {n:>3} = {size*n/2**30:7.2f} GiB")
    print(f"    单域 {total/2**30:.2f} GiB  x {n_domains} 域 = {total*n_domains/2**30:.2f} GiB")
    need += total * n_domains

if what in ("fisher", "both"):
    total = 0
    print("  ---- F（按权重形状）")
    for m in targets:
        out_dim, in_dim = fisher_shape[m]
        size = out_dim * in_dim * 4
        n = 1 if m == "lm_head" else layers
        total += size * n
        print(f"    {m:<10} {out_dim:>6}x{in_dim:<6} {size/2**20:8.1f} MiB x {n:>3} = {size*n/2**30:7.2f} GiB")
    print(f"    单域 {total/2**30:.2f} GiB  x {n_domains} 域 = {total*n_domains/2**30:.2f} GiB")
    need += total * n_domains

free = shutil.disk_usage(os.environ["COV_DIR"]).free
print(f"本次预计写入 {need/2**30:.2f} GiB ({need/1e9:.1f} GB)")
print(f"{os.environ['COV_DIR']} 剩余 {free/2**30:.2f} GiB")
print(f"PLAN need_gib={need/2**30:.2f} free_gib={free/2**30:.2f}")
PY
)
echo "${DISK_PLAN}"

NEED_GIB="${DISK_PLAN##*need_gib=}"; NEED_GIB="${NEED_GIB%% *}"
FREE_GIB="${DISK_PLAN##*free_gib=}"; FREE_GIB="${FREE_GIB%% *}"
# 留 20 GiB 余量：torch.save 先写临时文件再改名，落盘瞬间要两份的空间。
if ! python -c "import sys; sys.exit(0 if float('${FREE_GIB}') >= float('${NEED_GIB}') + 20 else 1)"; then
  echo "!! 空间不足：需要 ${NEED_GIB} GiB + 20 GiB 余量，实际剩余 ${FREE_GIB} GiB" >&2
  echo "   F 没有断点续采，写到一半失败等于全白跑，所以这里直接停。" >&2
  echo "   要么清理，要么分批采（WHAT=cov / WHAT=fisher，或 DO_* 一次一个域）。" >&2
  exit 1
fi

# ===========================================================================
# 每个域的**源**语料参数，逐字等于 68/69 号。只有 Step 1 的物化用它。
#
# C / F / replay 并不直接读这些源：Step 1 先按这套口径把每个域读出来，切成
# 「池」和「val」两个文件落盘，之后三条臂一律读物化后的池文件。见文件头第 4 条。
# ===========================================================================
source_args_for () {
  case "$1" in
    if)
      # FLAN 原始语料的 targets 就是 gold，不需要换列。
      printf '%s\n' \
        --data_files "${FLAN_DIR}/train/*.jsonl" \
        --dataset_split train \
        --streaming 0 \
        --input_column inputs \
        --target_column targets \
        --max_samples "${FLAN_SAMPLES}" \
        --sample_shuffle 1 \
        --sample_seed "${SAMPLE_SEED}"
      ;;
    math)
      # 池在 generate_replay_targets 那一步就切好了（文件名里的 30k），所以
      # --max_samples 0 是"整份读完"，不是"读原始数据集的全量"。
      printf '%s\n' \
        --data_files "${MATH_GLOB}" \
        --dataset_split train \
        --streaming 0 \
        --input_column inputs \
        --target_column "${GOLD_COLUMN}" \
        --require_target 1 \
        --max_samples 0 \
        --sample_shuffle 0 \
        --sample_seed "${SAMPLE_SEED}"
      ;;
    code)
      printf '%s\n' \
        --data_files "${CODE_FILE}" \
        --dataset_split train \
        --streaming 0 \
        --input_column inputs \
        --target_column "${GOLD_COLUMN}" \
        --require_target 1 \
        --max_samples 0 \
        --sample_shuffle 0 \
        --sample_seed "${SAMPLE_SEED}"
      ;;
  esac
}

# ===========================================================================
# 物化后的池。**C 和 F 共用同一份**，95 号的 replay 臂读的也是这个文件 ——
# 三者同池不再靠"两个 shuffle 应该一致"这种推理，靠的是它们打开同一个文件。
# Step 5 仍会用 pool_fingerprint 复核 C 与 F。
#
# 三个域在这里的参数完全相同：物化时已经把列名归一成 inputs / gold_targets、
# 行序已经定死、空行已经滤掉，所以这里 --max_samples 0 --sample_shuffle 0。
# ===========================================================================
pool_file_for () { printf '%s' "${SPLIT_DIR}/$1_pool.jsonl"; }
val_file_for ()  { printf '%s' "${SPLIT_DIR}/$1_val${OLD_VAL_ROWS}.jsonl"; }

pool_args_for () {
  printf '%s\n' \
    --data_files "$(pool_file_for "$1")" \
    --dataset_split train \
    --streaming 0 \
    --input_column inputs \
    --target_column gold_targets \
    --require_target 1 \
    --max_samples 0 \
    --sample_shuffle 0 \
    --sample_seed "${SAMPLE_SEED}"
}

maxlen_for () {
  case "$1" in
    if)   printf '%s' "${IF_MAXLEN}" ;;
    math) printf '%s' "${MATH_MAXLEN}" ;;
    code) printf '%s' "${CODE_MAXLEN}" ;;
  esac
}

cov_batch_for () {
  case "$1" in
    if)   printf '%s' "${IF_COV_BATCH}" ;;
    math) printf '%s' "${MATH_COV_BATCH}" ;;
    code) printf '%s' "${CODE_COV_BATCH}" ;;
  esac
}

cov_path_for () {
  case "$1" in
    if)   printf '%s' "${IF_COV}" ;;
    math) printf '%s' "${MATH_COV}" ;;
    code) printf '%s' "${CODE_COV}" ;;
  esac
}

fisher_path_for () {
  case "$1" in
    if)   printf '%s' "${IF_FISHER}" ;;
    math) printf '%s' "${MATH_FISHER}" ;;
    code) printf '%s' "${CODE_FISHER}" ;;
  esac
}

ACTIVE_DOMAINS=()
[[ "${DO_IF}"   == "1" ]] && ACTIVE_DOMAINS+=(if)
[[ "${DO_MATH}" == "1" ]] && ACTIVE_DOMAINS+=(math)
[[ "${DO_CODE}" == "1" ]] && ACTIVE_DOMAINS+=(code)

# DRY_RUN 在切分之前退出：Step 1 会往磁盘写池和 val 两个文件，那是副作用，
# 不该在"只看计划"的这一档里发生。上面 Step 0 的检查全是只读的。
if [[ "${DRY_RUN}" == "1" ]]; then
  echo
  echo "DRY_RUN=1：以上为计划，不切分、不采集。确认后 qsub -v DRY_RUN=0,... "
  for domain in "${ACTIVE_DOMAINS[@]}"; do
    echo
    echo "  ${domain}: maxlen $(maxlen_for "${domain}")  cov_batch $(cov_batch_for "${domain}")"
    echo "    源语料参数（逐字等于 68/69 号）："
    source_args_for "${domain}" | paste - - | sed 's/^/      /'
    echo "    -> 池  $(pool_file_for "${domain}")        (C / F / replay 三者共用)"
    echo "    -> val $(val_file_for "${domain}")   (末尾 ${OLD_VAL_ROWS} 行，谁都不训)"
    echo "    C -> $(cov_path_for "${domain}")"
    echo "    F -> $(fisher_path_for "${domain}")"
  done
  if [[ "${DO_MIX}" == "1" ]]; then
    echo
    echo "  mix (${MIX_DOMAINS} @ ${MIX_WEIGHTS}):"
    echo "    C -> ${MIX_COV}"
    echo "    F -> ${MIX_FISHER}"
  fi
  exit 0
fi

# ===========================================================================
# Step 1: 物化每个域的池与 val 切片
#
# 为什么要落盘，而不是靠传参把 val 那 500 行排除掉：
#   data/replay.py 的 load_self_distilled_pool **不吃** --replay_pool_size，它
#   整份读完（那个函数的前提是"池在上游已经切好了"）。所以 replay 臂靠传参是
#   排不掉尾部那 500 行的，它照样会训到被拿来算 val loss 的行，而 val loss 的
#   全部意义就是"没有任何一条臂训过这些行"。
#
#   更根本的一条：math 和 code 的池不是"shuffle 后取前 N"来的。
#   prepare_opc_ccode 用的是 rng.sample(deduped, 20000)，prepare_metamath_cmath
#   是按 source 加权、按 question 去重的分层抽样。所以"池后面那一段"这个概念在
#   这两个域上根本不存在，--pool_offset 只会在池内偏移。
#
# 于是切分在这里做一次、落到磁盘上：谁训了哪些行变成 wc -l 能查的事，不再是
# 关于两个 shuffle 能不能对上的推理。列名同时归一成 inputs / gold_targets，
# 三个域之后的参数因此完全相同。
#
# 顺带消掉一个坑：物化后的池不带 truncated 列，--replay_drop_truncated 传错也
# 不会再悄悄丢掉 13% 的行。
# ===========================================================================
if [[ "${DO_PREP}" == "1" && "${#ACTIVE_DOMAINS[@]}" -gt 0 ]]; then
  echo
  echo "==== Step 1: 物化池与 val 切片（每域留 ${OLD_VAL_ROWS} 行）===="
  mkdir -p "${SPLIT_DIR}"
  for domain in "${ACTIVE_DOMAINS[@]}"; do
    pool_out="$(pool_file_for "${domain}")"
    val_out="$(val_file_for "${domain}")"
    if [[ -f "${pool_out}" && -f "${val_out}" && "${FORCE_PREP}" != "1" ]]; then
      echo "  已存在，跳过 ${domain}（要重切传 FORCE_PREP=1）"
      echo "    池  $(wc -l < "${pool_out}") 行  ${pool_out}"
      echo "    val $(wc -l < "${val_out}") 行  ${val_out}"
      continue
    fi
    src_args=()
    while IFS= read -r item; do src_args+=("${item}"); done < <(source_args_for "${domain}")
    python - "${src_args[@]}" \
      --cache_dir "${DATASET_CACHE}" --label "${domain}" \
      --val_rows "${OLD_VAL_ROWS}" \
      --out_pool "${pool_out}" --out_val "${val_out}" \
      --manifest "${SPLIT_MANIFEST}" <<'PY'
import argparse
import json
import sys
from pathlib import Path

from onereplay.data.old_knowledge import (
    filter_incomplete_rows,
    fingerprint_pool,
    load_old_knowledge_dataset,
)

parser = argparse.ArgumentParser()
# 与 collect_cov / collect_fisher 同名的那几个，好让 source_args_for 的输出
# 原样喂进来：这一步必须和 68/69 号读到的是同一批行，多一个少一个都不行。
parser.add_argument("--dataset_path", type=str, default="")
parser.add_argument("--dataset_name", type=str, default="")
parser.add_argument("--dataset_config", type=str, default="")
parser.add_argument("--dataset_split", type=str, default="train")
parser.add_argument("--data_files", type=str, default="")
parser.add_argument("--cache_dir", type=str, default="")
parser.add_argument("--streaming", type=int, default=0)
parser.add_argument("--text_column", type=str, default="")
parser.add_argument("--input_column", type=str, default="inputs")
parser.add_argument("--target_column", type=str, default="targets")
parser.add_argument("--require_target", type=int, default=0)
parser.add_argument("--require_target_column", type=str, default="")
parser.add_argument("--max_samples", type=int, default=0)
parser.add_argument("--sample_shuffle", type=int, default=0)
parser.add_argument("--sample_seed", type=int, default=1)
parser.add_argument("--label", type=str, default="pool")
parser.add_argument("--val_rows", type=int, required=True)
parser.add_argument("--out_pool", type=str, required=True)
parser.add_argument("--out_val", type=str, required=True)
parser.add_argument("--manifest", type=str, default="")
args = parser.parse_args()

dataset = load_old_knowledge_dataset(args)
before = len(dataset)
if args.require_target == 1:
    dataset = filter_incomplete_rows(dataset, args)
# limit_dataset 的两步，手写在这里是因为下面还要按同一个顺序切第二刀。
if args.sample_shuffle == 1:
    dataset = dataset.shuffle(seed=args.sample_seed)
if args.max_samples > 0:
    dataset = dataset.select(range(min(args.max_samples, len(dataset))))

total = len(dataset)
if total <= args.val_rows:
    raise SystemExit(
        f"{args.label}: 语料只有 {total} 行，留不出 {args.val_rows} 行 val。"
        " 调小 OLD_VAL_ROWS，或确认语料路径对不对。"
    )
pool_rows = total - args.val_rows
pool = dataset.select(range(pool_rows))
val = dataset.select(range(pool_rows, total))

# 池归一成 inputs / gold_targets：三个域之后的参数因此完全相同，95 号的
# replay 臂也不再需要按域切换答案列。
Path(args.out_pool).parent.mkdir(parents=True, exist_ok=True)
with open(args.out_pool, "w", encoding="utf-8") as handle:
    for row in pool:
        handle.write(json.dumps({
            "inputs": str(row[args.input_column] or "").strip(),
            "gold_targets": str(row[args.target_column] or "").strip(),
        }, ensure_ascii=False) + "\n")

# val 用 question / response：那是 data/old_val.py 读的 schema。
with open(args.out_val, "w", encoding="utf-8") as handle:
    for row in val:
        handle.write(json.dumps({
            "question": str(row[args.input_column] or "").strip(),
            "response": str(row[args.target_column] or "").strip(),
        }, ensure_ascii=False) + "\n")

pool_count, pool_fp = fingerprint_pool(pool, args)
val_count, val_fp = fingerprint_pool(val, args)
print(f"  {args.label}: 源 {before} 行 -> 口径内 {total} 行"
      f" -> 池 {pool_rows} + val {args.val_rows}")
print(f"    池  {args.out_pool}")
print(f"        rows={pool_count} fingerprint={pool_fp}")
print(f"    val {args.out_val}")
print(f"        rows={val_count} fingerprint={val_fp}")

if args.manifest:
    path = Path(args.manifest)
    payload = {}
    if path.is_file():
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            # 半截文件不该让整轮切分失败，重写一份就是了。
            payload = {}
    payload[args.label] = {
        "source_data_files": args.data_files,
        "source_input_column": args.input_column,
        "source_target_column": args.target_column,
        "require_target": args.require_target,
        "sample_shuffle": args.sample_shuffle,
        "sample_seed": args.sample_seed,
        "max_samples": args.max_samples,
        "rows_in_scope": total,
        "pool_rows": pool_rows,
        "val_rows": val_count,
        "pool_file": args.out_pool,
        "val_file": args.out_val,
        "pool_fingerprint": pool_fp,
        "val_fingerprint": val_fp,
    }
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
PY
  done
  echo "  切分清单: ${SPLIT_MANIFEST}"
  echo "  95 号按同一套规则推导这些路径，两边对不上时它的同池检查会拦下来。"
fi

# ---- F 的耗时预估。行数直接数物化后的池，不用再跑一次装载 ----
if [[ "${#ACTIVE_DOMAINS[@]}" -gt 0 ]] \
   && [[ "${WHAT}" == "fisher" || "${WHAT}" == "both" ]]; then
  TOTAL_ROWS=0
  for domain in "${ACTIVE_DOMAINS[@]}"; do
    pool_out="$(pool_file_for "${domain}")"
    [[ -f "${pool_out}" ]] || continue
    ROWS="$(wc -l < "${pool_out}" | tr -d ' ')"
    TOTAL_ROWS=$((TOTAL_ROWS + ROWS))
  done
  if (( TOTAL_ROWS > 0 )); then
    TOTAL_ROWS="${TOTAL_ROWS}" python - <<'PY'
import os

rows = int(os.environ["TOTAL_ROWS"])
ms = float(os.environ["ETA_MS_PER_EXAMPLE"])
budget = float(os.environ["WALLTIME_HOURS"])
hours = rows * ms / 1000 / 3600
print(f"  F 共 {rows} 行，预计 {hours:.2f} h（按 {ms:.0f} ms/样本估，不是实测）"
      f" / walltime {budget:.0f} h")
if hours > budget * 0.85:
    print("  !! 逼近或超过 walltime，而 F 没有断点续采。")
    print("     分域投：DO_IF / DO_MATH / DO_CODE 一次开一个。")
PY
  fi
fi

# ===========================================================================
# Step 2: 采 C
# ===========================================================================
collect_cov_one () {
  local domain="$1"
  local out_path maxlen batch
  out_path="$(cov_path_for "${domain}")"
  maxlen="$(maxlen_for "${domain}")"
  batch="$(cov_batch_for "${domain}")"

  if [[ -f "${out_path}" && "${FORCE}" != "1" ]]; then
    echo "==== 已存在，跳过 C_${domain}: ${out_path}（要重采传 FORCE=1）===="
    return 0
  fi
  local args=()
  while IFS= read -r item; do args+=("${item}"); done < <(pool_args_for "${domain}")

  echo
  echo "==== Step 2: 采 C_${domain} -> ${out_path} ===="
  python -m onereplay.scripts.collect_cov \
    --seed "${SEED}" \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    --use_bf16 "${COV_USE_BF16}" \
    --cache_dir "${DATASET_CACHE}" \
    --use_chat_template 1 --include_target_in_chat 1 \
    --enable_thinking 0 --concat_prompt_target 0 \
    --system_prompt "${SYSTEM_PROMPT}" \
    --cov_supervision assistant_only \
    --debug_print_examples "${DEBUG_EXAMPLES}" \
    --batch_size "${batch}" --max_len "${maxlen}" \
    --truncation_side left \
    --target_modules "${TARGET_MODULES}" \
    --cov_accum_device "${COV_ACCUM_DEVICE}" \
    --output_path "${out_path}" \
    "${args[@]}"
  ls -lh "${out_path}"
}

# ===========================================================================
# Step 3: 采 F
# ===========================================================================
collect_fisher_one () {
  local domain="$1"
  local out_path maxlen
  out_path="$(fisher_path_for "${domain}")"
  maxlen="$(maxlen_for "${domain}")"

  if [[ -f "${out_path}" && "${FORCE}" != "1" ]]; then
    echo "==== 已存在，跳过 F_${domain}: ${out_path}（要重采传 FORCE=1）===="
    return 0
  fi
  local args=()
  while IFS= read -r item; do args+=("${item}"); done < <(pool_args_for "${domain}")

  echo
  echo "==== Step 3: 采 F_${domain} -> ${out_path} ===="
  python -m onereplay.scripts.collect_fisher \
    --seed "${SEED}" \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    --use_bf16 "${FISHER_USE_BF16}" \
    --cache_dir "${DATASET_CACHE}" \
    --use_chat_template 1 --include_target_in_chat 1 \
    --system_prompt "${SYSTEM_PROMPT}" \
    --max_len "${maxlen}" --truncation_side left \
    --target_modules "${TARGET_MODULES}" \
    --fisher_device "${FISHER_DEVICE}" \
    --log_every "${LOG_EVERY}" \
    --output_path "${out_path}" \
    "${args[@]}"
  ls -lh "${out_path}"
}

for domain in "${ACTIVE_DOMAINS[@]}"; do
  if [[ "${WHAT}" == "cov" || "${WHAT}" == "both" ]]; then
    collect_cov_one "${domain}"
  fi
  if [[ "${WHAT}" == "fisher" || "${WHAT}" == "both" ]]; then
    collect_fisher_one "${domain}"
  fi
done

# ===========================================================================
# Step 4: mix —— 一份矩阵同时保两个域
#
# 单域臂只证明了"C 采自哪个域，就保住哪个域"。真实的微调场景要保的不止一样
# 东西，而 C 是线性可加的，那么 0.5 C_math + 0.5 C_code 这一份能不能同时保住
# math 和 code？这一臂就是问这个。EWC 那边同理换成 F。
#
# !! mix 臂要报的是两侧分开的数，不是平均分
# 它成立的条件是 math 与 code **都**不比对应的单域臂差得多。一侧保住、另一侧
# 塌了，那就是"矩阵的容量不够，两个域在抢"，这个权衡本身才是结论 —— 平均成
# 一个数会把它藏起来。95 号因此按域分别报 old_val_loss_math / old_val_loss_code，
# 评测也取 math 与 code 两侧的并集。
#
# !! mix 的 λ 是另一把尺子
# C_mix 的 tr(C) 是两份的加权平均，与任何一份单域 C 都不同，同一个 λ 压出来的
# λR/task_loss 就不是一个量。老实按 95 号的 λ=0 标尺法对 mix 重新扫一遍。
#
# !! if 域进不了 mix
# 三个域的 maxlen 不同（if 512、math/code 1024），而 replay 那一侧的
# --replay_max_len 在 train.py 里是全局唯一的，混进来必然有一个域的口径是错的。
# C/F 这一侧虽然只是矩阵相加、看不出这个冲突，但三条臂必须消费同一批旧知识，
# 所以这里也只在 math 与 code 之间混。
# ===========================================================================
mix_inputs_for () {
  local kind="$1" out="" d src
  for d in ${MIX_DOMAINS//,/ }; do
    if [[ "${kind}" == "cov" ]]; then src="$(cov_path_for "${d}")"; else src="$(fisher_path_for "${d}")"; fi
    [[ -n "${src}" ]] || return 1
    out="${out}${out:+,}${src}"
  done
  printf '%s' "${out}"
}

mix_one () {
  local kind="$1" out_path="$2" module="$3"
  local inputs missing=0 item
  inputs="$(mix_inputs_for "${kind}")" || return 1

  for item in ${inputs//,/ }; do
    if [[ ! -f "${item}" ]]; then
      echo "  缺 ${item}" >&2
      missing=1
    fi
  done
  if (( missing )); then
    echo "  跳过 ${kind} mix：参与混合的单域矩阵还没采齐。" >&2
    echo "  先把 ${MIX_DOMAINS} 两个域的这一类矩阵采完再重投（已有的会跳过）。" >&2
    return 0
  fi
  if [[ -f "${out_path}" && "${FORCE_MIX}" != "1" ]]; then
    echo "  已存在，跳过 ${kind} mix: ${out_path}（要重合成传 FORCE_MIX=1）"
    return 0
  fi

  echo
  echo "==== Step 4: 合成 ${kind} mix -> ${out_path} ===="
  echo "  ${inputs}"
  echo "  权重 ${MIX_WEIGHTS}"
  # mix_fishers 还有一档 --equalize mean（按 mean(F) 归一后两域等贡献）。这里
  # 走的是裸等系数，与 C 那边 0.5/0.5 的口径对应；两档的 λ 不通用，要另扫。
  python -m "onereplay.${module}" \
    --inputs "${inputs}" \
    --weights "${MIX_WEIGHTS}" \
    --output_path "${out_path}"
  ls -lh "${out_path}"
}

if [[ "${DO_MIX}" == "1" ]]; then
  for d in ${MIX_DOMAINS//,/ }; do
    case "${d}" in
      math|code) ;;
      if)
        echo "!! MIX_DOMAINS 里不能有 if：它的 maxlen 是 512 而 math/code 是 1024，" >&2
        echo "   而 train.py 的 --replay_max_len 是全局唯一的，replay 那一侧必然有" >&2
        echo "   一个域的口径是错的。见 Step 4 的说明。" >&2
        exit 2
        ;;
      *) echo "!! MIX_DOMAINS 里的 '${d}' 不认识，只能是 math / code" >&2; exit 2 ;;
    esac
  done
  if [[ "${WHAT}" == "cov" || "${WHAT}" == "both" ]]; then
    mix_one cov "${MIX_COV}" mix_covariances
  fi
  if [[ "${WHAT}" == "fisher" || "${WHAT}" == "both" ]]; then
    mix_one fisher "${MIX_FISHER}" mix_fishers
  fi
fi

# ===========================================================================
# Step 5: 诊断
#   1) 层覆盖断言 —— regularizer 对缺矩阵的层是**静默跳过**的，拿一份少了层的 C
#      去训，训练照跑 loss 照降，要到看结果时才发现方法被削掉一大半。
#   2) lm_head 与其余层的量级对比 —— 它 tie 着 embed_tokens，见文件头。
#   3) C 与 F 的 pool_fingerprint 必须逐域相等 —— 两条臂同源的唯一证据。
#   4) 两个 λ 起点。C 和 F 的网格完全不通用：前者罚 tr(ΔW C ΔWᵀ)、后者
#      Σ F_ij ΔW_ij²，量纲和量级都不是一回事。而且这两个数只是数量级参考，
#      本线真正的中心点要靠 95 号的 λ=0 标尺法实测（ΔW 那一侧 trace 看不见）。
# ===========================================================================
if [[ "${DO_DIAG}" == "1" ]]; then
  echo
  echo "==== Step 5: 诊断 ===="
  python - <<'PY'
import json, os

import torch

model_dir = os.path.join(os.environ["MODEL_DIR"], os.environ["MODEL_NAME"])
with open(os.path.join(model_dir, "config.json"), encoding="utf-8") as fh:
    cfg = json.load(fh)
layers = cfg["num_hidden_layers"]
targets = [m.strip() for m in os.environ["TARGET_MODULES"].split(",") if m.strip()]
# lm_head 只有一个，其余每类每层一个。
expect = sum(1 if m == "lm_head" else layers for m in targets)
print(f"层覆盖期望 = {expect}（{len(targets)} 类 x {layers} 层，lm_head 只算一个）")


def load(path):
    """mmap 读：诊断只看对角线，不必把整份矩阵拉进常驻内存。"""
    try:
        return torch.load(path, map_location="cpu", mmap=True)
    except (TypeError, RuntimeError):
        return torch.load(path, map_location="cpu")


def class_of(name):
    return name.rsplit(".", 1)[-1]


failures = []
active = [
    d for d, key in (("if", "DO_IF"), ("math", "DO_MATH"), ("code", "DO_CODE"))
    if os.environ.get(key, "0") == "1"
]
# mix 的两份矩阵走同一套检查：层覆盖、量级、以及 C 与 F 是否同池。它们是相加
# 出来的，所以指纹一致与否取决于两份输入是否同池，这里查一遍比事后猜省事。
if os.environ.get("DO_MIX", "0") == "1":
    active.append("mix")

for domain in active:
    if domain == "mix":
        cov_path = os.environ["MIX_COV"]
        fisher_path = os.environ["MIX_FISHER"]
    else:
        cov_path = os.environ[f"{domain.upper()}_COV"]
        fisher_path = os.environ[f"{domain.upper()}_FISHER"]
    fingerprints = {}
    print()
    print(f"================ {domain} ================")

    if os.path.isfile(cov_path):
        payload = load(cov_path)
        covs = payload["covariances"]
        meta = payload.get("metadata", {})
        print(f"---- C: {cov_path}")
        print(f"     层数 {len(covs)} / 期望 {expect}")
        if meta.get("type") == "weighted_covariance_mix":
            # 相加出来的矩阵没有自己的池：它的口径是两份输入的口径，所以报输入。
            print(f"     inputs  = {meta.get('inputs')}")
            print(f"     weights = {meta.get('weights')}")
            for src in meta.get("source_metadata", []) or []:
                print(f"       源: pool_rows={src.get('pool_rows')} max_len={src.get('max_len')}"
                      f" supervision={src.get('cov_supervision')}")
        else:
            print(f"     pool_rows={meta.get('pool_rows')} max_len={meta.get('max_len')}")
            print(f"     supervision={meta.get('cov_supervision')} system={meta.get('system_prompt')!r}")
        fingerprints["C"] = meta.get("pool_fingerprint")
        if len(covs) != expect:
            got = sorted({class_of(k) for k in covs})
            failures.append(f"{domain}: C 层覆盖 {len(covs)} != {expect}，实际模块类 {got}")

        per_class = {}
        for name, mat in covs.items():
            # tr(C)/d = 每个方向的平均能量，跨维度可比；tr(C) 本身会被 d 拉着走。
            per_class.setdefault(class_of(name), []).append(
                float(torch.diagonal(mat).float().mean())
            )
        print(f"     {'module':<10} {'层数':>4} {'mean tr(C)/d':>16}")
        for cls in targets:
            vals = per_class.get(cls, [])
            if vals:
                print(f"     {cls:<10} {len(vals):>4} {sum(vals)/len(vals):>16.4e}")

        # lm_head 与 embed_tokens 是同一个张量（tie_word_embeddings），约束它等于
        # 连输入嵌入一起约束。它比其余层大几个数量级的话，λ 实际主要压在输出头上，
        # 那是结果里必须写明的一件事，不是可以默认的实现细节。
        head = per_class.get("lm_head", [])
        others = [v for cls, vals in per_class.items() if cls != "lm_head" for v in vals]
        if head and others:
            ratio = head[0] / (sum(others) / len(others))
            print(f"     lm_head / 其余层均值 = {ratio:.2f}x")
            if ratio > 10 or ratio < 0.1:
                print("     !! 量级差 10 倍以上：这份 C 的罚项主要落在输出头/输入嵌入上。")
                print("        不是错误，但读结果时要说明，别写成'均匀约束了 all-linear'。")

        allv = [v for vals in per_class.values() for v in vals]
        if allv:
            mean_c = sum(allv) / len(allv)
            print(f"     全层 mean tr(C)/d = {mean_c:.4e}")
            print(f"     -> OneReplay λ 的数量级参考 1/{mean_c:.3e} = {1.0/mean_c:.3e}")
            print("        !! 只是数量级。本线的中心点要用 95 号的 λ=0 标尺法实测：")
            print("           λ ≈ 目标占比 x task_loss / R(λ=0)，trace 看不见 ΔW 那一侧。")
    else:
        print(f"---- C: 未生成，跳过 ({cov_path})")

    if os.path.isfile(fisher_path):
        payload = load(fisher_path)
        fishers = payload.get("fishers") or payload["covariances"]
        meta = payload.get("metadata", {})
        lw = meta.get("length_weighting", {}) or {}
        scale = meta.get("fisher_scale", {}) or {}
        print(f"---- F: {fisher_path}")
        print(f"     层数 {len(fishers)} / 期望 {expect}")
        if meta.get("inputs") and meta.get("weights") is not None:
            print(f"     inputs  = {meta.get('inputs')}")
            print(f"     weights = {meta.get('weights')}  mode={meta.get('mode')}")
        else:
            print(f"     样本数 {meta.get('num_examples')}  pool_rows={meta.get('pool_rows')}")
            print(f"     max_len={meta.get('max_len')}")
        print(f"     mean(F)={scale.get('mean')}  max(F)={scale.get('max')}")
        fingerprints["F"] = meta.get("pool_fingerprint")
        if len(fishers) != expect:
            failures.append(f"{domain}: F 层覆盖 {len(fishers)} != {expect}")
        if scale.get("mean"):
            print(f"     -> EWC λ 从 1/mean = {1.0/float(scale['mean']):.3e} 附近起步，按十倍展开")
        ess = lw.get("effective_sample_size")
        n = meta.get("num_examples")
        if ess and n:
            # F 实际靠多少条样本撑着。C 的收敛靠 token 数、余量三位数倍，从来不是
            # 瓶颈；F 是按样本平均且梯度长尾，所以要不要加量看这个数，不看行数。
            ratio = ess / n
            print(f"     effective_sample_size {ess:.0f} / {n} ({ratio:.3f})")
            print(f"     对角元素相对误差约 {1.0/max(ess, 1)**0.5:.1%}")
            print(f"     length_exponent a={lw.get('length_exponent')} (1=逐token独立, 2=完全对齐)")
            # 0.2 不是理论阈值，是"比历史上 gold 数据的 0.336 明显差"这条经验线。
            if ratio < 0.2:
                print(f"     !! ESS 比值 {ratio:.3f} 偏低（gold 数据历史值约 0.336）")
                print("        F 被少数长样本主导，先查池里的长尾再考虑加量")
    else:
        print(f"---- F: 未生成，跳过 ({fisher_path})")

    have = {k: v for k, v in fingerprints.items() if v}
    if len(have) == 2:
        if have["C"] != have["F"]:
            print(f"     !! 池指纹不一致  C={have['C']}  F={have['F']}")
            failures.append(f"{domain}: C 与 F 的 pool_fingerprint 不等")
        else:
            print(f"     C 与 F 同池: {have['C']}")
    elif domain == "mix":
        # 相加出来的矩阵没有自己的指纹。它的同池性由两份输入决定，而那两份
        # 在上面各自的小节里已经查过了。这里说一句，免得这行空白被读成"没查"。
        print("     mix 没有自己的池指纹（它是相加出来的）；同池性看上面 "
              f"{os.environ.get('MIX_DOMAINS', '')} 各自那两节。")
    elif len(fingerprints) == 1:
        print("     只采了一半，另一半采完后重跑 WHAT=none 复核同池。")

if failures:
    print()
    print("!! 诊断未通过:")
    for item in failures:
        print(f"   - {item}")
    print("   层覆盖不足：regularizer 会静默跳过缺矩阵的层，方法被削掉一部分而不报错。")
    print("   池指纹不等：EWC 和 OneReplay 消费的旧知识不是同一批，对比不再公平；")
    print("   查 pool_args_for 里 max_samples / sample_shuffle / sample_seed 是否两段同值。")
    raise SystemExit(1)
print()
print("诊断通过。")
PY
fi

echo
echo "========================================================================"
echo "采集完成。产物："
ls -lh "${COV_DIR}" "${FISHER_DIR}" 2>/dev/null || true
echo
echo "池与 val 切片（95 号的三条臂读前者，val loss 读后者）："
ls -lh "${SPLIT_DIR}" 2>/dev/null || true
echo
echo "下一步："
echo "  1) 没采的那一半接着投：WHAT=cov 或 WHAT=fisher（已有的会自动跳过）"
echo "  2) 拿 collect_fisher 打印的 ms/example 校准 ETA_MS_PER_EXAMPLE 再投下一批"
echo "  3) 先跑 94 号拿 base 与 vanilla 这两个分母（λ 标定要用它的 task_loss，"
echo "     score_retention_subset 的子集也由 base 定义）："
echo "       qsub -v DRY_RUN=0 onereplay/pbs/94_finance_probe.pbs"
echo "  4) 再用 95 号扫 λ，每个域每个方法各一次（两条臂的尺度不通用）："
echo "       qsub -v DRY_RUN=0,DOMAIN=if,ARM=onereplay,LAMBDAS=0:a:b:c onereplay/pbs/95_finance_arms.pbs"
echo "       qsub -v DRY_RUN=0,DOMAIN=if,ARM=ewc,LAMBDAS=0:a:b:c       onereplay/pbs/95_finance_arms.pbs"
echo "     mix 臂同理，它是第四个 DOMAIN（λ 要另扫，C_mix 的 tr(C) 与单域的不同）："
echo "       qsub -v DRY_RUN=0,DOMAIN=mix,ARM=onereplay,LAMBDAS=0:a:b:c onereplay/pbs/95_finance_arms.pbs"
echo "========================================================================"
