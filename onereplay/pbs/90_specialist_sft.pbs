#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N spec_sft
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o  /scratch/weiliu87/student/czq/Onereplay/logs

# =============================================================================
# 三个领域 specialist 的 Stage 1：Qwen3-4B-Base -> M_math / M_medical / M_code
#
#   qsub -v DOMAIN=math    ,MODE=data  onereplay/pbs/90_specialist_sft.pbs
#   qsub -v DOMAIN=math    ,MODE=train onereplay/pbs/90_specialist_sft.pbs   # 训练+评测
#   qsub -v DOMAIN=math    ,MODE=eval  onereplay/pbs/90_specialist_sft.pbs   # 只评测
#   qsub -v DOMAIN=medical ,MODE=data  onereplay/pbs/90_specialist_sft.pbs
#   qsub -v DOMAIN=code    ,MODE=data  onereplay/pbs/90_specialist_sft.pbs
#   ...
#
# 第三臂原本是 finance（ODA-Fin-SFT-318k），已换成 code。换的原因不是数据脏而是
# 领域边界：那份语料"金融"标签下混着编程题、语法改写、多语种实体抽取，训练信号和
# FinQA/ConvFinQA/TAT-QA 要考的东西对不上，再怎么过滤也补不回来。code 没有这个
# 问题——HumanEval 和 MBPP 要的正是 Magicoder 教的。finance 的 prepare 和 metric
# 都留着，传 EVAL_DOMAINS="math medical finance" 可以回到旧配置。
#
# 1. 为什么是一个脚本而不是三个
# -----------------------------
# 三个 specialist 存在的意义是之后拿来比较（Math->Medical 会不会忘掉 Math），
# 而比较成立的前提是**除了数据以外什么都没变**。三份脚本意味着三份可以各自漂移的
# 超参：某次只在 medical 那份上调了 BATCH，半年后没人记得，于是"finance 比 medical
# 差"里混进了一个 batch size 差。
#
# 所以超参在这里**只有一份**，DOMAIN 只切换三样东西：数据集路径、结果目录、以及
# MODE=data 时调用哪个 prepare 脚本。下面 pick_domain 之后的所有训练参数对三个领域
# 逐字相同，这是脚本结构保证的，不是靠人记得。
#
# 2. 相对旧 Math 线改了什么
# -------------------------
# 旧的 91_s1_train_math.pbs（已随 IF/CS 线一起删除，要查就翻 git 历史）是这条线的
# reference，下面的 LR / scheduler / warmup /
# ACCUM / VAL_FRAC / TARGET_MODULES / SYSTEM_PROMPT 全部逐字照抄。只有三处不同，
# 每一处都是**三个领域一起变**，所以领域之间仍然是同口径：
#
#   MAXLEN  2048 -> 4096
#     旧线把长度交给训练时截断，而 tokenizer_to_ids 是 full_ids[-max_length:]，
#     **保尾丢头**——被砍掉的是题干开头，留下的是答案。对 Numina 影响很小（p99≈1462），
#     但 MedQA 的 R1 轨迹和 ODA-Fin 的 235B 蒸馏 CoT 在 2048 下会被大量砍掉，而且砍掉的
#     不是随机样本，是**所有长推理样本**，剩下的全是简单题。现在长度在数据侧解决：
#     prepare_* 把超过 4096 的整行丢掉，所以训练时永远不会触发截断那条路径。
#
#   BATCH   4 -> 2       （ACCUM 保持 64）
#     纯粹是 4096 序列的显存代价。**有效 batch 没变**：trainer 里
#     accum_steps = accumulation_size // batch_size，旧线是 64//4 = 16 步 x 4 行 = 64 行/update，
#     这里是 64//2 = 32 步 x 2 行 = 64 行/update。优化器看到的东西逐字相同，只是慢一倍。
#     **如果还 OOM，改 BATCH 就够了，不要动 ACCUM**；且三个领域必须用同一个值，
#     所以改了就三个都重跑。
#
#   SEED    1 -> 42
#     和 prepare_* 的采样 seed 对齐，全线一个数。Math 因此要重训，这是已知的。
#
# 3. SYSTEM_PROMPT 必须和数据准备时逐字一致
# -----------------------------------------
# 这不是风格问题，是**长度正确性**问题。system turn 会贡献 token，而 4096 那条线是在
# prepare_* 里按"含 system 的完整序列"算出来的。训练时传一个不同的 system（哪怕只差
# 一个标点），每行长度都会平移，prepare 保证的"没有一行会被截断"就不再成立，而且不会
# 报错。所以这里的默认值 = common.DEFAULT_SYSTEM_PROMPT = 旧线 SYSTEM_PROMPT_PRESET=auto
# 展开出来的那一条，三处必须同时改或都不改。
#
# 至于为什么不干脆留空：Qwen3-4B-Base 的模板不像 Qwen2.5-Math 那样自动注入
# \boxed{} 指令，留空的话**没训练过的 base 臂根本不会写 \boxed{}**，评分器找不到答案
# span 而给近乎 0 分，训练后的模型因为从数据里学会了格式而正常——那个差值是度量误差，
# 不是学习效果，会把每一个 before/after 都夸大。
#
# 3b. 为什么 system prompt 有两条而不是一条
# ----------------------------------------
# math 和 medical 的答案都归一到了 \boxed{}（Medical 的 <answer>X</answer> 在
# prepare 阶段改写过），同一条指令对两者都成立。code 不行：代码答案放不进
# \boxed{}，code_exec.py 提的是 markdown fence，两套提取器互不相干。给代码题发
# boxed 指令的结果是所有模型一起提不出答案、pass@1 掉到地板上，而那会被读成
# "灾难性遗忘"。
#
# 所以 SYSTEM_PROMPT_BOXED 和 SYSTEM_PROMPT_CODE 并存，前半句逐字相同，差异只在
# "最终答案放哪"这一个从句。**训练**用哪条由 DOMAIN 决定，**评测**用哪条由
# benchmark 决定（见 run_group）——同一个 benchmark 下所有模型必须收到同一条指令，
# 否则横向不可比。跨域评测时模型会收到训练时没见过的那条，那正是"没学过这个域"的
# 真实表现，不是度量误差。
#
# system prompt 属于数据序列化格式，不在第 1 条要求三域统一的那批训练超参里。
#
# 4. 训练完直接接评测，同一个作业，不用再投一次
# ---------------------------------------------
# MODE=train 跑完会**在本脚本里**接着评测，没有第二个脚本要投。评测口径因此只有
# 一份，不会出现"训练脚本里的评测"和"独立评测脚本"各算各的这种漂移。
#
# 评的是交叉矩阵：M_<DOMAIN> 在 EVAL_DOMAINS（默认 math / medical / code）全评，base 只评当前
# DOMAIN 这一边。"学会了新领域"和"没忘掉别的领域"是两个问题，只评自己那边只能回答
# 前一个，而后一个才是这项研究要问的。base 是三条线共用的同一个 checkpoint，让三个
# DOMAIN 各自重评三边等于把同一组数字算三次，还会往 csv 里塞重复行。
#
# walltime 必须够训练 + 评测两段。不够也不会丢东西：checkpoint 在就跳过训练，评测
# 组只要有 summary.json 就跳过，原样重投会从断点接着跑。DO_EVAL=0 则只训不评。
#
# 只想评不想训的场合用 MODE=eval，配 WHICH 选评谁：
#   qsub -v DOMAIN=math,MODE=eval,WHICH=base   ...   # 只看 base 的分数
#   qsub -v DOMAIN=math,MODE=eval              ...   # 训练早跑完了，补评/续评
#   qsub -v DOMAIN=math,MODE=eval,FORCE=1      ...   # 改了 metric，推翻重算
#
# 评测太慢想砍掉某一组用 SKIP_GROUPS（比 EVAL_DOMAINS 细一档，按解码组而不是按域）：
#   qsub -v DOMAIN=code,MODE=train,SKIP_GROUPS=math_hard ...
# math_hard（minervamath）是最值得砍的一组：4096 上限配 avg@4，而**不会做的模型
# 反而最慢**——答不出来就不收尾，四遍都顶到上限。见 SKIP_GROUPS 那里的完整说明。
#
# 5. benchmark 放在哪，为什么两套命名
# -----------------------------------
# math 三件沿用这条线一直用的 datasets/math/<name>_test.jsonl：gsm8k 和 math500
# 早就在集群上了，没有理由为了好看再下一遍或挪位置——挪了反而让旧结果和新结果对不
# 上账。medical / finance 六件是新加的，走 datasets/bench/<name>/。code 两件走
# 第三套 datasets/code/，因为 HumanEval/MBPP 早就由 download_code_data.py 管着，
# 那条线还有别的脚本在用。三套命名不统一是历史的直接结果，不是疏忽。缺哪件，本脚本
# 会在**开跑前**就把路径打出来（只查 EVAL_DOMAINS 里真的会评的那几个域）。
# math/medical/finance 的数据用 test_code/download_bench.py 下，code 的用
# onereplay.scripts.download_code_data。
#
# MBPP 必须用 test split（500 题）。evaluate.py 的 --dataset_split 默认是
# validation，那只有 90 题，pass@1 的抽样噪声能盖过真实差异。MBPP_SPLIT 默认已经
# 是 test，别改。
#
# 6. 这一阶段严格禁止的事
# -----------------------
# 三个模型必须各自从**同一个** Qwen3-4B-Base 独立训练：不 warm-start（不许
# M_math -> Medical）、不 replay、不掺通用数据、不做 teacher 生成、不做 RL。
# 下面的 --replay_lambda 0 和 --replay_dataset_path 缺省是写死的，不要加回来。
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/90_specialist_sft.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_spec_${JOBTAG}}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_spec_${JOBTAG}}"
  EXTRA_BIND=""
fi

# ---- 只有这三样跟着 DOMAIN 变 ----
DOMAIN="${DOMAIN:-}"
MODE="${MODE:-train}"

# ---- 原始语料（离线，必须在登录节点先下好）----
# 计算节点上 HF_HUB_OFFLINE=1，prepare_* 走不了 Hub，所以这三条都得是本地路径。
NUMINA_PATH="${NUMINA_PATH:-${REPO_ROOT}/datasets/raw/NuminaMath-CoT/data}"
MEDQA_PATH="${MEDQA_PATH:-${REPO_ROOT}/datasets/raw/MedQA-5options}"
FIN_JSON="${FIN_JSON:-${REPO_ROOT}/datasets/raw/ODA-Fin-SFT-318k/train.json}"
# download_magicoder_data.py 的落点，和 code_replay 那条线共用同一份 parquet。
MAGICODER_PATH="${MAGICODER_PATH:-${REPO_ROOT}/datasets/code_replay/magicoder_oss_instruct_75k.parquet}"

# =============================================================================
# 外层：裸计算节点，只负责起容器再把自己跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]]    || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_spec_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME RESULTS_ROOT METRICS_DIR CKPT_DIR
    DOMAIN MODE DRY_RUN SEED DO_EVAL
    BENCH_ROOT EVAL_ROOT LIMIT WHICH FORCE
    GSM8K_DATA MATH500_DATA MINERVA_DATA
    MEDQA_DATA PUBMEDQA_DATA MEDXPERTQA_DATA
    FINQA_DATA CONVFINQA_DATA TATQA_DATA
    MATH_BATCH MEDICAL_BATCH FINANCE_BATCH CODE_BATCH CODE_TIMEOUT
    CODE_DATA_DIR HUMANEVAL_DATA MBPP_DATA MBPP_SPLIT EVAL_DOMAINS SKIP_GROUPS
    HUMANEVALPLUS_DATA MBPPPLUS_DATA
    NUMINA_PATH MEDQA_PATH FIN_JSON MAGICODER_PATH LANG_FILTER
    DECONTAM_NGRAM DECONTAM_MIN_HITS
    DATA_ROOT PROCESSED_DIR STATS_DIR DATASET_DIR
    EPOCHS LR LR_SCHEDULER WARMUP_RATIO BATCH ACCUM MAXLEN VAL_FRAC MAXVAL
    TARGET_MODULES SYSTEM_PROMPT MAX_TRAIN_SAMPLES LOG_EVERY SMOKE_STEPS
    SAMPLE_ROWS MAX_TRACES NEAR_DUP_THRESHOLD MAX_SOURCE_RATIO FIN_LANGUAGE
    EVAL_SOURCE_PATTERNS TARGET_ROWS
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e --nv -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv

cd "${REPO_ROOT}"

# ---- 模型 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
# 三个 specialist 必须从**完全相同**的这一个 checkpoint 起步。
MODEL_NAME="${MODEL_NAME:-Qwen3-4B-Base}"

# ---- 数据产物布局 ----
DATA_ROOT="${DATA_ROOT:-${REPO_ROOT}/data}"
PROCESSED_DIR="${PROCESSED_DIR:-${DATA_ROOT}/processed}"
STATS_DIR="${STATS_DIR:-${DATA_ROOT}/stats}"

# =============================================================================
# 训练超参：**这一段对三个领域逐字相同**，来自已删除的 91_s1_train_math.pbs。
# 想调任何一个，就是三个领域一起重跑，否则它们不再可比。
# =============================================================================
EPOCHS="${EPOCHS:-1}"
LR="${LR:-5e-5}"
LR_SCHEDULER="${LR_SCHEDULER:-cosine}"
WARMUP_RATIO="${WARMUP_RATIO:-0.1}"
# 见文件头第 2 条：BATCH 是显存参数，ACCUM 才是"每次更新多少行"。
# accum_steps = ACCUM / BATCH = 32，effective batch = ACCUM = 64 行/update，和旧线一致。
BATCH="${BATCH:-2}"
ACCUM="${ACCUM:-64}"
MAXLEN="${MAXLEN:-4096}"
VAL_FRAC="${VAL_FRAC:-0.01}"
MAXVAL="${MAXVAL:-200}"
TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj,lm_head}"
SEED="${SEED:-42}"
MAX_TRAIN_SAMPLES="${MAX_TRAIN_SAMPLES:-0}"
LOG_EVERY="${LOG_EVERY:-500}"
SMOKE_STEPS="${SMOKE_STEPS:-70}"
DRY_RUN="${DRY_RUN:-0}"
# MODE=train 跑完直接接交叉评测。DO_EVAL=0 只训不评（之后用 MODE=eval 补）。
DO_EVAL="${DO_EVAL:-1}"

# 见文件头第 3 条：这一条和 prepare_* 的 --system_prompt 必须逐字相同。
# 文本里有逗号，qsub -v 用逗号分隔变量，所以要覆盖它得改这里而不是 -v。
#
# 不能写成 ${SYSTEM_PROMPT:-...\\boxed{}.}：参数展开找闭合括号时不跟踪嵌套，会在
# \boxed{} 自己那个 } 上提前收尾，默认值只取到 "...\boxed{"，剩下的 ".}" 作为双引号
# 内的字面量接在后面，实得 "\boxed{.}"。头一版 math / medical 的池子就是带着这个
# 错的 system turn 建的。用独立赋值绕开展开，单引号避免反斜杠再被吃一层。
#
# 为什么是两条不是一条：代码答案放不进 \boxed{}。code_exec.py 提的是 markdown
# fence，和 boxed 提取器是互不相干的两套；给代码题发 boxed 指令的结果是答案提
# 不出来、pass@1 掉到地板上，而那会被误读成"灾难性遗忘"。两条的前半句逐字相同，
# 差异被压在"最终答案放哪"这一个从句上——这是能做到的最小差异，再小就要牺牲某
# 一边的正确性。system prompt 属于数据序列化格式，不在必须三域统一的那批训练
# 超参（optimizer / lr / scheduler / batch / precision / loss mask）里。
SYSTEM_PROMPT_BOXED='Please reason step by step, and put your final answer within \boxed{}.'
SYSTEM_PROMPT_CODE='Please reason step by step, and put your final code in a Python code block.'

# 训练用哪条由 DOMAIN 决定；评测用哪条由 **benchmark** 决定，见 run_group。
# 这里 DOMAIN 可能还是空（校验在后面），落到 boxed 无妨，后面会退出。
if [[ -z "${SYSTEM_PROMPT:-}" ]]; then
  case "${DOMAIN}" in
    code) SYSTEM_PROMPT="${SYSTEM_PROMPT_CODE}" ;;
    *)    SYSTEM_PROMPT="${SYSTEM_PROMPT_BOXED}" ;;
  esac
fi

# ---- 各领域 prepare 的可调项（只影响数据，不影响训练超参）----
SAMPLE_ROWS="${SAMPLE_ROWS:-100000}"          # math：目标池大小
MAX_TRACES="${MAX_TRACES:-4}"                 # medical：每题最多几条正确轨迹
NEAR_DUP_THRESHOLD="${NEAR_DUP_THRESHOLD:-0.8}"
MAX_SOURCE_RATIO="${MAX_SOURCE_RATIO:-0.15}"  # finance：单一 source 上限
FIN_LANGUAGE="${FIN_LANGUAGE:-en}"
EVAL_SOURCE_PATTERNS="${EVAL_SOURCE_PATTERNS:-finqa tat-qa tatqa tat_qa convfinqa}"
TARGET_ROWS="${TARGET_ROWS:-0}"               # finance/code：0 = 过滤后剩多少用多少
# code：要哪些语言。默认 all —— benchmark 全是 Python，但 OSS-Instruct 论文的
# 消融（Table 5，CodeLlama-Python-7B）说只留 Python 反而更差：
#
#   不微调 34.1 / 只用 Python(43K) 47.6 / 只用非 Python(32K) 44.5 / 全量(75K) 55.5
#           ——都是 HumanEval+ pass@1
#
# 非 Python 那一半不是稀释，是净贡献：光用它训练就能把 Python 从 34.1 提到 44.5。
# 顺带池子翻倍，token 量和另外两臂的差距也小一截。
# python / python_strict 可以退回只要 Python；注意论文是按 ```python 分类的，
# **不**按 lang 列，因为 OSS-Instruct 可以生成与种子不同的语言。
LANG_FILTER="${LANG_FILTER:-all}"
# code 去污染：13 词窗口、至少撞 2 个窗口才算抄。用 8 词/撞 1 个的老口径会刷掉
# 8% 的语料，其中 86% 栽在两句 GPT 写编程题的口头禅上（"your task is to
# implement a function that" 之类，取自 HumanEval 的 docstring）。
DECONTAM_NGRAM="${DECONTAM_NGRAM:-13}"
DECONTAM_MIN_HITS="${DECONTAM_MIN_HITS:-2}"

# =============================================================================
# 评测配置
# =============================================================================
# base | trained | both。MODE=train 之后固定走 both（base 那半有结果就自动跳过）。
WHICH="${WHICH:-both}"
# 1 = 已有 summary.json 也重算。改了 metric 实现时才用。
FORCE="${FORCE:-0}"
LIMIT="${LIMIT:-0}"                           # >0 只评前 N 题，冒烟用

# medical 的解码预算。必须 >= 训练池的 MAXLEN，因为那是 prompt+response 的总长，
# 蒸馏进来的长 CoT 响应本身就能接近它。2048 时 m_medical 在 medqa 上有 41% 的回答
# 顶到上限，没抽到答案的 416 题**全部**是截断（无一例格式不服从），accuracy 被压到
# 54.99% 而抽到答案的那 857 题里对了 81.68%。base 答得短、不受影响，所以这个预算
# 会给每一个"训练后退化"的 delta 掺进一份纯伪影。
MEDICAL_MAX_NEW="${MEDICAL_MAX_NEW:-4096}"

# 评测结果**跨 DOMAIN 共用一个根**：每个 <metric>_summary.csv 才能把 base 和三个
# specialist 攒成一张表。分开放就得手工拼。
EVAL_ROOT="${EVAL_ROOT:-${REPO_ROOT}/results_specialist_eval}"

# ---- benchmark 数据（离线，登录节点先下好）----
# 见文件头第 5 条：math 沿用旧布局，medical/finance 走新的 bench 目录。
MATH_DATA_DIR="${MATH_DATA_DIR:-${REPO_ROOT}/datasets/math}"
BENCH_ROOT="${BENCH_ROOT:-${REPO_ROOT}/datasets/bench}"
GSM8K_DATA="${GSM8K_DATA:-${MATH_DATA_DIR}/gsm8k_test.jsonl}"
MATH500_DATA="${MATH500_DATA:-${MATH_DATA_DIR}/math500_test.jsonl}"
MINERVA_DATA="${MINERVA_DATA:-${MATH_DATA_DIR}/minervamath_test.jsonl}"
MEDQA_DATA="${MEDQA_DATA:-${BENCH_ROOT}/medqa/test.jsonl}"
PUBMEDQA_DATA="${PUBMEDQA_DATA:-${BENCH_ROOT}/pubmedqa/test.jsonl}"
MEDXPERTQA_DATA="${MEDXPERTQA_DATA:-${BENCH_ROOT}/medxpertqa/test.jsonl}"
FINQA_DATA="${FINQA_DATA:-${BENCH_ROOT}/finqa/test.jsonl}"
CONVFINQA_DATA="${CONVFINQA_DATA:-${BENCH_ROOT}/convfinqa/dev_turn.json}"
TATQA_DATA="${TATQA_DATA:-${BENCH_ROOT}/tatqa/tatqa_dataset_dev.json}"
# code 走的是另一套目录（download_code_data.py 的产物），不在 bench 下。
CODE_DATA_DIR="${CODE_DATA_DIR:-${REPO_ROOT}/datasets/code}"
HUMANEVAL_DATA="${HUMANEVAL_DATA:-${CODE_DATA_DIR}/humaneval_test.parquet}"
MBPP_DATA="${MBPP_DATA:-${CODE_DATA_DIR}/mbpp_full}"
# EvalPlus：同样的题、约 80 倍的测试用例。基础版那 9 条/3 条测试少到能让错解通过，
# 加号版就是冲这个去的。注意 MBPP+ 只有 378 题（EvalPlus 删掉了题意含糊和参考解
# 本身就错的），题目集和 MBPP 的 500 题不同，两个分数并列看、不能当 before/after。
HUMANEVALPLUS_DATA="${HUMANEVALPLUS_DATA:-${CODE_DATA_DIR}/humanevalplus_test.parquet}"
MBPPPLUS_DATA="${MBPPPLUS_DATA:-${CODE_DATA_DIR}/mbppplus_test.parquet}"
# !! 必须是 test（500 题）。evaluate.py 的默认值是 validation，那只有 90 题，
# pass@1 的抽样噪声能盖过真实差异。
MBPP_SPLIT="${MBPP_SPLIT:-test}"

MATH_BATCH="${MATH_BATCH:-128}"
MEDICAL_BATCH="${MEDICAL_BATCH:-64}"
# 财报 prompt 动辄几千 token，KV cache 吃得比别的组狠，batch 必须压下来。
FINANCE_BATCH="${FINANCE_BATCH:-32}"
# 代码只解 512 token，prompt 也短，所以能开大。
CODE_BATCH="${CODE_BATCH:-64}"
# 判分在子进程里 exec 生成的代码，卡死的那条会拖住整组。
# 0 = 各 metric 用自己的默认值：基础版 5 秒，EvalPlus 30 秒。加号版每题跑的断言
# 多约 80 倍，5 秒会把正确答案判成超时，而超时记作失败——那是所有臂共同的扣分，
# 看上去就像大家都变差了。要统一覆盖就在这里给个非 0 值。
CODE_TIMEOUT="${CODE_TIMEOUT:-0}"

# =============================================================================
# DOMAIN 分派：只决定数据在哪、结果写哪、MODE=data 调谁。
# =============================================================================
case "${DOMAIN}" in
  math|medical|code|finance) ;;
  "") echo "必须指定 DOMAIN=math|medical|code" >&2; exit 2 ;;
  *)  echo "DOMAIN 只能是 math / medical / code / finance，得到 '${DOMAIN}'" >&2; exit 2 ;;
esac

# 一个 specialist 要在哪几个领域上评。finance 那一臂因为语料的领域边界不干净
# （"金融"标签下混着编程题、语法题、医疗记录抽取）被换成了 code，但它的 metric
# 和 prepare 都留着：传 EVAL_DOMAINS="math medical finance" 就能回到旧配置。
EVAL_DOMAINS="${EVAL_DOMAINS:-math medical code}"

# 按**解码组**关掉评测，比 EVAL_DOMAINS 细一档：math 一个域下有 math_std
# （gsm8k+math500，贪心 2048）和 math_hard（minervamath，4096 配 avg@4）两组，
# 想只去掉后者就得在这一层。可用组名：math_std math_hard medical code finance。
#
# math_hard 是明显的候选。它的成本不是难度带来的而是**不会做**带来的：模型答不出
# 来就不收尾，一路顶到 4096 上限，再乘 4 个采样，跨域评一次能吃掉几个小时，而
# 非数学模型在上面基本贴着 0。
#
#   qsub -v DOMAIN=code,MODE=train,SKIP_GROUPS=math_hard ...
#
# 代价要说清楚：math_hard 一关，M_code / M_medical 在 MinervaMath 上就没有数字，
# 而 M_math 有，"忘了多少"这一栏在这个 benchmark 上就空着。gsm8k 和 math500 仍然
# 覆盖着同一个问题，所以主线结论不受影响；真要补，事后 MODE=eval 不带这个开关
# 单独补跑即可，已有的组会自动跳过。
SKIP_GROUPS="${SKIP_GROUPS:-}"
case "${MODE}" in
  data|smoke|train|eval) ;;
  *) echo "MODE 只能是 data / smoke / train / eval，得到 '${MODE}'" >&2; exit 2 ;;
esac
case "${WHICH}" in
  base|trained|both) ;;
  *) echo "WHICH 只能是 base / trained / both，得到 '${WHICH}'" >&2; exit 2 ;;
esac

DATASET_DIR="${DATASET_DIR:-${PROCESSED_DIR}/${DOMAIN}_train}"
OUT_JSONL="${PROCESSED_DIR}/${DOMAIN}_train.jsonl"
OUT_STATS="${STATS_DIR}/${DOMAIN}_stats.json"

RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_specialist_${DOMAIN}_${MODEL_NAME}}"
METRICS_DIR="${METRICS_DIR:-${RESULTS_ROOT}/metrics}"
CKPT_DIR="${CKPT_DIR:-${RESULTS_ROOT}/checkpoints}"
RUN="specialist_${DOMAIN}_lr${LR}_seed${SEED}"
CKPT="${CKPT_DIR}/${RUN}"
mkdir -p "${METRICS_DIR}" "${CKPT_DIR}" "${PROCESSED_DIR}" "${STATS_DIR}"

echo "================================================================"
echo " DOMAIN      : ${DOMAIN}"
echo " MODE        : ${MODE}"
echo " model       : ${MODEL_DIR}/${MODEL_NAME}"
echo " dataset     : ${DATASET_DIR}"
echo " run         : ${RUN}"
echo " maxlen      : ${MAXLEN}   batch ${BATCH} x accum $((ACCUM / BATCH)) = ${ACCUM} 行/update"
echo " lr          : ${LR} ${LR_SCHEDULER} warmup=${WARMUP_RATIO} epochs=${EPOCHS} seed=${SEED}"
echo " system      : ${SYSTEM_PROMPT}"
if [[ "${MODE}" == "train" || "${MODE}" == "eval" ]]; then
echo " eval        : WHICH=${WHICH} DO_EVAL=${DO_EVAL} FORCE=${FORCE} LIMIT=${LIMIT}"
echo " eval root   : ${EVAL_ROOT}"
echo " math bench  : ${MATH_DATA_DIR}"
echo " 其他 bench  : ${BENCH_ROOT}"
fi
echo "================================================================"

# =============================================================================
# MODE=data：原始语料 -> data/processed/{domain}_train{.jsonl,/}
#
# 三个 prepare 脚本都会打印一张 budget_scan 表（1024/2048/3072/4096/6144/8192 各档
# 会保留多少行、多少 assistant token）。**定 MAXLEN 之前先读它**，尤其是 medical 和
# finance——如果 4096 在某个领域丢掉的行远多于预期，那是该领域数据本身的信息，不是
# 参数填错了。
# =============================================================================
if [[ "${MODE}" == "data" ]]; then
  if [[ -f "${DATASET_DIR}/dataset_dict.json" ]]; then
    echo "拒绝 MODE=data：${DATASET_DIR} 已经是一个 save_to_disk 池。"
    echo "  prepare_* 会整目录覆盖，而已经用它训过的 checkpoint 会就此失去可追溯的数据。"
    echo "  真要重建就先把旧目录挪走，或者指定 DATASET_DIR=<新路径>。"
    exit 3
  fi

  COMMON_ARGS=(
    --tokenizer_path "${MODEL_DIR}/${MODEL_NAME}"
    --system_prompt "${SYSTEM_PROMPT}"
    --max_tokens "${MAXLEN}"
    --seed "${SEED}"
    --out_jsonl "${OUT_JSONL}"
    --out_stats "${OUT_STATS}"
    --out_dir "${DATASET_DIR}"
  )

  case "${DOMAIN}" in
    math)
      [[ -d "${NUMINA_PATH}" ]] || { echo "找不到 NuminaMath: ${NUMINA_PATH}"; exit 1; }
      python -m onereplay.scripts.domain_sft.prepare_math \
        --numina_path "${NUMINA_PATH}" \
        --sample_rows "${SAMPLE_ROWS}" \
        --require_boxed 1 \
        "${COMMON_ARGS[@]}"
      ;;
    medical)
      [[ -e "${MEDQA_PATH}" ]] || { echo "找不到 MedQA: ${MEDQA_PATH}"; exit 1; }
      python -m onereplay.scripts.domain_sft.prepare_medical \
        --medqa_path "${MEDQA_PATH}" \
        --max_traces_per_question "${MAX_TRACES}" \
        --near_dup_threshold "${NEAR_DUP_THRESHOLD}" \
        "${COMMON_ARGS[@]}"
      ;;
    code)
      [[ -e "${MAGICODER_PATH}" ]] || {
        echo "找不到 Magicoder: ${MAGICODER_PATH}"
        echo "  登录节点先跑 python -m onereplay.scripts.download_magicoder_data"
        exit 1
      }
      # HumanEval / MBPP 是这一臂仅有的两个 benchmark，去污染漏一条，报出来的
      # pass@1 就有一部分是背下来的。prepare_code 默认没给评测集就拒绝建池，
      # 这里把路径传全，让它真的能查。
      python -m onereplay.scripts.domain_sft.prepare_code \
        --magicoder_path "${MAGICODER_PATH}" \
        --humaneval_data_file "${HUMANEVAL_DATA}" \
        --mbpp_dataset_path "${MBPP_DATA}" \
        --mbpp_split "${MBPP_SPLIT}" \
        --lang_filter "${LANG_FILTER}" \
        --decontam_ngram "${DECONTAM_NGRAM}" \
        --decontam_min_hits "${DECONTAM_MIN_HITS}" \
        --target_rows "${TARGET_ROWS}" \
        "${COMMON_ARGS[@]}"
      ;;
    finance)
      [[ -f "${FIN_JSON}" ]] || { echo "找不到 ODA-Fin train.json: ${FIN_JSON}"; exit 1; }
      # shellcheck disable=SC2086
      python -m onereplay.scripts.domain_sft.prepare_finance \
        --fin_json "${FIN_JSON}" \
        --language "${FIN_LANGUAGE}" \
        --eval_source_patterns ${EVAL_SOURCE_PATTERNS} \
        --max_source_ratio "${MAX_SOURCE_RATIO}" \
        --target_rows "${TARGET_ROWS}" \
        "${COMMON_ARGS[@]}"
      ;;
  esac

  echo
  echo "==== ${DOMAIN} 数据就绪 ===="
  echo "  训练用 : ${DATASET_DIR}"
  echo "  可审计 : ${OUT_JSONL}"
  echo "  统计   : ${OUT_STATS}"
  echo "三个领域都跑完后，比一下各自的 total_assistant_tokens：那才是 SFT loss 真正"
  echo "作用到的量。差距超过 1.5~2x 的话，再考虑补一个 matched-token 的对照。"
  exit 0
fi

# =============================================================================
# 训练
# =============================================================================
train_one () {
  local run="$1" save_path="$2" max_steps="${3:-0}" do_save="${4:-1}"
  local log_every="${5:-${LOG_EVERY}}"

  mkdir -p "${RESULTS_ROOT}/map_cache/${run}"
  echo "==== train ${run} (lr=${LR} ${LR_SCHEDULER} warmup=${WARMUP_RATIO} maxlen=${MAXLEN} batch=${BATCH} accum=${ACCUM} max_steps=${max_steps}) ===="
  python -m onereplay.scripts.train --paradigm sft --full_finetune 1 \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
    --system_prompt "${SYSTEM_PROMPT}" \
    --dataset_path "${DATASET_DIR}" \
    --epochs "${EPOCHS}" --lr "${LR}" \
    --lr_scheduler "${LR_SCHEDULER}" --warmup_ratio "${WARMUP_RATIO}" \
    --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
    --max_len "${MAXLEN}" \
    --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" \
    --eval_batch_size "${BATCH}" \
    --max_train_samples "${MAX_TRAIN_SAMPLES}" \
    --target_modules "${TARGET_MODULES}" \
    --map_cache_dir "${RESULTS_ROOT}/map_cache/${run}" \
    --replay_lambda 0 --measure_replay_when_lambda_zero 0 \
    --max_steps "${max_steps}" --log_every "${log_every}" \
    --save "${do_save}" --save_path "${save_path}" \
    --metrics_path "${METRICS_DIR}/${run}.jsonl"
}

# 下面两项是**训练**的前置条件，MODE=eval 不该受它们约束：评测只需要
# checkpoint 和 benchmark，训练数据集早就可以不在了（甚至本来就在别的机器上）。
if [[ "${MODE}" != "eval" ]]; then
  if [[ ! -d "${DATASET_DIR}" ]]; then
    echo "数据集不存在: ${DATASET_DIR}"
    echo "先跑: qsub -v DOMAIN=${DOMAIN},MODE=data onereplay/pbs/90_specialist_sft.pbs"
    exit 1
  fi

  # 数据是用哪条 system prompt 量出来的，就必须用哪条训练——不然 4096 的保证失效。
  STATS_SYSTEM="$(python - "${OUT_STATS}" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        print(json.load(fh)["metadata"]["system_prompt"], end="")
except Exception:
    print("", end="")
PY
)"
  if [[ -n "${STATS_SYSTEM}" && "${STATS_SYSTEM}" != "${SYSTEM_PROMPT}" ]]; then
    echo "拒绝训练：SYSTEM_PROMPT 和数据准备时用的不一致。"
    echo "  数据 (${OUT_STATS}): ${STATS_SYSTEM}"
    echo "  本次训练          : ${SYSTEM_PROMPT}"
    echo "  system turn 会贡献 token，长度是按含它的完整序列量的；不一致就会有行超过"
    echo "  ${MAXLEN} 而被静默左截断（保尾丢头），prepare 的 drop-not-truncate 保证作废。"
    exit 4
  fi
fi

if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只打印配置，不训练。"
  exit 0
fi

# =============================================================================
# 评测：交叉矩阵。M_<DOMAIN> 评三边，base 只评当前 DOMAIN 这一边。
# =============================================================================
# 跑了多少组、跳过多少组。两种跳过必须分开记：
#   DONE   已经有结果 -> 正常，补评时几乎全是这种
#   NODATA 数据没下载 -> 不正常，矩阵会缺一块，结束时要让作业失败
# 不分开的话，一次"什么都没评"的运行会安静地以 0 退出，看起来和评完了一样。
GROUPS_RAN=0
GROUPS_DONE=0
GROUPS_NODATA=0
GROUPS_SKIPPED=0

# 该组是否被 SKIP_GROUPS 关掉了。组名见下面 eval_* 的第一个参数：
# math_std / math_hard / medical / code / finance。
group_skipped () {
  [[ " ${SKIP_GROUPS} " == *" $1 "* ]]
}

# 缺哪个 benchmark 就报哪个，不要等跑到一半才炸。
require_data () {
  local group="$1"; shift
  local missing=0
  for path in "$@"; do
    if [[ ! -e "${path}" ]]; then
      echo "  [${group}] 缺少数据: ${path}" >&2
      missing=1
    fi
  done
  if [[ "${missing}" == "1" ]]; then
    echo "  [${group}] 数据不全，整组跳过；补齐后重投会自动补上。" >&2
    GROUPS_NODATA=$((GROUPS_NODATA + 1))
  fi
  return "${missing}"
}

# 该组的每个 metric 是否都已经有 summary.json。
group_done () {
  local run_name="$1"; shift
  for metric in "$@"; do
    [[ -f "${EVAL_ROOT}/${metric}/${run_name}/summary.json" ]] || return 1
  done
  return 0
}

# run_group <组名> <run_name> <adapter_path 或空> <metrics 逗号串> <额外参数...>
run_group () {
  local group="$1" run_name="$2" adapter="$3" metrics="$4"; shift 4
  local metric_list=(${metrics//,/ })

  # 在 group_done 之前判：被关掉的组连"已有结果"都不必查，日志里也就只出现一行。
  if group_skipped "${group}"; then
    echo "==== skip ${run_name} / ${group}：在 SKIP_GROUPS 里 ===="
    GROUPS_SKIPPED=$((GROUPS_SKIPPED + 1))
    return 0
  fi

  if [[ "${FORCE}" != "1" ]] && group_done "${run_name}" "${metric_list[@]}"; then
    echo "==== skip ${run_name} / ${group}：${EVAL_ROOT} 下已有全部 summary.json ===="
    GROUPS_DONE=$((GROUPS_DONE + 1))
    return 0
  fi
  GROUPS_RAN=$((GROUPS_RAN + 1))

  # 评测的 system 由 **benchmark** 决定，不由被评的模型决定。同一个 benchmark
  # 下所有模型必须收到同一条指令，否则横向不可比；而代码组必须发 code 那条，
  # 否则 fence 提取器拿不到东西、所有模型一起是 0 分。这意味着跨域评测时模型
  # 会收到训练时没见过的那条 system —— 那正是"没学过这个域"的真实表现。
  local group_system="${SYSTEM_PROMPT_BOXED}"
  [[ "${group}" == "code" ]] && group_system="${SYSTEM_PROMPT_CODE}"

  echo
  echo "==== eval ${run_name} / ${group} : ${metrics} ===="
  local args=(
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}"
    --out_dir "${EVAL_ROOT}" --run_name "${run_name}"
    --metrics "${metrics}" --seed "${SEED}"
    --system_prompt "${group_system}"
    # 训完的 chat turn 以 '<|im_end|><|endoftext|>' 结尾，而 base tokenizer 的
    # eos 只是 '<|endoftext|>'。不停在 im_end 上，模型会顺着幻觉出下一轮，再被
    # skip_special_tokens 拼进答案里。这条线没有历史结果要兼容，直接开。
    --decode_stop_on_im_end 1
    --limit "${LIMIT}"
  )
  [[ -n "${adapter}" ]] && args+=(--adapter_path "${adapter}")
  python -m onereplay.scripts.evaluate "${args[@]}" "$@"
}

# ---- 四个解码组 ----
eval_math_std () {
  local run_name="$1" adapter="$2"
  require_data math_std "${GSM8K_DATA}" "${MATH500_DATA}" || return 0
  run_group math_std "${run_name}" "${adapter}" "gsm8k,math500" \
    --gsm8k_data_path "${GSM8K_DATA}" \
    --math500_data_path "${MATH500_DATA}" \
    --math_max_new_tokens 2048 \
    --math_batch_size "${MATH_BATCH}"
}

eval_math_hard () {
  local run_name="$1" adapter="$2"
  require_data math_hard "${MINERVA_DATA}" || return 0
  # MinervaMath 难且方差大，贪心一遍基本在量"某一道题的硬币落在哪面"，所以 avg@4。
  # 采样必须配 --decode_do_sample 1，否则 4 个样本是同一条贪心输出的四份拷贝。
  run_group math_hard "${run_name}" "${adapter}" "minervamath" \
    --minervamath_data_path "${MINERVA_DATA}" \
    --math_max_new_tokens 4096 \
    --math_batch_size 64 \
    --decode_do_sample 1 --decode_temperature 1.0 --math_num_samples 4
}

eval_medical () {
  local run_name="$1" adapter="$2"
  require_data medical "${MEDQA_DATA}" "${PUBMEDQA_DATA}" "${MEDXPERTQA_DATA}" || return 0
  run_group medical "${run_name}" "${adapter}" "medqa,pubmedqa,medxpertqa" \
    --medqa_data_path "${MEDQA_DATA}" \
    --pubmedqa_data_path "${PUBMEDQA_DATA}" \
    --medxpertqa_data_path "${MEDXPERTQA_DATA}" \
    --medical_max_new_tokens 2048 \
    --medical_batch_size "${MEDICAL_BATCH}"
}

eval_finance () {
  local run_name="$1" adapter="$2"
  require_data finance "${FINQA_DATA}" "${CONVFINQA_DATA}" "${TATQA_DATA}" || return 0
  run_group finance "${run_name}" "${adapter}" "finqa,convfinqa,tatqa" \
    --finqa_data_path "${FINQA_DATA}" \
    --convfinqa_data_path "${CONVFINQA_DATA}" \
    --tatqa_data_path "${TATQA_DATA}" \
    --finance_max_new_tokens 2048 \
    --finance_batch_size "${FINANCE_BATCH}"
}

eval_code () {
  local run_name="$1" adapter="$2"
  require_data code "${HUMANEVAL_DATA}" "${MBPP_DATA}" \
                    "${HUMANEVALPLUS_DATA}" "${MBPPPLUS_DATA}" || return 0
  # --dataset_split 在 evaluate.py 里只被 MBPP 读，默认 validation 是 90 题的
  # 那个 split；显式传 test 才是 500 题的正式集合。
  #
  # 四个 metric 一组解码一次：prompt 在基础版和加号版之间是一样的，分开成两组
  # 等于把同一批生成跑两遍。CODE_TIMEOUT 留空的话，基础版用 5 秒、加号版用 30
  # 秒（metric 各自的默认值）——加号版跑的断言多约 80 倍，超时会被记成失败。
  run_group code "${run_name}" "${adapter}" "humaneval,mbpp,humanevalplus,mbppplus" \
    --humaneval_data_file "${HUMANEVAL_DATA}" \
    --mbpp_dataset_path "${MBPP_DATA}" \
    --dataset_split "${MBPP_SPLIT}" \
    --humanevalplus_data_file "${HUMANEVALPLUS_DATA}" \
    --mbppplus_data_file "${MBPPPLUS_DATA}" \
    --code_max_new_tokens 512 \
    --code_batch_size "${CODE_BATCH}" \
    --timeout "${CODE_TIMEOUT}"
}

# 某个领域的全部组。
eval_domain () {
  local domain="$1" run_name="$2" adapter="$3"
  case "${domain}" in
    math)    eval_math_std "${run_name}" "${adapter}"; eval_math_hard "${run_name}" "${adapter}" ;;
    medical) eval_medical  "${run_name}" "${adapter}" ;;
    code)    eval_code     "${run_name}" "${adapter}" ;;
    finance) eval_finance  "${run_name}" "${adapter}" ;;
    *) echo "eval_domain: 不认识的领域 '${domain}'，跳过" >&2 ;;
  esac
}

# 一个领域要哪几份 benchmark 数据。eval_* 里的 require_data 用的是同一批路径，
# 两处对不上就会出现"预检说齐了、真跑时跳过"。
bench_paths_for () {
  case "$1" in
    # 只要求真的会跑的那几份：关掉了某组还报它的数据缺失就是假警报。
    math)    group_skipped math_std  || printf '%s\n' "${GSM8K_DATA}" "${MATH500_DATA}"
             group_skipped math_hard || printf '%s\n' "${MINERVA_DATA}"
             ;;
    medical) printf '%s\n' "${MEDQA_DATA}" "${PUBMEDQA_DATA}" "${MEDXPERTQA_DATA}" ;;
    code)    printf '%s\n' "${HUMANEVAL_DATA}" "${MBPP_DATA}" \
                           "${HUMANEVALPLUS_DATA}" "${MBPPPLUS_DATA}" ;;
    finance) printf '%s\n' "${FINQA_DATA}" "${CONVFINQA_DATA}" "${TATQA_DATA}" ;;
  esac
}

# 训练要跑几个小时，评测紧接在后面。benchmark 缺不缺现在就知道了，没有理由等
# require_data 在几小时后才发现——那时补完数据还得重投一次作业。
#
# 只警告不中止：训练产出的 checkpoint 本身有价值，不该被"评测数据没同步"拦住。
preflight_bench () {
  local missing=()
  local path domain
  # 只查真的会评的那几个域：trained 评 EVAL_DOMAINS，base 评 DOMAIN。拿没配进
  # EVAL_DOMAINS 的领域（比如换掉的 finance）去报缺失，只会制造假警报。
  local checked=" "
  # shellcheck disable=SC2086
  for domain in ${EVAL_DOMAINS} "${DOMAIN}"; do
    [[ "${checked}" == *" ${domain} "* ]] && continue
    checked+="${domain} "
    while IFS= read -r path; do
      [[ -n "${path}" && ! -e "${path}" ]] && missing+=("${path}")
    done < <(bench_paths_for "${domain}")
  done
  if [[ "${#missing[@]}" -gt 0 ]]; then
    echo
    echo "!! 训练后要评的 benchmark 缺 ${#missing[@]} 个：" >&2
    printf '     %s\n' "${missing[@]}" >&2
    echo "   训练照常开始，但评测会跳过对应的组、最后以 rc=6 结束。" >&2
    echo "   现在补上比训练跑完再补省一次作业：python test_code/download_bench.py" >&2
    echo
  fi
}

run_cross_eval () {
  echo
  echo "================================================================"
  echo " 交叉评测：M_${DOMAIN} 评三边 + base 评 ${DOMAIN}"
  echo " eval root : ${EVAL_ROOT}"
  echo " WHICH     : ${WHICH}   FORCE=${FORCE}   LIMIT=${LIMIT}"
  echo "================================================================"
  mkdir -p "${EVAL_ROOT}"

  # ---- base：只评当前 DOMAIN 这一边 ----
  if [[ "${WHICH}" == "base" || "${WHICH}" == "both" ]]; then
    echo
    echo "################ base: 只评 ${DOMAIN} ################"
    eval_domain "${DOMAIN}" "base" ""
  fi

  # ---- trained：三边全评 ----
  if [[ "${WHICH}" == "trained" || "${WHICH}" == "both" ]]; then
    if [[ ! -d "${CKPT}" ]]; then
      echo
      echo "找不到 checkpoint: ${CKPT}" >&2
      echo "  先跑 qsub -v DOMAIN=${DOMAIN},MODE=train onereplay/pbs/90_specialist_sft.pbs" >&2
      echo "  或者用 WHICH=base 只评 base。" >&2
      return 4
    fi
    echo
    echo "################ M_${DOMAIN}: 评 ${EVAL_DOMAINS} ################"
    # shellcheck disable=SC2086
    for target in ${EVAL_DOMAINS}; do
      eval_domain "${target}" "m_${DOMAIN}" "${CKPT}"
    done
  fi

  echo
  echo "==== 交叉评测结束: DOMAIN=${DOMAIN} WHICH=${WHICH} ===="
  echo "  本次执行 ${GROUPS_RAN} 组，已有结果跳过 ${GROUPS_DONE} 组，缺数据跳过 ${GROUPS_NODATA} 组，SKIP_GROUPS 关掉 ${GROUPS_SKIPPED} 组。"
  [[ -n "${SKIP_GROUPS}" ]] && echo "  SKIP_GROUPS='${SKIP_GROUPS}' —— 这几组没有数字，不是跑出来是 0。"
  echo "  汇总 csv: ${EVAL_ROOT}/<metric>_summary.csv"
  echo "  三个 DOMAIN 都跑完后，每个 csv 里会有 base 和三个 m_* 的行。"

  if [[ "${GROUPS_NODATA}" -gt 0 ]]; then
    echo
    echo "有 ${GROUPS_NODATA} 组因为缺数据没评，这次的交叉矩阵是不完整的。" >&2
    echo "  按上面 stderr 里的路径把 benchmark 补齐，然后投" >&2
    echo "  qsub -v DOMAIN=${DOMAIN},MODE=eval onereplay/pbs/90_specialist_sft.pbs，" >&2
    echo "  已经评完的组会自动跳过，只补缺的那几组。" >&2
    return 6
  fi
  return 0
}

case "${MODE}" in
  smoke)
    # 几十步，用来确认 4096 x BATCH 放得下、loss 会降。不保存。
    train_one "${RUN}_smoke" "" "${SMOKE_STEPS}" 0 8
    ;;
  train)
    if [[ "${DO_EVAL}" == "1" ]]; then preflight_bench; fi
    # checkpoint 已经在就跳过训练，但**不退出**——后面的评测还要跑。撞了
    # walltime 之后原样重投，就会跳过训练、跳过已完成的评测组，从断点接着跑。
    if [[ -d "${CKPT}" ]]; then
      echo "已存在 checkpoint，跳过训练: ${CKPT}"
      echo "  要重训就先挪走它，或换一个 SEED / RESULTS_ROOT。"
    else
      train_one "${RUN}" "${CKPT}" 0 1
      echo
      echo "==== ${DOMAIN} specialist 训练完成 ===="
      echo "  checkpoint : ${CKPT}"
      echo "  metrics    : ${METRICS_DIR}/${RUN}.jsonl"
    fi

    if [[ "${DO_EVAL}" != "1" ]]; then
      echo
      echo "DO_EVAL=0：不评测。要补评就投"
      echo "  qsub -v DOMAIN=${DOMAIN},MODE=eval onereplay/pbs/90_specialist_sft.pbs"
      exit 0
    fi
    # 评测的退出码直接透出来（4=没 checkpoint，6=缺 benchmark），但要说清楚训练
    # 那一半是好的：不然看到非 0 会以为整个作业白跑了，跑去重训。
    eval_rc=0
    run_cross_eval || eval_rc=$?
    if [[ "${eval_rc}" != "0" ]]; then
      echo
      echo "评测没跑完（rc=${eval_rc}），但训练本身是好的：${CKPT}" >&2
      echo "  补评: qsub -v DOMAIN=${DOMAIN},MODE=eval onereplay/pbs/90_specialist_sft.pbs" >&2
      exit "${eval_rc}"
    fi
    ;;
  eval)
    # 只评不训。checkpoint 在不在由 run_cross_eval 判断：WHICH=base 时本来就不需要。
    eval_rc=0
    run_cross_eval || eval_rc=$?
    exit "${eval_rc}"
    ;;
esac
