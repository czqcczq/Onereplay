#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_probedir
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# NUS Hopper: gold 探针的**方向检查** —— 投任何一轮重跑之前的一道闸
#
# 只做前向，不训练、不生成、不评测。一个语料一个 checkpoint 约 5-15 分钟。
# （文件名里的 math_val500 是初版的遗留；现在它对任意语料、任意基座都能用。）
#
# -----------------------------------------------------------------------------
# !! 这个脚本存在的原因：已经栽过两次的同一个坑
#
#   96 号那轮（DialogSum 线、Qwen3-8B）跑完 8 小时，结论不能用，因为保护域的
#   loss 不升反降：
#
#       FLAN gold      base 2.9218 -> vanilla 1.9118   (-34.6%)
#
#   本脚本第一次运行又量了一个域，同一个方向，而且更狠：
#
#       MetaMath gold  base 0.6769 -> vanilla 0.3865   (-42.9%)
#
#   同期这两个域上的**能力**是实实在在掉的：IFEval 78.74% -> 63.96%，
#   MATH500 79.60% -> 58.60%（掉 21 个点）。所以不是"没有遗忘"，是这把尺子
#   量不出遗忘，还反着走。
#
#   !! 机制：这决定了换域多半没用
#   CE(gold) 问的是"模型多会预测**这个语料的参考答案**"。在任何指令数据上做完
#   SFT，模型都会进入一种"按数据集的口吻直接作答"的通用模式，于是它在**任何**
#   SFT 语料的 gold 答案上 CE 都会下降。这一项增益大且与域无关 —— 上面两个数
#   base CE 差了 4.3 倍（2.92 vs 0.68），相对跌幅却都在 35-43%，正是这个签名。
#   能力损失反映成一个方向相反、小得多的 CE 上升，被完全淹没。
#
#   所以再换域是**确认**不是翻盘。确认仍然值得做：三个域、两个基座比一个点硬得多，
#   而且"gold CE 在各处都反向"本身就是个可写进论文的观察，它正是"为什么本文用
#   benchmark 而不是 loss 报遗忘"的直接依据。
#
# -----------------------------------------------------------------------------
# !! 判据（跑完照着读，每个语料各判一次）
#
#   CE(vanilla) > CE(base) 且幅度够  ->  方向对，这个语料能用
#   CE(vanilla) > CE(base) 但幅度小  ->  方向对，可是各臂的差会淹在噪声里
#   |Δ| 在 3δ 以内                   ->  探针对本次训练不敏感，臂间差只会更小
#   CE(vanilla) < CE(base)           ->  上面那个坑，这个语料作废
#
#   δ = 0.0077，96 号那轮实测的噪声地板（bs4 与 bs2 两条 vanilla 曲线末点的间距）。
#   臂间差通常只是 vanilla 总漂移的一小截，所以总漂移要有几十个 δ 才够用。
#
# -----------------------------------------------------------------------------
# !! 三条线，base 分母必须各算各的
#
#   DialogSum 线   Qwen3-8B              LoRA，ds_*，checkpoint 在 results/qwen3-8b/adapters
#   commonsense 线 Qwen3-8B              LoRA，cs_*，同一个 adapters 目录（67/70/71/72）
#   finance 线     Qwen2.5-1.5B-Instruct 全参，checkpoint 在
#                                        results_finance_.../checkpoints
#
#   所以是**三次投递**，不是一次。跨线只能比"方向和相对幅度"，CE 的绝对值不可比：
#   两个模型在同一批题上的起点本来就不同。
#
#   ds 与 cs 同基座同目录，只差 ADAPTER_GLOB，但 OUT_PATH 必须分开传：默认那个
#   路径两条线会互相备份掉，汇总时读到的就是上一条线的数。
#
#   score_probe_ce 的 --adapter_path 同时吃 LoRA 目录和全参 checkpoint 目录
#   （95 号自己就是这么把 fin_* 传给评测的），所以两条线共用这一个脚本。
#
# -----------------------------------------------------------------------------
# !! 顺带把端点结果白捡了
#   81/82/83 号（LoRA）和 95 号（全参）的 SAVE 默认都是 1，OneReplay / EWC /
#   replay 的 checkpoint 大概率还在（96 号自己是 SAVE=0，它那九条臂没留）。
#   Step 1 会把目录列出来。多打几个只是多几分钟前向，却能**不重训**拿到端点对比。
#   拿不到的只有过程曲线和 ratio 扫描 —— 那两样非重训不可。
#
# -----------------------------------------------------------------------------
# !! 口径：与训练期探针逐字相同
#   score_probe_ce 复用 build_self_distilled_probe / build_probe_loader /
#   BaseTrainer.evaluate_probe 三件套，没有重写 loss：
#     * 只对 assistant token 求 CE（prompt 段 label = -100）
#     * **token 加权平均**而非 batch 平均（答案长度跨度大，batch 平均会让短答案
#       主导，还会随 batch_size 漂移）
#     * shuffle=False、左 padding
#   所以打出来的数以后可以和 metrics jsonl 里的 probe_* 字段并排读。
#   函数名里的 self_distilled 只是历史包袱：load_self_distilled_pool 对列很宽容，
#   index / truncated 都是可选的，普通 jsonl 直接能喂。
#
# !! 列名归一（Step 2）
#   score_probe_ce 的 --replay_input_column / --replay_target_column 是**整次调用
#   共用**的，所以列名不同的语料没法塞进同一次调用。Step 2 因此把每个语料抄一份到
#   ${TMPDIR}、统一改成 inputs / targets —— 之后一次模型加载就能把所有语料打完，
#   省掉每组多花的那几分钟加载。原文件不动。
#
# !! MAX_LEN
#   截断的行只有答案前缀被打分。所有要互相比较的 run 必须用同一个值 —— 脚本会打
#   rows_at_max_len，超过 5% 会警告。要调大就**所有 run 一起重跑**，不然不可比。
#
# -----------------------------------------------------------------------------
# 投递:
#
#   # (1) DialogSum 线 / Qwen3-8B：base + vanilla，if / math / code 三个语料
#   qsub onereplay/pbs/102_math_val500_direction.pbs
#
#   # (1') DialogSum 线的**全部**臂 x 三个保护域。ADAPTERS 不传就只打默认那一个，
#   #      要全打得显式说。VANILLA_RUN 也必须给 —— 它是「消除的遗忘」的分母。
#   qsub -v ADAPTERS=all,VANILLA_RUN=ds_vanilla_8b_r16all_lr2e-4_ep2_seed1 \
#        onereplay/pbs/102_math_val500_direction.pbs
#
#   # 只要其中一部分：ADAPTER_GLOB 过滤，或者 ADAPTERS 显式列举
#   qsub -v ADAPTERS=all,ADAPTER_GLOB='ds_*',VANILLA_RUN=... onereplay/pbs/102_...pbs
#
#   # (1'') commonsense 线 / Qwen3-8B：67/70/71/72 那批 cs_* 的保护域 old val loss。
#   #       同一个 adapters 目录，所以只差 glob；OUT_PATH 一定要另给，否则会把 ds
#   #       线的 direction.jsonl 备份掉，两条线的数混在一个汇总里。
#   qsub -v ADAPTERS=all,ADAPTER_GLOB='cs_*',\
#VANILLA_RUN=cs_vanilla_8b_r16all_lr2e-4_seed1,\
#OUT_PATH=/scratch/weiliu87/student/czq/Onereplay/results/qwen3-8b/probe_ce/direction_cs.jsonl,\
#PER_ROW_DIR=/scratch/weiliu87/student/czq/Onereplay/results/qwen3-8b/probe_ce/per_row_cs \
#        onereplay/pbs/102_math_val500_direction.pbs
#
#   #       先 DRY_RUN=1 看一眼 Step 1：cs_* 里混着 λ 扫描的 _probe 短跑和 _idcov
#   #       的 L2 对照臂，它们也会被 all 展开进来。正式那 13 个臂（vanilla + 三种
#   #       方法 x 四个域）要的话就把 ADAPTERS 显式列举。
#
#   #    14 个 checkpoint x 3 个语料约 1.5 h；赶时间可以 VERIFY=0 砍掉一半前向
#   #    （那是逐行路径与 evaluate_probe 的互校，第一次跑过一次就够了）。
#
#   # (2) finance 线 / Qwen2.5-1.5B-Instruct：同样两个语料，自己的 base 做分母
#   qsub -v MODEL_NAME=Qwen2.5-1.5B-Instruct,\
#RESULTS_ROOT=/scratch/weiliu87/student/czq/Onereplay/results_finance_Qwen2.5-1.5B-Instruct,\
#ADAPTER_DIR=/scratch/weiliu87/student/czq/Onereplay/results_finance_Qwen2.5-1.5B-Instruct/checkpoints,\
#ADAPTERS=fin_vanilla_lr8e-5_ep2_seed42 \
#        onereplay/pbs/102_math_val500_direction.pbs
#
#   # 看过 Step 1 的清单之后，把端点一次打全
#   qsub -v ADAPTERS='ds_vanilla_...,ds_onereplay_...,ds_ewc_...,ds_replay_...' \
#        onereplay/pbs/102_math_val500_direction.pbs
#
#   # 只看语料与清单，不打分（约 1 分钟）
#   qsub -v DRY_RUN=1 onereplay/pbs/102_math_val500_direction.pbs
#
#   # 已经打过分，只想把判据重读一遍（判据改了、或上次汇总挂了）：不加载模型，秒级
#   qsub -v VERDICT_ONLY=1 onereplay/pbs/102_math_val500_direction.pbs
#
#   # 自定义语料集合
#   qsub -v PROBES='foo=/path/a.jsonl,bar=/path/b.jsonl' onereplay/pbs/102_...pbs
#
# 注意 OUT_PATH 默认落在 ${RESULTS_ROOT}/probe_ce/direction.jsonl，两条线的
# RESULTS_ROOT 不同，所以各写各的，不会互相覆盖。
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/102_math_val500_direction.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。起容器，然后把脚本自己在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME RESULTS_ROOT ADAPTER_DIR
    PROBES IF_GOLD_FILE MATH_GOLD_FILE CODE_GOLD_FILE POOL_ROOT
    ADAPTERS ADAPTER_GLOB BASE_NAME VANILLA_RUN OUT_PATH PER_ROW_DIR
    MAX_LEN BATCH ROW_BATCH PROBE_SIZE VERIFY
    DRY_RUN VERDICT_ONLY KEEP_GOING
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：那会把当前 shell 换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python : $(which python)"
nvidia-smi --query-gpu=name,memory.total --format=csv

MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-8B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results/qwen3-8b}"
# LoRA 的臂在 adapters/，全参的在 checkpoints/ —— finance 线要把这个指过去。
ADAPTER_DIR="${ADAPTER_DIR:-${RESULTS_ROOT}/adapters}"

# gold 语料：93 号 Step 1 切出来的三份 500 行留出集（if / math / code）。
# 它们物理上落在 finance 线的 pools 目录下，但内容与基座无关 —— 就是三个域各自
# 的题与参考答案。两条线共用同一批题，所以"同一个语料上不同基座各自的漂移"
# 可以并排看方向与相对幅度（CE 的绝对值仍然只在同一基座内可比）。
POOL_ROOT="${POOL_ROOT:-${REPO_ROOT}/results_finance_Qwen2.5-1.5B-Instruct/pools}"
IF_GOLD_FILE="${IF_GOLD_FILE:-${POOL_ROOT}/if_val500.jsonl}"
MATH_GOLD_FILE="${MATH_GOLD_FILE:-${POOL_ROOT}/math_val500.jsonl}"
CODE_GOLD_FILE="${CODE_GOLD_FILE:-${POOL_ROOT}/code_val500.jsonl}"
PROBES="${PROBES:-ifgold=${IF_GOLD_FILE},mathgold=${MATH_GOLD_FILE},codegold=${CODE_GOLD_FILE}}"
# 缺哪一份就少一列，Step 2 会打"跳过：找不到"然后继续，不会整个作业停掉。

# 谁是 vanilla。它是"消除的遗忘"那一列的分母，不能靠名字里有没有 vanilla 猜 ——
# 一次打十几个 checkpoint 时猜错就是整列作废。留空则回落到子串匹配。
VANILLA_RUN="${VANILLA_RUN:-}"

OUT_PATH="${OUT_PATH:-${RESULTS_ROOT}/probe_ce/direction.jsonl}"
PER_ROW_DIR="${PER_ROW_DIR:-${RESULTS_ROOT}/probe_ce/per_row}"

MAX_LEN="${MAX_LEN:-2048}"
BATCH="${BATCH:-8}"
ROW_BATCH="${ROW_BATCH:-4}"
PROBE_SIZE="${PROBE_SIZE:-0}"      # 0 = 整个语料（500 行本来就不多）
VERIFY="${VERIFY:-1}"
DRY_RUN="${DRY_RUN:-0}"
VERDICT_ONLY="${VERDICT_ONLY:-0}"   # 1 = 不打分，只把已有的 OUT_PATH 重新判一遍
KEEP_GOING="${KEEP_GOING:-1}"
BASE_NAME="${BASE_NAME:-base}"

# 要打哪些 checkpoint。默认只有 74 号的 vanilla —— 方向检查只要它，而多打一个就是
# 几分钟前向，不该由默认值替人做这个决定。想打全部用 ADAPTERS=all。
#   ADAPTERS=all          把 ADAPTER_DIR 下所有子目录都打一遍
#   ADAPTER_GLOB='ds_*'   配合 all 过滤（默认 *）
#   ADAPTERS='a,b,c'      显式列举；绝对路径也认
# finance 线要传 fin_vanilla_lr8e-5_ep2_seed42（或 all + ADAPTER_GLOB='fin_*'）。
ADAPTERS="${ADAPTERS:-ds_vanilla_8b_r16all_lr2e-4_ep2_seed1}"
ADAPTER_GLOB="${ADAPTER_GLOB:-*}"

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺基座模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
mkdir -p "$(dirname "${OUT_PATH}")" "${PER_ROW_DIR}"

echo "========================================================================"
echo "gold 探针方向检查"
echo "  基座   = ${MODEL_DIR}/${MODEL_NAME}"
echo "  ckpt   = ${ADAPTER_DIR}"
echo "  语料   = ${PROBES}"
echo "  预算   = max_len ${MAX_LEN} / batch ${BATCH} / row_batch ${ROW_BATCH}"
echo "  输出   = ${OUT_PATH}"
echo "========================================================================"

# ===========================================================================
# Step 1: checkpoint 目录里有什么
# ===========================================================================
echo ""
echo "==== Step 1: ${ADAPTER_DIR} 下现有的 checkpoint ===="
AVAILABLE=()
if [[ -d "${ADAPTER_DIR}" ]]; then
  while IFS= read -r _dir; do
    [[ -n "${_dir}" ]] && AVAILABLE+=("$(basename "${_dir}")")
  done < <(find "${ADAPTER_DIR}" -mindepth 1 -maxdepth 1 -type d -name "${ADAPTER_GLOB}" 2>/dev/null | sort)
  if (( ${#AVAILABLE[@]} == 0 )); then
    echo "  （没有匹配 '${ADAPTER_GLOB}' 的子目录）"
  else
    for _name in "${AVAILABLE[@]}"; do echo "  ${_name}"; done
  fi
else
  echo "  !! 目录不存在: ${ADAPTER_DIR}"
fi

# ADAPTERS=all：省掉手抄十几个长 run 名这一步，那正是最容易出错的地方。
if [[ "${ADAPTERS}" == "all" ]]; then
  if (( ${#AVAILABLE[@]} == 0 )); then
    echo "!! ADAPTERS=all，但 ${ADAPTER_DIR} 下没有匹配 '${ADAPTER_GLOB}' 的目录。"
    exit 1
  fi
  ADAPTERS="$(IFS=,; printf '%s' "${AVAILABLE[*]}")"
  echo ""
  echo "ADAPTERS=all 展开成 ${#AVAILABLE[@]} 个 checkpoint。"
fi

# 本次到底要打几个 —— 只打了一个而目录里有一堆，多半是忘了传 ADAPTERS。
WANT_COUNT="$(printf '%s' "${ADAPTERS}" | tr ',' '\n' | grep -c '[^[:space:]]' || true)"
PROBE_COUNT="$(printf '%s' "${PROBES}" | tr ',' '\n' | grep -c '[^[:space:]]' || true)"
echo ""
echo "本次要打 ${WANT_COUNT} 个 checkpoint + base，各 ${PROBE_COUNT} 个语料。"
if (( WANT_COUNT <= 1 )) && (( ${#AVAILABLE[@]} > 1 )); then
  echo ""
  echo "!! 目录里有 ${#AVAILABLE[@]} 个 checkpoint，本次只打 ${WANT_COUNT} 个。"
  echo "   ADAPTERS 没传就是这个默认值。要全打是:"
  echo ""
  echo "     qsub -v ADAPTERS=all,VANILLA_RUN=<vanilla 的 run 名> \\"
  echo "          onereplay/pbs/102_math_val500_direction.pbs"
  echo ""
  echo "   或者把下面这行粘进 -v（只要其中几个就自己删）:"
  echo "     ADAPTERS='$(IFS=,; printf '%s' "${AVAILABLE[*]}")'"
  echo ""
  echo "   VANILLA_RUN 要显式给：它是「消除的遗忘」那一列的分母。"
fi
echo ""
echo "81/82/83（LoRA）与 95（全参）的 SAVE 默认是 1，所以 OneReplay / EWC / replay"
echo "的 checkpoint 大概率都在上面 —— 不重训就能拿到端点对比。"

# ===========================================================================
# Step 2: 语料体检 + 列名归一
#   score_probe_ce 的列名参数是整次调用共用的，所以先把所有语料抄成 inputs/targets，
#   之后一次模型加载就能把它们全打完。原文件不动。
# ===========================================================================
echo ""
echo "==== Step 2: 语料体检与列名归一 ===="
NORM_DIR="${TMPDIR}/probe_norm"
NORM_REPORT="${TMPDIR}/probe_norm.txt"
mkdir -p "${NORM_DIR}"

PROBES="${PROBES}" NORM_DIR="${NORM_DIR}" \
python - <<'PY' 2>&1 | tee "${NORM_REPORT}"
import json
import os
from pathlib import Path

# 目标列要挑对：训练侧只对 assistant 段求 CE，挑错列就是在给另一段文本打分。
CANDIDATES = [
    ("inputs", "targets"),
    ("inputs", "gold_targets"),
    ("question", "response"),
    ("instruction", "output"),
    ("query", "answer"),
    ("problem", "solution"),
    ("prompt", "completion"),
]

norm_dir = Path(os.environ["NORM_DIR"])
kept = []

for spec in os.environ["PROBES"].split(","):
    spec = spec.strip()
    if not spec:
        continue
    if "=" not in spec:
        print(f"!! PROBES 里的 {spec!r} 不是 name=path，跳过")
        continue
    name, path = (part.strip() for part in spec.split("=", 1))
    source = Path(path)
    print(f"---- {name}")
    if not source.is_file():
        print(f"  跳过：找不到 {source}")
        continue

    rows = []
    with source.open(encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                rows.append(json.loads(line))
    if not rows:
        print("  跳过：语料是空的")
        continue

    columns = list(rows[0].keys())
    picked = next((pair for pair in CANDIDATES
                   if pair[0] in columns and pair[1] in columns), None)
    if picked is None:
        print(f"  跳过：认不出输入/目标列，实有 {columns}")
        continue
    in_col, out_col = picked

    # 空行会被 to_sft_schema 丢掉（标签全 -100 会出 NaN），先报出来免得行数对不上。
    usable = [row for row in rows
              if str(row.get(in_col) or "").strip() and str(row.get(out_col) or "").strip()]
    target_path = norm_dir / f"{name}.jsonl"
    with target_path.open("w", encoding="utf-8") as handle:
        for index, row in enumerate(usable):
            handle.write(json.dumps(
                {"index": index, "inputs": row[in_col], "targets": row[out_col]},
                ensure_ascii=False,
            ) + "\n")

    lengths = sorted(len(str(row[out_col])) for row in usable)

    def quantile(fraction):
        return lengths[min(int(fraction * len(lengths)), len(lengths) - 1)]

    print(f"  列     = {in_col} / {out_col}   (实有 {columns})")
    print(f"  行数   = {len(rows)} -> 滤空行后 {len(usable)}")
    print(f"  目标字符数 P50={quantile(0.5)} P90={quantile(0.9)} "
          f"P99={quantile(0.99)} max={lengths[-1]}")
    print(f"  归一至 {target_path}")
    kept.append(f"{name}={target_path}")

print()
if not kept:
    print("!! 没有任何语料可用。")
    raise SystemExit(1)
print("NORM_PROBES=" + ",".join(kept))
PY

NORM_PROBES="$(grep -o '^NORM_PROBES=.*' "${NORM_REPORT}" | tail -n 1 || true)"
NORM_PROBES="${NORM_PROBES#NORM_PROBES=}"
[[ -n "${NORM_PROBES}" ]] || { echo "!! 没解析到归一后的语料清单，停。"; exit 1; }

if [[ "${DRY_RUN}" == "1" ]]; then
  echo ""
  echo "DRY_RUN=1：只看语料与清单，未打分。"
  echo "Job finished at: $(date)"
  exit 0
fi

# ===========================================================================
# Step 3: 逐个 checkpoint 打分（一次加载打完所有语料）
#   base 必须第一个 —— 它是后面所有数的分母，而且换了基座就得换分母。
# ===========================================================================
echo ""
echo "==== Step 3: 打分（base 在前，它是分母）===="

score_one () {
  local run_name="$1" adapter_path="$2"
  echo ""
  echo "---- ${run_name}"
  python -m onereplay.scripts.score_probe_ce \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    --adapter_path "${adapter_path}" \
    --run_name "${run_name}" \
    --probes "${NORM_PROBES}" \
    --probe_size "${PROBE_SIZE}" \
    --max_len "${MAX_LEN}" \
    --batch_size "${BATCH}" --row_batch_size "${ROW_BATCH}" \
    --replay_input_column inputs \
    --replay_target_column targets \
    --map_cache_dir "${TMPDIR}/map_cache_${run_name}" \
    --verify_aggregate "${VERIFY}" \
    --per_row_dir "${PER_ROW_DIR}" \
    --out "${OUT_PATH}"
}

OK_RUNS=()
FAILED_RUNS=()

if [[ "${VERDICT_ONLY}" == "1" ]]; then
  # 已经打过分、只想重读判据（比如判据本身改了）。不碰 OUT_PATH，不加载模型。
  [[ -f "${OUT_PATH}" ]] || { echo "!! VERDICT_ONLY=1 但没有 ${OUT_PATH}"; exit 1; }
  echo "VERDICT_ONLY=1：跳过打分，直接读 ${OUT_PATH}"
else
  # 追加写的 jsonl：本轮先挪走旧的，否则汇总会读到上一次不同 max_len 或不同基座的数。
  if [[ -f "${OUT_PATH}" ]]; then
    mv "${OUT_PATH}" "${OUT_PATH}.$(date +%Y%m%d_%H%M%S).bak"
    echo "已备份上一次的 ${OUT_PATH}"
  fi

  if score_one "${BASE_NAME}" ""; then
    OK_RUNS+=("${BASE_NAME}")
  else
    echo "!! base 打分失败。后面的数没有分母，停。"
    exit 1
  fi

  IFS=',' read -r -a _ADAPTER_SPECS <<< "${ADAPTERS}"
  for _spec in "${_ADAPTER_SPECS[@]}"; do
    _spec="$(printf '%s' "${_spec}" | tr -d '[:space:]')"
    [[ -z "${_spec}" ]] && continue
    # 绝对路径直接用，否则当作 ADAPTER_DIR 下的名字。
    if [[ "${_spec}" == /* ]]; then
      _path="${_spec}"
      _name="$(basename "${_spec}")"
    else
      _path="${ADAPTER_DIR}/${_spec}"
      _name="${_spec}"
    fi
    if [[ ! -d "${_path}" ]]; then
      echo "!! 跳过 ${_name}：找不到 ${_path}（看 Step 1 的清单核对名字）"
      FAILED_RUNS+=("${_name} (缺 checkpoint)")
      continue
    fi
    if score_one "${_name}" "${_path}"; then
      OK_RUNS+=("${_name}")
    else
      FAILED_RUNS+=("${_name} (打分失败)")
      [[ "${KEEP_GOING}" == "1" ]] || { echo "!! KEEP_GOING=0，停。"; break; }
    fi
  done
fi

# ===========================================================================
# Step 4: 逐语料的方向判据
# ===========================================================================
echo ""
echo "========================================================================"
echo "方向判据"
echo "========================================================================"
set +e
OUT_PATH="${OUT_PATH}" BASE_NAME="${BASE_NAME}" MODEL_NAME="${MODEL_NAME}" \
VANILLA_RUN="${VANILLA_RUN}" \
python - <<'PY'
import json
import os

base_name = os.environ["BASE_NAME"]
print(f"基座 = {os.environ['MODEL_NAME']}   （CE 的绝对值只在同一基座内可比）")

records = []
with open(os.environ["OUT_PATH"], encoding="utf-8") as handle:
    for line in handle:
        if line.strip():
            records.append(json.loads(line))
if not records:
    raise SystemExit("输出文件是空的，没什么可判的。")

base = next((row for row in records if row["run_name"] == base_name), None)
if base is None:
    raise SystemExit("找不到 base 那一行，没有分母。")

# score_probe_ce 也把 "probe_size"（它的 --probe_size 参数）写进同一条记录，所以
# 光看 probe_ 前缀会凭空多出一个叫 size、值为 0 的"语料"。真正的探针一定同时带着
# 自己的 <name>_rows，用它把参数筛掉。
probe_names = [
    key[len("probe_"):]
    for key in base
    if key.startswith("probe_") and f"{key[len('probe_'):]}_rows" in base
]
if not probe_names:
    raise SystemExit("base 那一行没有任何探针字段（probe_<name> 配 <name>_rows）。")

# 96 号那轮实测的噪声地板（bs4 与 bs2 两条 vanilla 曲线末点的间距）。臂间差通常只是
# vanilla 总漂移的一小截，所以总漂移要有几十个 δ 才够把各臂分开。
DELTA = 0.0077

# vanilla 是"消除的遗忘"那一列的分母。显式给最好；一次打十几个 checkpoint 时
# 靠名字里有没有 "vanilla" 猜，猜错就是整列作废，所以猜中了也要把名字打出来。
want_vanilla = os.environ.get("VANILLA_RUN", "").strip()
names = [row["run_name"] for row in records]
if want_vanilla:
    vanilla_name = want_vanilla if want_vanilla in names else ""
    if not vanilla_name:
        print(f"!! VANILLA_RUN={want_vanilla!r} 不在本次打过分的 run 里；"
              f"实有 {names}。「消除的遗忘」整列会是 n/a。")
else:
    guesses = [n for n in names if "vanilla" in n.lower()]
    vanilla_name = guesses[0] if len(guesses) == 1 else ""
    if len(guesses) > 1:
        print(f"!! 名字里带 vanilla 的有 {guesses}，猜不出用哪个。"
              "传 VANILLA_RUN=<run 名> 指定，否则「消除的遗忘」整列是 n/a。")
    elif vanilla_name:
        print(f"note: 未指定 VANILLA_RUN，按名字猜中 {vanilla_name}。")
print()

WIDTH = max([len(n) for n in names] + [20]) + 2
verdicts = {}
# (run, corpus) -> 消除的遗忘；分母为负时记 None，见下面那段。
eliminated = {}
below_base = []

for probe in probe_names:
    key = f"probe_{probe}"
    scored = [row for row in records if key in row]
    anchor = base[key]
    rows = base.get(f"{probe}_rows") or 0
    cut = base.get(f"{probe}_rows_at_max_len") or 0
    tokens = base.get(f"{probe}_supervised_tokens") or 0

    vanilla = next((row for row in scored if row["run_name"] == vanilla_name), None)
    # 分母。vanilla 若没掉反涨（gold 探针的老毛病），这个量没有意义：它会把
    # "漂得更少"报成负的百分比，读起来像"帮倒忙"，其实是分母的方向就错了。
    span = (vanilla[key] - anchor) if vanilla else None
    span_usable = span is not None and span > 3 * DELTA

    print()
    print(f"######## {probe}")
    print(f"  {rows} 行 / {tokens} 个 supervised token / "
          f"{cut} 行顶到 max_len={base.get('max_len')}")
    if rows and cut / rows > 0.05:
        print(f"  !! {cut / rows:.1%} 的行被截断，CE 只覆盖答案前缀。调大 MAX_LEN"
              "（**所有** run 一起重跑，不然不可比）。")
    print()
    header = f"  {'run':<{WIDTH}}{'CE':>10}{'vs base':>11}{'相对':>9}{'δ':>7}{'消除遗忘':>11}"
    print(header)
    print("  " + "-" * (len(header) - 2))
    for row in sorted(scored, key=lambda r: r[key]):
        name = row["run_name"]
        value = row[key]
        delta = value - anchor
        if name == base_name:
            print(f"  {name:<{WIDTH}}{value:>10.4f}{'(锚点)':>13}")
            continue
        rel = f"{delta / anchor:+.1%}" if anchor else "n/a"
        if span_usable:
            share = 1 - delta / span
            eliminated[(name, probe)] = share
            kept = f"{share:>10.1%}"
        else:
            eliminated[(name, probe)] = None
            kept = f"{'n/a':>11}"
        if delta < -3 * DELTA:
            below_base.append((name, probe))
        print(f"  {name:<{WIDTH}}{value:>10.4f}{delta:>+11.4f}{rel:>9}"
              f"{abs(delta) / DELTA:>7.0f}{kept}")

    if vanilla is None:
        print("\n  没有 vanilla，判不了方向，也算不了「消除的遗忘」。")
        verdicts[probe] = "无 vanilla"
        continue

    print()
    relative = f"{span / anchor:+.1%}" if anchor else "n/a"
    print(f"  方向判据看 {vanilla_name}: {anchor:.4f} -> {vanilla[key]:.4f} "
          f"({span:+.4f}, {relative}, {abs(span) / DELTA:.0f}δ)")
    if span > 40 * DELTA:
        verdicts[probe] = "可用"
        print("  -> 方向对，幅度够。这个语料能用。")
    elif span > 3 * DELTA:
        verdicts[probe] = "方向对但弱"
        print("  -> 方向对但幅度小，各臂的差多半会淹在噪声里。"
              "「消除的遗忘」这一列算得出来，但百分比的误差会很大。")
    elif span >= -3 * DELTA:
        verdicts[probe] = "没信号"
        print("  -> 整轮训练都没让它动（在 3δ 以内）。这不是「没有遗忘」，是这个")
        print("     探针对本次训练不敏感 —— 臂间差只会更小，一样读不出来。")
    else:
        verdicts[probe] = "作废"
        print("  -> 方向反了：训练让这个语料的 loss 变**低**，没有遗忘可言。")
        print("     分母是负的，所以「消除的遗忘」整列是 n/a，不是 0 也不是负数。")

# ---- 跨域矩阵：一次看完所有模型在所有域上的位置 ----
if len(probe_names) > 1 and len(names) > 2:
    print()
    print("========================================================================")
    print("跨域矩阵：CE 相对 base 的变化（正 = 遗忘，负 = 比基座还低）")
    head = f"  {'run':<{WIDTH}}" + "".join(f"{p:>14}" for p in probe_names)
    print(head)
    print("  " + "-" * (len(head) - 2))
    for row in records:
        name = row["run_name"]
        if name == base_name:
            continue
        cells = ""
        for probe in probe_names:
            key = f"probe_{probe}"
            cells += (f"{row[key] - base[key]:>+14.4f}" if key in row else f"{'-':>14}")
        print(f"  {name:<{WIDTH}}{cells}")

print()
print("========================================================================")
print("汇总")
for probe, verdict in verdicts.items():
    print(f"  {probe:<20} {verdict}")

pairs = sum(1 for probe in probe_names for row in records if row["run_name"] != base_name
            and f"probe_{probe}" in row)
if below_base:
    print()
    print(f"  {len(below_base)}/{pairs} 个 (模型, 语料) 组合的 CE **低于基座**"
          f"（超过 3δ）。")

usable = [probe for probe, verdict in verdicts.items() if verdict == "可用"]
weak = [probe for probe, verdict in verdicts.items() if verdict == "方向对但弱"]
print()
if usable or weak:
    if usable:
        print(f"方向可用的语料: {', '.join(usable)}")
    if weak:
        print(f"方向对但偏弱的语料: {', '.join(weak)} —— 「消除的遗忘」算得出来，")
        print("  但量程薄，臂间差要先过本线实测的 δ 才能声明，别只看百分比。")
    if any(eliminated.get(pair) is not None and eliminated[pair] > 1.0
           for pair in eliminated):
        print("  注意有臂的「消除的遗忘」超过 100%：它的 CE 掉到了基座**以下**，")
        print("  那已经不是保留而是在把旧域重新训一遍。报的时候要连锚点一起画出来。")
else:
    print("这个基座上没有一个 gold 语料方向是对的。")
    print("这不是选错了域：CE(gold) 问的是「多会预测这个语料的参考答案」，而任何指令")
    print("SFT 都会让模型更会预测**任何** SFT 语料的 gold 答案，这一项与域无关且远大于")
    print("能力损失带来的上升。而且 CE 是 teacher forcing —— 每个位置都喂着正确前缀，")
    print("量的是「参考答案有多意外」，不是「能不能自己解出来」。")
    print("这件事本身就是结论：写进论文，作为「本文为什么用 benchmark 而不是 loss 报")
    print("遗忘」的依据。上面那张跨域矩阵就是它的证据表。")
PY
SUMMARY_RC=$?
set -e

echo ""
echo "成功 ${#OK_RUNS[@]} 个: ${OK_RUNS[*]:-}"
if (( ${#FAILED_RUNS[@]} > 0 )); then
  echo "失败 ${#FAILED_RUNS[@]} 个:"
  for name in "${FAILED_RUNS[@]}"; do echo "  ${name}"; done
fi
echo ""
echo "产物:"
echo "  分数    : ${OUT_PATH}"
echo "  逐行    : ${PER_ROW_DIR}/<run>__<probe>.jsonl"
echo "            (误差棒: python -m onereplay.scripts.bootstrap_probe_ce --help)"
echo "Job finished at: $(date)"

exit "${SUMMARY_RC}"
