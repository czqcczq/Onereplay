echo "  ${OUT_DIR}/commonsense/<run>/summary.json"
echo ""
echo "配套的保护域 old val loss:"
echo "  qsub -v ADAPTERS=all,ADAPTER_GLOB='cs_*',VANILLA_RUN=cs_vanilla_8b_r16all_lr2e-4_seed1,\\"
echo "       OUT_PATH=${RESULTS_ROOT}/probe_ce/direction_cs.jsonl,\\"
echo "       PER_ROW_DIR=${RESULTS_ROOT}/probe_ce/per_row_cs \\"
echo "       onereplay/pbs/102_math_val500_direction.pbs"
echo "Job finished at: $(date)"

exit "${SUMMARY_RC}"
