#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_ifrerun
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=12:00:00
#PBS -o /scratch/weiliu87/logs/onereplay/
#
# =============================================================================
# NUS Hopper (PBS + Singularity): 只跑 IFEval，不训练，不评其它指标。
#
# 默认一次评 7 个 adapter。它们不在同一个 results 树下，但 REPO_ROOT 相同：
#   results_safety/adapters/  cs_onereplay_lam3e-2_seed1_regonce
#   results/adapters/         其余 6 个
# 每个 run 的 summary.json 写回它自己那棵树，互不覆盖。
#
# 【这个脚本能回答什么、不能回答什么】
#   IFEval 用贪心解码（do_sample=False），对同一份 adapter 重评几乎逐位复现。
#   所以本作业测的是「评测侧 / 跨目录」的数字，不是「训练的随机浮动」。
#   要量训练浮动得换 seed 重新训练。
#
# 【默认写到新 run 名，不覆盖原结果】
#   OUT_SUFFIX 默认 _rerun，summary.json 落到
#     <该 run 所属 results>/ifeval/<run>_rerun/
#   想直接覆盖原结果:  OUT_SUFFIX=
#
# -----------------------------------------------------------------------------
# 用法:
#   qsub onereplay/pbs/54_ifeval_rerun_regonce.pbs
#
#   只评其中几个:
#     qsub -v RUNS="cs_onereplay_ifmath_lam3e-2_seed1_regonce cs_vanilla_seed1" \
#       onereplay/pbs/54_ifeval_rerun_regonce.pbs
#   覆盖原结果而不是写 _rerun:
#     qsub -v OUT_SUFFIX= onereplay/pbs/54_ifeval_rerun_regonce.pbs
#   冒烟（每个模型只评前 20 条）:
#     qsub -v LIMIT=20 onereplay/pbs/54_ifeval_rerun_regonce.pbs
#   已有 summary.json 仍强制重评:
#     qsub -v FORCE_EVAL=1 onereplay/pbs/54_ifeval_rerun_regonce.pbs
#
# 前置条件:
#   1) adapter 就位（见上方两棵 results 树）
#   2) IFEval 数据: onereplay/third_party/instruction_following_eval/data/input_data.jsonl
#   3) 日志目录先建好: mkdir -p /scratch/weiliu87/logs/onereplay
#
# 预计耗时: 每模型约 40–60 min，默认 7 个约 5–7 h，walltime 给 12 h。
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id>
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（与其它 pbs 脚本保持一致）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/54_ifeval_rerun_regonce.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

# ---- 本次作业专属的临时目录 ----
JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  # -e/--cleanenv 会清掉环境，只有 SINGULARITYENV_/APPTAINERENV_ 前缀的变量能进容器。
  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME RESULTS_ROOT RESULTS_MAIN RESULTS_SAFETY
    SEED RUN RUNS ADAPTER OUT_NAME OUT_SUFFIX LIMIT MAX_NEW_TOKENS
    IFEVAL_INPUT FORCE_EVAL SAFETY_RUNS
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  # 不加 --nv：Hopper 的 singularity 已经全局绑好 GPU 驱动。
  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"

  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：那会把当前 shell 替换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的评测。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
# 离线：模型和数据都在本地盘，禁止任何 HuggingFace 联网调用。
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available(), torch.cuda.device_count())"

# ---- 项目路径 ----
# 两棵 results 树同属一个 REPO_ROOT。RESULTS_ROOT 仍接受旧用法（整作业覆写输出根），
# 默认不设，让每个 run 写回自己那棵树。
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B}"
RESULTS_MAIN="${RESULTS_MAIN:-${REPO_ROOT}/results}"
RESULTS_SAFETY="${RESULTS_SAFETY:-${REPO_ROOT}/results_safety}"

# ---- 评测参数（与第一章 / 02 号逐字一致，换了就不可比）----
SEED="${SEED:-1}"
LIMIT="${LIMIT:-0}"                  # >0 时只评前 N 条（冒烟用）
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-768}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"
FORCE_EVAL="${FORCE_EVAL:-0}"
OUT_SUFFIX="${OUT_SUFFIX:-_rerun}"

# ---- 要评的 run ----
# SAFETY_RUNS 里的名字优先去 results_safety/adapters 找；其余去 results/adapters。
# 找不到时再在另一棵树里兜底，避免名字记错就整作业挂掉。
# 旧接口：只传 RUN=xxx（或再传 ADAPTER=/绝对路径）时评那一个。
SAFETY_RUNS="${SAFETY_RUNS:-cs_onereplay_lam3e-2_seed1_regonce}"
DEFAULT_RUNS="cs_onereplay_lam3e-2_seed1_regonce cs_onereplay_ifcode_opcedu_lam2e-2_seed1_regonce cs_onereplay_ifmath_lam3e-2_seed1_regonce cs_ewcmix_opcedu_half_lam1_seed1 cs_ewcmix_opcedu_equal_lam1_seed1 cs_replaymix_ifmath_4n4r_rows80-20_seed1 cs_replaymix_ifmath_4n4r_rows50-50_seed1"
if [[ -n "${RUNS:-}" ]]; then
  :
elif [[ -n "${RUN:-}" ]]; then
  RUNS="${RUN}"
else
  RUNS="${DEFAULT_RUNS}"
fi

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
[[ -f "${IFEVAL_INPUT}" ]] || { echo "缺 IFEval 数据: ${IFEVAL_INPUT}"; exit 1; }
mkdir -p "${RESULTS_MAIN}/map_cache/eval_if_seed${SEED}" "${RESULTS_SAFETY}/map_cache/eval_if_seed${SEED}"

if [[ "${LIMIT}" != "0" ]]; then
  echo "!! LIMIT=${LIMIT}：冒烟模式，产出的 summary.json 只覆盖前若干条，不是正式结果。"
fi

is_safety_run () {
  local needle=" $1 "
  local haystack=" ${SAFETY_RUNS} "
  [[ "${haystack}" == *"${needle}"* ]]
}

# 返回: 该 run 所属的 results 根目录（输出写这里）。
resolve_out_root () {
  local run=$1
  if [[ -n "${RESULTS_ROOT:-}" ]]; then
    echo "${RESULTS_ROOT}"
    return
  fi
  if is_safety_run "${run}"; then
    echo "${RESULTS_SAFETY}"
  else
    echo "${RESULTS_MAIN}"
  fi
}

# 返回: adapter 绝对路径；找不到则返回空。
# 单 run 且显式传了 ADAPTER 时，整表都用这个路径（旧接口）。
resolve_adapter () {
  local run=$1
  local n
  n="$(echo "${RUNS}" | wc -w)"
  if [[ -n "${ADAPTER:-}" && "${n}" -eq 1 ]]; then
    echo "${ADAPTER}"
    return
  fi

  local primary secondary
  if is_safety_run "${run}"; then
    primary="${RESULTS_SAFETY}/adapters/${run}"
    secondary="${RESULTS_MAIN}/adapters/${run}"
  else
    primary="${RESULTS_MAIN}/adapters/${run}"
    secondary="${RESULTS_SAFETY}/adapters/${run}"
  fi
  if [[ -d "${primary}" ]]; then
    echo "${primary}"
  elif [[ -d "${secondary}" ]]; then
    echo "${secondary}"
  else
    echo ""
  fi
}

resolve_out_name () {
  local run=$1
  local n
  n="$(echo "${RUNS}" | wc -w)"
  if [[ -n "${OUT_NAME:-}" && "${n}" -eq 1 ]]; then
    echo "${OUT_NAME}"
    return
  fi
  echo "${run}${OUT_SUFFIX}"
}

# ---------------------------------------------------------------------------
# 前置：谁会跑、谁会跳过、为什么跳过。缺 adapter 只跳过这一行，不整作业退出。
# ---------------------------------------------------------------------------
set +x
echo "========================================================================"
echo "前置检查（只评 ifeval）"
printf "%-52s %-14s %s\n" "run" "tree" "状态"
PENDING_ANY=0
MISSING_ANY=0
for run in ${RUNS}; do
  adapter="$(resolve_adapter "${run}")"
  out_root="$(resolve_out_root "${run}")"
  out_name="$(resolve_out_name "${run}")"
  tree="$(basename "${out_root}")"
  if [[ -z "${adapter}" ]]; then
    printf "%-52s %-14s %s\n" "${run}" "${tree}" "!! 缺 adapter（results 与 results_safety 都没有）"
    MISSING_ANY=1
    continue
  fi
  if [[ "${FORCE_EVAL}" != "1" && -f "${out_root}/ifeval/${out_name}/summary.json" ]]; then
    printf "%-52s %-14s %s\n" "${run}" "${tree}" "已有 ${out_name}，跳过"
  else
    printf "%-52s %-14s %s\n" "${run}" "${tree}" "待评 -> ${out_name}"
    echo "         adapter: ${adapter}"
    PENDING_ANY=1
  fi
done
echo "========================================================================"
set -x

# ---------------------------------------------------------------------------
# 评测
# ---------------------------------------------------------------------------
eval_one () {
  local run=$1
  local adapter out_root out_name
  adapter="$(resolve_adapter "${run}")"
  out_root="$(resolve_out_root "${run}")"
  out_name="$(resolve_out_name "${run}")"

  if [[ -z "${adapter}" || ! -d "${adapter}" ]]; then
    echo "跳过 ${run}：缺 adapter"
    return 0
  fi
  if [[ "${FORCE_EVAL}" != "1" && -f "${out_root}/ifeval/${out_name}/summary.json" ]]; then
    echo "已有结果，跳过: ${out_root}/ifeval/${out_name}/summary.json"
    return 0
  fi

  echo "==== eval IFEval: adapter=${adapter}  ->  ${out_root}/ifeval/${out_name} ===="
  python -m onereplay.scripts.evaluate \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    --adapter_path "${adapter}" --run_name "${out_name}" \
    --metrics ifeval --out_dir "${out_root}" --seed "${SEED}" \
    --limit "${LIMIT}" --max_new_tokens "${MAX_NEW_TOKENS}" \
    --map_cache_dir "${out_root}/map_cache/eval_if_seed${SEED}" \
    --ifeval_input "${IFEVAL_INPUT}"
}

for run in ${RUNS}; do
  eval_one "${run}"
done

# ---------------------------------------------------------------------------
# 后置：每个 run 一行，原结果 vs 本次写出的 run 名。
# ---------------------------------------------------------------------------
set +x
python - "${RESULTS_MAIN}" "${RESULTS_SAFETY}" "${OUT_SUFFIX}" ${RUNS} <<'PY'
import json
import sys
from pathlib import Path

main_root = Path(sys.argv[1])
safety_root = Path(sys.argv[2])
suffix = sys.argv[3]
runs = sys.argv[4:]
roots = [main_root, safety_root]


def load(name):
    for root in roots:
        path = root / "ifeval" / name / "summary.json"
        if path.is_file():
            return json.loads(path.read_text(encoding="utf-8")), root.name
    return None, ""


def cell(payload, key):
    return f"{payload[key] * 100:6.2f}" if payload and key in payload else "  --  "


print()
print("=" * 118)
print("IFEval（%）。贪心解码，同一 adapter 重评差异应极小。")
print("=" * 118)
print(f"{'run':<52} {'tree':<16} {'strict p':>9} {'strict i':>9} {'loose p':>9} {'loose i':>9} {'Δsp':>8}")
for run in runs:
    orig, _ = load(run)
    out_name = f"{run}{suffix}" if suffix else run
    neu, tree = load(out_name)
    if orig and neu and "strict_prompt_accuracy" in orig and "strict_prompt_accuracy" in neu:
        delta = f"{(neu['strict_prompt_accuracy'] - orig['strict_prompt_accuracy']) * 100:+.2f}"
    else:
        delta = "  --  "
    print(
        f"{out_name:<52} {tree:<16} "
        f"{cell(neu, 'strict_prompt_accuracy'):>9} "
        f"{cell(neu, 'strict_instruction_accuracy'):>9} "
        f"{cell(neu, 'loose_prompt_accuracy'):>9} "
        f"{cell(neu, 'loose_instruction_accuracy'):>9} "
        f"{delta:>8}"
    )
    if orig and out_name != run:
        print(
            f"{'  原 ' + run:<52} {'':<16} "
            f"{cell(orig, 'strict_prompt_accuracy'):>9} "
            f"{cell(orig, 'strict_instruction_accuracy'):>9} "
            f"{cell(orig, 'loose_prompt_accuracy'):>9} "
            f"{cell(orig, 'loose_instruction_accuracy'):>9}"
        )
print()
print("Δsp = 本次 strict prompt − 同名原结果（若有）。541 条：1pp = 5.41 条；二项 SE ≈ 2pp。")
PY

echo "========================================================================"
echo "产物（各写回自己那棵树）:"
for run in ${RUNS}; do
  out_root="$(resolve_out_root "${run}")"
  out_name="$(resolve_out_name "${run}")"
  echo "  ${out_root}/ifeval/${out_name}/summary.json"
done
echo "Job finished at: $(date)"
