#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_8b_rep
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=48:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# NUS Hopper: Qwen3-8B replay 臂 —— 单域保护（训练 + 按域评测）
#
# OneReplay 的正面对手。同一批旧知识，两种用法：
#   70 号（OneReplay）把语料压成 C = E[x x^T] 一次，之后再也不碰语料；
#   本脚本（replay）留着语料，每个 micro-batch 掏出一部分和新任务一起训。
# 所以这两条臂必须消费同一批行，否则比的就不是「怎么用旧知识」而是「用了多少」。
#
# -----------------------------------------------------------------------------
# !! 同池这件事，机关不在 KEEP_COLUMN，在 --replay_drop_truncated
#   文档 09-09 的 2.4 节写了「replay 臂必须用全池，不能照抄 61 号带 KEEP_COLUMN
#   的命令行」。KEEP_COLUMN 是 collect_cov 那一侧的参数，本脚本根本不传它；
#   replay 这一侧对应的机关是另一个：
#
#       data/replay.py 的 load_self_distilled_pool 在 --replay_drop_truncated 1
#       （默认值！）时会把 truncated == true 的行**过滤掉**。
#
#   那个 truncated 标记说的是 1.7B 当年自蒸馏生成时答案顶到了 token 上限，
#   与本轮要训的 gold_targets 一点关系都没有 —— gold 在这些行上照样是满的。
#   68 号采 C 用的是全池（20000 行，不含 require_target_column），所以这里必须
#   传 --replay_drop_truncated 0，否则 replay 训到的行数会比 C 覆盖的少约 13%，
#   两条臂不再同池，而且这件事在日志里只有一行 "dropped N truncated rows"。
#
#   Step 1 不靠人读那行日志：它按 replay 的真实装配路径把池建出来，数出行数，
#   和 C 文件 metadata 里的 pool_rows 比，不等就退出。
#
# -----------------------------------------------------------------------------
# !! 4 new + 4 replay，以及 ACCUM 为什么是 128 而不是 64
#   本臂用 batch 级混合（--replay_per_batch），不是数据级（--replay_ratio）：
#   数据级混完再全局 shuffle，一个 accumulation 窗口里的新任务行数是二项分布
#   （64 ± 5.7），batch 级是逐 micro-batch 定死的。
#
#   --batch_size 保持 8 不变，replay 行是从这 8 行里**切出来**的，所以每步的
#   时间和峰值显存与 vanilla 直接可比。代价是每个 micro-batch 只剩 4 行新任务，
#   于是 accumulation_size 必须翻倍才能让「每次更新的新任务行数」回到 64：
#
#       accum_steps = ACCUM / BATCH = 128 / 8 = 16
#       每次更新的新任务行 = 16 x (8 - 4) = 64      <- 与 67/70 号相同
#
#   这就是为什么本脚本的 ACCUM 默认 128 而 70 号是 64，而两者的 new_per_update
#   都是 64。Step 0 断言的是 new_per_update，不是 ACCUM。
#
#   池是被**循环**用的，不是无放回采样：replay_per_batch=4 时一个 epoch 要消耗
#   约 168k replay 行，而池只有 2 万。这是刻意的 —— 池就是产生 C 的那批行，
#   为了避免重复而扩池等于让 replay 拿到比 C 更多的信息。
#
# -----------------------------------------------------------------------------
# !! replay_max_len 必须等于该域 C 的 max_len
#   训练侧的截断是保留末尾 max_len 个 token（丢问题、留答案），所以一条超长的
#   数学行在 512 下会退化成「无题干的续写」。C_math / C_code 是在 2048 下采的，
#   replay 若卡在 512，它保护的旧知识严格少于罚项编码的那一份。
#   本脚本按域取：if 512 / math 2048 / code 2048，与 68 号逐字对应。
#   新任务始终是 MAXLEN=512，两者互不影响（train.py 的 --replay_max_len 只管
#   replay 行）。
#
# -----------------------------------------------------------------------------
# 各域的池从哪来（与 68 号完全对应）
#   if    原始 FLAN。replay 侧 shuffle(seed=1) 取前 20000 行，collect_cov 侧
#         --sample_shuffle 1 --sample_seed 1 --max_samples 20000 --sample_strategy
#         uniform 走的是同两步操作（shuffle 后 select），所以两边同一批行。
#   math  1.7B 那批自蒸馏 jsonl 的 gold_targets 列，两个视角一起读，全池。
#   code  同上，一个文件，全池。
#   math/code 走 --replay_self_distill_file（那文件自带 index、行序确定），
#   只把答案列换成 gold_targets —— 这正是 data/replay.py 文件头写的第三种配置。
#
# -----------------------------------------------------------------------------
# 本臂不加载 C
#   --replay_lambda 0 且 --cov_path "" 且 --measure_replay_when_lambda_zero 0，
#   三个一起传，确保 build_regularizer 返回 None：否则它会为了「顺便测一下罚项
#   量级」把 33.75 GB 的 C 读进显存，纯属浪费。自检会核对 replay_reg 恒为 0。
#
# -----------------------------------------------------------------------------
# 开销：这条 baseline 的代价就是要被暴露出来的
#   同样的新任务行数下，本臂的 micro-batch 数是 vanilla 的两倍（每步只装 4 行
#   新任务），所以 train_sec 大约 2x，walltime 给到 48 h。
#   峰值显存反而应该与 vanilla 接近（micro-batch 还是 8 行），这与 OneReplay
#   常驻 33.75 GB 的 C 形成对照 —— 汇总表会把三者并排打出来。
#
# -----------------------------------------------------------------------------
# 评测口径按域走（与 70 号相同）
#       DOMAIN=if    评 ifeval + gsm8k + math500 + humaneval + mbpp
#       DOMAIN=math  评 ifeval + gsm8k + math500
#       DOMAIN=code  评 ifeval + humaneval + mbpp
#
# -----------------------------------------------------------------------------
# 投递前要有的东西
#   1) ${MODEL_DIR}/Qwen3-8B
#   2) 本域的语料：if 要 ${FLAN_DIR}；math/code 要 1.7B 那批 replay jsonl
#   3) 68 号产出的本域 C —— 本臂不训练时用它，只用它 metadata 里的 pool_rows
#      来证明同池。真没有就传 SKIP_POOL_CHECK=1，但那样就没有同池的证据了。
#   4) ${CS_DATASET} = datasets/commonsense_170k_hf
#   5) 67 号的 base 与 vanilla 已评完
#
# 投递（DRY_RUN=1 是默认，先看计划）:
#   qsub -v DRY_RUN=0,DOMAIN=if    onereplay/pbs/71_qwen3_8b_gold_replay.pbs
#   qsub -v DRY_RUN=0,DOMAIN=math  onereplay/pbs/71_qwen3_8b_gold_replay.pbs
#   qsub -v DRY_RUN=0,DOMAIN=code  onereplay/pbs/71_qwen3_8b_gold_replay.pbs
#   换 replay 比例（run 名会跟着变，不会覆盖）:
#   qsub -v DRY_RUN=0,DOMAIN=if,REPLAY_PER_BATCH=2,ACCUM=112 onereplay/pbs/71_...
#     注意自己把 ACCUM 配平到 new_per_update=64：(ACCUM/8) x (8-2) = 64 -> ACCUM=85.3
#     配不平就取最近的整数步（如 ACCUM=88 给 66 行），Step 0 会打印实际值并要求
#     ALLOW_DRIFT=1 才放行。
#   拆两次投（训练与评测分开）:
#   qsub -v DRY_RUN=0,DOMAIN=if,DO_EVAL=0  ...   然后   DO_TRAIN=0
#
#   若本站点 qsub 不吃 -v（63 号文件头有过这个记录），就直接改「阶段开关」段的
#   默认值再投。
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/71_qwen3_8b_gold_replay.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME CS_DATASET RESULTS_ROOT MATH_DATA_DIR CODE_DATA_DIR
    DATASET_CACHE OUT_DIR FLAN_DIR POOL_ROOT
    DRY_RUN DO_TRAIN DO_EVAL FORCE_TRAIN FORCE_EVAL PROBE ALLOW_DRIFT SKIP_POOL_CHECK
    DOMAIN COV_PATH IF_COV MATH_COV CODE_COV
    REPLAY_PER_BATCH REPLAY_FILE REPLAY_DATA_FILES REPLAY_TARGET_COLUMN
    REPLAY_INPUT_COLUMN REPLAY_POOL_SIZE REPLAY_SAMPLE_SEED REPLAY_MAXLEN
    REPLAY_DROP_TRUNCATED
    SEED EPOCHS LR BATCH ACCUM MAXLEN VAL_FRAC MAXVAL
    TARGET_MODULES LORA_RANK LORA_ALPHA LORA_DROPOUT
    EVAL_BATCH SAVE MAX_STEPS RUN_TAG RUN VANILLA_RUN
    MATH500_FILE GSM8K_FILE HUMANEVAL_FILE MBPP_DIR MBPP_SPLIT IFEVAL_INPUT
    MATH_MAX_NEW_TOKENS CODE_MAX_NEW_TOKENS IF_MAX_NEW_TOKENS
    MATH_BATCH CODE_BATCH IFEVAL_BATCH
    TIMEOUT LIMIT DIAG_LEN WITH_BASE WITH_VANILLA EXTRA_MODELS
    POOL_LEN_DIAG LEN_DIAG_SAMPLE ONEREPLAY_METRICS
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：那会把当前 shell 替换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的训练与评测。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

# ---- 项目路径：写 8B 自己的目录，与 1.7B 那批彻底隔离 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-8B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results/qwen3-8b}"
CS_DATASET="${CS_DATASET:-${REPO_ROOT}/datasets/commonsense_170k_hf}"
MATH_DATA_DIR="${MATH_DATA_DIR:-${REPO_ROOT}/datasets/math}"
CODE_DATA_DIR="${CODE_DATA_DIR:-${REPO_ROOT}/datasets/code}"
# 旧知识语料：if 读原始 FLAN，math/code 读 1.7B 那批 replay jsonl（只读，
# gold_targets 列是数据集自带的解答、与生成它的模型无关）。
FLAN_DIR="${FLAN_DIR:-${REPO_ROOT}/datasets/flan}"
POOL_ROOT="${POOL_ROOT:-${REPO_ROOT}/results}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
ADAPTERS="${RESULTS_ROOT}/adapters"
COV_DIR="${RESULTS_ROOT}/cov"
TRAIN_LOG_DIR="${RESULTS_ROOT}/train_logs"
export HF_DATASETS_CACHE="${DATASET_CACHE}"

# ---- 阶段开关 ----
DRY_RUN="${DRY_RUN:-1}"          # 默认只做前置检查与 C 诊断，不训练不评测
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"
PROBE="${PROBE:-0}"             # 1 = 300 步短跑，只看池装配与吞吐
ALLOW_DRIFT="${ALLOW_DRIFT:-0}"  # 1 = 容忍与 67 号不一致的超参（会打印偏差清单）
SKIP_POOL_CHECK="${SKIP_POOL_CHECK:-0}"  # 1 = 不与 C 的 pool_rows 比（那就没有同池证据）
WITH_BASE="${WITH_BASE:-0}"      # base/vanilla 由 67 号评过，默认不重评
WITH_VANILLA="${WITH_VANILLA:-0}"

# ---- 保护域：决定 C、run 名与评测口径 ----
DOMAIN="${DOMAIN:-}"
case "${DOMAIN}" in
  if|math|code) ;;
  "")
    echo "!! 必须指定 DOMAIN（if / math / code）。"
    echo "   例: qsub -v DRY_RUN=0,DOMAIN=if ${SELF_PATH}"
    exit 1
    ;;
  *)
    echo "!! DOMAIN=${DOMAIN} 不认识，只能是 if / math / code（本轮不做 mix）"
    exit 1
    ;;
esac

# ---- 训练超参：与 67 号逐字一致；LR 是唯一有意留的自由度 ----
SEED="${SEED:-1}"
EPOCHS="${EPOCHS:-3}"
LR="${LR:-2e-4}"                 # 67 号若因 lr=2e-4 崩溃回落 1e-4，本臂必须跟着回落
BATCH="${BATCH:-8}"              # micro-batch 总行数，与 vanilla 同值才能比每步开销
# 128 而不是 64：每个 micro-batch 只剩 4 行新任务，accum_steps 要翻倍才能让
# 每次更新的新任务行数回到 64。见文件头的算术。
ACCUM="${ACCUM:-128}"
REPLAY_PER_BATCH="${REPLAY_PER_BATCH:-4}"   # 从 BATCH 里切出来的 replay 行数
EVAL_BATCH="${EVAL_BATCH:-8}"    # 钉住，否则 val_loss 与 67 号及其余各臂不可比
MAXLEN="${MAXLEN:-512}"
VAL_FRAC="${VAL_FRAC:-0.01}"
MAXVAL="${MAXVAL:-1000}"
LORA_RANK="${LORA_RANK:-16}"
LORA_ALPHA="${LORA_ALPHA:-32}"
LORA_DROPOUT="${LORA_DROPOUT:-0.05}"
TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj}"
SAVE="${SAVE:-1}"
MAX_STEPS="${MAX_STEPS:-0}"

# ---- replay 的语料与口径：每一项都与 68 号采 C 时逐字对应 ----
REPLAY_INPUT_COLUMN="${REPLAY_INPUT_COLUMN:-inputs}"
REPLAY_SAMPLE_SEED="${REPLAY_SAMPLE_SEED:-1}"    # 必须等于 collect_cov 的 --sample_seed
# truncated 标记说的是自蒸馏答案顶到了上限，与 gold_targets 无关；68 号采 C 用的
# 是全池，所以这里必须 0。默认 1 会静默少掉约 13% 的行。见文件头。
REPLAY_DROP_TRUNCATED="${REPLAY_DROP_TRUNCATED:-0}"

MATH_VIEW_PREFIX="${MATH_VIEW_PREFIX:-metamath_cmath_30k}"
CODE_VIEW_PREFIX="${CODE_VIEW_PREFIX:-opc_edu_ccode_20k}"

case "${DOMAIN}" in
  if)
    # 原始 FLAN，targets 本身就是 gold。走 --replay_data_files 的 gold 路径：
    # shuffle(seed) 后 select(pool_size)，与 collect_cov 的 uniform 策略同两步操作。
    REPLAY_FILE=""
    REPLAY_DATA_FILES="${REPLAY_DATA_FILES:-${FLAN_DIR}/train/*.jsonl}"
    REPLAY_TARGET_COLUMN="${REPLAY_TARGET_COLUMN:-targets}"
    REPLAY_POOL_SIZE="${REPLAY_POOL_SIZE:-20000}"   # = 68 号的 FLAN_SAMPLES
    REPLAY_MAXLEN="${REPLAY_MAXLEN:-512}"           # = 68 号的 IF_MAXLEN
    EXPECT_POOL_FILES=0                             # 分片数不定，只要求 >0
    ;;
  math)
    # 与 68 号的 MATH_GLOB 逐字相同的通配。两个视角一起读，少读一个就等于换了池，
    # 所以下面要求它正好展开出 2 个文件。
    REPLAY_FILE="${REPLAY_FILE:-${POOL_ROOT}/replay/${MATH_VIEW_PREFIX}_*_selfdistill_seed${REPLAY_SAMPLE_SEED}.jsonl}"
    REPLAY_DATA_FILES=""
    REPLAY_TARGET_COLUMN="${REPLAY_TARGET_COLUMN:-gold_targets}"
    REPLAY_POOL_SIZE="${REPLAY_POOL_SIZE:-0}"       # 全池，= 68 号的 --max_samples 0
    REPLAY_MAXLEN="${REPLAY_MAXLEN:-2048}"          # = 68 号的 MATH_MAXLEN
    EXPECT_POOL_FILES=2
    ;;
  code)
    REPLAY_FILE="${REPLAY_FILE:-${POOL_ROOT}/replay/${CODE_VIEW_PREFIX}_selfdistill_seed${REPLAY_SAMPLE_SEED}.jsonl}"
    REPLAY_DATA_FILES=""
    REPLAY_TARGET_COLUMN="${REPLAY_TARGET_COLUMN:-gold_targets}"
    REPLAY_POOL_SIZE="${REPLAY_POOL_SIZE:-0}"
    REPLAY_MAXLEN="${REPLAY_MAXLEN:-2048}"          # = 68 号的 CODE_MAXLEN
    EXPECT_POOL_FILES=1
    ;;
esac

# 68 号的三份 C。本臂不训练时用它，只读 metadata 里的 pool_rows 证明同池。
IF_COV="${IF_COV:-${COV_DIR}/cov_flan_chat_20k_8b_all.pt}"
MATH_COV="${MATH_COV:-${COV_DIR}/cov_math_metamath30k_gold_8b_all.pt}"
CODE_COV="${CODE_COV:-${COV_DIR}/cov_code_opcedu20k_gold_8b_all.pt}"
case "${DOMAIN}" in
  if)   COV_PATH="${COV_PATH:-${IF_COV}}" ;;
  math) COV_PATH="${COV_PATH:-${MATH_COV}}" ;;
  code) COV_PATH="${COV_PATH:-${CODE_COV}}" ;;
esac

if [[ "${PROBE}" == "1" ]]; then
  SAVE=0
  [[ "${MAX_STEPS}" == "0" ]] && MAX_STEPS=300
  EPOCHS=1                       # 300 步 x 3 个 epoch 没有额外信息，只是等三倍时间
  DO_EVAL=0
  echo "PROBE=1：SAVE=0 MAX_STEPS=${MAX_STEPS} EPOCHS=1 DO_EVAL=0，只看池装配与吞吐"
fi

# 每次更新的新任务行数：这是与 67/70 号必须相等的量（不是 ACCUM）。
NEW_PER_BATCH=$(( BATCH - REPLAY_PER_BATCH ))
ACCUM_STEPS=$(( ACCUM / BATCH ))
NEW_PER_UPDATE=$(( ACCUM_STEPS * NEW_PER_BATCH ))

# ---- run 名：域与混合比都编进去 ----
RUN_TAG="${RUN_TAG:-r${LORA_RANK}all}"
RUN="${RUN:-cs_replay_8b_${DOMAIN}gold_${RUN_TAG}_${NEW_PER_BATCH}n${REPLAY_PER_BATCH}r_lr${LR}_seed${SEED}}"
# 67 号的 vanilla：分母。名字必须按同一套规则拼，否则末尾的对照表读不到它。
VANILLA_RUN="${VANILLA_RUN:-cs_vanilla_8b_${RUN_TAG}_lr${LR}_seed${SEED}}"
TRAIN_LOG="${TRAIN_LOG_DIR}/${RUN}.train.log"

# ---- 评测数据 ----
MATH500_FILE="${MATH500_FILE:-${MATH_DATA_DIR}/math500_test.jsonl}"
GSM8K_FILE="${GSM8K_FILE:-${MATH_DATA_DIR}/gsm8k_test.jsonl}"
HUMANEVAL_FILE="${HUMANEVAL_FILE:-${CODE_DATA_DIR}/humaneval_test.parquet}"
MBPP_DIR="${MBPP_DIR:-${CODE_DATA_DIR}/mbpp_full}"
MBPP_SPLIT="${MBPP_SPLIT:-test}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"

# ---- 解码预算与解码 batch：67 号定的口径，所有臂必须逐字相同 ----
MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS:-4096}"
CODE_MAX_NEW_TOKENS="${CODE_MAX_NEW_TOKENS:-512}"
IF_MAX_NEW_TOKENS="${IF_MAX_NEW_TOKENS:-768}"
MATH_BATCH="${MATH_BATCH:-32}"
CODE_BATCH="${CODE_BATCH:-64}"
IFEVAL_BATCH="${IFEVAL_BATCH:-32}"

TIMEOUT="${TIMEOUT:-10}"
LIMIT="${LIMIT:-0}"
DIAG_LEN="${DIAG_LEN:-1}"
EXTRA_MODELS="${EXTRA_MODELS:-}" # "name;/abs/path" 用 | 分隔，额外要评的已有 run
POOL_LEN_DIAG="${POOL_LEN_DIAG:-1}"       # 1 = Step 1 抽样统计池的未截断长度
LEN_DIAG_SAMPLE="${LEN_DIAG_SAMPLE:-1500}"

# 按域决定评哪些指标（文档 09-09 第一节的口径）
case "${DOMAIN}" in
  if)   DOMAIN_METRICS="ifeval gsm8k math500 humaneval mbpp" ;;
  math) DOMAIN_METRICS="ifeval gsm8k math500" ;;
  code) DOMAIN_METRICS="ifeval humaneval mbpp" ;;
esac

# LIMIT>0 的产物只覆盖前 N 题，写进正式目录会被"已有 summary.json 就跳过"当成完整结果。
OUT_DIR="${OUT_DIR:-${RESULTS_ROOT}}"
if [[ "${LIMIT}" != "0" ]]; then
  OUT_DIR="${OUT_DIR}_limit${LIMIT}"
fi

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺基座模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
mkdir -p "${ADAPTERS}" "${RESULTS_ROOT}/metrics" "${OUT_DIR}" "${DATASET_CACHE}" "${TRAIN_LOG_DIR}"

set +x
echo "========================================================================"
echo "Qwen3-8B replay 臂：保护 ${DOMAIN}"
echo "  run      = ${RUN}"
echo "  分母     = base / ${VANILLA_RUN}   (67 号产出)"
echo "  对手     = 70 号 OneReplay 同域（同池，只差怎么用旧知识）"
echo "  语料     = ${REPLAY_FILE:-${REPLAY_DATA_FILES}}"
echo "             答案列=${REPLAY_TARGET_COLUMN}  pool_size=${REPLAY_POOL_SIZE:-<全池>}"
echo "             sample_seed=${REPLAY_SAMPLE_SEED}  drop_truncated=${REPLAY_DROP_TRUNCATED}"
echo "             replay_max_len=${REPLAY_MAXLEN}（该域 C 的 max_len）"
echo "  同池参照 = ${COV_PATH}   skip_check=${SKIP_POOL_CHECK}"
echo "  混合     = ${NEW_PER_BATCH} new + ${REPLAY_PER_BATCH} replay / micro-batch(${BATCH})"
echo "             accum_steps ${ACCUM_STEPS} x ${NEW_PER_BATCH} = ${NEW_PER_UPDATE} 行新任务/更新（要 = 64）"
echo "  LoRA     = r${LORA_RANK} alpha${LORA_ALPHA} dropout${LORA_DROPOUT}"
echo "             targets=${TARGET_MODULES}"
echo "  训练     = LR ${LR} / EPOCHS ${EPOCHS} / BATCH ${BATCH} / ACCUM ${ACCUM} / MAXLEN ${MAXLEN}"
echo "             eval_batch ${EVAL_BATCH} / seed ${SEED} / max_steps ${MAX_STEPS}"
echo "  评测     = ${DOMAIN_METRICS}"
echo "             预算 math ${MATH_MAX_NEW_TOKENS} / code ${CODE_MAX_NEW_TOKENS} / ifeval ${IF_MAX_NEW_TOKENS}"
echo "             batch math ${MATH_BATCH} / code ${CODE_BATCH} / ifeval ${IFEVAL_BATCH}"
echo "  阶段     = train:${DO_TRAIN} eval:${DO_EVAL} probe:${PROBE} DRY_RUN=${DRY_RUN}"
echo "  OUT_DIR  = ${OUT_DIR}"
echo "========================================================================"

# ===========================================================================
# Step 0: 与 67 号的对齐检查（纯 bash，秒级）
#   delta 只有在「除了正则项之外一切相同」时才是这个方法的效果。
# ===========================================================================
echo "==== Step 0: 对齐检查 ===="

[[ -d "${CS_DATASET}" ]] || { echo "缺 commonsense_170k: ${CS_DATASET}"; exit 1; }

# ---- 语料在不在，且文件数正确 ----
#   math 的通配要正好展开出 2 个（两个视角）。少一个 load_dataset 不会报错，
#   它只会安静地少读一半池 —— Step 1 的行数比会抓到，但在这里就报更省事。
POOL_GLOB="${REPLAY_FILE:-${REPLAY_DATA_FILES}}"
# shellcheck disable=SC2086
POOL_FILES=$(ls -1 ${POOL_GLOB} 2>/dev/null | wc -l)
if (( POOL_FILES == 0 )); then
  echo "!! ${POOL_GLOB} 没匹配到任何文件。"
  echo "   if 域读 FLAN_DIR=${FLAN_DIR}；math/code 读 POOL_ROOT=${POOL_ROOT}/replay"
  echo "   （那是 1.7B 那批自蒸馏 jsonl，本臂只取它的 ${REPLAY_TARGET_COLUMN} 列）。"
  exit 1
fi
if (( EXPECT_POOL_FILES > 0 && POOL_FILES != EXPECT_POOL_FILES )); then
  echo "!! ${POOL_GLOB} 展开出 ${POOL_FILES} 个文件，期望 ${EXPECT_POOL_FILES} 个。"
  echo "   68 号采本域 C 时用的是同一个通配；文件数不同就不是同一个池。"
  # shellcheck disable=SC2086
  ls -1 ${POOL_GLOB}
  exit 1
fi
echo "语料文件 ${POOL_FILES} 个: ${POOL_GLOB}"

# ---- 同池的参照物 ----
if [[ "${SKIP_POOL_CHECK}" == "1" ]]; then
  echo "warning: SKIP_POOL_CHECK=1，不与 C 的 pool_rows 比。"
  echo "         这条臂与 70 号是否同池就没有证据了，结论只能当作参考。"
elif [[ ! -f "${COV_PATH}" ]]; then
  echo "!! 缺 C: ${COV_PATH}"
  echo "   本臂不用它训练，只读它 metadata 里的 pool_rows 来证明与 70 号同池。"
  echo "   68 号还没跑就先跑它；确实要先跑 replay 就传 SKIP_POOL_CHECK=1。"
  exit 1
fi

# ---- 混合比的算术：要保的是新任务行数，不是 ACCUM ----
if (( REPLAY_PER_BATCH <= 0 || REPLAY_PER_BATCH >= BATCH )); then
  echo "!! REPLAY_PER_BATCH=${REPLAY_PER_BATCH} 必须在 1..$((BATCH-1)) 之间。"
  echo "   =0 就是 vanilla（67 号），=BATCH 就一行新任务都没有了。"
  exit 1
fi
if (( ACCUM % BATCH != 0 )); then
  echo "ACCUM=${ACCUM} 不能被 BATCH=${BATCH} 整除，每次更新的行数会被静默取整"; exit 1
fi

# 67 号钉下来的值。LR 不在其中：它是有意留的自由度，但必须与被比的 vanilla 同值。
DRIFT=()
[[ "${TARGET_MODULES}" == "q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj" ]] \
  || DRIFT+=("target_modules=${TARGET_MODULES}（67 号: all-linear 七类）")
[[ "${LORA_RANK}"    == "16"   ]] || DRIFT+=("lora_rank=${LORA_RANK}（67 号: 16）")
[[ "${LORA_ALPHA}"   == "32"   ]] || DRIFT+=("lora_alpha=${LORA_ALPHA}（67 号: 32）")
[[ "${LORA_DROPOUT}" == "0.05" ]] || DRIFT+=("lora_dropout=${LORA_DROPOUT}（67 号: 0.05）")
[[ "${BATCH}"        == "8"    ]] || DRIFT+=("batch_size=${BATCH}（67 号: 8，每步开销靠它可比）")
# 本臂刻意与 67 号不同的一项。要对齐的是 NEW_PER_UPDATE，ACCUM 只是达到它的手段。
(( NEW_PER_UPDATE == 64 )) || DRIFT+=("每次更新的新任务行数=${NEW_PER_UPDATE}（67/70 号: 64）；\
调 ACCUM 使 (ACCUM/${BATCH})x${NEW_PER_BATCH}=64，当前 ACCUM=${ACCUM}")
[[ "${EVAL_BATCH}"   == "8"    ]] || DRIFT+=("eval_batch_size=${EVAL_BATCH}（67 号: 8，val_loss 靠它可比）")
[[ "${MAXLEN}"       == "512"  ]] || DRIFT+=("max_len=${MAXLEN}（67 号: 512）")
[[ "${VAL_FRAC}"     == "0.01" ]] || DRIFT+=("val_fraction=${VAL_FRAC}（67 号: 0.01，改了 val 划分就变了）")
[[ "${MAXVAL}"       == "1000" ]] || DRIFT+=("max_val_samples=${MAXVAL}（67 号: 1000）")
if [[ "${PROBE}" != "1" ]]; then
  [[ "${EPOCHS}"   == "3" ]] || DRIFT+=("epochs=${EPOCHS}（67 号: 3）")
  [[ "${MAX_STEPS}" == "0" ]] || DRIFT+=("max_steps=${MAX_STEPS}（正式 run 应为 0）")
fi
# 全池：这是本臂与 70 号同池的唯一开关，写进 DRIFT 是为了改了以后必须解释。
[[ "${REPLAY_DROP_TRUNCATED}" == "0" ]] || DRIFT+=("replay_drop_truncated=${REPLAY_DROP_TRUNCATED}\
（必须 0；1 会静默丢掉 truncated 行，池就比 68 号采 C 的那份小了）")
# replay 的截断长度必须等于该域 C 的 max_len，否则保护的旧知识严格少于罚项编码的那份。
case "${DOMAIN}" in
  if)        _want_rlen=512 ;;
  math|code) _want_rlen=2048 ;;
esac
[[ "${REPLAY_MAXLEN}" == "${_want_rlen}" ]] || DRIFT+=("replay_max_len=${REPLAY_MAXLEN}\
（68 号采 ${DOMAIN} 的 C 用的是 ${_want_rlen}；不等就与 70 号看到的旧知识不同）")

if (( ${#DRIFT[@]} > 0 )); then
  echo "与 67 号不一致的项:"
  for item in "${DRIFT[@]}"; do echo "  - ${item}"; done
  if [[ "${ALLOW_DRIFT}" != "1" ]]; then
    echo "!! 这些偏差会让 delta 里混进第二个变量。确实要改就传 ALLOW_DRIFT=1，"
    echo "   并把偏差写进结果表。停。"
    exit 1
  fi
  echo "ALLOW_DRIFT=1：继续，但上面每一条都要写进结果表。"
else
  echo "训练超参与 67 号逐字一致。"
fi

if [[ ! -f "${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl" ]]; then
  echo "warning: 找不到 ${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl"
  echo "         67 号的 vanilla（LR=${LR}）还没跑完，本臂现在没有可比的分母。"
  echo "         若 67 号回落到了 LR=1e-4，本臂也要传 LR=1e-4。"
fi
for f in "${IFEVAL_INPUT}" "${MATH500_FILE}" "${GSM8K_FILE}" "${HUMANEVAL_FILE}"; do
  [[ -f "${f}" ]] || echo "warning: 缺评测数据 ${f}（相关指标会被跳过）"
done
[[ -d "${MBPP_DIR}" ]] || echo "warning: 缺 MBPP 目录 ${MBPP_DIR}（该指标会被跳过）"

# ===========================================================================
# Step 1: 同池断言（本脚本存在的主要理由）
#   OneReplay 与 replay 的对比只有在两条臂消费同一批行时才成立。这里不去读
#   日志里那行 "dropped N truncated rows" —— 而是按 replay 的**真实装配路径**
#   （直接 import onereplay.data.replay 的函数，不复写一遍逻辑）把池建出来，
#   数出可用行数，与 68 号写在 C metadata 里的 pool_rows 比。
#
#   顺带的好处：这一步会把 json -> arrow 的转换结果落进 ${DATASET_CACHE}，
#   训练时 load_dataset 直接命中缓存，所以这次读盘基本不是白花的。
# ===========================================================================
echo "==== Step 1: 同池检查 ===="
export MODEL_DIR MODEL_NAME COV_PATH DOMAIN SKIP_POOL_CHECK POOL_LEN_DIAG
export REPLAY_FILE REPLAY_DATA_FILES REPLAY_TARGET_COLUMN REPLAY_INPUT_COLUMN
export REPLAY_POOL_SIZE REPLAY_SAMPLE_SEED REPLAY_MAXLEN REPLAY_DROP_TRUNCATED
export MAXLEN DATASET_CACHE LEN_DIAG_SAMPLE
export BATCH REPLAY_PER_BATCH ACCUM EPOCHS
POOL_REPORT_FILE="${TMPDIR}/pool_preflight_${RUN}.txt"

if ! python - <<'PY' 2>&1 | tee "${POOL_REPORT_FILE}"; then
import argparse
import os
import random
from pathlib import Path

import torch

from onereplay.data.replay import (
    load_replay_pool,
    load_self_distilled_pool,
    replay_max_len,
    replay_target_flavor,
    to_sft_schema,
)

# 与 train.py 会构造的那份 args 同值。字段名照抄 train.py 的 add_argument，
# 少一个就会在 getattr 的默认值上静默走回默认行为。
args = argparse.Namespace(
    replay_dataset_path="",
    replay_data_files=os.environ["REPLAY_DATA_FILES"],
    replay_split="train",
    replay_cache_dir=os.environ["DATASET_CACHE"],
    replay_self_distill_file=os.environ["REPLAY_FILE"],
    replay_mix_files="",
    replay_drop_truncated=int(os.environ["REPLAY_DROP_TRUNCATED"]),
    replay_input_column=os.environ["REPLAY_INPUT_COLUMN"],
    replay_target_column=os.environ["REPLAY_TARGET_COLUMN"],
    replay_pool_size=int(os.environ["REPLAY_POOL_SIZE"]),
    replay_sample_seed=int(os.environ["REPLAY_SAMPLE_SEED"]),
    max_len=int(os.environ["MAXLEN"]),
    replay_max_len=int(os.environ["REPLAY_MAXLEN"]),
)

failures = []

# ---- 按 build_replay_dataset 的前半段装配池（后半段只是 tokenize）----
if args.replay_self_distill_file:
    pool = load_self_distilled_pool(args)
    source = args.replay_self_distill_file
    ordering = "文件序，按 index 列排回池序；不做第二次 shuffle"
else:
    pool = load_replay_pool(args)
    raw_total = len(pool)
    pool = pool.shuffle(seed=args.replay_sample_seed)
    if args.replay_pool_size > 0:
        pool = pool.select(range(min(args.replay_pool_size, len(pool))))
    source = args.replay_data_files
    ordering = f"shuffle(seed={args.replay_sample_seed}) 后取前 {len(pool)} 行（原始 {raw_total}）"

after_pool = len(pool)
has_truncated = "truncated" in pool.column_names
dataset = to_sft_schema(pool, args)
rows = len(dataset)

print(f"域           = {os.environ['DOMAIN']}")
print(f"语料         = {source}")
print(f"行序         = {ordering}")
print(f"答案列       = {args.replay_target_column}   ({replay_target_flavor(args)})")
print(f"drop_truncated = {args.replay_drop_truncated}"
      f"   (池里{'有' if has_truncated else '没有'} truncated 列)")
print(f"装配后行数   = {after_pool} -> to_sft_schema 过滤空行后 {rows}")
print(f"replay_max_len = {replay_max_len(args)}   (新任务仍是 {args.max_len})")

if args.replay_drop_truncated == 1 and has_truncated:
    failures.append(
        "replay_drop_truncated=1 且池里有 truncated 列：那些行的 gold_targets 是完整的，"
        "68 号采 C 时也算了它们。丢掉它们等于 replay 训的行比 C 覆盖的少。传 0。"
    )

# ---- 与 C 的 pool_rows 对表：这是同池的唯一硬证据 ----
if os.environ["SKIP_POOL_CHECK"] == "1":
    print()
    print("SKIP_POOL_CHECK=1：不与 C 对表，本臂与 70 号是否同池没有证据。")
    cov_rows = None
else:
    cov_path = os.environ["COV_PATH"]
    try:
        payload = torch.load(cov_path, map_location="cpu", mmap=True)
    except (TypeError, RuntimeError):
        # mmap 不可用就整份读。只为了 metadata 读 33.75 GiB 很浪费，但比不查好。
        payload = torch.load(cov_path, map_location="cpu")
    meta = payload.get("metadata", {}) if isinstance(payload, dict) else {}
    cov_rows = meta.get("pool_rows")
    cov_max_len = meta.get("max_len")
    print()
    print(f"C            = {cov_path}")
    print(f"  pool_rows        = {cov_rows}")
    print(f"  max_len          = {cov_max_len}")
    print(f"  target_column    = {meta.get('target_column')}")
    print(f"  require_target_column = {meta.get('require_target_column')}")
    print(f"  pool_fingerprint = {meta.get('pool_fingerprint')}")

    if cov_rows is None:
        failures.append(
            f"{cov_path} 的 metadata 里没有 pool_rows，无法证明同池。"
            "这份 C 可能是更早的脚本产的；重采或传 SKIP_POOL_CHECK=1（并在结果里注明）。"
        )
    elif int(cov_rows) != rows:
        failures.append(
            f"池行数不一致：replay 会训 {rows} 行，C 是在 {cov_rows} 行上采的。"
            "两条臂消费的旧知识不同，比出来的就不是「怎么用」而是「用了多少」。"
            "先查 replay_drop_truncated / replay_pool_size / replay_sample_seed / 答案列。"
        )
    else:
        print(f"  -> 行数一致（{rows}），两条臂同池。")

    # fingerprint 故意不比：replay 侧按 index 排序，collect_cov 侧按文件序，
    # fingerprint_pool 按迭代顺序哈希，同一批行也会得出不同值。行数才是可比的量。
    if cov_max_len is not None and int(cov_max_len) != replay_max_len(args):
        failures.append(
            f"replay_max_len={replay_max_len(args)} 与 C 的 max_len={cov_max_len} 不等。"
            "训练截断保留末尾 token，长行会丢题干；两条臂看到的旧知识长度不同。"
        )

# ---- 混合比与 epoch 的算术 ----
batch = int(os.environ["BATCH"])
per_batch = int(os.environ["REPLAY_PER_BATCH"])
accum = int(os.environ["ACCUM"])
epochs = int(os.environ["EPOCHS"])
new_per_batch = batch - per_batch
print()
print("---- 混合比")
print(f"micro-batch {batch} = {new_per_batch} new + {per_batch} replay")
print(f"每次更新的新任务行 = ({accum}/{batch}) x {new_per_batch} = {accum // batch * new_per_batch}"
      "   (67/70 号是 64)")
if rows:
    # commonsense_170k 的确切行数由 train.py 划分 val 后才定，这里只按池的循环
    # 次数给个量级：replay 消费的行数 = 新任务步数 x per_batch。
    print(f"池 {rows} 行被循环使用；每 epoch 的 replay 行数 = "
          f"(新任务行数/{new_per_batch}) x {per_batch}")
    print(f"{epochs} 个 epoch 下来会把池过很多遍。这是刻意的：为了避免重复而扩池，")
    print("等于让 replay 拿到比 C 更多的信息，对比就不成立了。")

# ---- 长度诊断：验证 replay_max_len 这个选择本身 ----
if os.environ.get("POOL_LEN_DIAG", "1") == "1":
    from transformers import AutoTokenizer

    from onereplay.data.chat import apply_train_template

    tok = AutoTokenizer.from_pretrained(
        str(Path(os.environ["MODEL_DIR"]) / os.environ["MODEL_NAME"]), trust_remote_code=True
    )
    sample_n = min(int(os.environ.get("LEN_DIAG_SAMPLE", "1500")), rows)
    rng = random.Random(0)
    idx = rng.sample(range(rows), sample_n) if sample_n < rows else list(range(rows))
    lengths = []
    for i in idx:
        row = dataset[i]
        full_text, _ = apply_train_template(tok, row["instruction"], "", row["output"])
        lengths.append(len(tok(full_text, add_special_tokens=False)["input_ids"]))
    lengths.sort()
    budget = replay_max_len(args)
    over = sum(1 for n in lengths if n > budget)
    print()
    print(f"---- 长度（{sample_n} 行抽样，未截断的完整 token 数）")
    print(f"P50 {lengths[len(lengths) // 2]}   P95 {lengths[int(len(lengths) * 0.95)]}   "
          f"max {lengths[-1]}")
    print(f"超过 replay_max_len={budget} 的比例 {over / len(lengths):.2%}")
    if over:
        print("这些行会丢掉题干只留答案，变成无题干的续写。C 在同一个 max_len 下采的，")
        print("所以两条臂受同样的影响，对比仍然成立 —— 但报告里要写明这个比例。")
else:
    print()
    print("POOL_LEN_DIAG=0：跳过长度抽样（省一次 tokenize）。")

print()
if failures:
    print("!! 同池检查未通过:")
    for item in failures:
        print(f"   - {item}")
    raise SystemExit(1)
print(f"同池检查通过。EXPECT_POOL_ROWS={rows}")
PY
  echo "!! Step 1 未通过，不进入训练。"
  exit 1
fi

EXPECT_POOL_ROWS="$(grep -o 'EXPECT_POOL_ROWS=[0-9]*' "${POOL_REPORT_FILE}" | tail -n 1)"
EXPECT_POOL_ROWS="${EXPECT_POOL_ROWS#EXPECT_POOL_ROWS=}"
[[ -n "${EXPECT_POOL_ROWS}" ]] || { echo "!! 没解析到 EXPECT_POOL_ROWS，训练后的池行数断言会失效。停。"; exit 1; }
echo "训练后要在日志里核对的池行数: ${EXPECT_POOL_ROWS}"

if [[ "${DRY_RUN}" == "1" ]]; then
  echo ""
  echo "DRY_RUN=1：以上为计划与前置检查，未训练未评测。"
  echo "确认无误后: qsub -v DRY_RUN=0,DOMAIN=${DOMAIN} ${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi
set -x

# ===========================================================================
# 训练
#   profile 保持 0：它每阶段插 cuda synchronize，会污染要上报的墙钟。
#   peak memory / epoch wall time 不开 profile 也照样写进 metrics jsonl。
#
#   !! 本臂不许加载 C
#   --replay_lambda 0 只是不把罚项加进 loss；决定要不要读 C 的是
#       should_load = replay_lambda > 0 or (measure_replay_when_lambda_zero == 1
#                                           and Path(penalty_path).exists())
#   而 Path("") 会解析成 Path(".")、exists() 为真，所以单靠 --cov_path "" 挡不住，
#   反而会去 torch.load 一个目录。必须显式传 --measure_replay_when_lambda_zero 0。
#   读了 C 就白付 33.75 GB 显存和每步的求值，本臂上报的开销也就不是它自己的了。
# ===========================================================================
REPLAY_ARGS=(
  --replay_per_batch "${REPLAY_PER_BATCH}"
  --replay_input_column "${REPLAY_INPUT_COLUMN}"
  --replay_target_column "${REPLAY_TARGET_COLUMN}"
  --replay_pool_size "${REPLAY_POOL_SIZE}"
  --replay_sample_seed "${REPLAY_SAMPLE_SEED}"
  --replay_max_len "${REPLAY_MAXLEN}"
  --replay_drop_truncated "${REPLAY_DROP_TRUNCATED}"
  --replay_cache_dir "${DATASET_CACHE}"
)
if [[ -n "${REPLAY_FILE}" ]]; then
  # index 列已经带着池序，load_self_distilled_pool 会按它排回去，不做第二次 shuffle
  REPLAY_ARGS+=( --replay_self_distill_file "${REPLAY_FILE}" )
else
  REPLAY_ARGS+=( --replay_data_files "${REPLAY_DATA_FILES}" )
fi

if [[ "${DO_TRAIN}" == "1" ]]; then
  if [[ "${FORCE_TRAIN}" != "1" && "${SAVE}" == "1" && -d "${ADAPTERS}/${RUN}" ]]; then
    echo "跳过训练 ${RUN}：adapter 已存在（FORCE_TRAIN=1 可强制重训）"
  else
    mkdir -p "${RESULTS_ROOT}/map_cache/${RUN}"
    echo "==== train: ${RUN} (${NEW_PER_BATCH}n${REPLAY_PER_BATCH}r, 池=${POOL_GLOB}) ===="
    # 训练输出同时留一份文件：池行数、混合比、答案口径那几句只在 stdout 上，
    # metrics jsonl 里没有。
    python -m onereplay.scripts.train --paradigm sft \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
      --dataset_path "${CS_DATASET}" \
      --epochs "${EPOCHS}" --lr "${LR}" --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
      --eval_batch_size "${EVAL_BATCH}" \
      --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" --max_len "${MAXLEN}" \
      --lora_rank "${LORA_RANK}" --lora_alpha "${LORA_ALPHA}" --lora_dropout "${LORA_DROPOUT}" \
      --target_modules "${TARGET_MODULES}" \
      --map_cache_dir "${RESULTS_ROOT}/map_cache/${RUN}" \
      --max_steps "${MAX_STEPS}" \
      "${REPLAY_ARGS[@]}" \
      --cov_path "" --replay_lambda 0 --measure_replay_when_lambda_zero 0 \
      --save "${SAVE}" --save_path "${ADAPTERS}/${RUN}" \
      --metrics_path "${RESULTS_ROOT}/metrics/${RUN}.jsonl" 2>&1 | tee "${TRAIN_LOG}"
  fi
fi

# ===========================================================================
# 训练自检 1：日志里的运行期证据
#   train.py 启动时把全部 args 打出来，replay.py 打池行数与答案口径，
#   batch_mix 的 describe() 打真实的混合比。这三处都只在 stdout 上，metrics
#   jsonl 里没有 lora_rank / max_len / 答案列 / 池行数。所以这里查文件。
# ===========================================================================
set +x
if [[ -f "${TRAIN_LOG}" ]]; then
  echo "==== 训练自检 1: 日志 (${TRAIN_LOG}) ===="
  LOG_FAIL=()
  assert_log () {
    if ! grep -qF -- "$1" "${TRAIN_LOG}"; then
      LOG_FAIL+=("找不到 '$1'   <- $2")
    else
      echo "  ok  $1"
    fi
  }
  # 这一句是全脚本最重要的断言：训练真的用了 Step 1 数出来的那些行。
  assert_log "replay pool: ${EXPECT_POOL_ROWS} usable rows (no cut)" \
    "训练用的池行数与 Step 1 数出的 ${EXPECT_POOL_ROWS} 不符。行数变了就不再与 70 号同池。"
  # 混合比：describe() 打的是实际装配出来的，不是命令行回显。
  assert_log "batch-level replay: ${NEW_PER_BATCH} new + ${REPLAY_PER_BATCH} replay per micro-batch (micro-batch=${BATCH})" \
    "实际混合比与 run 名不符。run 名里的 ${NEW_PER_BATCH}n${REPLAY_PER_BATCH}r 就名不副实了。"
  # 答案口径：从 gold_targets 列读的话这一句会写明「column ... of the self-distilled file」。
  if [[ -n "${REPLAY_FILE}" ]]; then
    assert_log "replay targets: gold-target (column ${REPLAY_TARGET_COLUMN} of the self-distilled file)" \
      "训到的不是 gold_targets 列。读成 targets 列就变成 1.7B 的自蒸馏答案了，那是另一条臂。"
    assert_log "replay pool: tokenizing at max_len=${REPLAY_MAXLEN} (new task stays at ${MAXLEN})" \
      "replay 的 token 预算没生效，长行会丢题干，保护的旧知识少于 C 编码的那份。"
  else
    assert_log "replay targets: gold-target" "if 域读的应该是 FLAN 自己的 targets"
  fi
  assert_log "TARGET_MODULES=${TARGET_MODULES}" "LoRA 覆盖与 67 号不同"
  assert_log "LORA_RANK=${LORA_RANK}" "rank 与 67 号不同"
  assert_log "LORA_ALPHA=${LORA_ALPHA}" "alpha 与 67 号不同"
  assert_log "LORA_DROPOUT=${LORA_DROPOUT}" "dropout 与 67 号不同"
  assert_log "MAX_LEN=${MAXLEN}" "新任务的 token 预算与 67 号不同"
  assert_log "REPLAY_DROP_TRUNCATED=${REPLAY_DROP_TRUNCATED}" \
    "全池开关没传对；=1 会静默丢掉 truncated 行，池就比 68 号采 C 的那份小"
  assert_log "REPLAY_LAMBDA=0.0" "本臂不该有罚项，λ 不为 0 就变成 OneReplay+replay 的混合体了"
  assert_log "MEASURE_REPLAY_WHEN_LAMBDA_ZERO=0" \
    "λ=0 但仍会加载并求值 C，本臂会白付一份显存和每步开销，上报的成本不是它自己的"
  # 反向断言：C 一旦被读进来，日志里必然有这一句。
  if grep -q "covariance matrices from" "${TRAIN_LOG}"; then
    LOG_FAIL+=("日志里出现了 'covariance matrices from'   <- C 被加载了。本臂的开销数字作废，重跑。")
  fi
  if (( ${#LOG_FAIL[@]} > 0 )); then
    echo ""
    echo "!! 日志自检失败:"
    for item in "${LOG_FAIL[@]}"; do echo "   - ${item}"; done
    echo "   （若这是一次续跑、日志来自上一次投递，先确认它对应的就是当前 run）"
    exit 1
  fi
  echo "日志自检通过。"
  echo ""
  echo "---- 日志里 describe() 打的实际混合比（写进结果表用）"
  grep -A4 "batch-level replay:" "${TRAIN_LOG}" | tail -n 6 || true
else
  echo "note: 没有 ${TRAIN_LOG}，跳过日志自检（DO_TRAIN=0 或 adapter 是上一次投递训的）"
fi

# ===========================================================================
# 训练自检 2：metrics jsonl 里的配置、混合比与开销
#   本臂的核心记录是 new_per_update：它才是与 67/70 号必须相等的量。ACCUM
#   本来就故意不同，所以只核对 ACCUM 反而会漏掉「配比换了但没配平 ACCUM」。
#   文档 2.2 节定的主表口径是「同等或更好的 val loss 下旧能力保留更多」，
#   所以 val_loss 必须和 vanilla 并排出现，不能只报 delta。
#   6.3 节还要 replay 的墙钟与显存 —— 这条 baseline 的代价就是要被摊开的。
# ===========================================================================
METRICS_FILE="${RESULTS_ROOT}/metrics/${RUN}.jsonl"
if [[ -f "${METRICS_FILE}" ]]; then
  echo "==== 训练自检 2: metrics (${METRICS_FILE}) ===="
  RUN_METRICS="${METRICS_FILE}" \
  VANILLA_METRICS="${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl" \
  ONEREPLAY_METRICS="${ONEREPLAY_METRICS:-}" \
  WANT_BATCH="${BATCH}" WANT_ACCUM="${ACCUM}" WANT_EVAL_BATCH="${EVAL_BATCH}" \
  WANT_EPOCHS="${EPOCHS}" WANT_PER_BATCH="${REPLAY_PER_BATCH}" \
  WANT_NEW_PER_UPDATE="${NEW_PER_UPDATE}" WANT_REPLAY_MAXLEN="${REPLAY_MAXLEN}" \
  WANT_SELF_DISTILL_FILE="${REPLAY_FILE}" \
  VANILLA_NAME="${VANILLA_RUN}" \
  python - <<'PY'
import json
import os


def load_epochs(path):
    rows = []
    if not path or not os.path.isfile(path):
        return rows
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if not line.strip():
                continue
            row = json.loads(line)
            if row.get("epoch") is not None:
                rows.append(row)
    return rows


epochs = load_epochs(os.environ["RUN_METRICS"])
if not epochs:
    raise SystemExit(f"{os.environ['RUN_METRICS']} 里没有 epoch 记录，训练没跑完一个 epoch")
last = epochs[-1]
want_epochs = int(os.environ["WANT_EPOCHS"])
want_new_per_update = int(os.environ["WANT_NEW_PER_UPDATE"])

print(f"records         = {len(epochs)} 条 epoch 记录（含历史追加），最后一条 epoch={last.get('epoch')}")
# regularizer 这一栏会写着 onereplay：那是 train.py 的默认值，本臂没传。
# 真正决定有没有罚项的是 replay_lambda 和 covariance_memory_gb 这两行。
print(f"regularizer     = {last.get('regularizer')}   penalty_path={last.get('penalty_path')!r}")
print("  ^ regularizer 是 train.py 的默认值，本臂没传；看下面两行才知道有没有罚项")
print(f"replay_lambda   = {last.get('replay_lambda')}   (本臂必须是 0)")
print(f"replay_per_batch= {last.get('replay_per_batch')} (want {os.environ['WANT_PER_BATCH']})")
print(f"new_per_batch   = {last.get('new_per_batch')}")
print(f"replay_row_share= {last.get('replay_row_share')}")
print(f"new_per_update  = {last.get('new_per_update')} (want {want_new_per_update}；67/70 号是 64)")
print(f"batch/accum     = {last.get('batch_size')}/{last.get('accumulation_size')} "
      f"(want {os.environ['WANT_BATCH']}/{os.environ['WANT_ACCUM']})")
print(f"eval_batch_size = {last.get('eval_batch_size')} (want {os.environ['WANT_EVAL_BATCH']})")
print(f"replay_max_len  = {last.get('replay_max_len')} (want {os.environ['WANT_REPLAY_MAXLEN']})")
print(f"replay_self_distill = {last.get('replay_self_distill')}"
      "   (1 = 池来自自蒸馏文件；答案列是否 gold 看日志那行，这里看不出来)")
print(f"C 常驻显存      = {last.get('covariance_memory_gb')} GB   (本臂必须是 0/None)")

failures = []
if float(last.get("replay_lambda") or 0.0) != 0.0:
    failures.append(
        f"replay_lambda={last.get('replay_lambda')}，本臂不该有罚项。"
        "非 0 的话这条 run 是 replay+OneReplay 的混合体，不能当 baseline。"
    )
if last.get("covariance_memory_gb"):
    failures.append(
        f"covariance_memory_gb={last.get('covariance_memory_gb')}：C 被加载了。"
        "开销数字（train_sec / peak_memory_gb）作废，加 --measure_replay_when_lambda_zero 0 重跑。"
    )
if int(last.get("replay_per_batch") or 0) != int(os.environ["WANT_PER_BATCH"]):
    failures.append(
        f"replay_per_batch={last.get('replay_per_batch')}，与 run 名里的配比不符"
    )
if int(last.get("new_per_update") or 0) != want_new_per_update:
    failures.append(
        f"new_per_update={last.get('new_per_update')}，本次要求 {want_new_per_update}"
    )
elif want_new_per_update != 64:
    failures.append(
        f"new_per_update={want_new_per_update} != 64：每次更新的新任务行数与 67/70 号不同，"
        "优化器看到的梯度噪声就不一样了。调 ACCUM 配平，或 ALLOW_DRIFT=1 并写进结果表。"
    )
if int(last.get("batch_size") or 0) != int(os.environ["WANT_BATCH"]):
    failures.append(f"batch_size={last.get('batch_size')}，每步开销与 vanilla 不可比")
if int(last.get("eval_batch_size") or 0) != int(os.environ["WANT_EVAL_BATCH"]):
    failures.append(f"eval_batch_size={last.get('eval_batch_size')}，val_loss 与其余臂不可比")
if int(last.get("replay_max_len") or 0) != int(os.environ["WANT_REPLAY_MAXLEN"]):
    failures.append(
        f"replay_max_len={last.get('replay_max_len')}，本次要求 {os.environ['WANT_REPLAY_MAXLEN']}"
        "（= 该域 C 的 max_len）"
    )
want_sd = 1 if os.environ["WANT_SELF_DISTILL_FILE"] else 0
if int(last.get("replay_self_distill") or 0) != want_sd:
    failures.append(
        f"replay_self_distill={last.get('replay_self_distill')}，本次要求 {want_sd}："
        "池的来源（原始语料 / 自蒸馏文件的行序）与本域的配置不符"
    )
if int(last.get("epoch") or 0) != want_epochs:
    failures.append(f"最后一条记录是 epoch {last.get('epoch')}，没跑满 {want_epochs} 个 epoch")


def cell(value, spec=".6f", width=14):
    """None 也要占位：缺字段时表格不能错列，否则一眼看不出是哪一列缺。"""

    return f"{'-' if value is None else format(value, spec):>{width}}"


print()
print("---- 新任务性能与开销（R 列应恒为 0/None：本臂没有罚项）")
print(f"{'epoch':>6}{'task_loss':>14}{'R':>14}{'val_loss':>14}{'train_sec':>12}{'peak_GB':>10}")
tail = epochs[-want_epochs:] if len(epochs) >= want_epochs else epochs
for row in tail:
    print(
        f"{row.get('epoch'):>6}"
        + cell(row.get("train_task_loss"))
        + cell(row.get("train_replay_reg"), ".4e")
        + cell(row.get("val_loss"))
        + cell(row.get("train_sec"), ".1f", 12)
        + cell(row.get("peak_memory_gb"), ".2f", 10)
    )
if last.get("train_replay_reg"):
    failures.append(
        f"train_replay_reg={last.get('train_replay_reg')} 不为 0：本臂居然算了罚项，"
        "配置串了。"
    )

vanilla = load_epochs(os.environ.get("VANILLA_METRICS", ""))
print()
if vanilla:
    v_last = vanilla[-1]
    print(f"{'':<10}{'val_loss':>12}{'train_sec':>12}{'peak_GB':>10}{'new/update':>12}")
    for name, row in (("vanilla", v_last), ("replay", last)):
        print(
            f"{name:<10}"
            + cell(row.get("val_loss"), ".6f", 12)
            + cell(row.get("train_sec"), ".1f", 12)
            + cell(row.get("peak_memory_gb"), ".2f", 10)
            + f"{row.get('new_per_update') or row.get('accumulation_size') or '-':>12}"
        )
    if v_last.get("val_loss") and last.get("val_loss"):
        print(f"val_loss 差值 = {last['val_loss'] - v_last['val_loss']:+.6f}"
              "  （<=0 就是新任务没被 replay 拖慢，主表要的就是这一点）")
    if v_last.get("train_sec") and last.get("train_sec"):
        print(f"墙钟倍数 = {last['train_sec'] / v_last['train_sec']:.2f}x"
              f"  （每步只装 {last.get('new_per_batch')} 行新任务，约 2x 是预期的）")
    if v_last.get("peak_memory_gb") and last.get("peak_memory_gb"):
        print(f"峰值显存差 = {last['peak_memory_gb'] - v_last['peak_memory_gb']:+.2f} GB"
              "  （micro-batch 行数不变，应该接近 0；这正是与 OneReplay 常驻 C 的对照）")
else:
    print("note: 找不到 vanilla 的 metrics，val_loss 没有分母。67 号跑完再回来看这一行。")

# 与 OneReplay 同域那条并排：不传 ONEREPLAY_METRICS 就跳过，不是必须的。
one = load_epochs(os.environ.get("ONEREPLAY_METRICS", ""))
if one:
    o_last = one[-1]
    print()
    print("---- 与 70 号 OneReplay 同域并排（成本那一栏）")
    print(f"OneReplay  val_loss={o_last.get('val_loss')}  train_sec={o_last.get('train_sec')}  "
          f"peak={o_last.get('peak_memory_gb')} GB  C 常驻={o_last.get('covariance_memory_gb')} GB")
    print(f"replay     val_loss={last.get('val_loss')}  train_sec={last.get('train_sec')}  "
          f"peak={last.get('peak_memory_gb')} GB  C 常驻=0")
    print(f"OneReplay 用的 C = {o_last.get('penalty_path')}")
    print("  （两条臂同池由各自的 Step 1 保证：那份 C 的 pool_rows 就是本臂的池行数）")

if failures:
    print()
    print("!! 训练自检失败:")
    for item in failures:
        print(f"   - {item}")
    raise SystemExit(1)
print()
print("训练自检通过。")
PY
else
  echo "note: 没有 ${METRICS_FILE}，跳过 metrics 自检"
fi
set -x

# ===========================================================================
# 评测：按域走口径，解码预算与 batch 与 67 号逐字相同
# ===========================================================================
if [[ "${DO_EVAL}" != "1" ]]; then
  echo "DO_EVAL=0：跳过评测。评测单独投: qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},DO_TRAIN=0 ${SELF_PATH}"
  set +x
  echo "Job finished at: $(date)"
  exit 0
fi

# 缺哪个数据就跳过哪个指标（数据没搬全时不至于整个作业白挂）。
AVAIL=""
for m in ${DOMAIN_METRICS}; do
  case "${m}" in
    ifeval)    [[ -f "${IFEVAL_INPUT}"   ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 ifeval：缺 ${IFEVAL_INPUT}" ;;
    gsm8k)     [[ -f "${GSM8K_FILE}"     ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 gsm8k：缺 ${GSM8K_FILE}" ;;
    math500)   [[ -f "${MATH500_FILE}"   ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 math500：缺 ${MATH500_FILE}" ;;
    humaneval) [[ -f "${HUMANEVAL_FILE}" ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 humaneval：缺 ${HUMANEVAL_FILE}" ;;
    mbpp)      [[ -d "${MBPP_DIR}"       ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 mbpp：缺 ${MBPP_DIR}" ;;
  esac
done
AVAIL="${AVAIL# }"
if [[ -z "${AVAIL}" ]]; then
  echo "本域要评的指标一个数据都没找到，跳过评测"
  set +x
  echo "Job finished at: $(date)"
  exit 0
fi
echo "AVAIL=[${AVAIL}]"

# base 的 adapter 路径是空串：evaluate.py 认这个，直接加载裸模型。
# base 与 vanilla 默认不重评（67 号已经评过、结果就在同一个 OUT_DIR 里）。
EVAL_SPECS="${RUN};${ADAPTERS}/${RUN}"
if [[ "${WITH_BASE}" == "1" ]]; then
  EVAL_SPECS="base;|${EVAL_SPECS}"
fi
if [[ "${WITH_VANILLA}" == "1" ]]; then
  EVAL_SPECS="${EVAL_SPECS}|${VANILLA_RUN};${ADAPTERS}/${VANILLA_RUN}"
fi
if [[ -n "${EXTRA_MODELS}" ]]; then
  EVAL_SPECS="${EVAL_SPECS}|${EXTRA_MODELS}"
fi

pending_metrics () {
  # $1=run_name, 其余=候选 metric。已有 summary.json 的跳过，除非 FORCE_EVAL=1。
  local name=$1; shift
  local out=""
  for m in "$@"; do
    if [[ "${FORCE_EVAL}" == "1" || ! -f "${OUT_DIR}/${m}/${name}/summary.json" ]]; then
      out="${out}${out:+,}${m}"
    fi
  done
  echo "${out}"
}

EVAL_NAMES=()
IFS='|' read -ra SPECS <<< "${EVAL_SPECS}"
for spec in "${SPECS[@]}"; do
  name="${spec%%;*}"
  adapter="${spec#*;}"
  if [[ -n "${adapter}" && ! -d "${adapter}" ]]; then
    echo "跳过评测 ${name}：找不到 adapter ${adapter}"
    continue
  fi
  EVAL_NAMES+=("${name}")
  # shellcheck disable=SC2086
  mp="$(pending_metrics "${name}" ${AVAIL})"
  if [[ -z "${mp}" ]]; then
    echo "跳过评测 ${name}：所有指标都已有结果（FORCE_EVAL=1 可重评）"
    continue
  fi
  echo "==== eval: ${name} (${mp}) ===="
  # 一次调用跑完本域所有指标：runner 只加载一次模型，8B 的加载不便宜。
  python -m onereplay.scripts.evaluate \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    --adapter_path "${adapter}" --run_name "${name}" \
    --metrics "${mp}" --out_dir "${OUT_DIR}" --seed "${SEED}" \
    --limit "${LIMIT}" \
    --math_max_new_tokens "${MATH_MAX_NEW_TOKENS}" \
    --code_max_new_tokens "${CODE_MAX_NEW_TOKENS}" \
    --max_new_tokens "${IF_MAX_NEW_TOKENS}" \
    --math_batch_size "${MATH_BATCH}" \
    --code_batch_size "${CODE_BATCH}" \
    --ifeval_batch_size "${IFEVAL_BATCH}" \
    --math500_data_path "${MATH500_FILE}" \
    --gsm8k_data_path "${GSM8K_FILE}" \
    --humaneval_data_file "${HUMANEVAL_FILE}" \
    --mbpp_dataset_path "${MBPP_DIR}" --dataset_split "${MBPP_SPLIT}" \
    --ifeval_input "${IFEVAL_INPUT}" \
    --timeout "${TIMEOUT}" \
    --cache_dir "${TMPDIR}/hf_datasets"
done

# ---------------------------------------------------------------------------
# 长度/截断诊断
#   两个用途：
#   1) 预算够不够 —— hit-cap 接近 0 且 P99 远低于 cap 就说明富余，可以调小省时间；
#      反过来 hit-cap 高就必须调大后**所有臂全部重评**，截断偏差跨 run 不均匀。
#   2) replay 有没有把风格拖走 —— 旧知识那批答案的长度分布与新任务不同，
#      replay 占了一半的行，本臂的 P50 可能被拉向池的长度。相对 base/vanilla
#      大幅偏移就是这个信号，此时分数变化要连带这个一起解释。
#   no-answer 那一列对 gsm8k 就是「缺 '####' 的比例」，文档 6.3 要求单列报它。
# ---------------------------------------------------------------------------
length_diagnostic () {
  python - "${MODEL_DIR}/${MODEL_NAME}" "$@" <<'PY'
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

model_path, specs = sys.argv[1], sys.argv[2:]
tokenizer = AutoTokenizer.from_pretrained(model_path)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


print("==== response length / truncation diagnostic ====")
for spec in specs:
    path, cap = spec.rsplit(":", 1)
    cap = int(cap)
    file = Path(path)
    if not file.is_file():
        continue
    rows = [json.loads(line) for line in file.open(encoding="utf-8") if line.strip()]
    if not rows:
        continue
    # 各 metric 的字段名不同：数学写 response，代码写 raw，ifeval 写 response。
    texts = [row.get("response", row.get("raw", "")) for row in rows]
    lengths = sorted(
        len(tokenizer(text, add_special_tokens=False)["input_ids"]) for text in texts
    )
    hit_cap = sum(length >= cap - 8 for length in lengths)
    if "prediction" in rows[0]:
        missing = sum(row.get("prediction") in (None, "") for row in rows)
        miss_label = f"no-answer={missing} ({missing / len(rows):.1%}) "
    else:
        miss_label = ""
    label = f"{file.parent.parent.name}/{file.parent.name}"
    print(
        f"{label:>66}: n={len(rows)} cap={cap} {miss_label}"
        f"hit-cap={hit_cap} ({hit_cap / len(rows):.1%}) "
        f"P50={pct(lengths, 50)} P90={pct(lengths, 90)} P99={pct(lengths, 99)} "
        f"max={lengths[-1]}"
    )
print("")
print("读法 1（预算）: hit-cap 接近 0 且 P99 远低于 cap => 可以调小 cap 省时间。")
print("读法 2（风格漂移）: 本臂 P50 相对 base/vanilla 明显偏移 => 被 replay 池的")
print("                 答案长度带走了。分数变化要连着这一项一起解释。")
PY
}

if [[ "${DIAG_LEN}" == "1" ]]; then
  DIAG_SPECS=()
  # base 与 vanilla 的 responses.jsonl 是 67 号留下的，一起打出来才能比 P50。
  DIAG_RUNS=("base" "${VANILLA_RUN}" "${RUN}")
  for name in "${DIAG_RUNS[@]}"; do
    for m in ${AVAIL}; do
      case "${m}" in
        gsm8k|math500) cap="${MATH_MAX_NEW_TOKENS}" ;;
        humaneval|mbpp) cap="${CODE_MAX_NEW_TOKENS}" ;;
        *) cap="${IF_MAX_NEW_TOKENS}" ;;
      esac
      DIAG_SPECS+=("${OUT_DIR}/${m}/${name}/responses.jsonl:${cap}")
    done
  done
  length_diagnostic "${DIAG_SPECS[@]}"
fi

# ---------------------------------------------------------------------------
# 汇总：base / vanilla / 本臂并排
#   delta_base 是遗忘量（负数越大越坏），delta_van 是本臂相对 vanilla 救回来
#   多少（正数越大越好）。后者才是这个方法的效果，前者只是标尺。
# ---------------------------------------------------------------------------
set +x
echo ""
echo "========================================================================"
echo "结果汇总：保护 ${DOMAIN}   replay ${NEW_PER_BATCH}n${REPLAY_PER_BATCH}r"
echo "========================================================================"
OUT_DIR="${OUT_DIR}" RUN_NAME="${RUN}" VANILLA_NAME="${VANILLA_RUN}" \
METRIC_NAMES="${AVAIL}" \
RUN_METRICS="${RESULTS_ROOT}/metrics/${RUN}.jsonl" \
VANILLA_METRICS="${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl" \
python - <<'PY'
import json
import os
from pathlib import Path

out_dir = Path(os.environ["OUT_DIR"])
run_name = os.environ["RUN_NAME"]
vanilla_name = os.environ["VANILLA_NAME"]
metric_names = os.environ["METRIC_NAMES"].split()

# 各 metric 的主分数字段名不同，按这个顺序取第一个命中的。
SCORE_KEYS = ("accuracy", "pass_at_1", "strict_prompt_accuracy")


def read_score(metric, name):
    path = out_dir / metric / name / "summary.json"
    if not path.is_file():
        return None
    payload = json.loads(path.read_text(encoding="utf-8"))
    for key in SCORE_KEYS:
        if key in payload:
            return payload[key]
    return None


def cell(value, spec=".4f", width=10):
    return f"{'-' if value is None else format(value, spec):>{width}}"


print(f"{'metric':<12}{'base':>10}{'vanilla':>10}{'replay':>11}{'d_base(pp)':>12}{'d_van(pp)':>11}")
print("-" * 66)
for metric in metric_names:
    base = read_score(metric, "base")
    van = read_score(metric, vanilla_name)
    ours = read_score(metric, run_name)
    d_base = (ours - base) * 100 if (base is not None and ours is not None) else None
    d_van = (ours - van) * 100 if (van is not None and ours is not None) else None
    print(
        f"{metric:<12}"
        + cell(base)
        + cell(van)
        + cell(ours, ".4f", 11)
        + cell(d_base, "+.2f", 12)
        + cell(d_van, "+.2f", 11)
    )


def last_epoch(path):
    if not path or not os.path.isfile(path):
        return {}
    rows = []
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                row = json.loads(line)
                if row.get("epoch") is not None:
                    rows.append(row)
    return rows[-1] if rows else {}


ours_m = last_epoch(os.environ.get("RUN_METRICS"))
van_m = last_epoch(os.environ.get("VANILLA_METRICS"))
print()
print("新任务性能与开销（主表必须带上 val_loss，见文档 2.2 节第 1 条）:")
print(f"{'':<14}{'val_loss':>12}{'train_sec':>12}{'peak_mem_GB':>13}{'new/update':>12}")
for label, row in (("vanilla", van_m), ("replay", ours_m)):
    print(
        f"{label:<14}"
        + cell(row.get("val_loss"), ".6f", 12)
        + cell(row.get("train_sec"), ".0f", 12)
        + cell(row.get("peak_memory_gb"), ".2f", 13)
        + f"{row.get('new_per_update') or row.get('accumulation_size') or '-':>12}"
    )
if ours_m.get("val_loss") and van_m.get("val_loss"):
    delta = ours_m["val_loss"] - van_m["val_loss"]
    print(f"val_loss 差值 = {delta:+.6f}")
    if delta <= 0:
        print("  <= 0：新任务没被 replay 拖慢，上面的 d_van 可以直接当保护效果读。")
    else:
        print("  > 0：新任务学得更差了，d_van 里有一部分是'少学了'而不是'保住了'。")
        print("       报结果时必须同时给这两个数，否则就是拿新任务性能换旧能力。")
print()
print("这一臂的开销结论（文档 6.3 要的对照）:")
print("  常驻显存 0（不加载 C），但每步只装 %s 行新任务，墙钟约 vanilla 的 2x，"
      % (ours_m.get("new_per_batch") or "?"))
print("  而且必须一直留着整个语料。OneReplay 反过来：语料只过一遍，之后常驻一份 C。")
PY

echo ""
echo "========================================================================"
echo "接下来要做的三件事（文档 6.3 节）"
echo "========================================================================"
echo "1) 把格式退化和知识退化拆开 —— 光看准确率分不清这两件事:"
echo "   python -m onereplay.scripts.score_retention_subset \\"
echo "     --results_root ${OUT_DIR} --metrics ${AVAIL// /,} \\"
echo "     --runs base,${VANILLA_RUN},${RUN} --baseline base"
echo "   python -m onereplay.scripts.analyze_code_failures \\"
echo "     --results_root ${OUT_DIR} --metrics humaneval,mbpp \\"
echo "     --runs base,${VANILLA_RUN},${RUN} --baseline base"
echo "   （GSM8K 缺 '####' 的比例看上面长度诊断里的 no-answer 那一列）"
echo ""
echo "2) 显著性（配对 McNemar，题量小的时候尤其要看）:"
echo "   python -m onereplay.scripts.compare_significance \\"
echo "     --results_root ${OUT_DIR} --metrics ${AVAIL// /,} \\"
echo "     --runs base,${VANILLA_RUN},${RUN} --baseline ${VANILLA_RUN}"
echo ""
echo "3) 与 70 号同域那条并排。这两条臂消费同一批行，差别只在怎么用:"
echo "   qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=<本域 λ> onereplay/pbs/70_qwen3_8b_gold_onereplay.pbs"
echo "   已经有 70 号的 metrics 时，可以让本脚本把成本那一栏并排打出来:"
echo "   qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},DO_TRAIN=0,DO_EVAL=0,ONEREPLAY_METRICS=<那条的 jsonl> ${SELF_PATH}"
echo "   换混合比是本臂自己的旋钮（记得同时配平 ACCUM 让 new/update 回到 64）:"
echo "   qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},REPLAY_PER_BATCH=2,ACCUM=88 ${SELF_PATH}"
echo "   配比写在 run 名里，不会互相覆盖。"
echo ""
echo "产物:"
echo "  adapter   : ${ADAPTERS}/${RUN}"
echo "  开销/loss : ${RESULTS_ROOT}/metrics/${RUN}.jsonl"
echo "  训练日志  : ${TRAIN_LOG}"
echo "  同池报告  : ${POOL_REPORT_FILE}"
echo "  汇总      : ${OUT_DIR}/<metric>_summary.csv"
echo "  逐题      : ${OUT_DIR}/<metric>/${RUN}/responses.jsonl"
echo ""
echo "本轮的口径，其余各臂必须逐字相同才可比:"
echo "  LoRA r${LORA_RANK} alpha${LORA_ALPHA} dropout${LORA_DROPOUT} targets=${TARGET_MODULES}"
echo "  train lr=${LR} epochs=${EPOCHS} batch=${BATCH} maxlen=${MAXLEN} eval_batch=${EVAL_BATCH}"
echo "  本臂 accum=${ACCUM}（vanilla 是 64），new/update=${NEW_PER_UPDATE} 与其余臂相同"
echo "  replay 池 ${EXPECT_POOL_ROWS:-?} 行 @ max_len ${REPLAY_MAXLEN}，答案列 ${REPLAY_TARGET_COLUMN}"
echo "  decode math ${MATH_MAX_NEW_TOKENS}/${MATH_BATCH} code ${CODE_MAX_NEW_TOKENS}/${CODE_BATCH} ifeval ${IF_MAX_NEW_TOKENS}/${IFEVAL_BATCH}"
echo "Job finished at: $(date)"
