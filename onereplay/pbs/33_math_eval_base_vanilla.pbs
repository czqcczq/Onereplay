#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_matheval
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/logs/onereplay/
#
# =============================================================================
# NUS Hopper (PBS + Singularity): 数学基线评测 base + vanilla
#   math500 / gsm8k 两个 test 集，只评测，不训练。
#
# 为什么单独一个脚本而不是用交互节点：交互作业上限 2h，而 base+vanilla 两个模型
# 各要跑 500(MATH-500) + 1319(GSM8K) = 1819 题的 batch=1 贪心生成，实测量级在
# 6-8 小时，必须走批处理。
#
# 与 onereplay/slurm/32_math_train_eval.slurm 的评测段算法一致，改动只在集群层:
#   1) PBS 指令替代 SBATCH；提交用 qsub。
#   2) 计算在 Singularity 容器里跑，venv 在容器内激活。
#   3) zsh -> bash（去掉 `${=VAR}` 的 zsh 分词写法）。
#   4) 路径迁到 /scratch；数据取 wget 下载并由 prepare_math_data 归一化后的 jsonl。
# 脚本会把自己在容器里再跑一遍：外层只做 module load singularity + singularity
# exec 和临时目录清理，内层（ONEREPLAY_IN_CONTAINER=1）跑真正的评测。
#
# -----------------------------------------------------------------------------
# 评测的两个模型
#   base    : 裸 Qwen3-1.7B，不挂 adapter               -> run_name "base"
#   vanilla : 普通 LoRA SFT（无 OneReplay 正则）的 adapter -> run_name 取其目录名
#             即 cs_vanilla_seed1，与 32 号里 cs_vanilla_seed${SEED} 同名，
#             这样 CSV 里的行能和后续 cif/cmath/cmix 直接并排比。
#
# MATH_MAX_NEW_TOKENS 默认 1792（不是 32 号里的 1024）
#   math500 的判分靠抽最后一个 \boxed{...}，生成被砍断就等于没给答案、直接记错。
#   更麻烦的是这种偏差跨 run 不均匀：训过的模型往往更啰嗦、截断率更高，会把
#   "谁更话多" 混进 retention 差异里。贪心解码遇 EOS 就停，所以抬高上限只对长尾
#   生效，几乎不增加总时长——是很便宜的保险。1792 与 31 号自蒸馏的预算一致。
#   注意：这个值必须在 base/vanilla/cif/cmath/cmix 所有 run 上保持一致，否则数字
#   不可比；旧集群上用 1024 出过的数不能和这里的新数混进同一张表。
#
# 断点续跑
#   每个 (指标, run) 的 summary.json 已存在就跳过该指标（FORCE_EVAL=1 可强制重评）。
#   这样超时后原样再投一次即可接着跑，也避免 *_summary.csv 里追加出重复行。
#
# -----------------------------------------------------------------------------
# 用法:
#   qsub onereplay/pbs/33_math_eval_base_vanilla.pbs
#   本集群不从 qsub 命令行传额外变量；要改预算/抽样，直接改下方默认值
#   （若本站点的 qsub 支持 -v，FORWARD_VARS 里的变量也可以从命令行传）。
#
# 前置条件:
#   1) 数据就位（wget 下载 + prepare_math_data 归一化后）:
#        ${REPO_ROOT}/datasets/math/math500_test.jsonl   (500 行)
#        ${REPO_ROOT}/datasets/math/gsm8k_test.jsonl      (1319 行)
#   2) 日志目录必须在 qsub 之前就存在: mkdir -p /scratch/weiliu87/logs/onereplay
#      故意放在仓库外面：仓库是 rsync 的目标，而运行中的作业一直握着日志的 fd，
#      rsync 覆盖会换 inode 把作业打成 ESTALE。
#
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/33_math_eval_base_vanilla.pbs}"

# 用本站点已经跑通的 NGC PyTorch 镜像，不要用裸 cuda:*-u20.04 那个:
# u20.04 自带 python3.8，而 venv 的 bin/python 只是个指向"创建它的那个解释器"的
# 软链，解释器版本对不上 venv 根本起不来。ngc 24.04 是 ubuntu22.04 + python3.10。
# 提交前确认一致: grep version ${REPO_ROOT}/.venv/pyvenv.cfg
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

# ---- 本次作业专属的临时目录 ----
# 容器里的 /tmp 常是 tmpfs（吃内存），优先节点本地 NVMe，没有就退回 /scratch。
# 只在没继承到时才算：内层是被转发进来的（PBS_JOBID 不在转发列表里，重算会得到
# 另一个名字，于是内层用一个目录、外层的 cleanup 删另一个，白白泄漏一份临时数据）。
JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  # 只删本次作业自己建的那一个目录，且必须匹配前缀，避免手滑清掉共享缓存。
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  # PBS 起的这个 shell 不一定是 login shell，module 可能还没被定义；
  # set -e 下那会让作业在第一步就静默挂掉，所以先兜一层初始化。
  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  # -e/--cleanenv 会清掉环境，只有 SINGULARITYENV_/APPTAINERENV_ 前缀的变量能进容器。
  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME RESULTS_ROOT MATH_DATA_DIR
    MATH500_FILE GSM8K_FILE MATH_MAX_NEW_TOKENS LIMIT SEED
    MODELS VANILLA_ADAPTER FORCE_EVAL DIAG_LEN
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  # 不加 --nv：Hopper 的 singularity 已经全局绑好 GPU 驱动。
  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"

  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：那会把当前 shell 替换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的评测。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
# 离线：模型和数据都在本地盘，禁止任何 HuggingFace 联网调用（本站点联网会卡死）
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
# 打印 torch.__file__：镜像自带的 torch 和 venv 里的 torch 谁生效，看这一行就知道。
python -c "import torch; print('torch', torch.__version__, torch.__file__, 'cuda', torch.cuda.is_available(), torch.cuda.device_count())"

# ---- 项目路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results}"
MATH_DATA_DIR="${MATH_DATA_DIR:-${REPO_ROOT}/datasets/math}"
ADAPTERS="${RESULTS_ROOT}/adapters"
VANILLA_ADAPTER="${VANILLA_ADAPTER:-${ADAPTERS}/cs_vanilla_seed1}"

# ---- 评测数据 ----
MATH500_FILE="${MATH500_FILE:-${MATH_DATA_DIR}/math500_test.jsonl}"
GSM8K_FILE="${GSM8K_FILE:-${MATH_DATA_DIR}/gsm8k_test.jsonl}"

# ---- 评测参数 ----
SEED="${SEED:-1}"
# 见文件头说明：1792 而非 1024，且所有 run 必须用同一个值。
MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS:-1792}"
LIMIT="${LIMIT:-0}"                  # >0 时每个指标只评前 N 题（冒烟用）
MODELS="${MODELS:-base vanilla}"
FORCE_EVAL="${FORCE_EVAL:-0}"        # 1 = 忽略已有 summary.json 重评
DIAG_LEN="${DIAG_LEN:-1}"            # 1 = 评完打印长度/截断诊断

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
mkdir -p "${RESULTS_ROOT}"

# 缺哪个数据文件就跳过哪个指标，和 32 号一致（下载失败时不至于整个 job 白挂）。
ALL_METRICS=""
if [[ -f "${MATH500_FILE}" ]]; then ALL_METRICS="${ALL_METRICS} math500"; else echo "跳过 math500：缺 ${MATH500_FILE}"; fi
if [[ -f "${GSM8K_FILE}" ]]; then ALL_METRICS="${ALL_METRICS} gsm8k"; else echo "跳过 gsm8k：缺 ${GSM8K_FILE}"; fi
ALL_METRICS="${ALL_METRICS# }"
[[ -n "${ALL_METRICS}" ]] || { echo "两个数据文件都不在，无可评测指标"; exit 1; }

echo "MODELS=${MODELS}  METRICS=${ALL_METRICS}"
echo "MATH_MAX_NEW_TOKENS=${MATH_MAX_NEW_TOKENS}  LIMIT=${LIMIT}  SEED=${SEED}"

# ---------------------------------------------------------------------------
# 模型解析：base 传空 adapter_path（evaluate 里空串就是裸 base），
# vanilla 的 run_name 取 adapter 目录名，保证与 32 号的命名一致。
# ---------------------------------------------------------------------------
resolve_adapter () {
  case "$1" in
    base)    echo "" ;;
    vanilla) echo "${VANILLA_ADAPTER}" ;;
    *)       echo "" ;;
  esac
}

resolve_name () {
  case "$1" in
    base)    echo "base" ;;
    vanilla) echo "$(basename "${VANILLA_ADAPTER}")" ;;
    *)       echo "$1" ;;
  esac
}

# 已有 summary.json 的指标不再重跑：既省卡时，也防止 *_summary.csv 追加重复行。
pending_metrics () {
  local name=$1
  local out=""
  local m
  for m in ${ALL_METRICS}; do
    if [[ "${FORCE_EVAL}" != "1" && -f "${RESULTS_ROOT}/${m}/${name}/summary.json" ]]; then
      echo "已有结果，跳过 ${m}/${name}" >&2
      continue
    fi
    out="${out},${m}"
  done
  echo "${out#,}"
}

eval_one () {
  local short=$1
  local name adapter metrics
  name="$(resolve_name "${short}")"
  adapter="$(resolve_adapter "${short}")"

  if [[ -n "${adapter}" && ! -d "${adapter}" ]]; then
    echo "跳过评测 ${short}：缺 adapter ${adapter}"
    return 0
  fi

  metrics="$(pending_metrics "${name}")"
  if [[ -z "${metrics}" ]]; then
    echo "跳过评测 ${name}：所有指标都已有结果（FORCE_EVAL=1 可强制重评）"
    return 0
  fi

  echo "==== eval math: ${name} (${metrics}) ===="
  python -m onereplay.scripts.evaluate \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    --adapter_path "${adapter}" --run_name "${name}" \
    --metrics "${metrics}" --out_dir "${RESULTS_ROOT}" --seed "${SEED}" \
    --math_max_new_tokens "${MATH_MAX_NEW_TOKENS}" --limit "${LIMIT}" \
    --math500_data_path "${MATH500_FILE}" \
    --gsm8k_data_path "${GSM8K_FILE}"
}

for m in ${MODELS}; do
  eval_one "${m}"
done

# ---------------------------------------------------------------------------
# 长度/截断诊断：用 responses.jsonl 反查 MATH_MAX_NEW_TOKENS 够不够
#   no-answer : 没抽出答案的比例（math500 是没有 \boxed{}，gsm8k 是没有数字）
#   hit-cap   : 生成长度顶到上限的比例，这些基本都是被砍断记错的
# hit-cap 接近 0 且 P99 明显低于 cap，就说明预算富余，可以把这个数写进结论。
# ---------------------------------------------------------------------------
length_diagnostic () {
  python - "${MODEL_DIR}/${MODEL_NAME}" "${MATH_MAX_NEW_TOKENS}" "$@" <<'PY'
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

model_path, cap, paths = sys.argv[1], int(sys.argv[2]), sys.argv[3:]
tokenizer = AutoTokenizer.from_pretrained(model_path)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


print(f"==== response length / truncation diagnostic (cap={cap}) ====")
for path in paths:
    file = Path(path)
    if not file.is_file():
        continue
    rows = [json.loads(line) for line in file.open(encoding="utf-8") if line.strip()]
    if not rows:
        continue
    lengths = sorted(
        len(tokenizer(row.get("response", ""), add_special_tokens=False)["input_ids"])
        for row in rows
    )
    missing = sum(row.get("prediction") in (None, "") for row in rows)
    hit_cap = sum(length >= cap - 8 for length in lengths)
    label = f"{file.parent.parent.name}/{file.parent.name}"
    print(
        f"{label:>34}: n={len(rows)} "
        f"no-answer={missing} ({missing / len(rows):.1%}) "
        f"hit-cap={hit_cap} ({hit_cap / len(rows):.1%}) "
        f"P50={pct(lengths, 50)} P90={pct(lengths, 90)} P99={pct(lengths, 99)} max={lengths[-1]}"
    )
print("hit-cap 接近 0 且 P99 明显低于 cap => 预算够用；否则提高 MATH_MAX_NEW_TOKENS 后重评。")
PY
}

if [[ "${DIAG_LEN}" == "1" ]]; then
  DIAG_FILES=()
  for m in ${ALL_METRICS}; do
    for s in ${MODELS}; do
      DIAG_FILES+=("${RESULTS_ROOT}/${m}/$(resolve_name "${s}")/responses.jsonl")
    done
  done
  if [[ ${#DIAG_FILES[@]} -gt 0 ]]; then
    length_diagnostic "${DIAG_FILES[@]}"
  fi
fi

set +x
echo "========================================================================"
echo "产物（每个 run 一行，append 进同名 CSV，可直接并排比）:"
echo "  math500: ${RESULTS_ROOT}/math500_summary.csv   (accuracy 越高越好)"
echo "  gsm8k:   ${RESULTS_ROOT}/gsm8k_summary.csv     (accuracy 越高越好)"
echo "逐题输出: ${RESULTS_ROOT}/{math500,gsm8k}/<run_name>/responses.jsonl"
echo "本次 run_name: base 与 $(basename "${VANILLA_ADAPTER}")"
echo "这两行是数学 retention 的基线：base 是未训的上界参照，vanilla 是无正则 SFT"
echo "的遗忘量。后续 cif/cmath/cmix 必须用同一个 MATH_MAX_NEW_TOKENS=${MATH_MAX_NEW_TOKENS} 才可比。"
echo "Job finished at: $(date)"
