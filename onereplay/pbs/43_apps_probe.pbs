#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_appsprobe
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o /scratch/weiliu87/logs/onereplay/
#
# =============================================================================
# NUS Hopper: APPS 量程探针 —— base 模型，两档难度各 100 题
#   只跑 base，不训练，不涉及 C。目的是**定参数**，不是出结论。
#
# -----------------------------------------------------------------------------
# 这一轮要回答的问题
#   代码线要从 Magicoder->HumanEval/MBPP 换成 APPS/MBPP 的同域 train->test，
#   但换之前有一件事必须先确认：**APPS 在本套判分口径下有没有量程。**
#   base 若只有 1~2 分，vanilla 掉到 0.6 分也读不出来，地板和天花板一样致命。
#
#   本作业一次跑完给出四个数，难度/预算/主指标三个决策据此一次定完：
#     1) strict pass@1        —— 有没有量程
#     2) mean pass_ratio      —— 连续值，配对检验的分辨率比 strict 高一个量级
#     3) num_truncated        —— MAX_NEW_TOKENS 够不够（这是最可能的瓶颈）
#     4) error_buckets        —— 失败是语法崩了还是算法错了
#
# -----------------------------------------------------------------------------
# !! 本地已验证的事实（apps_ref/apps_data，2026-08-30）
#
# 1) APPS 的难度是**连续 index 块**，不是打散的。test split：
#      interview     index    0..2999   (3000)
#      competition   index 3000..3999   (1000)
#      introductory  index 4000..4999   (1000)
#    所以「取 test 前 500 条」= 取 500 道 interview，是个难度选择而非随机抽样。
#    PettingLLMs 的 load_code.py 用的正是 ds[:500]，即全 interview。
#    本脚本用 --apps_difficulties 显式选，不靠 index 切。
#
# 2) 判分器天花板已验收：gold solution 在两档上都是 93.3%（试 5 条参考解）。
#    只试第 1 条是 83.3%，差的那 10pp 全是 SyntaxError —— APPS 的 solution 0
#    有 Python 2 代码，属数据噪声。**所有模型分数都要对着 93% 读**，论文里同报。
#    复跑: python -m onereplay.scripts.check_apps_judge \
#            --apps_data_file ${APPS_DATA} --apps_difficulties introductory \
#            --limit 30 --num_solutions 5
#
# 3) 判分耗时约 1.0~1.4 s/题（max_tests=5），500 题约 10 分钟/模型。判分不是瓶颈，
#    **生成才是**。题面 P90=2692 字符（约 770 token），P99≈1135 token。
#
# 4) APPS test 每题平均 85 个测试用例（P90=143，max=565）。全跑不现实，
#    --apps_max_tests 是必需的。它让 strict pass@1 比官方口径**偏松**，
#    所以必须在所有 run 之间保持同一个值，并和分数一起报。
#
# -----------------------------------------------------------------------------
# !! 判分口径（与 MBPP/HumanEval 不同，不可混读）
#   APPS 走 onereplay/eval/apps_exec.py，不走 code_exec.py：
#     - 判等是空白归一化的精确匹配，比官方 APPS harness（6 层回退 + 浮点容差）严
#     - 代码抽取取**最后一个** ```python 块，且不做 '\ndef ' 截断
#       （cleanup_completion 那四个 marker 对 APPS 是全灭，APPS 解答必然有
#        多个函数、if __name__、print）
#     - call-based（有 fn_name 的 LeetCode 题）默认丢弃：stdin runner 判不了。
#       test split 的 interview 档实测 call-based 为 0，影响很小；
#       但 APPS **train** 前 300 条里有 178 条是 call-based，建池时要注意。
#   => 绝对分数不可外引，跨 run 对比有效。
#
# -----------------------------------------------------------------------------
# 前置：数据要在**登录节点**先下好（计算节点 HF_HUB_OFFLINE=1）
#   python -m onereplay.scripts.download_apps_data \
#     --out_dir /scratch/weiliu87/student/czq/Onereplay/datasets/code
#   产出 apps_train.parquet / apps_test.parquet，并打印难度布局与 call-based 计数。
#   已有 save_to_disk 目录的话直接把 APPS_DATA 指过去，加载器两种都吃。
#
# 用法:
#   qsub onereplay/pbs/43_apps_probe.pbs
#   本站点 qsub 不吃命令行变量，改参数直接改下面「探针参数」那一段。
#
# 预计: 200 题 × 1 个模型 × 1024 token，约 1.5~2 h。walltime 给 4 h。
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/43_apps_probe.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    # 写成 if 而不是 `[[ -f x ]] && source x && break`：后者在第一个候选不存在时
    # 整条 && 列表返回 1，set -e 会当场把作业干掉（坑 #18）。
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      if [[ -f "${_init}" ]]; then
        source "${_init}"
        break
      fi
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME RESULTS_ROOT OUT_DIR APPS_DATA APPS_SPLIT
    MODELS VANILLA_RUN SEED DIFFICULTIES LIMIT
    APPS_MAX_NEW_TOKENS APPS_MAX_TESTS TIMEOUT FORCE_EVAL DRY_RUN
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv

MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results}"
ADAPTERS="${RESULTS_ROOT}/adapters"

# ---- 探针参数（本站点 qsub 不吃命令行变量，改这一段）----
SEED="${SEED:-1}"
APPS_DATA="${APPS_DATA:-${REPO_ROOT}/datasets/code/apps_test.parquet}"
APPS_SPLIT="${APPS_SPLIT:-test}"        # 仅当 APPS_DATA 是 save_to_disk 目录时生效
DIFFICULTIES="${DIFFICULTIES:-introductory interview}"
LIMIT="${LIMIT:-100}"                   # 每档取多少题
# 512 是 39 号给 MBPP/HumanEval 的预算，对 APPS 几乎肯定不够：题面 P90 就有
# 770 token，解答还要更长。PettingLLMs 的 config 默认响应预算是 2048，
# 评测脚本开到 8192。1024 是探针的起点，看 num_truncated 再定。
APPS_MAX_NEW_TOKENS="${APPS_MAX_NEW_TOKENS:-1024}"
APPS_MAX_TESTS="${APPS_MAX_TESTS:-5}"
TIMEOUT="${TIMEOUT:-10}"
MODELS="${MODELS:-base}"                # 探针只要 base；要看伤害有多大就 "base vanilla"
VANILLA_RUN="${VANILLA_RUN:-cs_vanilla_seed${SEED}}"
FORCE_EVAL="${FORCE_EVAL:-0}"
DRY_RUN="${DRY_RUN:-0}"

# 探针不是正式结果，产物单独放，免得被「已有 summary.json 就跳过」的逻辑
# 当成完整结果挡住后续正式评测（坑 #7）。
OUT_DIR="${OUT_DIR:-${RESULTS_ROOT}_appsprobe}"

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
[[ -e "${APPS_DATA}" ]] || { echo "缺 APPS 数据: ${APPS_DATA}（先在登录节点跑 download_apps_data）"; exit 1; }
mkdir -p "${OUT_DIR}"

resolve_path () {
  case "$1" in
    base)    echo "" ;;
    vanilla) echo "${ADAPTERS}/${VANILLA_RUN}" ;;
    *)       echo "" ;;
  esac
}
resolve_name () {
  case "$1" in
    base)    echo "base" ;;
    vanilla) echo "${VANILLA_RUN}" ;;
    *)       echo "$1" ;;
  esac
}

set +x
echo "========================================================================"
echo "APPS 量程探针"
echo "  数据     : ${APPS_DATA} (split=${APPS_SPLIT})"
echo "  难度     : ${DIFFICULTIES}   每档 ${LIMIT} 题"
echo "  预算     : ${APPS_MAX_NEW_TOKENS} token   每题最多 ${APPS_MAX_TESTS} 个用例   超时 ${TIMEOUT}s"
echo "  模型     : ${MODELS}"
echo "  输出     : ${OUT_DIR}"
echo "  天花板   : gold solution 93.3%（本地已验收，见文件头）"
echo "========================================================================"
if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只打印配置。"
  echo "Job finished at: $(date)"
  exit 0
fi
set -x

# ---------------------------------------------------------------------------
# 判分链路自检：这套 fork-per-testcase 的 runner 在容器里没跑过。它要是不通，
# 整个作业跑完只会得到一片 0 分，很难看出是模型差还是判分坏了。
# ---------------------------------------------------------------------------
python - <<'PY'
from onereplay.eval.apps_exec import evaluate_stdin_program

code = "a = int(input())\nb = int(input())\nprint(a + b)\n"
ok = evaluate_stdin_program(code, ["2\n3\n"], ["5\n"], timeout=10.0)
print(f"自检 正确解 : {ok}")
bad = evaluate_stdin_program("while True:\n    pass\n", ["1\n"], ["1\n"], timeout=5.0)
print(f"自检 死循环 : {bad}")
if not ok["passed"]:
    raise SystemExit("判分沙箱不通（多半是容器里 subprocess 起不来），先修这个再评测")
if bad["error"] != "timeout":
    raise SystemExit("超时没生效：死循环会把作业挂死，先修 kill 路径")
print("APPS 判分链路 OK")
PY

# ---------------------------------------------------------------------------
# 评测：每档难度单独一次，产物落在 <OUT_DIR>_<difficulty>/apps/<run_name>/
# 分开放是因为 introductory 和 interview 的分数不可合并平均 —— 它们是两个量程。
# ---------------------------------------------------------------------------
for difficulty in ${DIFFICULTIES}; do
  tier_out="${OUT_DIR}_${difficulty}"
  mkdir -p "${tier_out}"
  for short in ${MODELS}; do
    name="$(resolve_name "${short}")"
    path="$(resolve_path "${short}")"
    if [[ -n "${path}" && ! -d "${path}" ]]; then
      echo "跳过 ${short}：缺 adapter ${path}"
      continue
    fi
    if [[ "${FORCE_EVAL}" != "1" && -f "${tier_out}/apps/${name}/summary.json" ]]; then
      echo "已有结果，跳过 ${difficulty}/${name}"
      continue
    fi

    echo "==== eval apps: ${name} (${difficulty}) ===="
    python -m onereplay.scripts.evaluate \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
      --adapter_path "${path}" --run_name "${name}" \
      --metrics apps --out_dir "${tier_out}" --seed "${SEED}" \
      --apps_data_file "${APPS_DATA}" --apps_split "${APPS_SPLIT}" \
      --apps_difficulties "${difficulty}" \
      --apps_max_new_tokens "${APPS_MAX_NEW_TOKENS}" \
      --apps_max_tests "${APPS_MAX_TESTS}" \
      --limit "${LIMIT}" --timeout "${TIMEOUT}" \
      --cache_dir "${JOB_TMPDIR}/hf_datasets"
  done
done

set +x
echo "========================================================================"
echo "怎么读（这四个数决定后面三件事）："
echo "  1) num_truncated —— **先看这个**。占比高说明 ${APPS_MAX_NEW_TOKENS} token 不够，"
echo "     分数是多少都没意义，先加预算重跑。这是最可能的瓶颈。"
echo "  2) pass_at_1 —— 有没有量程。base 若低于 5%，这一档就没法用 strict 量退化，"
echo "     要么换 introductory，要么改用 pass_ratio 当主指标。对着天花板 93.3% 读。"
echo "  3) mean_pass_ratio —— 连续值。即使 strict 只有个位数，ratio 常有 15~25%，"
echo "     且配对检验能分辨的效应比 strict 小一个量级（39 号算过 MBPP strict 的"
echo "     可分辨下限是 3.30pp，而预期只救回 2.28pp，测不出来）。"
echo "  4) error_buckets —— SyntaxError 暴涨 = 格式崩了（和 IFEval / GSM8K 丢 '####'"
echo "     同一件事，正是 OneReplay 主张能保住的）；wrong answer 上升才是算法退化。"
echo ""
echo "产物: ${OUT_DIR}_<difficulty>/apps/<run_name>/{summary.json,responses.jsonl}"
echo "      ${OUT_DIR}_<difficulty>/apps_summary.csv"
echo ""
echo "定完参数后：把难度、LIMIT、APPS_MAX_NEW_TOKENS、APPS_MAX_TESTS 固化进 39/42 号，"
echo "所有 run 必须用同一组值，否则跨 run 不可比。"
echo "Job finished at: $(date)"
