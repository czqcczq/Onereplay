#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_gold_or
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/logs/onereplay/
#
# =============================================================================
# NUS Hopper: 代码线 gold-target 消融 —— OneReplay 臂（训练 + 代码评测）
#   与 52 号的 cs_onereplay_ifcode_opcedu_lam2e-2_seed1_regonce 逐字相同，
#   唯一变量是 --cov_path 指向 gold 版的 C_mix：
#     52 号  C_mix = 0.5*C_if(FLAN gold) + 0.5*C_code(OPC **自蒸馏**)
#     本脚本 C_mix = 0.5*C_if(FLAN gold) + 0.5*C_code(OPC **gold**)     <- 57 号 + 混合
#
# -----------------------------------------------------------------------------
# 这条臂在整个消融里的位置
#   gold 消融一共三条臂，分三个脚本投，互不依赖，可以同时排队：
#     59（本脚本）OneReplay  --cov_path    C_mix_gold
#     60          EWC        --fisher_path F_mix_gold_equal
#     61          replay     --replay_target_column gold_targets，4n4r
#   拆开的理由：单条臂完整 3 epoch 就要十几小时，一个 24 h 作业装不下三条；而且三条
#   臂的失败模式完全不同（C 看 trace、F 看 magnitude、replay 看 token 占比），挤在
#   一个脚本里会让自检和文件头都变成大杂烩。
#
#   与之配对的自蒸馏版结果直接读 52 号已有的 run，不用重跑。本脚本的 run 名多一个
#   _gold 段，两批会落进同一份 summary.csv，可以并排读。
#
# -----------------------------------------------------------------------------
# !! λ 沿用 2e-2 之前先看 57 号 Step 2 的打印
#   2e-2 是这么来的：C_if 单独 run 用 λ=3e-2，而 C_mix 在真实 ΔW 下的惩罚约为 C_if
#   的 1.252 倍，3e-2/1.252 ≈ 2.4e-2，取 2e-2。这个 1.252 是对**自蒸馏**的 C_mix 算
#   的。gold 的 trace 不同，57 号会重新算一遍并打印 λ_mix 建议：
#     与 2e-2 相差 10% 以内   直接沿用，两条线的 λ 才是同一把尺子
#     差得多                  改下面的 LAMBDA，并先 PROBE=1 短跑确认罚项量级
#
# -----------------------------------------------------------------------------
# !! 训练超参必须与 52 号逐字相同，否则消融不成立
#   BATCH=8 ACCUM=64（每次更新 64 行新任务）、EVAL_BATCH=8（val_loss 是按 batch 平均
#   的，改了就与 52/60/61 不可比）、EPOCHS=3、LR=1e-4、MAXLEN=512、q_proj,v_proj。
#   reg_once_per_update=1：罚项每次参数更新只算一次，不是每个 micro-batch 都算。
#
# -----------------------------------------------------------------------------
# 用法（**本站点 qsub 不吃命令行变量**，开关改「阶段开关」段的默认值）
#   qsub onereplay/pbs/59_opc_code_gold_onereplay.pbs
#
#   DRY_RUN=1   只打印 run 名与路径，不训练不评测（建议先跑）
#   PROBE=1     300 步短跑，只看罚项量级，不保存不评测（换 λ 时用）
#   DO_TRAIN=0  只评测已有 adapter
#   DO_EVAL=0   只训练
#   FORCE_TRAIN=1 / FORCE_EVAL=1  覆盖"已存在就跳过"
#
# 前置条件
#   1) ${MIX_COV_GOLD} 已就位（57 号采集后，按其文末打印的命令混合）
#   2) ${CS_DATASET} = datasets/commonsense_170k_hf
#   3) 代码评测数据 ${CODE_DATA_DIR}/humaneval_test.parquet、mbpp_full/
#   4) mkdir -p /scratch/weiliu87/logs/onereplay
#
# 出结果之后：整体分数之外一定要看 base 答对子集上的保留率，脚本结尾会打出命令。
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/59_opc_code_gold_onereplay.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME CS_DATASET RESULTS_ROOT CODE_DATA_DIR DATASET_CACHE OUT_DIR
    DRY_RUN DO_TRAIN DO_EVAL FORCE_TRAIN FORCE_EVAL PROBE
    SEED EPOCHS LR BATCH ACCUM MAXLEN VAL_FRAC MAXVAL TARGET_MODULES
    EVAL_BATCH SAVE MAX_STEPS
    LAMBDA REG_ONCE IDENTITY_COV MIX_COV_GOLD RUN_TAG
    MODELS EXTRA_MODELS
    CODE_MAX_NEW_TOKENS TIMEOUT LIMIT MBPP_SPLIT MBPP_CONFIG
    WITH_IF IFEVAL_INPUT
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：那会把当前 shell 替换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的训练与评测。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

# ---- 项目路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results}"
CS_DATASET="${CS_DATASET:-${REPO_ROOT}/datasets/commonsense_170k_hf}"
CODE_DATA_DIR="${CODE_DATA_DIR:-${REPO_ROOT}/datasets/code}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
ADAPTERS="${RESULTS_ROOT}/adapters"
export HF_DATASETS_CACHE="${DATASET_CACHE}"

# ---- 阶段开关 ----
DRY_RUN="${DRY_RUN:-1}"          # 默认只打印计划，确认无误后改 0
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"
PROBE="${PROBE:-0}"

# ---- 训练超参：与 52 号逐字一致，唯一变量是 C 的来源 ----
SEED="${SEED:-1}"
EPOCHS="${EPOCHS:-3}"
LR="${LR:-1e-4}"
BATCH="${BATCH:-8}"
ACCUM="${ACCUM:-64}"             # 每次更新 64 行新任务
EVAL_BATCH="${EVAL_BATCH:-8}"    # 钉住，否则 val_loss 与 52/60/61 不可比
MAXLEN="${MAXLEN:-512}"
VAL_FRAC="${VAL_FRAC:-0.01}"
MAXVAL="${MAXVAL:-1000}"
TARGET_MODULES="${TARGET_MODULES:-q_proj,v_proj}"
SAVE="${SAVE:-1}"
MAX_STEPS="${MAX_STEPS:-0}"

if [[ "${PROBE}" == "1" ]]; then
  SAVE=0
  [[ "${MAX_STEPS}" == "0" ]] && MAX_STEPS=300
  DO_EVAL=0
  echo "PROBE=1：SAVE=0 MAX_STEPS=${MAX_STEPS} DO_EVAL=0，只看罚项量级"
fi

# ---- 正则化：λ 沿用前先看 57 号 Step 2 的 λ_mix 建议（见文件头）----
LAMBDA="${LAMBDA:-2e-2}"
REG_ONCE="${REG_ONCE:-1}"
IDENTITY_COV="${IDENTITY_COV:-0}"
MIX_COV_GOLD="${MIX_COV_GOLD:-${RESULTS_ROOT}/cov/cov_if_code_opcedu20k_gold_mix_qv.pt}"

# ---- run 名：_gold 段是关键，不带它会覆盖 52 号的 adapter ----
RUN_TAG="${RUN_TAG:-gold}"
RUN="cs_onereplay_ifcode_opcedu_${RUN_TAG}_lam${LAMBDA}_seed${SEED}_regonce"

# ---- 评测：与 39/42/52/55/56 同口径，所有 run 必须同预算才可比 ----
MBPP_CONFIG="${MBPP_CONFIG:-full}"
MBPP_SPLIT="${MBPP_SPLIT:-test}"
CODE_MAX_NEW_TOKENS="${CODE_MAX_NEW_TOKENS:-512}"
TIMEOUT="${TIMEOUT:-10}"
LIMIT="${LIMIT:-0}"
HUMANEVAL_FILE="${CODE_DATA_DIR}/humaneval_test.parquet"
MBPP_DIR="${CODE_DATA_DIR}/mbpp_${MBPP_CONFIG}"

WITH_IF="${WITH_IF:-0}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"

MODELS="${MODELS:-}"             # 额外要评的已有 run 名（不训练）
EXTRA_MODELS="${EXTRA_MODELS:-}" # "name;/abs/path" 用 | 分隔

# LIMIT>0 的产物只覆盖前 N 题，写进正式目录会被"已有 summary.json 就跳过"当成完整结果。
OUT_DIR="${OUT_DIR:-${RESULTS_ROOT}}"
if [[ "${LIMIT}" != "0" ]]; then
  OUT_DIR="${OUT_DIR}_limit${LIMIT}"
fi

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
if (( ACCUM % BATCH != 0 )); then
  echo "ACCUM=${ACCUM} 不能被 BATCH=${BATCH} 整除，每次更新的行数会被静默取整"; exit 1
fi
if (( ACCUM != 64 )); then
  echo "ACCUM=${ACCUM} 与 52/60/61 的 64 不符，三条臂走的不是同一条优化轨迹"; exit 1
fi
mkdir -p "${ADAPTERS}" "${RESULTS_ROOT}/metrics" "${OUT_DIR}" "${DATASET_CACHE}"

echo "run      = ${RUN}"
echo "C_mix    = ${MIX_COV_GOLD}"
echo "λ        = ${LAMBDA}  reg_once=${REG_ONCE}  seed=${SEED}"
echo "训练     = BATCH ${BATCH} / ACCUM ${ACCUM}(行/更新) / EPOCHS ${EPOCHS} / MAXLEN ${MAXLEN}"
echo "评测     = MBPP ${MBPP_SPLIT}(${MBPP_CONFIG}) max_new=${CODE_MAX_NEW_TOKENS} timeout=${TIMEOUT} limit=${LIMIT}"
echo "OUT_DIR  = ${OUT_DIR}"
echo "对照(自蒸馏版, 52 号): cs_onereplay_ifcode_opcedu_lam2e-2_seed${SEED}_regonce"

echo "==== 前置检查 ===="
[[ -f "${MIX_COV_GOLD}" ]] || { echo "缺 C_mix_gold: ${MIX_COV_GOLD}（先跑 57 号采集，再按其文末命令混合）"; exit 1; }
[[ -d "${CS_DATASET}" ]] || { echo "缺 commonsense_170k: ${CS_DATASET}"; exit 1; }

if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只做前置检查，不训练不评测。确认无误后把默认值改 0 再投。"
  echo "Job finished at: $(date)"
  exit 0
fi

# ===========================================================================
# 训练
# ===========================================================================
if [[ "${DO_TRAIN}" == "1" ]]; then
  if [[ "${FORCE_TRAIN}" != "1" && "${SAVE}" == "1" && -d "${ADAPTERS}/${RUN}" ]]; then
    echo "跳过训练 ${RUN}：adapter 已存在（FORCE_TRAIN=1 可强制重训）"
  else
    mkdir -p "${RESULTS_ROOT}/map_cache/${RUN}"
    echo "==== train: ${RUN} (C=${MIX_COV_GOLD} λ=${LAMBDA}) ===="
    python -m onereplay.scripts.train --paradigm sft \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
      --dataset_path "${CS_DATASET}" \
      --epochs "${EPOCHS}" --lr "${LR}" --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
      --eval_batch_size "${EVAL_BATCH}" \
      --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" --max_len "${MAXLEN}" \
      --target_modules "${TARGET_MODULES}" \
      --map_cache_dir "${RESULTS_ROOT}/map_cache/${RUN}" \
      --max_steps "${MAX_STEPS}" \
      --cov_path "${MIX_COV_GOLD}" --replay_lambda "${LAMBDA}" \
      --identity_cov "${IDENTITY_COV}" --reg_once_per_update "${REG_ONCE}" \
      --save "${SAVE}" --save_path "${ADAPTERS}/${RUN}" \
      --metrics_path "${RESULTS_ROOT}/metrics/${RUN}.jsonl"

    echo "==== 训练自检: ${RUN} ===="
    python - "${RESULTS_ROOT}/metrics/${RUN}.jsonl" "${LAMBDA}" "${MIX_COV_GOLD}" "${ACCUM}" <<'PY'
import json
import sys

path, want_lambda, want_cov, want_accum = sys.argv[1], float(sys.argv[2]), sys.argv[3], int(sys.argv[4])

epochs = []
with open(path, encoding="utf-8") as handle:
    for line in handle:
        if not line.strip():
            continue
        row = json.loads(line)
        if row.get("epoch") is not None:
            epochs.append(row)
if not epochs:
    raise SystemExit(f"{path} 里没有 epoch 记录，训练没有跑完一个 epoch")
last = epochs[-1]

# train.py 把罚项的来源文件统一记成 penalty_path（EWC 时是 fisher_path，其余是
# cov_path），不是 cov_path 这个名字。字段名对不上就会读到 None 而不是报错。
penalty_path = str(last.get("penalty_path") or "")

print(f"epochs done     = {len(epochs)}")
print(f"replay_lambda   = {last.get('replay_lambda')} (want {want_lambda})")
print(f"regularizer     = {last.get('regularizer')}")
print(f"penalty_path    = {penalty_path}")
print(f"reg_once        = {last.get('reg_once_per_update')}")
print(f"accumulation    = {last.get('accumulation_size')} (want {want_accum})")
print(f"eval_batch_size = {last.get('eval_batch_size')} (want 8, 见文件头)")
print(f"val_loss        = {last.get('val_loss')}")

failures = []
if abs(float(last.get("replay_lambda") or 0.0) - want_lambda) > 1e-12:
    failures.append(f"λ 记录为 {last.get('replay_lambda')}，与本次要求的 {want_lambda} 不符")
if not penalty_path:
    failures.append(
        "metrics 里没有 penalty_path。train.py 的 extra_record 改过字段名的话，"
        "这个自检就形同虚设，先去核对再重训"
    )
elif penalty_path != want_cov:
    failures.append(f"penalty_path 记录为 {penalty_path}，不是本次要用的 {want_cov}")
elif "gold" not in penalty_path:
    failures.append(
        f"penalty_path {penalty_path!r} 里没有 gold 字样：这一臂很可能训在自蒸馏的 C 上，"
        "那样就和 52 号是同一个 run，消融白跑"
    )
if int(last.get("accumulation_size") or 0) != want_accum:
    failures.append(f"accumulation_size={last.get('accumulation_size')}，与 52 号的 {want_accum} 不符")

if failures:
    print("\n训练自检失败:")
    for item in failures:
        print(f"  - {item}")
    raise SystemExit(1)
print("\n训练自检通过")
PY
  fi
else
  echo "DO_TRAIN=0：跳过训练"
fi

# ===========================================================================
# 评测：与 39/42/52/55/56 同口径
# ===========================================================================
if [[ "${DO_EVAL}" != "1" ]]; then
  echo "DO_EVAL=0：跳过评测"
  set +x
  echo "Job finished at: $(date)"
  exit 0
fi

EVAL_SPECS="${RUN};${ADAPTERS}/${RUN}"
for m in ${MODELS}; do EVAL_SPECS="${EVAL_SPECS}|${m};${ADAPTERS}/${m}"; done
if [[ -n "${EXTRA_MODELS}" ]]; then
  EVAL_SPECS="${EVAL_SPECS}|${EXTRA_MODELS}"
fi

CODE_AVAIL=""
[[ -f "${HUMANEVAL_FILE}" ]] && CODE_AVAIL="${CODE_AVAIL} humaneval"
[[ -d "${MBPP_DIR}" ]] && CODE_AVAIL="${CODE_AVAIL} mbpp"
CODE_AVAIL="$(echo "${CODE_AVAIL}" | xargs || true)"
if [[ -z "${CODE_AVAIL}" ]]; then
  echo "找不到任何代码评测数据（${HUMANEVAL_FILE} / ${MBPP_DIR}），跳过评测"
  set +x
  echo "Job finished at: $(date)"
  exit 0
fi
echo "CODE_AVAIL=[${CODE_AVAIL}]"

# 判分链路自检：沙箱不通的话整个作业跑完只会得到一片 0 分。39 号加的，照搬。
python - <<'PY'
from onereplay.eval.code_exec import evaluate_assert_program, evaluate_entry_point_program

ok, err = evaluate_assert_program("def add(a, b):\n    return a + b\n", ["assert add(1, 2) == 3"], 5.0)
print(f"自检 MBPP 路径      : passed={ok} error={err!r}")
program = "def add(a, b):\n    return a + b\n"
test = "def check(candidate):\n    assert candidate(1, 2) == 3\n"
ok2, err2 = evaluate_entry_point_program(program, "add", test, 5.0)
print(f"自检 HumanEval 路径 : passed={ok2} error={err2!r}")
if not (ok and ok2):
    raise SystemExit("判分沙箱不通（多半是容器里 multiprocessing 起不来），先修这个再评测")
print("判分链路 OK")
PY

pending_metrics () {
  # $1=run_name, 其余=候选 metric。已有 summary.json 的跳过，除非 FORCE_EVAL=1。
  local name=$1; shift
  local out=""
  for m in "$@"; do
    if [[ "${FORCE_EVAL}" == "1" || ! -f "${OUT_DIR}/${m}/${name}/summary.json" ]]; then
      out="${out}${out:+,}${m}"
    fi
  done
  echo "${out}"
}

IFS='|' read -ra SPECS <<< "${EVAL_SPECS}"
for spec in "${SPECS[@]}"; do
  name="${spec%%;*}"
  adapter="${spec#*;}"
  if [[ ! -d "${adapter}" ]]; then
    echo "跳过评测 ${name}：找不到 adapter ${adapter}"
    continue
  fi
  # shellcheck disable=SC2086
  cp="$(pending_metrics "${name}" ${CODE_AVAIL})"
  if [[ -z "${cp}" ]]; then
    echo "跳过代码评测 ${name}：所有代码指标都已有结果（FORCE_EVAL=1 可重评）"
  else
    echo "==== eval code: ${name} (${cp}) ===="
    python -m onereplay.scripts.evaluate \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
      --adapter_path "${adapter}" --run_name "${name}" \
      --metrics "${cp}" --out_dir "${OUT_DIR}" --seed "${SEED}" \
      --limit "${LIMIT}" \
      --code_max_new_tokens "${CODE_MAX_NEW_TOKENS}" --timeout "${TIMEOUT}" \
      --humaneval_data_file "${HUMANEVAL_FILE}" \
      --mbpp_dataset_path "${MBPP_DIR}" --dataset_split "${MBPP_SPLIT}" \
      --cache_dir "${JOB_TMPDIR}/hf_datasets"
  fi

  if [[ "${WITH_IF}" == "1" ]]; then
    ip="$(pending_metrics "${name}" ifeval)"
    if [[ -n "${ip}" ]]; then
      echo "==== eval IF: ${name} ===="
      python -m onereplay.scripts.evaluate \
        --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
        --adapter_path "${adapter}" --run_name "${name}" \
        --metrics ifeval --out_dir "${OUT_DIR}" --seed "${SEED}" \
        --ifeval_input "${IFEVAL_INPUT}"
    fi
  fi
done

set +x
echo "========================================================================"
echo "run   : ${RUN}"
echo "汇总  : ${OUT_DIR}/<metric>_summary.csv"
echo "逐题  : ${OUT_DIR}/<metric>/${RUN}/responses.jsonl"
echo ""
echo "对照读法（同一份 CSV，自蒸馏版不用重评）:"
echo "  自蒸馏 cs_onereplay_ifcode_opcedu_lam2e-2_seed${SEED}_regonce   <- 52 号"
