#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N p4_cs2if
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# Part 4: Model-CS --FLANv2--> Model-CS-IF，用 C_cs 保护常识问答能力
#
#     Model-CS ---- FLAN v2 (50000 单轮样本) ----> Model-CS-IF
#              \                              /
#               \---- λ·tr(ΔW C_cs ΔWᵀ) ----/
#
#     评测  旧能力保留: commonsense_qa 八个测试集   新任务: IFEval + FollowBench
#     四行  cs_anchor (Stage 2 起点) / vanilla (无保护) / onereplay (C_cs) / ewc (F_cs)
#
# 这是第三条「保旧能力」的线，把结论从两个点变成三个点：
#
#     Part 2  Base --FLANv2----------> Model-IF-FLAN --OpenR1 + C_if  --> 保 IF
#     Part 3  Base --OpenR1----------> Model-Math    --FLANv2 + C_math--> 保 Math
#     Part 4  Base --Commonsense170k-> Model-CS      --FLANv2 + C_cs  --> 保 CS
#                   ^^^^^^^^^^^^^^^^^  ^^^^^^^^                ^^^^^
#                   93 号的产物         本脚本的基座             101 号采的矩阵
#
# 三个旧能力的形态刻意选得不一样：IF 是格式服从，Math 是长 CoT 推理，CS 是**固定模板下
# 的闭集多选常识问答**（93 号文件头的原话，不要写成"通用能力"—— 这八个测试集是
# Commonsense170k 那八个数据集的留出半边，是严格的 in-domain train/test）。三种都守住，
# 「onereplay 保的是能力、不是某个域碰巧好保」才算有证据。
#
# -----------------------------------------------------------------------------
# 【与 Part 3（100 号）的关系：新任务完全相同，所以这条线有两个便宜】
#
# 100 号和本脚本的新任务是同一个：94 号那个 FLAN v2 50k 池、同样的 BATCH/ACCUM/MAXLEN/
# LR/EPOCHS。**唯一变的是基座和保护矩阵。** 由此得到两件别的线之间没有的东西：
#
# 1) λ 可以从 Part 3 折算过来。约束强度 ∝ λ·trace(C)，而 λ·R 要和 task_loss 比才有
#    意义 —— 两条线的 task_loss 尺度相同（同一个新任务），于是只剩 trace(C) 一个变量：
#        λ_part4 ≈ λ_part3 · trace(C_math) / trace(C_cs)
#    101 号 Step 2 会把这个比值和折算值直接打出来（传 REF_LAMBDA=<Part 3 选定的 λ>）。
#    这是一个真正可用的起点，不只是量级参考。但仍要跑一次 MODE=lambda_probe 确认。
#
# 2) 「代价」那一列可以跨线读。各臂在 IFEval/FollowBench 上的分数和 Part 3 是同一个
#    新任务、同一套预算，所以「保 Math 要付多少可塑性」和「保 CS 要付多少」可以并排。
#
# -----------------------------------------------------------------------------
# 【本线的测量比 Part 3 干净得多，这是它最容易被低估的价值】
#
# Part 3 的保留分数（GSM8K/MATH-500）是**生成 + 抽 \boxed{}**，于是分数和输出长度纠缠：
# 输出被 FLAN 压短就走不到 \boxed{}、读成不会做，撞上 8192 上限又被右删失，所以那条线
# 的每个数学分都必须配着 hit-cap 一起读才有可比性。
#
# 本线的主口径 acc_logprob **没有这个问题**：它对每行的候选集逐个算
# "the correct answer is <label>" 的 continuation logprob 再取 argmax（见
# eval/metrics/commonsense_qa.py 文件头），是闭集排序，不解码、不正则匹配、永远不会
# "抽不出答案"，因此**不受输出长度漂移影响**。遗忘量可以直接读。
#
# 代价是它只回答「模型还能不能在闭集里排对」，不回答「还会不会按训练格式作答」。后者由
# acc_gen + parse_rate 回答，而那两个数在本线会被新任务明显推动（见下一节），所以：
#
#     acc_logprob  = 能力保留，主口径，直接读
#     acc_gen      = 格式保留，只能和 parse_rate 一起读，单独引用是错的
#
# 两个都报，而且要说清哪个是主口径。
#
# -----------------------------------------------------------------------------
# 【输出长度的漂移方向和 Part 3 相反，受害的是 acc_gen 而不是 acc_logprob】
#
# Stage 1 的 Model-CS 只会输出 7-8 个 token（"the correct answer is <label>" 就是它
# 一辈子学过的全部答案形态）。Stage 2 的 FLAN targets P50 是 18-19 token（94 号文件头），
# 而且形态五花八门。所以本线的输出长度是被往**变长、变杂**的方向推 —— 和 Part 3 那个
# 「长 CoT 被压成短答案」正好相反。
#
# 后果只落在生成式打分那一路：模型开始在答案前后加解释、或者干脆不用那个模板，于是
# extract_label 抽不到 label（parse_rate 掉），acc_gen 跟着掉，而它的下降**不是**常识
# 能力的下降。这正是为什么主口径必须是 acc_logprob。诊断段会把 parse_rate、响应长度、
# 以及 logprob_pred 与 gen_pred 的一致率一起打出来，用来分辨「忘了常识」和「忘了格式」。
#
# 另一件要看的事：**预测塌成单一 label**。八个任务的候选集都很小（2-5 个），一个塌成
# 「永远答 true」的模型 acc 会停在 random_baseline 附近而不是 0。诊断段因此还打每个
# task 里 logprob_pred 的众数占比 —— 接近 1 就说明模型不是在答题而是在猜同一个词。
#
# -----------------------------------------------------------------------------
# 【与 94 号（正向 IF 训练）的四处结构性差别】
#
# 1) 基座不是 Qwen3-1.7B-Base，而是 93 号训出来的 Model-CS。
#    train.py 从 --model_dir/--model_name 拼路径加载，全量 checkpoint 是完整权重 +
#    tokenizer，所以直接把 93 号的输出目录当基座传进去，一行代码都不用改。
#
# 2) 加了正则：--cov_path C_cs --replay_lambda λ。94 号是 --replay_lambda 0
#    --measure_replay_when_lambda_zero 0（build_regularizer 返回 None，纯 vanilla）。
#
# 3) vanilla 臂是**必须**的，不是可选对照。
#    「onereplay 保住了 CS」这句话只有和「不保护会掉多少」并排才有内容。而且各臂
#    必须同 LR / 同 EPOCHS / 同 seed / 同数据池，否则差异里混进别的东西。
#
# 4) 评测多了常识保留那一半（commonsense_qa 八个测试集），这才是本作业的主指标；
#    IFEval + FollowBench 这次是**新任务**侧。**不评 IFBench**（与 96/100 号一致）：
#    Part 1 第 8c 节结论是 IFBench 三个家族测长篇散文的涌现统计量、对输出长度极度敏感，
#    而 SFT 必然改变输出长度，那 161 条对遗忘研究是噪声源。
#
# -----------------------------------------------------------------------------
# 【C_cs 从哪来，以及它为什么必须是 101 号采的那一份】
#
# 罚项是 λ·tr(ΔW C ΔWᵀ)，ΔW = W − W0，而 W0 是 train.py 在训练开始时从**加载进来的
# 模型**快照的（build_regularizer 之后紧跟 snapshot_reference_weights）。本脚本的
# 基座是 Model-CS，所以 W0 = Model-CS 的权重，C 也必须是在同一个模型上采的 ——
# 这正是 101 号做的事（--model_name = CS_RUN）。拿 Base 上采的 C 来配，是两个不同点上
# 的量拼在一起，不报错、loss 曲线也正常，只会让保护变弱且无法解释。这条线上这个错误
# 尤其容易犯，因为 Stage 1 把隐状态分布改得很彻底：93 号那 170k 行只教一件事，读完题
# 之后输出 "the correct answer is <label>"。
#
# Step 0 会读 C 文件的 metadata，把 model_name 和本作业的基座名对表，不一致就退出。
# 还会打印两个 max_len 并说明它们**本来就不该相等**：C_cs 采在 512（旧知识池的预算，
# 与 93 号训练一致），新任务在 1536 训练。罚项只经过 ΔW 与 C 相乘，序列长度不需要一致，
# 需要一致的是模型。
#
# -----------------------------------------------------------------------------
# 【--reg_impl analytic 不是调优选项，是这条线的必需项】
#
# train.py 的默认是 autograd。全量微调下两条路径算的是同一个罚项，但内存不同，而
# regularizer.py resolve_full_layers 的注释把数字记下来了：analytic 路径**按层**把
# W0 casts 成 fp32，「keeps one layer of temporaries alive rather than 197」。
# autograd 那条会把整个 W0 的 fp32 副本留一整轮 —— 在 Qwen3-1.7B 上是 6.41 GiB fp32
# 叠在 3.20 GiB bf16 之上。
#
# 保留 analytic 一是省这 6.4 GiB，二是它天然一次更新只注入一次罚项梯度，与
# --reg_once_per_update 1 一致（传 0 会直接报错，train.py 里有显式检查）。本线的显存
# 与 100 号完全同量级（同一个新任务、同一个架构、同一个 scope），没有理由退回 autograd。
#
# -----------------------------------------------------------------------------
# 【显存预算：与 100 号相同，但 vanilla 基线仍要 smoke 实测】
#
# 新任务是 FLAN@1536（不是 96 号的 OpenR1@8192），激活小得多，所以 vanilla 基线的峰值
# 远低于 96 号那 50 GiB 量级。确定的加数与 96/100 号相同（同一个架构、同一个 full scope）：
#   + C_cs 常驻 (fp32, 197 层, all-linear)           + 6.58 GiB
#       6 x 2048² + 6144² = 62.91M/层 x 28 + lm_head 2048² = 1.766G 个 fp32
#   + W0 快照 (bf16, 1.72G 参数)                      + 3.20 GiB
#   + analytic 的单层临时量 (最大是 lm_head 的 fp32)   + 约 1.2 GiB
# H200 140 GiB 余量充足，80GB 卡也够。但 vanilla 基线的 peak **必须先跑 MODE=smoke 实测**，
# 94 号没有正式记这个数（它也让你跑 smoke）。C 的形状和 100 号逐字相同（矩阵是 d_in x d_in，
# 与采集时的序列长度无关），所以 100 号的 smoke 实测值在这里可以当预期，但别当结论。
# smoke 还要确认日志里出现这一行（trainers/base.py 在第 1 步打印）：
#     regularizer covers 197 layers; no penalty matrix for 0 layers
# missing 非 0 就说明 C 的层名和模型对不上，罚项在偷偷少覆盖几层。
#
# -----------------------------------------------------------------------------
# 【正则的计算开销：本线约 3% 而不是 96 号的 0.13%，但绝对量仍可忽略】
#
# analytic 每次优化器更新做一遍 2λ·ΔW·C，每层一次矩阵乘，成本只取决于权重维度、与序列
# 长度无关，所以还是约 3.4 TFLOP / 更新（down_proj 2.2 + lm_head 0.64 + 其余约 0.5）。
# 但训练计算随序列长度掉：一次更新 64 行 x 约 150 token x 6 x 1.72e9 ≈ 0.1 PFLOP（FLAN
# 序列比 OpenR1 短约 25 倍），所以正则占比升到 **约 3%**。仍然小，且 ACCUM=64 把它摊到
# 一次更新只算一遍。onereplay 臂和 vanilla 臂的墙钟应当接近；差很多先怀疑显存抖动。
# 这一节和 100 号逐字相同 —— 新任务一样、C 的形状一样，开销自然一样。
#
# -----------------------------------------------------------------------------
# 【λ 怎么定：这是本脚本唯一一个真正需要人做判断的旋钮】
#
# 本线有一个别的线没有的起点：Part 3 的 λ 按 trace 折算过来（新任务相同，见上面「与
# Part 3 的关系」）。101 号 Step 2 传 REF_LAMBDA=<Part 3 选定的 λ> 就会打印
#     λ_part4 ≈ λ_part3 · trace(C_math) / trace(C_cs)
# 把那个数当 grid 中心，比从历史值猜好得多。
#
# 但**不要跳过 probe**。折算只保证起点在正确的数量级附近，它没覆盖一件事：C_math 采在
# Model-Math 上、C_cs 采在 Model-CS 上，两个不同的 W0，ΔW 在训练早期的增长速度不必相同。
#
# 也不要照搬别的历史值。44 号那个 7.5e-3 是**新任务**为 Commonsense@512 时定的（正好和
# 本线的旧/新方向相反），96 号那套是在 OpenR1@8192 上定的。约束强度要和**任务损失**比
# 才有意义，而这两个 task_loss 的绝对尺度都不是 FLANv2@1536。
#
# 三步走，都在本脚本里：
#
#   1) MODE=lambda_probe  短跑几档 λ，打印 λ·R 与 task_loss 的比值。
#      挑 λ 让 λ·R 落在 task_loss 的 1%~10% 区间当 grid 中心 —— 罚项要能改变优化
#      方向（太小等于没开），又不能盖住任务信号（太大等于不学新任务）。
#      metrics jsonl 里的字段名是 train_lambda_reg（= λ·R）和 train_task_loss。
#
#   2) 各档跑完整训练，看 val_loss（新任务 IF 的可塑性）和常识 AVERAGE（旧能力保留）。
#
#   3) **matched plasticity**：报结果时各臂应当在同一个新任务 val_loss 上比，
#      否则「onereplay 保住了 CS」可能只是因为它少学了新任务。仓库里有现成工具，
#      它把 val_loss(λ) = floor + a·λ^b 拟合出来再反解：
#
#        python -m onereplay.scripts.calibrate_lambda \
#          --results_root ${RESULTS_ROOT} \
#          --pattern 'part4_if_onereplay_lr*_lam*_seed1' \
#          --floor_run part4_if_vanilla_lr<LR>_seed1 \
#          --target <vanilla 的 val_loss>
#
#      floor 必须是同配置的 vanilla run —— λ→0 收敛到的就是它，没有 floor 这个拟合
#      没有锚点、会系统性过冲（calibrate_lambda 的 docstring 里写了这件事）。
#
# λ 写进 run 名，所以换 λ 不会覆盖已有 checkpoint。
#
# -----------------------------------------------------------------------------
# 【读结果的三条纪律】
#
# 1) **报任何生成式分数必须同时报响应长度中位数。** 这是 Part 1 第 8c 节的口径。本线的
#    长度是往变长方向漂（Model-CS 的 7 个 token -> FLAN 的 18-19 个），IFEval/FollowBench
#    里不少约束本质在量长度，acc_gen/parse_rate 更是直接受害。汇总表每个生成式分数右边
#    紧跟它自己的 words。
#    acc_logprob 是**唯一**不需要这样读的数（闭集排序，不解码），所以它是主口径。
#
# 2) **acc_gen 不能脱离 parse_rate 引用，acc_logprob 不能脱离 random_baseline 引用。**
#    前者的下降可能只是格式漂移（见上面那节）；后者的下限不是 0 —— 候选集只有 2-5 个，
#    塌成单一 label 的模型也能拿到 random_baseline（八任务宏平均约 0.35）。汇总表把
#    random_baseline 和众数占比一起打出来就是为了这件事。
#
# 3) **FollowBench 只有 rule 那一半**（350/820 行、70/164 组，style 类覆盖为 0）。
#    不要写成「FollowBench = xx%」。judge 那 470 行落到 judge_inputs.jsonl，要在有网
#    的地方过 judge_followbench.py。详见 92 号文件头的三条纪律。
#
# -----------------------------------------------------------------------------
# 【前置】计算节点无外网
#   1) Model-CS checkpoint          93 号 MODE=train 的产物（不传 CS_LR 时自动 glob）
#   2) C_cs (+ F_cs for ewc)        101 号的产物 results_part4_cs2if/{cov,fisher}/
#   3) FLAN 数据池                  94 号 MODE=data 的产物 results_part1_if_flanv2/datasets/flan_v2_if_50k
#   4) 常识评测集                   ${REPO_ROOT}/datasets/commonsense_eval/<task>/test.json
#                                   （LLM-Adapters 的 dataset/ 目录，八个子集约 10MB，
#                                    93 号文件头有 git clone + cp 那两行）
#   5) IFEval 输入随仓库自带；FollowBench 完全 vendored（零外部依赖）
#   6) mkdir -p ${REPO_ROOT}/logs
#
# 【用法】ARM 一次只跑一条。本线训练便宜（FLAN@1536 约 0.5-1h），常识保留评测也便宜
#         （八个集 1-1.5h：logprob 约 7.6 万次前向 + 2.2 万行 x 32 token 解码），真正贵的是 IF 新任务侧
#         （两个数据集 3-4h）。所以拆法和 100 号相反：**训练 + 常识评测放一个作业，
#         IF 评测另开**。
#
#   # 0) 只打印计划和前置检查，不碰 GPU（**先跑这个**）
#   qsub -v DRY_RUN=1 onereplay/pbs/102_part4_commonsence2if.pbs
#
#   # 1) 冒烟：两条臂各 70 步，看 peak memory 和「covers 197 layers」那行
#   qsub -v MODE=smoke onereplay/pbs/102_part4_commonsence2if.pbs
#
#   # 2) 选 λ（短跑几档，只看 λ·R / task_loss 的比值）
#   #    ！两条臂的 λ 要各标一次，靠 PROBE_ARM 区分，grid 不通用（见下面 PROBE_ARM 一节）
#   #    起点建议直接用 101 号 Step 2 折算出来的那个数当 grid 中心
#   qsub -v MODE=lambda_probe onereplay/pbs/102_part4_commonsence2if.pbs
#   # 已经单独交了完整 vanilla 的话，probe 里那档 λ=0 可以省掉
#   qsub -v MODE=lambda_probe,PROBE_VANILLA=0 onereplay/pbs/102_part4_commonsence2if.pbs
#   # 只验一个 λ（最快，约 20 次更新）；<折算值> 来自 101 号 Step 2 的 D 组
#   qsub -v MODE=lambda_probe,PROBE_VANILLA=0,LAMBDA_GRID=<折算值> \
#     onereplay/pbs/102_part4_commonsence2if.pbs
#
#   # 2b) 标定 EWC 的 λ。不传 LAMBDA_GRID 时会读 F 文件，围绕 1/mean(F) 现算三档
#   #     （x0.1 / x1 / x10），所以第一次扫不需要你先知道 F 的量级。
#   qsub -v MODE=lambda_probe,PROBE_ARM=ewc,PROBE_VANILLA=0 \
#     onereplay/pbs/102_part4_commonsence2if.pbs
#   # 看完表后只验一档（比值要落在 task_loss 的 1%~10%）
#   qsub -v MODE=lambda_probe,PROBE_ARM=ewc,PROBE_VANILLA=0,LAMBDA_GRID=1.2e7 \
#     onereplay/pbs/102_part4_commonsence2if.pbs
#
#   # 3) vanilla 臂（必须跑，是遗忘的标尺）。训练+常识(保留)评测同作业，IF 评测另开。
#   qsub -v MODE=train,ARM=vanilla,DO_IF=0 onereplay/pbs/102_part4_commonsence2if.pbs
#   qsub -v MODE=eval,ARM=vanilla,DO_CS=0 onereplay/pbs/102_part4_commonsence2if.pbs
#
#   # 4) onereplay 臂（λ 用第 2 步选出来的）
#   qsub -v MODE=train,ARM=onereplay,LAMBDA=7.5e-3,DO_IF=0 onereplay/pbs/102_part4_commonsence2if.pbs
#   qsub -v MODE=eval,ARM=onereplay,LAMBDA=7.5e-3,DO_CS=0 onereplay/pbs/102_part4_commonsence2if.pbs
#
#   # 4b) ewc 臂（λ 用第 2b 步选出来的；ARM=ewc 不接受默认 λ，不传会直接退出）
#   qsub -v MODE=train,ARM=ewc,LAMBDA=1.2e7,DO_IF=0 onereplay/pbs/102_part4_commonsence2if.pbs
#   qsub -v MODE=eval,ARM=ewc,LAMBDA=1.2e7,DO_CS=0 onereplay/pbs/102_part4_commonsence2if.pbs
#   # EWC 只有 autograd 路径，显存曲线和 onereplay 不同，正式跑之前单独冒烟一次
#   qsub -v MODE=smoke,ARM=ewc,LAMBDA=1.2e7 onereplay/pbs/102_part4_commonsence2if.pbs
#
#   # 5) Stage 2 的起点（Model-CS）也要评一遍，它是所有对照的「before」那一行。
#   #    93 号评过它的 commonsense_qa，但结果落在 results_part1_cs 的树里，而且那边
#   #    根本没评过 IFEval/FollowBench（CS 线不测 IF）。
#   qsub -v MODE=eval,ARM=anchor onereplay/pbs/102_part4_commonsence2if.pbs
#
#   # 只评便宜的几个常识子集（先确认链路，HellaSwag 一个集占总量约 45%）
#   #    引号是必须的：-v 用逗号分隔变量，不引起来 piqa 会被当成另一个变量名
#   qsub -v MODE=eval,ARM=vanilla,DO_IF=0,CS_EVAL_TASKS="boolq,piqa" \
#     onereplay/pbs/102_part4_commonsence2if.pbs
#
#   # 便宜地把链路跑通
#   qsub -v MODE=train,ARM=onereplay,MAX_TRAIN_SAMPLES=4000,EPOCHS=1,DO_EVAL=0 \
#     onereplay/pbs/102_part4_commonsence2if.pbs
#
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id>
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/102_part4_commonsence2if.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_p4cs_${JOBTAG}}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_p4cs_${JOBTAG}}"
  EXTRA_BIND=""
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_p4cs_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME CS_LINE_ROOT CS_CKPT_DIR CS_LR CS_RUN CS_CKPT
    IF_LINE_ROOT IF_DATASET RESULTS_ROOT DATASET_CACHE METRICS_DIR CKPT_DIR
    COV_PATH COV_SCOPE FISHER_PATH
    MODE ARM DRY_RUN DO_TRAIN DO_EVAL DO_CS DO_IF SEED FORCE_TRAIN FORCE_EVAL
    EPOCHS LR BATCH ACCUM MAXLEN VAL_FRAC MAXVAL TARGET_MODULES
    LAMBDA LAMBDA_GRID REG_IMPL REG_ONCE REG_ALLOW_TF32 NORMALIZE_BY_LAYERS
    LAMBDA_GRID_ONEREPLAY EWC_GRID_MULTIPLIERS
    PROBE_MAX_STEPS SMOKE_STEPS MAX_TRAIN_SAMPLES LOG_EVERY PROBE_LOG_EVERY
    PROBE_VANILLA PROBE_ARM
    CS_EVAL_DIR CS_EVAL_TASKS CS_SCORING CS_MAX_NEW_TOKENS CS_BATCH CS_SCORE_BATCH
    DIAG_LEN
    IFEVAL_INPUT MAX_NEW_TOKENS EVAL_BATCH
    FB_DATA FB_CATEGORIES FB_MAX_NEW_TOKENS FB_BATCH FB_GROUP_LIMIT
    EVAL_LIMIT
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e --nv -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv

cd "${REPO_ROOT}"
# ---- Stage 1 / CS 线（93 号）的产物：基座就在这里 ----
# 本线的 W0 = Model-CS（Commonsense170k 训出来的），checkpoint 是 93 号 MODE=train 的产物。
CS_LINE_ROOT="${CS_LINE_ROOT:-${REPO_ROOT}/results_part1_cs}"
CS_CKPT_DIR="${CS_CKPT_DIR:-${CS_LINE_ROOT}/checkpoints}"

# ---- IF 线（94 号）的产物：新任务的数据池就在这里，本脚本只读不重建 ----
# 94 号 MODE=data 已经把 FLAN v2 摊平成 {instruction,input,output} 的 save_to_disk
# （40/40/10/10 remix，50k 行）。本线**不重新建池**：换一遍就等于换了数据，Part 1 的
# Model-IF-FLAN 分数也不再可比。
IF_LINE_ROOT="${IF_LINE_ROOT:-${REPO_ROOT}/results_part1_if_flanv2}"
IF_DATASET="${IF_DATASET:-${IF_LINE_ROOT}/datasets/flan_v2_if_50k}"

# ---- Part 4 自己的结果树 ----
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_part4_cs2if}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
export HF_DATASETS_CACHE="${DATASET_CACHE}"
METRICS_DIR="${METRICS_DIR:-${RESULTS_ROOT}/metrics}"
CKPT_DIR="${CKPT_DIR:-${RESULTS_ROOT}/checkpoints}"

# ---- C_cs：101 号的产物（在 Model-CS 上采的 Commonsense 20k 二阶矩）----
COV_SCOPE="${COV_SCOPE:-full}"
COV_PATH="${COV_PATH:-${RESULTS_ROOT}/cov/cov_cs_commonsense_20k_${COV_SCOPE}.pt}"
# ---- F_cs：101 号的产物（ewc 臂用）。scope 跟 C 同一个变量，两者必须同 scope ----
FISHER_PATH="${FISHER_PATH:-${RESULTS_ROOT}/fisher/fisher_cs_commonsense_20k_${COV_SCOPE}.pt}"

# ---- 原始 Base：evaluate.py 在 --adapter_path 为空时会加载它，本线只有它当占位 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B-Base}"

# ---- 模式与臂 ----
MODE="${MODE:-train}"
# vanilla   无保护，遗忘的标尺（必须跑）
# onereplay C_cs 保护
# ewc       F_cs 保护（onereplay 的正则对照臂）
# anchor    不训练，只评 Stage 2 的起点 Model-CS（所有对照的 before 那一行）
ARM="${ARM:-onereplay}"
DRY_RUN="${DRY_RUN:-0}"
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
# 评测拆两半。本线的便宜/贵和 100 号相反：常识保留侧只有 22k 行短序列（logprob 一遍前向
# + 32 token 解码，1-1.5h），IF 新任务侧两个数据集 3-4h。所以推荐「训练 + DO_CS」一个作业、
# DO_IF 另开。默认都开，靠这两个开关拆。
# 注意本线里 DO_CS 评的是**旧能力保留**、DO_IF 评的是**新任务**。
DO_CS="${DO_CS:-1}"
DO_IF="${DO_IF:-1}"
SEED="${SEED:-1}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"

# ---- 训练超参：与 94 号逐字对齐，改任何一个都会让 Part 1 的对照失效 ----
# 本线的新任务是 FLANv2（短答案，P50 约 18 token），不是 91 号那种 8192 长 CoT，所以
# 这些值来自 94 号而不是 91 号。BATCH=8 / ACCUM=64：一次更新 64 行，激活上界
# 8 x 1536 = 12288 token/micro-batch。94 号实测这套配置下 FLAN 池（80% 短 zero-shot 行）
# 远低于吞吐饱和点，BATCH=8 基本是免费的。
BATCH="${BATCH:-8}"
ACCUM="${ACCUM:-64}"
# 1536：与 94 号同值。FLAN 的 few-shot 结构是「示例1 示例2 … 真问题」，左截断只退化成
# 更少 shot 的同一道题（截断率 zs 约 0.3-0.6% / fs 约 1.4-1.9%），是良性的。
MAXLEN="${MAXLEN:-1536}"
# 1 epoch：与 94 号默认一致。这样 Model-CS-IF 和 Part 1 的 Model-IF-FLAN 是同样的
# 新任务预算（约 14.3M tok，只有 Conifer 的 42%，见 94 号文件头），IF 分可以并排读。
EPOCHS="${EPOCHS:-3}"
# **各臂必须同 LR**，这是比较的前提。LR 写进 run 名，train 和 eval 要传同一个值。
LR="${LR:-2e-5}"
VAL_FRAC="${VAL_FRAC:-0.01}"
MAXVAL="${MAXVAL:-500}"
# 全量微调下 --target_modules 不决定哪些参数训练（全都训），只在 LoRA 路径有用。
# 罚项的覆盖范围由 **C 文件的键** 决定，不由这个参数决定。保持与 94 号一致便于对照。
TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj,lm_head}"
MAX_TRAIN_SAMPLES="${MAX_TRAIN_SAMPLES:-0}"
LOG_EVERY="${LOG_EVERY:-500}"

# ---- 正则 ----
# λ 是否由用户显式给出。ewc 臂没有可辩护的默认值（F 的量级由数据决定，见文件头），
# 所以要能区分"用了默认值"和"用户真的传了"，不能让 onereplay 的 7.5e-3 静默漏到 ewc。
LAMBDA_WAS_SET=0
[[ -n "${LAMBDA:-}" ]] && LAMBDA_WAS_SET=1
# 起点值来自 44 号（全量 all-linear），只对 onereplay 有意义。本线有个更好的起点：
# 101 号 Step 2 用 trace(C_math)/trace(C_cs) 折算出来的那个数（新任务与 Part 3 相同，
# 所以折算是有效的，见文件头「λ」一节）。**两个都不要当结论用**，先跑 MODE=lambda_probe。
LAMBDA="${LAMBDA:-7.5e-3}"
# 空 = 按 PROBE_ARM 自动生成：onereplay 用下面这三档，ewc 由 1/mean(F) 现算。
# 拿到 101 号的折算值之后，直接传 LAMBDA_GRID="<折算值/3> <折算值> <折算值*3>" 更省作业。
LAMBDA_GRID="${LAMBDA_GRID:-}"
LAMBDA_GRID_ONEREPLAY="${LAMBDA_GRID_ONEREPLAY:-1e-3 7.5e-3 5e-2}"
# ewc 的 grid 围绕 1/mean(F) 取几档（十倍一档）。乘数写在这里，中心值现算。
EWC_GRID_MULTIPLIERS="${EWC_GRID_MULTIPLIERS:-0.1 1 10}"
# analytic 是本线的必需项，理由见文件头（autograd 会多留 6.41 GiB 的 fp32 W0 副本）。
REG_IMPL="${REG_IMPL:-analytic}"
REG_ONCE="${REG_ONCE:-1}"
REG_ALLOW_TF32="${REG_ALLOW_TF32:-1}"
NORMALIZE_BY_LAYERS="${NORMALIZE_BY_LAYERS:-1}"
# λ probe：数的是 micro-batch，更新次数 = PROBE_MAX_STEPS / (ACCUM/BATCH) = /64。
# 1280 步 = 20 次更新。probe 只要看 λ·R 与 task_loss 的**量级比**，20 次更新够了
# （R 在前几次更新里就从 0 长到稳定量级）；它不是 LR sweep，不需要比末值。
PROBE_MAX_STEPS="${PROBE_MAX_STEPS:-1280}"
PROBE_LOG_EVERY="${PROBE_LOG_EVERY:-64}"
# probe 里那条 λ=0 的短跑。它**不是** calibrate_lambda 要的地板（那个必须是完整
# EPOCHS 的 vanilla run），只是让你在同样 20 次更新下看到「罚项把 task_loss 推高了
# 多少」。选 λ 靠的 λ·R/task_loss 比值只用到 onereplay 臂自己的两个数，所以已经
# 单独交了完整 vanilla 的话，这条可以关掉，省 1/4 的 probe 时间。
PROBE_VANILLA="${PROBE_VANILLA:-1}"
# MODE=lambda_probe 扫哪条臂。两条臂的 λ 各有自己的尺子（C 是激活二阶矩、F 是梯度
# 平方，量级差好几个数量级），所以要分两次 probe，不能共用一个 grid。
PROBE_ARM="${PROBE_ARM:-onereplay}"
SMOKE_STEPS="${SMOKE_STEPS:-70}"

# ---- 评测：常识=保留侧与 93 号同预算，IF=新任务侧与 94 号同预算 ----
# 八个 LLM-Adapters 测试集，布局 <dir>/<task>/test.json。93 号文件头有 clone + cp 两行。
CS_EVAL_DIR="${CS_EVAL_DIR:-${REPO_ROOT}/datasets/commonsense_eval}"
# 空 = 跑全部八个（boolq piqa social_i_qa hellaswag winogrande ARC-Easy ARC-Challenge
# openbookqa，约 22.4k 行）。HellaSwag 一个集 10042 行、占约 45%，想先便宜地过链路就
# 显式列几个。**正式结果必须是八个全跑**：AVERAGE 是宏平均，少一个集就换了指标定义。
CS_EVAL_TASKS="${CS_EVAL_TASKS:-}"
# both = logprob + gen 两路都算，一次模型加载共用。两路各回答一个问题，缺一不可：
#   logprob  闭集排序，主口径，不受输出长度漂移影响（文件头有论证）
#   gen      还会不会按训练格式作答；它的 accuracy 只能和 parse_rate 一起读
# 只在赶时间时传 logprob——但那样就拿不到「格式保留」那一半，而本线恰好最该看它。
CS_SCORING="${CS_SCORING:-both}"
# 答案只有 7-8 个 token，32 足够收尾（与 93 号同值）。**不要为了看长输出把它调大**：
# 各臂必须同值，改了就得所有臂一起重评。诊断段会打 hit-cap，真撞上限再说。
CS_MAX_NEW_TOKENS="${CS_MAX_NEW_TOKENS:-32}"
CS_BATCH="${CS_BATCH:-32}"
# logprob 那一路的瓶颈和解码不同：它要 materialize 一个 [batch, seq, 151936] 的 logit
# 张量、且完全不复用 KV cache，所以单独一个更小的默认值（与 93 号同值）。
CS_SCORE_BATCH="${CS_SCORE_BATCH:-8}"
# 想要一个比准确率更灵敏的连续量（准确率在小 λ 差异下可能纹丝不动），还有个 commonsense
# 指标能给 CS 池上的留出 SFT loss。它需要 --dataset_path 指向 93 号那个 CS 池而不是 FLAN
# 池，所以本脚本没有接进来（这里的 --dataset_path 语义是新任务）。要的话单独起一次
# evaluate：--metrics commonsense --dataset_path <CS 池> --max_len 512。
# 注意那个 val 是按行切的，不是干净留出集，能力结论一律由 commonsense_qa 给出。
# 评测末尾打常识侧的格式/塌缩诊断（parse_rate、响应长度、logprob 与 gen 的一致率、
# 预测众数占比）。它挡的不是删失，而是本线特有的两种误读：
#   * acc_gen 掉了但 acc_logprob 没掉  -> 忘的是格式，不是常识（长度往变长方向漂）
#   * acc 停在 random_baseline 附近    -> 预测塌成单一 label，模型在猜不在答
# 100 号那个 hit-cap 诊断在本线没有对应物：主口径不解码，没有删失可言。
DIAG_LEN="${DIAG_LEN:-1}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-1024}"
EVAL_BATCH="${EVAL_BATCH:-32}"
FB_DATA="${FB_DATA:-}"
FB_CATEGORIES="${FB_CATEGORIES:-}"
FB_MAX_NEW_TOKENS="${FB_MAX_NEW_TOKENS:-2048}"
# 不回落到 EVAL_BATCH：example 类的 prompt P90=2516 / max=5019 token，KV 不是一个量级。
FB_BATCH="${FB_BATCH:-16}"
# FollowBench 不读全局 --limit（metric 只认 group_limit），截它只能用这个，而且按**组**。
FB_GROUP_LIMIT="${FB_GROUP_LIMIT:-0}"
EVAL_LIMIT="${EVAL_LIMIT:-0}"

mkdir -p "${METRICS_DIR}" "${CKPT_DIR}" "${DATASET_CACHE}" "${RESULTS_ROOT}/map_cache"

# ===========================================================================
# Step 0: 前置检查
# ===========================================================================
echo "==== Step 0: 前置检查 ===="

# ---- 解析 Stage 1 checkpoint（与 101 号同一套逻辑，必须选到同一个模型）----
if [[ -z "${CS_CKPT:-}" ]]; then
  if [[ -n "${CS_LR:-}" ]]; then
    CS_RUN="${CS_RUN:-part1_cs_lr${CS_LR}_seed${SEED}}"
    CS_CKPT="${CS_CKPT_DIR}/${CS_RUN}"
  else
    mapfile -t _CANDS < <(
      find "${CS_CKPT_DIR}" -maxdepth 1 -mindepth 1 -type d \
        -name "part1_cs_lr*_seed${SEED}" 2>/dev/null | sort
    )
    if (( ${#_CANDS[@]} == 0 )); then
      echo "在 ${CS_CKPT_DIR} 下找不到 part1_cs_lr*_seed${SEED}"
      echo "先跑 93 号 MODE=train，或传 CS_CKPT=/abs/path"
      exit 1
    fi
    if (( ${#_CANDS[@]} > 1 )); then
      echo "命中多个 Stage 1 checkpoint，必须显式选一个（它是基座也是 W0）:"
      for _c in "${_CANDS[@]}"; do echo "  ${_c}"; done
      echo "传 CS_LR=<lr> 或 CS_CKPT=<绝对路径>；**必须与 101 号采 C 时选的那个一致**"
      exit 1
    fi
    CS_CKPT="${_CANDS[0]}"
    CS_RUN="$(basename "${CS_CKPT}")"
  fi
fi
CS_RUN="${CS_RUN:-$(basename "${CS_CKPT}")}"
[[ -d "${CS_CKPT}" ]] || { echo "缺 Stage 1 checkpoint（基座）: ${CS_CKPT}"; exit 1; }
[[ -f "${CS_CKPT}/config.json" ]] || { echo "${CS_CKPT} 不是可加载的模型目录"; exit 1; }

# ---- run 名 ----
# λ 进名字，所以换 λ 不会覆盖；ARM 进名字，所以两条臂不会互相覆盖。
case "${ARM}" in
  vanilla)   RUN="part4_if_vanilla_lr${LR}_seed${SEED}" ;;
  onereplay) RUN="part4_if_onereplay_lr${LR}_lam${LAMBDA}_seed${SEED}" ;;
  ewc)       RUN="part4_if_ewc_lr${LR}_lam${LAMBDA}_seed${SEED}" ;;
  anchor)    RUN="cs_anchor" ;;
  *) echo "未知 ARM=${ARM}，可选 vanilla / onereplay / ewc / anchor"; exit 1 ;;
esac

# ewc 臂不接受默认 λ。onereplay 的 7.5e-3 在 F 的尺子上毫无意义（差好几个数量级），
# 静默套用会烧掉一个 24h 作业。MODE=lambda_probe,PROBE_ARM=ewc 会现算 grid。
if [[ "${ARM}" == "ewc" && "${MODE}" != "eval" && "${LAMBDA_WAS_SET}" != "1" ]]; then
  echo "!! ARM=ewc 必须显式传 LAMBDA。"
  echo "   onereplay 的默认值 7.5e-3 是 C 那把尺子上的数，F 是梯度平方，量级完全不同。"
  echo "   先跑: qsub -v MODE=lambda_probe,PROBE_ARM=ewc,PROBE_VANILLA=0 ${SELF_PATH}"
  echo "   它会读 ${FISHER_PATH} 的 mean(F)，围绕 1/mean(F) 现算 grid 并打印比值表。"
  exit 1
fi
CKPT="${CKPT_DIR}/${RUN}"

# ---- 数据池 / 评测集 / C ----
if [[ "${ARM}" != "anchor" && "${MODE}" != "eval" ]]; then
  [[ -d "${IF_DATASET}" ]] || {
    echo "缺 FLAN 池: ${IF_DATASET}"
    echo "它是 94 号 MODE=data 的产物。本线不重建池（换池就换了数据）。"
    exit 1
  }
fi

# ---- 这次到底要用哪个矩阵 ----
# ARM 只管正式训练；MODE=smoke 和 MODE=lambda_probe 各有自己的臂选择，所以三者分开
# 解析。缺文件要在加载模型之前就报出来，别等 GPU 排到了才失败。
case "${ARM}" in
  onereplay|ewc) SMOKE_ARM="${ARM}" ;;
  *)             SMOKE_ARM="onereplay" ;;
esac
NEEDS_COV=0
NEEDS_FISHER=0
if [[ "${MODE}" != "eval" ]]; then
  case "${MODE}" in
    lambda_probe) CHECK_ARM="${PROBE_ARM}" ;;
    smoke)        CHECK_ARM="${SMOKE_ARM}" ;;
    *)            CHECK_ARM="${ARM}" ;;
  esac
  if [[ "${CHECK_ARM}" == "onereplay" ]]; then NEEDS_COV=1; fi
  if [[ "${CHECK_ARM}" == "ewc" ]]; then NEEDS_FISHER=1; fi
fi

if (( NEEDS_COV )); then
  [[ -f "${COV_PATH}" ]] || {
    echo "缺 C_cs: ${COV_PATH}（先跑 101 号）"
    exit 1
  }
  # C 必须是在**本作业的基座**上采的。metadata 里的 model_name 是 collect_cov 的
  # --model_name，101 号传的就是 CS_RUN，所以两边应当逐字相等。
  # 这条检查挡的是最贵的错误：拿 Base 上采的 C 配 Model-CS 的 W0。
  python - "${COV_PATH}" "${CS_RUN}" "${MAXLEN}" <<'PY'
import sys

import torch

cov_path, want_model, new_task_max_len = sys.argv[1], sys.argv[2], int(sys.argv[3])
payload = torch.load(cov_path, map_location="cpu")
meta = payload.get("metadata", {})
covariances = payload["covariances"]

got_model = str(meta.get("model_name", ""))
cov_max_len = meta.get("max_len")
print("C_cs 的 metadata:")
print(f"  model_name       = {got_model}")
print(f"  pool_rows        = {meta.get('pool_rows')}")
print(f"  pool_fingerprint = {meta.get('pool_fingerprint')}")
print(f"  target_modules   = {','.join(meta.get('target_modules', []))}")
print(f"  层数             = {len(covariances)}")
# 这两个 max_len **本来就不该相等**，写出来免得后面有人当 bug 修。
# C 是旧知识（常识 QA 短序列）的隐状态二阶矩，101 号在 512 下采的（与 93 号训练一致）；
# 新任务 FLAN 在 1536 下训练。罚项只经过 ΔW 与 C 相乘，两边的序列长度不需要一致，需要
# 一致的是**模型**（上面那条检查）。
# 本线这个方向（C 的预算 < 新任务的预算）有一个只对 replay 臂成立的陷阱：replay 行不传
# --replay_max_len 会默认跟随 --max_len=1536，于是超过 512 的行多保留一段题干、复习到
# C 没编码的内容。本脚本没有 replay 臂（那是单独一个脚本，见 98 号文件头「为什么单独一个
# 文件」），但写在这里免得将来加臂时踩上。
print(f"  max_len          = {cov_max_len}  (采 C 时旧知识池的预算, 应为 512)")
print(f"  新任务 max_len   = {new_task_max_len}  (本作业训练的预算, 应为 1536；两者不必相等)")

if got_model != want_model:
    raise SystemExit(
        f"\n!! C 是在 {got_model!r} 上采的，本作业的基座是 {want_model!r}。\n"
        "罚项是 tr(ΔW C ΔWᵀ) 且 ΔW = W - W0，W0 就是基座权重，所以 C 必须和基座\n"
        "同一个模型。不一致的话隐状态分布对不上，保护会变弱且无法解释 —— 而且\n"
        "不会报错、loss 曲线也正常。\n"
        "要么重跑 101 号采对应的 C，要么把 CS_LR/CS_CKPT 指到 C 对应的那个 checkpoint。"
    )
print("\nC 与基座是同一个模型：ok")
print(f"C 常驻显存 = {sum(m.numel() for m in covariances.values()) * 4 / 1024 ** 3:.2f} GiB "
      "(fp32, move_covariances_to_device 一次性搬上去)")
PY
fi

if (( NEEDS_FISHER )); then
  [[ -f "${FISHER_PATH}" ]] || {
    echo "缺 F_cs: ${FISHER_PATH}（先跑 101 号）"
    exit 1
  }
  # 和 C 那边同一个理由：F 是 W0 处的曲率，采在别的模型上就不是这个 W0 的曲率。
  # 额外多一条：F 的池指纹必须等于 C 的。EWC 与 onereplay 的整个对照建立在"两者
  # 吃的是同一批旧知识行"之上，指纹不等的话比的就是数据而不是加权矩阵。
  python - "${FISHER_PATH}" "${CS_RUN}" "${MAXLEN}" "${COV_PATH}" <<'PY'
import sys
from pathlib import Path

import torch

fisher_path, want_model, new_task_max_len, cov_path = sys.argv[1:5]
new_task_max_len = int(new_task_max_len)
payload = torch.load(fisher_path, map_location="cpu")
meta = payload.get("metadata", {})
fishers = payload["fishers"]

got_model = str(meta.get("model_name", ""))
elements = sum(matrix.numel() for matrix in fishers.values())
print("F_cs 的 metadata:")
print(f"  model_name       = {got_model}")
print(f"  estimator        = {meta.get('estimator')}")
print(f"  num_examples (N) = {meta.get('num_examples')}")
print(f"  pool_fingerprint = {meta.get('pool_fingerprint')}")
print(f"  target_modules   = {','.join(meta.get('target_modules', []))}")
print(f"  层数             = {len(fishers)}")
print(f"  max_len          = {meta.get('max_len')}  (采 F 时旧知识池的预算)")
print(f"  新任务 max_len   = {new_task_max_len}  (本作业训练的预算；两者不必相等)")

problems = []
if got_model != want_model:
    problems.append(
        f"F 是在 {got_model!r} 上采的，本作业的基座是 {want_model!r}。\n"
        "   罚项是 sum_ij F_ij (W-W0)_ij² 且 W0 就是基座权重，所以 F 必须和基座同一个\n"
        "   模型。不一致不会报错、loss 曲线也正常，但曲率对不上，保护无法解释。"
    )
if meta.get("per_example_backward") is not True:
    problems.append(
        "per_example_backward 不是 True —— 对 batch 求和的梯度再平方算的是 (Σg)²，"
        "不是 Σg²，那不是 Fisher"
    )

# 与 C 的交叉校验。C 不在场（例如只跑 ewc 臂）就跳过，不当成错误。
if Path(cov_path).is_file():
    cov_payload = torch.load(cov_path, map_location="cpu")
    cov_meta = cov_payload.get("metadata", {})
    cov_fp = str(cov_meta.get("pool_fingerprint", ""))
    fisher_fp = str(meta.get("pool_fingerprint", ""))
    if cov_fp and cov_fp == fisher_fp:
        print(f"\nF 与 C 的池指纹一致: {cov_fp[:16]}...  ok")
    else:
        problems.append(
            f"F 的池指纹 {fisher_fp} != C 的 {cov_fp}。两者看到的不是同一批旧知识，\n"
            "   「onereplay vs EWC」就退化成「谁看到了哪些数据」的比较。"
        )
    cov_keys = set(cov_payload["covariances"])
    if cov_keys == set(fishers):
        print(f"F 与 C 的层集合一致: {len(cov_keys)} 个模块  ok")
    else:
        problems.append(
            f"F 与 C 的层集合不同（只有 C: {sorted(cov_keys - set(fishers))[:3]}，"
            f"只有 F: {sorted(set(fishers) - cov_keys)[:3]}）。"
            "两条臂必须约束同一批层。"
        )
else:
    print(f"\n（{cov_path} 不在，跳过与 C 的交叉校验）")

if problems:
    print()
    raise SystemExit("!! " + "\n!! ".join(problems))

# EWC 走的是 autograd 路径（EWCRegularizer 没有 accumulate_grad，也就没有 injects_grad），
# 所以 reg_once_per_update=1 下罚项在每个 accumulation 窗口的**第一个** micro-batch
# 上进图、backward 之后就释放。常驻的只有 F 本身和 W0 快照。
mean_f = sum(float(m.float().sum()) for m in fishers.values()) / max(elements, 1)
print(f"\nF 常驻显存 = {elements * 4 / 1024 ** 3:.2f} GiB (fp32)")
print(f"mean(F)    = {mean_f:.4e}   ->  1/mean(F) = {1.0 / max(mean_f, 1e-30):.4e}")
print("  ^ EWC 的 λ 起点。这个数和 onereplay 的 λ **不可比**，必须自己 sweep。")
PY
fi

# ---- 评测数据在**训练之前**查 ----
# 常识那八个 test.json 是本线的主指标，而它不随仓库走（LLM-Adapters 的原始文件）。放到
# eval 那一步才发现缺，意味着先白烧掉一小时训练。所以这里提前拦：只在这次真的会评测时查。
if [[ "${MODE}" == "eval" || ( "${MODE}" == "train" && "${DO_EVAL}" == "1" ) ]]; then
  if [[ "${DO_CS}" == "1" && ! -d "${CS_EVAL_DIR}" ]]; then
    echo "!! 缺常识评测数据目录: ${CS_EVAL_DIR}"
    echo "   它是本线的主指标（旧能力保留）。在有网节点上准备："
    echo "     git clone --depth 1 https://github.com/AGI-Edgerunners/LLM-Adapters"
    echo "     cp -r LLM-Adapters/dataset ${CS_EVAL_DIR}"
    echo "   布局 <dir>/<task>/test.json，八个子目录约 10MB。"
    echo "   只想训练、评测另开的话传 DO_EVAL=0（或 MODE=train,DO_CS=0）。"
    exit 1
  fi
  if [[ "${DO_IF}" == "1" && ! -f "${IFEVAL_INPUT}" ]]; then
    echo "注意：找不到 IFEval 输入 ${IFEVAL_INPUT}，新任务侧只会评 FollowBench。"
    echo "   它本来随仓库自带（third_party/instruction_following_eval/data/），先查路径。"
  fi
fi

if (( ACCUM % BATCH != 0 )); then
  echo "ACCUM=${ACCUM} 必须能被 BATCH=${BATCH} 整除"
  echo "（accumulation_steps = ACCUM // BATCH 是整除，否则「一次更新 ${ACCUM} 行」不成立）"
  exit 1
fi

echo ""
echo "========================================================================"
echo "Part 4: Model-CS --FLANv2--> Model-CS-IF   (full finetune)"
echo "  MODE / ARM     : ${MODE} / ${ARM}"
if [[ "${MODE}" == "lambda_probe" ]]; then
# probe 不看 ARM，它扫的是 PROBE_ARM。这一行免得下面的"保护"栏被读成本次扫的对象。
echo "  本次扫的臂     : PROBE_ARM=${PROBE_ARM}（ARM=${ARM} 在 probe 模式下不参与）"
fi
if [[ "${MODE}" == "smoke" ]]; then
echo "  本次冒烟的臂   : vanilla + ${SMOKE_ARM}"
fi
echo "  基座 (= W0)    : ${CS_CKPT}"
echo "  新任务池       : ${IF_DATASET}"
if [[ "${ARM}" == "onereplay" ]]; then
echo "  保护           : C_cs = ${COV_PATH}"
echo "                   λ=${LAMBDA} reg_impl=${REG_IMPL} once_per_update=${REG_ONCE}"
echo "                   normalize_by_layers=${NORMALIZE_BY_LAYERS} tf32=${REG_ALLOW_TF32}"
elif [[ "${ARM}" == "ewc" ]]; then
echo "  保护           : F_cs = ${FISHER_PATH}"
echo "                   λ=${LAMBDA} (EWC 自己的尺子，与 onereplay 的 λ 不可比)"
echo "                   once_per_update=${REG_ONCE} normalize_by_layers=${NORMALIZE_BY_LAYERS}"
echo "                   reg_impl 不适用：EWC 只有 autograd 路径"
elif [[ "${ARM}" == "vanilla" ]]; then
echo "  保护           : 无（--replay_lambda 0 --measure_replay_when_lambda_zero 0）"
echo "                   这条臂是遗忘的标尺，onereplay 的结论离不开它"
else
echo "  保护           : 不适用（anchor 只评测 Stage 2 的起点，不训练）"
fi
echo "  超参           : epochs=${EPOCHS} lr=${LR} batch=${BATCH} accum=${ACCUM} maxlen=${MAXLEN}"
echo "  评测           : cs=${DO_CS} (commonsense_qa 旧能力保留, tasks=${CS_EVAL_TASKS:-<全部八个>})"
echo "                   scoring=${CS_SCORING} 主口径 acc_logprob; acc_gen 只配 parse_rate 读"
echo "                   if=${DO_IF} (ifeval+followbench 新任务, **不评 ifbench**)"
echo "  run 名         : ${RUN}"
echo "  checkpoint     : ${CKPT}"
echo "  结果树         : ${RESULTS_ROOT}"
echo "========================================================================"
if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只做前置检查，不训练不评测。"
  echo "Job finished at: $(date)"
  exit 0
fi
# =============================================================================
# 共用训练封装
#
# 两条臂的唯一差别是最后那三行正则参数，其余逐字相同 —— 这是「只改一个变量」的
# 工程实现。vanilla 必须传 --measure_replay_when_lambda_zero 0：只传 λ=0 的话
# build_regularizer 仍会加载 C 并每步求值（默认 measure=1），那测出来的时间和显存
# 就不是 vanilla 的了（train.py 里有一段专门 warn 这件事）。
#
#   $1 run  $2 arm  $3 epochs  $4 lambda  $5 save_path  $6 max_steps  $7 save  $8 log_every
# =============================================================================
train_one () {
  local run="$1" arm="$2" epochs="$3" lam="$4" save_path="$5"
  local max_steps="${6:-0}" do_save="${7:-1}" log_every="${8:-${LOG_EVERY}}"

  local -a reg_args=()
  case "${arm}" in
    onereplay)
      reg_args=(
        --regularizer onereplay
        --cov_path "${COV_PATH}"
        --replay_lambda "${lam}"
        --identity_cov 0
        --reg_impl "${REG_IMPL}"
        --reg_once_per_update "${REG_ONCE}"
        --reg_allow_tf32 "${REG_ALLOW_TF32}"
        --normalize_replay_by_layers "${NORMALIZE_BY_LAYERS}"
      )
      ;;
    ewc)
      # 与 onereplay 只差加权矩阵：F 的对角经验 Fisher 换掉 C，罚项从
      # tr(ΔW C ΔWᵀ) 变成 sum_ij F_ij ΔW_ij²。其余训练参数逐字相同。
      #
      # 刻意**不传** --reg_impl / --reg_allow_tf32：EWCRegularizer 没有
      # accumulate_grad，analytic 路径对它不存在（那条路是给 C 的矩阵乘写的），
      # 传了会被静默忽略，反而让日志看起来像开了 analytic。EWC 只有 autograd。
      # --identity_cov 也不能传 1：train.py 会直接报错（它是 C 那条路的 L2 对照）。
      reg_args=(
        --regularizer ewc
        --fisher_path "${FISHER_PATH}"
        --replay_lambda "${lam}"
        --reg_once_per_update "${REG_ONCE}"
        --normalize_replay_by_layers "${NORMALIZE_BY_LAYERS}"
      )
      ;;
    vanilla)
      reg_args=(--replay_lambda 0 --measure_replay_when_lambda_zero 0)
      ;;
    *)
      echo "train_one 不支持 arm=${arm}"; return 1
      ;;
  esac

  mkdir -p "${RESULTS_ROOT}/map_cache/${run}"
  echo "==== train ${run} (arm=${arm} lr=${LR} lam=${lam} max_steps=${max_steps}) ===="
  python -m onereplay.scripts.train --paradigm sft --full_finetune 1 \
    --model_dir "${CS_CKPT_DIR}" --model_name "${CS_RUN}" --seed "${SEED}" \
    --dataset_path "${IF_DATASET}" \
    --epochs "${epochs}" --lr "${LR}" \
    --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
    --max_len "${MAXLEN}" \
    --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" \
    --eval_batch_size "${BATCH}" \
    --max_train_samples "${MAX_TRAIN_SAMPLES}" \
    --target_modules "${TARGET_MODULES}" \
    --map_cache_dir "${RESULTS_ROOT}/map_cache/${run}" \
    "${reg_args[@]}" \
    --max_steps "${max_steps}" --log_every "${log_every}" \
    --save "${do_save}" --save_path "${save_path}" \
    --metrics_path "${METRICS_DIR}/${run}.jsonl"
}

# =============================================================================
# MODE=smoke：两条臂各跑几十步、不保存。这一步要盯三件事：
#
#   1) 「regularizer covers N layers; no penalty matrix for M layers」
#      N 必须是 C 的层数（full scope 是 197），**M 必须是 0**。M 非 0 说明 C 的键
#      和模型的模块名对不上，罚项在偷偷少覆盖几层，而这不会报错。
#   2) peak memory。文件头给的是加数（C_cs 6.58 + W0 3.2 + analytic 约 1.2），
#      vanilla 基线要靠这里的实测值，94 号没记这个数。
#   3) 两条臂的 tokens_per_sec 应当基本相同（正则只占约 3% 的计算，见文件头）。
#      差很多就是显存压力导致的分配器抖动，不是正则本身贵。
# =============================================================================
if [[ "${MODE}" == "smoke" ]]; then
  # SMOKE_ARM 跟着 ARM：ARM=ewc 时冒烟的是 vanilla + ewc。EWC 走 autograd（没有
  # analytic 路径），显存曲线和 onereplay 不是一回事，所以那条臂**必须自己冒烟一次**，
  # 不能拿 onereplay 的 peak memory 代替。
  echo "冒烟臂: vanilla + ${SMOKE_ARM}"
  train_one "smoke_p4_vanilla" vanilla 1 0 "${CKPT_DIR}/smoke_p4_vanilla" \
    "${SMOKE_STEPS}" 0 10
  train_one "smoke_p4_${SMOKE_ARM}" "${SMOKE_ARM}" 1 "${LAMBDA}" \
    "${CKPT_DIR}/smoke_p4_${SMOKE_ARM}" "${SMOKE_STEPS}" 0 10

  echo ""
  echo "==== 冒烟自检 ===="
  python - "${METRICS_DIR}/smoke_p4_vanilla.jsonl" "${METRICS_DIR}/smoke_p4_${SMOKE_ARM}.jsonl" \
    "${SMOKE_ARM}" <<'PY'
import json
import sys


def last_epoch(path):
    rows = []
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if line:
                    row = json.loads(line)
                    if row.get("record_type") == "epoch":
                        rows.append(row)
    except FileNotFoundError:
        return None
    return rows[-1] if rows else None


vanilla, protected = (last_epoch(path) for path in sys.argv[1:3])
arm = sys.argv[3]
if vanilla is None or protected is None:
    raise SystemExit("缺 metrics，冒烟没跑完")

print(f"{'':<26}{'vanilla':>16}{arm:>16}")
for key, label, fmt in (
    ("train_task_loss", "task_loss", "{:.6f}"),
    ("train_replay_reg", "R (未乘 λ)", "{:.4e}"),
    ("train_lambda_reg", "λ·R", "{:.4e}"),
    ("tokens_per_sec", "tokens/s", "{:.0f}"),
    ("covariance_memory_gb", "罚项矩阵常驻 GiB", "{:.2f}"),
    ("reference_memory_gb", "W0 常驻 GiB", "{:.2f}"),
):
    def cell(row):
        value = row.get(key)
        return (fmt.format(value) if isinstance(value, (int, float)) else "-").rjust(16)
    print(f"{label:<26}{cell(vanilla)}{cell(protected)}")

peak_keys = [k for k in protected if "peak" in k and "memory" in k]
for key in sorted(peak_keys):
    print(f"{key:<26}{str(vanilla.get(key, '-')):>16}{str(protected.get(key, '-')):>16}")
if arm == "ewc":
    print()
    print("EWC 走 autograd：罚项在每个 accumulation 窗口的第一个 micro-batch 上进图，")
    print("backward 之后释放。峰值应当比 onereplay(analytic) 高一些——那条路按层转 fp32，")
    print("这条路整轮持有。高多少看上面的实测，别按估计值排作业。")

ratio = None
task = protected.get("train_task_loss")
lam_reg = protected.get("train_lambda_reg")
if task and lam_reg:
    ratio = lam_reg / task
    print(f"\nλ·R / task_loss = {ratio:.4f}")
    if ratio < 0.01:
        print("  -> 罚项不到任务损失的 1%，λ 大概偏小（几乎等于没开保护）")
    elif ratio > 0.5:
        print("  -> 罚项超过任务损失的一半，λ 大概偏大（会明显牺牲新任务）")
    else:
        print("  -> 量级合理，可以从这个 λ 附近开 grid")

speed = None
if vanilla.get("tokens_per_sec") and protected.get("tokens_per_sec"):
    speed = protected["tokens_per_sec"] / vanilla["tokens_per_sec"]
    print(f"{arm} / vanilla 吞吐比 = {speed:.3f}")
    if speed < 0.9:
        print("  -> 慢了 10% 以上。正则本身只占约 3% 计算，先怀疑显存压力。")
PY
  echo ""
  echo "还要回到上面的训练日志里人工确认一行:"
  echo "  regularizer covers <N> layers; no penalty matrix for <M> layers"
  echo "  N 必须等于罚项矩阵的层数，**M 必须是 0**。M 非 0 = 矩阵的键与模型模块名对不上。"
  exit 0
fi

# =============================================================================
# MODE=lambda_probe：选 λ 的第一步
#
# 只回答一个问题：**λ·R 和 task_loss 差几个数量级。** 不回答「哪个 λ 更好」——
# 那要跑完整训练看 IF 分数和 val_loss。
#
# 为什么不能照搬历史 λ：约束强度 ∝ λ·trace(C)，但罚项要和任务损失比才有意义，而
# 本线的新任务是 FLANv2 @ 1536 的短答案（P50 约 18 token）。44 号那个 7.5e-3 是在
# **新任务** = Commonsense @ 512 上定的（和本线的方向正好相反），96 号那套是在
# OpenR1 @ 8192 上定的，task_loss 的绝对尺度都和这里不同。
#
# 唯一可以搬的是 Part 3：新任务与本线完全相同，所以 λ_part3 · trace(C_math)/trace(C_cs)
# 是一个有效起点（101 号 Step 2 会算这个数）。把它当 grid 中心传进 LAMBDA_GRID，这一步
# 就只是确认而不是搜索了 —— 但**别省掉这一步**，两条线的 W0 不同，ΔW 的早期增长速度
# 不必相同。
#
# PROBE_MAX_STEPS 数的是 micro-batch，更新次数要除以 ACCUM/BATCH=64。默认 1280 步
# = 20 次更新。这对量级判断够了（R 从 0 开始长，前几次更新就到稳定量级），但**不足以
# 判断谁的 val_loss 更低** —— 别拿这里的 val_loss 排序做决定。
#
# -----------------------------------------------------------------------------
# 【PROBE_ARM：两条臂的 λ 必须各标一次】
#
# λ·R 要落在 task_loss 的 1%~10%，这个判据对两条臂是同一个。但达到它的 λ 数值不是
# 同一个量级，因为 R 的定义不同：
#     onereplay  R = tr(ΔW C ΔWᵀ)，C 是激活的二阶矩 E[x xᵀ]
#     ewc        R = Σ F_ij ΔW_ij²，F 是逐参数梯度平方的均值
# F 的元素普遍是很小的数（mean(F) 常在 1e-8 量级），所以 λ_ewc 的起点是 1/mean(F)，
# 可能是 1e7 这种数。把 onereplay 的 7.5e-3 套到 ewc 上等于没开保护，反之等于不学
# 新任务 —— 两种错误都要烧掉一个 24h 作业才看得见，所以脚本强制 ARM=ewc 显式传 λ。
#
# PROBE_ARM=ewc 时若没传 LAMBDA_GRID，下面会读 F 文件现算 1/mean(F)，按
# EWC_GRID_MULTIPLIERS 展开成三档。这样 grid 中心来自数据本身，不是猜的。
# =============================================================================
if [[ "${MODE}" == "lambda_probe" ]]; then
  case "${PROBE_ARM}" in
    onereplay|ewc) : ;;
    *) echo "PROBE_ARM=${PROBE_ARM} 无效，可选 onereplay / ewc"; exit 1 ;;
  esac

  # ---- grid：用户给了就用，没给按臂生成 ----
  if [[ -z "${LAMBDA_GRID}" ]]; then
    if [[ "${PROBE_ARM}" == "onereplay" ]]; then
      LAMBDA_GRID="${LAMBDA_GRID_ONEREPLAY}"
      echo "LAMBDA_GRID 未指定，用 onereplay 的默认三档（来自 44 号，只是起点）"
    else
      echo "LAMBDA_GRID 未指定，按 1/mean(F) x {${EWC_GRID_MULTIPLIERS}} 现算"
      LAMBDA_GRID="$(python - "${FISHER_PATH}" "${EWC_GRID_MULTIPLIERS}" <<'PY'
import sys

import torch

payload = torch.load(sys.argv[1], map_location="cpu")
fishers = payload["fishers"]
total = sum(float(matrix.float().sum()) for matrix in fishers.values())
elements = sum(matrix.numel() for matrix in fishers.values())
mean_f = total / max(elements, 1)
if mean_f <= 0:
    raise SystemExit("mean(F) <= 0，F 文件不对（全零？先看 99 号的诊断）")
center = 1.0 / mean_f
# 1/mean(F) 让 Σ F ΔW² 的量级回到 ΣΔW² 附近，也就是把 EWC 摆到"和 L2 同量级"的
# 起点上。它只是个有依据的起点，不是答案——落到 1%~10% 区间靠下面那张表。
# 打到 stderr：stdout 要原样当 grid 用，多一个字都会进 for 循环。
print(f"mean(F)={mean_f:.6e}  1/mean(F)={center:.6e}", file=sys.stderr)
print(" ".join(f"{center * float(m):.4e}" for m in sys.argv[2].split()))
PY
)"
    fi
  fi
  echo "PROBE_ARM=${PROBE_ARM}  grid=${LAMBDA_GRID}"
  echo "每档 ${PROBE_MAX_STEPS} micro-batch = $(( PROBE_MAX_STEPS / (ACCUM / BATCH) )) 次优化器更新 = $(( PROBE_MAX_STEPS * BATCH )) 行"
  if [[ "${PROBE_VANILLA}" == "1" ]]; then
    echo "先跑一档 vanilla 当同步长下的 λ=0 参照"
    train_one "probe_p4_vanilla" vanilla 1 0 "${CKPT_DIR}/probe_p4_vanilla" \
      "${PROBE_MAX_STEPS}" 0 "${PROBE_LOG_EVERY}"
  else
    echo "PROBE_VANILLA=0：跳过 probe 里的 λ=0 那一档。"
    echo "选 λ 的 λ·R/task_loss 比值只用 ${PROBE_ARM} 臂自己的数，不需要它。"
    echo "但 calibrate_lambda 的 floor 必须是**完整 EPOCHS** 的 vanilla run，别拿这条顶替。"
  fi
  for lam in ${LAMBDA_GRID}; do
    train_one "probe_p4_${PROBE_ARM}_lam${lam}" "${PROBE_ARM}" 1 "${lam}" \
      "${CKPT_DIR}/probe_p4_${PROBE_ARM}_lam${lam}" "${PROBE_MAX_STEPS}" 0 "${PROBE_LOG_EVERY}"
  done

  echo ""
  echo "==== λ probe 汇总（${PROBE_MAX_STEPS} micro-batch = $(( PROBE_MAX_STEPS / (ACCUM / BATCH) )) 次更新）===="
  python - "${METRICS_DIR}" "${LAMBDA_GRID}" "${PROBE_ARM}" <<'PY'
import json
import sys
from pathlib import Path

metrics_dir = Path(sys.argv[1])
grid = sys.argv[2].split()
arm = sys.argv[3]


def last_epoch(path: Path):
    if not path.is_file():
        return None
    rows = [
        json.loads(line)
        for line in path.read_text(encoding="utf-8").splitlines()
        if line.strip()
    ]
    rows = [row for row in rows if row.get("record_type") == "epoch"]
    return rows[-1] if rows else None


floor = last_epoch(metrics_dir / "probe_p4_vanilla.jsonl")
floor_loss = floor.get("train_task_loss") if floor else None
floor_val = floor.get("val_loss") if floor else None

print(f"{'lambda':>10}{'task_loss':>13}{'R':>13}{'λ·R':>13}{'λ·R/task':>11}{'val_loss':>11}")
if floor is not None:
    print(f"{'0 (vanilla)':>10}{floor_loss:>13.6f}{'-':>13}{'-':>13}{'-':>11}"
          + (f"{floor_val:>11.6f}" if floor_val is not None else f"{'-':>11}"))

rows = []
for lam in grid:
    record = last_epoch(metrics_dir / f"probe_p4_{arm}_lam{lam}.jsonl")
    if record is None:
        print(f"{lam:>10}{'  (缺 metrics)':<40}")
        continue
    task = record.get("train_task_loss")
    reg = record.get("train_replay_reg")
    lam_reg = record.get("train_lambda_reg")
    val = record.get("val_loss")
    ratio = (lam_reg / task) if (task and lam_reg) else None
    rows.append((lam, ratio))
    print(
        f"{lam:>10}{task:>13.6f}"
        + (f"{reg:>13.4e}" if reg is not None else f"{'-':>13}")
        + (f"{lam_reg:>13.4e}" if lam_reg is not None else f"{'-':>13}")
        + (f"{ratio:>11.4f}" if ratio is not None else f"{'-':>11}")
        + (f"{val:>11.6f}" if val is not None else f"{'-':>11}")
    )

print()
print("怎么读这张表:")
print("  * R 那一列在各档之间应当接近（同样 20 次更新、同样的数据，ΔW 的量级相仿），")
print("    λ·R 主要随 λ 线性变。R 差很多说明大 λ 已经明显改变了轨迹。")
print("  * 选 λ·R/task 落在 0.01~0.10 的那一档当 grid 中心：罚项要能改变优化方向")
print("    （太小等于没开保护），又不能盖住任务信号（太大等于不学新任务）。")
inside = [lam for lam, ratio in rows if ratio is not None and 0.01 <= ratio <= 0.10]
if inside:
    print(f"  * 本次落在该区间的: {' '.join(inside)}")
else:
    print("  * 本次没有一档落在该区间，按比值线性外推调整 grid 再跑一次（λ·R ∝ λ）。")
print()
print("**这张表不决定最终 λ。** 20 次更新的 val_loss 没有判别力，别用它排序。定稿要:")
print("  1) 选出的 λ 跑完整 EPOCHS，和 vanilla 比常识 AVERAGE（这才是保留能力的证据）")
print(f"       qsub -v MODE=train,ARM={arm},LAMBDA=<选出的值>,DO_IF=0 <本脚本>")
print("  2) 报结果时用 matched plasticity —— 各臂在同一个新任务 val_loss 上比:")
print("       python -m onereplay.scripts.calibrate_lambda \\")
print("         --results_root <RESULTS_ROOT> \\")
print(f"         --pattern 'part4_if_{arm}_lr*_lam*_seed1' \\")
print("         --floor_run part4_if_vanilla_lr<LR>_seed1 --target <vanilla val_loss>")
if arm == "ewc":
    print()
    print("注意：onereplay 与 ewc 各自标定出的 λ 之间**没有可比性**，不要因为一个是")
    print("1e7、一个是 1e-2 就觉得哪条臂更强。可比的是两者在同一个 val_loss 上")
    print("（matched plasticity）各保住了多少常识准确率。")
PY
  exit 0
fi

# =============================================================================
# MODE=train：正式训练
# =============================================================================
if [[ "${MODE}" == "train" && "${DO_TRAIN}" == "1" ]]; then
  if [[ "${ARM}" == "anchor" ]]; then
    echo "ARM=anchor 不训练（它就是 Stage 2 的起点 Model-CS）。用 MODE=eval 评它。"
  elif [[ -d "${CKPT}" && "${FORCE_TRAIN}" != "1" ]]; then
    echo "跳过训练：${CKPT} 已存在（FORCE_TRAIN=1 可强制重训）"
  else
    train_one "${RUN}" "${ARM}" "${EPOCHS}" "${LAMBDA}" "${CKPT}" 0 1

    echo ""
    echo "==== 训练自检: ${RUN} ===="
    python - "${METRICS_DIR}/${RUN}.jsonl" "${ARM}" "${LAMBDA}" "${ACCUM}" <<'PY'
import json
import sys

path, arm, want_lambda, want_accum = sys.argv[1], sys.argv[2], float(sys.argv[3]), int(sys.argv[4])
rows = [
    json.loads(line)
    for line in open(path, encoding="utf-8").read().splitlines()
    if line.strip()
]
epochs = [row for row in rows if row.get("record_type") == "epoch"]
if not epochs:
    raise SystemExit(f"{path} 里没有 epoch 记录，训练没跑完")

problems = []
last = epochs[-1]
print(f"{'epoch':>6}{'task_loss':>13}{'val_loss':>12}{'R':>13}{'λ·R':>13}{'tok/s':>10}")
for row in epochs:
    print(
        f"{row['epoch']:>6}{row['train_task_loss']:>13.6f}"
        + (f"{row['val_loss']:>12.6f}" if row.get("val_loss") is not None else f"{'-':>12}")
        + (f"{row['train_replay_reg']:>13.4e}" if row.get("train_replay_reg") else f"{'-':>13}")
        + (f"{row['train_lambda_reg']:>13.4e}" if row.get("train_lambda_reg") else f"{'-':>13}")
        + f"{row.get('tokens_per_sec', 0):>10.0f}"
    )

got_lambda = last.get("replay_lambda")
if arm == "onereplay":
    if got_lambda != want_lambda:
        problems.append(f"metrics 里的 replay_lambda={got_lambda} != 传入的 {want_lambda}")
    if not last.get("train_replay_reg"):
        problems.append(
            "train_replay_reg 是 0 或缺失 —— 罚项没有真的在算。"
            "检查 --cov_path 是否被加载（日志里应有 'loaded N covariance matrices'）"
        )
    if not last.get("reference_memory_gb"):
        problems.append(
            "reference_memory_gb 是 0 —— W0 快照没建，全量微调的 ΔW 无从算起。"
            "日志里应有 'full finetune: froze W0 for N layers'"
        )
elif arm == "vanilla":
    if got_lambda:
        problems.append(f"vanilla 臂的 replay_lambda 应当是 0，实际 {got_lambda}")
    if last.get("covariance_memory_gb"):
        problems.append(
            f"vanilla 臂却常驻了 {last['covariance_memory_gb']:.2f} GiB 的 C —— "
            "--measure_replay_when_lambda_zero 0 没生效，这条臂的时间和显存不是 vanilla 的"
        )

print()
if problems:
    for item in problems:
        print(f"!! {item}")
    raise SystemExit("训练自检未通过")
print("训练自检通过。")
PY
  fi
  echo ""
  echo "checkpoint 是完整权重目录，可以直接当下一阶段的基座："
  echo "  --model_dir ${CKPT_DIR} --model_name ${RUN}"
fi
# =============================================================================
# MODE=eval：旧能力保留 (commonsense_qa 八个测试集) 与新任务 (IFEval + FollowBench)
#
# 一次 evaluate 调用只加载模型一次，请求的指标共用。DO_CS / DO_IF 把两半拆到不同作业。
# 本线的贵/便宜和 100 号相反：常识保留侧 1-1.5h（22.4k 行短序列，logprob 那一路是每个
# (行, 候选) 一次前向、约 7.6 万次），IF 新任务侧 3-4h。所以推荐「训练 + DO_CS」一个
# 作业、DO_IF 另开。
#
# 全量 checkpoint 直接传 --adapter_path：runner 的 load_eval_model 先用
# is_lora_adapter_dir 判断，没有 adapter_config.json 就把该目录当完整模型加载。
# ARM=anchor 时 --adapter_path 指向 Stage 1 的 checkpoint，评的就是 Stage 2 的起点。
# =============================================================================
if [[ "${MODE}" == "eval" || ( "${MODE}" == "train" && "${DO_EVAL}" == "1" ) ]]; then
  METRICS=""
  if [[ "${DO_CS}" == "1" ]]; then
    # 八个测试集是 LLM-Adapters 的原始 test.json，仓库里没有，必须在有网节点上先备好。
    # 缺了直接退出而不是跳过：这是本作业的**主指标**，静默跳过等于白跑一个作业。
    if [[ -d "${CS_EVAL_DIR}" ]]; then
      METRICS="${METRICS},commonsense_qa"
    else
      echo "!! 缺常识评测数据目录: ${CS_EVAL_DIR}"
      echo "   它是本线的主指标（旧能力保留），不能跳过。在有网节点上准备："
      echo "     git clone --depth 1 https://github.com/AGI-Edgerunners/LLM-Adapters"
      echo "     cp -r LLM-Adapters/dataset ${CS_EVAL_DIR}"
      echo "   布局 <dir>/<task>/test.json，八个子目录约 10MB。只评新任务请传 DO_CS=0。"
      exit 1
    fi
  fi
  if [[ "${DO_IF}" == "1" ]]; then
    if [[ -f "${IFEVAL_INPUT}" ]]; then
      METRICS="${METRICS},ifeval"
    else
      echo "跳过 IFEval：未找到 ${IFEVAL_INPUT}"
    fi
    # FollowBench 的数据和判分器完全 vendored，没有可检查的前置文件。
    METRICS="${METRICS},followbench"
  fi
  METRICS="${METRICS#,}"
  [[ -n "${METRICS}" ]] || { echo "没有可用指标（DO_CS/DO_IF 都关了？），评测退出"; exit 1; }

  if [[ "${FB_GROUP_LIMIT}" != "0" ]]; then
    echo "!! FB_GROUP_LIMIT=${FB_GROUP_LIMIT}：FollowBench 冒烟模式，产出的 summary 只覆盖每类前"
    echo "   ${FB_GROUP_LIMIT} 组，不是正式结果。"
  fi
  if [[ "${EVAL_LIMIT}" != "0" ]]; then
    echo "!! EVAL_LIMIT=${EVAL_LIMIT} 截的是 ifeval 和 commonsense_qa（后者是**每个 task** 截前"
    echo "   ${EVAL_LIMIT} 行，metric 里是 cs_limit or limit）。截过的 AVERAGE 不是正式结果。"
    if [[ "${METRICS}" == *followbench* ]]; then
      echo "   FollowBench 不读全局 --limit，要截它请用 FB_GROUP_LIMIT（按阶梯组，不能按行 ——"
      echo "   CSL 的分母假设一组完整的 L1..L5）。"
    fi
  fi
  if [[ -n "${CS_EVAL_TASKS}" && "${METRICS}" == *commonsense_qa* ]]; then
    echo "!! CS_EVAL_TASKS=${CS_EVAL_TASKS}：只评这几个子集。AVERAGE 是**宏平均**，子集不同的两个"
    echo "   run 之间那一列不可比，正式结果必须八个全跑。"
  fi

  run_eval () {
    local name="$1" ckpt="$2"
    local -a ckpt_arg=()
    if [[ -n "${ckpt}" ]]; then ckpt_arg=(--adapter_path "${ckpt}"); fi

    # 只有请求的指标**全部**已有结果才跳过，否则拆开跑时第二批会被第一批挡掉。
    local pending=0 m
    for m in ${METRICS//,/ }; do
      if [[ ! -f "${RESULTS_ROOT}/${m}/${name}/summary.json" ]]; then
        pending=1
      fi
    done
    if [[ "${pending}" == "0" && "${FORCE_EVAL}" != "1" ]]; then
      echo "跳过评测 ${name}：${METRICS} 都已有 summary（FORCE_EVAL=1 强制重评）"
      return 0
    fi

    local -a fb_data_arg=() fb_cats_arg=()
    if [[ -n "${FB_DATA}" ]]; then fb_data_arg=(--followbench_data "${FB_DATA}"); fi
    if [[ -n "${FB_CATEGORIES}" ]]; then fb_cats_arg=(--followbench_categories "${FB_CATEGORIES}"); fi

    echo "==== eval ${name} (${METRICS}) ===="
    python -m onereplay.scripts.evaluate \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
      "${ckpt_arg[@]}" --run_name "${name}" \
      --metrics "${METRICS}" --out_dir "${RESULTS_ROOT}" --seed "${SEED}" \
      --limit "${EVAL_LIMIT}" \
      --max_new_tokens "${MAX_NEW_TOKENS}" \
      --eval_batch_size "${EVAL_BATCH}" \
      --cs_eval_dir "${CS_EVAL_DIR}" \
      --cs_eval_tasks "${CS_EVAL_TASKS}" \
      --cs_scoring "${CS_SCORING}" \
      --cs_max_new_tokens "${CS_MAX_NEW_TOKENS}" \
      --cs_batch_size "${CS_BATCH}" \
      --cs_score_batch_size "${CS_SCORE_BATCH}" \
      --ifeval_input "${IFEVAL_INPUT}" \
      --followbench_max_new_tokens "${FB_MAX_NEW_TOKENS}" \
      --followbench_batch_size "${FB_BATCH}" \
      --followbench_group_limit "${FB_GROUP_LIMIT}" \
      "${fb_data_arg[@]}" "${fb_cats_arg[@]}" \
      --map_cache_dir "${RESULTS_ROOT}/map_cache/eval_seed${SEED}"
  }

  case "${ARM}" in
    anchor)
      # Stage 2 的起点 Model-CS。93 号已经评过它的 commonsense_qa，但那些结果落在
      # results_part1_cs 的树里；重评一次是为了让 Part 4 的表自成一体，而且 93 号
      # 根本没评过它的 IFEval/FollowBench（Part 1 的 CS 线不测 IF）。
      # 两次的分数应当逐字相同（同 checkpoint、同 greedy 解码、同 batch）—— 不同就说明
      # 有个口径变了（CS_BATCH / CS_MAX_NEW_TOKENS / 评测集版本），值得先查清楚。
      run_eval "cs_anchor" "${CS_CKPT}"
      ;;
    *)
      if [[ -d "${CKPT}" ]]; then
        run_eval "${RUN}" "${CKPT}"
      else
        echo "跳过 ${RUN}：checkpoint 不存在（先跑 MODE=train,ARM=${ARM}）"
      fi
      ;;
  esac

  # -------------------------------------------------------------------------
  # 常识侧诊断：分辨「忘了常识」「忘了格式」「塌成猜一个词」三件事。
  #
  # 100 号那个 hit-cap 诊断在本线没有对应物 —— 主口径 acc_logprob 不解码，没有右删失
  # 可言。这里查的是本线特有的三种误读，逐 task 打，因为候选集大小和塌缩程度按 task 差
  # 很多（boolq 只有 true/false，hellaswag 有四个 ending）：
  #
  #   parse_rate 掉 + logprob 没掉  -> 忘的是**格式**不是常识。FLAN 把输出推长推杂，
  #                                    extract_label 抽不到那个 label。acc_gen 的下降
  #                                    不能当遗忘证据。
  #   agree（logprob 与 gen 一致率）-> 两个 scorer 在多少行上给出同一个 label。它掉说明
  #                                    生成路径开始答非所问，而排序路径还知道答案。
  #   mode share（众数占比）        -> 接近 1 = 预测塌成单一 label，模型在猜不在答。这种
  #                                    模型的 acc 会停在 random_baseline 附近而不是 0，
  #                                    不看这一列会把「塌了」读成「还剩一半能力」。
  #   hit-cap                       -> 撞 CS_MAX_NEW_TOKENS 的行。答案只要 7-8 个 token，
  #                                    撞上限说明模型在滔滔不绝，本身就是格式漂移的证据。
  # -------------------------------------------------------------------------
  if [[ "${DIAG_LEN}" == "1" && "${DO_CS}" == "1" ]]; then
    if [[ "${ARM}" == "anchor" ]]; then DIAG_NAME="cs_anchor"; else DIAG_NAME="${RUN}"; fi
    DIAG_FILE="${RESULTS_ROOT}/commonsense_qa/${DIAG_NAME}/responses.jsonl"
    if [[ -f "${DIAG_FILE}" ]]; then
      python - "${MODEL_DIR}/${MODEL_NAME}" "${CS_MAX_NEW_TOKENS}" "${DIAG_FILE}" <<'PY'
import collections
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

model_path, cap, path = sys.argv[1], int(sys.argv[2]), Path(sys.argv[3])
tokenizer = AutoTokenizer.from_pretrained(model_path, trust_remote_code=True)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


by_task: dict[str, list[dict]] = collections.defaultdict(list)
with path.open(encoding="utf-8") as handle:
    for line in handle:
        if line.strip():
            row = json.loads(line)
            by_task[str(row.get("task", "?"))].append(row)

print(f"==== commonsense 生成侧诊断 (cap={cap})  {path.parent.name} ====")
print(
    f"{'task':<16}{'n':>6}{'parse':>8}{'agree':>8}{'mode':>8}"
    f"{'mode_lbl':>11}{'hit-cap':>9}{'tokP50':>8}{'tokP90':>8}{'max':>6}"
)
for task in sorted(by_task):
    rows = by_task[task]
    total = len(rows)
    # gen 那一路关掉时 responses.jsonl 里没有 response/gen_pred 字段，这几列打 '-'。
    has_gen = "gen_pred" in rows[0]
    has_logprob = "logprob_pred" in rows[0]

    if has_gen:
        lengths = sorted(
            len(tokenizer(str(row.get("response", "")), add_special_tokens=False)["input_ids"])
            for row in rows
        )
        parsed = sum(1 for row in rows if row.get("gen_pred"))
        hit_cap = sum(1 for length in lengths if length >= cap - 2)
        parse_cell = f"{parsed / total:.3f}".rjust(8)
        cap_cell = f"{hit_cap / total:.1%}".rjust(9)
        len_cells = f"{pct(lengths, 50):>8}{pct(lengths, 90):>8}{lengths[-1]:>6}"
    else:
        parse_cell, cap_cell = "-".rjust(8), "-".rjust(9)
        len_cells = f"{'-':>8}{'-':>8}{'-':>6}"

    if has_gen and has_logprob:
        both = [row for row in rows if row.get("gen_pred")]
        agree = sum(1 for row in both if row["gen_pred"] == row["logprob_pred"])
        agree_cell = (f"{agree / len(both):.3f}" if both else "-").rjust(8)
    else:
        agree_cell = "-".rjust(8)

    # 众数按主口径的预测算（logprob 没跑就退回 gen）。
    key = "logprob_pred" if has_logprob else ("gen_pred" if has_gen else None)
    if key:
        counts = collections.Counter(str(row.get(key, "")) for row in rows)
        label, count = counts.most_common(1)[0]
        mode_cell = f"{count / total:.3f}".rjust(8)
        mode_label = (label or "<empty>")[:10].rjust(11)
    else:
        mode_cell, mode_label = "-".rjust(8), "-".rjust(11)

    print(f"{task:<16}{total:>6}{parse_cell}{agree_cell}{mode_cell}{mode_label}{cap_cell}{len_cells}")

print()
print("怎么读:")
print("  parse 掉而 summary 里的 acc_logprob 没掉 => 忘的是**格式**不是常识。这正是本线")
print("    预期会发生的事（FLAN 把输出从 7 个 token 推到 18-19 个），所以主口径是 logprob。")
print("  mode 接近 1 => 预测塌成单一 label（mode_lbl 那一列就是它）。这种模型的 acc 会停在")
print("    random_baseline 附近而不是 0，只看 acc 会把「塌了」读成「还剩一半能力」。")
print("  agree 明显低于 1 => 两个 scorer 分道扬镳，生成路径已经不在答这道题了。")
print("  hit-cap 非零 => 答案只要 7-8 个 token 却撞上 cap，模型在滔滔不绝。**不要**因此调大")
print("    CS_MAX_NEW_TOKENS：那是格式漂移的证据，不是预算不够；调了还得所有臂一起重评。")
PY
    fi
  fi

  # -------------------------------------------------------------------------
  # 汇总：两张表。
  #
  # 第一张是主表：左半旧能力保留（常识），右半新任务（IF），**每个生成式分数右边紧跟它
  # 自己的响应词数中位数**。acc_logprob 是唯一不需要配 words 读的数（闭集排序、不解码），
  # 其余每一个都要 —— Stage 1 的 Model-CS 只输出 7 个 token，Stage 2 的 FLAN targets
  # P50 是 18-19，长度往变长方向漂，而 IFEval/FollowBench 里不少约束本质在量长度
  # （Part 1 第 8c 节）、acc_gen 更是直接受害。
  #
  # 第二张是常识八个子任务的 acc_logprob 分解。宏平均会把「某一个子任务塌了」摊平，而
  # 遗忘往往不是均匀的 —— 哪个子任务先塌是这条线能给出的一个额外发现，所以单独列一张。
  #
  # words 用 len(response.split()) 从各自的 responses.jsonl 现算，与 followbench 的
  # response_shape 同一个定义，所以 fb 那列和它 summary.json 里的 response_words_p50 一致。
  # -------------------------------------------------------------------------
  python - "${RESULTS_ROOT}" <<'PY' || true
import json
from pathlib import Path
import sys

root = Path(sys.argv[1])
METRICS = ("commonsense_qa", "ifeval", "followbench")

names: set[str] = set()
for metric in METRICS:
    directory = root / metric
    if directory.is_dir():
        names.update(path.name for path in directory.iterdir() if path.is_dir())
if not names:
    print("\n没有可汇总的 summary.json")
    raise SystemExit(0)


def sort_key(name: str):
    # anchor 在最上面（它是 before 那一行），然后 vanilla，然后 onereplay 按 λ 排。
    rank = 0 if name == "cs_anchor" else (1 if "vanilla" in name else 2)
    return (rank, name)


order = sorted(names, key=sort_key)


def load(metric: str, name: str):
    path = root / metric / name / "summary.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else None


def words_p50(metric: str, name: str):
    path = root / metric / name / "responses.jsonl"
    if not path.is_file():
        return None
    counts = []
    with path.open(encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                counts.append(len(str(json.loads(line).get("response", "")).split()))
    if not counts:
        return None
    counts.sort()
    return counts[len(counts) // 2]


def pct(payload, key, width):
    if payload is None or payload.get(key) is None:
        return "-".rjust(width)
    return f"{payload[key] * 100:.1f}".rjust(width)


def num(value, width, fmt="{:.0f}"):
    return ("-" if value is None else fmt.format(value)).rjust(width)


print()
print("=" * 116)
print("Part 4: Model-CS --FLANv2--> Model-CS-IF")
print("  左半 = 旧能力保留多少(常识)   右半 = 新任务学到多少(IF)   words = 该指标自己的响应词数中位数")
print("  CS 那三列都是八任务宏平均。logp 是主口径；gen 只能配着 parse 读；rand 是塌缩后的地板。")
print("=" * 116)
print(
    f"{'run':<40}{'CS logp':>9}{'CS gen':>8}{'parse':>7}{'rand':>7}"
    f"{'IFEval':>8}{'words':>7}{'FB HSR':>8}{'words':>7}"
)
for name in order:
    cs = load("commonsense_qa", name)
    ifeval = load("ifeval", name)
    fb = load("followbench", name)
    levels = [fb.get(f"rule_hsr_level_{level}") for level in range(1, 6)] if fb else []
    levels = [value for value in levels if value is not None]
    fb_mean = f"{sum(levels) / len(levels) * 100:.1f}".rjust(8) if levels else "-".rjust(8)
    print(
        f"{name:<40}"
        + pct(cs, "average_acc_logprob", 9)
        + pct(cs, "average_acc_gen", 8)
        + pct(cs, "average_parse_rate", 7)
        + pct(cs, "average_random_baseline", 7)
        + pct(ifeval, "strict_prompt_accuracy", 8)
        + num(words_p50("ifeval", name), 7)
        + fb_mean
        + num(words_p50("followbench", name), 7)
    )

# 宏平均会把「某一个子任务塌了」摊平。哪个子集先塌是这条线的一个额外发现。
cs_rows = [(name, load("commonsense_qa", name)) for name in order]
cs_rows = [(name, payload) for name, payload in cs_rows if payload]
if cs_rows:
    tasks = sorted({task for _, payload in cs_rows for task in payload.get("tasks", [])})
    print()
    print("=" * 116)
    print("常识八子集的 acc_logprob 分解（%，最后一列是宏平均，就是主表的 CS logp）")
    print("=" * 116)
    header = "".join(task[:9].rjust(10) for task in tasks)
    print(f"{'run':<34}{header}{'AVG':>9}")
    for name, payload in cs_rows:
        cells = "".join(
            pct(payload.get("per_task", {}).get(task), "acc_logprob", 10) for task in tasks
        )
        print(f"{name:<34}{cells}" + pct(payload, "average_acc_logprob", 9))
    missing = {
        name: payload["tasks_missing"]
        for name, payload in cs_rows
        if payload.get("tasks_missing")
    }
    if missing:
        print()
        print(f"!! 有 run 少评了子集: {missing}")
        print("   AVERAGE 是宏平均，子集不同的两行之间那一列不可比。补齐后重看。")

print()
print("怎么读:")
print("  遗忘量  = cs_anchor 的 CS logp − 该臂的 CS logp")
print("  保护效果 = onereplay 的 CS logp − vanilla 的 CS logp")
print("  代价    = vanilla 的 IF 分 − onereplay 的 IF 分（保护换来的可塑性损失）")
print("  三个数要一起看：只报第二个而不报第三个，等于用「少学新任务」冒充「保住旧能力」。")
print()
print("**CS logp 是主口径，而且它是这三条线里唯一不受输出长度影响的保留指标**：闭集排序、")
print("不解码、不正则匹配，所以遗忘量可以直接读，不像 Part 3 的数学分要配着 hit-cap 才有")
print("可比性。这是本线的方法学优势，写结果时值得点明。")
print()
print("**CS gen 掉了不等于遗忘。** 它测的是「还会不会按训练格式作答」，而 Stage 2 必然把")
print("输出从 7 个 token 推长推杂（FLAN targets P50 18-19），所以 gen 和 parse 一起掉是")
print("预期行为。只有 logp 掉了才是常识能力掉了。两者分道扬镳时看上面那张诊断表的 agree。")
print()
print("**rand 那一列是地板不是零。** 候选集只有 2-5 个，塌成单一 label 的模型也能拿到这个")
print("分数（宏平均约 35%，rand 那一列就是各 run 自己算出来的实测值）。CS logp 掉到 rand")
print("附近 = 塌了，不是「还剩三分之一能力」。")
print("配着诊断表的 mode 那一列看：接近 1 就是塌缩确认。")
print()
print("**IF 分数升降先看 words 再谈能力。** Stage 1 的 Model-CS 只输出 7 个 token，Stage 2")
print("把它推到十几二十个，而 IFEval/FollowBench 里不少约束本质在量长度（见")
print("results_log/2026-09-12 第 8c 节）。")
print()
print("**FB HSR 不是 FollowBench 全量分数**：只有 rule 那一半（350/820 行、70/164 组），")
print("style 类覆盖为 0，format 类只覆盖 2/30，example 类还有 2 组是退化的。judge 那")
print("470 行要在有网的地方过 judge_followbench.py 才能补齐 164 组（见 92 号文件头）。")

# FollowBench 的价值在分级曲线而不是单值：它报的是模型在第几级开始塌。
fb_rows = [(name, load("followbench", name)) for name in order]
fb_rows = [(name, payload) for name, payload in fb_rows if payload]
if fb_rows:
    print()
    print("=" * 108)
    print("FollowBench rule 侧分级曲线（HSR %，CSL 是 0-5 的级数）")
    print("=" * 108)
    print(f"{'run':<40}{'L1':>7}{'L2':>7}{'L3':>7}{'L4':>7}{'L5':>7}{'CSL':>8}{'empty':>7}")
    for name, payload in fb_rows:
        cells = "".join(pct(payload, f"rule_hsr_level_{level}", 7) for level in range(1, 6))
        print(
            f"{name:<40}{cells}"
            + num(payload.get("rule_csl"), 8, "{:.2f}")
            + num(payload.get("response_empty"), 7)
        )
PY
fi

