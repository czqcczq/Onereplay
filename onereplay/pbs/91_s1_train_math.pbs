#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N p1_math
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o  /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# Part 1 / Math 线: Qwen2.5-Math-1.5B --NuminaMath-CoT--> Model-Math
#                   评 MATH-500 + AMC + GSM8K
#
#     Base ---- NuminaMath-CoT ----> Model-Math
#     评测: MATH-500, AMC, GSM8K     对照: base
#
# capability forgetting 实验的 sanity check 之一。只回答一个问题：
#
#     NuminaMath 能不能把 mathematical reasoning 教起来？
#
# 必须先确认能，Part 2 里测到的 Math 下降才叫遗忘。
#
# -----------------------------------------------------------------------------
# 【为什么换成 Qwen2.5-Math-1.5B，以及配方对标哪篇论文】
#
# 对标 "On the Generalization of SFT: A Reinforcement Learning Perspective with
# Reward Rectification" (DFT, ICLR 2026) 的 Table 1。它那一行
#     Qwen2.5-Math-1.5B          Math500 31.66  均值 15.92
#     Qwen2.5-Math-1.5B w/SFT    Math500 43.76  均值 18.01
# 是这条线的外部参照：同模型、同数据集、同量级配方下，vanilla SFT 该把 MATH-500
# 从 31.66 抬到 43.76。我们只要 base -> Model-Math 的方向和幅度对得上，就说明
# Part 1 的 sanity check 立住了。
#
# 论文 §4.1 明写的配方（本脚本已对齐的部分）：
#   NuminaMath-CoT 随机采 10 万条 / 全参 SFT / 1 epoch / AdamW / lr 5e-5 /
#   max input length 2048 / cosine decay / warmup ratio 0.1 / default chat template
#
# 刻意不对齐的只剩一处：
#
#   1) effective batch 64 而不是论文的 256（ACCUM=64, BATCH=4）。设备不同，而且
#      论文自己的 Figure 3 右图专门 sweep 了 batch 32/64/128/256，结论是"没有
#      一致趋势"，64 落在它扫过的区间内。改 ACCUM 反而会让 accumulation_steps
#      和 90/93 号那几条线失去可比性。
#
#   2) （已消除）数据量。原来的 datasets/numina_math_50k 是 5 万条，现在换成
#      datasets/numina_math_100k，和论文的 10 万条对齐。
#      写到**新目录**，不要覆盖现有池（Part 2/3 的 replay 池是从它上面切的）。
#
# 论文没写、属于合理推断的：BF16（verl 默认）、loss 只算 assistant 段（同上）。
# 论文没给 weight decay，所以 train.py 的裸 torch.optim.Adam 其实已经对齐 ——
# Adam(wd=0) 和 AdamW(wd=0) 是同一个更新式。
#
# -----------------------------------------------------------------------------
# 【Qwen2.5-Math 换模型带来的三个坑，两个是静默的】
#
# 1) **上下文硬上限 4096**。config.json 的 max_position_embeddings=4096
#    （tokenizer_config 里的 model_max_length=131072 是假的，别看它）。所以
#    MAXLEN=2048 是安全的，而评测 cap 一旦设到 4096，prompt+生成就越过了窗口，
#    RoPE 外推区的输出不可信。MATH_MAX_NEW_TOKENS 因此定在 2048。
#
# 2) **eos_token 是 <|endoftext|>，但 chat template 用 <|im_end|> 收尾**。训练后
#    模型吐出 <|im_end|> 时 generate 不会停，会继续编造下一轮对话，
#    skip_special_tokens 再把那段拼到答案后面 —— 于是 \boxed{} 之后还有数字，
#    math500 的打分器取最后一个 boxed 跨度、gsm8k 退回取最后一个数字，两边都会
#    取错。所以评测**必须** --decode_stop_on_im_end 1（本脚本已固定传）。
#    这和 Qwen3-1.7B-Base 是同一个坑，只是 evaluate.py 的默认值是 0。
#
# 3) Qwen2.5-Math 的 chat template 在**没有 system 消息**时会自动注入
#        "Please reason step by step, and put your final answer within \boxed{}."
#    这正是论文说的 "default chat template + CoT prompting"。data/chat.py 的
#    apply_train_template 和 eval/generation.py 的 render_chat 都只传 user 角色，
#    所以训练和评测拿到的是同一条 system —— 这一点是对齐的，不用改。
#    副作用是 INSTRUCTION_STYLE=eval_aligned 又在 user turn 里写了一遍同样的要求，
#    指令重复。训练/评测同口径所以不影响可比性，想更贴论文就传 bare。
#
# IF 线是 90_part1_if_conifer.pbs。两条线拆开管，因为这条线的 maxlen 是 IF 的 4 倍、
# batch 只有 1/4，超参和显存预算完全是另一套。不做交叉评测。
#
# -----------------------------------------------------------------------------
# 【为什么是全量微调，而不是 LoRA】
#
# 工程：train.py 没有 --adapter_path / --resume_from，模型一律从
#   --model_dir/--model_name 拼路径加载。而 trainers/base.py 的 save 分支是
#   self.model.save_pretrained(save_path)，全量微调写的是**完整权重 + tokenizer**，
#   于是 Part 2 可以把上一阶段的输出目录直接当 base 接着训。LoRA 存的是 adapter，
#   做不到，得先 merge。
#
# 科学：LoRA 的低秩约束本身就限制权重漂移、天然抗遗忘，会把「方法的效果」和
#   「LoRA 的隐式正则」混在一起。全量是干净的对照底座。
#
# -----------------------------------------------------------------------------
# 【LR 现在由论文给定：5e-5 + cosine + warmup 0.1，不再需要 sweep】
#
# 论文 §4.1 对 Qwen2.5-Math 系列就是 lr=5e-5（只有 LLaMA-3.1-8B 降到 2e-5），
# 配 cosine decay 和 warmup ratio 0.1。既然是照配方复现，LR 直接取 5e-5，
# MODE=lr_sweep 保留但不是必经步骤。
#
# **warmup 不是可选项**。train.py 在加 --lr_scheduler 之前是裸 torch.optim.Adam
# 恒定 LR、无 warmup、无 scheduler（93 号脚本里记过这件事）。全参微调在 5e-5 下，
# 第一次更新落在一个离自己最优点很远的模型上，没有 warmup 的那一步就是 loss
# 尖峰的来源。所以本脚本固定传：
#     --lr_scheduler cosine --warmup_ratio 0.1
#
# schedule 的推进单位是**优化器更新**而不是 micro-batch，horizon 由 --epochs
# （或 --max_steps，取更小者）换算。所以 MODE=lr_sweep 的每一档是在自己那
# 3200 步 / 200 次更新的预算上走**完整**的 cosine，而不是停在一条长 schedule 的
# 半山腰 —— 否则 sweep 比的是"谁的 LR 还没降下来"，不是谁更好。
#
# 正式训练是 99000 行 / BATCH=4 = 24750 micro-batch，除以 accumulation_steps 16 =
# **1547 次更新**，其中前 155 次是 warmup。
# metrics jsonl 里会记 lr_scheduler / warmup_updates /
# total_updates / lr_end，train 日志每个窗口打一次 lr=，发散先去看那条轨迹。
#
# 旧的 LR 讨论（Qwen3-1.7B + OpenR1 时代，恒定 LR 无 scheduler）留档：44 号记录过
# 全量在 lr=1e-5 下 val loss ep3 = 0.07364，比 LoRA (lr=1e-4) 的 0.04494 还差 64%，
# 是欠训练，所以那时起点定在 2e-5。换模型换配方之后这组数不再适用。
#
# -----------------------------------------------------------------------------
# 【Part 1 不需要采 C】
#
# build_regularizer 的加载条件是
#     replay_lambda > 0  或  (measure_replay_when_lambda_zero==1 且 penalty 文件存在)
# 所以 --replay_lambda 0 --measure_replay_when_lambda_zero 0 返回 None，既不读 cov
# 文件，也不存 W0 快照。纯 vanilla，省掉一个 Stage 和 W0 那 3.4 GB。
#
# -----------------------------------------------------------------------------
# 【<think> / strip_tags：在 Qwen2.5-Math + Numina 下已是空操作，本节是留档】
#
# 现在的情况：NuminaMath 的 solution 里没有 <think> 标签，所以 --think_handling
# strip_tags 什么也不做。而 Qwen2.5-Math 的 chat template 根本不引用
# enable_thinking 这个变量 —— apply_chat_template 会把它当成一个多余的模板变量
# 静默忽略（不会抛 TypeError，所以 render_chat 的那个 except 分支也不会触发），
# prompt 末尾不会出现空 think 块。这一节对本次运行没有可执行含义。
#
# 留档是因为它记录了一个踩了不报错的坑，换回长推理数据集时必须重读：
#
# eval/generation.py 把所有生成式评测的 prompt 都渲染成 enable_thinking=False。在
# Qwen3 的 chat template 下，这会在 prompt 末尾放一个**空的** <think></think> 块，
# 等于告诉模型「思考已经结束，直接作答」。
#
# 而 OpenR1 的 target 自带 <think>…</think> 长推理。如果原样保留：
#   训练时模型学到的是「先开 think 块，在里面推理」
#   评测时 think 块已经被关掉了 -> 学到的能力发不出来
# 结果会读成「OpenR1 没教会数学」，而真实原因是评测 prompt 掐掉了 thinking。
#
# 所以 --think_handling strip_tags：去掉 <think>/</think> 两个标签、**保留推理正文**，
# 让答案变成「一段长推理 + 最后一个 \boxed{}」。这正好是 math500.py 的 prompt
# （"Reason step by step, then give the final answer as \boxed{...}"）要求的形态，
# 打分也只看最后一个 \boxed 跨度，评测路径一行都不用改。
#
# 顺带一个实测：保留标签还会破坏 label masking。tokenizer_to_ids 的做法是
#     labels = [-100] * len(prompt_ids) + full_ids[len(prompt_ids):]
# 它假设 prompt_ids 是 full_ids 的前缀。带 <think> 的 target 在共享 21 个 token 后
# 分叉，而 prompt_ids 长到 25，于是推理开头 4 个 token 被误标成 -100。4 个 token
# 在 2000+ 的 CoT 里可以忽略，但它是同一个 prompt/answer 错配的症状。
#
# --instruction_style eval_aligned 是同一个道理：训练用的 user turn 直接采用
# math500.py 的措辞，训练 prompt 就是评测 prompt。数据集自带的那条 762 字符 R1
# system 指令被丢掉（apply_train_template 也没有 system 位），因为它要求的正是
# 被 strip 掉的那对标签。
#
# -----------------------------------------------------------------------------
# 【eval_aligned 对齐 MATH-500 和 AMC，不对齐 GSM8K —— 这是有意的】
#
# 三个评测的 prompt 不是一套。AMC 走的是 math500.py 里的 AMCMetric，它继承
# MATH500Metric、**共用同一个 build_prompt 和同一套 is_equiv 打分**，只是换了
# 数据文件；GSM8K 是独立的一套：
#   math500/amc.build_prompt : "Reason step by step, then give the final answer as \boxed{...}"
#   gsm8k.build_prompt       : "Reason briefly, then end your answer with '#### ' + 最终数字"
#
# eval_aligned 对齐的是前者。于是这三个指标读出来的含义不同：
#   MATH-500 = 同分布的能力上限（训练/评测同一套指令和答案格式）
#   AMC      = 同口径但更难（竞赛题，指令格式和训练一致，只是题目分布更难）
#   GSM8K    = 跨格式泛化（模型要在没见过的 '####' 指令下仍然做对）
#
# 所以 AMC 低于 MATH-500 是难度，不是格式问题；GSM8K 低则要先排除格式。
#
# GSM8K 的打分不会因此假阴性：predicted_answer 在响应里找不到 '####' 时，会退回
# 取全文最后一个数字，而 \boxed{18} 结尾的响应最后一个数字正是 18。GSM8K 的 gold
# 全是整数，这条退路够用。
#
# 唯一要留神的是：如果模型在 \boxed{} 之后还继续写了带数字的话，最后一个数字会取错。
# 万一 GSM8K 明显低于 MATH-500，先去 responses.jsonl 里翻几条原文确认是这个原因，
# 再下"数学能力没学到"的结论。
#
# -----------------------------------------------------------------------------
# 【显存与 batch：ACCUM/BATCH 刻意不动，而且这不损失速度】
#
# 1.5B 全量 + Adam（torch.optim.Adam，状态跟参数 dtype 走 bf16）的常驻部分：
#     权重 bf16 3.1 + 梯度 bf16 3.1 + 两个动量 6.2 ≈ 12.3 GB
# 比 Qwen3-1.7B 那一版还少 1.5 GB。剩下全是激活。collator 是
# DataCollatorForTokenClassification，按 **batch 内最长**动态补齐，所以激活的
# 上界由 BATCH x MAXLEN 决定：
#     IF 线   4 x 1536 = 6144 token/micro-batch
#     Math 线 4 x 2048 = 8192 token/micro-batch
# 两条线刻意取在同一量级，IF 能跑 Math 就能跑。注意 OpenR1 时代这里是 1 x 8192，
# 换 Numina（答案短一个量级）之后是 4 x 2048 —— 每步 token 数没变，只是形状变了。
#
# 关键是**加大 batch 换不到速度**。results_log 的 batch 饱和测试（Job 2831163，
# 同一张卡）实测：micro-batch=8 x max_len 512、每步约 908 token 时 GPU 吞吐已经
# 吃满，加到 16 总时间比 1.015、tokens/s 反而从 10181 掉到 10026，只多花 18 GB
# 显存。饱和取决于**每步 token 数**而不是样本数，而本线每步 8192 token 是那个
# 饱和点的 9 倍。所以 BATCH=4 不是妥协。
#
# ACCUM=64 也刻意不动：论文用的 effective batch 是 256，但它自己的 Figure 3
# sweep 过 32/64/128/256 且没有一致趋势，而改 ACCUM 会让 accumulation_steps 和
# 90/93 号那几条线失去可比性 —— 那个代价比对齐一个已被证明不敏感的超参更大。
#
# 那次测量的显存斜率（约 20 MB/token）不能照搬到这里：它是 LoRA、max_len=512、
# 短样本分布下拟合的，padding 行为完全不同。真实峰值只能测——这就是 MODE=smoke
# 的用途，跑之前先看它报的 peak memory。
#
# 仓库没有 gradient checkpointing、没有 DDP（trainers/base.py 只有一个 self.device）。
# 等 Part 2 要在 Math 的 batch 里混入 Conifer replay 行时再重新算这一节。
#
# -----------------------------------------------------------------------------
# 【时间预算：换 Numina + 2048 之后便宜了一个数量级】
#
# Numina 的答案 P50=351 / P90=778 / max=2666，题目 P50≈104，所以全序列 P50 约 480
# token。100k 池实测（manifest length 段，n=3000 抽样）：全序列 P50=487 / P90=961 /
# P99=1462 / max=3045，答案 P50=350 / P90=787。MAXLEN=2048 下 tok/epoch **55.6M**，
# 而 OpenR1 时代（45792 行 x MAXLEN 8192）是 190.0M。
#
# 吞吐仍然没有全参微调的实测值，而且 T=2048 时 attention 的 O(T^2) 项比 8192 那版
# 轻得多，所以不该再套那个 5-8k token/s。**别猜，跑 MODE=smoke 看 tokens_per_sec**，
# 用 55.6M / 它算真实 epoch 秒数。按 8-15k token/s 粗估 1 epoch 约 1.0-1.9 h。
#
# 所以和 OpenR1 时代不同：正式训练不再必须 DO_EVAL=0。但仍然建议拆开跑 —— 评测
# 两个 run x 三个指标是独立的墙钟，混在一个作业里失败要重跑训练。
#
# EPOCHS=1 是论文的值（§4.1 没明写，但 100000/256 ≈ 391 次更新正好对上 Figure 1
# 横轴的 0-400；附录 A.5 说 OpenR1 那组"except epochs 设为 3"也反证了主实验是 1）。
#
# -----------------------------------------------------------------------------
# 【MAXLEN=2048 是论文值，但它在 Numina 上不是零截断 —— 提交前先核一眼】
#
# tokenizer_to_ids 的截断是 full_input_ids[-max_length:]，**保尾丢头**。超长的样本
# 丢掉的是开头的题目，留下推理尾巴，模型于是学会「凭空续写推理」。loss 曲线看不出
# 异常，这是这条线最容易踩而且踩了不报错的坑。
#
# 论文 §4.1 的 "maximum input length 2048" 也是在 10 万条上跑的。50k 池实测的分布
# 是：答案 P50=351 / P90=778 / **max=2666**，题目 P50=104 / max 也有上千。所以
# 2048 会截断**一小部分**行（答案 max 已经超过它），不是零。prepare_numina_math 的
# docstring 说"4096 截断 0 行"，那是 4096 的结论，不能推到 2048。
#
# 真实比例不要猜，去看池子旁边的 numina_math_100k_manifest.json 里的 length 段
# （MODE=data 生成时打的那张表），确认两件事：
#     truncated 占比很小（个位数百分比以内），且 **question gone = 0**
# question gone 就是"答案本身填满预算、左截断后一个题目 token 都不剩"的行数，只要
# 它不为 0，模型就会在那些行上学到无题目续写。
#
# 如果 question gone 不为 0，选择是 MAXLEN=3072（Numina 全池都装得下，且仍在
# Qwen2.5-Math 的 4096 上下文内），代价只是偏离论文值 —— 而这个偏离比在几百行上
# 训"无题目续写"要安全得多。
#
# 下面这张表是 **OpenR1 时代**（45792 行 R1 长推理 + MAXLEN 8192）的留档，和现在的
# Numina 池无关，留着是为了说明左截断能造成多大破坏：
#
#   全序列  P50=3900  P75=5551  P90=6957  P95=7524  P99=8004  max=9004
#   答案    P50=3767  P75=5416  P90=6819                      max=7993
#   题目    P50= 104  P90= 172                                max=2078
#
#   max_len  截断行数   占比    题目全丢   tok/epoch
#      1024    45467  99.3%      45238      46.8M
#      2048    39499  86.3%      38412      91.0M
#      3072    29996  65.5%      28845     126.6M
#      4096    21359  46.6%      20326     152.8M   <- OpenR1 时代曾经的默认值
#      6144     8235  18.0%       7560     182.2M
#      8192       25   0.1%          0     190.0M   <- OpenR1 时代最终用的值
#     10240        0   0.0%          0     190.0M
#
# 「题目全丢」= 答案本身就填满了预算、左截断后一个题目 token 都不剩的行数。4096 下
# 有 20326 行（44.4%）落在这一类，模型会在近一半的数据上学到"无题目续写推理"。
# 这个错误不会报错、loss 曲线也正常，只会让 Part 2 测到的"遗忘"无法解释。这就是
# 上面要求核对 question gone 的理由。
#
# 换了 tokenizer、改了 instruction_style 或 think_handling 都必须重看长度报告，
# 不能沿用任何旧数。
#
# -----------------------------------------------------------------------------
# 【评测预算必须大于训练答案长度】现在是 2048，下面整节是 OpenR1 的留档
#
# 先说现在的结论：**2048**，有两个独立的理由同时指向它。
#
# 一是够用。NuminaMath-CoT 的训练答案 P50=351 / P90=778 / max=2666，每条训练目标
# 末尾都补了 EOS（data/chat.py 的 apply_train_template），所以模型学到的回答长度
# 分布基本被 2666 封住，2048 能覆盖绝大多数正常收尾的响应。而且 OpenR1 时代实测过
# 把 cap 从 4096 提到 8192 **没有改善 MATH-500**：撞上限的行是陷在重复自我复核的
# 循环里，任何 cap 都填得满（同一批题在两个 cap 下的 Jaccard=0.649，说明是题目难度
# 驱动的循环，不是预算不够）。给更多预算只是白烧解码时间。
#
# 二是不能更大。Qwen2.5-Math-1.5B 的 max_position_embeddings=4096，prompt 大约
# 150 token，cap 设到 4096 就把生成推到了 RoPE 外推区，那段输出不可信。论文虽然写
# max generation 4096，但它对 Qwen2.5-Math 也撞着同一个天花板 —— 实际上短响应根本
# 用不到，所以这个偏离只在纸面上。
#
# 改这个值必须整张结果表一起重评，不能和旧数字混用。
#
# 下面这一节记录的是 OpenR1 时代为什么必须要 8192 —— 换数据集之前它是对的，留着是
# 为了说明「什么情况下 4096 会骗你」，不要按它去调现在的默认值。
#
# 训练答案实测 P50=3767 / P75=5416 / P90=6819 / P95=7524 / P99=8004 token。评测预算
# 只要低于这个分布的中位数，就会把正确推理在写到 \boxed{} 之前掐断，而 math500.py 的
# extract_answer 抽不到 boxed 跨度就返回 None，is_equiv(None, gold) 直接判错——分数
# 读成"不会做"。
#
# 曾经的默认 4096 正好卡在训练答案中位数下面，代价实测如下（lr=5e-5 seed=1，batch=128）：
#
#                报告 acc   无答案    其中撞上限    响应 token P50/P90/P99/max
#   base           0.528    14.6%      58.9%         468 / 1978 / 4147 / 4194
#   Model-Math     0.388    55.0%      99.6%        4096 / 4096 / 4096 / 4096
#
# Model-Math 的长度分布**在中位数上就被右删失**（P50 == cap），无答案的 275 行里 274
# 行是撞上限，自然收尾却不写 boxed 的只有 1 行。所以 0.388 < 0.528 是纯测量假象：
#   两边都抽出答案的 200 题交集   0.870 vs 0.805
#   各自能抽出答案的行           0.862 vs 0.618
#   base 在 Model-Math 被截断的那 275 行上只有 0.375（它自己也有 48 行无答案）
# GSM8K 同病但症状轻，因为它的打分器兜底取"整篇最后一个数字"：未截断子集 0.861 vs
# base 0.368，而报告值是 0.719 vs 0.320。四个报告数字全都偏低。
#
# 8192 的依据：数据集本身按 8192 筛过，训练答案 P99=8004 / max=7993，且每条训练目标
# 末尾都补了 EOS（onereplay/data/chat.py 的 apply_train_template），所以模型学到的回答
# 长度分布基本被 8000 封住，8192 能覆盖 95%+。代价是解码时间，见下面 MATH_BATCH。
#
# 判读规则：eval 跑完会自动打 length/truncation diagnostic（本文件 eval 段末尾）。
# hit-cap 接近 0 且 P99 明显低于 cap 才算预算够用。**但 hit-cap 高不等于该加 cap** ——
# 先看撞上限那些行的尾部 distinct-shingle：低（约 0.1）就是重复循环，加 cap 没用，
# 要动的是训练数据或解码策略；高（接近 1）才是真的写不完，那时才提 cap。
#
# 【这件事对 Part 2 / Part 3 的杀伤力更大】删失是长度相关的：任何让输出变短的干预
# （replay 混 IF 数据、EWC 把权重拉回 base）都会让更多行在预算内收尾，MATH-500 分数
# 因此上升，会被误读成"该方法保住了数学能力"。所以 96/98/99 号必须用同一个预算，且
# 每个 arm 都要同时报 accuracy / no-answer / hit-cap，否则遗忘结论和输出长度分不开。
#
# -----------------------------------------------------------------------------
# 【前置】计算节点无外网，以下都要先在有网节点备好
#   1) 模型      ${MODEL_DIR}/${MODEL_NAME}      (Qwen2.5-Math-1.5B)
#                huggingface-cli download Qwen/Qwen2.5-Math-1.5B \
#                  --local-dir ${REPO_ROOT}/models/Qwen2.5-Math-1.5B
#                这是**本次唯一的新增下载**。评测集和数据池都已就位。
#   2) 数据池    ${REPO_ROOT}/datasets/numina_math_100k/  (save_to_disk)
#                用 prepare_numina_math.py --sample_rows 100000 --require_boxed 1
#                --tokenizer_path <Qwen2.5-Math-1.5B> 生成，**out_dir 必须是新目录**：
#                指向已有池时 check_out_dir 会放行并覆盖掉它。
#                旁边的 numina_math_100k_manifest.json 是核 MAXLEN 的依据，见上面
#                「MAXLEN=2048」那一节。正式训练**不要**走 MODE=data。
#   3) 评测集    ${REPO_ROOT}/datasets/math/{gsm8k,math500,amc}_test.jsonl
#                （和 32/33/45 号同一目录，不是 datasets/math_eval/）
#                三个文件都已存在。缺哪个就自动跳过那个指标，不会中断作业。
#   4) mkdir -p ${REPO_ROOT}/logs   （即上面 #PBS -o 指的目录，不存在的话作业没日志）
#
# 【用法】按顺序。数据池已备好，所以不再需要第 0 步。
#   # 1) 冒烟：70 步，不保存。两个目的：看 peak memory（2048x4 的真实峰值），
#   #    以及拿 tokens_per_sec 去除 55.6M tok/epoch 算真实 epoch 时长。
#   #    **顺便确认日志里出现了 lr= 字段**，没有就说明 scheduler 没接上。
#   qsub -v MODE=smoke onereplay/pbs/91_part1_math_openr1.pbs
#
#   # 2) 正式训练。LR/scheduler 都已是论文值，默认就对，不用再传。
#   #    1 epoch 约 1.0-1.9 h，所以可以带评测一起跑；想拆开就加 DO_EVAL=0。
#   qsub -v MODE=train onereplay/pbs/91_part1_math_openr1.pbs
#
#   # 3) 评测单独跑（或上一步带 DO_EVAL=0 之后补）。默认 cap=2048 / batch=128，
#   #    两个 run x 三个指标。产物写到 ${RESULTS_ROOT}/eval_cap2048/，按 cap 分目录
#   #    所以不会和 OpenR1 时代 4096/8192 的数字混进一张表。
#   #    **LR 必须和训练时一致**（默认都是 5e-5），否则会去找不存在的 checkpoint 目录。
#   qsub -v MODE=eval onereplay/pbs/91_part1_math_openr1.pbs
#
#   # 想先便宜地把整条链路跑通，用子集（几分钟）
#   qsub -v MODE=train,MAX_TRAIN_SAMPLES=6000,EPOCHS=1 onereplay/pbs/91_part1_math_openr1.pbs
#
#   # 可选：LR sweep。论文已经给了 5e-5，所以这步不是必经的。每档在自己的
#   # SWEEP_MAX_STEPS 预算上走完整 cosine。
#   qsub -v MODE=lr_sweep onereplay/pbs/91_part1_math_openr1.pbs
#
#   # 5) 反向线（Math -> IF）要用的 20k 旧知识池。训练池逐字不变，已有 checkpoint
#   #    不受影响，所以在 Model-Math 训完之后补跑是安全的（约 10-15 min，纯 CPU）。
#   qsub -v MODE=data,REPLAY_ROWS=20000 onereplay/pbs/91_part1_math_openr1.pbs
#      也可以不重跑本脚本，直接用 99 号的 MODE=pool 从已存的训练池上切（几分钟，
#      两条路径调的是同一个 carve_replay_pool，产物逐字相同）。
#
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id>
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/91_s1_train_math.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  JOB_TMPDIR="/local_ssd/${SCRATCH_USER}/tmp_p1math_${JOBTAG}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="/scratch/${SCRATCH_USER}/cache/tmp_p1math_${JOBTAG}"
  EXTRA_BIND=""
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_p1math_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME RESULTS_ROOT DATASET_CACHE METRICS_DIR CKPT_DIR
    OPENR1_PARQUET MATH_DATASET
    MODE DRY_RUN DO_TRAIN DO_EVAL SEED FORCE_EVAL
    EPOCHS LR LR_SCHEDULER WARMUP_RATIO BATCH ACCUM MAXLEN VAL_FRAC MAXVAL TARGET_MODULES
    LR_GRID SWEEP_MAX_STEPS SMOKE_STEPS MAX_TRAIN_SAMPLES LOG_EVERY SWEEP_LOG_EVERY
    THINK_HANDLING INSTRUCTION_STYLE REQUIRE_BOXED SYSTEM_PROMPT
    REPLAY_ROWS REPLAY_POOL REPLAY_SAMPLE_SEED
    GSM8K_DATA MATH500_DATA AMC_DATA MATH_MAX_NEW_TOKENS EVAL_OUT_DIR
    EVAL_LIMIT EVAL_BATCH MATH_BATCH RUNS_TO_EVAL DIAG_LEN STOP_ON_IM_END
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e --nv -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv

cd "${REPO_ROOT}"

# ---- 路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen2.5-Math-1.5B}"
# 结果树按**模型**分，这是必须的而不是整洁强迫症。旧的 Qwen3-1.7B-Base 那一轮就写在
# results_part1_numina_math/ 下，run 名是 part1_math_lr5e-5_seed1 —— 和本次的
# lr/seed 完全相同。两者共用一个根的话，MODE=train 会撞上
# `if [[ -d "${CKPT}" ]] then 跳过训练`，于是**静默跳过训练、直接去评测 Qwen3 的旧
# checkpoint**，日志里只有一行"跳过"。按模型分根之后 checkpoint / metrics / eval
# 产物三者一起分开，旧结果也完整留着可以对照。
#
# 【对 99/100 号的影响】它们默认去 ${REPO_ROOT}/results_part1_numina_math/checkpoints
# 找 Stage 1 的 checkpoint（MATH_LINE_ROOT 变量）。用本脚本训出来的模型跑 Part 3 时
# 必须带上：
#   qsub -v MATH_LINE_ROOT=${REPO_ROOT}/results_part1_numina_Qwen2.5-Math-1.5B ...
# 忘了传不会静默出错：它们的 glob 命中 0 个就 exit 1 并打出找过的目录。
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_part1_numina_${MODEL_NAME}}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
export HF_DATASETS_CACHE="${DATASET_CACHE}"
METRICS_DIR="${METRICS_DIR:-${RESULTS_ROOT}/metrics}"
CKPT_DIR="${CKPT_DIR:-${RESULTS_ROOT}/checkpoints}"

# OpenR1 parquet 的位置。只给 MODE=data 用：那一档会跑 prepare_openr1_math，把
# 源 parquet 摊成 save_to_disk。Numina 池已经备好了，正式训练不要走 MODE=data。
# 集群上是 huggingface-cli download 直接落的仓库名目录
# ${REPO_ROOT}/datasets/Openr1-Math-46k-8192/openr1.parquet，本地放在 data_check/ 下。
OPENR1_DIRS=(
  "${REPO_ROOT}/datasets/Openr1-Math-46k-8192"
  "${REPO_ROOT}/datasets/openr1"
  "${REPO_ROOT}/data_check/Openr1-Math-46k-8192"
)
if [[ -z "${OPENR1_PARQUET:-}" ]]; then
  for _dir in "${OPENR1_DIRS[@]}"; do
    for _hit in "${_dir}"/*.parquet "${_dir}"/data/*.parquet; do
      if [[ -f "${_hit}" ]]; then
        OPENR1_PARQUET="${_hit}"
        break 2
      fi
    done
  done
  OPENR1_PARQUET="${OPENR1_PARQUET:-${OPENR1_DIRS[0]}/openr1.parquet}"
fi
# train.py --dataset_path 要的是 save_to_disk 根目录（里面有 dataset_dict.json
# 和 train/），不是 train/data-*.arrow，也不是旁边的 *_test.jsonl。
# load_and_prepare_dataset 会读 dataset["train"]，再按 val_fraction 切 val。
# 官方 100 行 test（numina_math_100k_test.jsonl）训练侧不读。
MATH_DATASET="${MATH_DATASET:-${REPO_ROOT}/datasets/numina_math_100k}"

# ---- 反向线（Math -> IF）的旧知识池 ----
# 本线自己不需要它。它是 99/100/101 号的输入：Math 变成"被保护的能力"时，C_math /
# F_math / replay 三者必须读同一批旧知识行，那批行就是这个文件。
#
# nested 随机子集：训练池**一行都不删**，这只是它的另一个视图。所以在 Model-Math 已经
# 训完之后补跑 MODE=data 是安全的——prepare_openr1_math 在同样的 --seed 下写出逐字
# 相同的训练池（rows 的构造是确定的，--max_train_samples 0 下连 shuffle 都不发生），
# 已有 checkpoint 不会失效。
#
# 默认 0 = 不写，保持这条线原来的行为不变。要产池就 REPLAY_ROWS=20000。
REPLAY_ROWS="${REPLAY_ROWS:-0}"
REPLAY_POOL="${REPLAY_POOL:-${MATH_DATASET}_replay.jsonl}"
# 与 --seed 分开：重抽旧知识池不该牵动训练池。
REPLAY_SAMPLE_SEED="${REPLAY_SAMPLE_SEED:-1}"

# ---- 模式 ----
MODE="${MODE:-data}"
DRY_RUN="${DRY_RUN:-0}"
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
FORCE_EVAL="${FORCE_EVAL:-0}"
SEED="${SEED:-1}"

# ---- 数据转换选项 ----
# strip_tags：去 <think> 标签、保留推理正文。与 enable_thinking=False 的评测路径一致，
# 换成 keep 会让 Math 分数假阴性（见文件头）。
THINK_HANDLING="${THINK_HANDLING:-strip_tags}"
# eval_aligned：训练 prompt 直接用 math500.py 的措辞，训练/评测同口径。
INSTRUCTION_STYLE="${INSTRUCTION_STYLE:-eval_aligned}"
# 1 会丢掉答案里没有 \boxed{} 的行（打分器只认这个跨度）。默认 0，先看比例再决定。
REQUIRE_BOXED="${REQUIRE_BOXED:-0}"
MAX_TRAIN_SAMPLES="${MAX_TRAIN_SAMPLES:-0}"

# ---- 训练超参（Math 线专用）----
# ACCUM 仍是 64 行/更新，与 IF 线可比。论文的 effective batch 是 256，刻意不对齐，
# 理由见文件头「显存与 batch」那一节。**注意 ACCUM 是"行/更新"而不是微批个数**：
# accumulation_steps = ACCUM // BATCH = 16，所以有效 batch 是 64 而不是 4x64=256。
# 1 epoch 是论文值（§4.1 没明写，但 100000/256 ≈ 391 次更新对上 Figure 1 的横轴）。
# 本配置是 99000/64 = 1547 次更新，多出的 4 倍纯粹来自 batch 小 4 倍，数据量已对齐。
EPOCHS="${EPOCHS:-1}"
LR="${LR:-5e-5}"
# 论文 §4.1: cosine decay + warmup ratio 0.1。train.py 在加 --lr_scheduler 之前是
# 恒定 LR、无 warmup，全参微调在 5e-5 下第一步就可能出 loss 尖峰。schedule 按
# **优化器更新**推进，horizon = epochs（或 max_steps，取更小者）换算出的更新数。
#
# 本配置（100k 池 / VAL_FRAC=0.01 / BATCH=4 / ACCUM=64 / 1 epoch）下的确定值：
#   99000 行 -> 24750 micro-batch -> ceil(24750/16) = **1547 次更新**，warmup **155** 次。
# 训练一开始 train.py 会打一行
#   `lr schedule: cosine over 1547 updates (1547/epoch x 1), warmup 155 updates ...`
# **对不上就说明池子行数或 BATCH/ACCUM 和这里的假设不一致，停下来查**。
#
# horizon 必须和 trainer 真实的 optimizer.step() 次数严格相等，不是"差不多就行"：
# base.py 在 `step % accumulation_steps == 0 or step == total_steps` 两个条件上都
# step，24750 = 16x1546+14 所以尾部那次 flush 让实际步数正好 1547。HF 的 cosine 在
# 越过 num_training_steps 之后 progress>1、余弦**回升**，horizon 短一步就会让 LR
# 在末尾反向抬头。已数值核验过两者都是 1547。
LR_SCHEDULER="${LR_SCHEDULER:-cosine}"
WARMUP_RATIO="${WARMUP_RATIO:-0.1}"
# BATCH 必须整除 ACCUM（accumulation_steps = ACCUM // BATCH 是整除），否则"一次更新
# 64 行"不成立。BATCH=4 x MAXLEN 2048 = 8192 token/micro-batch，和 OpenR1 时代的
# 1 x 8192 是同一个激活预算，所以那时能跑现在一定能跑。
# 历史实测：BATCH=8 在 MAXLEN=4096 下 OOM（8 x 4096 = 32768 token/micro-batch）。
# 现在 MAXLEN 降到 2048，8 x 2048 = 16384 理论上装得下，但没有实测，而且
# 4 x 2048 已经远在吞吐饱和点之上（见文件头「显存与 batch」），加大换不到速度。
# 要动就先 MODE=smoke 看峰值。
BATCH="${BATCH:-8}"
ACCUM="${ACCUM:-64}"
# 2048 = 论文 §4.1 的 "maximum input length"。Numina 的答案 P50=351 / P90=778 /
# max=2666，所以 2048 会截断一小部分行，**不是零截断**。截断是保尾丢头的，提交前
# 先看 numina_math_100k_manifest.json 的 length 段确认 question gone = 0；不为 0 就
# 提到 3072（Numina 全池装得下，且仍在 Qwen2.5-Math 的 4096 上下文内）。
# 详见文件头「MAXLEN=2048」那一节。
MAXLEN="${MAXLEN:-2048}"
VAL_FRAC="${VAL_FRAC:-0.01}"
# 长序列的 val 也贵，取小一点；跨 run 比较时必须保持同一个值。
MAXVAL="${MAXVAL:-200}"
# 全量微调时 --target_modules 只决定正则覆盖哪些层，不决定哪些参数训练（全都训）。
# 本线没有正则，传什么都不影响结果；与 44 号保持一致便于对照。
TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj,lm_head}"

# ---- system 消息：本线**刻意留空** ----
# 空 = 不传 system turn = Qwen2.5-Math 的模板自动注入
#     "Please reason step by step, and put your final answer within \boxed{}."
# 这正是论文 §4.1 说的 "default chat template + CoT prompting"，是本线要复现的
# 配方的一部分，所以不要动它（见文件头 Qwen2.5-Math 那节第 3 条）。
#
# 93/94 号（cs / if）相反：同一个注入在那两条线上是污染，它们各自传一条中性的
# 助手消息。三条线的 system 不同是有意的，不是遗漏。
#
# 已跑完的 Model-Math 就是在空值下训练的，所以改这个等于换了训练 prompt，
# checkpoint 和评测都要重来。
SYSTEM_PROMPT="${SYSTEM_PROMPT:-}"

# ---- LR 搜索 / 冒烟 ----
# 论文已经给了 5e-5，所以 lr_sweep 不再是必经步骤，这一档是留着备用的。
LR_GRID="${LR_GRID:-2e-5 5e-5 1e-4}"
# **数的是 micro-batch，不是优化器步**。更新次数 = SWEEP_MAX_STEPS / (ACCUM/BATCH)，
# 本线 BATCH=4 所以分母是 **16** —— 3200 步 = 200 次更新 = 12800 行 = 26% 的 epoch。
#
# 曾经的默认值 150 是个严重的陷阱：分母 64 时只有 **2 次权重更新**，比出来的完全是
# 噪声。IF 线（同样分母 16）的 300 步也只有 18 次更新，实测那一轮的排序就被"谁走得
# 快"主导、天然偏袒大 LR，详见 90 号脚本里记的结果。
#
# 每档约 6M token，按 8-15k tok/s 估 **每档 7-13 min**，3 档半小时内。比 OpenR1
# 时代（每档 28-44 min）便宜得多，因为序列短了 4 倍。
#
# 注意 sweep 的每一档都在自己 3200 步 / 200 次更新的预算上走**完整**的 cosine
# （train.py 的 horizon 取 min(epochs 换算, max_steps 换算)），所以比的是"同样
# 走完一条完整 schedule 后谁更低"，而不是"谁的 LR 还没降下来"。
SWEEP_MAX_STEPS="${SWEEP_MAX_STEPS:-3200}"
SMOKE_STEPS="${SMOKE_STEPS:-70}"
# 每多少个 micro-batch 打一行 task_loss。sweep 要看**轨迹**而不只是末值——发散表现为
# loss 中途抬头或出 nan，只比末值看不出来，所以 sweep 用一个更密的值。
LOG_EVERY="${LOG_EVERY:-500}"
SWEEP_LOG_EVERY="${SWEEP_LOG_EVERY:-64}"

# ---- 评测（只测 Math 能力）----
GSM8K_DATA="${GSM8K_DATA:-${REPO_ROOT}/datasets/math/gsm8k_test.jsonl}"
MATH500_DATA="${MATH500_DATA:-${REPO_ROOT}/datasets/math/math500_test.jsonl}"
# AMC 走 math500.py 的 AMCMetric（继承 MATH500Metric，共用 build_prompt 和 is_equiv，
# 只换数据文件和输出目录），所以加上它零成本。注意这个文件来自
# AI-MO/aimo-validation-amc，是 AMC12 2022+2023 共 83 题，**不是论文 AMC23 的 40 题**，
# 所以绝对值不能直接对 Table 1，只能读 base -> Model-Math 的方向。
AMC_DATA="${AMC_DATA:-${REPO_ROOT}/datasets/math/amc_test.jsonl}"
# Qwen2.5-Math 的 eos_token 是 <|endoftext|>，而 chat template 的 assistant turn 以
# <|im_end|> 收尾。不开这个，模型吐出 <|im_end|> 后 generate 不停，会续写下一轮对话，
# skip_special_tokens 再把那段拼到答案后面 —— \boxed{} 之后多出数字，math500 取错
# boxed 跨度、gsm8k 兜底取错"最后一个数字"。evaluate.py 的默认值是 0，必须显式开。
# 开关它会移动所有生成式分数，所以**一张表里的所有 arm 必须同值重评**。
STOP_ON_IM_END="${STOP_ON_IM_END:-1}"
# 2048：两个理由同时指向它（详见文件头「评测预算」那一节）。
#   够用   —— Numina 训练答案 P50=351 / P90=778 / max=2666，且每条训练目标末尾都补了
#            EOS，所以模型学到的回答长度基本被 2666 封住。
#   不能更大 —— Qwen2.5-Math-1.5B 的 max_position_embeddings=4096，prompt 约 150 token，
#            cap 设到 4096 就把生成推进 RoPE 外推区，那段输出不可信。
# 8192 是 OpenR1 时代定的（R1 traces 答案 P50=3767 / P99=8004），且实测把 cap 从 4096
# 提到 8192 **没有改善 MATH-500** —— 撞上限的行是陷在重复循环里的，任何 cap 都填得满。
# 改这个值必须整张结果表一起重评，不能和旧数字混用。
MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS:-2048}"
EVAL_LIMIT="${EVAL_LIMIT:-0}"
EVAL_BATCH="${EVAL_BATCH:-32}"
# math 的解码 batch 刻意给大值，理由不是显存而是 generate 的退出条件。
#
# GSM8K 上实测 12.2% 的响应不吐 EOS（数学题上就是陷入重复循环），而 model.generate
# 只在**批内所有行都结束**时才退出。batch=32 时一批撞上限的概率是
# 1-(1-0.122)^32 = 98.4%，也就是几乎每批都要跑满 MATH_MAX_NEW_TOKENS 步。所以墙钟
# 正比于**批数**，跟平均响应长度无关。
#
# decode 阶段是权重带宽瓶颈：每一步都要把 3.1GB 的 bf16 权重读一遍，不管批内是 32
# 行还是 128 行，单步耗时几乎不变。少的是批数，所以墙钟正比于批数。
#
# **换成 Qwen2.5-Math-1.5B 之后 KV cache 便宜了 4 倍**，这一节的账要重算：
#   Qwen3-1.7B      28 层 / **8** 个 KV head / head_dim 128 / bf16 -> 每 token 112 KiB
#   Qwen2.5-Math-1.5B 28 层 / **2** 个 KV head / head_dim 128 / bf16 -> 每 token  28 KiB
# KV head 从 8 降到 2（GQA 分组更狠），再叠上 cap 从 4096 降到 2048，单序列显存是
# 原来的 1/8：prompt+2048 约 2200 token = 2200 x 28 KiB = **60 MiB/序列**。
#
# 批数 = ceil(1319/B) + ceil(500/B) + ceil(83/B)（GSM8K / MATH-500 / AMC 各自分桶，
# 不是 1902/B）。下表按上面的单序列 60 MiB 推算，**是算出来的不是实测的**：
#
#   B    批数   KV 稳态   +concat 瞬时   +权重/上下文   峰值      140GiB 占用
#   64    30     3.8 GiB    0.13 GiB       5.1 GiB      9.0 GiB      6%
#  128    16     7.5 GiB    0.27 GiB       5.1 GiB     12.9 GiB      9%    <- 默认
#  256     9    15.0 GiB    0.54 GiB       5.1 GiB     20.7 GiB     15%
#  512     5    30.1 GiB    1.07 GiB       5.1 GiB     36.3 GiB     26%
#
# "concat 瞬时"是 HF DynamicCache 每步每层做 torch.cat 时新旧张量并存的那一层，
# = KV 稳态 / 28 层。"权重/上下文" = 3.1 GiB bf16 权重 + 约 2 GiB CUDA context 和
# cuBLAS workspace（逐步的 logits 只有 batch x 151936 x 4 B，128 下 74 MiB，可忽略）。
#
# 默认仍取 128：它在 OpenR1/4096/1.7B 那轮实测占了 70.3 GiB 并跑通过，现在同一个值
# 只占约 13 GiB，安全边际极大。想再快就上 256（批数 16->9）或 512（->5），显存都还
# 很宽裕 —— 但**必须在跑第一个 run 之前定死**：换 batch 会换 left padding 宽度和
# kernel 选择，贪心输出会有微小漂移，中途换会让整张表不可比
# （generation.py 开头那段 "a mix of old and new numbers is not comparable"）。
# 真实峰值不用猜——evaluate 每个指标跑完会打一行 peak GPU memory，看那个数再决定。
#
# 换 batch 会换 left padding 的宽度和 kernel 选择，贪心输出可能有微小漂移，所以
# **同一张结果表里的所有 run 必须用同一个 MATH_BATCH 重评**——generation.py 开头
# 那段"a mix of old and new numbers is not comparable"就是在说这件事。
MATH_BATCH="${MATH_BATCH:-128}"
# 两层隔离：RESULTS_ROOT 已经按模型分开（所以 Qwen3 那一轮的数字完全碰不到），
# 这一层再按 cap 分目录，于是同一个模型下 2048 / 4096 / 8192 三个预算的结果也不会
# 混进同一张表。checkpoint 仍从 ${CKPT_DIR} 读，不受影响。
# 想覆盖原目录就提交时传 EVAL_OUT_DIR=${RESULTS_ROOT} FORCE_EVAL=1。
EVAL_OUT_DIR="${EVAL_OUT_DIR:-${RESULTS_ROOT}/eval_cap${MATH_MAX_NEW_TOKENS}}"
DIAG_LEN="${DIAG_LEN:-1}"

# run 名**刻意保持** part1_math_lr<LR>_seed<SEED> 这个形状：99/100 号发现 Stage 1
# checkpoint 的三条路径里有两条依赖它（MATH_LR 拼名、以及 glob
# "part1_math_lr*_seed${SEED}"）。把 MODEL_NAME 塞进 run 名会让那两条同时失效，
# 所以模型的区分放在 RESULTS_ROOT 上，见上面 RESULTS_ROOT 的注释。
RUN="part1_math_lr${LR}_seed${SEED}"
CKPT="${CKPT_DIR}/${RUN}"
RUNS_TO_EVAL="${RUNS_TO_EVAL:-base trained}"

mkdir -p "${RESULTS_ROOT}/datasets" "${METRICS_DIR}" "${CKPT_DIR}" \
  "${DATASET_CACHE}" "${RESULTS_ROOT}/map_cache"

[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }

echo "========================================================================"
echo "Part 1 / Math 线: Base --NuminaMath-CoT 50k--> Model-Math   (full finetune, vanilla)"
echo "  MODE           : ${MODE}"
echo "  model          : ${MODEL_DIR}/${MODEL_NAME}"
echo "  results root   : ${RESULTS_ROOT}"
echo "  数据池         : ${MATH_DATASET}"
echo "                   (save_to_disk 根目录；val 从该池 val_fraction 切，不读 *_test.jsonl)"
echo "  think / prompt : ${THINK_HANDLING} / ${INSTRUCTION_STYLE}"
echo "                   (Numina 无 <think> 标签，strip_tags 是空操作；prompt 仍 eval_aligned)"
echo "  超参           : epochs=${EPOCHS} lr=${LR} ${LR_SCHEDULER} warmup=${WARMUP_RATIO}"
echo "                   batch=${BATCH} accum=${ACCUM} maxlen=${MAXLEN}"
echo "                   (对标 DFT/ICLR2026 Table 1 的 Qwen2.5-Math-1.5B w/SFT 行)"
echo "  评测           : math500, amc, gsm8k   (对照 base)"
echo "                   max_new_tokens=${MATH_MAX_NEW_TOKENS} batch=${MATH_BATCH} stop_on_im_end=${STOP_ON_IM_END}"
echo "  eval out       : ${EVAL_OUT_DIR}   (FORCE_EVAL=${FORCE_EVAL})"
echo "  checkpoint     : ${CKPT}"
echo "========================================================================"
if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只打印配置，不跑。"
  exit 0
fi

# =============================================================================
# 共用训练封装：vanilla 全量微调
#   --full_finetune 1
#   --replay_lambda 0 --measure_replay_when_lambda_zero 0   -> 不加载任何 penalty
# =============================================================================
train_one () {
  local run="$1" epochs="$2" lr="$3" save_path="$4" max_steps="${5:-0}" do_save="${6:-1}"
  local log_every="${7:-${LOG_EVERY}}"

  mkdir -p "${RESULTS_ROOT}/map_cache/${run}"
  echo "==== train ${run} (lr=${lr} ${LR_SCHEDULER} warmup=${WARMUP_RATIO} maxlen=${MAXLEN} batch=${BATCH} max_steps=${max_steps}) ===="
  python -m onereplay.scripts.train --paradigm sft --full_finetune 1 \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
    --system_prompt "${SYSTEM_PROMPT}" \
    --dataset_path "${MATH_DATASET}" \
    --epochs "${epochs}" --lr "${lr}" \
    --lr_scheduler "${LR_SCHEDULER}" --warmup_ratio "${WARMUP_RATIO}" \
    --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
    --max_len "${MAXLEN}" \
    --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" \
    --eval_batch_size "${BATCH}" \
    --max_train_samples "${MAX_TRAIN_SAMPLES}" \
    --target_modules "${TARGET_MODULES}" \
    --map_cache_dir "${RESULTS_ROOT}/map_cache/${run}" \
    --replay_lambda 0 --measure_replay_when_lambda_zero 0 \
    --max_steps "${max_steps}" --log_every "${log_every}" \
    --save "${do_save}" --save_path "${save_path}" \
    --metrics_path "${METRICS_DIR}/${run}.jsonl"
}

# =============================================================================
# MODE=data：OpenR1 (verl 的 RL schema) -> {instruction, input, output} 的 save_to_disk
#
# 源 schema 是 prompt=[system,user] / target=[assistant] / reward_model.ground_truth，
# 不是 SFT 的三列，所以要摊平。转换脚本会打印 think 标签命中率、\boxed 覆盖率，以及
# 每个候选 MAXLEN 的截断率 / "question gone" / "tok per epoch"。
# **先读长度报告再定 MAXLEN**：截断是保尾丢头的，错了不报错，只会悄悄毁掉数据。
# =============================================================================
if [[ "${MODE}" == "data" ]]; then
  if [[ -f "${MATH_DATASET}/dataset_dict.json" ]]; then
    echo "拒绝 MODE=data：${MATH_DATASET} 已经是一个 save_to_disk 池"
    echo "  （有 dataset_dict.json）。prepare_openr1_math 会把 --out_dir 整目录覆盖掉。"
    echo "  Numina 50k 已经备好，直接 MODE=smoke / MODE=train。若真要重建 OpenR1 池，"
    echo "  另指定 MATH_DATASET=<新目录>，不要指向 datasets/numina_math_100k。"
    exit 1
  fi
  if [[ ! -f "${OPENR1_PARQUET}" ]]; then
    echo "缺 OpenR1 parquet。在这些目录里找过 *.parquet 和 data/*.parquet："
    for _dir in "${OPENR1_DIRS[@]}"; do
      echo "  ${_dir}/"
    done
    echo "把 parquet 放到其中之一，或提交时传 OPENR1_PARQUET=<绝对路径>"
    exit 1
  fi
  echo "OpenR1 parquet: ${OPENR1_PARQUET}"

  echo "==== data: OpenR1-Math -> ${MATH_DATASET} ===="
  python -m onereplay.scripts.prepare_openr1_math \
    --openr1_path "${OPENR1_PARQUET}" \
    --out_dir "${MATH_DATASET}" \
    --think_handling "${THINK_HANDLING}" \
    --instruction_style "${INSTRUCTION_STYLE}" \
    --require_boxed "${REQUIRE_BOXED}" \
    --max_len "${MAXLEN}" \
    --replay_rows "${REPLAY_ROWS}" \
    --replay_out "${REPLAY_POOL}" \
    --replay_sample_seed "${REPLAY_SAMPLE_SEED}" \
    --tokenizer_path "${MODEL_DIR}/${MODEL_NAME}"

  echo "数据准备完成。**先看长度报告**：确认 question gone ≈ 0，并用 tok/epoch 反推"
  echo "训练时长，再决定 MAXLEN / EPOCHS，然后 MODE=smoke 冒烟。"
  if (( REPLAY_ROWS > 0 )); then
    echo ""
    echo "另外写了反向线（Math -> IF）的旧知识池: ${REPLAY_POOL}"
    echo "它是训练池的 nested 随机子集，训练池本身逐字不变，所以已有的 Model-Math"
    echo "checkpoint 依然有效。99 号采 C_math 读的就是这个文件。"
  fi
  exit 0
fi

if [[ "${MODE}" != "eval" ]]; then
  [[ -d "${MATH_DATASET}" ]] || { echo "缺 Math 池: ${MATH_DATASET}（先跑 MODE=data）"; exit 1; }
fi

# =============================================================================
# MODE=smoke：跑几十步、不保存。这条线的冒烟要同时量两件事：
#
#   1) **显存**：MAXLEN x BATCH = 2048 x 4 是否真的装得下，峰值离卡容量还有多少余量。
#   2) **吞吐**：日志里的 tokens_per_sec。全参微调没有实测值，文件头那个
#      "1 epoch 1.0-1.9 h" 是按 8-15k tok/s 估的。用实测值除 55.6M tok/epoch
#      才是真实 epoch 时长。
#   3) **scheduler 真的接上了**：日志的 step 行里必须出现 lr= 字段，而且它应当在
#      warmup 期内上升。没有这个字段就说明 --lr_scheduler 没传到（train.py 只在
#      scheduler 非 None 时打它），那这一轮就是恒定 LR，不是论文配方。
#
# 70 步（=70 micro-batch）对 tokens_per_sec 够用：它是按 train_sec 算的窗口均值，
# 但前几步含 cold start，所以看日志里 win= 那个窗口值更准。
# 另外确认 trainable params ≈ 1.54e9、loss 在动。
#
# 注意 SMOKE_STEPS=70 时 horizon 也只有 ceil(70/16)=5 次更新，warmup 占 1 次，
# 所以 lr 会在 5 步内走完一整条 cosine —— 这是预期行为，冒烟不是在看 LR 曲线形状，
# 只是确认字段在、数值在动。
# =============================================================================
if [[ "${MODE}" == "smoke" ]]; then
  train_one "smoke_math" 1 "${LR}" "${CKPT_DIR}/smoke_math" "${SMOKE_STEPS}" 0 1
  echo "冒烟完成。看三件事（前两个在 ${METRICS_DIR}/smoke_math.jsonl 里）："
  echo "  peak_memory_gb  -> 2048x4 的真实峰值，离卡容量还剩多少"
  echo "  tokens_per_sec  -> 用 55.6M / 它 = 单卡真实 epoch 秒数"
  echo "  上面 step 日志里有没有 lr= 字段 -> 没有就是 scheduler 没接上，停下来查"
  exit 0
fi

# =============================================================================
# MODE=lr_sweep：全量的 LR 必须用数据选，且不能沿用 IF 线的结果（见文件头）。
# 每个 LR 只跑 SWEEP_MAX_STEPS 步、不保存权重，比同一步数下的 val loss。
# =============================================================================
if [[ "${MODE}" == "lr_sweep" ]]; then
  echo "grid=${LR_GRID}"
  echo "每档 ${SWEEP_MAX_STEPS} micro-batch = $(( SWEEP_MAX_STEPS / (ACCUM / BATCH) )) 次优化器更新 = $(( SWEEP_MAX_STEPS * BATCH )) 行"
  for lr in ${LR_GRID}; do
    train_one "sweep_math_lr${lr}" 1 "${lr}" "${CKPT_DIR}/sweep_math_lr${lr}" \
      "${SWEEP_MAX_STEPS}" 0 "${SWEEP_LOG_EVERY}"
  done
  echo "==== LR sweep val loss（同步数下比较，${SWEEP_MAX_STEPS} 步）===="
  for lr in ${LR_GRID}; do
    f="${METRICS_DIR}/sweep_math_lr${lr}.jsonl"
    if [[ -f "${f}" ]]; then
      echo "lr=${lr}: $(python - "${f}" <<'PY'
import json, sys
rows = [json.loads(line) for line in open(sys.argv[1]) if line.strip()]
values = [r.get("val_loss") for r in rows if r.get("val_loss") is not None]
print(values[-1] if values else "n/a")
PY
)"
    fi
  done
  echo
  echo "别只看这张表：回到上面每档的 task_loss 轨迹，确认没有中途抬头/抖动/nan。"
  echo "在都不发散的前提下，选边际收益已经塌缩的那个膝点，而不是末值最小的那个。"
  exit 0
fi

# =============================================================================
# MODE=train：正式训练 Model-Math
# =============================================================================
if [[ "${MODE}" == "train" && "${DO_TRAIN}" == "1" ]]; then
  if [[ -d "${CKPT}" ]]; then
    echo "跳过训练：${CKPT} 已存在（删掉可重跑）"
  else
    train_one "${RUN}" "${EPOCHS}" "${LR}" "${CKPT}" 0 1
  fi
  echo "训练完成。checkpoint 是完整权重目录，可直接作为 Part 2 下一阶段的起点："
  echo "  --model_dir ${CKPT_DIR} --model_name ${RUN}"
fi

# =============================================================================
# MODE=eval：base 与 Model-Math 各测 GSM8K + MATH-500
#
# 一次 evaluate 调用只加载模型一次，两个指标共用。
# 全量 checkpoint 直接传 --adapter_path：runner 的 load_eval_model 先用
# is_lora_adapter_dir 判断，没有 adapter_config.json 就把该目录当完整模型加载。
# =============================================================================
if [[ "${MODE}" == "eval" || ( "${MODE}" == "train" && "${DO_EVAL}" == "1" ) ]]; then
  METRICS=""
  if [[ -f "${GSM8K_DATA}" ]]; then
    METRICS="${METRICS},gsm8k"
  else
    echo "跳过 GSM8K：未找到 ${GSM8K_DATA}（prepare_math_data.py 产出）"
  fi
  if [[ -f "${MATH500_DATA}" ]]; then
    METRICS="${METRICS},math500"
  else
    echo "跳过 MATH-500：未找到 ${MATH500_DATA}"
  fi
  if [[ -f "${AMC_DATA}" ]]; then
    METRICS="${METRICS},amc"
  else
    echo "跳过 AMC：未找到 ${AMC_DATA}"
  fi
  METRICS="${METRICS#,}"
  [[ -n "${METRICS}" ]] || { echo "没有可用指标，评测退出"; exit 1; }

  run_eval () {
    local name="$1" ckpt="$2"
    local -a ckpt_arg=()
    if [[ -n "${ckpt}" ]]; then ckpt_arg=(--adapter_path "${ckpt}"); fi

    if [[ -f "${EVAL_OUT_DIR}/math500/${name}/summary.json" && "${FORCE_EVAL}" != "1" ]]; then
      echo "跳过评测 ${name}：已有 ${EVAL_OUT_DIR}/math500/${name}/summary.json（FORCE_EVAL=1 强制重评）"
      return 0
    fi
    echo "==== eval ${name} (${METRICS}) cap=${MATH_MAX_NEW_TOKENS} batch=${MATH_BATCH} -> ${EVAL_OUT_DIR} ===="
    python -m onereplay.scripts.evaluate \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
      "${ckpt_arg[@]}" --run_name "${name}" \
      --metrics "${METRICS}" --out_dir "${EVAL_OUT_DIR}" --seed "${SEED}" \
      --system_prompt "${SYSTEM_PROMPT}" \
      --limit "${EVAL_LIMIT}" \
      --eval_batch_size "${EVAL_BATCH}" --math_batch_size "${MATH_BATCH}" \
      --gsm8k_data_path "${GSM8K_DATA}" \
      --math500_data_path "${MATH500_DATA}" \
      --amc_data_path "${AMC_DATA}" \
      --math_max_new_tokens "${MATH_MAX_NEW_TOKENS}" \
      --decode_stop_on_im_end "${STOP_ON_IM_END}" \
      --map_cache_dir "${RESULTS_ROOT}/map_cache/eval_seed${SEED}"
  }

  for which in ${RUNS_TO_EVAL}; do
    case "${which}" in
      base) run_eval "base" "" ;;
      trained)
        if [[ -d "${CKPT}" ]]; then
          run_eval "${RUN}" "${CKPT}"
        else
          echo "跳过 ${RUN}：checkpoint 不存在（${CKPT}）"
          echo "MODE=eval 的 LR/SEED 必须和训练时一致（默认都是 lr=5e-5 seed=1），"
          echo "否则拼出来的 run 名对不上。另外确认 RESULTS_ROOT 指向的是同一个模型的树："
          echo "  当前 = ${RESULTS_ROOT}"
        fi
        ;;
      *) echo "未知 run: ${which}" ;;
    esac
  done

  # 长度/截断诊断：hit-cap 接近 0 且 P99 明显低于 cap 才算预算够用。
  if [[ "${DIAG_LEN}" == "1" ]]; then
    DIAG_FILES=()
    for which in ${RUNS_TO_EVAL}; do
      case "${which}" in
        base) name="base" ;;
        trained) name="${RUN}" ;;
        *) continue ;;
      esac
      for metric in gsm8k math500 amc; do
        f="${EVAL_OUT_DIR}/${metric}/${name}/responses.jsonl"
        [[ -f "${f}" ]] && DIAG_FILES+=("${f}")
      done
    done
    if [[ ${#DIAG_FILES[@]} -gt 0 ]]; then
      python - "${MODEL_DIR}/${MODEL_NAME}" "${MATH_MAX_NEW_TOKENS}" "${DIAG_FILES[@]}" <<'PY'
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

model_path, cap = sys.argv[1], int(sys.argv[2])
tokenizer = AutoTokenizer.from_pretrained(model_path, trust_remote_code=True)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


print(f"==== response length / truncation diagnostic (cap={cap}) ====")
for path in sys.argv[3:]:
    file = Path(path)
    if not file.is_file():
        continue
    rows = [json.loads(line) for line in file.open(encoding="utf-8") if line.strip()]
    if not rows:
        continue
    lengths = sorted(
        len(tokenizer(row.get("response", ""), add_special_tokens=False)["input_ids"])
        for row in rows
    )
    missing = sum(row.get("prediction") in (None, "") for row in rows)
    hit_cap = sum(length >= cap - 8 for length in lengths)
    label = f"{file.parent.parent.name}/{file.parent.name}"
    print(
        f"{label:>40}: n={len(rows)} "
        f"no-answer={missing} ({missing / len(rows):.1%}) "
        f"hit-cap={hit_cap} ({hit_cap / len(rows):.1%}) "
        f"P50={pct(lengths, 50)} P90={pct(lengths, 90)} P99={pct(lengths, 99)} max={lengths[-1]}"
    )
print("hit-cap 接近 0 且 P99 明显低于 cap => 预算够用。hit-cap 仍高时**先看是不是重复循环**")
print("（撞上限那些行的尾部 distinct-shingle 低到约 0.1 就是），那种情况加 cap 没用；")
print("确认是真的写不完再把 MATH_MAX_NEW_TOKENS 提上去并**所有 run 一起重评**。")
PY
    fi
  fi
fi

echo "========================================================================"
echo "产物:"
echo "  Math 池      : ${MATH_DATASET}"
echo "  checkpoint   : ${CKPT}"
echo "  评测         : ${EVAL_OUT_DIR}/{gsm8k,math500,amc}/<run>/summary.json"
echo "  汇总 csv     : ${EVAL_OUT_DIR}/{gsm8k,math500,amc}_summary.csv"
echo "  Qwen3 旧结果 : ${REPO_ROOT}/results_part1_numina_math/  （另一个模型，未触碰）"
echo ""
echo "接 Part 3（99/100 号）时记得带："
echo "  MATH_LINE_ROOT=${RESULTS_ROOT}"
echo ""
echo "怎么读结论: Model-Math 的 MATH-500/AMC/GSM8K 明显高于 base => NuminaMath 确实"
echo "            教会了数学推理，这条线的 sanity check 通过。"
echo "            MATH-500 是同分布上限（训练 prompt 与它一致），AMC 同口径但更难，"
echo "            GSM8K 是跨格式泛化（要求 '####'，训练时没见过），后者偏低是正常的。"
echo "            外部参照是 DFT/ICLR2026 Table 1：Qwen2.5-Math-1.5B 的 MATH-500"
echo "            31.66 -> w/SFT 43.76。**但那是 temperature 1.0 的 Average@16，"
echo "            我们这里是 greedy@1，绝对值通常偏高，只能比方向和幅度。**"
echo "            AMC 的文件是 AMC12 2022+2023 83 题，不是论文的 AMC23 40 题。"
echo "            先看作业末尾的 length diagnostic：hit-cap 还高就不是能力不行，是预算"
echo "            仍不够。这批数字必须和 4096/8192 那两次分开读，不能混进同一张表。"
echo "Job finished at: $(date)"
