#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_opcewc
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/logs/onereplay/
#
# =============================================================================
# NUS Hopper (PBS + Singularity): OPC 代码线的 EWC 基线（F_mix 混合 + λ 扫描 + 评测）
#   旧知识 = F_if(FLAN gold) + F_code(opc-sft-stage2/educational_instruct 自蒸馏)，
#   两个变体只差「怎么混」这一个变量：
#
#     variant equal : --equalize mean  -> if:code ≈ 0.265:0.735，两域等 Fisher 质量贡献
#     variant half  : --weights 0.5,0.5 -> 原始等系数，if 按 2.77x 主导（= replay0.5 的类比）
#
#   与 52 号（OneReplay C_mix 代码线）共用同一套 HumanEval/MBPP 评测口径；与 48 号
#   （数学 EWC）逐字共用训练超参与自检，唯一区别是 F_code 换成 OPC 池、评测换成代码侧。
#   于是三向对比成立：EWC(F_mix) vs OneReplay(C_mix) vs vanilla，同评测、同训练超参。
#
# -----------------------------------------------------------------------------
# 为什么是两个变体，而不是随手取 0.5/0.5
#   F 是 sequence-summed 分数（estimator 名字里就带 sequence_sum、reduction=sum），
#   域间天然差一个尺度：实测 mean(F_if)=9.997e-2、mean(F_code)=3.613e-2，if 大 2.77x
#   （51 号 inspect_fisher）。注意这与 C 侧的结论相反——C 是 token 均值，实测
#   trace(C_code)/trace(C_if)=0.886≈1，所以 C_mix 用裸的 0.5/0.5 本身就是等权；F 不是，
#   必须先按尺度归一。于是：
#     half  = 直接 0.5·F_if + 0.5·F_code，罚项里 if 拿 2.77x 的份额（73.5% vs 26.5%），
#             和 replay 的原始等系数混合是同一件事，作为「不做尺度归一」的对照臂。
#     equal = 各自除以自己的 mean 再 0.5/0.5（等价 1/mean 归一权重 0.265/0.735，
#             两域权重比 = mean 的反比 = m_code:m_if），两域在罚项里等量贡献。
#             mix_fishers.py --equalize mean 在运行时读两个文件的 mean 现算权重，
#             换了重采的 F 会自动更新，不会像硬编码 0.265 那样过期。
#   两版都跑，最后按结果挑。
#
#   !! F_if 是两域里更弱的一方，写结果时要记：ESS 2599/20000(0.130) vs F_code 的
#      11135/19823(0.562)，且 F_if 有 1408 行零监督、6 处 prompt mask 错位。它是 47 号
#      的既有产物、数学线用的也是它，所以不重采（重采会毁掉与数学线的可比性）。
#
# 【λ 网格：别照 51 号文末的 3e2 猜，也别照 OneReplay 的 3e-2 对齐】
#   51 号文末写"λ=3e2 是对 mean(F_if) 调的"，那是 IF 线的**预估值**，48 号 08-29 的
#   300 步短探已证明这个量级完全错。EWC 的 λ 与 OneReplay 的 λ 尺度差约 1e5
#   （F 逐元素 vs C 沿 hidden 收缩一次），拿 3e-2 给 EWC ≈ 无约束、直接退回 vanilla。
#
#   48 号数学线的实测锚点（300 步短探，λ·R 占 task_loss）：
#       λ      equal (mean≈0.042)     half (mean≈0.063)
#       0.3        1.6%                  2.5%
#       1          5.2%                  7.9%     <- 两版都在 1%–10% 目标带内
#       3         14.1%                 20.3%
#       10        35.9%                 47.1%
#       30        64.9%                 75.9%
#       100       86.9%                 90.3%
#
#   本线可以直接迁移，因为 F_code 相对 F_if 的尺度和 F_math 当年几乎一样：
#       mix mean   数学 equal 0.042 / half 0.063
#                  本线 equal 0.0531 / half 0.0681   -> 只大 1.26x / 1.08x
#   按 λ·mean 折算，本线在 λ=1 处的占比外推约 equal 6.6% / half 8.5%，**仍在 1%–10%
#   目标带内**。所以默认 LAMBDAS=1 单点，与 48 号同点，两条线可直接并排读。
#
#   !! 这个外推只在温和带（占比 <10%）可靠：λ 变大后 ΔW 被压小、R 跟着掉，实际占比是
#      次线性的，λ≥3 的外推会偏高。所以正式投之前**必须先跑 PROBE 实测**（几分钟）。
#      λ≥10 是强端边界，30/100 是锁死区（65–90%），纯亏不跑。
#
#   要扩成 retention–plasticity 曲线传 LAMBDAS="0.3 1 3"（3×2 版×约 5.7h，需拆投）。
#   不要为两版 mean 不同强行对齐幅度（那会改变语义），两版共用同一 λ、各取最优。
#
#   整组是 2 变体 × |LAMBDAS| × 约 5.7 h 训练 + 约 1~2 h/run 评测，很容易超 24 h。所以：
#     1) 先探针，只看罚项量级，不保存不评测（每变体几分钟）：
#          qsub -v PROBE=1 onereplay/pbs/55_opc_code_ewc_mix.pbs
#        PROBE 等价 SAVE=0 MAX_STEPS=300 DO_EVAL=0，且只取 LAMBDAS 里最小的一档
#        （λ 给大了 ΔW 被压住、R 跟着变小，会误判成"还要再加大"）。
#     2) 按探到的中心值改 LAMBDAS，正式整组投；已存在的 adapter 会跳过，超时后原样
#        再投即续跑。卡时紧就拆投：VARIANTS=equal 先跑一版，或 DO_EVAL=0 先训后评。
#
# -----------------------------------------------------------------------------
# 结果怎么读（照抄 23/48 号的告诫）
#   EWC-LoRA (arXiv 2602.17559) 实测 precomputed 固定 Fisher 塑性最低——EWC 很可能
#   不是"retention 更好"，而是"新任务学不动"。所以别各挑一个 λ 报点，要在相同
#   commonsense val_loss 处比 HumanEval/MBPP（和 IF）。训练自检会把 val_loss 和
#   vanilla 基线比一下并提示（传 VANILLA_VAL_LOSS=<值> 就会打差值）。
#
#   本线的三向对比（同训练超参、同评测口径）：
#     vanilla            未保护的一端（39 号已出代码结果）
#     OneReplay C_mix    52 号的 cs_onereplay_ifcode_opcedu_lam*  <- 主方法
#     EWC F_mix          本脚本的 cs_ewcmix_opcedu_{equal,half}_lam*
#   若 OneReplay 在等 val_loss 处优于 EWC，那就是"C 比固定 Fisher 更划算"的直接证据。
#
# -----------------------------------------------------------------------------
# !! 判分口径（都在 onereplay/eval/code_exec.py）——2026-08-31 修掉两个判错 bug
#   1) 清洗按题型分流。MBPP 走 AST 白名单（保留 import 与所有顶层 def）；HumanEval
#      保留函数体缩进并在装配时归一化。旧口径在第一个 '\ndef ' 处截断（腰斩以 import
#      开头的 MBPP 程序），且 strip() 吃掉函数体首行缩进（把 HumanEval 正解变成
#      'return' outside function）。详见 52 号头部的实测数字。
#   2) 黑名单只拦文件/进程/网络（os、subprocess、socket、requests、urllib、shutil、
#      open(、exec(、eval(、__import__）；sys / pathlib / pickle 已放开。
#   3) MBPP split 默认 validation（90 题），本脚本显式传 test（500 题）。
#   !! 修复前后的代码结果不可混用；旧 run 用 onereplay/scripts/rejudge_code_eval.py
#      重判（HumanEval 可精确复原，MBPP 必须重新生成）。
#
# -----------------------------------------------------------------------------
# 前置条件
#   1) ${FISHER_IF}   = results/fisher/fisher_flan_chat_20k_qv.pt          （47 号产物）
#   2) ${FISHER_CODE} = results/fisher/fisher_code_opcedu20k_qv.pt         （51 号产物）
#   3) ${CS_DATASET}  = datasets/commonsense_170k_hf                       （训练集）
#   4) 代码评测数据 ${CODE_DATA_DIR}/humaneval_test.parquet、mbpp_full/
#   5) mkdir -p /scratch/weiliu87/logs/onereplay   # qsub 之前必须存在，且在仓库外
#   F_mix 两份若已手工建好（fisher_if_code_opcedu20k_mix_{equal,half}_qv.pt），Step A
#   会自动跳过混合、只做自检；没建也没关系，DO_MIX=1 会现建。
#
# 用法
#   qsub -v PROBE=1 onereplay/pbs/55_opc_code_ewc_mix.pbs        # 探针：两版最小 λ 跑 300 步看罚项
#   qsub onereplay/pbs/55_opc_code_ewc_mix.pbs                   # 默认：两版(equal/half) × λ=1 训练 + 评测
#   qsub -v VARIANTS=equal onereplay/pbs/55_opc_code_ewc_mix.pbs # 只跑等贡献版
#   qsub -v 'LAMBDAS=0.3 1 3' onereplay/pbs/55_opc_code_ewc_mix.pbs  # 扩成曲线（默认单点 1）
#   qsub -v DO_EVAL=0 onereplay/pbs/55_opc_code_ewc_mix.pbs      # 只训练
#   qsub -v DO_TRAIN=0 onereplay/pbs/55_opc_code_ewc_mix.pbs     # F_mix 已就位、adapter 已训，只评测
#   qsub -v FORCE_MIX=1 onereplay/pbs/55_opc_code_ewc_mix.pbs    # 强制重建 F_mix
#   qsub -v DO_ANALYZE=1 onereplay/pbs/55_opc_code_ewc_mix.pbs   # 顺带出失败分桶
#   qsub -v WITH_IF=1 onereplay/pbs/55_opc_code_ewc_mix.pbs      # 顺带评 IF/CS 侧
#   冒烟（每指标前 20 题，产物自动改道到 _limit20）: qsub -v LIMIT=20 ...
#
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/55_opc_code_ewc_mix.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME CS_DATASET RESULTS_ROOT CODE_DATA_DIR DATASET_CACHE OUT_DIR
    FISHER_IF FISHER_CODE FISHER_MIX_EQUAL FISHER_MIX_HALF IF_COV CODE_COV
    DO_MIX FORCE_MIX DO_TRAIN DO_EVAL FORCE_TRAIN FORCE_EVAL DO_ANALYZE
    VARIANTS LAMBDAS PROBE SAVE MAX_STEPS PROFILE VANILLA_VAL_LOSS
    SEED EPOCHS LR BATCH ACCUM EVAL_BATCH MAXLEN VAL_FRAC MAXVAL TARGET_MODULES
    RUN_PREFIX MODELS EXTRA_MODELS
    CODE_MAX_NEW_TOKENS TIMEOUT LIMIT MBPP_SPLIT MBPP_CONFIG
    WITH_IF IFEVAL_INPUT MULTIIF_INPUT MULTIIF_LANG MULTIIF_LIMIT
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：那会把当前 shell 替换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的混合 + 训练 + 评测。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, torch.__file__, 'cuda', torch.cuda.is_available(), torch.cuda.device_count())"

# ---- 项目路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results}"
CS_DATASET="${CS_DATASET:-${REPO_ROOT}/datasets/commonsense_170k_hf}"
CODE_DATA_DIR="${CODE_DATA_DIR:-${REPO_ROOT}/datasets/code}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
ADAPTERS="${RESULTS_ROOT}/adapters"
export HF_DATASETS_CACHE="${DATASET_CACHE}"

# ---- 单域 F 输入与 F_mix 输出 ----
FISHER_IF="${FISHER_IF:-${RESULTS_ROOT}/fisher/fisher_flan_chat_20k_qv.pt}"
FISHER_CODE="${FISHER_CODE:-${RESULTS_ROOT}/fisher/fisher_code_opcedu20k_qv.pt}"
FISHER_MIX_EQUAL="${FISHER_MIX_EQUAL:-${RESULTS_ROOT}/fisher/fisher_if_code_opcedu20k_mix_equal_qv.pt}"
FISHER_MIX_HALF="${FISHER_MIX_HALF:-${RESULTS_ROOT}/fisher/fisher_if_code_opcedu20k_mix_half_qv.pt}"
# 可选：对应的协方差，仅用于打印/核对 F_mix 的源池是否与 C 同批（不硬拦）。
IF_COV="${IF_COV:-${RESULTS_ROOT}/cov/cov_flan_chat_20k_qv.pt}"
CODE_COV="${CODE_COV:-${RESULTS_ROOT}/cov/cov_code_opcedu20k_qv.pt}"

# ---- 阶段开关 ----
DO_MIX="${DO_MIX:-1}"
FORCE_MIX="${FORCE_MIX:-0}"
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"

# ---- 变体与 λ 网格 ----
VARIANTS="${VARIANTS:-equal half}"
LAMBDAS="${LAMBDAS:-1}"   # 48 号探针定的温和单点；扩曲线见文件头
# PBS 的 -v 用**逗号**分隔变量，值里的空格必须靠整体加单引号保住，见 52 号的写法：
#   qsub -v 'VARIANTS=equal,LAMBDAS=0.3 1 3' ...
# 所以千万别写 -v LAMBDAS=0.3,1,3 —— PBS 会拆成 LAMBDAS=0.3 外加两个名叫 1 和 3 的变量。
# 下面两行只是容错：直接在 shell 里 export 时用逗号也能work，走 qsub 时轮不到它。
LAMBDAS="${LAMBDAS//,/ }"
VARIANTS="${VARIANTS//,/ }"

# ---- 探针短跑：只看罚项量级，不保存不评测 ----
PROBE="${PROBE:-0}"
SAVE="${SAVE:-1}"
MAX_STEPS="${MAX_STEPS:-0}"
PROFILE="${PROFILE:-0}"
VANILLA_VAL_LOSS="${VANILLA_VAL_LOSS:-}"
if [[ "${PROBE}" == "1" ]]; then
  SAVE=0
  MAX_STEPS="${MAX_STEPS:-0}"; [[ "${MAX_STEPS}" == "0" ]] && MAX_STEPS=300
  DO_EVAL=0
  # 探针只取网格里最小的一档：λ 给大了 R 反而变小，会误判方向。
  LAMBDAS="$(printf '%s\n' ${LAMBDAS} | sort -g | head -n 1)"
  echo "PROBE=1：SAVE=0 MAX_STEPS=${MAX_STEPS} DO_EVAL=0，LAMBDAS 收窄为最小档 ${LAMBDAS}"
fi

# ---- 训练超参：与 23/47 号逐字相同，唯一变量是 --fisher_path 与 λ ----
SEED="${SEED:-1}"
EPOCHS="${EPOCHS:-3}"
LR="${LR:-1e-4}"
# BATCH 是 micro-batch，ACCUM 是「每次更新的总行数」。EWC 没有回放占位，每次更新的
# 新任务行数就等于 ACCUM=64，与 23/47 号一致。BATCH=16 只是把它拆成更少的 micro-batch
# 提高 H200 利用率，不改每次更新的行数；要复现旧 run 就保持 8。
BATCH="${BATCH:-8}"
ACCUM="${ACCUM:-64}"
EVAL_BATCH="${EVAL_BATCH:-8}"   # 钉住，否则 val_loss 与 42/48/52 号不可比
MAXLEN="${MAXLEN:-512}"
VAL_FRAC="${VAL_FRAC:-0.01}"
MAXVAL="${MAXVAL:-1000}"
TARGET_MODULES="${TARGET_MODULES:-q_proj,v_proj}"
# !! _opcedu 中缀是关键：不带它会和 48 号数学线的 cs_ewcmix_* adapter 撞名。
RUN_PREFIX="${RUN_PREFIX:-cs_ewcmix_opcedu}"

# ---- 代码评测参数（与 39/42/52 号一致，所有 run 必须同预算才可比）----
MBPP_CONFIG="${MBPP_CONFIG:-full}"
MBPP_SPLIT="${MBPP_SPLIT:-test}"
CODE_MAX_NEW_TOKENS="${CODE_MAX_NEW_TOKENS:-512}"
TIMEOUT="${TIMEOUT:-10}"
LIMIT="${LIMIT:-0}"
DO_ANALYZE="${DO_ANALYZE:-0}"        # 失败分桶默认不跑，只读 responses.jsonl，可事后补

HUMANEVAL_FILE="${CODE_DATA_DIR}/humaneval_test.parquet"
MBPP_DIR="${CODE_DATA_DIR}/mbpp_${MBPP_CONFIG}"

# LIMIT>0 的产物只覆盖前 N 题，写进正式目录会被"已有 summary.json 就跳过"的逻辑
# 当成完整结果挡住后续正式评测（坑 #7）。这里自动改道。
OUT_DIR="${OUT_DIR:-${RESULTS_ROOT}}"
if [[ "${LIMIT}" != "0" ]]; then
  OUT_DIR="${OUT_DIR}_limit${LIMIT}"
fi

WITH_IF="${WITH_IF:-0}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"
MULTIIF_INPUT="${MULTIIF_INPUT:-${REPO_ROOT}/onereplay/third_party/Multi-IF/multiIF_20241018.csv}"
MULTIIF_LANG="${MULTIIF_LANG:-English}"
MULTIIF_LIMIT="${MULTIIF_LIMIT:-0}"

MODELS="${MODELS:-}"
EXTRA_MODELS="${EXTRA_MODELS:-}"

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
[[ -d "${CS_DATASET}" ]] || { echo "缺 commonsense_170k: ${CS_DATASET}"; exit 1; }
grep -q "regularizer" onereplay/scripts/train.py || {
  echo "train.py 里没有 --regularizer，代码没同步到最新"; exit 1
}
if (( ACCUM % BATCH != 0 )); then
  echo "ACCUM=${ACCUM} 不能被 BATCH=${BATCH} 整除，每次更新的行数会被静默取整"; exit 1
fi
mkdir -p "${ADAPTERS}" "${RESULTS_ROOT}/metrics" "${RESULTS_ROOT}/fisher" "${DATASET_CACHE}"

# ---- variant -> F_mix 路径 / 混合模式 / run 名 ----
variant_fisher () {
  case "$1" in
    equal) echo "${FISHER_MIX_EQUAL}" ;;
    half)  echo "${FISHER_MIX_HALF}" ;;
    *)     echo "" ;;
  esac
}
variant_mix_args () {
  case "$1" in
    equal) echo "--equalize mean" ;;
    half)  echo "--weights 0.5,0.5" ;;
    *)     echo "" ;;
  esac
}
run_name () {
  # $1=variant $2=lambda
  echo "${RUN_PREFIX}_$1_lam$2_seed${SEED}"
}

echo "VARIANTS=[${VARIANTS}]  LAMBDAS=[${LAMBDAS}]  SEED=${SEED}"
echo "BATCH=${BATCH} ACCUM=${ACCUM}(行/更新) MAXLEN=${MAXLEN} EVAL_BATCH=${EVAL_BATCH}"
echo "评测: MBPP split=${MBPP_SPLIT}(config=${MBPP_CONFIG}) CODE_MAX_NEW=${CODE_MAX_NEW_TOKENS} TIMEOUT=${TIMEOUT} LIMIT=${LIMIT}"
echo "OUT_DIR=${OUT_DIR}  RUN_PREFIX=${RUN_PREFIX}"
echo "F_if   = ${FISHER_IF}"
echo "F_code = ${FISHER_CODE}"
for v in ${VARIANTS}; do
  [[ -n "$(variant_fisher "${v}")" ]] || { echo "未知 VARIANT=${v}，可选 equal / half"; exit 1; }
  echo "  variant ${v}: mix_args='$(variant_mix_args "${v}")' -> $(variant_fisher "${v}")"
done

# ===========================================================================
# Step A: 构造 F_mix（两个变体各一份），并逐份自检
#   自检不走 inspect_fisher 完整模式：mix 产物没有 length_weighting 元数据（那是
#   采集阶段的估计诊断），只有 fisher_scale。改为直接读 metadata 校验混合语义：
#     equal -> mode=equalize:mean 且两域 contribution 相等
#     half  -> mode=explicit 且 weights=[0.5,0.5]
# ===========================================================================
if [[ "${DO_MIX}" == "1" ]]; then
  [[ -f "${FISHER_IF}" ]]   || { echo "缺 F_if: ${FISHER_IF}（47 号产物）"; exit 1; }
  [[ -f "${FISHER_CODE}" ]] || { echo "缺 F_code: ${FISHER_CODE}（51 号产物）"; exit 1; }

  for v in ${VARIANTS}; do
    fmix="$(variant_fisher "${v}")"
    if [[ "${FORCE_MIX}" != "1" && -f "${fmix}" ]]; then
      echo "跳过混合 ${v}：${fmix} 已存在（FORCE_MIX=1 可强制重建）"
    else
      echo "==== Step A: mix ${v} -> ${fmix} ===="
      # shellcheck disable=SC2046
      python -m onereplay.mix_fishers \
        --inputs "${FISHER_IF},${FISHER_CODE}" \
        $(variant_mix_args "${v}") \
        --output_path "${fmix}"
    fi

    echo "==== Step A 自检: ${v} ===="
    python - "${fmix}" "${v}" "${IF_COV}" "${CODE_COV}" <<'PY'
import sys
from pathlib import Path

import torch

fmix_path, variant, if_cov, code_cov = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
payload = torch.load(fmix_path, map_location="cpu")
meta = payload.get("metadata", {})

if meta.get("type") != "weighted_fisher_mix":
    raise SystemExit(f"{fmix_path} 不是 mix_fishers 产物 (type={meta.get('type')!r})")

weights = meta.get("weights", [])
means = meta.get("input_means", [])
contrib = meta.get("input_contributions", [])
scale = meta.get("fisher_scale", {})
src_fp = meta.get("source_pool_fingerprints", [])
print(f"variant          = {variant}")
print(f"mode             = {meta.get('mode')}")
print(f"inputs           = {meta.get('inputs')}")
print(f"weights          = {weights}")
print(f"input_means      = {means}")
print(f"contributions    = {contrib}  (w_i * mean_i)")
print(f"mix mean/max     = {scale.get('mean'):.6e} / {scale.get('max'):.6e}")
print(f"source pool fps  = {src_fp}")

failures = []
if len(contrib) != 2:
    failures.append(f"期望 2 个输入域，实得 {len(contrib)}")
if variant == "equal":
    if meta.get("mode") != "equalize:mean":
        failures.append(f"equal 版 mode 应为 equalize:mean，实得 {meta.get('mode')!r}")
    # 等贡献：两域 w_i*mean_i 应相等（浮点级）。
    if len(contrib) == 2:
        rel = abs(contrib[0] - contrib[1]) / max(abs(contrib[0]), 1e-12)
        print(f"contribution 相对差 = {rel:.3e}（equal 版应 ~0）")
        if rel > 1e-6:
            failures.append(f"equal 版两域贡献不相等，相对差 {rel:.3e}")
elif variant == "half":
    if meta.get("mode") != "explicit":
        failures.append(f"half 版 mode 应为 explicit，实得 {meta.get('mode')!r}")
    if [round(w, 6) for w in weights] != [0.5, 0.5]:
        failures.append(f"half 版 weights 应为 [0.5,0.5]，实得 {weights}")
    # 原始等系数下贡献比应约等于 mean 比（if 主导）。
    if len(contrib) == 2 and contrib[1]:
        print(f"contribution 比 if/code = {contrib[0] / contrib[1]:.3f}（half 版应≈mean 比 2.767）")

# 源池指纹：仅提示，不硬拦。F_mix 的两个源应分别与 C_if / C_code 同池，
# 否则 EWC(F_mix) 与 OneReplay(C_mix) 的对比会被数据差异污染。
def cov_fp(path):
    if not Path(path).is_file():
        return None
    return torch.load(path, map_location="cpu").get("metadata", {}).get("pool_fingerprint")

for label, cov_path, fp in [("C_if", if_cov, src_fp[0] if src_fp else None),
                            ("C_code", code_cov, src_fp[1] if len(src_fp) > 1 else None)]:
    cfp = cov_fp(cov_path)
    if cfp is None:
        print(f"提示: 找不到 {label}（{cov_path}）或其 metadata 无 pool_fingerprint，跳过源池核对")
    elif fp is None:
        print(f"提示: F_mix 未记录该源的 pool_fingerprint，跳过 {label} 核对")
    elif cfp == fp:
        print(f"OK: F_mix 的源与 {label} 同池 {fp}")
    else:
        print(f"警告: F_mix 源池与 {label} 不同 (F={fp} vs {label}={cfp})，"
              "EWC(F_mix) 与 OneReplay(C_mix) 对比会被数据差异污染")

if failures:
    print("\nStep A 自检失败:")
    for item in failures:
        print(f"  - {item}")
    raise SystemExit(1)
print("\nStep A 自检通过")
PY
  done
else
  echo "DO_MIX=0：跳过混合，直接用已有 F_mix"
  for v in ${VARIANTS}; do
    fmix="$(variant_fisher "${v}")"
    [[ -f "${fmix}" ]] || { echo "缺 ${v} 的 F_mix: ${fmix}（DO_MIX=0 时必须已存在）"; exit 1; }
  done
fi

# ===========================================================================
# 训练：每个 variant × 每个 λ 一份 EWC adapter
#   罚项 R = (1/L) Σ_l Σ_ij F_l,ij (ΔW_l,ij)²；唯一变量是 --fisher_path 指向哪份
#   F_mix 以及 λ。其余超参逐字照抄 23/47 号。
# ===========================================================================
check_train () {
  # $1=metrics $2=lambda $3=fmix $4=accum
  python - "$1" "$2" "$3" "$4" "${VANILLA_VAL_LOSS}" <<'PY'
import json
import sys

path = sys.argv[1]
want_lambda = float(sys.argv[2])
want_penalty_path = sys.argv[3]
want_rows_per_update = int(sys.argv[4])
vanilla_val = sys.argv[5]
with open(path, encoding="utf-8") as handle:
    records = [json.loads(line) for line in handle if line.strip()]
if not records:
    raise SystemExit(f"{path} 是空的，训练没有写出任何一条 metrics")
last = records[-1]

reg = last.get("train_replay_reg") or 0.0
lambda_reg = last.get("train_lambda_reg") or 0.0
task_loss = last.get("train_task_loss") or 0.0
share = lambda_reg / task_loss if task_loss else 0.0

print(f"regularizer      = {last.get('regularizer')}")
print(f"replay_lambda    = {last.get('replay_lambda')} (want {want_lambda})")
print(f"penalty_path     = {last.get('penalty_path')}")
print(f"batch/accum      = {last.get('batch_size')} / {last.get('accumulation_size')} (行/更新)")
print(f"train_replay_reg = {reg:.6e}")
print(f"lambda * reg     = {lambda_reg:.6e}  ({share:.2%} of task_loss {task_loss:.4f})")
print(f"val_loss         = {last.get('val_loss')}")

failures = []
if last.get("regularizer") != "ewc":
    failures.append(f"regularizer={last.get('regularizer')!r}，应为 'ewc'，这次 run 白跑")
if float(last.get("replay_lambda") or 0) != want_lambda:
    failures.append(f"replay_lambda={last.get('replay_lambda')}，应为 {want_lambda}")
# 「这份 adapter 确实用的是本 variant 的 F_mix」的直接证据。
got_penalty = last.get("penalty_path")
if got_penalty is None:
    print("提示: metrics 里没有 penalty_path（train.py 版本较旧），跳过这一项")
elif got_penalty != want_penalty_path:
    failures.append(f"penalty_path={got_penalty!r}，应为 {want_penalty_path!r}")
rows_per_update = last.get("accumulation_size")
if rows_per_update is not None and int(rows_per_update) != want_rows_per_update:
    failures.append(
        f"accumulation_size={rows_per_update}，应为 {want_rows_per_update}，与 23/47 号不可比"
    )
if reg == 0.0:
    failures.append(
        "罚项恒为 0：Fisher 的层名一个都没匹配上 LoRA 模块，或 F 文件本身是空的。"
        " 看训练日志 'regularizer covers N layers' 是不是 0，这个 checkpoint 实际是 vanilla。"
    )

if share and share < 1e-3:
    print(f"提示: 罚项只占 task_loss 的 {share:.3%}，这一档基本等于 vanilla，λ 偏小")
elif share > 0.5:
    print(f"提示: 罚项占 task_loss 的 {share:.1%}，新任务很可能学不动了，λ 偏大")

if vanilla_val:
    gap = (last.get("val_loss") or 0.0) - float(vanilla_val)
    print(f"val_loss 相对 vanilla({vanilla_val}) 的差值 = {gap:+.4f}")
    if gap > 0.05:
        print(
            "提示: 新任务明显学得更差，符合 EWC-LoRA(2602.17559) 的固定 Fisher 塑性偏低。"
            "写结论要按等 val_loss 比 HumanEval/MBPP，不能直接说 EWC retention 更好。"
        )

if failures:
    print("\n训练自检失败:")
    for item in failures:
        print(f"  - {item}")
    raise SystemExit(1)
print("\n训练自检通过")
PY
}

train_one () {
  # $1=variant $2=lambda
  local variant=$1 lam=$2
  local fmix run
  fmix="$(variant_fisher "${variant}")"
  run="$(run_name "${variant}" "${lam}")"

  if [[ "${FORCE_TRAIN}" != "1" && "${SAVE}" == "1" && -d "${ADAPTERS}/${run}" ]]; then
    echo "跳过训练 ${run}：adapter 已存在（FORCE_TRAIN=1 可强制重训）"
    return 0
  fi
  mkdir -p "${RESULTS_ROOT}/map_cache/${run}"

  echo "==== train ${variant} λ=${lam}: ${run} (F=${fmix}) ===="
  python -m onereplay.scripts.train --paradigm sft \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
    --dataset_path "${CS_DATASET}" \
    --epochs "${EPOCHS}" --lr "${LR}" --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
    --eval_batch_size "${EVAL_BATCH}" \
    --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" --max_len "${MAXLEN}" \
    --target_modules "${TARGET_MODULES}" \
    --map_cache_dir "${RESULTS_ROOT}/map_cache/${run}" \
    --profile "${PROFILE}" --max_steps "${MAX_STEPS}" \
    --regularizer ewc --fisher_path "${fmix}" \
    --replay_lambda "${lam}" \
    --save "${SAVE}" --save_path "${ADAPTERS}/${run}" \
    --metrics_path "${RESULTS_ROOT}/metrics/${run}.jsonl"

  echo "==== 训练自检: ${run} ===="
  check_train "${RESULTS_ROOT}/metrics/${run}.jsonl" "${lam}" "${fmix}" "${ACCUM}"
}

if [[ "${DO_TRAIN}" == "1" ]]; then
  for v in ${VARIANTS}; do
    for lam in ${LAMBDAS}; do
      train_one "${v}" "${lam}"
    done
  done
else
  echo "DO_TRAIN=0：跳过训练"
fi

if [[ "${SAVE}" != "1" ]]; then
  echo "SAVE=0（探针短跑）：不评测。看上面每档的 'lambda * reg' 占 task_loss 的比例。"
  echo "  目标带 1%–10%。按 48 号数学线折算，本线 λ=1 处的预期是 equal≈6.6% / half≈8.5%，"
  echo "  实测若落在这个附近就直接用 LAMBDAS=1 正式投；明显偏高就降到 0.3，偏低就升到 3。"
  echo "  注意 λ≥3 的线性外推会偏高（ΔW 被压小后 R 也会掉），所以只信实测。"
  echo "Job finished at: $(date)"
  exit 0
fi

# ===========================================================================
# 评测：HumanEval + MBPP（+ 可选 IF/CS 侧），与 39/42/52 号同口径
#   已有 summary.json 的 (指标, run) 直接跳过：省卡时，也防止 *_summary.csv 追加重复行。
#
#   本脚本**只评自己训的 EWC run**。对照不重复评：
#     base / vanilla 的代码结果 = 39 号产物
#     OneReplay C_mix 的        = 52 号产物
#   三者都 append 进同一份 ${OUT_DIR}/{humaneval,mbpp}_summary.csv，直接并排读即可。
#   真要在本作业里重评某个已有 adapter，传 MODELS="<run 名>"（会**替代**方法 run），
#   或 EXTRA_MODELS="base;|其他名;<adapter 路径>"（追加，base 的 adapter 段留空）。
# ===========================================================================
EVAL_SPECS=""
append_spec () {
  if [[ -z "${EVAL_SPECS}" ]]; then EVAL_SPECS="$1"; else EVAL_SPECS="${EVAL_SPECS}|$1"; fi
}
if [[ -n "${MODELS}" ]]; then
  for m in ${MODELS}; do append_spec "${m};${ADAPTERS}/${m}"; done
else
  for v in ${VARIANTS}; do
    for lam in ${LAMBDAS}; do
      run="$(run_name "${v}" "${lam}")"
      append_spec "${run};${ADAPTERS}/${run}"
    done
  done
fi
if [[ -n "${EXTRA_MODELS}" ]]; then
  IFS='|' read -ra extra <<< "${EXTRA_MODELS}"
  for spec in "${extra[@]}"; do append_spec "${spec}"; done
fi

pending_metrics () {
  local name=$1; shift
  local out="" m
  for m in "$@"; do
    if [[ "${FORCE_EVAL}" != "1" && -f "${OUT_DIR}/${m}/${name}/summary.json" ]]; then
      echo "已有结果，跳过 ${m}/${name}" >&2
      continue
    fi
    out="${out},${m}"
  done
  echo "${out#,}"
}

eval_one () {
  local name=$1 adapter=$2
  if [[ -n "${adapter}" && ! -d "${adapter}" ]]; then
    echo "跳过评测 ${name}：缺 adapter ${adapter}"
    return 0
  fi

  if [[ -n "${CODE_AVAIL}" ]]; then
    local cp
    # shellcheck disable=SC2086
    cp="$(pending_metrics "${name}" ${CODE_AVAIL})"
    if [[ -n "${cp}" ]]; then
      echo "==== eval code: ${name} (${cp}) ===="
      python -m onereplay.scripts.evaluate \
        --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
        --adapter_path "${adapter}" --run_name "${name}" \
        --metrics "${cp}" --out_dir "${OUT_DIR}" --seed "${SEED}" \
        --limit "${LIMIT}" \
        --code_max_new_tokens "${CODE_MAX_NEW_TOKENS}" --timeout "${TIMEOUT}" \
        --humaneval_data_file "${HUMANEVAL_FILE}" \
        --mbpp_dataset_path "${MBPP_DIR}" --dataset_split "${MBPP_SPLIT}" \
        --cache_dir "${JOB_TMPDIR}/hf_datasets"
    else
      echo "跳过代码评测 ${name}：所有代码指标都已有结果"
    fi
  fi

  if [[ "${WITH_IF}" == "1" && -n "${IF_AVAIL}" ]]; then
    local ip
    # shellcheck disable=SC2086
    ip="$(pending_metrics "${name}" ${IF_AVAIL})"
    if [[ -n "${ip}" ]]; then
      echo "==== eval IF/CS: ${name} (${ip}) ===="
      python -m onereplay.scripts.evaluate \
        --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
        --adapter_path "${adapter}" --run_name "${name}" \
        --metrics "${ip}" --out_dir "${OUT_DIR}" --seed "${SEED}" \
        --dataset_path "${CS_DATASET}" \
        --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" --max_len "${MAXLEN}" \
        --map_cache_dir "${RESULTS_ROOT}/map_cache/eval_opcewc_seed${SEED}" \
        --ifeval_input "${IFEVAL_INPUT}" \
        --multiif_input "${MULTIIF_INPUT}" --multiif_language "${MULTIIF_LANG}" \
        --multiif_limit "${MULTIIF_LIMIT}"
    else
      echo "跳过 IF/CS 评测 ${name}：所有 IF/CS 指标都已有结果"
    fi
  fi
}

if [[ "${DO_EVAL}" == "1" ]]; then
  mkdir -p "${RESULTS_ROOT}/map_cache/eval_opcewc_seed${SEED}"
  CODE_AVAIL=""
  if [[ -f "${HUMANEVAL_FILE}" ]]; then
    CODE_AVAIL="${CODE_AVAIL} humaneval"
  else
    echo "跳过 humaneval：缺 ${HUMANEVAL_FILE}（先在登录节点跑 download_code_data）"
  fi
  if [[ -d "${MBPP_DIR}" ]]; then
    CODE_AVAIL="${CODE_AVAIL} mbpp"
  else
    echo "跳过 mbpp：缺 ${MBPP_DIR}（先在登录节点跑 download_code_data）"
  fi
  CODE_AVAIL="${CODE_AVAIL# }"

  IF_AVAIL=""
  if [[ "${WITH_IF}" == "1" ]]; then
    IF_AVAIL="ifeval commonsense"
    if [[ -f "${MULTIIF_INPUT}" ]]; then IF_AVAIL="${IF_AVAIL} multiif"; else echo "跳过 multiif：缺 ${MULTIIF_INPUT}"; fi
    [[ -d "${CS_DATASET}" ]] || echo "警告: commonsense 评测缺 ${CS_DATASET}"
  fi

  if [[ -z "${CODE_AVAIL}" && -z "${IF_AVAIL}" ]]; then
    echo "没有任何可评测指标（两份代码数据都不在，且未开 WITH_IF）"; exit 1
  fi
  echo "CODE_AVAIL=[${CODE_AVAIL}]  IF_AVAIL=[${IF_AVAIL}]"

  # -------------------------------------------------------------------------
  # 判分链路自检：这套 exec-in-subprocess 的沙箱要是不通，整个作业跑完只会得到
  # 一片 0 分，很难看出是模型差还是判分坏了。39 号加的，照搬。
  # -------------------------------------------------------------------------
  if [[ -n "${CODE_AVAIL}" ]]; then
    python - <<'PY'
from onereplay.eval.code_exec import evaluate_assert_program, evaluate_entry_point_program

ok, err = evaluate_assert_program("def add(a, b):\n    return a + b\n", ["assert add(1, 2) == 3"], 5.0)
print(f"自检 MBPP 路径      : passed={ok} error={err!r}")
program = "def add(a, b):\n    return a + b\n"
test = "def check(candidate):\n    assert candidate(1, 2) == 3\n"
ok2, err2 = evaluate_entry_point_program(program, "add", test, 5.0)
print(f"自检 HumanEval 路径 : passed={ok2} error={err2!r}")
if not (ok and ok2):
    raise SystemExit("判分沙箱不通（多半是容器里 multiprocessing 起不来），先修这个再评测")
print("判分链路 OK")
PY
  fi

  EVAL_NAMES=()
  IFS='|' read -ra specs <<< "${EVAL_SPECS}"
  for spec in "${specs[@]}"; do
    name="${spec%%;*}"
    adapter="${spec#*;}"
    eval_one "${name}" "${adapter}"
    EVAL_NAMES+=("${name}")
  done

  # -------------------------------------------------------------------------
  # 失败原因分桶 + 语法错误成因取证 + 配对 McNemar
  #   只读上面落盘的 responses.jsonl，纯 CPU 几秒。baseline 固定为 base（39 号已在
  #   同目录留下结果）。默认关，可事后在登录节点补。
  # -------------------------------------------------------------------------
  if [[ "${DO_ANALYZE}" == "1" && -n "${CODE_AVAIL}" && ${#EVAL_NAMES[@]} -gt 0 ]]; then
    ANALYZE_RUNS="$(IFS=,; echo "${EVAL_NAMES[*]}")"
    python -m onereplay.scripts.analyze_code_failures \
      --results_root "${OUT_DIR}" --metrics "${CODE_AVAIL// /,}" \
      --runs "${ANALYZE_RUNS}" --baseline base --inspect 5 || true
  fi

  set +x
  echo "========================================================================"
  echo "评测产物（每个 run 一行，append 进同名 CSV，可直接并排比）:"
  for m in ${CODE_AVAIL}; do
    echo "  ${m}: ${OUT_DIR}/${m}_summary.csv"
  done
  if [[ "${WITH_IF}" == "1" ]]; then
    for m in ${IF_AVAIL}; do
      echo "  ${m}: ${OUT_DIR}/${m}_summary.csv"
    done
  fi
  echo "逐题输出: ${OUT_DIR}/<metric>/<run_name>/responses.jsonl"
  echo "本次评测 run: ${EVAL_NAMES[*]}"
  echo ""
  echo "怎么读："
  echo "  1) 同一份 CSV 里已有的对照（都是同口径，不用重评）："
  echo "       base / vanilla                       <- 39 号"
  echo "       cs_onereplay_ifcode_opcedu_lam*      <- 52 号（主方法 C_mix）"
  echo "       cs_ewcmix_opcedu_{equal,half}_lam*   <- 本作业"
  echo "  2) **不要各挑最优 λ 报点。** EWC-LoRA(2602.17559) 的固定 Fisher 塑性偏低，"
  echo "     分数低可能只是新任务没学动。要在相同 commonsense val_loss 处比代码分。"
  echo "  3) 主量具仍是 40 号代码 CE 探针：pass@1 量程不够测保护（MBPP 只 3.30pp）。"
  echo "  4) equal vs half 的差别只反映 mixing 策略，两版共用同一 λ，各取最优。"
  echo "  5) 绝对分数低于公开报告值（判分器有黑名单且会在第一个 '\\ndef ' 处截断），"
  echo "     对比有效，绝对值不要外引。"
  echo ""
  echo "失败分桶（DO_ANALYZE=0 时本作业不跑）纯 CPU，登录节点上补即可："
  echo "  python -m onereplay.scripts.analyze_code_failures \\"
  echo "    --results_root ${OUT_DIR} --metrics ${CODE_AVAIL// /,} \\"
  echo "    --runs <run1,run2,...> --baseline base --inspect 5"
  set -x
else
  echo "DO_EVAL=0：跳过评测"
fi

set +x
echo "Job finished at: $(date)"
