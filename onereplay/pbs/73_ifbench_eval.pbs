#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_ifbench
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# NUS Hopper (PBS + Singularity): 只跑 IFBench，不训练，不评其它指标。
#
# 【IFBench 是什么、为什么单独评】
#   IFEval 的 25 类约束是公开的，谁都能拿它当训练信号，所以「IFEval 没掉」
#   有可能只是记住了那 25 类的模板。IFBench（Pyatkin et al., NeurIPS 2025 D&B）
#   换了 58 类**训练时没见过**的可验证约束，300 条 prompt 来自 WildChat 留出集。
#   它和 IFEval 一起看才有意义：
#     IFEval 保住 + IFBench 也保住  -> 指令遵循能力本身没退
#     IFEval 保住 + IFBench 掉了    -> 保住的是那 25 类模板，不是能力
#   论文主报 prompt-level loose accuracy，本脚本 strict/loose 都打。
#
# 【绝对不要把 IFBench 的 registry 拿去重算 IFEval】
#   IFBench 自带一份改过的 classic checker。用它重算那 541 条，历史结果会无声
#   偏移。两个数据集各用各的 registry：ifeval -> third_party/
#   instruction_following_eval，ifbench -> 装好的 ifbench 包。
#
# -----------------------------------------------------------------------------
# 前置条件（比其它评测脚本多两条，都必须在**登录节点**做完）:
#
#   1) 装 ifbench（不在 PyPI，只能从 git 装；pin 死 commit，因为校验函数就是
#      指标本身，上游改一个 checker 我们的分数就会变）:
#        source ${VENV}/bin/activate
#        pip install "ifbench @ git+https://github.com/allenai/IFBench.git@1c40f0c10d9b5c5c2f10a175a28007ebb64f7f4d"
#
#   2) 下 NLTK 语料。IFBench 的 checker 要用 pos_tag / stopwords / sent_tokenize，
#      IFEval 一个都不用，所以现有环境里大概率是缺的。它自己会在 import 时
#      nltk.download()，但计算节点离线，那个调用**不报错也不下载**，等到打分
#      阶段才 LookupError —— 300 条已经解码完了，一小时 GPU 白烧。
#      所以本脚本在解码前先探一次（metric 里的 check_nltk_data）。
#        source ${VENV}/bin/activate
#        python -m nltk.downloader punkt punkt_tab stopwords averaged_perceptron_tagger_eng
#      在 venv 里 nltk 会把语料下到 ${VENV}/nltk_data（sys.prefix/nltk_data），
#      基本不理 NLTK_DATA 环境变量 —— 下面的默认值就指到那儿。那个位置本来
#      就在 nltk 的自动搜索表里，所以只要激活的是同一个 venv，不转发
#      NLTK_DATA 也能找到；显式设上只是为了报错时一眼看出它在找哪儿。
#      登录节点出不去网就在本地下好这四个包再 rsync 到同一路径。
#
#   3) adapter 就位；日志目录: mkdir -p /scratch/weiliu87/logs/onereplay
#
# -----------------------------------------------------------------------------
# 用法:
#   # 默认：扫 ${RESULTS_ROOT}/adapters/ 下所有 run，加 base，跳过已有结果
#   qsub onereplay/pbs/73_ifbench_eval.pbs
#
#   # 只评指定的几个
#   qsub -v RUNS="cs_vanilla_8b_r16all_lr1e-4_seed1 cs_replay_8b_ifgold_r16all_4n4r_lr1e-4_seed1" \
#     onereplay/pbs/73_ifbench_eval.pbs
#
#   # 1.7B 那批（换模型和结果树）
#   qsub -v MODEL_NAME=Qwen3-1.7B,RESULTS_ROOT=/scratch/weiliu87/student/czq/Onereplay/results \
#     onereplay/pbs/73_ifbench_eval.pbs
#
#   # 冒烟：只评 base 的前 20 条，确认依赖齐了再投正式的
#   qsub -v RUNS=base,LIMIT=20 onereplay/pbs/73_ifbench_eval.pbs
#
#   # 已有 summary.json 也强制重评
#   qsub -v FORCE_EVAL=1 onereplay/pbs/73_ifbench_eval.pbs
#
# 预计耗时: 300 条 / 2048 token 预算，8B 上约 25–40 min 一个模型。
#   walltime 24h 够评 30 个上下。要评的多就分批投 RUNS。
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id>
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（与其它 pbs 脚本保持一致）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/73_ifbench_eval.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

# IFBench 的 checker 要用的 NLTK 语料。venv 里跑 nltk.downloader 会落到
# ${VENV}/nltk_data（sys.prefix/nltk_data），和登录节点那次下载同一处。
NLTK_DATA="${NLTK_DATA:-${VENV}/nltk_data}"

# ---- 本次作业专属的临时目录 ----
JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  # -e/--cleanenv 会清掉环境，只有 SINGULARITYENV_/APPTAINERENV_ 前缀的变量能进容器。
  # NLTK_DATA 必须在这张表里：漏了它，容器里就只会去 site-packages 下面找，那里是空的。
  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR NLTK_DATA
    MODEL_DIR MODEL_NAME RESULTS_ROOT
    SEED RUN RUNS ADAPTER OUT_NAME OUT_SUFFIX LIMIT
    IFBENCH_INPUT IFBENCH_MAX_NEW_TOKENS IFBENCH_BATCH
    WITH_BASE FORCE_EVAL
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  # 不加 --nv：Hopper 的 singularity 已经全局绑好 GPU 驱动。
  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"

  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  echo "NLTK_DATA       : ${NLTK_DATA}"
  # 不能用 exec：那会把当前 shell 替换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的评测。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
export NLTK_DATA="${NLTK_DATA}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
# 离线：模型和数据都在本地盘，禁止任何 HuggingFace 联网调用。
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available(), torch.cuda.device_count())"

# ---- 项目路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-8B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results/qwen3-8b}"

# ---- 评测参数 ----
# 预算 2048：上游用 4096，但那是给 thinking 模型留的余量。IFBench 里
# "把 prompt 重复一遍再答"、"每个字母开头各一段" 这类约束确实要地方，被 cap
# 截断的回复会把它还没满足的约束全判失败，所以宁可给宽一点。
# 换过这个值之后**所有臂都要重评**，截断偏差跨 run 不均匀。
SEED="${SEED:-1}"
LIMIT="${LIMIT:-0}"                  # >0 时只评前 N 条（冒烟用）
IFBENCH_MAX_NEW_TOKENS="${IFBENCH_MAX_NEW_TOKENS:-2048}"
IFBENCH_BATCH="${IFBENCH_BATCH:-16}"
IFBENCH_INPUT="${IFBENCH_INPUT:-}"   # 空 = 用装好的 ifbench 包自带的 IFBench_test.jsonl
FORCE_EVAL="${FORCE_EVAL:-0}"
WITH_BASE="${WITH_BASE:-1}"
OUT_SUFFIX="${OUT_SUFFIX:-}"

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }

# ---------------------------------------------------------------------------
# 依赖自检：ifbench 装了没、NLTK 语料齐不齐。
#   放在加载模型之前 —— 这两样缺了必挂，而 8B 的加载要几分钟。
# ---------------------------------------------------------------------------
set +x
echo "==== 依赖自检 ===="
python - <<'PY'
import sys

try:
    import ifbench
    from ifbench import instructions_registry
except ImportError as error:
    sys.exit(
        f"缺 ifbench: {error}\n"
        "登录节点上装（不在 PyPI，只能从 git 装）:\n"
        "  source <REPO_ROOT>/.venv/bin/activate\n"
        '  pip install "ifbench @ git+https://github.com/allenai/IFBench.git'
        '@1c40f0c10d9b5c5c2f10a175a28007ebb64f7f4d"'
    )

n = len(instructions_registry.INSTRUCTION_DICT)
print(f"ifbench     : {n} 个 checker, 数据 {ifbench.data_path()}")
if n < 83:
    sys.exit(f"registry 只有 {n} 个 checker，预期 83，装的版本不对")

from onereplay.eval.metrics.ifbench import check_nltk_data

check_nltk_data()   # 缺语料会带着 download 命令一起报出来
print("nltk 语料   : punkt / punkt_tab / stopwords / tagger 都在")
PY
echo "自检通过"
set -x

# ---- 要评的 run ----
# RUNS 没给就扫 adapters 目录：给所有已有臂补 IFBench 分数是这个脚本的主用途，
# 硬编码一张名单每加一个臂就得改一次。
if [[ -z "${RUNS:-}" ]]; then
  if [[ -n "${RUN:-}" ]]; then
    RUNS="${RUN}"
  else
    RUNS=""
    if [[ -d "${RESULTS_ROOT}/adapters" ]]; then
      for d in "${RESULTS_ROOT}/adapters"/*/; do
        [[ -d "${d}" ]] || continue
        RUNS="${RUNS} $(basename "${d}")"
      done
    fi
    RUNS="${RUNS# }"
  fi
fi
# base 的 adapter 路径是空串：evaluate.py 认这个，直接加载裸模型。
if [[ "${WITH_BASE}" == "1" && " ${RUNS} " != *" base "* ]]; then
  RUNS="base ${RUNS}"
fi

if [[ -z "${RUNS// /}" ]]; then
  echo "没有可评的 run：${RESULTS_ROOT}/adapters 下是空的，且 WITH_BASE=0"
  exit 1
fi

if [[ "${LIMIT}" != "0" ]]; then
  echo "!! LIMIT=${LIMIT}：冒烟模式，产出的 summary.json 只覆盖前若干条，不是正式结果。"
fi

resolve_adapter () {
  local run=$1
  if [[ "${run}" == "base" ]]; then
    echo ""
    return
  fi
  local n
  n="$(echo "${RUNS}" | wc -w)"
  if [[ -n "${ADAPTER:-}" && "${n}" -eq 1 ]]; then
    echo "${ADAPTER}"
    return
  fi
  echo "${RESULTS_ROOT}/adapters/${run}"
}

resolve_out_name () {
  local run=$1
  local n
  n="$(echo "${RUNS}" | wc -w)"
  if [[ -n "${OUT_NAME:-}" && "${n}" -eq 1 ]]; then
    echo "${OUT_NAME}"
    return
  fi
  echo "${run}${OUT_SUFFIX}"
}

# ---------------------------------------------------------------------------
# 前置：谁会跑、谁会跳过、为什么跳过。缺 adapter 只跳过这一行，不整作业退出。
# ---------------------------------------------------------------------------
set +x
echo "========================================================================"
echo "IFBench（只评这一个指标）"
echo "  模型     = ${MODEL_DIR}/${MODEL_NAME}"
echo "  结果树   = ${RESULTS_ROOT}"
echo "  数据     = ${IFBENCH_INPUT:-<ifbench 包自带 IFBench_test.jsonl, 300 条>}"
echo "  解码     = 贪心, ${IFBENCH_MAX_NEW_TOKENS} token, batch ${IFBENCH_BATCH}, seed ${SEED}"
echo "------------------------------------------------------------------------"
printf "%-56s %s\n" "run" "状态"
PENDING=0
for run in ${RUNS}; do
  adapter="$(resolve_adapter "${run}")"
  out_name="$(resolve_out_name "${run}")"
  if [[ "${run}" != "base" && ! -d "${adapter}" ]]; then
    printf "%-56s %s\n" "${run}" "!! 缺 adapter: ${adapter}"
    continue
  fi
  if [[ "${FORCE_EVAL}" != "1" && -f "${RESULTS_ROOT}/ifbench/${out_name}/summary.json" ]]; then
    printf "%-56s %s\n" "${run}" "已有结果，跳过"
  else
    printf "%-56s %s\n" "${run}" "待评 -> ifbench/${out_name}"
    PENDING=$((PENDING + 1))
  fi
done
echo "------------------------------------------------------------------------"
echo "待评 ${PENDING} 个，按 ~30 min/个 估计约 $((PENDING * 30 / 60))h$((PENDING * 30 % 60))min"
echo "========================================================================"
set -x

# ---------------------------------------------------------------------------
# 评测
# ---------------------------------------------------------------------------
eval_one () {
  local run=$1
  local adapter out_name
  adapter="$(resolve_adapter "${run}")"
  out_name="$(resolve_out_name "${run}")"

  if [[ "${run}" != "base" && ! -d "${adapter}" ]]; then
    echo "跳过 ${run}：缺 adapter ${adapter}"
    return 0
  fi
  if [[ "${FORCE_EVAL}" != "1" && -f "${RESULTS_ROOT}/ifbench/${out_name}/summary.json" ]]; then
    echo "已有结果，跳过: ${RESULTS_ROOT}/ifbench/${out_name}/summary.json"
    return 0
  fi

  echo "==== eval IFBench: ${run} -> ${RESULTS_ROOT}/ifbench/${out_name} ===="
  # IFBENCH_INPUT 为空就不传这个 flag，让 metric 去用包自带的数据。
  local input_flag=()
  if [[ -n "${IFBENCH_INPUT}" ]]; then
    input_flag=(--ifbench_input "${IFBENCH_INPUT}")
  fi
  python -m onereplay.scripts.evaluate \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    --adapter_path "${adapter}" --run_name "${out_name}" \
    --metrics ifbench --out_dir "${RESULTS_ROOT}" --seed "${SEED}" \
    --ifbench_limit "${LIMIT}" \
    --ifbench_max_new_tokens "${IFBENCH_MAX_NEW_TOKENS}" \
    --ifbench_batch_size "${IFBENCH_BATCH}" \
    "${input_flag[@]}"
}

for run in ${RUNS}; do
  eval_one "${run}"
done

# ---------------------------------------------------------------------------
# 后置：一张 IFBench 表，旁边带上同名 run 的 IFEval，方便看「哪种约束保住了」。
# ---------------------------------------------------------------------------
set +x
python - "${RESULTS_ROOT}" "${OUT_SUFFIX}" ${RUNS} <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
suffix = sys.argv[2]
runs = sys.argv[3:]


def load(metric, name):
    path = root / metric / name / "summary.json"
    if path.is_file():
        return json.loads(path.read_text(encoding="utf-8"))
    return None


def cell(payload, key):
    return f"{payload[key] * 100:6.2f}" if payload and key in payload else "  --  "


rows = []
for run in runs:
    name = f"{run}{suffix}" if suffix else run
    rows.append((name, load("ifbench", name), load("ifeval", run)))

print()
print("=" * 108)
print("IFBench（300 条，训练时没见过的约束）vs IFEval（541 条，公开约束）。单位 %。")
print("=" * 108)
print(
    f"{'run':<50} {'IFB loose p':>12} {'IFB loose i':>12} "
    f"{'IFB strict p':>13} {'IFE strict p':>13}"
)
for name, ifb, ife in rows:
    print(
        f"{name:<50} "
        f"{cell(ifb, 'loose_prompt_accuracy'):>12} "
        f"{cell(ifb, 'loose_instruction_accuracy'):>12} "
        f"{cell(ifb, 'strict_prompt_accuracy'):>13} "
        f"{cell(ife, 'strict_prompt_accuracy'):>13}"
    )
print()
print("IFB loose p = 论文主指标（prompt-level loose）。300 条：1pp = 3 条，二项 SE ≈ 2.7pp，")
print("所以 3pp 以内的差别别当成效应。IFE 那列是同名 run 已有的 IFEval，没评过就是 --。")

# 按约束族分开看：整体分数盖不住「掉的是哪一类」。
families = {}
for name, ifb, _ in rows:
    if not ifb:
        continue
    payload = json.loads((root / "ifbench" / name / "summary.json").read_text(encoding="utf-8"))
    per_family = payload.get("per_family_loose", {})
    if per_family:
        families[name] = per_family

if families:
    keys = sorted({k for v in families.values() for k in v})
    print()
    print("=" * 108)
    print("按约束族（loose instruction-level %，括号是该族的题数）")
    print("=" * 108)
    header = "".join(f"{k:>13}" for k in keys)
    print(f"{'run':<40}{header}")
    any_name = next(iter(families))
    counts = "".join(f"{'n=' + str(families[any_name][k]['total']):>13}" for k in keys)
    print(f"{'':<40}{counts}")
    for name, per_family in families.items():
        cells = "".join(
            f"{per_family[k]['accuracy'] * 100:>13.1f}" if k in per_family else f"{'--':>13}"
            for k in keys
        )
        print(f"{name:<40}{cells}")
PY

echo "========================================================================"
echo "产物:"
for run in ${RUNS}; do
  out_name="$(resolve_out_name "${run}")"
  [[ -f "${RESULTS_ROOT}/ifbench/${out_name}/summary.json" ]] && \
    echo "  ${RESULTS_ROOT}/ifbench/${out_name}/summary.json"
done
echo "  ${RESULTS_ROOT}/ifbench_summary.csv   (所有 run 一行一条)"
echo "Job finished at: $(date)"
