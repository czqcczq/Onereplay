#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N p3_cf_math
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# Part 3 / Stage 1 采集: 在 Model-Math 上一次采完 C_math 和 F_math
#
#     Model-Math  --(NuminaMath 20k 行, gold targets)-->  C_math + F_math
#
# Part 3 是 Part 2 的**反方向**。Part 2 是「先学 IF，再学 Math，保 IF」，这条线把两个
# 域调换：
#
#     Part 2   Base --FLANv2--> Model-IF-FLAN --Numina + C_if  --> 保 IF
#     Part 3   Base --Numina--> Model-Math    --FLANv2 + C_math--> 保 Math
#                               ^^^^^^^^^^^^             ^^^^^^
#                               本脚本的模型              本脚本的产物
#
# 两个方向都做才能说「onereplay 保的是能力，不是某个特定域碰巧好保」。反方向还顺带
# 检验一个更强的说法：Math 是长 CoT 能力，比指令跟随更脆，如果 C 在这个方向也守住了，
# 结论就硬得多。
#
# 95/97 号是分开的两个作业（C 和 F）。这条线合成一个，因为反方向的两次采集共用同一套
# 前置检查和同一个池指纹，分开写等于把 Step 0 抄两遍。想分开投就用 DO_COV / DO_FISHER
# 开关（见下面「运行时长」一节，F 是大头，很可能真的需要分开）。
#
# -----------------------------------------------------------------------------
# 【最关键的一条：C 和 F 都必须在 Model-Math 上采，不是在 Base 上采】
#
# 罚项是 λ · tr(ΔW C ΔWᵀ)，其中 ΔW = W − W0，而 W0 是 train.py 在**训练开始时**从加载
# 进来的模型快照的（scripts/train.py 里 build_regularizer 之后紧跟
# snapshot_reference_weights）。Part 3 的训练起点是 Model-Math，所以：
#
#     W0 = Model-Math 的权重  ->  C 也必须是 Model-Math 的 E[x xᵀ]
#
# 拿 Base 的 C 配 Model-Math 的 W0 是把两个不同点的量拼在一起：隐状态分布在 Stage 1
# 已经被 Numina 改过一遍了。这个错误**不报错、loss 也正常**，只会让保护变弱且无法解释。
# EWC 那边同理：F 是在 W0 处的曲率，采在 Base 上就不是这个 W0 的曲率。
#
# -----------------------------------------------------------------------------
# 【池子：NuminaMath 50k 训练池里 nested 随机抽的 20k 行】
#
# 三个用途读同一个文件，这是三条臂可比的前提（71/83 号已经在强制这个约束）：
#
#     C        collect_cov    --data_files <该文件>       （本脚本 Step 1）
#     Fisher   collect_fisher --data_files <该文件>       （本脚本 Step 3）
#     replay   train.py       --replay_data_files <该文件>（101 号）
#
# 三条臂如果拿到的旧知识不是同一批行，「onereplay vs EWC vs replay」就被「谁看到了
# 哪些数据」混淆，比较本身失效。
#
# nested（池 ⊂ Stage 1 训练池）也是有意的：Model-Math 真的在这 20k 行上训过，所以
# gold targets 的 replay 在这里是**标准 experience replay**（复习训过的数据），C 描述
# 的也确实是它学到的东西。本线**不需要自蒸馏**。
#
# 池子由 MODE=pool 从**已经存好的**训练池上切（load_from_disk + prepare_openr1_math
# 里的 replay_row_order/to_replay_row），不重新转 parquet、不动训练池一个字节，所以已有
# 的 Model-Math checkpoint 依然有效。等价路径是
# `qsub -v MODE=data,REPLAY_ROWS=20000 onereplay/pbs/91_part1_math_openr1.pbs`，两条
# 路径调的是同一个排列函数，产物逐字相同。
#
# -----------------------------------------------------------------------------
# 【max_len=2048：换成 NuminaMath 之后这条线便宜了将近一个数量级】
#
# 必须和三处对齐：
#   1) Stage 1 训练时 91 号用的 MAXLEN=2048
#   2) 本脚本采 C 和 F
#   3) Stage 3 训练时 replay 行的 --replay_max_len 2048
#
# 第 3 条是 replay.py 里 replay_max_len() 那段注释的镜像：Stage 3 往 IF 方向续训时
# 新任务的 --max_len 是 1536，但 replay 行是 math，**不能**跟着用 1536（Numina 的
# 全序列 P90 就有 942 token，1536 会开始切，「replay 复习的旧知识」比「C 编码的旧知
# 识」少一截，两条臂不再是同一份旧知识）。往 CS 方向的 512 更是差得远。两边都得显
# 式传。
#
# prepare_numina_math 的 length report（Qwen 系 tokenizer + chat template）：
#     全序列 P50=479  P90=942  P95=1118  P99=1507  max=2810
# 所以 2048 下只有极少数行被切。OpenR1 那版需要 8192（P99=8004）是因为 R1 traces 的
# 答案中位就有 3767 token；换数据集的动机正是那个长度本身。
#
# -----------------------------------------------------------------------------
# 【truncation_side left：在 math 上比在 FLAN 上危险得多，但仍然必须是 left】
#
# 训练侧 tokenizer_to_ids 是 full_input_ids[-max_length:]，保尾丢头，所以采集也必须
# left，否则 C/F 看到的文本和训练时不是一份。
#
# 但要知道它在这条线上意味着什么：FLAN 上左截断是良性的（few-shot 结构是「示例1 示例2
# … 真问题」，丢头只退化成更少 shot 的同一道题）。math 上丢头丢的是**题目本身**，剩下
# 一段没有问题的推理。OpenR1 那版在 4096 下会有 20326 行「连题目都不剩」，所以它必须用
# 8192。Numina 在 4096 下一行都不截，风险归零——但这是「够短所以碰不到」，不是「左截断
# 在 math 上无害」。改小 MAXLEN 会立刻把这个风险请回来。
#
# collect_cov / collect_fisher 的默认都是空串 = 跟 tokenizer 默认（right，先切答案），
# 所以 left 必须显式传。对 F 更要紧：右截断把答案切干净之后这一行的 supervised token
# 数变成 0，它不报错、也不被丢掉，而是走 add_empty()——算作 N 的一员但贡献 0，也就是
# **静默稀释 F**。
#
# -----------------------------------------------------------------------------
# 【COV_BATCH=4：4096 下显存账仍由 logits 主导，但每行便宜了一半】
#
# 协方差 hook 按 attention_mask 过滤了 padding，batch 只改变浮点累加顺序，**不改变 C
# 的数学定义**，所以取多少纯粹是性能选择。4096 下的账：
#
#   logits (bf16)   B x 4096 x 151936 x 2B = B x 1.16 GiB    <- 最大的一项
#   C 累加器        6.58 GiB（常驻 device，与 B 无关）
#   权重 (bf16)     3.2 GiB
#   down_proj hook  B x 4096 x 6144 x 4B = B x 0.09 GiB（.float() 转换的瞬时量）
#
# logits 那 1.16 GiB/行 **躲不掉**：transformers 有 logits_to_keep 可以只算最后若干个
# 位置，但那会在 lm_head 之前就把 hidden_states 切掉，于是 lm_head 的 hook 只看到最后
# 一个位置，lm_head 的 C 就废了。lm_head 在 scope 里，所以必须让它看到全部位置。
#
# padding 浪费在 Numina 上也小得多：长度分布窄（P50=479 P90=942），一个 batch 的 max
# 不会像 OpenR1 那样把均值拉高近一倍。OpenR1 那时取 2 是因为 8192 一行就能喂饱 GPU 且
# 补齐浪费大，两条理由在这里都弱了，所以取 4。显存还很宽松，想再快可以试 8。
#
# -----------------------------------------------------------------------------
# 【F 侧被 collect_fisher 强制的三件事，都不是可调项】
#
# 1) --use_bf16 0（模型跑 fp32）。梯度在 backward 里就被舍入了，事后加宽救不回来；
#    bf16 相当于给每个 F 元素压上约 1% 的噪声底。
# 2) batch_size 固定为 1，**collect_fisher 根本没有这个参数**。Fisher 要逐样本梯度：
#    对 batch 求和后再平方算的是 (Σ_n g_n)²，不是 Σ_n g_n²，差一个不可忽略的交叉项。
# 3) F 是 d_out x d_in（**C 是 d_in x d_in**），all-linear 下约 6.9 GB。
#
# FISHER_DEVICE=cuda：放 CPU 每条样本要把 197 个梯度平方搬过 PCIe（约 6.88 GB/条），
# 20000 条按 20 GB/s 算是 +1.9h 下限，而且是 197 次小传输 x 20000 的同步开销。1.7B 上
# cuda 总占用（fp32 权重 6.9 + fp32 梯度 6.9 + F 累加器 6.9 + 4096 的激活）约 25-30 GiB，
# H200 余量很大。显存紧的卡再传 FISHER_DEVICE=cpu。
#
# -----------------------------------------------------------------------------
# 【运行时长：换成 Numina 之后一个作业就装得下，不必再分两次投】
#
# 关键的量是**池子的 token 总数**。IF 线那 20k 行 FLAN 累出 5,318,546 个非 padding
# token；这条线 20k 行 Numina 按全序列均值约 542 估是约 1100 万，只有 2 倍。
# （OpenR1 那版按 P50=3900 估是约 8000 万，是这里的 7 倍多，那才是当初 24h walltime
#   和「分两次投」这条建议的由来。）
#
#   Step 1  采 C    IF 线约 12 min  ->  这条线约 20-40 min
#   Step 3  采 F    IF 线 0.5-2 h   ->  这条线约 1-2 h（fp32、逐样本 backward）
#
# 合起来两三个小时，24h 的 walltime 余量很大，直接一次投完即可。仍然想分开的话
# （比如先拿 C 去 101 号跑 lambda_probe）：
#   qsub -v DO_FISHER=0 ...   先只采 C
#   qsub -v DO_COV=0 ...      再采 F（Step 0 会用 C 文件交叉校验池指纹）
#
# collect_cov 每 50 个 batch 打一次进度，collect_fisher 每 ${LOG_EVERY} 条打一次
# ms/example。**拿 ms/example x 20000 才是真实时长**，上面的区间只够判断有没有卡住。
#
# -----------------------------------------------------------------------------
# 【λ 不要在这里定死】
#
# 约束强度 ∝ λ·trace(C)，但罚项要和**任务损失**比较才有意义。Part 3 的新任务是
# FLANv2@1536（短答案，task_loss 的尺度和 Part 2 的 Numina@4096 完全不同），所以
# Part 2 那套 λ 在这里没有可比性，Step 2 折算出来的数只是 grid 的中心。101 号有
# MODE=lambda_probe：短跑几十次更新、打印 reg_loss / task_loss 的实际比例，据此选 λ。
#
# EWC 的 λ 和 onereplay 的 λ **不可比**（F 是梯度平方、C 是激活二阶矩，量级差好几个
# 数量级）。train.py 的 --regularizer help 原话：the two scales are not comparable and
# need separate sweeps。Step 4 会给出 1/mean(F) 作为 EWC 自己那把尺子的起点。
#
# -----------------------------------------------------------------------------
# 【前置】计算节点无外网，以下都要先就位
#   1) Stage 1 的 checkpoint（91 号 MODE=train 的产物，完整权重目录）
#        ${MATH_CKPT_DIR}/part1_math_lr<LR>_seed<SEED>/
#      不传 MATH_LR 时脚本会自己去 glob，命中不唯一会报错并列出候选。
#   2) Stage 1 的训练池（prepare_numina_math.py 的产物，save_to_disk 目录）
#        ${REPO_ROOT}/datasets/numina_math_50k/
#   3) mkdir -p ${REPO_ROOT}/logs
#
# 【用法】务必按顺序
#   # 0) 切 20k 旧知识池（纯 CPU，几分钟；只读训练池，不改它）
#   qsub -v MODE=pool onereplay/pbs/99_part3_cf_math_openr1.pbs
#
#   # 1) 只做前置检查 + 池指纹，不碰 GPU（几分钟）
#   qsub -v DRY_RUN=1 onereplay/pbs/99_part3_cf_math_openr1.pbs
#
#   # 2) 先采 C（约 2-3h），拿到就能去 101 号跑 lambda_probe
#   qsub -v DO_FISHER=0 onereplay/pbs/99_part3_cf_math_openr1.pbs
#
#   # 3) 再采 F（约 6-10h）
#   qsub -v DO_COV=0 onereplay/pbs/99_part3_cf_math_openr1.pbs
#
#   # 一次跑完两个（贴着 24h，不推荐）
#   qsub onereplay/pbs/99_part3_cf_math_openr1.pbs
#
#   # 指定 Stage 1 的 LR（glob 命中多个时必须传）
#   qsub -v MATH_LR=2e-5 onereplay/pbs/99_part3_cf_math_openr1.pbs
#
#   # 只重看诊断，不重采
#   qsub -v DO_COV=0,DO_FISHER=0 onereplay/pbs/99_part3_cf_math_openr1.pbs
#
#   # 产物已存在也重采
#   qsub -v FORCE=1 onereplay/pbs/99_part3_cf_math_openr1.pbs
#
#   # 便宜地把 F 的链路跑通（500 行，几分钟；产物不可用于正式实验）
#   qsub -v DO_COV=0,MAX_SAMPLES=500,FISHER_PATH=/tmp/f_smoke.pt onereplay/pbs/99_part3_cf_math_openr1.pbs
#
# 下一步: 101 号 Stage 2 训练（FLANv2 上训 IF，用 C_math / F_math 保 Math）
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id>
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/99_s2_collect_math.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_p3cf_${JOBTAG}}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_p3cf_${JOBTAG}}"
  EXTRA_BIND=""
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_p3cf_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME MATH_LINE_ROOT MATH_CKPT_DIR MATH_LR MATH_RUN MATH_CKPT
    TRAIN_POOL RESULTS_ROOT DATASET_CACHE POOL_FILE POOL_ROWS_EXPECT POOL_SAMPLE_SEED
    MODE DRY_RUN FORCE DO_COV DO_FISHER
    SEED SAMPLE_SEED MAXLEN SCOPE TARGET_MODULES SYSTEM_PROMPT SYSTEM_PROMPT_PRESET
    COV_BATCH COV_ACCUM_DEVICE COV_USE_BF16 COV_PATH
    FISHER_DEVICE FISHER_USE_BF16 FISHER_PATH MAX_SAMPLES LOG_EVERY
    TAG REF_COV REF_LAMBDA_FULL REF_LAMBDA_QV DEBUG_EXAMPLES
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e --nv -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

cd "${REPO_ROOT}"

# ---- 原始 Base，只用于 Step 0 打印对照（本脚本**不**在它上面采）----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
# 全线模型，理由见 91 号同处。必须和 91 号训练时用的模型一致，否则采到的 C/F
# 描述的不是这个 checkpoint 的激活分布。要回 1.5B 就传 MODEL_NAME=Qwen2.5-Math-1.5B。
MODEL_NAME="${MODEL_NAME:-Qwen3-4B-Base}"

# ---- Stage 1（Math 线 / NuminaMath-CoT）的产物，本脚本只读 ----
# Model-Math 是 91 号用 NuminaMath 100k 训出来的那一个，它就是 Stage 3 的 W0，
# 所以 C/F 必须采在它身上。结果树按模型分根，与 91 号的 RESULTS_ROOT 同构：
# **91 号换了 MODEL_NAME 就必须在这里一起换**，否则会静默采到另一个模型的
# checkpoint 上（那个目录也存在，run 名还完全一样）。
MATH_LINE_ROOT="${MATH_LINE_ROOT:-${REPO_ROOT}/results_part1_numina_${MODEL_NAME}}"
MATH_CKPT_DIR="${MATH_CKPT_DIR:-${MATH_LINE_ROOT}/checkpoints}"
# 91 号的 MATH_DATASET 默认值。注意它在 ${REPO_ROOT}/datasets/ 下而不是结果树里
# （prepare_numina_math.py 直接写在那），MODE=pool 从它上面切池子（只读）。
# 训练池不按模型分——它只是数据，和权重无关。
TRAIN_POOL="${TRAIN_POOL:-${REPO_ROOT}/datasets/numina_math_100k}"
# <训练池目录>_replay.jsonl，schema {inputs, targets, data_source, source_index}。
# MODE=pool 走 prepare_openr1_math 的 replay_row_order + to_replay_row —— Numina 池的
# 列名（instruction/output/data_source/source_index）与 OpenR1 池相同，所以那对函数
# 直接适用，不需要为新数据集另写一份。
POOL_FILE="${POOL_FILE:-${TRAIN_POOL}_replay.jsonl}"
POOL_ROWS_EXPECT="${POOL_ROWS_EXPECT:-20000}"
# 与训练池的 --seed 分开：重抽旧知识池不该牵动训练池。必须与 91 号的
# REPLAY_SAMPLE_SEED 一致，否则两条产池路径给出不同的 20k 行。
POOL_SAMPLE_SEED="${POOL_SAMPLE_SEED:-1}"

# ---- Stage 2 自己的结果树。与 results_part1_* 分开 ----
# 名字里不带目标域（原来叫 math2if）：C_math / F_math 只取决于 Stage 1 的模型和
# 旧知识池，和 Stage 3 往哪个方向续训无关。同一份 C_math 给 math->if 和
# math->cs 两条 Stage 3 线共用。
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_stage2_math_${MODEL_NAME}}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
export HF_DATASETS_CACHE="${DATASET_CACHE}"

# ---- 模式与阶段开关 ----
# MODE=pool 只切池子然后退出（纯 CPU）。默认 collect 走 Step 0 -> 1 -> 2 -> 3 -> 4。
MODE="${MODE:-collect}"
DRY_RUN="${DRY_RUN:-0}"
FORCE="${FORCE:-0}"
DO_COV="${DO_COV:-1}"
DO_FISHER="${DO_FISHER:-1}"

# ---- 共用的采集口径 ----
SEED="${SEED:-1}"
SAMPLE_SEED="${SAMPLE_SEED:-1}"
# 必须等于 91 号训练时的 MAXLEN，也必须等于 Stage 3 的 --replay_max_len（见文件头）。
# Numina 全序列 P50=479 P90=942 P99=1507 max=2810，2048 下截断的行极少，而 91 号
# 用的就是 2048 —— 对齐训练侧优先于多留余量。
MAXLEN="${MAXLEN:-2048}"
# ---- system 消息：**必须与 91 号训练时逐字一致** ----
# C/F 描述的是模型在 Stage 3 起点上会看到的激活分布，所以采集时的渲染和训练时的
# 渲染必须一样。这里不一致不会报错，只会让保护方向偏掉，静默地削弱 OneReplay/EWC。
#
# 在 Qwen2.5-Math-1.5B 上这一条靠"留空"实现：没有 system turn 时它的模板会自动注入
#     "Please reason step by step, and put your final answer within \boxed{}."
# 91 号刻意留空就是为了复现那个配方，所以采集也留空，两边都拿到注入的版本。
#
# 换成 Qwen3-4B-Base 之后留空就错了：Qwen3 的模板只在 messages[0] 是 system 时才输出
# system 块，不会替你注入任何东西。而 91 号那边已经按模型补齐了那条指令，这边若还
# 留空，采到的 C/F 就是"无 system turn"下的分布，和训练分布差一整个 system 段。
# 所以这里用和 91 号**同一套** preset 逻辑，两个脚本必须一起改，别只改一个。
# 95 号（IF）和 101 号（CS）不需要这个开关：它们的 system 是一条与模型无关的中性
# 助手消息，换模型不改变渲染。
SYSTEM_PROMPT_PRESET="${SYSTEM_PROMPT_PRESET:-auto}"
if [[ -z "${SYSTEM_PROMPT:-}" ]]; then
  case "${SYSTEM_PROMPT_PRESET}" in
    none) ;;
    math) SYSTEM_PROMPT="Please reason step by step, and put your final answer within \\boxed{}." ;;
    auto)
      if [[ "${MODEL_NAME}" != *Math* ]]; then
        SYSTEM_PROMPT="Please reason step by step, and put your final answer within \\boxed{}."
      fi
      ;;
    *) echo "SYSTEM_PROMPT_PRESET 只能是 auto / math / none，得到 '${SYSTEM_PROMPT_PRESET}'" >&2; exit 2 ;;
  esac
fi
SYSTEM_PROMPT="${SYSTEM_PROMPT:-}"
# scope 对 C 和 F 必须相同，否则 EWC 和 onereplay 约束的层集合不同，对照失效。
SCOPE="${SCOPE:-full}"
case "${SCOPE}" in
  qv)
    TARGET_MODULES="${TARGET_MODULES:-q_proj,v_proj}"
    TAG="${TAG:-qv}"
    ;;
  full)
    TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj,lm_head}"
    TAG="${TAG:-full}"
    ;;
  *)
    echo "未知 SCOPE=${SCOPE}，可选 qv / full"; exit 1
    ;;
esac

# ---- C 侧 ----
# 4：MAXLEN 从 8192 降到 4096 之后 logits 减半到 1.16 GiB/行，而 Numina 的长度分布
# 也窄得多（P50=479 对 P90=942），动态补齐的浪费远小于 OpenR1 那时。文件头里
# COV_BATCH=2 的那段算术是按 8192 写的，不再适用。
COV_BATCH="${COV_BATCH:-4}"
# device：把 6.58 GiB 累加器留在 GPU 上，省掉每 batch 每层的回传。
# 那 6.58 GiB 是 Qwen2.5-Math-1.5B 下的实测值。C 的大小只由架构决定（每个目标层
# 一个 d_in x d_in 的 fp32 矩阵），换 Qwen3-4B-Base 后 full scope 下大约翻倍：
# 主导项 down_proj 的 d_in 从 8960 变 9728、层数从 28 变 36，(9728/8960)^2 x 36/28
# ~= 1.5，而 hidden 从 1536 变 2560 让其余层涨得更多。跑完看 C 文件的实际大小就能
# 核准，别用这里的数字当定论。
#
# 采集本身不吃紧（C 20 GB 上下 + bf16 权重 8 GB + 前向，远在 140 GB 之内），要当心
# 的是 **Stage 3**：那时显存里同时有 4B 的训练开销（静态 32 GB + 激活 + logits，
# 见 91 号 BATCH 那段，约 97 GB）、驻留的 C、以及 EWC 的对角 F（4.02B x fp32 ~= 15
# GiB），加起来约 125 GB，贴着 140 GB 的卡。到时候大概要把 Stage 3 的 BATCH 降到 2、
# 或者把 C 放 CPU（--cov_accum_device cpu，慢但省 20 GB）。这不影响本脚本。
COV_ACCUM_DEVICE="${COV_ACCUM_DEVICE:-device}"
# C 由前向激活累加、hook 里已经 .float() 加宽，所以模型走 bf16 没有精度问题。
COV_USE_BF16="${COV_USE_BF16:-1}"
# 文件名带 numina：OpenR1 那版 C/F 如果还在同一棵树下，不能被覆盖，也不能被误用。
COV_PATH="${COV_PATH:-${RESULTS_ROOT}/cov/cov_math_numina_20k_${TAG}.pt}"

# ---- F 侧 ----
# cuda：放 CPU 每条要过 PCIe 搬 6.88 GB。见文件头。
FISHER_DEVICE="${FISHER_DEVICE:-cuda}"
# 0 = 模型跑 fp32。梯度在 backward 里就被舍入了，事后加宽救不回来。
FISHER_USE_BF16="${FISHER_USE_BF16:-0}"
FISHER_PATH="${FISHER_PATH:-${RESULTS_ROOT}/fisher/fisher_math_numina_20k_${TAG}.pt}"
# 0 = 全量。只在冒烟时改；改了 Step 4 会拒绝（N != 池行数）。
MAX_SAMPLES="${MAX_SAMPLES:-0}"
LOG_EVERY="${LOG_EVERY:-500}"

# ---- 诊断辅助 ----
# 打两条渲染后的文本。确认 checkpoint 的 chat template 和 91 号训练时同构，
# 以及 assistant turn 里放的确实是 Numina 的 gold CoT（原始数据就没有 <think>）。
DEBUG_EXAMPLES="${DEBUG_EXAMPLES:-2}"
# 历史上单阶段线的 C_math（31/46 号，Base 模型 / MetaMath 30k 池 / qv scope）。存在就在
# Step 2 里打一个 trace 比值。full scope 的 1.7B 版本不存在，会自动跳过。
REF_COV="${REF_COV:-${REPO_ROOT}/results/cov/cov_math_metamath30k_${TAG}.pt}"
REF_LAMBDA_FULL="${REF_LAMBDA_FULL:-7.5e-3}"
REF_LAMBDA_QV="${REF_LAMBDA_QV:-3e-2}"
if [[ "${TAG}" == "qv" ]]; then
  REF_LAMBDA="${REF_LAMBDA_QV}"
else
  REF_LAMBDA="${REF_LAMBDA_FULL}"
fi

mkdir -p "$(dirname "${COV_PATH}")" "$(dirname "${FISHER_PATH}")" "${DATASET_CACHE}"

# ===========================================================================
# MODE=pool: 从已存的训练池上切 20k 旧知识池
#
# 只读 TRAIN_POOL，不重新转 parquet、不改训练池一个字节，所以 Model-Math 的
# checkpoint 依然有效。
#
# 用的是 prepare_openr1_math 里的 replay_row_order + to_replay_row，也就是
# `qsub -v MODE=data,REPLAY_ROWS=20000 91_part1_math_openr1.pbs` 会调的同一对函数，
# 所以两条路径在同一个 seed 下产物逐字相同。ds.select(...) 保持给定的下标顺序，
# 只取那 20000 行，不把 45792 条长 CoT 全拉进 Python。
# ===========================================================================
if [[ "${MODE}" == "pool" ]]; then
  [[ -d "${TRAIN_POOL}" ]] || {
    echo "缺 Stage 1 训练池: ${TRAIN_POOL}"
    echo "先跑: qsub -v MODE=data onereplay/pbs/91_part1_math_openr1.pbs"
    exit 1
  }
  if [[ "${FORCE}" != "1" && -f "${POOL_FILE}" ]]; then
    echo "池子已存在，跳过: ${POOL_FILE}"
    echo "  行数: $(wc -l < "${POOL_FILE}")   （FORCE=1 可强制重切）"
    echo "Job finished at: $(date)"
    exit 0
  fi
  echo "==== MODE=pool: ${TRAIN_POOL} -> ${POOL_FILE} ===="
  python - "${TRAIN_POOL}" "${POOL_FILE}" "${POOL_ROWS_EXPECT}" "${POOL_SAMPLE_SEED}" <<'PY'
import collections
import json
import sys
from pathlib import Path

from datasets import load_from_disk

from onereplay.scripts.prepare_openr1_math import (
    REPLAY_COLUMNS,
    replay_row_order,
    to_replay_row,
)

train_pool, out_path, want_rows, sample_seed = sys.argv[1:5]
want_rows = int(want_rows)
sample_seed = int(sample_seed)

dataset = load_from_disk(train_pool)
# 91 号存的是 DatasetDict({"train": ...})，而 DatasetDict 是 dict 的子类。
# 直接判 dict 比 hasattr("keys") 稳。
if isinstance(dataset, dict):
    if "train" not in dataset:
        raise SystemExit(f"{train_pool} 里没有 train split，实际有 {sorted(dataset)}")
    dataset = dataset["train"]
print(f"训练池行数: {len(dataset)}")

missing = [c for c in ("instruction", "output", "data_source", "source_index")
           if c not in dataset.column_names]
if missing:
    raise SystemExit(
        f"训练池缺列 {missing}，实际有 {sorted(dataset.column_names)}。\n"
        "这个池子不是 prepare_openr1_math 写的，或者 schema 变过了。"
    )

order = replay_row_order(len(dataset), want_rows, sample_seed)
subset = dataset.select(order)

out = Path(out_path)
out.parent.mkdir(parents=True, exist_ok=True)
sources = collections.Counter()
empty = 0
with out.open("w", encoding="utf-8") as handle:
    for row in subset:
        pool_row = to_replay_row(row)
        if not str(pool_row["inputs"]).strip() or not str(pool_row["targets"]).strip():
            empty += 1
        sources[pool_row["data_source"]] += 1
        handle.write(json.dumps(pool_row, ensure_ascii=False) + "\n")

print(f"写出 {len(subset)} 行 -> {out}")
print(f"  列        : {list(REPLAY_COLUMNS)}")
print(f"  sample_seed: {sample_seed}  (nested 随机子集，训练池未改动)")
print("  data_source: " + ", ".join(
    f"{name or '<empty>'}={count}" for name, count in sources.most_common()
))
if empty:
    # require_target 会把这些行滤掉，于是 C/F 的实际行数少于 20000，Step 0 会拦住。
    raise SystemExit(f"!! 有 {empty} 行的 inputs/targets 是空的，回去查训练池")
print("池子就位。")
PY
  echo ""
  echo "下一步: qsub -v DRY_RUN=1 onereplay/pbs/99_part3_cf_math_openr1.pbs"
  echo "Job finished at: $(date)"
  exit 0
fi

# ===========================================================================
# Step 0: 前置检查（纯 CPU，几分钟）
#
# 每一件都对应一个「不报错但会毁掉结果」的失败模式：
#   1) Stage 1 checkpoint 存在、唯一、且是**完整权重**而不是 LoRA adapter
#   2) 池文件存在、行数正好等于 POOL_ROWS_EXPECT、schema 有 inputs/targets
#   3) 池指纹落盘打印出来：C 和 F 必须是同一个值，Step 2/4 都会核
#   4) DO_COV=0 时 C 文件必须已存在（F 的诊断要拿它对层集合）
# ===========================================================================
echo "==== Step 0: 前置检查 ===="

# ---- 1) 解析 Stage 1 checkpoint ----
# 三种指定方式，从具体到宽松：MATH_CKPT（绝对路径）> MATH_LR（拼 run 名）> glob 自动发现。
if [[ -z "${MATH_CKPT:-}" ]]; then
  if [[ -n "${MATH_LR:-}" ]]; then
    MATH_RUN="${MATH_RUN:-part1_math_lr${MATH_LR}_seed${SEED}}"
    MATH_CKPT="${MATH_CKPT_DIR}/${MATH_RUN}"
  else
    mapfile -t _CANDS < <(
      find "${MATH_CKPT_DIR}" -maxdepth 1 -mindepth 1 -type d \
        -name "part1_math_lr*_seed${SEED}" 2>/dev/null | sort
    )
    if (( ${#_CANDS[@]} == 0 )); then
      echo "在 ${MATH_CKPT_DIR} 下找不到 part1_math_lr*_seed${SEED}"
      echo "先跑: qsub -v MODE=train,LR=<lr> onereplay/pbs/91_part1_math_openr1.pbs"
      echo "或显式指定: qsub -v MATH_CKPT=/abs/path onereplay/pbs/99_part3_cf_math_openr1.pbs"
      exit 1
    fi
    if (( ${#_CANDS[@]} > 1 )); then
      echo "命中多个 Stage 1 checkpoint，必须显式选一个（采在哪个模型上决定了 W0）:"
      for _c in "${_CANDS[@]}"; do echo "  ${_c}"; done
      echo "传 MATH_LR=<lr> 或 MATH_CKPT=<绝对路径>"
      exit 1
    fi
    MATH_CKPT="${_CANDS[0]}"
    MATH_RUN="$(basename "${MATH_CKPT}")"
  fi
fi
MATH_RUN="${MATH_RUN:-$(basename "${MATH_CKPT}")}"

[[ -d "${MATH_CKPT}" ]] || { echo "缺 Stage 1 checkpoint: ${MATH_CKPT}"; exit 1; }
[[ -f "${MATH_CKPT}/config.json" ]] || {
  echo "${MATH_CKPT} 里没有 config.json，不是一个可加载的模型目录"; exit 1
}
if [[ -f "${MATH_CKPT}/adapter_config.json" ]]; then
  echo "${MATH_CKPT} 是 LoRA adapter 目录（有 adapter_config.json）。"
  echo "本线要求全量 checkpoint：C/F 采在 W0 上，而 W0 必须是 Stage 2 真正的起点权重。"
  exit 1
fi
# tokenizer 必须随 checkpoint 落盘：chat template 决定了 C/F 看到的文本长什么样。
[[ -f "${MATH_CKPT}/tokenizer_config.json" ]] || {
  echo "${MATH_CKPT} 里没有 tokenizer_config.json。trainers/base.py 的 save 分支应当同时"
  echo "写模型和 tokenizer；缺了说明这个目录不是 save_pretrained 的完整产物。"
  exit 1
}
# 目录存在 + 有 config.json 还不够：save 被 walltime 打断过的话目录会在、权重却没写完。
MATH_WEIGHT_COUNT="$(find "${MATH_CKPT}" -maxdepth 1 -type f \
  \( -name '*.safetensors' -o -name '*.bin' \) | wc -l)"
if (( MATH_WEIGHT_COUNT == 0 )); then
  echo "${MATH_CKPT} 里没有 *.safetensors / *.bin —— 目录在但权重没落盘。"
  echo "多半是 91 号那次 save 被打断了。删掉这个目录重训，或指向别的 checkpoint。"
  exit 1
fi
echo "Stage 1 checkpoint : ${MATH_CKPT}"
echo "  run 名           : ${MATH_RUN}"
echo "  权重文件         : ${MATH_WEIGHT_COUNT} 个"

# ---- 2) 池文件、行数、schema ----
[[ -f "${POOL_FILE}" ]] || {
  echo "缺 20k 旧知识池: ${POOL_FILE}"
  echo "先跑: qsub -v MODE=pool onereplay/pbs/99_part3_cf_math_openr1.pbs"
  exit 1
}
POOL_ROWS_ACTUAL="$(wc -l < "${POOL_FILE}")"
echo "池文件             : ${POOL_FILE}"
echo "  行数             : ${POOL_ROWS_ACTUAL} (期望 ${POOL_ROWS_EXPECT})"
if [[ "${POOL_ROWS_ACTUAL}" != "${POOL_ROWS_EXPECT}" ]]; then
  echo "行数不等于期望值。确认这就是想要的池大小的话，传 POOL_ROWS_EXPECT=${POOL_ROWS_ACTUAL}。"
  exit 1
fi

python - "${POOL_FILE}" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    first = json.loads(handle.readline())
missing = [column for column in ("inputs", "targets") if column not in first]
if missing:
    raise SystemExit(
        f"池文件缺列 {missing}，实际有 {sorted(first)}。\n"
        "collect_cov / collect_fisher / replay 三边都按 inputs/targets 读，"
        "改列名会让三者读到不同的东西。"
    )
print(f"  schema           : {sorted(first)}  (inputs/targets 就位)")
print(f"  第一行 inputs    : {str(first['inputs'])[:100]!r}")
print(f"  第一行 targets   : {str(first['targets'])[:100]!r}")
if "<think>" in str(first["targets"]):
    raise SystemExit(
        "!! targets 里有 <think> 标签。NuminaMath 的解答本来就不带标签，评测路径又是"
        "enable_thinking=False，出现标签说明这个池子不是从 numina_math_50k 切的。"
    )
if "\\boxed" not in str(first["targets"]) and "\\fbox" not in str(first["targets"]):
    # 只看第一行，所以这是提示不是断言：prepare_numina_math 的 --require_boxed 1
    # 让整池 100% 带 boxed，缺了多半是池子来源不对。
    print("  !! 第一行 targets 里没有 \\boxed —— 确认这个池子确实来自 numina_math_50k")
PY

# ---- 3) 池指纹 ----
# 与 Step 1/3 的采集逐字同参（max_samples/sample_shuffle/require_target），所以这里
# 打印的指纹就是 C 和 F 会看到的那批行的指纹。
POOL_FP="$(python -m onereplay.scripts.check_old_knowledge_pool \
  --data_files "${POOL_FILE}" --dataset_split train \
  --cache_dir "${DATASET_CACHE}" --streaming 0 \
  --input_column inputs --target_column targets \
  --require_target 1 \
  --max_samples 0 --sample_shuffle 0 --sample_seed "${SAMPLE_SEED}" \
  --label math_numina_20k | tail -n 1)"
echo "${POOL_FP}"
POOL_HASH="${POOL_FP##*fingerprint=}"
POOL_FP_ROWS="${POOL_FP##*rows=}"; POOL_FP_ROWS="${POOL_FP_ROWS%% *}"
if [[ "${POOL_FP_ROWS}" != "${POOL_ROWS_EXPECT}" ]]; then
  echo "require_target 过滤后只剩 ${POOL_FP_ROWS} 行（原始 ${POOL_ROWS_EXPECT}）。"
  echo "说明池里有空的 inputs/targets —— replay 的 to_sft_schema 也会丢掉这些行。"
  exit 1
fi

# ---- 4) 分两次投时的交叉依赖 ----
if [[ "${DO_COV}" != "1" && ! -f "${COV_PATH}" ]]; then
  echo "!! DO_COV=0 但 ${COV_PATH} 不存在。"
  echo "   F 的诊断要拿 C 对层集合和池指纹，先采 C: qsub -v DO_FISHER=0 ${SELF_PATH}"
  exit 1
fi
if [[ "${MAX_SAMPLES}" != "0" ]]; then
  echo "!! MAX_SAMPLES=${MAX_SAMPLES} != 0：F 只吃前 ${MAX_SAMPLES} 行，与 C 的 ${POOL_FP_ROWS} 行不等。"
  echo "   这只适合冒烟。Step 4 会因为 N != 池行数而拒绝，正式实验必须是 0。"
fi

echo ""
echo "========================================================================"
echo "Part 3 / Stage 1 采集: C_math + F_math  (在 Model-Math 上，不是在 Base 上)"
echo "  采集的模型    : ${MATH_CKPT}"
echo "                  ^ 这就是 Stage 2 的 W0；换成 Base 会让 C/F 与 W0 不同点"
echo "  对照(未使用)  : ${MODEL_DIR}/${MODEL_NAME}"
echo "  旧知识池      : ${POOL_FILE}"
echo "                  ${POOL_ROWS_EXPECT} 行, gold CoT, nested ⊂ Stage 1 训练池"
echo "  池指纹        : ${POOL_HASH}"
echo "                  ^ C 和 F 必须都记着这个值"
echo "  scope         : ${SCOPE}  (${TARGET_MODULES})"
echo "  共用口径      : max_len=${MAXLEN} truncation=left"
echo "                  max_samples=0 (全量) sample_shuffle=0 require_target=1"
echo "  C  : batch=${COV_BATCH} accum_device=${COV_ACCUM_DEVICE} bf16=${COV_USE_BF16}"
echo "       -> ${COV_PATH}"
echo "  F  : batch=1(强制) device=${FISHER_DEVICE} bf16=${FISHER_USE_BF16}"
echo "       -> ${FISHER_PATH}"
echo "  阶段          : DO_COV=${DO_COV}  DO_FISHER=${DO_FISHER}"
echo "  历史对照 C    : ${REF_COV} $( [[ -f "${REF_COV}" ]] && echo '(存在, Step 2 会比)' || echo '(不存在, 跳过比值)' )"
echo "========================================================================"

if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只做前置检查。确认上面的 checkpoint / 行数 / 指纹无误后，"
  echo "建议分两次投：先 DO_FISHER=0 采 C，再 DO_COV=0 采 F。"
  echo "Job finished at: $(date)"
  exit 0
fi

# ===========================================================================
# Step 1: 采 C_math
#
# --model_dir/--model_name 拼出的是 Stage 1 的 checkpoint 目录，这是本脚本与
# 01/31/41/62/68 号所有采集脚本的结构性区别（它们指向 Base）。
#
# 逐条对上文件头的理由：
#   --include_target_in_chat 1   assistant turn 放 Numina 的 gold CoT，与 replay 读同
#                                一列，也与 Stage 1 训练时的监督对象一致
#   --enable_thinking 0          Numina 的解答本来就不带 <think>；与 concat 一起保持 0
#   --concat_prompt_target 0
#   --truncation_side left       与训练一致；默认空串会走 tokenizer 默认(right, 先切答案)
#   --max_samples 0 --sample_shuffle 0   文件本身就是那 20k 行，取全量不打乱
#   --require_target 1           与 replay 的 to_sft_schema 同口径
# ===========================================================================
if [[ "${DO_COV}" == "1" ]]; then
  if [[ "${FORCE}" != "1" && -f "${COV_PATH}" ]]; then
    echo "跳过采 C：${COV_PATH} 已存在（FORCE=1 可强制重采）"
  else
    echo "==== Step 1: collect C_math -> ${COV_PATH} ===="
    echo "4096 上下文、约 1100 万 token，预计 20-40 min。每 50 个 batch 打一次进度。"
    python -m onereplay.scripts.collect_cov \
      --model_dir "${MATH_CKPT_DIR}" --model_name "${MATH_RUN}" \
      --seed "${SEED}" --use_bf16 "${COV_USE_BF16}" \
      --data_files "${POOL_FILE}" --dataset_split train \
      --cache_dir "${DATASET_CACHE}" --streaming 0 \
      --input_column inputs --target_column targets \
      --require_target 1 \
      --use_chat_template 1 --include_target_in_chat 1 \
      --system_prompt "${SYSTEM_PROMPT}" \
      --enable_thinking 0 --concat_prompt_target 0 \
      --debug_print_examples "${DEBUG_EXAMPLES}" \
      --max_samples 0 --sample_shuffle 0 --sample_seed "${SAMPLE_SEED}" \
      --batch_size "${COV_BATCH}" --max_len "${MAXLEN}" \
      --truncation_side left \
      --target_modules "${TARGET_MODULES}" \
      --cov_normalization none \
      --cov_accum_device "${COV_ACCUM_DEVICE}" \
      --output_path "${COV_PATH}"
  fi
else
  echo "DO_COV=0：使用已有 ${COV_PATH}"
fi
[[ -f "${COV_PATH}" ]] || { echo "缺 C_math: ${COV_PATH}"; exit 1; }

# ===========================================================================
# Step 2: 诊断 C_math
#
# 四组数，各挡一类错误：
#   A) metadata 自检 —— 池指纹 / max_len / truncation / scope 有没有真的传上去。
#      这些错了 C 仍然会写出一个合法文件，只有 metadata 能证明它是对的。
#   B) 层覆盖 —— 模块数、每个投影家族齐不齐。scope=full 应当是 197 个。
#   C) 数值健康 —— NaN/Inf、对角非负（C=E[x xᵀ] 半正定，对角是 E[x_i²]）、trace 分布。
#      down_proj 的 trace 会大一个量级，这是正常的：它的输入是 SwiGLU 之后的 6144 维。
#   D) λ 的起点 —— 只是量级参考，必须在 101 号用 lambda_probe 实测再定。
# ===========================================================================
echo ""
echo "==== Step 2: 诊断 C_math ===="
python - "${COV_PATH}" "${POOL_HASH}" "${MAXLEN}" "${TARGET_MODULES}" \
         "${REF_COV}" "${REF_LAMBDA}" "${MATH_CKPT}" "${MATH_RUN}" <<'PY'
import json
import sys
from collections import defaultdict
from pathlib import Path

import torch

(cov_path, want_fp, want_max_len, want_modules_raw,
 ref_path, ref_lambda, ckpt, want_model) = sys.argv[1:9]
want_max_len = int(want_max_len)
want_modules = [item for item in want_modules_raw.split(",") if item]
ref_lambda = float(ref_lambda)

# 预期模块数从 config.json 的层数算，不写死。lm_head 全模型只有一个，其余每层一个。
num_layers = int(json.loads((Path(ckpt) / "config.json").read_text())["num_hidden_layers"])
expected = sum(1 if item == "lm_head" else num_layers for item in want_modules)

payload = torch.load(cov_path, map_location="cpu")
covariances = payload["covariances"]
meta = payload.get("metadata", {})
counts = payload.get("counts", {})
problems: list[str] = []

# ---- A) metadata 自检 ----
print("A) 采集口径（metadata，证明参数真的传上去了）")
checks = [
    ("pool_fingerprint", want_fp, "池指纹与 Step 0 不一致：C 看到的行不是那 20k 行"),
    ("max_len", want_max_len, f"max_len 不是 {want_max_len}：与 91 号训练和 replay_max_len 不对齐"),
    ("truncation_side", "left", "truncation_side 不是 left：切掉的是答案而不是题目"),
    ("require_target", 1, "require_target 不是 1：与 replay 的过滤口径不一致"),
    ("sample_shuffle", 0, "sample_shuffle 不是 0"),
    ("max_samples", 0, "max_samples 不是 0（应当取全量）"),
    ("cov_normalization", "none", "cov_normalization 不是 none"),
    ("model_name", want_model, f"model_name 不是 {want_model}：C 采在了别的模型上"),
]
for key, want, message in checks:
    got = meta.get(key)
    ok = str(got) == str(want)
    print(f"   {key:<20} = {got!s:<44} {'ok' if ok else '!! ' + message}")
    if not ok:
        problems.append(message)

got_modules = list(meta.get("target_modules", []))
if sorted(got_modules) != sorted(want_modules):
    problems.append(f"target_modules 不一致: {got_modules} vs {want_modules}")
print(f"   {'target_modules':<20} = {','.join(got_modules)}")
print(f"   {'pool_rows':<20} = {meta.get('pool_rows')}")

# ---- B) 层覆盖 ----
by_family: dict[str, list[str]] = defaultdict(list)
for name in covariances:
    by_family[name.rsplit(".", 1)[-1]].append(name)

total_elements = sum(matrix.numel() for matrix in covariances.values())
print()
print(f"B) 层覆盖: {len(covariances)} 个模块, {total_elements / 1e9:.3f}G 个 fp32 "
      f"= {total_elements * 4 / 1024 ** 3:.2f} GiB")
print(f"   预期 {expected} 个 = {num_layers} 层 x "
      f"{len([m for m in want_modules if m != 'lm_head'])} 类"
      + (" + lm_head" if "lm_head" in want_modules else " (不含 lm_head)"))
if len(covariances) != expected:
    problems.append(
        f"模块数 {len(covariances)} != 预期 {expected}。"
        "少了就说明某个 target_modules 名字在这个模型上没命中。"
    )
if any(name.endswith("lm_head") or name == "lm_head" for name in covariances):
    print("   note: lm_head 在覆盖内。该权重与 embed_tokens 共享存储（Qwen3-1.7B 是")
    print("         tie_word_embeddings=true），罚项只约束 lm_head 这一侧的输入协方差。")

# ---- C) 数值健康 + trace ----
print()
print("C) 数值健康与 trace（按家族）")
print(f"   {'family':<12}{'层数':>6}{'d_in':>7}{'trace p50':>14}{'trace min':>14}{'trace max':>14}")
all_traces = []
for family in sorted(by_family):
    names = sorted(by_family[family])
    traces = []
    for name in names:
        matrix = covariances[name].float()
        if not torch.isfinite(matrix).all():
            problems.append(f"{name} 含 NaN/Inf")
        diagonal = torch.diagonal(matrix)
        if (diagonal < 0).any():
            problems.append(f"{name} 对角有负值 (min={diagonal.min().item():.3e})")
        traces.append(diagonal.sum().item())
    all_traces.extend(traces)
    tensor = torch.tensor(traces)
    dim = covariances[names[0]].shape[-1]
    print(
        f"   {family:<12}{len(names):>6}{dim:>7}"
        f"{tensor.median().item():>14.4e}{tensor.min().item():>14.4e}{tensor.max().item():>14.4e}"
    )
token_counts = sorted(set(counts.values()))
print(f"   累加的非 padding token 数: {token_counts[0]:,}"
      + ("" if len(token_counts) == 1 else f" .. {token_counts[-1]:,} (各层不同?!)"))
print("     参考：IF 线那 20k 行 FLAN 是 5,318,546 个。Numina 20k 行按均值约 542 估")
print("     应当在 1100 万上下——明显偏小就说明 max_len 或 truncation 把解答截掉了。")
print("     （OpenR1 那版的参考值是 8 千万，不要拿它来对这条线。）")
if len(token_counts) > 1:
    problems.append("各层的 token 计数不同，同一批前向不该出现这种情况")

# ---- D) λ 起点 ----
print()
print("D) λ 的起点")
mean_trace = torch.tensor(all_traces).mean().item()
print(f"   mean trace(C_math) over {len(all_traces)} layers = {mean_trace:.4e}")
if Path(ref_path).is_file():
    reference = torch.load(ref_path, map_location="cpu")
    reference = reference["covariances"] if "covariances" in reference else reference
    shared = sorted(set(covariances) & set(reference))
    if shared:
        ratios = torch.tensor([
            torch.diagonal(covariances[name].float()).sum().item()
            / max(torch.diagonal(reference[name].float()).sum().item(), 1e-30)
            for name in shared
        ])
        r = ratios.mean().item()
        print(f"   trace(C_new)/trace(C_hist) over {len(shared)} shared layers: "
              f"mean={r:.3f} min={ratios.min().item():.3f} max={ratios.max().item():.3f}")
        print(f"   历史 λ={ref_lambda:g} 按 trace 反比折算 -> λ ≈ {ref_lambda / r:.3e}")
        print("   历史 C 与本次差了模型（Base vs Model-Math）、池子（MetaMath vs Numina）、")
        print("   max_len（512 vs 4096）三件事，所以这只是量级参考，不是等强度换算。")
    else:
        print("   历史 C 的层集合与本次无交集（scope 不同?），跳过比值")
else:
    print(f"   找不到历史对照 {ref_path}，只能用绝对值")
    print("   历史 λ 参考: 全量 all-linear 7.5e-3 (44 号) / LoRA qv 3e-2 (32/63 号)")
print()
print("   **λ 不要在这里定死。** 约束强度 ∝ λ·trace(C)，但罚项要和**任务损失**比较才有")
print("   意义，而 Part 3 的新任务是 FLANv2@1536（短答案），task_loss 的尺度和 Part 2 的")
print("   Numina@4096 完全不同。101 号有 MODE=lambda_probe：短跑几十次更新，打印")
print("   reg_loss / task_loss 的实际比例，据此选 λ。上面这个数只是 grid 的中心。")

print()
if problems:
    print("!! 诊断发现问题:")
    for item in problems:
        print(f"   - {item}")
    raise SystemExit("C_math 不可用，先修上面的问题（重采要传 FORCE=1）")
print("诊断通过：C_math 可用。")
PY

# ===========================================================================
# Step 3: 采 F_math
#
# 与 Step 1 相同的池、相同的模型、相同的渲染，只有三处按 Fisher 的定义强制不同
# （fp32、逐样本 batch=1、d_out x d_in），见文件头。
#
# 参数表上的两处「看起来少了」：
#   没有 --batch_size：collect_fisher 内部固定 1，逐样本梯度不可 batch。
#   没有 --enable_thinking / --concat_prompt_target：old_knowledge.py 用 getattr 读
#     它们、默认就是 0，与 Step 1 显式传的 0 等价。加了 argparse 会报错。
#   所以两步的渲染仍然是**逐字节相同**的。
# ===========================================================================
if [[ "${DO_FISHER}" == "1" ]]; then
  if [[ "${FORCE}" != "1" && -f "${FISHER_PATH}" ]]; then
    echo "跳过采 F：${FISHER_PATH} 已存在（FORCE=1 可强制重采）"
  else
    echo ""
    echo "==== Step 3: collect F_math -> ${FISHER_PATH} ===="
    echo "${POOL_FP_ROWS} 次逐样本 backward，fp32、4096 上下文，预计 1-2h。"
    echo "**拿日志里的 ms/example x ${POOL_FP_ROWS} 才是真实时长**，区间只够判断有没有卡住。"
    python -m onereplay.scripts.collect_fisher \
      --model_dir "${MATH_CKPT_DIR}" --model_name "${MATH_RUN}" \
      --seed "${SEED}" --use_bf16 "${FISHER_USE_BF16}" \
      --data_files "${POOL_FILE}" --dataset_split train \
      --cache_dir "${DATASET_CACHE}" --streaming 0 \
      --input_column inputs --target_column targets \
      --require_target 1 \
      --use_chat_template 1 --include_target_in_chat 1 \
      --system_prompt "${SYSTEM_PROMPT}" \
      --max_samples "${MAX_SAMPLES}" --sample_shuffle 0 --sample_seed "${SAMPLE_SEED}" \
      --max_len "${MAXLEN}" \
      --truncation_side left \
      --target_modules "${TARGET_MODULES}" \
      --fisher_device "${FISHER_DEVICE}" \
      --log_every "${LOG_EVERY}" \
      --output_path "${FISHER_PATH}"
  fi
else
  echo ""
  echo "DO_FISHER=0：跳过 F。C 已就位，可以先去 101 号跑 lambda_probe。"
  echo "采 F: qsub -v DO_COV=0 ${SELF_PATH}"
fi

# ===========================================================================
# Step 4: 诊断 F_math
#
# 五组数，各挡一类错误：
#   A) metadata 自检 —— 估计量定义、池指纹、N、口径。这些错了 F 仍会写出合法文件。
#   B) 与 C 的层集合对比 —— 必须是**同一批模块名**，否则两个方法约束的不是同一批层。
#   C) 数值健康 —— F 是平方和，逐元素必须 >= 0；以及零元素比例（F=0 的权重在 EWC 下
#      完全不受约束，比例太高说明 20k 行不够）。
#   D) 估计量健康 —— ESS / length_exponent / zero_supervision_rows。这条线上 D 组比
#      IF 线更值得看：math 答案长度跨度极大（P50=3900 到 max=9004），||g||² 随长度增长，
#      所以 ESS 被少数长 CoT 压低的风险比 FLAN 高得多。
#   E) λ 起点 —— 1/mean。EWC 的 λ 和 onereplay 的 λ 不可比，必须独立 sweep。
# ===========================================================================
if [[ -f "${FISHER_PATH}" ]]; then
  echo ""
  echo "==== Step 4: 诊断 F_math ===="
  python - "${FISHER_PATH}" "${COV_PATH}" "${POOL_HASH}" "${MAXLEN}" "${TARGET_MODULES}" \
    "${MATH_RUN}" "${MATH_CKPT}" "${POOL_FP_ROWS}" <<'PY'
import json
import math
import sys
from collections import defaultdict
from pathlib import Path

import torch

(fisher_path, cov_path, want_fp, want_max_len, want_modules_raw,
 want_model, ckpt, want_rows) = sys.argv[1:9]
want_max_len = int(want_max_len)
want_modules = [item for item in want_modules_raw.split(",") if item]
want_rows = int(want_rows)

payload = torch.load(fisher_path, map_location="cpu")
fishers = payload["fishers"]
meta = payload.get("metadata", {})
counts = payload.get("counts", {})
problems: list[str] = []

# ---------------------------------------------------------------- A) metadata
print("[A] metadata 自检")
print(f"  estimator          : {meta.get('estimator')}")
print(f"  loss_reduction     : {meta.get('loss_reduction')}   supervision: {meta.get('supervision')}")
print(f"  per_example_backward: {meta.get('per_example_backward')}")
print(f"  num_examples (N)   : {meta.get('num_examples')}")
print(f"  model_name         : {meta.get('model_name')}")
print(f"  pool_fingerprint   : {meta.get('pool_fingerprint')}")
print(f"  max_len / trunc    : {meta.get('max_len')} / {meta.get('truncation_side')}")
print(f"  use_bf16           : {meta.get('use_bf16')}")
print(f"  target_modules     : {','.join(meta.get('target_modules', []))}")

if meta.get("per_example_backward") is not True:
    problems.append(
        "per_example_backward 不是 True —— 对 batch 求和的梯度再平方算的是 (Σg)²，"
        "不是 Σg²，那不是 Fisher"
    )
if str(meta.get("model_name", "")) != want_model:
    problems.append(f"model_name={meta.get('model_name')} != 本作业的基座 {want_model}")
if str(meta.get("pool_fingerprint", "")) != want_fp:
    problems.append(
        f"pool_fingerprint={meta.get('pool_fingerprint')} != Step 0 算的 {want_fp}"
    )
if int(meta.get("max_len", -1)) != want_max_len:
    problems.append(f"max_len={meta.get('max_len')} != {want_max_len}")
if str(meta.get("truncation_side", "")) != "left":
    problems.append(
        f"truncation_side={meta.get('truncation_side')} != left。右截断先切答案，"
        "被切干净的行 supervised token 数为 0、贡献 0，会静默稀释 F"
    )
if int(meta.get("use_bf16", -1)) != 0:
    problems.append("use_bf16 != 0：梯度被舍入到 8 位尾数才平方，F 带约 1% 噪声底")
if int(meta.get("num_examples", 0)) != want_rows:
    problems.append(
        f"N={meta.get('num_examples')} != 池行数 {want_rows}。F 和 C 必须吃同样多的行"
        "（冒烟用的 MAX_SAMPLES 产物不能用于正式实验）"
    )

# ------------------------------------------------------- B) 层集合 vs C
print("\n[B] 层覆盖")
num_layers = int(json.loads((Path(ckpt) / "config.json").read_text())["num_hidden_layers"])
expected = sum(1 if item == "lm_head" else num_layers for item in want_modules)
print(f"  模块数             : {len(fishers)}  (期望 {expected} = "
      f"{num_layers} 层 x {len([m for m in want_modules if m != 'lm_head'])}"
      + (" + lm_head" if "lm_head" in want_modules else "") + ")")
if len(fishers) != expected:
    problems.append(
        f"模块数 {len(fishers)} != 期望 {expected}。--target_modules 里某个名字"
        "在这个模型上没命中（find_target_linear_module_names 是后缀匹配）"
    )

families: dict[str, list[str]] = defaultdict(list)
for name in fishers:
    families[name.split(".")[-1]].append(name)
for family in sorted(families):
    shapes = {tuple(fishers[name].shape) for name in families[family]}
    print(f"    {family:<12} {len(families[family]):>4} 个   shape={sorted(shapes)}")
print("  note: F 是 d_out x d_in，C 是 d_in x d_in，所以两者形状不同是对的。")

if Path(cov_path).is_file():
    cov_payload = torch.load(cov_path, map_location="cpu")
    cov_keys = set(cov_payload["covariances"])
    cov_fp = str(cov_payload.get("metadata", {}).get("pool_fingerprint", ""))
    if cov_keys == set(fishers):
        print(f"  与 C 的层集合     : 完全一致（{len(cov_keys)} 个模块）ok")
    else:
        problems.append(
            f"F 和 C 的层集合不同。只有 C 有: {sorted(cov_keys - set(fishers))[:5]}；"
            f"只有 F 有: {sorted(set(fishers) - cov_keys)[:5]}。"
            "两个方法必须约束同一批层，否则比较的是覆盖范围而不是权重矩阵"
        )
    # 这是这条线最重要的一条交叉校验：C 和 F 是不是真的吃了同一批行。
    if cov_fp == str(meta.get("pool_fingerprint", "")):
        print(f"  与 C 的池指纹     : 一致 ok  ({cov_fp[:16]}...)")
    else:
        problems.append(
            f"C 的池指纹 {cov_fp} != F 的 {meta.get('pool_fingerprint')}。"
            "两者看到的不是同一批旧知识，onereplay vs EWC 的对照失效"
        )
else:
    print(f"  与 C 的对比       : 跳过（{cov_path} 不存在）")

# -------------------------------------------------------- C) 数值健康
print("\n[C] 数值健康")
total_elements = sum(matrix.numel() for matrix in fishers.values())
bad_finite: list[str] = []
negative: list[str] = []
zero_elements = 0
family_mean: dict[str, list[float]] = defaultdict(list)
global_max = 0.0
weighted_sum = 0.0
for name, matrix in fishers.items():
    matrix = matrix.float()
    if not torch.isfinite(matrix).all():
        bad_finite.append(name)
        continue
    minimum = float(matrix.min())
    if minimum < 0.0:
        negative.append(f"{name}({minimum:.3e})")
    zero_elements += int((matrix == 0).sum())
    weighted_sum += float(matrix.sum())
    global_max = max(global_max, float(matrix.max()))
    family_mean[name.split(".")[-1]].append(float(matrix.mean()))

mean_magnitude = weighted_sum / max(total_elements, 1)
print(f"  元素总数           : {total_elements / 1e9:.3f}G "
      f"({total_elements * 4 / 1024 ** 3:.2f} GiB fp32)")
print(f"  mean / max         : {mean_magnitude:.4e} / {global_max:.4e}")
print(f"  零元素比例         : {zero_elements / max(total_elements, 1) * 100:.2f}%")
print("    F=0 的权重在 EWC 下完全不受约束。比例很高说明 20k 行没能激活那部分参数。")
if bad_finite:
    problems.append(f"有 NaN/Inf 的层: {bad_finite[:5]}")
if negative:
    problems.append(
        f"有负元素的层: {negative[:5]}。F 是梯度平方的均值，逐元素必然 >= 0"
    )
print("  各家族 mean（量级差异正常，梯度尺度本身按层类型分布）:")
for family in sorted(family_mean):
    values = family_mean[family]
    print(f"    {family:<12} {sum(values) / len(values):.4e}")

# ------------------------------------------------------- D) 估计量健康
print("\n[D] 估计量健康")
print("  Numina 的长度跨度（答案 P50=351 / P90=778 / max=2666）比 OpenR1 那版窄得多，")
print("  ESS 被少数长 CoT 压低的风险因此低不少，但 ||g_n||² 仍随监督 token 数增长，")
print("  所以这一组还是要看。")
report = meta.get("length_weighting", {})
if report:
    print(json.dumps(report, indent=2, ensure_ascii=False))
    examples = float(report.get("examples", 0) or 0)
    ess = float(report.get("effective_sample_size", 0) or 0)
    ess_ratio = float(report.get("ess_ratio", 0) or 0)
    zero_rows = float(report.get("zero_supervision_rows", 0) or 0)
    exponent = float(report.get("length_exponent", float("nan")))
    print()
    print(f"  ESS = {ess:.0f} / {examples:.0f}  ({ess_ratio:.3f})")
    print("    「F 实际建立在多少条样本上」。远小于 N 意味着少数长答案主导了估计，")
    print("    那 F 描述的就不是这 20k 行的平均敏感度，而是那几条的。")
    if ess_ratio < 0.05:
        problems.append(
            f"ess_ratio={ess_ratio:.3f} < 0.05：F 几乎只由 {ess:.0f} 条样本决定。"
            "EWC 的对照仍然能跑，但必须在报告里写明这件事"
        )
    print(f"  zero_supervision_rows = {zero_rows:.0f}")
    print("    这些行没有任何被监督的 token，贡献 0 但仍计入 N（add_empty）。")
    print("    左截断 + 4096 下应当**正好是 0**（Numina 全序列 max=2810，根本截不到）；")
    print("    不为 0 说明池里有空 targets，或者 MAXLEN 被调小过。")
    if zero_rows > 0.01 * max(examples, 1.0):
        problems.append(
            f"zero_supervision_rows={zero_rows:.0f} 超过 1% 的行没有监督 token，"
            "F 被静默稀释了这么多"
        )
    if not math.isnan(exponent):
        print(f"  length_exponent = {exponent:.3f}")
        print("    ||g_n||² ~ T_n^a 的拟合指数。逐 token 梯度互不相关给 a=1，完全对齐给")
        print("    a=2。落在 1-2 之间正常；长 CoT 上偏向 2 是可以理解的（推理链内部相关）。")
else:
    problems.append("metadata 里没有 length_weighting，无法判断估计量是否健康")

if meta.get("prompt_prefix_mismatches"):
    print(f"\n  prompt_prefix_mismatches = {meta['prompt_prefix_mismatches']}")
    print("    这些行的 prompt 渲染不是完整渲染的干净 token 前缀，mask 退化到共同前缀。")
    print("    少量正常（chat template 的边界 token）；成千上万条就要查 template 了。")

counts_values = set(counts.values())
if len(counts_values) > 1:
    problems.append(f"各层的 example 计数不一致: {sorted(counts_values)[:5]}")

# ---------------------------------------------------------- E) λ 起点
print("\n[E] EWC 的 λ 起点")
print(f"  F 的 mean = {mean_magnitude:.4e}  ->  1/mean = {1.0 / max(mean_magnitude, 1e-30):.4e}")
print("  从这个量级起，按十倍一档往两边扩。")
print("  **不要借用 onereplay 的 λ**：F 是梯度平方、C 是激活二阶矩，量级差好几个数量级。")
print("  train.py 的 --regularizer help 原话: the two scales are not comparable and")
print("  need separate sweeps。EWC 臂要自己跑一遍 lambda_probe。")

print()
if problems:
    print("=" * 72)
    for item in problems:
        print(f"!! {item}")
    print("=" * 72)
    raise SystemExit("F_math 诊断未通过")
print("诊断全部通过：F_math 可用。")
PY
fi

# ===========================================================================
# 产物与下一步
# ===========================================================================
echo ""
echo "========================================================================"
COV_SIZE="$( [[ -f "${COV_PATH}" ]] && du -h "${COV_PATH}" | cut -f1 || echo '-' )"
FISHER_SIZE="$( [[ -f "${FISHER_PATH}" ]] && du -h "${FISHER_PATH}" | cut -f1 || echo '未采' )"
cat <<EOF
产物:
  C_math = ${COV_PATH}   (${COV_SIZE})
  F_math = ${FISHER_PATH}   (${FISHER_SIZE})
    采在  : ${MATH_CKPT}
    池子  : ${POOL_FILE}  (${POOL_FP_ROWS} 行)
    指纹  : ${POOL_HASH}
    scope : ${SCOPE}  (${TARGET_MODULES})

本线**不需要混合**：只保护一个域（Math），所以 C_math 直接就是训练用的 C。
62/68 号那种 mix_covariances 步骤在这里没有对应物。

下一步 —— 101 号 Stage 2：在 FLANv2 上训 IF，同时保 Math。四条臂共用上面这批旧知识:
  vanilla    不加载任何 penalty
  onereplay  --regularizer onereplay --cov_path ${COV_PATH} --replay_lambda <λ_or>
  ewc        --regularizer ewc --fisher_path ${FISHER_PATH} --replay_lambda <λ_ewc>
  replay     --replay_data_files ${POOL_FILE} --replay_max_len ${MAXLEN}

  注意 --replay_max_len ${MAXLEN}：新任务 FLANv2 的 --max_len 是 1536，但 replay 行是
  math，Numina 全序列 P99=1507、max=2810，跟着用 1536 会开始切尾。这是 Part 2 那条
  注释的镜像。

  101 号的默认值还指着 OpenR1 那一版，所以投的时候要显式覆盖这三项：
    COV_PATH=${COV_PATH}
    FISHER_PATH=${FISHER_PATH}
    POOL_FILE=${POOL_FILE}
  基座也要换成 numina 训出来的 Model-Math（MATH_LINE_ROOT=${MATH_LINE_ROOT}）。

  评测：Math 保留用 gsm8k + math500，新任务 IF 用 ifeval + followbench。
EOF
echo "Job finished at: $(date)"
