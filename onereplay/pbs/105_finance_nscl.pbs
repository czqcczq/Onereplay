#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N fin_nscl
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# finance 线的第五条臂：Adam-NSCL（特征协方差零空间投影），只做 mix
#
#   先看阈值可不可用（几分钟，不占 GPU，见第 3 条）:
#     python -m onereplay.baselines.inspect_nscl_nullspace \
#       --cov_path results_finance_*/cov/cov_mix-math-code-w0.5-0.5_gold_all.pt
#
#   qsub -v DRY_RUN=0,THRES=1000 onereplay/pbs/105_finance_nscl.pbs
#   qsub -v DRY_RUN=0,THRES=10000,SVD_LR=4e-4 onereplay/pbs/105_finance_nscl.pbs
#   接入自检：一对短跑，见第 6 条
#     qsub -v DRY_RUN=0,DEGENERATE=1,PROBE=1,CONTROL=1 onereplay/pbs/105_finance_nscl.pbs
#     qsub -v DRY_RUN=0,DEGENERATE=1,PROBE=1           onereplay/pbs/105_finance_nscl.pbs
#   拆两次投:
#     qsub -v DRY_RUN=0,THRES=1000,DO_EVAL=0 ...   然后   DO_TRAIN=0
#
# -----------------------------------------------------------------------------
# 1. 这条臂在表里的位置
# ---------------------
# Adam-NSCL 和 onereplay 吃的是**同一个 C**，区别只在软硬：onereplay 把
# tr(ΔW C ΔWᵀ) 加进 loss 让优化器自己权衡，Adam-NSCL 直接把每一步 Adam 更新投影
# 到 C 的近似零空间里，让这个二次型按构造趋于零，没有 λ。
#
# 所以它是这张表里 onereplay 最直接的对照物 —— 比 OSFT（99 号）更直接，因为 OSFT
# 的保护信号是权重自身的奇异谱，与旧知识数据无关。要让这个对照成立，C 必须**逐字**
# 是 95 号 mix 臂用的那一个，下面的 COV_PATH 默认值就是照 95 号 L455 拼的。
#
# 结构上这个脚本抄的是 99 号（域无关、一个旋钮一个 run），训练调用 / 旧域 val /
# 评测 / 汇总几段与 95、99 逐字相同。
#
# -----------------------------------------------------------------------------
# 2. !! 超参按 profile 走，不散落在文件里
# --------------------------------------
# 与 99 号同一套机制：finance 这条线的 lr / epochs / maxlen 在 PROFILE=finance 块
# 里，Step 0 会和 95 号逐个对表，不等就退出。换模型或换数据集时**新增一个
# profile**，不要改 finance 那组数。
#
# -----------------------------------------------------------------------------
# 3. !! THRES 必须先用预检脚本定，不能照抄上游
# -------------------------------------------
# 判据是「λ ≤ λ_min × thres」—— 锚在谱的**底部**，不是顶部。上游的 CNN 特征协方差
# 是真正降秩的（有精确零），所以 thres=10/30 就够。transformer 的输入协方差没有精确
# 零，谱在八九个数量级上平滑衰减，于是 thres 选中多少完全由"噪声底有多宽"决定，
# 这个量和模型、任务、hidden size 都没关系，猜不出来。
#
# 两个失败方向在训练日志里都看不出来：
#   选太少 → 被投影的权重几乎动不了，这条臂变成"冻结骨架 + 可训嵌入"，loss 照样降
#   选太多 → 什么都没约束住，这条臂就是 vanilla，只是名字叫 NSCL
#
# 所以 Step 0 会**强制**跑一遍 inspect_nscl_nullspace，在这个 THRES 上判定
# locked / vanilla / leaky / usable，不是 usable 就直接退出。投之前自己先跑一遍能
# 省一次排队：
#   python -m onereplay.baselines.inspect_nscl_nullspace --cov_path <上面那个 C>
#
# -----------------------------------------------------------------------------
# 4. SVD_LR：为什么要单独一个学习率
# --------------------------------
# 上游的 get_transforms 存的不是投影算子 P，而是 P/‖P‖_F。对秩 k 的正交投影
# ‖P‖_F = sqrt(k)，所以每一步更新在投影之后还被额外缩小了 1/sqrt(k)，而 k 逐层不同。
# 名义 lr 不是有效 lr，也不能从另外几条臂搬过来。
#
# 上游自己的选择是 svd_lr = model_lr / 2（5e-5 对 1e-4），也就是**接受**这个缩小而
# 不是补偿它。预检脚本会同时给出"补偿到和别的臂同步"所需的倍数（约 sqrt(k)）。
# 两端都值得扫：忠实复现上游是一个问题，"这条臂有没有真的动过"是另一个问题，一条
# 根本没动的臂不构成对这个方法的证据。
#
# SVD_LR 不给就用 LR，并且会在 Step 0 大声提示这既不是上游的设置也不是补偿后的设置。
#
# -----------------------------------------------------------------------------
# 5. !! bf16 会破坏这个方法的保证，这条臂的 USE_BF16 默认是 0
# ----------------------------------------------------------
# 上游的 step 以 p.data.add_(update) 结束，舍入是相对 |W| 而不是相对 |update| 的。
# 一旦单步更新接近权重 dtype 在 |W| 处的间隔，ΔW 就主要由舍入构成 —— 而舍入是各向
# 同性的，正好落满投影本该排除掉的那些方向。
#
# check_nscl 在合成数据上量过：fp32 下 ΔW 漏到子空间外的能量是 1e-6；把投影矩阵舍
# 入到 bf16 只涨到 1e-3；但**权重**用 bf16 就是 7e-2，步长/间隔比降到 1e-3 时是 7e-1。
# 丢掉保证的是累加，不是投影。
#
# 所以这条臂默认 USE_BF16=0。代价是显存和墙钟，收益是这条臂测的确实是这个方法。
# 要跑 bf16 版就显式传 USE_BF16=1，train.py 会打印 step/spacing 比值并在低于 10 时
# 警告，这个比值也会进 metrics（nscl_step_resolution），报告时必须带上。
#
# -----------------------------------------------------------------------------
# 6. 接入自检：DEGENERATE=1 对 CONTROL=1
# -------------------------------------
# NSCL 没有 OSFT 的 URR=1.0 那种"天然退化点"：即使 thres 大到保留全部方向，P 也是
# 单位阵，而存的是 I/sqrt(d)，更新仍被缩小 sqrt(d) 倍。但这给了一个**精确**的退化
# 对照：thres → ∞ 且 svd_lr = lr × sqrt(d_in) 时，这条臂逐步等于普通全量微调。
#
# DEGENERATE=1 就是这个模式：自动把 THRES 设成 1e30，把 SVD_LR 设成 LR × sqrt(d_in)
# （d_in 从 C 里读，并检查所有被覆盖的层同宽）。它必须和 CONTROL=1 那一跑重合。
#
# !! 对照不能用 94 号的 vanilla：PROBE 会把整条 cosine 压进 MAX_STEPS 步、末尾 lr
# 归零，而 94 号在同一位置还在 2-epoch cosine 的一半上，数据量也差一倍。
#
#   qsub -v DRY_RUN=0,DEGENERATE=1,PROBE=1,CONTROL=1 onereplay/pbs/105_finance_nscl.pbs
#   qsub -v DRY_RUN=0,DEGENERATE=1,PROBE=1           onereplay/pbs/105_finance_nscl.pbs
#
# 两条都跑完后，后跑的那条会自动打并排表。顺序无所谓。一条 probe 约 5 分钟。
#
# 代码层面的自检另有一个，投这个作业之前应该已经跑过（不需要 GPU 和 checkpoint）：
#   python -m onereplay.baselines.check_nscl
#
# -----------------------------------------------------------------------------
# 7. 方法的出处
# ------------
# Adam-NSCL = "Training Networks in Null Space of Feature Covariance for
# Continual Learning", CVPR 2021 oral。优化器全部来自作者的仓库，以未修改的 git
# clone 放在 baseline/Adam-NSCL，由 onereplay/baselines/nscl.py 导入而不是拷贝。
# 那个文件的头部记了 pin 住的 commit，以及三处必须显式说明的偏离。Step 0 会核对
# commit。
#
# 一处偏离在这里也要知道：C 用的是我们 collect_cov 逐 token 累加的 E[x xᵀ]，不是
# 上游那个先对 batch 求均值的版本 —— 后者对 (batch, seq, hidden) 的激活根本跑不起来
# （torch.mm 不吃 3D）。这也正是让这条臂和 onereplay 臂共用同一个 C 的原因。
#
# -----------------------------------------------------------------------------
# 8. 投递前要有
# ------------
#   1) baseline/Adam-NSCL 已 clone 到 REPO_ROOT 下并 checkout 到 pin 的 commit
#   2) 93 号 Step 4 合成的 mix C（与 95 号 mix/onereplay 臂**同一个文件**）
#   3) 93 号 Step 1 物化出来的 math / code val 切片
#   4) 94 号的 base 与 vanilla 已评完（base 缺席时 ret_* 三列会是 '-'）
#   5) ${DATASET_DIR} = data/processed/finance_train
#   6) 评测数据（缺哪个跳过哪个指标，只警告）
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
NLTK_DATA="${NLTK_DATA:-${VENV}/nltk_data}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/105_finance_nscl.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_finnscl_${JOBTAG}}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_finnscl_${JOBTAG}}"
  EXTRA_BIND=""
fi

# =============================================================================
# 外层：裸计算节点，只负责起容器再把自己跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]]    || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_finnscl_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR NLTK_DATA
    MODEL_DIR MODEL_NAME RESULTS_ROOT METRICS_DIR CKPT_DIR EVAL_ROOT
    DATA_ROOT PROCESSED_DIR STATS_DIR DATASET_DIR DATASET_CACHE
    PROFILE PROFILE_SOURCE SKIP_PROFILE_CHECK
    THRES SVD_LR DEGENERATE CONTROL USE_BF16 COV_DIR COV_PATH ADAM_NSCL_SRC
    SKIP_NULLSPACE_CHECK
    PROBE PROBE_STEPS MAX_STEPS SAVE
    SPLIT_DIR OLD_VAL OLD_VAL_ROWS MIX_DOMAINS MIX_WEIGHTS
    DRY_RUN DO_TRAIN DO_EVAL FORCE_TRAIN FORCE_EVAL WITH_RETENTION
    EPOCHS LR LR_SCHEDULER WARMUP_RATIO BATCH ACCUM MAXLEN VAL_FRAC MAXVAL
    EVAL_BATCH SYSTEM_PROMPT SEED MAX_TRAIN_SAMPLES LOG_EVERY EVAL_BEFORE_TRAIN
    BENCH_ROOT FPB_DATA FIQASA_DATA TFNS_DATA
    MATH_DATA_DIR CODE_DATA_DIR MATH500_FILE GSM8K_FILE
    HUMANEVAL_FILE MBPP_DIR MBPP_SPLIT IFEVAL_INPUT IFBENCH_INPUT WITH_IFBENCH
    FINANCE_MAX_NEW FINANCE_BATCH LIMIT
    MATH_MAX_NEW_TOKENS CODE_MAX_NEW_TOKENS IF_MAX_NEW_TOKENS IFBENCH_MAX_NEW_TOKENS
    MATH_BATCH CODE_BATCH IFEVAL_BATCH IFBENCH_BATCH CODE_TIMEOUT
    DECODE_STOP_ON_IM_END VANILLA_RUN
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e --nv -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  # 不能用 exec：会把当前 shell 换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
export NLTK_DATA="${NLTK_DATA}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv

cd "${REPO_ROOT}"

# =============================================================================
# 超参 profile。见文件头第 2 条。
# =============================================================================
PROFILE="${PROFILE:-finance}"

case "${PROFILE}" in
  finance)
    # ---- 训练：来自 95 号 L375-392，与 94 号的 vanilla 逐字相同 ----
    PROFILE_MODEL_NAME="Qwen2.5-1.5B-Instruct"
    PROFILE_DATASET_SUBDIR="finance_train"
    PROFILE_EPOCHS="2"
    PROFILE_LR="8e-5"
    PROFILE_LR_SCHEDULER="cosine"
    PROFILE_WARMUP_RATIO="0.1"
    PROFILE_BATCH="8"
    PROFILE_ACCUM="64"                           # NSCL 不从 batch 里切行，直接用原值
    PROFILE_MAXLEN="1216"
    PROFILE_VAL_FRAC="0.01"
    PROFILE_MAXVAL="200"
    PROFILE_SEED="42"
    PROFILE_MAX_TRAIN_SAMPLES="0"
    PROFILE_LOG_EVERY="500"
    PROFILE_EVAL_BEFORE_TRAIN="1"
    PROFILE_SYSTEM_PROMPT=""
    PROFILE_OLD_VAL_ROWS="500"
    # ---- 评测：来自 95 号 L644-656，与 94 号逐字相同 ----
    PROFILE_FINANCE_MAX_NEW="128"
    PROFILE_FINANCE_BATCH="128"
    PROFILE_MATH_MAX_NEW_TOKENS="4096"
    PROFILE_CODE_MAX_NEW_TOKENS="512"
    PROFILE_IF_MAX_NEW_TOKENS="768"
    PROFILE_IFBENCH_MAX_NEW_TOKENS="2048"
    PROFILE_MATH_BATCH="32"
    PROFILE_CODE_BATCH="64"
    PROFILE_IFEVAL_BATCH="32"
    PROFILE_IFBENCH_BATCH="16"
    PROFILE_CODE_TIMEOUT="10"
    PROFILE_DECODE_STOP_ON_IM_END="1"
    PROFILE_SOURCE="${PROFILE_SOURCE:-${REPO_ROOT}/onereplay/pbs/95_finance_arms.pbs}"
    ;;
  *)
    echo "未知 PROFILE='${PROFILE}'。现有：finance。" >&2
    echo "  新实验线请在本文件的 case 里加一个分支，把那条线的超参连同出处写进去。" >&2
    exit 2
    ;;
esac

MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-${PROFILE_MODEL_NAME}}"
EPOCHS="${EPOCHS:-${PROFILE_EPOCHS}}"
LR="${LR:-${PROFILE_LR}}"
LR_SCHEDULER="${LR_SCHEDULER:-${PROFILE_LR_SCHEDULER}}"
WARMUP_RATIO="${WARMUP_RATIO:-${PROFILE_WARMUP_RATIO}}"
BATCH="${BATCH:-${PROFILE_BATCH}}"
ACCUM="${ACCUM:-${PROFILE_ACCUM}}"
MAXLEN="${MAXLEN:-${PROFILE_MAXLEN}}"
VAL_FRAC="${VAL_FRAC:-${PROFILE_VAL_FRAC}}"
MAXVAL="${MAXVAL:-${PROFILE_MAXVAL}}"
EVAL_BATCH="${EVAL_BATCH:-${BATCH}}"
SEED="${SEED:-${PROFILE_SEED}}"
MAX_TRAIN_SAMPLES="${MAX_TRAIN_SAMPLES:-${PROFILE_MAX_TRAIN_SAMPLES}}"
LOG_EVERY="${LOG_EVERY:-${PROFILE_LOG_EVERY}}"
EVAL_BEFORE_TRAIN="${EVAL_BEFORE_TRAIN:-${PROFILE_EVAL_BEFORE_TRAIN}}"
SYSTEM_PROMPT="${SYSTEM_PROMPT:-${PROFILE_SYSTEM_PROMPT}}"
OLD_VAL_ROWS="${OLD_VAL_ROWS:-${PROFILE_OLD_VAL_ROWS}}"

FINANCE_MAX_NEW="${FINANCE_MAX_NEW:-${PROFILE_FINANCE_MAX_NEW}}"
FINANCE_BATCH="${FINANCE_BATCH:-${PROFILE_FINANCE_BATCH}}"
MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS:-${PROFILE_MATH_MAX_NEW_TOKENS}}"
CODE_MAX_NEW_TOKENS="${CODE_MAX_NEW_TOKENS:-${PROFILE_CODE_MAX_NEW_TOKENS}}"
IF_MAX_NEW_TOKENS="${IF_MAX_NEW_TOKENS:-${PROFILE_IF_MAX_NEW_TOKENS}}"
IFBENCH_MAX_NEW_TOKENS="${IFBENCH_MAX_NEW_TOKENS:-${PROFILE_IFBENCH_MAX_NEW_TOKENS}}"
MATH_BATCH="${MATH_BATCH:-${PROFILE_MATH_BATCH}}"
CODE_BATCH="${CODE_BATCH:-${PROFILE_CODE_BATCH}}"
IFEVAL_BATCH="${IFEVAL_BATCH:-${PROFILE_IFEVAL_BATCH}}"
IFBENCH_BATCH="${IFBENCH_BATCH:-${PROFILE_IFBENCH_BATCH}}"
CODE_TIMEOUT="${CODE_TIMEOUT:-${PROFILE_CODE_TIMEOUT}}"
DECODE_STOP_ON_IM_END="${DECODE_STOP_ON_IM_END:-${PROFILE_DECODE_STOP_ON_IM_END}}"

# =============================================================================
# 路径。C 必须和 95 号 mix/onereplay 臂是同一个文件，见文件头第 1 条。
# =============================================================================
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_finance_${MODEL_NAME}}"
METRICS_DIR="${METRICS_DIR:-${RESULTS_ROOT}/metrics}"
CKPT_DIR="${CKPT_DIR:-${RESULTS_ROOT}/checkpoints}"
EVAL_ROOT="${EVAL_ROOT:-${REPO_ROOT}/results_finance_eval}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
export HF_DATASETS_CACHE="${DATASET_CACHE}"
TRAIN_LOG_DIR="${RESULTS_ROOT}/train_logs"

DATA_ROOT="${DATA_ROOT:-${REPO_ROOT}/data}"
PROCESSED_DIR="${PROCESSED_DIR:-${DATA_ROOT}/processed}"
DATASET_DIR="${DATASET_DIR:-${PROCESSED_DIR}/${PROFILE_DATASET_SUBDIR}}"

SPLIT_DIR="${SPLIT_DIR:-${RESULTS_ROOT}/pools}"
OLD_VAL="${OLD_VAL:-1}"
val_file_for () { printf '%s' "${SPLIT_DIR}/$1_val${OLD_VAL_ROWS}.jsonl"; }

# qsub -v 自己按逗号切参数，所以从命令行传的时候只能写成 math:code / 0.25:0.75。
# 归一回逗号后拼出的 MIX_TAG 与 93/95 号是同一行，才指得到同一个 C 文件。
MIX_DOMAINS="${MIX_DOMAINS:-math,code}"
MIX_WEIGHTS="${MIX_WEIGHTS:-0.5,0.5}"
MIX_DOMAINS="${MIX_DOMAINS//:/,}"
MIX_WEIGHTS="${MIX_WEIGHTS//:/,}"
MIX_TAG="mix-$(printf '%s' "${MIX_DOMAINS//,/-}")-w$(printf '%s' "${MIX_WEIGHTS//,/-}")"
OLD_VAL_DOMAINS="${MIX_DOMAINS//,/ }"

COV_DIR="${COV_DIR:-${RESULTS_ROOT}/cov}"
COV_PATH="${COV_PATH:-${COV_DIR}/cov_${MIX_TAG}_gold_all.pt}"

# =============================================================================
# NSCL 的旋钮。见文件头第 3、4、6 条。
# =============================================================================
DEGENERATE="${DEGENERATE:-0}"
CONTROL="${CONTROL:-0}"
for _flag in DEGENERATE CONTROL; do
  if [[ "${!_flag}" != "0" && "${!_flag}" != "1" ]]; then
    echo "${_flag} 只能是 0 / 1，得到 '${!_flag}'" >&2
    exit 2
  fi
done

THRES="${THRES:-}"
SVD_LR="${SVD_LR:-}"
if [[ "${DEGENERATE}" == "1" ]]; then
  # 精确退化点：保留全部方向，并把 1/sqrt(d_in) 的缩小补偿回去。SVD_LR 在 Step 0
  # 读到 C 的维度之后才算得出来，这里先占位。
  THRES="1e30"
  echo "DEGENERATE=1：THRES 钉成 ${THRES}，SVD_LR 将按 LR x sqrt(d_in) 自动算出。"
  [[ -n "${SVD_LR}" ]] && {
    echo "!! DEGENERATE=1 时不能同时指定 SVD_LR，那样就不是退化点了。" >&2
    exit 2
  }
elif [[ -z "${THRES}" ]]; then
  echo "必须指定 THRES（--nscl_thres，零空间的特征值截断倍数）。它是 Adam-NSCL 唯一" >&2
  echo "的超参，占据 onereplay 那条臂 λ 的位置，同样不给默认值。" >&2
  echo "  !! 不要照抄上游的 10 / 30：那是给有精确零空间的 CNN 协方差用的，" >&2
  echo "     transformer 的谱平滑衰减，同一个值可能把权重全锁死。" >&2
  echo "  先跑预检（几分钟，不占 GPU）：" >&2
  echo "    python -m onereplay.baselines.inspect_nscl_nullspace \\" >&2
  echo "      --cov_path ${COV_PATH}" >&2
  echo "  然后挑它判成 usable 的值：" >&2
  echo "    qsub -v DRY_RUN=0,THRES=<值> ${SELF_PATH}" >&2
  exit 2
fi
if ! python -c "import sys; sys.exit(0 if float('${THRES}') >= 1.0 else 1)" 2>/dev/null; then
  echo "THRES='${THRES}' 不是一个 >= 1 的数。低于 1 时判据可能一个方向都选不中，" >&2
  echo "上游会拿全零矩阵除以自己的零范数，得到 NaN 投影而不是报错。" >&2
  exit 2
fi

# 见文件头第 5 条：这条臂默认 fp32，因为 bf16 的权重累加会把保证吃掉。
USE_BF16="${USE_BF16:-0}"
SKIP_NULLSPACE_CHECK="${SKIP_NULLSPACE_CHECK:-0}"

DRY_RUN="${DRY_RUN:-1}"
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"
WITH_RETENTION="${WITH_RETENTION:-1}"
SKIP_PROFILE_CHECK="${SKIP_PROFILE_CHECK:-0}"
MAX_STEPS="${MAX_STEPS:-0}"
SAVE="${SAVE:-1}"

# 接入自检的短跑模式。与 95 号 L545-563 同一套理由：max_steps 在
# trainers/base.py 里是**每个 epoch** 的上限而不是整个 run 的。
PROBE="${PROBE:-0}"
EPOCHS_DECLARED="${EPOCHS}"
if [[ "${PROBE}" == "1" ]]; then
  PROBE_STEPS="${PROBE_STEPS:-4800}"
  MAX_STEPS="${PROBE_STEPS}"
  SAVE=0
  DO_EVAL=0
  EPOCHS=1
fi

ACCUM_STEPS=$((ACCUM / BATCH))
if (( ACCUM_STEPS * BATCH != ACCUM )); then
  echo "!! ACCUM=${ACCUM} 不是 BATCH=${BATCH} 的整数倍，每次更新的行数凑不回 ${ACCUM}。" >&2
  exit 2
fi

# =============================================================================
# 评测配置：与 94/95/99 号逐字相同。
# =============================================================================
BENCH_ROOT="${BENCH_ROOT:-${REPO_ROOT}/datasets/bench}"
FPB_DATA="${FPB_DATA:-${BENCH_ROOT}/fpb/test.jsonl}"
FIQASA_DATA="${FIQASA_DATA:-${BENCH_ROOT}/fiqasa/test.jsonl}"
TFNS_DATA="${TFNS_DATA:-${BENCH_ROOT}/tfns/test.jsonl}"
MATH_DATA_DIR="${MATH_DATA_DIR:-${REPO_ROOT}/datasets/math}"
CODE_DATA_DIR="${CODE_DATA_DIR:-${REPO_ROOT}/datasets/code}"
MATH500_FILE="${MATH500_FILE:-${MATH_DATA_DIR}/math500_test.jsonl}"
GSM8K_FILE="${GSM8K_FILE:-${MATH_DATA_DIR}/gsm8k_test.jsonl}"
HUMANEVAL_FILE="${HUMANEVAL_FILE:-${CODE_DATA_DIR}/humaneval_test.parquet}"
MBPP_DIR="${MBPP_DIR:-${CODE_DATA_DIR}/mbpp_full}"
MBPP_SPLIT="${MBPP_SPLIT:-test}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"
IFBENCH_INPUT="${IFBENCH_INPUT:-}"
WITH_IFBENCH="${WITH_IFBENCH:-1}"
LIMIT="${LIMIT:-0}"

DOMAIN_METRICS="ifeval gsm8k math500 humaneval mbpp"
if [[ "${WITH_IFBENCH}" == "1" ]]; then
  DOMAIN_METRICS="${DOMAIN_METRICS} ifbench"
fi
DOMAIN_METRICS="${DOMAIN_METRICS} fpb fiqasa tfns"

mkdir -p "${METRICS_DIR}" "${CKPT_DIR}" "${EVAL_ROOT}" "${TRAIN_LOG_DIR}" "${DATASET_CACHE}"

# =============================================================================
# Step 0: 前置检查
# =============================================================================
echo
echo "==== Step 0: 前置检查 ===="

[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "找不到模型: ${MODEL_DIR}/${MODEL_NAME}" >&2; exit 3; }
[[ -d "${DATASET_DIR}" ]] || { echo "找不到新任务数据: ${DATASET_DIR}" >&2; exit 3; }
if [[ "${CONTROL}" != "1" ]]; then
  [[ -f "${COV_PATH}" ]] || {
    echo "找不到 C: ${COV_PATH}" >&2
    echo "  这条臂和 95 号 mix/onereplay 臂必须用同一个文件（93 号 Step 4 的产物）。" >&2
    exit 3
  }
fi
if [[ "${OLD_VAL}" == "1" ]]; then
  for _d in ${OLD_VAL_DOMAINS}; do
    _f="$(val_file_for "${_d}")"
    [[ -f "${_f}" ]] || { echo "找不到 ${_d} 的 val 切片: ${_f}（93 号 Step 1 的产物）" >&2; exit 3; }
  done
fi

# ---- 超参对表。见文件头第 2 条。----
if [[ "${SKIP_PROFILE_CHECK}" == "1" ]]; then
  echo "  !! SKIP_PROFILE_CHECK=1：跳过与 ${PROFILE_SOURCE##*/} 的超参对表。"
  echo "     这条臂和另外几条是否可比，现在没有任何东西在保证。"
elif [[ -z "${PROFILE_SOURCE}" || ! -f "${PROFILE_SOURCE}" ]]; then
  echo "  !! 找不到对表来源 '${PROFILE_SOURCE}'，跳过超参对表。"
else
  PROFILE_SOURCE="${PROFILE_SOURCE}" \
  EPOCHS="${EPOCHS_DECLARED}" LR="${LR}" LR_SCHEDULER="${LR_SCHEDULER}" \
  WARMUP_RATIO="${WARMUP_RATIO}" BATCH="${BATCH}" ACCUM="${ACCUM}" \
  MAXLEN="${MAXLEN}" VAL_FRAC="${VAL_FRAC}" MAXVAL="${MAXVAL}" SEED="${SEED}" \
  MAX_TRAIN_SAMPLES="${MAX_TRAIN_SAMPLES}" LOG_EVERY="${LOG_EVERY}" \
  EVAL_BEFORE_TRAIN="${EVAL_BEFORE_TRAIN}" MODEL_NAME="${MODEL_NAME}" \
  OLD_VAL_ROWS="${OLD_VAL_ROWS}" \
  FINANCE_MAX_NEW="${FINANCE_MAX_NEW}" FINANCE_BATCH="${FINANCE_BATCH}" \
  MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS}" CODE_MAX_NEW_TOKENS="${CODE_MAX_NEW_TOKENS}" \
  IF_MAX_NEW_TOKENS="${IF_MAX_NEW_TOKENS}" IFBENCH_MAX_NEW_TOKENS="${IFBENCH_MAX_NEW_TOKENS}" \
  MATH_BATCH="${MATH_BATCH}" CODE_BATCH="${CODE_BATCH}" \
  IFEVAL_BATCH="${IFEVAL_BATCH}" IFBENCH_BATCH="${IFBENCH_BATCH}" \
  CODE_TIMEOUT="${CODE_TIMEOUT}" DECODE_STOP_ON_IM_END="${DECODE_STOP_ON_IM_END}" \
  python - <<'PY'
import os
import re
import sys

NAMES = [
    "MODEL_NAME", "EPOCHS", "LR", "LR_SCHEDULER", "WARMUP_RATIO", "BATCH",
    "ACCUM", "MAXLEN", "VAL_FRAC", "MAXVAL", "SEED", "MAX_TRAIN_SAMPLES",
    "LOG_EVERY", "EVAL_BEFORE_TRAIN", "OLD_VAL_ROWS",
    "FINANCE_MAX_NEW", "FINANCE_BATCH", "MATH_MAX_NEW_TOKENS",
    "CODE_MAX_NEW_TOKENS", "IF_MAX_NEW_TOKENS", "IFBENCH_MAX_NEW_TOKENS",
    "MATH_BATCH", "CODE_BATCH", "IFEVAL_BATCH", "IFBENCH_BATCH",
    "CODE_TIMEOUT", "DECODE_STOP_ON_IM_END",
]

source = os.environ["PROFILE_SOURCE"]
with open(source, encoding="utf-8") as handle:
    text = handle.read()

missing, mismatched, checked = [], [], []
for name in NAMES:
    match = re.search(
        rf'^{name}="\$\{{{name}:-(.*?)\}}"\s*$', text, flags=re.MULTILINE
    )
    if match is None:
        missing.append(name)
        continue
    theirs = match.group(1)
    if "${" in theirs:
        continue
    ours = os.environ.get(name, "")
    if ours != theirs:
        mismatched.append((name, ours, theirs))
    else:
        checked.append(name)

print(f"  超参对表：{os.path.basename(source)}，比中 {len(checked)} 项")
if missing:
    print(f"  !! 在对表来源里找不到这些名字，无法核对：{missing}")
if mismatched:
    print()
    print("!! 超参与对表来源不一致。这条臂和另外几条不可比，而这种偏差事后")
    print("   只会表现为一个解释不了的数字，不会报错：")
    for name, ours, theirs in mismatched:
        print(f"   - {name}: 本脚本 '{ours}'  vs  {os.path.basename(source)} '{theirs}'")
    print()
    print("   要么改回来，要么在本文件里新增一个 PROFILE 分支。")
    sys.exit(1)
print("  超参对表通过")
PY
fi

# ---- 上游 commit ----
if git -C "${REPO_ROOT}/baseline/Adam-NSCL" rev-parse HEAD >/dev/null 2>&1; then
  NSCL_HEAD="$(git -C "${REPO_ROOT}/baseline/Adam-NSCL" rev-parse HEAD)"
  EXPECT_HEAD="$(python -c 'from onereplay.baselines.nscl import UPSTREAM_COMMIT; print(UPSTREAM_COMMIT)')"
  if [[ "${NSCL_HEAD}" != "${EXPECT_HEAD}" ]]; then
    echo "!! baseline/Adam-NSCL 在 ${NSCL_HEAD:0:10}，baselines/nscl.py 是对着 ${EXPECT_HEAD:0:10} 写的。" >&2
    echo "   get_eigens / get_transforms / step 的调用约定可能已经变了。" >&2
    exit 3
  fi
  echo "  clone commit 与 baselines/nscl.py 一致 (${NSCL_HEAD:0:10})"
else
  echo "  !! baseline/Adam-NSCL 不是 git checkout，无法核对 commit。"
fi

# ---- C 的形状，以及 DEGENERATE 需要的 sqrt(d_in) ----
EXPECT_NSCL_LAYERS=0
COV_DIM=0
if [[ "${CONTROL}" != "1" ]]; then
  read -r EXPECT_NSCL_LAYERS COV_DIM < <(
    COV_PATH="${COV_PATH}" python - <<'PY'
import os
import sys

from onereplay.core.covariance import load_covariance_file

covariances = load_covariance_file(os.environ["COV_PATH"])
dims = {int(matrix.shape[-1]) for matrix in covariances.values()}
print(f"  C           : {os.environ['COV_PATH']}", file=sys.stderr)
print(f"  覆盖层数    : {len(covariances)}，输入维度 {sorted(dims)}", file=sys.stderr)
if len(dims) != 1:
    # DEGENERATE 的补偿系数是单一的 sqrt(d_in)，逐层不同宽时那个退化点不成立。
    # 正常的 THRES run 不受影响，所以这里只在 DEGENERATE 下是致命的。
    print("  !! 各层输入维度不一致，DEGENERATE 模式不可用。", file=sys.stderr)
    print(f"{len(covariances)} 0")
else:
    print(f"{len(covariances)} {dims.pop()}")
PY
  )
  if ! [[ "${EXPECT_NSCL_LAYERS}" =~ ^[0-9]+$ ]] || (( EXPECT_NSCL_LAYERS == 0 )); then
    echo "!! 读不出 C 的层数（上面是 python 的输出）。C 文件可能损坏或为空。" >&2
    exit 3
  fi
  echo "  期望 ${EXPECT_NSCL_LAYERS} 个被投影的权重"
fi

if [[ "${DEGENERATE}" == "1" ]]; then
  if (( COV_DIM <= 0 )); then
    echo "!! DEGENERATE=1 需要所有被覆盖层的输入维度相同，当前不满足。" >&2
    exit 3
  fi
  SVD_LR="$(python -c "print(repr(${LR} * ${COV_DIM} ** 0.5))")"
  echo "  DEGENERATE  : d_in=${COV_DIM}，SVD_LR = ${LR} x sqrt(${COV_DIM}) = ${SVD_LR}"
  echo "                这一跑应当逐步等于 CONTROL=1，见文件头第 6 条。"
fi
SVD_LR="${SVD_LR:-${LR}}"

# ---- !! 这个 THRES 到底选中了什么。见文件头第 3 条。----
if [[ "${CONTROL}" == "1" || "${SKIP_NULLSPACE_CHECK}" == "1" || "${DEGENERATE}" == "1" ]]; then
  echo "  （跳过零空间预检：CONTROL / DEGENERATE / SKIP_NULLSPACE_CHECK）"
else
  echo
  echo "  零空间预检 THRES=${THRES}"
  # 判定走退出码而不是抓 stdout：表格用 %g 印阈值，命令行传的 1e5 在表里是
  # 100000，正则对不上。--require_usable 把同一个判定变成退出码。
  NSCL_PRECHECK_RC=0
  python -m onereplay.baselines.inspect_nscl_nullspace \
    --cov_path "${COV_PATH}" --thres_grid "${THRES}" --device cuda \
    --require_usable 1 || NSCL_PRECHECK_RC=$?
  if (( NSCL_PRECHECK_RC != 0 )); then
    echo >&2
    echo "!! THRES=${THRES} 在这个 C 上不可用（上面那行给了判定）。" >&2
    echo "   locked  = 有层被锁死，那一跑的被投影权重几乎不会动，但 loss 照样降。" >&2
    echo "   vanilla = 什么都没约束住，那一跑就是全量微调，只是名字叫 NSCL。" >&2
    echo "   leaky   = 保留的子空间仍带着旧数据的能量，保护的不是它声称保护的东西。" >&2
    echo "   先扫一遍完整网格再挑：" >&2
    echo "     python -m onereplay.baselines.inspect_nscl_nullspace --cov_path ${COV_PATH}" >&2
    echo "   确实要跑一个不可用的点（比如就是要做端点对照）就传 SKIP_NULLSPACE_CHECK=1。" >&2
    exit 3
  fi
  echo "  预检通过"
fi

# =============================================================================
# run 名：EVAL_ROOT 与 94/95/99 号共用，所以必须自带臂名、THRES 和 SVD_LR。
# 两个都要进名字：它们是这条臂的两个独立旋钮，少一个就会让不同的点同名，
# checkpoint 互相覆盖、metrics jsonl 追加混在一起。
# =============================================================================
run_name_for () {
  local thres="$1" svdlr="$2" control="${3:-${CONTROL}}"
  local name="fin_nscl_${MIX_TAG}_thres${thres}_svdlr${svdlr}"
  name="${name}_lr${LR}_ep${EPOCHS}_seed${SEED}"
  [[ "${USE_BF16}" == "1" ]] && name="${name}_bf16"
  if [[ "${PROBE}" == "1" || "${MAX_STEPS}" != "0" ]]; then
    name="${name}_probe${MAX_STEPS}"
  fi
  # 后缀而不是前缀，这样一对 run 在目录列表里紧挨着。
  [[ "${control}" == "1" ]] && name="${name}_control"
  printf '%s' "${name}"
}
VANILLA_RUN="${VANILLA_RUN:-fin_vanilla_lr${LR}_ep${EPOCHS_DECLARED}_seed${SEED}}"
BASE_RUN="base"

RUN="$(run_name_for "${THRES}" "${SVD_LR}")"
RUN_METRICS="${METRICS_DIR}/${RUN}.jsonl"
TRAIN_LOG="${TRAIN_LOG_DIR}/${RUN}.train.log"
PARTNER_RUN="$(run_name_for "${THRES}" "${SVD_LR}" "$((1 - CONTROL))")"
PARTNER_METRICS="${METRICS_DIR}/${PARTNER_RUN}.jsonl"

echo
echo "========================================================================"
echo "finance 线 nscl 臂：保护 ${MIX_TAG}"
echo "  profile  = ${PROFILE}"
echo "  W_ref    = ${MODEL_DIR}/${MODEL_NAME}   (裸底座，与其它臂相同)"
echo "  新任务   = ${DATASET_DIR}"
if [[ "${CONTROL}" == "1" ]]; then
echo "  CONTROL  = 1   **不开 NSCL**，同一套超参的对照跑。"
echo "             搭档 = ${PARTNER_RUN}"
else
echo "  C        = ${COV_PATH}"
echo "             与 95 号 mix/onereplay 臂同一个文件 —— 这条臂是它的硬约束版本"
echo "  THRES    = ${THRES}   (λ ≤ λ_min x thres 的方向被保留，更新只能动在里面)"
echo "  SVD_LR   = ${SVD_LR}   (被投影权重的 lr；投影矩阵另有 1/sqrt(k) 的缩小)"
fi
echo "  精度     = $([[ "${USE_BF16}" == "1" ]] && echo 'bf16 !! 见文件头第 5 条' || echo 'fp32（这条臂的默认，bf16 会吃掉零空间保证）')"
if [[ "${OLD_VAL}" == "1" ]]; then
echo "  旧域 val = ${OLD_VAL_ROWS} 行/域，域：${OLD_VAL_DOMAINS}"
echo "             ${SPLIT_DIR}  （93 号切好的，各臂打同一批行）"
else
echo "  旧域 val = OLD_VAL=0，不测"
fi
echo "  batch    = ${BATCH} x accum ${ACCUM_STEPS} = ${ACCUM} 行/update"
echo "  训练     = lr ${LR} ${LR_SCHEDULER} warmup ${WARMUP_RATIO} epochs ${EPOCHS} seed ${SEED}"
echo "             maxlen ${MAXLEN}"
if [[ "${PROBE}" == "1" ]]; then
echo "  模式     = 接入自检短跑，${MAX_STEPS} 步，不存 checkpoint、不评测"
echo "             !! 对照是 ${PARTNER_RUN}，不是 ${VANILLA_RUN}"
else
echo "  模式     = 正式 run"
fi
echo "  run      = ${RUN}"
echo "  评测     = ${DOMAIN_METRICS}"
echo "  分母     = ${BASE_RUN} / ${VANILLA_RUN}"
echo "  阶段     = train:${DO_TRAIN} eval:${DO_EVAL} DRY_RUN=${DRY_RUN}"
echo "========================================================================"

if [[ "${DRY_RUN}" == "1" ]]; then
  echo
  echo "DRY_RUN=1：以上为计划，不训练不评测。"
  echo "  train.py 会收到："
  echo "    --paradigm sft --full_finetune 1 --use_bf16 ${USE_BF16}"
  echo "    --model_dir ${MODEL_DIR} --model_name ${MODEL_NAME}"
  echo "    --dataset_path ${DATASET_DIR}"
  echo "    --epochs ${EPOCHS} --lr ${LR} --lr_scheduler ${LR_SCHEDULER} --warmup_ratio ${WARMUP_RATIO}"
  echo "    --batch_size ${BATCH} --accumulation_size ${ACCUM} --max_len ${MAXLEN}"
  if [[ "${CONTROL}" == "1" ]]; then
    echo "    （CONTROL=1：不传 --nscl，也不传任何 --nscl_* —— train.py 在 --nscl 0 时"
    echo "      看到设过的 --nscl_* 会直接报错，那个检查是故意的）"
  else
    echo "    --nscl 1 --nscl_cov_path ${COV_PATH}"
    echo "    --nscl_thres ${THRES} --nscl_svd_lr ${SVD_LR}"
  fi
  if [[ "${OLD_VAL}" == "1" ]]; then
    _spec=""
    for _d in ${OLD_VAL_DOMAINS}; do
      _spec="${_spec}${_spec:+,}${_d}=$(val_file_for "${_d}")"
    done
    echo "    --prior_val_jsonl ${_spec} --old_val_presliced 1 --old_val_rows ${OLD_VAL_ROWS}"
  fi
  echo "    --save ${SAVE} --save_path ${CKPT_DIR}/${RUN}"
  echo "  没有 --cov_path / --fisher_path / --replay_*：这条臂是硬约束，不加罚项。"
  echo "  没有 --target_modules：full_finetune=1 且无 regularizer 时它不起作用，"
  echo "  NSCL 的覆盖由 --nscl_cov_path 里有哪些层决定。"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 旧域 val：与 95 号 L1181-1192 逐字相同，各臂必须打同一批行。
# =============================================================================
OLD_VAL_ARGS=()
if [[ "${OLD_VAL}" == "1" ]]; then
  _spec=""
  for _d in ${OLD_VAL_DOMAINS}; do
    _spec="${_spec}${_spec:+,}${_d}=$(val_file_for "${_d}")"
  done
  OLD_VAL_ARGS=(
    --prior_val_jsonl "${_spec}"
    --old_val_presliced 1
    --old_val_rows "${OLD_VAL_ROWS}"
  )
fi

# =============================================================================
# Step 1: 训练
# =============================================================================
if [[ "${DO_TRAIN}" == "1" ]]; then
  if [[ "${FORCE_TRAIN}" != "1" && "${SAVE}" == "1" && -d "${CKPT_DIR}/${RUN}" ]]; then
    echo
    echo "已存在 checkpoint，跳过训练: ${CKPT_DIR}/${RUN}"
    echo "  要重训就传 FORCE_TRAIN=1，或换一个 SEED。"
  else
    mkdir -p "${RESULTS_ROOT}/map_cache/${RUN}"
    echo
    echo "==== train ${RUN} ===="
    if [[ "${CONTROL}" == "1" ]]; then
      echo "  CONTROL=1：不开 NSCL  batch ${BATCH} x accum ${ACCUM_STEPS} = ${ACCUM}"
      # 一个数组而不是复制整条命令：两条 run 只应该差这几个 flag。
      NSCL_ARGS=()
    else
      echo "  THRES=${THRES} SVD_LR=${SVD_LR}  batch ${BATCH} x accum ${ACCUM_STEPS} = ${ACCUM}"
      echo "  启动时会先对 ${EXPECT_NSCL_LAYERS} 个协方差各做一次 SVD，几分钟。"
      NSCL_ARGS=(
        --nscl 1
        --nscl_cov_path "${COV_PATH}"
        --nscl_thres "${THRES}"
        --nscl_svd_lr "${SVD_LR}"
      )
    fi

    python -m onereplay.scripts.train --paradigm sft --full_finetune 1 \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
      --use_bf16 "${USE_BF16}" \
      --system_prompt "${SYSTEM_PROMPT}" \
      --dataset_path "${DATASET_DIR}" \
      --epochs "${EPOCHS}" --lr "${LR}" \
      --lr_scheduler "${LR_SCHEDULER}" --warmup_ratio "${WARMUP_RATIO}" \
      --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
      --max_len "${MAXLEN}" \
      --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" \
      --eval_batch_size "${EVAL_BATCH}" \
      --eval_before_train "${EVAL_BEFORE_TRAIN}" \
      --max_train_samples "${MAX_TRAIN_SAMPLES}" \
      --max_steps "${MAX_STEPS}" \
      --map_cache_dir "${RESULTS_ROOT}/map_cache/${RUN}" \
      --log_every "${LOG_EVERY}" \
      ${OLD_VAL_ARGS[@]+"${OLD_VAL_ARGS[@]}"} \
      ${NSCL_ARGS[@]+"${NSCL_ARGS[@]}"} \
      --save "${SAVE}" --save_path "${CKPT_DIR}/${RUN}" \
      --metrics_path "${RUN_METRICS}" 2>&1 | tee "${TRAIN_LOG}"

    # ---- 训练自检 ----
    # 95 号那边是 assert_coverage（罚项覆盖了几层）。这条臂没有罚项，对应的问题是
    # "投影到底装上没有、装在几层上"。日志里没有这一行就说明投影没生效，而那样的
    # run 和 vanilla 完全一样，却会被当成 NSCL 记进表里。
    echo
    echo "==== 训练自检 ===="
    if [[ "${CONTROL}" == "1" ]]; then
      if grep -qF -- "Adam-NSCL:" "${TRAIN_LOG}"; then
        echo "  !! CONTROL=1 的日志里出现了 Adam-NSCL 的输出，说明 --nscl 还是传进去了。" >&2
        grep -F "Adam-NSCL:" "${TRAIN_LOG}" | head -n 3 >&2
        exit 1
      fi
      echo "  ok  没有任何 Adam-NSCL 输出，这是一条纯全量微调的对照"
    else
      if ! grep -qF -- "Adam-NSCL: ${EXPECT_NSCL_LAYERS} weights projected" "${TRAIN_LOG}"; then
        echo "  !! 日志里没有 'Adam-NSCL: ${EXPECT_NSCL_LAYERS} weights projected'。" >&2
        grep -F "weights projected" "${TRAIN_LOG}" | head -n 1 || true
        echo "     投影没有按预期装上，这个 run 不可用。" >&2
        exit 1
      fi
      echo "  ok  ${EXPECT_NSCL_LAYERS} 个权重被投影"
      grep -F "Adam-NSCL: kept" "${TRAIN_LOG}" | head -n 1
      # 两个端点：全锁死和完全没约束。预检已经挡过一次，这里是"实际发生了什么"。
      if grep -qF -- "Adam-NSCL: every layer kept under" "${TRAIN_LOG}"; then
        echo "  !! 每层保留的方向都不到 1%，这一跑是冻结骨架而不是 NSCL。" >&2
        exit 1
      fi
      if [[ "${DEGENERATE}" != "1" ]] && grep -qF -- "Adam-NSCL: almost nothing was dropped" "${TRAIN_LOG}"; then
        echo "  !! 几乎什么都没丢，这一跑等价于全量微调。" >&2
        exit 1
      fi
      if grep -qF -- "that ratio is too low" "${TRAIN_LOG}"; then
        echo "  !! step/spacing 比值过低：更新大部分被权重 dtype 的舍入吃掉了，" >&2
        echo "     而舍入是各向同性的，零空间保证不成立。见文件头第 5 条。" >&2
        grep -F "spacing of" "${TRAIN_LOG}" | head -n 1 >&2
        if [[ "${USE_BF16}" == "1" ]]; then
          echo "     这条跑的是 USE_BF16=1。改用默认的 fp32，或调高 SVD_LR。" >&2
        fi
        exit 1
      fi
    fi
    if grep -qE -- "(covariance|Fisher) matrices from" "${TRAIN_LOG}"; then
      echo "  !! 日志里出现了 regularizer 的矩阵加载：这条臂不该有罚项。" >&2
      exit 1
    fi

    echo "  checkpoint : ${CKPT_DIR}/${RUN}"
    echo "  metrics    : ${RUN_METRICS}"
  fi
fi

if [[ "${PROBE}" == "1" ]]; then
  echo
  echo "PROBE=1：短跑结束，不存 checkpoint、不评测。"
  if [[ -s "${PARTNER_METRICS}" ]]; then
    echo
    echo "==== NSCL / 对照 并排 ===="
    A_NAME="${RUN}" A_METRICS="${RUN_METRICS}" \
    B_NAME="${PARTNER_RUN}" B_METRICS="${PARTNER_METRICS}" \
    DEGENERATE="${DEGENERATE}" \
    python - <<'PY'
import json
import os


def last_epoch(path):
    best = {}
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if not line.strip():
                continue
            record = json.loads(line)
            if record.get("record_type") == "epoch":
                best = record
    return best


a = last_epoch(os.environ["A_METRICS"])
b = last_epoch(os.environ["B_METRICS"])
# train_steps 和 lr_end 排在最前：这两个不同的话下面就不是对照，是两个实验。
FIELDS = [
    ("train_steps", ".0f"),
    ("train_samples", ".0f"),
    ("lr_end", ".3e"),
    ("train_task_loss", ".6f"),
    ("val_loss", ".6f"),
    ("old_val_loss_math", ".6f"),
    ("old_val_loss_code", ".6f"),
    ("peak_memory_allocated_gb", ".4f"),
    ("train_sec", ".0f"),
]
print(f"{'field':<28}{'this run':>16}{'partner':>16}{'delta':>16}")
print("-" * 76)
for field, spec in FIELDS:
    left, right = a.get(field), b.get(field)
    if left is None and right is None:
        continue
    delta = (
        format(left - right, "+" + spec)
        if isinstance(left, (int, float)) and isinstance(right, (int, float))
        else "-"
    )
    print(
        f"{field:<28}"
        + f"{'-' if left is None else format(left, spec):>16}"
        + f"{'-' if right is None else format(right, spec):>16}"
        + f"{delta:>16}"
    )
print()
if a.get("train_steps") != b.get("train_steps") or a.get("lr_end") != b.get("lr_end"):
    print("!! train_steps 或 lr_end 不同：两跑的调度不一样，下面的 loss 不可比。")
elif os.environ.get("DEGENERATE") == "1":
    print("DEGENERATE=1：保留了全部方向，且 svd_lr 已把 1/sqrt(d_in) 补偿回去，所以")
    print("两跑应当几乎重合。train_task_loss 和 val_loss 差到小数点后三四位以外，就")
    print("说明接入有问题 —— 最可能是投影矩阵的 dtype 转换或 Adam 状态没对齐。")
else:
    print("这不是退化点，两跑本来就应该不同。要做接入自检请用 DEGENERATE=1。")
PY
  else
    echo "  搭档还没跑：${PARTNER_METRICS}"
    if [[ "${CONTROL}" == "1" ]]; then
      echo "    qsub -v DRY_RUN=0,DEGENERATE=${DEGENERATE},PROBE=1 ${SELF_PATH}"
    else
      echo "    qsub -v DRY_RUN=0,DEGENERATE=${DEGENERATE},PROBE=1,CONTROL=1 ${SELF_PATH}"
    fi
    echo "  两条都跑完后，后跑的那条会自动打并排表。"
  fi
  echo "Job finished at: $(date)"
  exit 0
fi

if [[ "${DO_EVAL}" != "1" ]]; then
  echo
  echo "DO_EVAL=0：跳过评测。补评："
  echo "  qsub -v DRY_RUN=0,THRES=${THRES},SVD_LR=${SVD_LR},DO_TRAIN=0 ${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# Step 2: 评测（与 95 号 Step 3 / 99 号 Step 2 逐字相同）
# =============================================================================
ifbench_ready () {
  python - <<'PY' >/dev/null 2>&1
from ifbench import instructions_registry
from onereplay.eval.metrics.ifbench import check_nltk_data

assert len(instructions_registry.INSTRUCTION_DICT) >= 83
check_nltk_data()
PY
}

AVAIL=""
for m in ${DOMAIN_METRICS}; do
  case "${m}" in
    fpb)       [[ -f "${FPB_DATA}"       ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 fpb：缺 ${FPB_DATA}" ;;
    fiqasa)    [[ -f "${FIQASA_DATA}"    ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 fiqasa：缺 ${FIQASA_DATA}" ;;
    tfns)      [[ -f "${TFNS_DATA}"      ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 tfns：缺 ${TFNS_DATA}" ;;
    ifeval)    [[ -f "${IFEVAL_INPUT}"   ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 ifeval：缺 ${IFEVAL_INPUT}" ;;
    gsm8k)     [[ -f "${GSM8K_FILE}"     ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 gsm8k：缺 ${GSM8K_FILE}" ;;
    math500)   [[ -f "${MATH500_FILE}"   ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 math500：缺 ${MATH500_FILE}" ;;
    humaneval) [[ -f "${HUMANEVAL_FILE}" ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 humaneval：缺 ${HUMANEVAL_FILE}" ;;
    mbpp)      [[ -d "${MBPP_DIR}"       ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 mbpp：缺 ${MBPP_DIR}" ;;
    ifbench)
      if ifbench_ready; then
        AVAIL="${AVAIL} ${m}"
      else
        echo "跳过 ifbench：依赖没就绪。见 onereplay/pbs/73_ifbench_eval.pbs 文件头。"
      fi
      ;;
  esac
done
AVAIL="${AVAIL# }"
if [[ -z "${AVAIL}" ]]; then
  echo "要评的指标一个数据都没找到，跳过评测" >&2
  exit 6
fi

pending_metrics () {
  local name="$1"; shift
  local out=""
  for m in "$@"; do
    if [[ "${FORCE_EVAL}" == "1" || ! -f "${EVAL_ROOT}/${m}/${name}/summary.json" ]]; then
      out="${out}${out:+,}${m}"
    fi
  done
  echo "${out}"
}

if [[ ! -d "${CKPT_DIR}/${RUN}" ]]; then
  echo "找不到 checkpoint: ${CKPT_DIR}/${RUN}" >&2
  echo "  先跑 DO_TRAIN=1，或检查 THRES / SVD_LR 是否与训练时一致。" >&2
  exit 4
fi

# shellcheck disable=SC2086
MP="$(pending_metrics "${RUN}" ${AVAIL})"
if [[ -z "${MP}" ]]; then
  echo "==== skip ${RUN}：所有指标都已有结果（FORCE_EVAL=1 可重评）===="
else
  echo
  echo "==== eval ${RUN} (${MP}) ===="
  EVAL_ARGS=(
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}"
    --adapter_path "${CKPT_DIR}/${RUN}" --run_name "${RUN}"
    --out_dir "${EVAL_ROOT}" --metrics "${MP}" --seed "${SEED}"
    --system_prompt "${SYSTEM_PROMPT}"
    --decode_stop_on_im_end "${DECODE_STOP_ON_IM_END}"
    --limit "${LIMIT}"
    --fpb_data_path "${FPB_DATA}"
    --fiqasa_data_path "${FIQASA_DATA}"
    --tfns_data_path "${TFNS_DATA}"
    --finance_max_new_tokens "${FINANCE_MAX_NEW}"
    --finance_batch_size "${FINANCE_BATCH}"
    --math500_data_path "${MATH500_FILE}"
    --gsm8k_data_path "${GSM8K_FILE}"
    --math_max_new_tokens "${MATH_MAX_NEW_TOKENS}"
    --math_batch_size "${MATH_BATCH}"
    --humaneval_data_file "${HUMANEVAL_FILE}"
    --mbpp_dataset_path "${MBPP_DIR}" --dataset_split "${MBPP_SPLIT}"
    --code_max_new_tokens "${CODE_MAX_NEW_TOKENS}"
    --code_batch_size "${CODE_BATCH}"
    --timeout "${CODE_TIMEOUT}"
    --ifeval_input "${IFEVAL_INPUT}"
    --ifeval_batch_size "${IFEVAL_BATCH}"
    --max_new_tokens "${IF_MAX_NEW_TOKENS}"
    --ifbench_limit "${LIMIT}"
    --ifbench_max_new_tokens "${IFBENCH_MAX_NEW_TOKENS}"
    --ifbench_batch_size "${IFBENCH_BATCH}"
  )
  [[ -n "${IFBENCH_INPUT}" ]] && EVAL_ARGS+=(--ifbench_input "${IFBENCH_INPUT}")
  python -m onereplay.scripts.evaluate "${EVAL_ARGS[@]}"
fi

# =============================================================================
# Step 3: base 答对子集上的保留率（与 95 号 Step 4 逐字相同）
# =============================================================================
RETENTION_JSON=""
if [[ "${WITH_RETENTION}" == "1" ]]; then
  RET_METRICS="${AVAIL// /,}"
  RETENTION_JSON="${EVAL_ROOT}/retention/${RUN}.json"
  mkdir -p "$(dirname "${RETENTION_JSON}")"
  echo
  echo "==== Step 3: base 答对子集上的保留率 ===="
  RET_RC=0
  python -m onereplay.scripts.score_retention_subset \
    --results_root "${EVAL_ROOT}" --metrics "${RET_METRICS}" \
    --runs "${BASE_RUN},${VANILLA_RUN},${RUN}" --baseline "${BASE_RUN}" \
    --json_out "${RETENTION_JSON}" || RET_RC=$?
  if (( RET_RC != 0 )); then
    echo "warning: score_retention_subset 退出码 ${RET_RC}，主表的 ret_* 三列会是 '-'。"
  fi
  [[ -s "${RETENTION_JSON}" ]] || RETENTION_JSON=""
fi

# =============================================================================
# Step 4: 汇总 —— base / vanilla / 本臂并排（与 95 号 Step 5 同一套表）
# =============================================================================
echo
echo "========================================================================"
echo "结果汇总：nscl 保护 ${MIX_TAG}   THRES=${THRES} SVD_LR=${SVD_LR}"
echo "========================================================================"
OUT_DIR="${EVAL_ROOT}" RUN_NAME="${RUN}" ARM_NAME="nscl" \
BASE_NAME="${BASE_RUN}" VANILLA_NAME="${VANILLA_RUN}" \
METRIC_NAMES="${AVAIL}" RETENTION_JSON="${RETENTION_JSON}" \
RUN_METRICS="${RUN_METRICS}" VANILLA_METRICS="${METRICS_DIR}/${VANILLA_RUN}.jsonl" \
python - <<'PY'
import json
import os
from pathlib import Path

out_dir = Path(os.environ["OUT_DIR"])
run_name = os.environ["RUN_NAME"]
base_name = os.environ["BASE_NAME"]
vanilla_name = os.environ["VANILLA_NAME"]
arm_name = os.environ["ARM_NAME"]
metric_names = os.environ["METRIC_NAMES"].split()

NEW_TASK = {"fpb", "fiqasa", "tfns"}
SCORE_KEYS = ("accuracy", "pass_at_1", "strict_prompt_accuracy")
METRIC_SCORE_KEY = {"ifbench": "loose_prompt_accuracy"}


def read_score(metric, name):
    path = out_dir / metric / name / "summary.json"
    if not path.is_file():
        return None
    payload = json.loads(path.read_text(encoding="utf-8"))
    override = METRIC_SCORE_KEY.get(metric)
    if override:
        return payload.get(override)
    for key in SCORE_KEYS:
        if key in payload:
            return payload[key]
    return None


def cell(value, spec=".4f", width=10):
    return f"{'-' if value is None else format(value, spec):>{width}}"


retention = {}
retention_path = os.environ.get("RETENTION_JSON", "")
if retention_path and os.path.isfile(retention_path):
    for record in json.loads(Path(retention_path).read_text(encoding="utf-8")):
        retention[(record["metric"], record["run"])] = record


def read_retention(metric, name):
    """这个 run 在 base 答对的那些题上还对多少。"""
    record = retention.get((metric, name))
    return None if record is None else record.get("accuracy_on_base_correct")


print("保留（d_base 是遗忘量，d_van 才是本臂救回来多少 —— 后者是方法的效果）")
print(
    f"{'metric':<12}{'base':>10}{'vanilla':>10}{arm_name:>11}"
    f"{'d_base(pp)':>12}{'d_van(pp)':>11}{'ret_van':>10}{'ret_ours':>10}{'d_ret(pp)':>11}"
)
print("-" * 97)
for metric in metric_names:
    if metric in NEW_TASK:
        continue
    base = read_score(metric, base_name)
    van = read_score(metric, vanilla_name)
    ours = read_score(metric, run_name)
    d_base = (ours - base) * 100 if (base is not None and ours is not None) else None
    d_van = (ours - van) * 100 if (van is not None and ours is not None) else None
    ret_van = read_retention(metric, vanilla_name)
    ret_ours = read_retention(metric, run_name)
    d_ret = (
        (ret_ours - ret_van) * 100
        if (ret_van is not None and ret_ours is not None)
        else None
    )
    print(
        f"{metric:<12}" + cell(base) + cell(van) + cell(ours, ".4f", 11)
        + cell(d_base, "+.2f", 12) + cell(d_van, "+.2f", 11)
        + cell(ret_van) + cell(ret_ours) + cell(d_ret, "+.2f", 11)
    )

print()
print("新任务（方向相反：这里掉了就是在拿 finance 的性能换旧能力）")
print(f"{'metric':<12}{'base':>10}{'vanilla':>10}{arm_name:>11}{'d_van(pp)':>12}")
print("-" * 55)
for metric in metric_names:
    if metric not in NEW_TASK:
        continue
    base = read_score(metric, base_name)
    van = read_score(metric, vanilla_name)
    ours = read_score(metric, run_name)
    d_van = (ours - van) * 100 if (van is not None and ours is not None) else None
    print(
        f"{metric:<12}" + cell(base) + cell(van) + cell(ours, ".4f", 11)
        + cell(d_van, "+.2f", 12)
    )

if retention:
    print()
    print("ret_* = base 答对的题里这个 run 还答对的比例（1.0 = 一道没丢），d_ret = 本臂 - vanilla。")
else:
    print()
    print("ret_* 三列是 '-'：没有保留率结果（WITH_RETENTION=0，或 base 还没评过）。")


def read_records(path):
    if not path or not os.path.isfile(path):
        return []
    rows = []
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                rows.append(json.loads(line))
    return rows


def last_epoch(path):
    rows = [r for r in read_records(path) if r.get("record_type") == "epoch"]
    return rows[-1] if rows else {}


def baseline(path):
    rows = [r for r in read_records(path) if r.get("record_type") == "baseline"]
    return rows[-1] if rows else {}


ours_m = last_epoch(os.environ.get("RUN_METRICS"))
van_m = last_epoch(os.environ.get("VANILLA_METRICS"))
ours_b = baseline(os.environ.get("RUN_METRICS"))
van_b = baseline(os.environ.get("VANILLA_METRICS"))

old_keys = sorted(k for k in ours_m if k.startswith("old_val_loss"))
if old_keys:
    print()
    print("旧域 val loss（Δ 是相对各自训练前的起点；正数 = 忘了，越小越好）:")
    print(f"{'domain':<12}{'baseline':>12}{'van_Δ':>12}{'ours_Δ':>12}{'救回':>12}")
    for key in old_keys:
        start = ours_b.get(key)
        final = ours_m.get(key)
        d_ours = (final - start) if (start is not None and final is not None) else None
        v_start, v_final = van_b.get(key), van_m.get(key)
        d_van = (v_final - v_start) if (v_start is not None and v_final is not None) else None
        saved = (d_van - d_ours) if (d_van is not None and d_ours is not None) else None
        name = key.replace("old_val_loss_", "").replace("old_val_loss", "(single)")
        print(
            f"{name:<12}" + cell(start, ".6f", 12) + cell(d_van, "+.6f", 12)
            + cell(d_ours, "+.6f", 12) + cell(saved, "+.6f", 12)
        )
    print("  这条只随权重动，不随生成和解析动。它和 bench 说法不一致时先信它。")
    if len(old_keys) > 1:
        print("  mix 要读的就是这两行分开的数：一侧保住、另一侧塌了，才是「保护容量不够，")
        print("  两个域在抢」这个结论。平均成一个数会把它藏起来。")
    # NSCL 不改变前向（投影只在 optimizer.step 里），所以起点必须和 vanilla 一致。
    # 这一点比 OSFT 强：那边有因子化前向的固有差，这边没有。
    if van_b:
        drift = [
            abs(ours_b[k] - van_b[k])
            for k in old_keys
            if ours_b.get(k) is not None and van_b.get(k) is not None
        ]
        if drift and max(drift) > 1e-6:
            print(f"  !! 起点与 vanilla 差 {max(drift):.2e}，但 NSCL 不动前向，这里应当为 0。")
            print("     两跑的加载路径或 seed 不一致，后面的 Δ 不可比。")

print()
print("零空间（这几个数确认这一跑确实是 NSCL，而不是悄悄退化成了 vanilla 或冻结骨架）:")
for key, label, spec in (
    ("nscl_thres", "THRES", ".6g"),
    ("nscl_svd_lr", "SVD_LR", ".3e"),
    ("nscl_layers", "被投影的权重数", ".0f"),
    ("nscl_kept_share", "保留方向占比", ".4f"),
    ("nscl_kept_share_min", "  最紧的层", ".4f"),
    ("nscl_kept_share_max", "  最松的层", ".4f"),
    ("nscl_energy_share_max", "最差层的残留能量", ".3e"),
    ("nscl_transform_memory_gb", "投影矩阵常驻 GiB", ".2f"),
    ("nscl_step_resolution", "step/spacing 比值", ".2f"),
):
    value = ours_m.get(key)
    print(f"  {label:<20}" + ("-" if value is None else format(value, spec)))
print(f"  上游 commit         {ours_m.get('nscl_upstream_commit', '-')}")
print(f"  C                   {ours_m.get('nscl_cov_path', '-')}")
resolution = ours_m.get("nscl_step_resolution")
if isinstance(resolution, (int, float)) and resolution < 10:
    print("  !! step/spacing 比值低于 10：更新大部分被权重 dtype 的舍入吃掉，而舍入")
    print("     各向同性，零空间保证在这一跑上不成立。这个数必须随结果一起报出来。")
print("  保留占比接近 0 = 冻结骨架；接近 1 = vanilla。两端在 loss 曲线上都看不出来。")

print()
print("新任务拟合与开销:")
print(f"{'':<14}{'val_loss':>12}{'train_sec':>12}{'peak_mem_GB':>13}")
for label, row in (("vanilla", van_m), (arm_name, ours_m)):
    print(
        f"{label:<14}"
        + cell(row.get("val_loss"), ".6f", 12)
        + cell(row.get("train_sec"), ".0f", 12)
        + cell(row.get("peak_memory_gb"), ".2f", 13)
    )
if ours_m.get("val_loss") and van_m.get("val_loss"):
    delta = ours_m["val_loss"] - van_m["val_loss"]
    print(f"val_loss 差值 = {delta:+.6f}")
    if delta <= 0:
        print("  <= 0：新任务没被本臂拖慢，上面的 d_van 可以直接当保护效果读。")
    else:
        print("  > 0：新任务学得更差了，d_van 里有一部分是'少学了'而不是'保住了'。")
        print("       报结果时必须同时给这两个数。")
if ours_m.get("train_sec") and van_m.get("train_sec"):
    print(f"墙钟比 = {ours_m['train_sec'] / van_m['train_sec']:.2f}x vanilla")
    print("  NSCL 每次 optimizer.step 对每个被投影的权重多做一次 d_in x d_in 矩阵乘，")
    print("  但只发生在 update 上（不是每个 micro-batch），所以这个数应当接近 1。")
    print("  显著大于 1 多半是 fp32 带来的，不是投影本身。")
PY

echo
echo "========================================================================"
echo "本臂完成: ${RUN}"
echo "  同一张表里还差哪几条就投哪几条："
echo "    qsub -v DRY_RUN=0,DOMAIN=mix,ARM=onereplay,LAMBDA=<中心点> ${REPO_ROOT}/onereplay/pbs/95_finance_arms.pbs"
echo "    qsub -v DRY_RUN=0,DOMAIN=mix,ARM=ewc,LAMBDA=<中心点> ${REPO_ROOT}/onereplay/pbs/95_finance_arms.pbs"
echo "    qsub -v DRY_RUN=0,DOMAIN=mix,ARM=replay ${REPO_ROOT}/onereplay/pbs/95_finance_arms.pbs"
echo "    qsub -v DRY_RUN=0,URR=0.25 ${REPO_ROOT}/onereplay/pbs/99_finance_osft.pbs"
echo "  本臂换一个点就改 THRES / SVD_LR，先用预检脚本确认那个 THRES 可用："
echo "    python -m onereplay.baselines.inspect_nscl_nullspace --cov_path ${COV_PATH}"
echo "  接入自检是一对短跑（见文件头第 6 条）："
echo "    qsub -v DRY_RUN=0,DEGENERATE=1,PROBE=1,CONTROL=1 ${SELF_PATH}"
echo "    qsub -v DRY_RUN=0,DEGENERATE=1,PROBE=1           ${SELF_PATH}"
echo "========================================================================"
