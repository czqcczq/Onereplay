#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N p1_if_flan
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# Stage 1 / IF 线: Qwen2.5-Math-1.5B --FLAN-v2--> Model-IF
#                  评 IFEval + IFBench + FollowBench
#                  外加交叉评测 math（DO_CROSS_MATH=1）
#
#     Base ---- FLAN v2 / Flan 2021 (100000 单轮样本) ----> Model-IF
#     评测: IFEval, IFBench, FollowBench      对照: base
#     交叉: GSM8K, MATH-500, AMC, Minerva Math   对照: 91 号的 base 那一行
#     IFBench 从 09-17 起默认开、进报告口径（此前默认关），四条线同口径。
#
# -----------------------------------------------------------------------------
# 【交叉评测：为什么 IF 线要评数学，而且只评 trained】
#
# S3 里出现了一件本来不该出现的事：先训 IF 再训 math，IF 几乎没掉。两种解释对论文的
# 含义相反：(A) math 训练真的不伤 IF；(B) 两个能力正相关 —— S1 训 IF 时 math 就已经
# 涨了、反之亦然，于是 S3 的"没有遗忘"是被这条正相关抵掉的。
#
# 分辨 A 和 B 只需要在 S1 把两个方向都测了。所以本脚本加评 math，91 号加评 IF。
# **交叉侧只评 trained**：base 的 math 分在 91 号已经测过，而两条线的 base 是同一个
# 权重、两边的 math 评测配置逐字相同，所以直接并表就有完整的 2x2：
#
#                   IF (本脚本)          math (91 号)
#     base          本脚本 base          91 号 base
#     Model-IF      本脚本 trained       本脚本 trained + DO_CROSS_MATH=1  <- 新增
#     Model-Math    91 号 DO_CROSS_IF=1                  91 号 trained
#
# 交叉侧的 system prompt 和生成预算**逐字照抄 91 号**，这不是整洁问题：math500 / amc /
# minervamath 的答案提取靠 \boxed{}，而本线主场用的中性 system 消息不含那条指令。拿
# 中性 system 去评数学会让分数虚低，减出来的"IF 训练对 math 的影响"就是口径差而不是
# 能力差。所以交叉侧单独一次 evaluate 调用、单独一个 system（见 MATH_SYSTEM_PROMPT）。
#
# math 侧分两组，因为解码配置不同（详见 91 号文件头「难题集」一节）：
#   标准  gsm8k + math500        贪心 cap=2048
#   难    amc + minervamath      采样 T=1.0 average@4 cap=4096
#
# 三条 Stage 1 线（91 号 math / 93 号 cs / 本脚本 if）现在共用同一个 base 和
# 同一套训练配方：100k 行 / 1 epoch / lr 5e-5 / cosine + warmup 0.1。只有数据
# 和评测不同。换成 Qwen2.5-Math-1.5B 的理由见 91 号文件头：Qwen3-1.7B-Base 上
# 训练 math 前后没有差别，这个模型上有，而 Stage 2/3 的交叉实验要求三条线的
# base 是同一个权重。
#
# 代价是 base 偏科：一个数学专用模型在 IFEval 上的起点会很低。本线读的是
# base -> Model-IF 的**方向和幅度**，不是绝对值，所以这不影响结论。
#
# -----------------------------------------------------------------------------
# 【换模型带来的三个坑，三个都是静默的】
#
# 下面每条都注明了对当前模型（Qwen3-4B-Base）是否还成立，别按旧印象跳读。
#
# 1) **SYSTEM_PROMPT 必须显式传，理由随模型变但结论不变**。
#    在 Qwen2.5-Math-1.5B 上，模板会在没有 system 消息时补上
#        "Please reason step by step, and put your final answer within \boxed{}."
#    而 data/chat.py 的 apply_train_template 和 eval/generation.py 的 render_chat
#    都只传 user 角色。那在 math 线上正是论文的 "default chat template + CoT
#    prompting"（91 号就靠它），在 IF 线上却是污染：每一条训练行和每一条
#    IFEval/FollowBench 评测 prompt 都会被要求输出 \boxed{}。IFEval 里大量约束是
#    "不要用逗号"、"回答分三段"这类，和 \boxed{} 直接冲突。
#
#    换成 Qwen3-4B-Base 之后模板不注入任何东西，所以上面那个污染在当前模型上已经不
#    存在了。但 SYSTEM_PROMPT 的默认值**仍然保留**那条中性助手消息，两个原因：已跑
#    完的 conifer / mix 结果都是在它下面测的，去掉等于换了 prompt、和历史不可比；
#    而且 base 模型有一条 system 更容易进入助手模式，对 base 臂的评测更公平。
#    它同时传给 train.py 和 evaluate.py。两边不一致 = 模型在没训过的 prompt 下被
#    评测，分数无意义。93 号（commonsense）同理；91 号（math）反过来，在 4B 上它必
#    须**补上** \boxed{} 指令，因为模板不再送。95 号采集必须和这里逐字一致。
#
# 2) **eos_token 是 <|endoftext|>，但 chat template 用 <|im_end|> 收尾**。模型
#    吐出 <|im_end|> 时 generate 不会停，会续写下一轮对话，skip_special_tokens
#    再把那段拼到答案后面 —— IFEval 的约束检查和 FollowBench 的判分都会读到多
#    出来的那段。evaluate.py 的 --decode_stop_on_im_end 默认是 0，本脚本固定传 1。
#
# 3) **上下文硬上限 4096**（config.json 的 max_position_embeddings；
#    tokenizer_config 里的 model_max_length=131072 是假的）。这一条只咬评测：
#    训练 MAXLEN=2048 远在窗口内，但 FollowBench 的 example 类把 few-shot 示例
#    内联进 instruction，prompt P90=2516 / max=5019 token。prompt 本身就超窗口
#    的那几行没救（要么 FB_CATEGORIES 排除 example，要么接受），但生成预算必须
#    收住：三个 MAX_NEW_TOKENS 因此都从 2048 降到 1024（见下面「评测预算」一节）。
#
# -----------------------------------------------------------------------------
# 【这条线最可能被误读的地方：FLAN v2 的答案极短】
#
# 实测（Qwen3 tokenizer，四个 remix 都一样）：targets 的 P50 只有 18-19 token，
# 均值约 30。而 Conifer 的答案 P50 是 181。FLAN 的 targets 是分类标签、短答案、
# 翻译句 —— 这本来就是 Flan 2021 的形态，不是数据坏了。
#
# 后果：在这套数据上全量微调**一定会把输出长度压下去**。而 IFEval / IFBench /
# FollowBench 里相当一部分约束（"至少 400 词"、"3 个要点"、format 与 style 类）
# 本质上在量长度。所以：
#
#     报这条线的任何 IF 分数，必须同时报 response_words_p50。
#
# 这是 IFBench 那次诊断留下的口径（results_log/2026-09-12 第 8c 节），92 号脚本
# 的汇总表也是因此带这一列。如果本线的分数比 base 低、而 words 同时大幅缩短，
# 那先怀疑的是长度漂移，不是「FLAN 教不会 IF」——两者要分开归因。
#
# 反过来说，这也正是这一点的科学价值：它给出 alignment gradient 最不对齐那一端
# 的实际读数，包括「通用指令数据会不会反而把 IF 评测拖下去」这个问题的答案。
#
# -----------------------------------------------------------------------------
# 【数据：为什么是 40/40/10/10 而不是官方的 25/25/25/25】
#
# 官方 flan2021_submix（run_example.py）把四种模板等权混合：
#     flan_zsopt 1 : flan_fsopt 1 : flan_zsnoopt 1 : flan_fsnoopt 1
# 按**行**等权是可辩护的默认，但这条线有两个理由偏离它：
#
#   1) few-shot 行比 zero-shot 长 2.5-3.3 倍（实测 token 均值 zs 210-227 /
#      fs 488-615）。按行等权的话 few-shot 会吃掉约 72% 的 token 预算。
#   2) IFEval / IFBench / FollowBench 全都是单轮零样本口径。few-shot 的示例
#      训练的是一种评测从不呈现的格式。
#
# 40/40/10/10 让两种 few-shot 样式都在（它们是 Flan 2021 的一部分），但不让它们
# 占住 token 预算。manifest 里会记下实际的 token 份额，所以这个选择是显式的。
# 想复现官方口径就传 FLAN_WEIGHTS=25:25:25:25（冒号而不是逗号，因为 qsub -v 自己
# 用逗号分隔变量；脚本里会转回逗号）。
#
# 另外两件必须知道的事：
#
#   * 只取 flan 来源，不含 t0 / niv2 / cot / dialog。download_flan_v2.py 只读
#     SirNeural/flan_v2 的 flan_* 四个文件，所以这是数据源层面就定下的，不靠过滤。
#   * 上游 dump 的 `task` 列是常量字符串 "flan"，没有任务粒度。所以 FLAN 自己的
#     capped-proportional 任务平衡（old_knowledge.allocate_task_quota 对 v1 dump
#     做的那件事）在这个 dump 上做不了，也没法报 per-task 表。好消息是这个 dump
#     本身的翻译占比已经只有约 15%（换算后），接近 capped-proportional 的目标值
#     （69 个任务里 5 个是 WMT），所以不需要救。manifest 里的 family 直方图是词法
#     近似的混合指纹，不是任务分布，别当后者用。
#
# -----------------------------------------------------------------------------
# 【训练配方：100k 行 / 1 epoch / 5e-5 / cosine + warmup 0.1，三条线统一】
#
# 数据量和 schedule 都对齐 91 号（它对齐的是 DFT/ICLR2026 §4.1 对 Qwen2.5-Math
# 系列的配方）。本线沿用同一套不是因为 FLAN 属于那篇论文的实验，而是因为三条
# Stage 1 线必须只差数据 —— Stage 3 要比较「从 IF 出发」和「从 math 出发」的
# 遗忘，起点的训练强度不同就没法归因。
#
# 1 epoch 也正好是 FLAN v2 自己的标准配方：它实际是无限量的，不重复样本，而且
# 30 token 的答案重复几遍很容易变成背答案。
#
# 本池 100000 行 / 40:40:10:10 / MAXLEN 2048。1536 时长度报告给过 ≈28.6M tok/epoch；
# 提到 2048 只多收那 4% 的长尾，总量几乎不变，真正带 loss 的仍是约 3M 答案 token。
#
# **warmup 不是可选项**。train.py 在加 --lr_scheduler 之前是裸 torch.optim.Adam、
# 恒定 LR、无 warmup。全参微调在 5e-5 下第一次更新落在一个离自己最优点很远的
# 模型上，没有 warmup 的那一步就是 loss 尖峰的来源。
#
# schedule 按**优化器更新**推进，而 ACCUM 是「行/更新」，所以更新数 = 训练行数 /
# ACCUM，**和 BATCH 无关**（BATCH 只决定 accumulation_steps = ACCUM/BATCH）。
# 三条 source 的池子大小不同，更新数因此不同：
#
#   IF_SOURCE=flan      100k 行   -> 约 1550 次更新，warmup 约 155
#   IF_SOURCE=mix       58.9k 行  -> 约  910 次更新，warmup 约  91   <- 当前默认
#   IF_SOURCE=conifer   38.9k 行  -> 约  600 次更新，warmup 约  60
#
# 训练开头 train.py 会打一行
#     `lr schedule: cosine over ... updates, warmup ... updates`
# 和上表对得上就行（差几次是 val 切分取整，MAXVAL=500 会封顶 1% 那个比例）。
# **数量级对不上才说明池子行数或 ACCUM 和这里的假设不一致，停下来查**。
#
# 还有一个比总 token 更重要的口径差：**带 loss 的答案 token**。label 只在答案上，
# 而 FLAN 的答案均值约 30 token。所以本线的 28.6M 总 token 里真正带监督的只有
# 约 3M，和 math 线（Numina 答案 P50=351）差一个量级。长度报告单独打了这一行，
# 跨线比较 val loss 的绝对值时必须记得这件事。
#
# -----------------------------------------------------------------------------
# 【MAXLEN 2048：救的是 zs 长尾，不是 few-shot 的 8.8%】
#
# tokenizer_to_ids 的截断是 full_input_ids[-max_length:]，保尾丢头。
#
# 在 Conifer 上这是个静默灾难：约束在 user turn 开头，丢头就等于训练「对没有约束
# 的问题给出带格式的答案」。在 FLAN 上恰好相反：few-shot prompt 的结构是
# 「示例1 示例2 … 真正的问题」，问题在最后。所以被截的行只是退化成更少 shot 的
# 同一道题，题干和指令都在。这是良性的。
#
# Qwen2.5-Math tokenizer + 中性 system 下，MODE=data 实测（40/40/10/10）：
#     trunc@1536  zs 1.8-2.2% / fs_opt 8.8% / fs_noopt 6.5% / 子样本整体 4.8%
#     trunc@2048  整体 0.9%
# few-shot 那一截切掉是良性的；zs 的 P99 已经 2142-2291，1536 会切掉零样本题干
# 前半段，所以默认提到 2048。3072 只再降到 0.3%，峰值显存按最长那条付，不划算。
# 仍在 4096 硬上限内。评测生成预算 1024 是 FollowBench prompt 太长逼出来的，
# 和训练 MAXLEN 不是一回事，不要跟着改。
#
# 改这个值必须连 95 号采集和 Stage 3 的 --replay_max_len 一起改。
#
# -----------------------------------------------------------------------------
# 【评测预算：三个都从 2048 降到 1024，这是 4096 窗口逼出来的】
#
# IFEval 541 行 + IFBench 300 行 + FollowBench 820 行，全部 @1024。
#
# 为什么不能更大：Qwen2.5-Math-1.5B 的 max_position_embeddings=4096，prompt +
# 生成一旦越过它，输出落在 RoPE 外推区、不可信。FollowBench 的 example 类
# prompt P90=2516，配 2048 的生成预算就是 4564 —— 已经出界。1024 让 P90 那档
# 落在 3540，留出余量；prompt 本身就超 4096 的极少数行（max=5019）任何预算都
# 救不了，要么 FB_CATEGORIES 排除 example，要么在读数时把它们当已知损失。
#
# 为什么够用：训练数据的答案 P50 只有 18 token，Model-IF 学到的回答长度被这个
# 分布封住，1024 远超它。base 那一行会更慢也更容易跑满预算（一个数学专用模型
# 面对 IF prompt 不会正常收尾），但那正是要测的东西。
#
# 改这三个值必须整张结果表一起重评，不能和旧数字混用。
#
# 按 92 号的估计 FollowBench 约是 IFBench 的 3 倍时间，所以它占一次 eval 的大头。
#
# 所以本脚本允许把评测拆开跑，用三个独立开关：
#     MODE=eval,DO_FOLLOWBENCH=0          先跑 IFEval + IFBench
#     MODE=eval,DO_IFEVAL=0,DO_IFBENCH=0  再单独跑 FollowBench
# 三个默认全开，一次 evaluate 只加载模型一次；拆开是为了卡 walltime。
#
# **IFBench 从 09-17 起默认开**（此前默认关、不在报告口径里）。三条 IF 评测线
# （本脚本、91 号交叉侧、96/100 号）现在报同一套 IFEval + IFBench + FollowBench，
# 否则同一个能力在四张表里有四个口径、没法并排读。它只有 300 条 prompt，比
# FollowBench 便宜得多。
#
# 但它的前置和另外两个不同：**装包 + 四份 NLTK 语料，都要在登录节点做**（见下面
# 【前置】第 3 条）。而依赖缺席时的失败发生在**打分阶段** —— 300 条已经解码完，
# GPU 白烧。所以下面 MODE=eval 里在解码前先探一次（ifbench_ready），探不过就只把
# ifbench 摘掉、其余指标照常评，并打印补齐依赖的命令。
#
# 用三个开关而不是一个 EVAL_METRICS=ifeval,ifbench 列表，是因为 **qsub -v 自己就用
# 逗号分隔变量**，带逗号的值会被 PBS 切开成两个变量名。同理下面 FLAN_WEIGHTS 在
# -v 里要写成冒号形式。
#
# FollowBench 不读全局 --limit（metric 只认 group_limit，已核对代码），所以
# EVAL_LIMIT 截不了它，冒烟要用 FB_GROUP_LIMIT。
#
# FollowBench 只出 rule 那一半（350/820 行、70/164 组），judge 那 470 行落到
# judge_inputs.jsonl，要在有网的地方过 scripts/judge_followbench.py。详见 92 号
# 文件头，那里记了读这张表的三条纪律。
#
# -----------------------------------------------------------------------------
# 【前置】计算节点无外网，第 2 条必须先在登录节点做完
#   1) 模型   ${MODEL_DIR}/${MODEL_NAME}   (Qwen2.5-Math-1.5B)
#   2) FLAN v2 取样（**登录节点，约 10 min，600MB 网络，原始 gz 不落盘**）：
#        python -m onereplay.scripts.download_flan_v2 \
#          --out_dir ${REPO_ROOT}/datasets/flan_v2
#      它从 SirNeural/flan_v2 的 flan_* 四个文件各流式读一个 400MB 解压窗口，
#      蓄水池抽样出 60k/60k/15k/15k 行写成 jsonl。127 GiB 的原始 dump 一个字节
#      都不会写到盘上，所以不占你那 150GB 冗余。
#      日志里会打一张平稳性表（TVD(block, window)），实测四路都在 0.010-0.012，
#      这是「只能从 gz 流头部读」不引入偏置的依据。
#      **默认取样量对 100k 池刚好够用，余量很小，先核一眼**：40/40/10/10 建
#      100k 训练池 + 2k heldout 需要 40800/40800/10200/10200 行，默认下载的是
#      60k/60k/15k/15k。zs 两路余量 47%、fs 两路余量 47%，够；但如果当初是用
#      非默认 --rows 下的，或者要切 disjoint replay（再加 20k，需要
#      48800/48800/12200/12200），就要先在登录节点核对四个 jsonl 的行数：
#        wc -l ${REPO_ROOT}/datasets/flan_v2/flan_v2_*.jsonl
#      不够就重跑 download_flan_v2 并调 --rows。
#      改大 FLAN_TARGET_ROWS 之后要回去看 MODE=data 的输出：配额没凑满时
#      prepare 会打一行 "!! 配额没满足" 并说明该调哪个 --rows。注意那只是
#      **警告不是报错**，退出码仍是 0，所以别只看作业成功就往下走。
#   3) IFEval 随仓库自带；FollowBench 完全 vendored 在
#      onereplay/third_party/followbench/（零外部依赖，不需要 pip 也不需要 NLTK）。
#      **IFBench 两样都要，而且都只能在登录节点做**（它现在默认开）：
#        source ${REPO_ROOT}/.venv/bin/activate
#        pip install "ifbench @ git+https://github.com/allenai/IFBench.git@1c40f0c10d9b5c5c2f10a175a28007ebb64f7f4d"
#        python -m nltk.downloader punkt punkt_tab stopwords averaged_perceptron_tagger_eng
#      commit 是钉死的：checker 函数就是这个指标本身，上游改一个 checker 就会在
#      仓库里什么都没变的情况下移动我们的分数。NLTK 语料在 venv 里会落到
#      ${VENV}/nltk_data，本脚本的 NLTK_DATA 默认就指那里并导进容器 —— 不导出的话
#      容器里的 nltk 只翻 site-packages（空的），而它的 nltk.download() 在离线节点
#      **不报错也不下载**。完整说明见 73 号文件头。
#      两样缺任一，本作业会跳过 ifbench 并打印上面这两条命令，不会整个挂掉。
#   4) mkdir -p ${REPO_ROOT}/logs
#
# 【用法】
#   # 0) 建池 + 看长度报告和 token 预算（CPU 即可，约 5 min）
#   qsub -v MODE=data onereplay/pbs/94_s1_train_if.pbs
#
#   # 1) 冒烟：20 步，看 loss 在动、peak memory 和 tokens/s
#   qsub -v MODE=smoke onereplay/pbs/94_s1_train_if.pbs
#
#   # 2) 正式训练（100k / 1 epoch）+ 评测。LR 由配方给定 5e-5，不需要 sweep。
#   qsub -v MODE=train onereplay/pbs/94_s1_train_if.pbs
#
#   # 3) 只评测，且拆开跑以免卡 walltime（默认就没有 IFBench）
#   qsub -v MODE=eval,DO_FOLLOWBENCH=0 onereplay/pbs/94_s1_train_if.pbs
#   qsub -v MODE=eval,DO_IFEVAL=0      onereplay/pbs/94_s1_train_if.pbs
#
#   # 3b) **交叉评测：Model-IF 的数学能力**（"IF 和 math 是否正相关"那个问题的一半，
#   #     另一半是 91 号的 DO_CROSS_IF=1）。只评 trained：base 的 math 分在 91 号已有。
#   #     已经训完的模型现在只要补这一条作业，训练不用重跑。
#   qsub -v MODE=eval,DO_IFEVAL=0,DO_FOLLOWBENCH=0,DO_CROSS_MATH=1 \
#     onereplay/pbs/94_s1_train_if.pbs
#   # 只要标准侧（gsm8k + math500，贪心，快）
#   qsub -v MODE=eval,DO_IFEVAL=0,DO_FOLLOWBENCH=0,DO_CROSS_MATH=1,DO_HARD_MATH=0 \
#     onereplay/pbs/94_s1_train_if.pbs
#
#   # MODE=lr_sweep 保留但不是必经步骤（三条线统一 5e-5，见上面训练配方一节）
#
#   # FollowBench 冒烟：每类前 2 组阶梯 = 60 行（按组截，不能按行）
#   qsub -v MODE=eval,DO_IFEVAL=0,FB_GROUP_LIMIT=2 onereplay/pbs/94_s1_train_if.pbs
#
#   # 复现官方等权混合。冒号是为了绕开 qsub -v 的逗号分隔，脚本里会转回逗号。
#   qsub -v MODE=data,FLAN_WEIGHTS=25:25:25:25 onereplay/pbs/94_s1_train_if.pbs
#
#   # 只看配置不跑
#   qsub -v MODE=train,DRY_RUN=1 onereplay/pbs/94_s1_train_if.pbs
#
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id>
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/94_s1_train_if.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
# IFBench 的 checker 要四份 NLTK 语料。venv 里 nltk.downloader 会落到
# sys.prefix/nltk_data（和 70/73/81 号同一处），所以默认指那里。必须**导进容器**，
# 否则容器里的 nltk 只翻 site-packages（空的），而它自己的 nltk.download() 在离线
# 计算节点上不报错也不下载 —— 缺语料要等到打分阶段才炸。
NLTK_DATA="${NLTK_DATA:-${VENV}/nltk_data}"
# 用 ${JOB_TMPDIR:-...} 而不是像 90 号那样无条件赋值：外层把 JOB_TMPDIR 转发进
# 容器后内层会再算一遍，而 JOBTAG 在 PBS_JOBID 缺失时退化成 local$$，内外层的 $$
# 并不相同。集群上 PBS_JOBID 总是有的，所以 90 号没被咬到；这里尊重转发值。
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_p1flan_${JOBTAG}}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_p1flan_${JOBTAG}}"
  EXTRA_BIND=""
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_p1flan_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME LINE_ROOT RESULTS_ROOT DATASET_CACHE METRICS_DIR CKPT_DIR
    IF_SOURCE FLAN_SAMPLE_DIR CONIFER_PATH IF_DATASET REPLAY_POOL HELDOUT_POOL
    MODE DRY_RUN DO_TRAIN DO_EVAL SEED FORCE_EVAL
    EPOCHS LR LR_SCHEDULER WARMUP_RATIO BATCH ACCUM MAXLEN VAL_FRAC MAXVAL TARGET_MODULES
    SYSTEM_PROMPT STOP_ON_IM_END
    LR_GRID SWEEP_MAX_STEPS SMOKE_STEPS MAX_TRAIN_SAMPLES LOG_EVERY SWEEP_LOG_EVERY
    FLAN_WEIGHTS FLAN_TARGET_ROWS FLAN_REPLAY_ROWS FLAN_HELDOUT_ROWS
    FLAN_REPLAY_MODE FLAN_DEDUP_ACROSS_REMIXES BUILD_REPLAY_POOL
    FLAN_ANSWER_BUCKETS FLAN_ANSWER_WEIGHTS
    CONIFER_MODE CONIFER_FORMAT_ONLY CONIFER_MAX_TURNS
    CONIFER_INCLUDE_PF CONIFER_DROP_REFUSALS
    MIX_CONIFER_POOL MIX_FLAN_POOL MIX_CONIFER_ROWS MIX_FLAN_ROWS MIX_FLAN_MIN_WORDS
    IFEVAL_INPUT IFBENCH_INPUT IFBENCH_MAX_NEW_TOKENS NLTK_DATA
    FB_DATA FB_CATEGORIES FB_MAX_NEW_TOKENS FB_BATCH FB_GROUP_LIMIT
    DO_IFEVAL DO_IFBENCH DO_FOLLOWBENCH
    EVAL_LIMIT EVAL_BATCH MAX_NEW_TOKENS RUNS_TO_EVAL
    DO_CROSS_MATH CROSS_MATH_OUT_DIR MATH_SYSTEM_PROMPT SYSTEM_PROMPT_PRESET
    GSM8K_DATA MATH500_DATA AMC_DATA MINERVA_DATA
    MATH_MAX_NEW_TOKENS MATH_BATCH DIAG_LEN
    DO_HARD_MATH HARD_MATH_MAX_NEW_TOKENS HARD_MATH_TEMPERATURE HARD_MATH_SAMPLES
    HARD_MATH_BATCH HARD_MATH_OUT_DIR MINERVA_REL_TOL
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e --nv -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
# IFBench 的 checker 要读它。不导出的话容器里的 nltk 只翻 site-packages。
export NLTK_DATA="${NLTK_DATA}"

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv

cd "${REPO_ROOT}"

# ---- 路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
# 全线模型，理由见 91 号同处。要回 1.5B 就传 MODEL_NAME=Qwen2.5-Math-1.5B。
MODEL_NAME="${MODEL_NAME:-Qwen3-4B-Base}"

# ---- 数据源：flan | conifer ----
# 这条线有两个可用语料，它们教的是互补的两件事，都是实测过的：
#
#   FLAN v2   答案 p50 = 6 词，35% 的行只有 1-2 词，几乎不带列表结构。
#             它教「遵守限制」—— IFEval 上 constrained_response 20%→80%、
#             punctuation:no_comma 34.8%→71.2%、keywords:forbidden_words
#             36.7%→69.4%、language:response_language 6.5%→29.0%。
#   Conifer   答案 p50 = 144 词，92.4% 的行在 50 词以上，54.7% 带 bullet 或
#             编号列表，18.1% 有三段以上。它教「产出结构」。
#
# FLAN 单独训 Qwen2.5-Math 的实测结果（IFEval 按 instruction_id 拆开看）：
# 只限制输出的约束 27.3%→40.3%（+13.0），要求多产出的约束 35.3%→13.4%
# （-21.9），于是 prompt-level strict 净掉 4.8 分。掉的全是需要模型多写东西的
# 那类：detectable_format:title -48.6、number_highlighted_sections -41.7、
# combination:repeat_prompt -41.5、detectable_content:postscript -38.5，而
# number_bullet_lists 和 multiple_sections 直接掉到 0%。原因是输出中位数从
# base 的 616 词崩到 32 词 —— 正是文件头「FLAN v2 的答案极短」那节预测的长度
# 漂移，不是「FLAN 教不会 IF」。同一次训练里 FollowBench 的每个 category 都是
# base 的 4-20 倍（content 0%→21.7%、mixed 2.5%→15.0%），能力确实学到了。
#
# 两条 source 各自一个 RESULTS_ROOT，所以 checkpoint / metrics / eval 产物互不
# 覆盖，FLAN 那一轮完整留着可以对照。**训练段和评测段对两条 source 逐行相同**，
# 所以 SYSTEM_PROMPT、STOP_ON_IM_END、IF 评测口径这些修复自动共享，不会出现
# 某条线漏掉某个修复的情况——这也是不去复活已删的 90_part1_if_conifer.pbs 的
# 理由：那份是这些修复之前的版本。
#
# mix 是第三条：Conifer 全量 + FLAN 的长答案部分。两个 source 在 IFEval 上占的
# 约束类型是互不重叠的（Conifer 拿 number_bullet_lists 6.5%→32.3%、
# multiple_sections 14.3%→35.7%、json_format 0%→41.2%，FLAN 把前两个压到 0；
# FLAN 拿 no_comma 34.8%→71.2%、forbidden_words 36.7%→69.4%，Conifer 两个都
# 没动），所以混合是冲着两半一起拿。比例是**长度决定**而不是行数决定，见
# mix_if_pools.py 的文件头。
#
# 默认改成 mix：实测下来 conifer 单独训的 IF 分比不过 mix，IF 线已经定在 mix 上，
# 95/96/100/103 的默认值也一起指过去了。还想跑另外两条 source 就显式传 IF_SOURCE，
# 结果树按 tag 分根，三条互不覆盖。
IF_SOURCE="${IF_SOURCE:-mix}"
case "${IF_SOURCE}" in
  flan)    IF_SOURCE_TAG="flanv2" ;;
  conifer) IF_SOURCE_TAG="conifer" ;;
  mix)     IF_SOURCE_TAG="ifmix" ;;
  *) echo "IF_SOURCE 只能是 flan / conifer / mix，得到 '${IF_SOURCE}'" >&2; exit 2 ;;
esac
# 结果树按**模型**分，这是必须的而不是整洁强迫症。旧的 Qwen3-1.7B-Base 那一轮
# 写在 results_part1_if_flanv2/ 下，run 名是 part1_if_flanv2_lr5e-5_seed1 ——
# 和本次的 lr/seed 完全相同。两者共用一个根的话，MODE=train 会撞上
# `if [[ -d "${CKPT}" ]] then 跳过训练`，于是**静默跳过训练、直接去评测 Qwen3 的
# 旧 checkpoint**，日志里只有一行"跳过"。按模型分根之后 checkpoint / metrics /
# eval 产物三者一起分开，旧结果也完整留着可以对照。91 号同理。
# IF_SOURCE_TAG 让两条 source 也各自分根；flan 解析成 flanv2，所以这一行对
# FLAN 线的默认路径和加 IF_SOURCE 之前逐字相同，旧结果不会失联。
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_part1_${IF_SOURCE_TAG}_${MODEL_NAME}}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
export HF_DATASETS_CACHE="${DATASET_CACHE}"
METRICS_DIR="${METRICS_DIR:-${RESULTS_ROOT}/metrics}"
CKPT_DIR="${CKPT_DIR:-${RESULTS_ROOT}/checkpoints}"

# download_flan_v2.py 在登录节点写下的四份 jsonl 所在目录（IF_SOURCE=flan 用）。
FLAN_SAMPLE_DIR="${FLAN_SAMPLE_DIR:-${REPO_ROOT}/datasets/flan_v2}"
# Conifer 的原始 parquet 目录（IF_SOURCE=conifer 用）。prepare_conifer 接受单个
# parquet、一个含 parquet 的目录，或一个 save_to_disk 目录，所以指到 data/ 即可。
CONIFER_PATH="${CONIFER_PATH:-${REPO_ROOT}/datasets/Conifer/data}"

if [[ "${IF_SOURCE}" == "conifer" ]]; then
  IF_DATASET="${IF_DATASET:-${RESULTS_ROOT}/datasets/conifer_if_full}"
  # prepare_conifer 只写一个 save_to_disk 池，没有 --replay_out / --heldout_out。
  # 它的 replay 池是同一个脚本加 --mode sampled 再跑一次的产物，形态是
  # save_to_disk；而 Part 2 的 collect_cov / replay.py 读的是 jsonl
  # （--data_files），两边对不上。这条 source 现在只做 Stage 1 的训练 + 评测，
  # 所以默认不建 replay/heldout 池。接 Part 2 之前要先定：给 prepare_conifer 加
  # jsonl 输出，还是让 collect_cov 也能读 save_to_disk。别默默跳过这个决定。
  REPLAY_POOL="${REPLAY_POOL:-${RESULTS_ROOT}/datasets/conifer_if_replay}"
  HELDOUT_POOL="${HELDOUT_POOL:-}"
  BUILD_REPLAY_POOL="${BUILD_REPLAY_POOL:-0}"
elif [[ "${IF_SOURCE}" == "mix" ]]; then
  IF_DATASET="${IF_DATASET:-${RESULTS_ROOT}/datasets/if_mix}"
  # 两个半边各自落盘再合并，而不是一步到位：它们可以单独检查，而且换比例重跑
  # 只需要重跑合并那一步（两个半边已存在时会跳过重建）。
  MIX_CONIFER_POOL="${MIX_CONIFER_POOL:-${RESULTS_ROOT}/datasets/conifer_if_full}"
  MIX_FLAN_POOL="${MIX_FLAN_POOL:-${RESULTS_ROOT}/datasets/flan_v2_if_long}"
  # 同 conifer：Part 2 的 jsonl 对接还没做，所以不建 replay/heldout 池。
  REPLAY_POOL="${REPLAY_POOL:-${RESULTS_ROOT}/datasets/if_mix_replay}"
  HELDOUT_POOL="${HELDOUT_POOL:-}"
  BUILD_REPLAY_POOL="${BUILD_REPLAY_POOL:-0}"
else
  IF_DATASET="${IF_DATASET:-${RESULTS_ROOT}/datasets/flan_v2_if_100k}"
  # prepare_flan_v2 的默认命名就是 <out_dir>_replay.jsonl / <out_dir>_heldout.jsonl，
  # 这里显式写出来只是为了能在产物清单里报路径。
  REPLAY_POOL="${REPLAY_POOL:-${IF_DATASET}_replay.jsonl}"
  HELDOUT_POOL="${HELDOUT_POOL:-${IF_DATASET}_heldout.jsonl}"
  BUILD_REPLAY_POOL="${BUILD_REPLAY_POOL:-1}"
fi

# ---- 模式 ----
MODE="${MODE:-data}"
DRY_RUN="${DRY_RUN:-0}"
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
FORCE_EVAL="${FORCE_EVAL:-0}"
SEED="${SEED:-1}"

# ---- 数据池选项 ----
# 行权重，顺序固定为 zs_opt,zs_noopt,fs_opt,fs_noopt。理由见文件头。
# 接受冒号或逗号：qsub -v 自己就用逗号分隔变量，所以 -v 里必须写 40:40:10:10，
# 这里统一转成 prepare_flan_v2 要的逗号形式。
FLAN_WEIGHTS="${FLAN_WEIGHTS:-40,40,10,10}"
FLAN_WEIGHTS="${FLAN_WEIGHTS//:/,}"
FLAN_TARGET_ROWS="${FLAN_TARGET_ROWS:-100000}"
# 答案长度重平衡，默认空 = 关闭，池子和这个旋钮存在之前逐行一致。
# 为什么会需要它：FLAN 的 targets 是分类标签和短答案，100k 池实测答案 p50 = 6 词、
# 35% 的行只有 1-2 词。拿它训 1 个 epoch 会把生成长度压崩（Qwen2.5-Math-1.5B 上
# 回答中位数从 base 的 616 词掉到 32 词），于是 IFEval 里所有"要求模型多产出"的
# 约束成批判死（title -48.6、number_highlighted_sections -41.7、repeat_prompt
# -41.5、postscript -38.5），而同一次训练里"只限制输出"的约束是大涨的
# （constrained_response +60、no_comma +36.4、forbidden_words +32.7）——能力学到了，
# 可花的输出预算没了。冒号写法同 FLAN_WEIGHTS，为了绕开 qsub -v 的逗号分隔：
#   qsub -v MODE=data,FLAN_ANSWER_BUCKETS=2:15:50,FLAN_ANSWER_WEIGHTS=10:25:35:30 ...
# 注意它只能重排，造不出 dump 里没有的行：50+ 词的桶只占约 8%，所以高占比只在
# 前若干行成立，prepare 会打印每一路的"配比可维持行数"。
FLAN_ANSWER_BUCKETS="${FLAN_ANSWER_BUCKETS:-}"
FLAN_ANSWER_BUCKETS="${FLAN_ANSWER_BUCKETS//:/,}"
FLAN_ANSWER_WEIGHTS="${FLAN_ANSWER_WEIGHTS:-}"
FLAN_ANSWER_WEIGHTS="${FLAN_ANSWER_WEIGHTS//:/,}"
# Part 2 的 IF protection 池 + C 的语料。replay.py 和 collect_cov 读同一个文件，
# 这是 71/83 号已经在强制的约束（两边必须同池，否则 OneReplay vs EWC 被"谁拿到
# 哪批数据"混淆）。
FLAN_REPLAY_ROWS="${FLAN_REPLAY_ROWS:-20000}"
# nested = replay 池是训练池打乱后的前缀，也就是通常定义的 Experience Replay：
# 复习 Stage 1 训过的行。disjoint 会让 replay 臂在 Stage 2 拿从没见过的 IF 样本
# **继续学**，而 OneReplay 只拿到一个惩罚矩阵、没有任何新梯度信号，等于悄悄给
# replay 基线一个对方结构上不可能有的优势。所以默认 nested。
FLAN_REPLAY_MODE="${FLAN_REPLAY_MODE:-nested}"
# probe.py 的 flan_heldout 曲线用的行，**永远**与训练池和 replay 池互斥。
# 要互斥的是测量，不是复习 —— flan_inpool 与 flan_heldout 的间隙才能区分
# "能力还在" 和 "只是背下了那些行"。
FLAN_HELDOUT_ROWS="${FLAN_HELDOUT_ROWS:-2000}"
# 0（默认）保留跨 remix 重复的 (inputs, targets)。opt/noopt 对无答案选项的任务
# 渲染完全相同，等权混合四种模板本身就是在给这些任务加权，这是 flan2021_submix
# 的固有行为；而且所有碰撞都判给 zs_noopt，去重会把那一路剩成纯多选题池。
# 实测重复率约 0.24%，prepare 会把数量报出来。
FLAN_DEDUP_ACROSS_REMIXES="${FLAN_DEDUP_ACROSS_REMIXES:-0}"

# ---- Conifer 池选项（只在 IF_SOURCE=conifer 时读）----
# full = 保留每个 Easy-to-Hard turn，这是 Stage 1 的获取池口径。实测扁平化后
# 38907 行（Easy-to-Hard 35603 + Process Feedback 3304），也就是说 Conifer 全量
# 就这么多，不像 FLAN 可以靠多下载变大 —— 目标行数不是这条线的可调项。
# sampled 是 replay 池的口径，每个对话只留一个 turn。
CONIFER_MODE="${CONIFER_MODE:-full}"
# 1 只留指令带 IFEval/IFBench 可程序化验证约束（长度、大小写、标点、列表结构、
# placeholder）的 turn，约 15.6%：拿 ~35.6k 行换 ~5.5k 行更贴评测口径的数据。
# 这条 source 是来补「产出结构」的，5.5k 行跑 1 epoch 大概不够，所以默认 0。
CONIFER_FORMAT_ONLY="${CONIFER_FORMAT_ONLY:-0}"
# 每个 Easy-to-Hard 对话最多留几个 turn，0 = 不限。阶梯是同一个问题逐级加约束，
# 不限就会让同一个种子问题的多个变体都进池；留的时候从最难那端开始。
CONIFER_MAX_TURNS="${CONIFER_MAX_TURNS:-0}"
# 1 把 Process Feedback 子集也加进来，每个对话一行，取被批评后修正过的那个答案。
CONIFER_INCLUDE_PF="${CONIFER_INCLUDE_PF:-1}"
# 1（默认）丢掉开头就拒答的行。它们教的正好是这个阶段要建立的能力的反面，而且
# 不是均匀分布的：拒答集中在每个阶梯的最后一级（4.61% vs 别处 2.23%），因为阶梯
# 会一直加码到生成器不肯配合。留着会让 sampled/hardest 选中拒答而不是难度。
CONIFER_DROP_REFUSALS="${CONIFER_DROP_REFUSALS:-1}"

# ---- 混合池选项（只在 IF_SOURCE=mix 时读）----
# 0 = Conifer 全取（约 38.9k，它没有更多了）。
MIX_CONIFER_ROWS="${MIX_CONIFER_ROWS:-0}"
# FLAN 那一半的行数。默认 20000 是让 Conifer 占约 2/3：模型输出长度紧跟池子的
# 答案长度（FLAN 6 词→输出 32 词，Conifer 144 词→输出 189 词），所以短答案占多数
# 会把产出型约束重新压回去。方向上加容易减难，先保守，看结果再往上加。
MIX_FLAN_ROWS="${MIX_FLAN_ROWS:-20000}"
# FLAN 那一半只取答案 >= 这个词数的行：FLAN 池 35% 的行只有 1-2 词，正是它们压崩
# 了长度。实现走 prepare_flan_v2 的长度重平衡（短桶权重 0 = 永不取）。
# 注意容量上限：原始 150k 采样池里 >=15 词约 50.8k 行、>=50 词只有约 12.2k 行，
# 所以 MIX_FLAN_ROWS 和这个门槛要一起看，要不到会直接报错而不是静默少取。
MIX_FLAN_MIN_WORDS="${MIX_FLAN_MIN_WORDS:-15}"

# ---- 训练超参（三条 Stage 1 线统一，见文件头「训练配方」）----
#
# BATCH=8 / ACCUM=64：一次更新 64 行，accumulation_steps = ACCUM // BATCH = 8。
# **注意 ACCUM 是"行/更新"而不是微批个数**，所以有效 batch 是 64 而不是 8x64。
# BATCH 必须整除 ACCUM，否则"一次更新 64 行"不成立。
# 激活上界 8 x 2048 = 16384 token/micro-batch。本池 80% 是很短的 zero-shot 行
# （P50 约 100-117 token），动态补齐之后多数 micro-batch 远低于这个上界；
# 碰到长 few-shot 的那一拍会顶到 2048。MODE=smoke 看一眼 peak memory。
EPOCHS="${EPOCHS:-1}"
LR="${LR:-5e-5}"
# cosine + warmup 0.1，与 91/93 号统一。train.py 在加 --lr_scheduler 之前是裸
# Adam、恒定 LR、无 warmup，全参微调在 5e-5 下第一步就可能出 loss 尖峰。
# schedule 按**优化器更新**推进，horizon = epochs（或 max_steps，取更小者）换算。
# 训练开头 train.py 打的那行 `lr schedule: ...` 要和文件头算的更新数对得上。
LR_SCHEDULER="${LR_SCHEDULER:-cosine}"
WARMUP_RATIO="${WARMUP_RATIO:-0.1}"
# 4 而不是 8 是 Qwen3-4B-Base 定的：无梯度检查点、纯 bf16 权重 + Adam（state 跟随
# param dtype）下每参数 8 字节，4.0B 的静态开销就是 32 GB，8x2048 的峰值约 162 GB、
# 超 140 GB 的卡，4 约 97 GB。完整拆账见 91 号同处。**ACCUM 不跟着改**，所以
# accumulation_steps 从 8 变 16、有效 batch 仍是 64，梯度在数学上等价。
#
# 三条 source 用同一个值，训练预算才可比。但它们的**实际**序列长度差很远，这条
# 值得知道：Conifer 的截断表说全 38.9k 行在 1024 预算下就零截断（答案 token
# P50=183 / P90=310 / max=690），所以单看 conifer 线，BATCH=8 的实际激活只有约
# 8k token、其实装得下。mix 和 flan 线掺了 FLAN 的 few-shot prompt，长度分布没实
# 测过，而 padding 是按 batch 内最长算的——只要有少数行接近 2048，那几个 batch
# 就会 OOM，而且是在训练跑到一半时才炸。为让一条 source 快一倍去冒另两条的风险
# 不值得，所以统一 4。哪天量过 flan/mix 的 full_length 分布，再单独放开。
BATCH="${BATCH:-4}"
ACCUM="${ACCUM:-64}"
# 两条 source 用同一个 2048，训练预算才可比。但**截断的后果方向是相反的**，这
# 一条必须知道：tokenizer_to_ids 保留序列**末尾**。FLAN 的问题在 prompt 末尾，
# 截断只是退化成更少 shot 的版本，问题还在；Conifer 把约束写在 user turn 的
# **开头**，截断会把约束本身切掉，训出来就是「对一个没有约束的问题给出看起来
# 受约束的答案」，而且完全静默。所以 IF_SOURCE=conifer 跑完 MODE=data 一定要看
# prepare_conifer 的截断表再回来定这个值。
MAXLEN="${MAXLEN:-2048}"
VAL_FRAC="${VAL_FRAC:-0.01}"
MAXVAL="${MAXVAL:-500}"
# 全量微调时只决定正则覆盖哪些层；本线没有正则，保持与 91/93 号一致便于对照。
TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj,lm_head}"

# ---- system 消息（换模型后本线必须传，理由见文件头第 1 个坑）----
# 不传的话 Qwen2.5-Math 的模板会给每一条 FLAN 训练行和每一条 IF 评测 prompt 补上
# "Please reason step by step, and put your final answer within \boxed{}."。
# 这里用 Qwen2.5-Instruct 的标准助手消息把它顶掉，train.py 和 evaluate.py 传同
# 一个值。改它等于换了整条线的 prompt 分布，训练和评测必须一起重跑。
#
# **Stage 2 的 C/F 采集（95 号）和 Stage 3 的续训也要传同一个值**，否则 C 看到的
# 文本分布和模型训练时的不是一回事。collect_cov / collect_fisher 自己就有
# --system_prompt 参数。
#
# 刻意**不**用 Qwen2.5-Instruct 官方那条（"You are Qwen, created by Alibaba
# Cloud. ..."）：它含两个逗号，而 qsub -v 就是用逗号分隔变量的，想在提交时覆盖
# 这个值会被 PBS 切成几个变量名（同 FLAN_WEIGHTS 那个坑）。这条短的没有逗号，
# 覆盖安全，而且对 IF 任务来说更中性——它不声明模型身份，只声明角色。
SYSTEM_PROMPT="${SYSTEM_PROMPT:-You are a helpful assistant.}"

# ---- LR 搜索 / 冒烟 ----
# LR 已由三条线统一的配方给定 5e-5，lr_sweep 不再是必经步骤，这一档留着备用。
LR_GRID="${LR_GRID:-2e-5 5e-5 1e-4 2e-4}"
# **数的是 micro-batch，不是优化器步**。更新次数 = SWEEP_MAX_STEPS / (ACCUM/BATCH)
# = SWEEP_MAX_STEPS / 16。忘了这个换算就会严重高估 sweep 的说服力。
SWEEP_MAX_STEPS="${SWEEP_MAX_STEPS:-1600}"
SMOKE_STEPS="${SMOKE_STEPS:-20}"
LOG_EVERY="${LOG_EVERY:-500}"
SWEEP_LOG_EVERY="${SWEEP_LOG_EVERY:-50}"
MAX_TRAIN_SAMPLES="${MAX_TRAIN_SAMPLES:-0}"

# ---- 评测 ----
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"
# 空 = 用 ifbench 包自带的 IFBench_test.jsonl（300 条）。
IFBENCH_INPUT="${IFBENCH_INPUT:-}"
# 1024 而不是 2048：Qwen2.5-Math-1.5B 的上下文硬上限是 4096，见文件头「评测预算」。
# **91/96/100 号的 IF 侧必须同值**，否则四张表里的 IFBench 不可比。
IFBENCH_MAX_NEW_TOKENS="${IFBENCH_MAX_NEW_TOKENS:-1024}"
# FollowBench：820 行，全 vendored，零外部依赖。空 FB_DATA = 用 vendored 的
# third_party/followbench/data，空 FB_CATEGORIES = 六类全跑。
FB_DATA="${FB_DATA:-}"
FB_CATEGORIES="${FB_CATEGORIES:-}"
# 1024：example 类 prompt P90=2516，配 2048 就是 4564，越过 4096 窗口。
FB_MAX_NEW_TOKENS="${FB_MAX_NEW_TOKENS:-1024}"
# 不回落到 EVAL_BATCH：example 类把 few-shot 示例内联在 instruction 里，
# prompt P90=2516 / max=5019 token，远长于 IFEval/IFBench，同一个 batch 值需要的
# KV 不是一个量级。OOM 就降到 8，或者 FB_CATEGORIES=example 单独跑。
FB_BATCH="${FB_BATCH:-16}"
# 冒烟用。按**组**取（每类前 N 个 example_id），绝不按行 —— CSL 和 rule 侧的分母
# 都假设一组完整的 level 1..5。注意全局 --limit 对 followbench 不生效（metric 只
# 读 followbench_group_limit，已核对代码），所以截它只能用这个。
FB_GROUP_LIMIT="${FB_GROUP_LIMIT:-0}"
# 三个独立开关而不是一个逗号列表：qsub -v 用逗号分隔变量（见文件头）。
# 三个默认全开 —— IFBench 从 09-17 起进报告口径（此前默认 0），这样本脚本、91 号
# 交叉侧、96/100 号报的是同一套 IF 指标。它的依赖要在登录节点装，缺了会被
# ifbench_ready 探到并跳过（见 MODE=eval 那一段），不会挂掉整个作业。
DO_IFEVAL="${DO_IFEVAL:-1}"
DO_IFBENCH="${DO_IFBENCH:-1}"
DO_FOLLOWBENCH="${DO_FOLLOWBENCH:-1}"
EVAL_LIMIT="${EVAL_LIMIT:-0}"
EVAL_BATCH="${EVAL_BATCH:-32}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-1024}"
# Qwen2.5-Math 的 eos_token 是 <|endoftext|>，chat template 却以 <|im_end|> 收尾。
# 不开这个，模型吐出 <|im_end|> 后 generate 不停、续写下一轮对话，
# skip_special_tokens 再把那段拼到答案后面，IFEval 的约束检查和 FollowBench 的
# 判分都会读到多出来的那段。evaluate.py 的默认值是 0，必须显式开。
# 开关它会移动所有生成式分数，所以**一张表里的所有 arm 必须同值重评**。
STOP_ON_IM_END="${STOP_ON_IM_END:-1}"

# =============================================================================
# ---- 交叉评测：Model-IF 的数学能力（默认关）----
#
# 回答"IF 和 math 是不是正相关"的一半，另一半是 91 号的 DO_CROSS_IF。理由和 2x2 表的
# 读法见文件头「交叉评测」一节。**只评 trained**：base 的 math 分在 91 号已经有了。
#
# 下面每一个值都**逐字照抄 91 号**。这不是复制粘贴的懒惰，而是可比性的前提：交叉侧要
# 报的是"Model-IF 的 math 分减 base 的 math 分"，而后者来自 91 号的结果树。任何一个
# 预算或 prompt 不同，那个差里就混进了口径差。
# =============================================================================
DO_CROSS_MATH="${DO_CROSS_MATH:-0}"
GSM8K_DATA="${GSM8K_DATA:-${REPO_ROOT}/datasets/math/gsm8k_test.jsonl}"
MATH500_DATA="${MATH500_DATA:-${REPO_ROOT}/datasets/math/math500_test.jsonl}"
AMC_DATA="${AMC_DATA:-${REPO_ROOT}/datasets/math/amc_test.jsonl}"
# math-ai/minervamath 的 test 切分（272 题 OCW 物理/天文）。**这个文件是新增的**，
# 计算节点无外网，要先在登录节点拉：
#   python -m onereplay.scripts.download_math_data --out_dir ${REPO_ROOT}/datasets/math \
#     --with_math_train 0 --with_math500 0 --with_amc 0 --with_aime 0 --with_gsm8k 0 \
#     --with_minervamath 1
MINERVA_DATA="${MINERVA_DATA:-${REPO_ROOT}/datasets/math/minervamath_test.jsonl}"

# math 侧的 system 消息：**不是本线主场那条中性助手消息**。math500 / amc / minervamath
# 的答案提取靠 \boxed{}，而 Qwen3 的模板不注入任何 system，所以这条指令必须显式传，
# 否则 Model-IF 会因为没写 \boxed{} 而被读成"不会做数学"。preset 逻辑与 91 / 96 / 99
# 号逐字相同：Qwen2.5-Math 留空（它的模板自己注入这条指令），其他模型补齐。
SYSTEM_PROMPT_PRESET="${SYSTEM_PROMPT_PRESET:-auto}"
if [[ -z "${MATH_SYSTEM_PROMPT:-}" ]]; then
  case "${SYSTEM_PROMPT_PRESET}" in
    none) ;;
    math) MATH_SYSTEM_PROMPT="Please reason step by step, and put your final answer within \\boxed{}." ;;
    auto)
      if [[ "${MODEL_NAME}" != *Math* ]]; then
        MATH_SYSTEM_PROMPT="Please reason step by step, and put your final answer within \\boxed{}."
      fi
      ;;
    *) echo "SYSTEM_PROMPT_PRESET 只能是 auto / math / none，得到 '${SYSTEM_PROMPT_PRESET}'" >&2; exit 2 ;;
  esac
fi
MATH_SYSTEM_PROMPT="${MATH_SYSTEM_PROMPT:-}"

# 标准 math 侧：贪心 cap=2048 / batch=128，91 号的值。
MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS:-2048}"
MATH_BATCH="${MATH_BATCH:-128}"
CROSS_MATH_OUT_DIR="${CROSS_MATH_OUT_DIR:-${RESULTS_ROOT}/eval_cross_math_cap${MATH_MAX_NEW_TOKENS}}"

# 难 math 侧：AMC + Minerva，采样 average@k。为什么这两个集合必须换配置（低准确率下
# greedy@1 的抖动和真实差距同量级；采样是 avg@k 的前提；4096 是因为推理链更长）
# 完整写在 91 号文件头的「难题集」一节，改这几个值要两个脚本一起改。
DO_HARD_MATH="${DO_HARD_MATH:-1}"
HARD_MATH_MAX_NEW_TOKENS="${HARD_MATH_MAX_NEW_TOKENS:-4096}"
HARD_MATH_TEMPERATURE="${HARD_MATH_TEMPERATURE:-1.0}"
HARD_MATH_SAMPLES="${HARD_MATH_SAMPLES:-4}"
# 64 而不是 128：cap 翻倍、每题解 4 遍，KV 是标准侧的 2 倍（Qwen3-4B-Base 每 token
# 144 KiB，prompt+4096 约 0.59 GiB/序列 -> 64 行约 38 GiB）。
HARD_MATH_BATCH="${HARD_MATH_BATCH:-64}"
MINERVA_REL_TOL="${MINERVA_REL_TOL:-0.01}"
HARD_MATH_OUT_DIR="${HARD_MATH_OUT_DIR:-${RESULTS_ROOT}/eval_cross_math_hard_t${HARD_MATH_TEMPERATURE}_avg${HARD_MATH_SAMPLES}_cap${HARD_MATH_MAX_NEW_TOKENS}}"
# 数学分数必须配着 hit-cap 读，理由见 91 号文件头最后一节。
DIAG_LEN="${DIAG_LEN:-1}"

# run 名保持 part1_if_<source>_lr<LR>_seed<SEED> 这个形状：95 号解析 Stage 1
# checkpoint 时靠它拼名和 glob（part1_if_flanv2_lr*_seed${SEED}）。把 MODEL_NAME
# 塞进 run 名会让那两条同时失效，所以模型的区分放在 RESULTS_ROOT 上。
# source 必须进 run 名而不是只靠 RESULTS_ROOT 分根：两条 source 的 RESULTS_ROOT
# 已经不同，不会互相覆盖，但如果 Conifer 的 checkpoint 和评测目录也叫 flanv2，
# 读结果时会把两条线认错。IF_SOURCE=flan 时 tag 就是 flanv2，所以 FLAN 线的 run
# 名和加 IF_SOURCE 之前逐字相同，95 号的 glob 照旧能命中。
RUN="part1_if_${IF_SOURCE_TAG}_lr${LR}_seed${SEED}"
CKPT="${CKPT_DIR}/${RUN}"
RUNS_TO_EVAL="${RUNS_TO_EVAL:-base trained}"

mkdir -p "${RESULTS_ROOT}/datasets" "${METRICS_DIR}" "${CKPT_DIR}" \
  "${DATASET_CACHE}" "${RESULTS_ROOT}/map_cache"

[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }

echo "========================================================================"
echo "Stage 1 / IF 线: Base --FLAN-v2--> Model-IF   (full finetune, vanilla)"
echo "  MODE           : ${MODE}"
echo "  model          : ${MODEL_DIR}/${MODEL_NAME}"
echo "  results root   : ${RESULTS_ROOT}"
if [[ "${IF_SOURCE}" == "conifer" ]]; then
  echo "  Conifer 原始   : ${CONIFER_PATH}"
  echo "  数据池         : ${IF_DATASET}   (mode=${CONIFER_MODE}, 全量约 38.9k 行)"
  echo "  replay 池      : ${REPLAY_POOL}   (BUILD_REPLAY_POOL=${BUILD_REPLAY_POOL})"
elif [[ "${IF_SOURCE}" == "mix" ]]; then
  echo "  数据池         : ${IF_DATASET}"
  echo "    Conifer 半边 : ${MIX_CONIFER_POOL}   (取 ${MIX_CONIFER_ROWS} 行, 0=全取)"
  echo "    FLAN 半边    : ${MIX_FLAN_POOL}   (取 ${MIX_FLAN_ROWS} 行, 答案 >= ${MIX_FLAN_MIN_WORDS} 词)"
else
  echo "  FLAN 取样目录  : ${FLAN_SAMPLE_DIR}"
  echo "  数据池         : ${IF_DATASET}"
  echo "                   ${FLAN_TARGET_ROWS} 行, weights=${FLAN_WEIGHTS} (zs_opt,zs_noopt,fs_opt,fs_noopt)"
  echo "  replay/C 池    : ${REPLAY_POOL}  (${FLAN_REPLAY_ROWS} 行, ${FLAN_REPLAY_MODE})"
  echo "  heldout 池     : ${HELDOUT_POOL}  (${FLAN_HELDOUT_ROWS} 行, 与上两者互斥)"
fi
echo "  超参           : epochs=${EPOCHS} lr=${LR} ${LR_SCHEDULER} warmup=${WARMUP_RATIO}"
echo "                   batch=${BATCH} accum=${ACCUM} maxlen=${MAXLEN}"
echo "  system 消息    : ${SYSTEM_PROMPT}"
echo "                   (Qwen3 的模板不注入 system，所以空 = 真的没有 system turn；"
echo "                    95 号采集必须传一样的值，见文件头第 1 条)"
if [[ "${MODE}" == "lr_sweep" ]]; then
  echo "  sweep          : grid=[${LR_GRID}]  每档 ${SWEEP_MAX_STEPS} micro-batch = $(( SWEEP_MAX_STEPS / (ACCUM / BATCH) )) 次更新 = $(( SWEEP_MAX_STEPS * BATCH )) 行"
fi
echo "  评测           : ifeval=${DO_IFEVAL} ifbench=${DO_IFBENCH} followbench=${DO_FOLLOWBENCH}   (对照 base)"
echo "                   max_new_tokens=${MAX_NEW_TOKENS}/${IFBENCH_MAX_NEW_TOKENS}/${FB_MAX_NEW_TOKENS} stop_on_im_end=${STOP_ON_IM_END}"
echo "  交叉 math      : do=${DO_CROSS_MATH}   只评 trained（base 的 math 分在 91 号）"
if [[ "${DO_CROSS_MATH}" == "1" ]]; then
echo "                   标准: gsm8k+math500 greedy cap=${MATH_MAX_NEW_TOKENS} batch=${MATH_BATCH}"
echo "                         -> ${CROSS_MATH_OUT_DIR}"
echo "                   难  : amc+minervamath (do=${DO_HARD_MATH}) sample T=${HARD_MATH_TEMPERATURE} avg@${HARD_MATH_SAMPLES} cap=${HARD_MATH_MAX_NEW_TOKENS} batch=${HARD_MATH_BATCH}"
echo "                         -> ${HARD_MATH_OUT_DIR}"
echo "                   system: ${MATH_SYSTEM_PROMPT:-<空>}   (91 号的值，含 \\boxed{} 指令)"
fi
echo "  checkpoint     : ${CKPT}"
echo "  同批 Stage 1   : 91_s1_train_math.pbs / 93_s1_train_cs.pbs  (同 base 同配方)"
echo "========================================================================"
if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只打印配置，不跑。"
  exit 0
fi

# =============================================================================
# 共用训练封装：vanilla 全量微调，与 91/93 号逐字对齐（只有数据和 system 不同）
#   --full_finetune 1
#   --replay_lambda 0 --measure_replay_when_lambda_zero 0   -> 不加载任何 penalty
# =============================================================================
train_one () {
  local run="$1" epochs="$2" lr="$3" save_path="$4" max_steps="${5:-0}" do_save="${6:-1}"
  local log_every="${7:-${LOG_EVERY}}"

  mkdir -p "${RESULTS_ROOT}/map_cache/${run}"
  echo "==== train ${run} (lr=${lr} ${LR_SCHEDULER} warmup=${WARMUP_RATIO} maxlen=${MAXLEN} batch=${BATCH} max_steps=${max_steps}) ===="
  python -m onereplay.scripts.train --paradigm sft --full_finetune 1 \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
    --system_prompt "${SYSTEM_PROMPT}" \
    --dataset_path "${IF_DATASET}" \
    --epochs "${epochs}" --lr "${lr}" \
    --lr_scheduler "${LR_SCHEDULER}" --warmup_ratio "${WARMUP_RATIO}" \
    --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
    --max_len "${MAXLEN}" \
    --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" \
    --eval_batch_size "${BATCH}" \
    --max_train_samples "${MAX_TRAIN_SAMPLES}" \
    --target_modules "${TARGET_MODULES}" \
    --map_cache_dir "${RESULTS_ROOT}/map_cache/${run}" \
    --replay_lambda 0 --measure_replay_when_lambda_zero 0 \
    --max_steps "${max_steps}" --log_every "${log_every}" \
    --save "${do_save}" --save_path "${save_path}" \
    --metrics_path "${METRICS_DIR}/${run}.jsonl"
}

# =============================================================================
# MODE=data：取样好的 jsonl -> {instruction, input, output} 的 save_to_disk
#            顺带切出 replay/C 池和 heldout 探针池
#
# 下载不在这里：计算节点无外网，download_flan_v2.py 必须在登录节点先跑完。
#
# 长度报告会打印每个候选 MAXLEN 的截断率、per-remix 的长度分布、以及
# **答案 token**（唯一带 loss 的那部分）和「对齐 Conifer 总 token 需要几个 epoch」。
# 先读这张表再定 EPOCHS，不要直接信文件头里那几个估算值。
# =============================================================================
if [[ "${MODE}" == "data" ]]; then
  if [[ "${IF_SOURCE}" == "conifer" ]]; then
    [[ -e "${CONIFER_PATH}" ]] || { echo "缺 Conifer 数据: ${CONIFER_PATH}"; exit 1; }

    echo "==== data: Conifer -> ${IF_DATASET} ===="
    python -m onereplay.scripts.prepare_conifer \
      --conifer_path "${CONIFER_PATH}" \
      --out_dir "${IF_DATASET}" \
      --mode "${CONIFER_MODE}" \
      --format_constraints_only "${CONIFER_FORMAT_ONLY}" \
      --max_turns_per_conv "${CONIFER_MAX_TURNS}" \
      --include_process_feedback "${CONIFER_INCLUDE_PF}" \
      --drop_refusals "${CONIFER_DROP_REFUSALS}" \
      --seed "${SEED}" \
      --max_len "${MAXLEN}" \
      --tokenizer_path "${MODEL_DIR}/${MODEL_NAME}"

    if [[ "${BUILD_REPLAY_POOL}" == "1" ]]; then
      echo ""
      echo "==== data: Conifer replay 池 (mode=sampled) -> ${REPLAY_POOL} ===="
      python -m onereplay.scripts.prepare_conifer \
        --conifer_path "${CONIFER_PATH}" \
        --out_dir "${REPLAY_POOL}" \
        --mode sampled \
        --format_constraints_only "${CONIFER_FORMAT_ONLY}" \
        --include_process_feedback "${CONIFER_INCLUDE_PF}" \
        --drop_refusals "${CONIFER_DROP_REFUSALS}" \
        --seed "${SEED}" \
        --max_len "${MAXLEN}" \
        --tokenizer_path "${MODEL_DIR}/${MODEL_NAME}"
    fi

    echo ""
    echo "数据准备完成。**先看截断表**：Conifer 的约束写在 user turn 开头，而"
    echo "tokenizer_to_ids 保留序列末尾，截断会静默切掉约束本身，训成「对没有约束"
    echo "的问题给出看起来受约束的答案」。MAXLEN=${MAXLEN} 的截断率不可接受就调大"
    echo "再重跑 data。然后 MODE=smoke。"
    exit 0
  fi

  MISSING=0
  for _label in zs_opt zs_noopt fs_opt fs_noopt; do
    if [[ ! -f "${FLAN_SAMPLE_DIR}/flan_v2_${_label}.jsonl" ]]; then
      echo "缺 ${FLAN_SAMPLE_DIR}/flan_v2_${_label}.jsonl"
      MISSING=1
    fi
  done
  if [[ "${MISSING}" == "1" ]]; then
    echo ""
    echo "取样文件不全。计算节点无外网，要先在**登录节点**跑（约 10 min，600MB 网络）:"
    echo "  python -m onereplay.scripts.download_flan_v2 \\"
    echo "    --out_dir ${FLAN_SAMPLE_DIR}"
    echo ""
    echo "它流式读 SirNeural/flan_v2 的 flan_* 四个文件，原始 gz 不落盘。"
    exit 1
  fi

  if [[ "${IF_SOURCE}" == "mix" ]]; then
    [[ -e "${CONIFER_PATH}" ]] || { echo "缺 Conifer 数据: ${CONIFER_PATH}"; exit 1; }

    # 两个半边分别落盘，已存在就跳过：换混合比例时只要删掉合并产物重跑，
    # 不用把两个半边也重建一遍。
    if [[ -d "${MIX_CONIFER_POOL}" ]]; then
      echo "==== data: Conifer 半边已存在，跳过 -> ${MIX_CONIFER_POOL} ===="
    else
      echo "==== data: Conifer 半边 -> ${MIX_CONIFER_POOL} ===="
      python -m onereplay.scripts.prepare_conifer \
        --conifer_path "${CONIFER_PATH}" \
        --out_dir "${MIX_CONIFER_POOL}" \
        --mode "${CONIFER_MODE}" \
        --format_constraints_only "${CONIFER_FORMAT_ONLY}" \
        --max_turns_per_conv "${CONIFER_MAX_TURNS}" \
        --include_process_feedback "${CONIFER_INCLUDE_PF}" \
        --drop_refusals "${CONIFER_DROP_REFUSALS}" \
        --seed "${SEED}" \
        --max_len "${MAXLEN}" \
        --tokenizer_path "${MODEL_DIR}/${MODEL_NAME}"
    fi

    if [[ -d "${MIX_FLAN_POOL}" ]]; then
      echo ""
      echo "==== data: FLAN 长答案半边已存在，跳过 -> ${MIX_FLAN_POOL} ===="
      echo "     改 MIX_FLAN_ROWS / MIX_FLAN_MIN_WORDS 要先删掉它，否则用的是旧池"
    else
      echo ""
      echo "==== data: FLAN 长答案半边（答案 >= ${MIX_FLAN_MIN_WORDS} 词）-> ${MIX_FLAN_POOL} ===="
      # 短桶权重 0 = 永不取，所以取到的行答案都 >= MIX_FLAN_MIN_WORDS 词。
      # replay/heldout 都给 0：混合线的 Part 2 还没对接，现在切了也没人读。
      python -m onereplay.scripts.prepare_flan_v2 \
        --sample_dir "${FLAN_SAMPLE_DIR}" \
        --out_dir "${MIX_FLAN_POOL}" \
        --target_rows "${MIX_FLAN_ROWS}" \
        --weights "${FLAN_WEIGHTS}" \
        --answer_word_buckets "${MIX_FLAN_MIN_WORDS}" \
        --answer_bucket_weights "0,100" \
        --replay_rows 0 \
        --heldout_rows 0 \
        --dedup_across_remixes "${FLAN_DEDUP_ACROSS_REMIXES}" \
        --seed "${SEED}" \
        --max_len "${MAXLEN}" \
        --tokenizer_path "${MODEL_DIR}/${MODEL_NAME}"
    fi

    echo ""
    echo "==== data: 合并两个半边 -> ${IF_DATASET} ===="
    python -m onereplay.scripts.mix_if_pools \
      --pools "${MIX_CONIFER_POOL},${MIX_FLAN_POOL}" \
      --rows "${MIX_CONIFER_ROWS},${MIX_FLAN_ROWS}" \
      --out_dir "${IF_DATASET}" \
      --seed "${SEED}" \
      --tokenizer_path "${MODEL_DIR}/${MODEL_NAME}"

    echo ""
    echo "数据准备完成。看两件事："
    echo "  1) 「混合后答案词数 p50」—— 那是对训练后输出长度的预测。两轮实测："
    echo "     FLAN 池 6 词 -> 输出 32 词；Conifer 池 144 词 -> 输出 189 词。"
    echo "  2) 截断表 —— Conifer 的约束写在 user turn 开头，截断保留末尾，是静默的。"
    echo "换比例：删掉 ${IF_DATASET}，改 MIX_FLAN_ROWS 重跑 data，两个半边会复用。"
    echo "然后 MODE=smoke。"
    exit 0
  fi

  echo "==== data: FLAN v2 取样 -> ${IF_DATASET} ===="
  REPLAY_ROWS_ARG="${FLAN_REPLAY_ROWS}"
  if [[ "${BUILD_REPLAY_POOL}" != "1" ]]; then
    echo "BUILD_REPLAY_POOL=0：不切 replay 池"
    REPLAY_ROWS_ARG=0
  fi
  python -m onereplay.scripts.prepare_flan_v2 \
    --sample_dir "${FLAN_SAMPLE_DIR}" \
    --out_dir "${IF_DATASET}" \
    --target_rows "${FLAN_TARGET_ROWS}" \
    --weights "${FLAN_WEIGHTS}" \
    --answer_word_buckets "${FLAN_ANSWER_BUCKETS}" \
    --answer_bucket_weights "${FLAN_ANSWER_WEIGHTS}" \
    --replay_rows "${REPLAY_ROWS_ARG}" \
    --replay_mode "${FLAN_REPLAY_MODE}" \
    --replay_out "${REPLAY_POOL}" \
    --heldout_rows "${FLAN_HELDOUT_ROWS}" \
    --heldout_out "${HELDOUT_POOL}" \
    --dedup_across_remixes "${FLAN_DEDUP_ACROSS_REMIXES}" \
    --seed "${SEED}" \
    --max_len "${MAXLEN}" \
    --tokenizer_path "${MODEL_DIR}/${MODEL_NAME}"

  echo ""
  echo "数据准备完成。**先看上面的输出再往下走**（prepare 的退出码是 0，不代表配额满了）："
  echo "  1) 有没有 \"!! 配额没满足\" —— 有就说明某一路取样不够，池子比 ${FLAN_TARGET_ROWS} 小"
  echo "  2) 截断率决定 MAXLEN 还能不能用 ${MAXLEN}"
  echo "  3) 「对齐总 token 需要几个 epoch」决定 EPOCHS（当前默认 ${EPOCHS}）"
  echo "  4) 答案 token 那一行说明按总 token 对齐并不等于按监督 token 对齐"
  echo "然后 MODE=smoke 冒烟。"
  exit 0
fi

if [[ "${MODE}" != "eval" ]]; then
  [[ -d "${IF_DATASET}" ]] || { echo "缺 IF 池: ${IF_DATASET}（先跑 MODE=data）"; exit 1; }
fi

# =============================================================================
# MODE=smoke：跑几十步、不保存。只回答「链路通不通」。
# 看三件事：trainable params ≈ 1.72e9、峰值显存有余量、loss 在动。
# 另外记下 tokens_per_sec —— 这是判断 BATCH 能不能从 4 提到 8 的唯一依据。
# =============================================================================
if [[ "${MODE}" == "smoke" ]]; then
  train_one "smoke_if_${IF_SOURCE_TAG}" 1 "${LR}" \
    "${CKPT_DIR}/smoke_if_${IF_SOURCE_TAG}" "${SMOKE_STEPS}" 0
  echo "冒烟完成。记下 peak memory 和 tokens_per_sec。"
  exit 0
fi

# =============================================================================
# MODE=lr_sweep：数据换了就要重选 LR（见上面 LR_GRID 的注释）。
#
# 【怎么读结果】末值最低 != 该选它。两件事要一起看：
#   1) val loss 的**边际收益**。LR 翻倍只换来千分之几时已经到膝点。
#   2) 训练 loss 的**轨迹**（stdout 里 SWEEP_LOG_EVERY 一行的 task_loss）。发散
#      表现为中途抬头、剧烈抖动或 nan，末值单看不出来。
#
# 本线还有一个 90 号没有的陷阱：FLAN 的答案只有约 30 token，val loss 的绝对值
# 因此和 Conifer 线**完全不可比**（分母不同）。只在本线内部横向比 LR。
# =============================================================================
if [[ "${MODE}" == "lr_sweep" ]]; then
  echo "grid=${LR_GRID}"
  echo "每档 ${SWEEP_MAX_STEPS} micro-batch = $(( SWEEP_MAX_STEPS / (ACCUM / BATCH) )) 次优化器更新 = $(( SWEEP_MAX_STEPS * BATCH )) 行"
  for lr in ${LR_GRID}; do
    train_one "sweep_if_${IF_SOURCE_TAG}_lr${lr}" 1 "${lr}" \
      "${CKPT_DIR}/sweep_if_${IF_SOURCE_TAG}_lr${lr}" \
      "${SWEEP_MAX_STEPS}" 0 "${SWEEP_LOG_EVERY}"
  done
  echo "==== LR sweep val loss（同步数下比较，${SWEEP_MAX_STEPS} 步）===="
  for lr in ${LR_GRID}; do
    f="${METRICS_DIR}/sweep_if_${IF_SOURCE_TAG}_lr${lr}.jsonl"
    if [[ -f "${f}" ]]; then
      echo "lr=${lr}: $(python - "${f}" <<'PY'
import json, sys
rows = [json.loads(line) for line in open(sys.argv[1]) if line.strip()]
values = [r.get("val_loss") for r in rows if r.get("val_loss") is not None]
print(values[-1] if values else "n/a")
PY
)"
    fi
  done
  echo
  echo "别只看这张表：回到上面每档的 task_loss 轨迹，确认没有中途抬头/抖动/nan。"
  echo "这些绝对值不能和 90 号的比 —— FLAN 的答案短得多，loss 的分母不是一个东西。"
  exit 0
fi

# =============================================================================
# MODE=train：正式训练 Model-IF-FLAN
# =============================================================================
if [[ "${MODE}" == "train" && "${DO_TRAIN}" == "1" ]]; then
  if [[ -d "${CKPT}" ]]; then
    echo "跳过训练：${CKPT} 已存在（删掉可重跑）"
  else
    train_one "${RUN}" "${EPOCHS}" "${LR}" "${CKPT}" 0 1
  fi
  echo "训练完成。checkpoint 是完整权重目录，可直接作为 Part 2 Stage 2 的起点："
  echo "  --model_dir ${CKPT_DIR} --model_name ${RUN}"
fi

# =============================================================================
# MODE=eval：base 与 Model-IF 各测 IFEval + IFBench + FollowBench
#
# 一次 evaluate 调用只加载模型一次，打开的指标共用。DO_IFEVAL / DO_IFBENCH /
# DO_FOLLOWBENCH 可以把它们拆到不同作业里（FollowBench 820 行占大头）。跳过检查
# 按**请求的那几个**指标算，所以拆开跑时第二批不会被第一批的产物挡掉。
#
# 全量 checkpoint 直接传 --adapter_path：runner 的 load_eval_model 先用
# is_lora_adapter_dir 判断，没有 adapter_config.json 就把该目录当完整模型加载。
# =============================================================================

# IFBench 的前置不是一个文件，是装好的 ifbench 包加四份 NLTK 语料，而它们缺席时的
# 失败发生在**打分阶段** —— 300 条已经解码完，GPU 白烧。所以解码前先探一次，探不过
# 就只把 ifbench 摘掉，其余指标照常评（与 70 / 81 号同一套探测）。
ifbench_ready () {
  python - <<'PY' >/dev/null 2>&1
from ifbench import instructions_registry
from onereplay.eval.metrics.ifbench import check_nltk_data

# 83 = 25 个 patch 过的经典 checker + 58 个新的；数目对不上说明装到了别的版本。
assert len(instructions_registry.INSTRUCTION_DICT) >= 83
check_nltk_data()
PY
}

ifbench_hint () {
  echo "跳过 IFBench：依赖没就绪。在**登录节点**补齐后重投（MODE=eval 即可，训练不用重跑）:"
  echo "  source ${VENV}/bin/activate"
  echo '  pip install "ifbench @ git+https://github.com/allenai/IFBench.git@1c40f0c10d9b5c5c2f10a175a28007ebb64f7f4d"'
  echo "  python -m nltk.downloader punkt punkt_tab stopwords averaged_perceptron_tagger_eng"
  echo "  当前 NLTK_DATA=${NLTK_DATA}（venv 里 nltk.downloader 默认就落这里）"
  echo "  详细说明见 onereplay/pbs/73_ifbench_eval.pbs 文件头"
}

if [[ "${MODE}" == "eval" || ( "${MODE}" == "train" && "${DO_EVAL}" == "1" ) ]]; then
  # 组装指标列表。IFEval 的输入随仓库自带，缺了就跳过它而不是整个作业退出；
  # IFBench 留空 input 表示用 wheel 内置测试集，FollowBench 的数据和判分器完全
  # vendored —— 这两个没有可检查的前置文件，装缺了会在 evaluate 里报错退出。
  METRICS=""
  if [[ "${DO_IFEVAL}" == "1" ]]; then
    if [[ -f "${IFEVAL_INPUT}" ]]; then
      METRICS="${METRICS},ifeval"
    else
      echo "跳过 IFEval：未找到 ${IFEVAL_INPUT}"
    fi
  fi
  if [[ "${DO_IFBENCH}" == "1" ]]; then
    if ifbench_ready; then
      METRICS="${METRICS},ifbench"
    else
      ifbench_hint
    fi
  fi
  if [[ "${DO_FOLLOWBENCH}" == "1" ]]; then
    METRICS="${METRICS},followbench"
  fi
  METRICS="${METRICS#,}"

  # 交叉 math 侧的两组指标。缺数据文件就跳过该指标，不中断作业。
  CROSS_METRICS=""
  CROSS_HARD_METRICS=""
  if [[ "${DO_CROSS_MATH}" == "1" ]]; then
    if [[ -f "${GSM8K_DATA}" ]]; then
      CROSS_METRICS="${CROSS_METRICS},gsm8k"
    else
      echo "跳过 GSM8K：未找到 ${GSM8K_DATA}"
    fi
    if [[ -f "${MATH500_DATA}" ]]; then
      CROSS_METRICS="${CROSS_METRICS},math500"
    else
      echo "跳过 MATH-500：未找到 ${MATH500_DATA}"
    fi
    if [[ "${DO_HARD_MATH}" == "1" ]]; then
      if [[ -f "${AMC_DATA}" ]]; then
        CROSS_HARD_METRICS="${CROSS_HARD_METRICS},amc"
      else
        echo "跳过 AMC：未找到 ${AMC_DATA}"
      fi
      if [[ -f "${MINERVA_DATA}" ]]; then
        CROSS_HARD_METRICS="${CROSS_HARD_METRICS},minervamath"
      else
        echo "跳过 Minerva Math：未找到 ${MINERVA_DATA}"
        echo "  它要先在**登录节点**拉一次（计算节点无外网）："
        echo "    python -m onereplay.scripts.download_math_data \\"
        echo "      --out_dir $(dirname "${MINERVA_DATA}") \\"
        echo "      --with_math_train 0 --with_math500 0 --with_amc 0 \\"
        echo "      --with_aime 0 --with_gsm8k 0 --with_minervamath 1"
      fi
    fi
  fi
  CROSS_METRICS="${CROSS_METRICS#,}"
  CROSS_HARD_METRICS="${CROSS_HARD_METRICS#,}"

  if [[ -z "${METRICS}${CROSS_METRICS}${CROSS_HARD_METRICS}" ]]; then
    echo "没有可用指标（DO_IFEVAL/DO_IFBENCH/DO_FOLLOWBENCH/DO_CROSS_MATH 都关了？），评测退出"
    exit 1
  fi

  if [[ "${FB_GROUP_LIMIT}" != "0" ]]; then
    echo "!! FB_GROUP_LIMIT=${FB_GROUP_LIMIT}：FollowBench 冒烟模式，产出的 summary.json"
    echo "   只覆盖每类前 ${FB_GROUP_LIMIT} 组，不是正式结果。"
  fi
  if [[ "${EVAL_LIMIT}" != "0" && "${METRICS}" == *followbench* ]]; then
    echo "!! EVAL_LIMIT=${EVAL_LIMIT} 截的是 ifeval/ifbench；FollowBench 不读全局 --limit，"
    echo "   要截它请用 FB_GROUP_LIMIT（按阶梯组，不能按行）。"
  fi

  # 一侧的指标全部已有 summary 才跳过；否则拆开跑时后一批会被前一批挡掉。
  side_pending () {
    local out_root="$1" name="$2" side_metrics="$3" m
    [[ "${FORCE_EVAL}" == "1" ]] && return 0
    for m in ${side_metrics//,/ }; do
      [[ -f "${out_root}/${m}/${name}/summary.json" ]] || return 0
    done
    return 1
  }

  run_eval () {
    local name="$1" ckpt="$2"
    [[ -n "${METRICS}" ]] || return 0
    local -a ckpt_arg=()
    if [[ -n "${ckpt}" ]]; then ckpt_arg=(--adapter_path "${ckpt}"); fi

    # 已有 summary 的指标逐个摘掉，只跑缺的那些。**不是**"全部齐了才跳过"：往一张已经
    # 跑完的表里补一个指标（IFBench 就是这么加进来的）是常态，而那时重跑 FollowBench 的
    # 820 行要 3-4h，纯属白烧。每个指标写自己的子目录，所以摘掉已完成的不影响任何结果。
    # 要重评已有的数就用 FORCE_EVAL=1。
    local -a todo=()
    local m
    for m in ${METRICS//,/ }; do
      if [[ "${FORCE_EVAL}" == "1" || ! -f "${RESULTS_ROOT}/${m}/${name}/summary.json" ]]; then
        todo+=("${m}")
      fi
    done
    if [[ ${#todo[@]} -eq 0 ]]; then
      echo "跳过评测 ${name}：${METRICS} 都已有 summary（FORCE_EVAL=1 强制重评）"
      return 0
    fi
    local run_metrics
    run_metrics="$(IFS=,; echo "${todo[*]}")"
    if [[ "${run_metrics}" != "${METRICS}" ]]; then
      echo "评测 ${name}：${METRICS} 里只有 ${run_metrics} 缺 summary，其余跳过（FORCE_EVAL=1 全部重评）"
    fi

    # 空值不传 flag，让 metric 用自己的默认（vendored 数据 / 六类全跑 / 包自带的 300 条）。
    local -a fb_data_arg=() fb_cats_arg=() ifbench_arg=()
    if [[ -n "${FB_DATA}" ]]; then fb_data_arg=(--followbench_data "${FB_DATA}"); fi
    if [[ -n "${FB_CATEGORIES}" ]]; then fb_cats_arg=(--followbench_categories "${FB_CATEGORIES}"); fi
    if [[ -n "${IFBENCH_INPUT}" ]]; then ifbench_arg=(--ifbench_input "${IFBENCH_INPUT}"); fi

    echo "==== eval ${name} (${run_metrics}) ===="
    python -m onereplay.scripts.evaluate \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
      "${ckpt_arg[@]}" --run_name "${name}" \
      --metrics "${run_metrics}" --out_dir "${RESULTS_ROOT}" --seed "${SEED}" \
      --system_prompt "${SYSTEM_PROMPT}" \
      --decode_stop_on_im_end "${STOP_ON_IM_END}" \
      --limit "${EVAL_LIMIT}" \
      --max_new_tokens "${MAX_NEW_TOKENS}" \
      --eval_batch_size "${EVAL_BATCH}" \
      --ifeval_input "${IFEVAL_INPUT}" \
      --ifbench_max_new_tokens "${IFBENCH_MAX_NEW_TOKENS}" \
      --followbench_max_new_tokens "${FB_MAX_NEW_TOKENS}" \
      --followbench_batch_size "${FB_BATCH}" \
      --followbench_group_limit "${FB_GROUP_LIMIT}" \
      "${ifbench_arg[@]}" "${fb_data_arg[@]}" "${fb_cats_arg[@]}" \
      --map_cache_dir "${RESULTS_ROOT}/map_cache/eval_seed${SEED}"
  }

  # 交叉 math 侧：两次 evaluate 调用（标准贪心 / 难题集采样），都用 math 的 system。
  #
  # 为什么不能和上面 IF 那次合成一次调用：system prompt 和解码策略在 evaluate.py 里都是
  # 整个 run 共享的（configure_system_prompt / configure_decoding 各调一次）。IF 侧要中性
  # 助手消息、math 侧要 \boxed{} 指令；标准侧要贪心、难侧要采样。混在一次调用里必然有一侧
  # 被评在它没有基线的口径下。代价是模型多加载两遍。
  run_cross_math_eval () {
    local name="$1" ckpt="$2"
    local -a ckpt_arg=()
    if [[ -n "${ckpt}" ]]; then ckpt_arg=(--adapter_path "${ckpt}"); fi

    if [[ -n "${CROSS_METRICS}" ]]; then
      if side_pending "${CROSS_MATH_OUT_DIR}" "${name}" "${CROSS_METRICS}"; then
        echo "==== eval ${name} (${CROSS_METRICS}) 交叉 math / greedy cap=${MATH_MAX_NEW_TOKENS} batch=${MATH_BATCH} -> ${CROSS_MATH_OUT_DIR} ===="
        echo "     system: ${MATH_SYSTEM_PROMPT:-<空>}   (91 号的值，改它就没有可比的 before)"
        python -m onereplay.scripts.evaluate \
          --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
          "${ckpt_arg[@]}" --run_name "${name}" \
          --metrics "${CROSS_METRICS}" --out_dir "${CROSS_MATH_OUT_DIR}" --seed "${SEED}" \
          --system_prompt "${MATH_SYSTEM_PROMPT}" \
          --decode_stop_on_im_end "${STOP_ON_IM_END}" \
          --limit "${EVAL_LIMIT}" \
          --eval_batch_size "${EVAL_BATCH}" --math_batch_size "${MATH_BATCH}" \
          --gsm8k_data_path "${GSM8K_DATA}" \
          --math500_data_path "${MATH500_DATA}" \
          --math_max_new_tokens "${MATH_MAX_NEW_TOKENS}" \
          --map_cache_dir "${RESULTS_ROOT}/map_cache/eval_seed${SEED}"
      else
        echo "跳过交叉 math ${name}：${CROSS_METRICS} 都已有 summary（FORCE_EVAL=1 强制重评）"
      fi
    fi

    # --math_num_samples 只被 amc / minervamath 读取（metrics/math500.py 的
    # allow_multi_sample），math500 / gsm8k 在实现上就忽略它，所以它不会悄悄换掉
    # 上面那一侧的口径。
    if [[ -n "${CROSS_HARD_METRICS}" ]]; then
      if side_pending "${HARD_MATH_OUT_DIR}" "${name}" "${CROSS_HARD_METRICS}"; then
        echo "==== eval ${name} (${CROSS_HARD_METRICS}) 交叉 math / sample T=${HARD_MATH_TEMPERATURE} avg@${HARD_MATH_SAMPLES} cap=${HARD_MATH_MAX_NEW_TOKENS} batch=${HARD_MATH_BATCH} -> ${HARD_MATH_OUT_DIR} ===="
        python -m onereplay.scripts.evaluate \
          --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
          "${ckpt_arg[@]}" --run_name "${name}" \
          --metrics "${CROSS_HARD_METRICS}" --out_dir "${HARD_MATH_OUT_DIR}" --seed "${SEED}" \
          --system_prompt "${MATH_SYSTEM_PROMPT}" \
          --decode_stop_on_im_end "${STOP_ON_IM_END}" \
          --limit "${EVAL_LIMIT}" \
          --eval_batch_size "${EVAL_BATCH}" --math_batch_size "${HARD_MATH_BATCH}" \
          --amc_data_path "${AMC_DATA}" \
          --minervamath_data_path "${MINERVA_DATA}" \
          --math_max_new_tokens "${HARD_MATH_MAX_NEW_TOKENS}" \
          --math_num_samples "${HARD_MATH_SAMPLES}" \
          --minerva_rel_tol "${MINERVA_REL_TOL}" \
          --decode_do_sample 1 \
          --decode_temperature "${HARD_MATH_TEMPERATURE}" \
          --map_cache_dir "${RESULTS_ROOT}/map_cache/eval_seed${SEED}"
      else
        echo "跳过交叉难 math ${name}：${CROSS_HARD_METRICS} 都已有 summary（FORCE_EVAL=1 强制重评）"
      fi
    fi
  }

  for which in ${RUNS_TO_EVAL}; do
    case "${which}" in
      base) run_eval "base" "" ;;
      trained)
        if [[ -d "${CKPT}" ]]; then
          run_eval "${RUN}" "${CKPT}"
          # 交叉 math 只在这里调：base 的 math 分归 91 号。
          run_cross_math_eval "${RUN}" "${CKPT}"
        else
          echo "跳过 ${RUN}：checkpoint 不存在"
        fi
        ;;
      *) echo "未知 run: ${which}" ;;
    esac
  done
  if [[ "${DO_CROSS_MATH}" == "1" && " ${RUNS_TO_EVAL} " != *" trained "* ]]; then
    echo "!! DO_CROSS_MATH=1 但 RUNS_TO_EVAL=${RUNS_TO_EVAL} 里没有 trained，交叉侧什么都没跑。"
    echo "   交叉评测按设计只评 trained（base 的 math 分在 91 号）。"
  fi

  # -------------------------------------------------------------------------
  # 交叉 math 侧的长度/截断诊断 + 汇总。数学分数只有配着 hit-cap 才能读：预算不够时
  # 模型写不到 \boxed{} 就记 0 分，那是"预算不够"被读成"不会做"。
  # -------------------------------------------------------------------------
  if [[ "${DO_CROSS_MATH}" == "1" && "${DIAG_LEN}" == "1" ]]; then
    CROSS_DIAG=()
    for metric in gsm8k math500; do
      f="${CROSS_MATH_OUT_DIR}/${metric}/${RUN}/responses.jsonl"
      [[ -f "${f}" ]] && CROSS_DIAG+=("${MATH_MAX_NEW_TOKENS}" "${f}")
    done
    for metric in amc minervamath; do
      f="${HARD_MATH_OUT_DIR}/${metric}/${RUN}/responses.jsonl"
      [[ -f "${f}" ]] && CROSS_DIAG+=("${HARD_MATH_MAX_NEW_TOKENS}" "${f}")
    done
    if [[ ${#CROSS_DIAG[@]} -gt 0 ]]; then
      python - "${MODEL_DIR}/${MODEL_NAME}" "${CROSS_DIAG[@]}" <<'PY'
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(sys.argv[1], trust_remote_code=True)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


# argv 是 (cap, 文件) 交替：两侧的 cap 不同，用同一个数判 hit-cap 会把一侧算错。
print("==== 交叉 math: response length / truncation diagnostic ====")
pairs = list(zip(sys.argv[2::2], sys.argv[3::2]))
for raw_cap, path in pairs:
    cap = int(raw_cap)
    file = Path(path)
    rows = [json.loads(line) for line in file.open(encoding="utf-8") if line.strip()]
    if not rows:
        continue
    lengths = sorted(
        len(tokenizer(row.get("response", ""), add_special_tokens=False)["input_ids"])
        for row in rows
    )
    missing = sum(row.get("prediction") in (None, "") for row in rows)
    hit_cap = sum(length >= cap - 8 for length in lengths)
    label = f"{file.parent.parent.name}/{file.parent.name}"
    # 采样 avg@k 的文件里 n = 题数 x k。
    print(
        f"{label:>44}: cap={cap} n={len(rows)} "
        f"no-answer={missing} ({missing / len(rows):.1%}) "
        f"hit-cap={hit_cap} ({hit_cap / len(rows):.1%}) "
        f"P50={pct(lengths, 50)} P90={pct(lengths, 90)} P99={pct(lengths, 99)}"
    )
print("hit-cap 接近 0 且 P99 明显低于 cap => 预算够用。难题集那一侧是采样解码，hit-cap")
print("天然比贪心高，不要和标准侧比大小。")
PY
    fi
  fi

  if [[ "${DO_CROSS_MATH}" == "1" ]]; then
    python - "${CROSS_MATH_OUT_DIR}" "${HARD_MATH_OUT_DIR}" <<'PY' || true
import json
import sys
from pathlib import Path

standard_root, hard_root = (Path(p) for p in sys.argv[1:3])


def runs_in(root: Path, metrics):
    names = set()
    for metric in metrics:
        directory = root / metric
        if directory.is_dir():
            names.update(path.name for path in directory.iterdir() if path.is_dir())
    return sorted(names)


def load(root: Path, metric: str, name: str):
    path = root / metric / name / "summary.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else None


def pct(payload, key, width):
    if payload is None or payload.get(key) is None:
        return "-".rjust(width)
    return f"{payload[key] * 100:.1f}".rjust(width)


standard = runs_in(standard_root, ("gsm8k", "math500"))
if standard:
    print()
    print("=" * 78)
    print("交叉 math / 标准（贪心 greedy@1）accuracy %")
    print("=" * 78)
    print(f"{'run':<40}{'GSM8K':>9}{'MATH500':>9}")
    for name in standard:
        print(
            f"{name:<40}"
            + pct(load(standard_root, "gsm8k", name), "accuracy", 9)
            + pct(load(standard_root, "math500", name), "accuracy", 9)
        )

hard = runs_in(hard_root, ("amc", "minervamath"))
if hard:
    print()
    print("=" * 96)
    print("交叉 math / 难（采样 average@k）accuracy %，pass@k = 至少答对一次的题目占比")
    print("=" * 96)
    print(f"{'run':<40}{'AMC':>8}{'pass@k':>9}{'Minerva':>9}{'strict':>8}{'pass@k':>9}")
    for name in hard:
        amc = load(hard_root, "amc", name)
        minerva = load(hard_root, "minervamath", name)
        print(
            f"{name:<40}"
            + pct(amc, "accuracy", 8)
            + pct(amc, "pass_at_k", 9)
            + pct(minerva, "accuracy", 9)
            + pct(minerva, "accuracy_strict_string", 8)
            + pct(minerva, "pass_at_k", 9)
        )
    for name in hard:
        for metric in ("amc", "minervamath"):
            payload = load(hard_root, metric, name)
            if payload and payload.get("accuracy_per_sample"):
                print(
                    f"  {metric:<12}{name:<40} 四次各自: "
                    f"{payload['accuracy_per_sample']}  (k={payload.get('num_samples')}, "
                    f"T={payload.get('temperature')})"
                )

if standard or hard:
    print()
    print("这几张表**没有 base 那一行，也不该有**：base 的 math 分在 91 号的结果树里")
    print("（results_part1_numina_*/eval_cap2048 和 eval_hard_*），两边的 system、cap、")
    print("batch、采样配置逐字相同，而且是同一个 base 权重，所以直接并表。")
    print("差值 = FLAN/Conifer 的 IF 训练对数学能力的净影响。它如果显著为正，那么 S3 里")
    print("「训完 math 之后 IF 没掉」就不能直接读成「math 训练不伤 IF」—— 两个能力本来")
    print("就是同向的，S3 的差被这条正相关抵掉了一部分。")
PY
  fi

  # -------------------------------------------------------------------------
  # 汇总：三个指标一张表，**每个分数右边紧跟它自己的响应词数中位数**。
  #
  # 这一段不是锦上添花。本线训练数据的答案 P50 只有 18 token，输出长度一定会塌，
  # 而三个 benchmark 里都有相当比例的约束其实在量长度。分数和 words 分开看就会
  # 把长度漂移读成能力变化。words 用 len(response.split()) 从各自的
  # responses.jsonl 现算，与 followbench.response_shape 同一个定义，所以 fb 那列
  # 和它 summary.json 里的 response_words_p50 严格一致。
  # -------------------------------------------------------------------------
  python - "${RESULTS_ROOT}" <<'PY' || true
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
METRICS = ("ifeval", "ifbench", "followbench")

# RUNS_TO_EVAL 里是别名（base/trained），实际目录名是 base / part1_if_flanv2_*，
# 而且拆开跑时同一个 run 会分几次作业落盘。扫目录比推算名字稳。
names: set[str] = set()
for metric in METRICS:
    directory = root / metric
    if directory.is_dir():
        names.update(path.name for path in directory.iterdir() if path.is_dir())
if not names:
    print("\n没有可汇总的 summary.json")
    raise SystemExit(0)
order = sorted(names, key=lambda name: (name != "base", name))


def load(metric: str, name: str):
    path = root / metric / name / "summary.json"
    if not path.is_file():
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def words_p50(metric: str, name: str):
    path = root / metric / name / "responses.jsonl"
    if not path.is_file():
        return None
    counts = []
    with path.open(encoding="utf-8") as file:
        for line in file:
            if line.strip():
                counts.append(len(str(json.loads(line).get("response", "")).split()))
    if not counts:
        return None
    counts.sort()
    return counts[len(counts) // 2]


def pct(payload, key, width):
    if payload is None or payload.get(key) is None:
        return "-".rjust(width)
    return f"{payload[key] * 100:.1f}".rjust(width)


def num(value, width, fmt="{:.0f}"):
    if value is None:
        return "-".rjust(width)
    return fmt.format(value).rjust(width)


print()
print("=" * 100)
print("Part 1 / FLAN-v2 线   prompt-level strict accuracy (%)，words = 响应词数中位数")
print("=" * 100)
print(f"{'run':<32}{'IFEval':>8}{'words':>8}{'IFBench':>9}{'words':>8}{'FB HSR':>9}{'words':>8}")
for name in order:
    ifeval = load("ifeval", name)
    ifbench = load("ifbench", name)
    fb = load("followbench", name)
    # FB HSR 取 level 1..5 的均值，是这张概览表的单值代理；分级曲线在下一张表。
    levels = (
        [fb.get(f"rule_hsr_level_{level}") for level in range(1, 6)] if fb else []
    )
    levels = [value for value in levels if value is not None]
    fb_mean = f"{sum(levels) / len(levels) * 100:.1f}".rjust(9) if levels else "-".rjust(9)
    print(
        f"{name:<32}"
        + pct(ifeval, "strict_prompt_accuracy", 8)
        + num(words_p50("ifeval", name), 8)
        + pct(ifbench, "strict_prompt_accuracy", 9)
        + num(words_p50("ifbench", name), 8)
        + fb_mean
        + num(words_p50("followbench", name), 8)
    )
print()
print("**分数和它右边的 words 必须一起读**：本线训练数据的答案 P50 只有 18 token，")
print("输出长度必然被压缩，而三个 benchmark 里的 format / style / 长度类约束有相当")
print("一部分其实在量长度（见 results_log/2026-09-12 第 8c 节）。分数变了先看 words，")
print("再谈「FLAN 教不教得会 IF」。")

# FollowBench 的价值在分级曲线而不是单值：它报的是模型在第几级开始塌。
fb_rows = [(name, load("followbench", name)) for name in order]
fb_rows = [(name, payload) for name, payload in fb_rows if payload]
if fb_rows:
    print()
    print("=" * 100)
    print("FollowBench rule 侧分级曲线（HSR %，覆盖 70/164 组；CSL 是 0-5 的级数）")
    print("=" * 100)
    print(f"{'run':<32}{'L1':>7}{'L2':>7}{'L3':>7}{'L4':>7}{'L5':>7}{'CSL':>8}{'empty':>7}")
    for name, payload in fb_rows:
        cells = "".join(
            pct(payload, f"rule_hsr_level_{level}", 7) for level in range(1, 6)
        )
        print(
            f"{name:<32}{cells}"
            + num(payload.get("rule_csl"), 8, "{:.2f}")
            + num(payload.get("response_empty"), 7)
        )
    print()
    print("这三列**不是 FollowBench 全量分数**：style 类 rule 覆盖为 0，format 类只")
    print("覆盖 2/30，example 类还有 2 组是退化的（ladder 4 恒 0 / ladder 21 恒满分）。")
    print("judge 那 470 行要在有网的地方过 judge_followbench.py 才能补齐 164 组。")
PY
fi

echo "========================================================================"
echo "产物:"
echo "  IF 池        : ${IF_DATASET}"
echo "                 manifest -> ${RESULTS_ROOT}/datasets/$(basename "${IF_DATASET}")_manifest.json"
if [[ "${IF_SOURCE}" == "conifer" ]]; then
  echo "  replay 池    : ${REPLAY_POOL}   (save_to_disk；Part 2 读 jsonl，还没对接)"
else
  echo "  replay/C 池  : ${REPLAY_POOL}   (Part 2 用；replay.py 与 collect_cov 读同一份)"
  echo "  heldout 池   : ${HELDOUT_POOL}   (probe.py 的 flan_heldout)"
fi
echo "  checkpoint   : ${CKPT}"
echo "  评测         : ${RESULTS_ROOT}/{ifeval,ifbench,followbench}/<run>/summary.json"
echo "  汇总 csv     : ${RESULTS_ROOT}/{ifeval,ifbench,followbench}_summary.csv"
echo "  交叉 math    : ${CROSS_MATH_OUT_DIR}/{gsm8k,math500}/${RUN}/summary.json"
echo "                 ${HARD_MATH_OUT_DIR}/{amc,minervamath}/${RUN}/summary.json"
echo "                 (DO_CROSS_MATH=1 才有；base 那两格在 91 号的结果树里)"
echo ""
echo "FollowBench 的 judge 那半边（470 行，要在有网的地方跑）:"
echo "  python -m onereplay.scripts.judge_followbench \\"
echo "    --input ${RESULTS_ROOT}/followbench/${RUN}/judge_inputs.jsonl \\"
echo "    --output ${RESULTS_ROOT}/followbench/${RUN}/judge_outputs.jsonl --api_key ..."
echo "然后 score_followbench.py 合并两半，出完整的 164 组 HSR/SSR/CSL。"
echo ""
echo "怎么读结论:"
echo "  * Model-IF 的 IFEval/IFBench/FB 明显高于 base => FLAN v2 确实教会了指令遵循，"
echo "    这条线的 sanity check 通过。base 是数学专用模型，起点会很低，看方向和幅度。"
echo "  * 分数升降都要先对照 FB words / 响应长度，再谈能力 —— 本线必然压缩输出长度。"
echo "  * 和 91/93 号的 val loss 绝对值不可比（答案长度差一个量级），只能比各自的评测分数。"
echo "  * 交叉 math（DO_CROSS_MATH=1）回答的是另一个问题：IF 训练顺带改变了多少数学能力。"
echo "    它的另一半在 91 号（DO_CROSS_IF=1）。两个脚本各跑一条 trained 就凑齐 2x2 表，"
echo "    base 那两格分别在两个脚本已有的结果里，不用重评。"
echo "Job finished at: $(date)"
