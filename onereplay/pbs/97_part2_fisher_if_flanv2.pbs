#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N p2_fisher_if
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=12:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# Part 2 Stage 1b: 在 Model-IF-FLAN 上采对角经验 Fisher（EWC 的权重矩阵）
#
#     F_l = (1/N) Σ_n (∂L_n / ∂W_l)²      L_n = -Σ_{t ∈ assistant} log p(y_t | x, y_<t)
#
# 这是 95 号（采 C）的孪生脚本。EWC 是 onereplay 的**主要对照**：两者都是
# λ·<权重矩阵, ΔW²> 形式的二次罚项，唯一的差别是那个权重矩阵是
#   onereplay  C_l = E_x[x xᵀ]           输入激活的二阶矩（跨列有相关性，是满矩阵）
#   ewc        F_l = E_n[(∂L/∂W_l)²]     每个权重独立的梯度平方（对角）
# 所以这条对照只有在「两者吃的是同一批旧知识」时才成立。本脚本把这件事做成硬检查，
# 而不是靠记性：Step 0 会读 95 号产出的 C 文件，逐项对比模型名 / 池指纹 / max_len /
# truncation / scope，任一不符就退出。
#
# -----------------------------------------------------------------------------
# 【三个被 collect_fisher 强制的差别，都不是可调项】
#
# 1) --use_bf16 0（模型跑 fp32）
#    C 是前向激活累加的，hook 里已经 .float() 加宽，所以模型走 bf16 无损。
#    F 不一样：梯度在到达我们手里之前**已经被 backward 舍入过了**。bf16 有 fp32 的
#    指数范围所以不会下溢，但 8 位尾数会给每个「梯度平方」压上约 1% 的噪声底。
#    这是个一次性作业、有几小时余量，没必要留这个问号。
#
# 2) batch_size 固定为 1，**collect_fisher 根本没有这个参数**。
#    Fisher 要的是逐样本梯度：对 batch 求和后的梯度再平方，算的是 (Σ_n g_n)²，
#    不是 Σ_n g_n²。两者差一个交叉项 2Σ_{n≠m} g_n·g_m，而且这个交叉项不是小量。
#    所以 20000 行就是 20000 次独立 backward，没法靠调 batch 提速。
#
# 3) 只监督 assistant token（labels 里 prompt 段是 -100）
#    F 量的是「模型对自己答案的敏感度」，不是「对 prompt 的重建能力」。
#
# -----------------------------------------------------------------------------
# 【FISHER_DEVICE=cuda：这里刻意不听 collect_fisher docstring 的建议】
#
# 它的 help 写着 full scope「about 7 GiB on top of an fp32 model and its gradients,
# so use cpu there」。那句话是按 8B 写的。1.7B 上把数算全了：
#
#   fp32 模型          1.7205G 参数 x 4B          = 6.41 GiB
#   fp32 梯度          同上（select_target_weights 只留目标层，但 full scope 覆盖
#                      了几乎全部矩阵参数）        = 6.41 GiB
#   F 累加器 (cuda)                               = 6.41 GiB
#   激活 (1 条, T<=1536, 无 checkpointing, fp32)   约 4.9 GiB
#   logits + CE 中间量 (1536 x 151936 fp32)        约 2.8 GiB
#   ------------------------------------------------------------
#                                                 约 27 GiB / 140 GiB (H200)
#
# 余量很大。而放 CPU 的代价是实打实的：add_example 每条样本要把 197 个梯度平方
# 搬过 PCIe，也就是每条 6.88 GB、共 20000 条。按 20 GB/s 算是 **+1.9 小时**下限，
# 而且是 197 次小传输 x 20000 的同步开销，实际更差。这条线用 cuda。
#
# 8B 线（或者显存紧的卡）再传 FISHER_DEVICE=cpu。
#
# -----------------------------------------------------------------------------
# 【耗时：20000 次逐样本 backward】
#
#   每条 FLOPs ≈ 6 x 1.72e9 x T。FLAN v2 的 targets 很短（94 号实测 P50 约 18 token），
#   但 inputs 不短；按平均 T≈400 估是 4.1 TFLOP/条。fp32（不开 TF32）在 H200 上
#   实际吞吐远低于峰值，batch=1 又填不满 GPU，所以别按峰值算。
#   累加器本身是显存带宽瓶颈：每条 1.72G x 4B x 3 次读写 = 20.6 GB / 4.8 TB/s ≈ 4.3 ms。
#
#   预计 **0.5-2 小时**。collect_fisher 每 ${LOG_EVERY} 条打一次 ms/example，
#   **拿它乘 20000 才是真实时长**，上面这个区间只是让你判断作业有没有卡住。
#
# -----------------------------------------------------------------------------
# 【EWC 的 λ 和 onereplay 的 λ 完全不可比，不要互相借】
#
# F 是梯度平方，量级比 C（激活二阶矩）低好几个数量级。train.py 的 --regularizer
# help 里写得很直接：「--replay_lambda is the coefficient either way, but the two
# scales are not comparable and need separate sweeps」。
# collect_fisher 结束时会打印 F 的 mean/max，Step 2 会把 **1/mean** 作为 λ 的起点
# 给出来，然后按十倍一档往两边扩。95 号那套 7.5e-3 在这里毫无意义。
#
# -----------------------------------------------------------------------------
# 【tie_word_embeddings=true 对 lm_head 的影响：是特性，不要"修"】
#
# Qwen3-1.7B-Base 的 config 里 tie_word_embeddings=true，即 lm_head.weight 和
# embed_tokens.weight 是**同一个张量**。于是：
#   * F_lm_head 里混合了两条路径的梯度 —— 输出投影的，和输入 embedding 查表的。
#   * 这与训练时的情形是**一致**的：罚项里的 ΔW_lm_head 也是这同一个张量的改变量，
#     所以 F 度量的正是罚项将要约束的那个量。
#   * 但它和 C 是**不对称**的：C_lm_head = E[x xᵀ] 只由 lm_head 这个 module 的
#     forward hook 采到，看到的只有最后一层隐状态，看不到 embedding 查表那条路。
# 这个不对称是两种方法定义本身带来的，不是实现 bug。要去掉它只能把 lm_head 从
# scope 里摘掉，而那会同时改变 onereplay 的覆盖范围 —— 那就是另一个实验了。
#
# -----------------------------------------------------------------------------
# 【两个"缺失"的参数：不要加，加了 argparse 会直接报错】
#
# 95 号给 collect_cov 传了 --enable_thinking 0 和 --concat_prompt_target 0，
# collect_fisher 的参数表里没有这两个。但渲染仍然是**逐字节相同**的，因为
# data/old_knowledge.py 是用 getattr 读它们的，默认值正好就是 0：
#     enable_thinking=getattr(args, "enable_thinking", 0) == 1        -> False
#     if getattr(args, "concat_prompt_target", 0) == 1 and ...        -> 跳过
# 也就是说 F 看到的 token 序列和 C 看到的是同一个。别为了"对齐"去加这两个 flag。
#
# -----------------------------------------------------------------------------
# 【--truncation_side left 对 F 比对 C 更要紧】
#
# collect_fisher 的默认是空串 = 跟 tokenizer 默认（right，先切答案）。右截断把答案
# 切掉之后，这一行的 supervised token 数变成 0 —— 它不会报错、也不会被丢掉，而是走
# add_empty()：算作 N 的一员但贡献 0。也就是说右截断会**静默地稀释 F**。
# 左截断切的是 prompt 开头，答案保住，所以 zero_supervision_rows 应当接近 0。
# Step 2 会把这个数打出来。
#
# -----------------------------------------------------------------------------
# 【前置】计算节点无外网
#   1) Model-IF-FLAN checkpoint   94 号 MODE=train 的产物（不传 IF_LR 时自动 glob）
#   2) 20k 旧知识池               94 号的 flan_v2_if_50k_replay.jsonl
#   3) C_if                       95 号的产物（用来做一致性硬检查）
#   4) mkdir -p ${REPO_ROOT}/logs
#
# 【用法】
#   # 只做前置检查（含与 C 的一致性对表），不碰 GPU
#   qsub -v DRY_RUN=1 onereplay/pbs/97_part2_fisher_if_flanv2.pbs
#
#   # 正式采集（scope 必须与 C 一致，默认都是 full）
#   qsub onereplay/pbs/97_part2_fisher_if_flanv2.pbs
#
#   # qv 对照（要先有 qv 的 C）
#   qsub -v FISHER_SCOPE=qv onereplay/pbs/97_part2_fisher_if_flanv2.pbs
#
#   # 只重跑诊断，不重采
#   qsub -v DO_FISHER=0 onereplay/pbs/97_part2_fisher_if_flanv2.pbs
#
#   # 便宜地把链路跑通（500 行，约 1-2 分钟；产物不可用于正式实验）
#   qsub -v MAX_SAMPLES=500,FISHER_PATH=/tmp/f_smoke.pt onereplay/pbs/97_part2_fisher_if_flanv2.pbs
#
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id>
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/97_part2_fisher_if_flanv2.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_p2fisher_${JOBTAG}}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_p2fisher_${JOBTAG}}"
  EXTRA_BIND=""
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_p2fisher_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME IF_LINE_ROOT IF_CKPT_DIR IF_LR IF_RUN IF_CKPT
    RESULTS_ROOT DATASET_CACHE POOL_FILE POOL_ROWS_EXPECT
    DRY_RUN FORCE DO_FISHER
    SEED SAMPLE_SEED MAXLEN FISHER_SCOPE TARGET_MODULES FISHER_DEVICE
    FISHER_PATH FISHER_TAG COV_PATH REQUIRE_COV USE_BF16
    MAX_SAMPLES LOG_EVERY
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e --nv -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

cd "${REPO_ROOT}"
# ---- Stage 1（IF 线 / FLAN v2）的产物，本脚本只读 ----
IF_LINE_ROOT="${IF_LINE_ROOT:-${REPO_ROOT}/results_part1_if_flanv2}"
IF_CKPT_DIR="${IF_CKPT_DIR:-${IF_LINE_ROOT}/checkpoints}"
POOL_FILE="${POOL_FILE:-${IF_LINE_ROOT}/datasets/flan_v2_if_50k_replay.jsonl}"
POOL_ROWS_EXPECT="${POOL_ROWS_EXPECT:-20000}"

# ---- Part 2 的结果树，与 95 号同一棵 ----
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_part2_if2math}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
export HF_DATASETS_CACHE="${DATASET_CACHE}"

# ---- 原始 Base，只用于 Step 0 打印对照（本脚本**不**在它上面采 F）----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B-Base}"

# ---- 阶段开关 ----
DRY_RUN="${DRY_RUN:-0}"
FORCE="${FORCE:-0}"
DO_FISHER="${DO_FISHER:-1}"

# ---- 采集参数：凡是决定「看到哪些 token」的，都必须与 95 号逐字相同 ----
SEED="${SEED:-1}"
SAMPLE_SEED="${SAMPLE_SEED:-1}"
# 必须等于 95 号的 MAXLEN，也等于 94 号训练时的 MAXLEN。Step 0 会和 C 的 metadata 对表。
MAXLEN="${MAXLEN:-1536}"
# scope 必须与 C 一致，否则 EWC 和 onereplay 约束的层集合不同，对照失效。
FISHER_SCOPE="${FISHER_SCOPE:-full}"
case "${FISHER_SCOPE}" in
  qv)
    TARGET_MODULES="${TARGET_MODULES:-q_proj,v_proj}"
    FISHER_TAG="${FISHER_TAG:-qv}"
    ;;
  full)
    TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj,lm_head}"
    FISHER_TAG="${FISHER_TAG:-full}"
    ;;
  *)
    echo "未知 FISHER_SCOPE=${FISHER_SCOPE}，可选 qv / full"; exit 1
    ;;
esac
# cuda：1.7B 上总占用约 27 GiB，余量很大；放 CPU 每条要过 PCIe 搬 6.88 GB。见文件头。
FISHER_DEVICE="${FISHER_DEVICE:-cuda}"
# 0 = 模型跑 fp32。梯度在 backward 里就被舍入了，事后加宽救不回来。见文件头。
USE_BF16="${USE_BF16:-0}"
# 0 = 取池文件全量、不打乱。与 95 号一致（文件本身就是那 20k 行）。
MAX_SAMPLES="${MAX_SAMPLES:-0}"
LOG_EVERY="${LOG_EVERY:-1000}"

FISHER_PATH="${FISHER_PATH:-${RESULTS_ROOT}/fisher/fisher_if_flanv2_20k_${FISHER_TAG}.pt}"
# 95 号的产物。这条线的全部意义在于 F 和 C 同池同模型，所以默认强制要求它存在。
COV_PATH="${COV_PATH:-${RESULTS_ROOT}/cov/cov_if_flanv2_20k_${FISHER_TAG}.pt}"
REQUIRE_COV="${REQUIRE_COV:-1}"

mkdir -p "$(dirname "${FISHER_PATH}")" "${DATASET_CACHE}"

# ===========================================================================
# Step 0: 前置检查（纯 CPU，几分钟）
#
# 六件事，每件对应一个「不报错但会毁掉对照」的失败模式：
#   1) Stage 1 checkpoint 存在、唯一、是完整权重而不是 LoRA adapter
#   2) 池文件存在、行数正好、schema 有 inputs/targets
#   3) 池指纹（与 95 号必须是同一个值）
#   4) C 文件存在，且它的 model_name / pool_fingerprint / max_len / truncation /
#      target_modules 与本次采 F 的设置逐项一致 —— 这是 EWC vs onereplay 的公平前提
#   5) USE_BF16 不是 1（是 1 会给每个梯度平方压上约 1% 噪声底）
#   6) FISHER_DEVICE 与 scope 的显存匹配
# ===========================================================================
echo "==== Step 0: 前置检查 ===="

# ---- 1) 解析 Stage 1 checkpoint（与 95 号同一套逻辑，必须选到同一个模型）----
if [[ -z "${IF_CKPT:-}" ]]; then
  if [[ -n "${IF_LR:-}" ]]; then
    IF_RUN="${IF_RUN:-part1_if_flanv2_lr${IF_LR}_seed${SEED}}"
    IF_CKPT="${IF_CKPT_DIR}/${IF_RUN}"
  else
    mapfile -t _CANDS < <(
      find "${IF_CKPT_DIR}" -maxdepth 1 -mindepth 1 -type d \
        -name "part1_if_flanv2_lr*_seed${SEED}" 2>/dev/null | sort
    )
    if (( ${#_CANDS[@]} == 0 )); then
      echo "在 ${IF_CKPT_DIR} 下找不到 part1_if_flanv2_lr*_seed${SEED}"
      echo "先跑: qsub -v MODE=train,LR=<lr> onereplay/pbs/94_part1_if_flanv2.pbs"
      echo "或显式指定: qsub -v IF_CKPT=/abs/path onereplay/pbs/97_part2_fisher_if_flanv2.pbs"
      exit 1
    fi
    if (( ${#_CANDS[@]} > 1 )); then
      echo "命中多个 Stage 1 checkpoint，必须显式选一个（F 采在哪个模型上要和 C 一致）:"
      for _c in "${_CANDS[@]}"; do echo "  ${_c}"; done
      echo "传 IF_LR=<lr> 或 IF_CKPT=<绝对路径>"
      exit 1
    fi
    IF_CKPT="${_CANDS[0]}"
    IF_RUN="$(basename "${IF_CKPT}")"
  fi
fi
IF_RUN="${IF_RUN:-$(basename "${IF_CKPT}")}"

[[ -d "${IF_CKPT}" ]] || { echo "缺 Stage 1 checkpoint: ${IF_CKPT}"; exit 1; }
[[ -f "${IF_CKPT}/config.json" ]] || {
  echo "${IF_CKPT} 里没有 config.json，不是一个可加载的模型目录"; exit 1
}
if [[ -f "${IF_CKPT}/adapter_config.json" ]]; then
  echo "${IF_CKPT} 是 LoRA adapter 目录。本线要求全量 checkpoint（F 采在 W0 上，"
  echo "而 W0 必须是 Stage 2 真正的起点权重）。先 merge 出完整权重。"
  exit 1
fi
if ! compgen -G "${IF_CKPT}/*.safetensors" >/dev/null 2>&1 \
   && ! compgen -G "${IF_CKPT}/*.bin" >/dev/null 2>&1; then
  echo "${IF_CKPT} 里没有权重文件（*.safetensors / *.bin）。"
  echo "94 号的训练可能被打断了，只落了 config。"
  exit 1
fi
echo "Stage 1 checkpoint : ${IF_CKPT}"
echo "  run 名           : ${IF_RUN}"

# ---- 2) 池文件 ----
[[ -f "${POOL_FILE}" ]] || {
  echo "缺 20k 旧知识池: ${POOL_FILE}"
  echo "它是 94 号 MODE=data 的产物（prepare_flan_v2 的 <训练池>_replay.jsonl）"
  exit 1
}
POOL_ROWS_ACTUAL="$(wc -l < "${POOL_FILE}")"
echo "池文件             : ${POOL_FILE}"
echo "  行数             : ${POOL_ROWS_ACTUAL} (期望 ${POOL_ROWS_EXPECT})"
if [[ "${POOL_ROWS_ACTUAL}" != "${POOL_ROWS_EXPECT}" ]]; then
  echo "行数与期望不符。**这会让 F 和 C 不同池**，EWC vs onereplay 的对照直接失效。"
  echo "确认这就是 95 号用过的那个池的话，传 POOL_ROWS_EXPECT=${POOL_ROWS_ACTUAL} 放行。"
  exit 1
fi

python - "${POOL_FILE}" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    first = json.loads(handle.readline())
missing = [column for column in ("inputs", "targets") if column not in first]
if missing:
    raise SystemExit(
        f"池文件缺列 {missing}，实际有 {sorted(first)}。\n"
        "collect_cov / collect_fisher / replay 三边都按 inputs/targets 读。"
    )
print(f"  schema           : {sorted(first)}  (inputs/targets 就位)")
PY

# ---- 3) 池指纹 ----
# 与 Step 1 的 collect_fisher 逐字同参，所以这里打印的就是 F 会看到的那批行的指纹。
# 它必须等于 95 号打印过的那个值 —— 下面第 4 步会直接和 C 文件里记的对比。
POOL_FP="$(python -m onereplay.scripts.check_old_knowledge_pool \
  --data_files "${POOL_FILE}" --dataset_split train \
  --cache_dir "${DATASET_CACHE}" --streaming 0 \
  --input_column inputs --target_column targets \
  --require_target 1 \
  --max_samples "${MAX_SAMPLES}" --sample_shuffle 0 --sample_seed "${SAMPLE_SEED}" \
  --label if_flanv2_20k | tail -n 1)"
echo "${POOL_FP}"
POOL_HASH="${POOL_FP##*fingerprint=}"
POOL_FP_ROWS="${POOL_FP##*rows=}"; POOL_FP_ROWS="${POOL_FP_ROWS%% *}"

# ---- 4) 与 C 的一致性硬检查 ----
# 这是本脚本存在的理由。F 和 C 只要有一项口径不同，「EWC 和 onereplay 吃了同一批
# 旧知识」这句话就不成立，而两个文件都会正常写出来、训练也不会报错。
if [[ -f "${COV_PATH}" ]]; then
  python - "${COV_PATH}" "${IF_RUN}" "${POOL_HASH}" "${MAXLEN}" "${TARGET_MODULES}" <<'PY'
import sys

import torch

cov_path, want_model, want_fp, want_max_len, want_modules = sys.argv[1:6]
want_max_len = int(want_max_len)
want_modules = [item for item in want_modules.split(",") if item]

payload = torch.load(cov_path, map_location="cpu")
meta = payload.get("metadata", {})

print(f"C_if (95 号) 的口径: {cov_path}")
checks = [
    ("model_name", str(meta.get("model_name", "")), want_model),
    ("pool_fingerprint", str(meta.get("pool_fingerprint", "")), want_fp),
    ("max_len", int(meta.get("max_len", -1)), want_max_len),
    ("target_modules", list(meta.get("target_modules", [])), want_modules),
]
bad = []
for label, got, want in checks:
    flag = "ok" if got == want else "!! 不一致"
    print(f"  {label:<18} C={got}")
    print(f"  {'':<18} F={want}   {flag}")
    if got != want:
        bad.append(label)

# truncation_side 单独报：C 那边记的是 args.truncation_side or tokenizer 默认，
# 所以它一定是个具体值（95 号传的是 left），而 F 这边也要传 left。
cov_trunc = str(meta.get("truncation_side", ""))
print(f"  truncation_side    C={cov_trunc}   F=left   "
      + ("ok" if cov_trunc == "left" else "!! 不一致"))
if cov_trunc != "left":
    bad.append("truncation_side")

print(f"  (参考) pool_rows   C={meta.get('pool_rows')}")

if bad:
    raise SystemExit(
        f"\n!! 与 C 不一致的项: {', '.join(bad)}\n"
        "EWC 和 onereplay 的整条对照建立在「两者吃同一批旧知识、约束同一批层」之上。\n"
        "这些项任一不同，两个方法的 λ 就不再是同一个东西的系数，而且不会报错。\n"
        "要么把本作业的参数改成与 C 一致，要么重采 C。"
    )
print("与 C 的口径完全一致：ok")
PY
elif [[ "${REQUIRE_COV}" == "1" ]]; then
  echo "缺 C_if: ${COV_PATH}"
  echo "F 的用处是给 onereplay 当 EWC 对照，所以默认要求 C 先存在、并逐项对表。"
  echo "先跑: qsub onereplay/pbs/95_part2_cov_if_flanv2.pbs"
  echo "确实要单独采 F（比如只做 EWC 基线）的话传 REQUIRE_COV=0。"
  exit 1
else
  echo "!! REQUIRE_COV=0 且没有 C 文件：跳过一致性检查。"
  echo "   记下这个池指纹，将来采 C 时必须一致: ${POOL_HASH}"
fi

# ---- 5) 精度 ----
if [[ "${USE_BF16}" == "1" ]]; then
  echo "!! USE_BF16=1：模型走 bf16，梯度会先被舍入到 8 位尾数再平方，"
  echo "   相当于给每个 F 元素压上约 1% 的噪声底。collect_fisher 的默认是 0 就是为了这个。"
  echo "   除非你在刻意做精度消融，否则改回 USE_BF16=0。"
fi

# ---- 6) 累加器位置与显存 ----
if [[ "${FISHER_DEVICE}" == "cpu" ]]; then
  echo "!! FISHER_DEVICE=cpu：每条样本要把 197 个梯度平方搬过 PCIe（约 6.88 GB/条），"
  echo "   20000 条按 20 GB/s 算是 +1.9h 下限。1.7B 上 cuda 只占约 27 GiB，建议用 cuda。"
fi

echo ""
echo "========================================================================"
echo "Part 2 Stage 1b: 采 F_if（EWC 的权重矩阵）"
echo "  模型          : ${IF_CKPT}"
echo "                  (= Stage 2 的起点 W0，与 95 号采 C 的模型同一个)"
echo "  旧知识池      : ${POOL_FILE}"
echo "                  ${POOL_FP_ROWS} 行, gold targets, nested ⊂ Stage 1 训练池"
echo "  池指纹        : ${POOL_HASH}"
echo "  scope         : ${FISHER_SCOPE}  (${TARGET_MODULES})"
echo "  采集口径      : max_len=${MAXLEN} truncation=left batch=1(强制) use_bf16=${USE_BF16}"
echo "  累加器        : ${FISHER_DEVICE}"
echo "  对照的 C      : ${COV_PATH}"
echo "  产物          : ${FISHER_PATH}"
echo "========================================================================"
if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只做前置检查，不采 F。"
  echo "Job finished at: $(date)"
  exit 0
fi
# ===========================================================================
# Step 1: 采 F
#
# 关键参数（凡是决定「看到哪些 token」的都与 95 号逐字相同）:
#   --model_dir/--model_name     指向 Stage 1 checkpoint，不是原始 Base
#   --use_chat_template 1        与 94 号训练、95 号采 C 同一套渲染
#   --include_target_in_chat 1   assistant turn 放 FLAN 的 gold target
#                                （collect_fisher 强制要求它是 1：没有 assistant turn
#                                 就没有被监督的 token，F 会全是 0）
#   --truncation_side left       右截断会切掉答案 -> supervised token 数为 0 -> 静默稀释 F
#   --max_samples 0 --sample_shuffle 0   文件本身就是那 20k 行，取全量不打乱
#   --require_target 1           与 replay 的 to_sft_schema 同口径
#   --use_bf16 0                 fp32 模型，梯度不被提前舍入
#   （没有 --batch_size：collect_fisher 内部固定 1，逐样本梯度不可 batch）
#   （没有 --enable_thinking / --concat_prompt_target：old_knowledge.py 用 getattr
#     读它们、默认就是 0，与 95 号显式传的 0 等价。加了 argparse 会报错。）
# ===========================================================================
if [[ "${DO_FISHER}" == "1" ]]; then
  if [[ "${FORCE}" != "1" && -f "${FISHER_PATH}" ]]; then
    echo "跳过采 F：${FISHER_PATH} 已存在（FORCE=1 可强制重采）"
  else
    echo "==== Step 1: collect F_if -> ${FISHER_PATH} ===="
    echo "20000 次逐样本 backward，预计 0.5-2h。"
    echo "**拿日志里的 ms/example x 20000 才是真实时长**，上面只是判断有没有卡住的区间。"
    python -m onereplay.scripts.collect_fisher \
      --model_dir "${IF_CKPT_DIR}" --model_name "${IF_RUN}" \
      --seed "${SEED}" --use_bf16 "${USE_BF16}" \
      --data_files "${POOL_FILE}" --dataset_split train \
      --cache_dir "${DATASET_CACHE}" --streaming 0 \
      --input_column inputs --target_column targets \
      --require_target 1 \
      --use_chat_template 1 --include_target_in_chat 1 \
      --max_samples "${MAX_SAMPLES}" --sample_shuffle 0 --sample_seed "${SAMPLE_SEED}" \
      --max_len "${MAXLEN}" \
      --truncation_side left \
      --target_modules "${TARGET_MODULES}" \
      --fisher_device "${FISHER_DEVICE}" \
      --log_every "${LOG_EVERY}" \
      --output_path "${FISHER_PATH}"
  fi
else
  echo "DO_FISHER=0：使用已有 ${FISHER_PATH}"
fi
[[ -f "${FISHER_PATH}" ]] || { echo "缺 F_if: ${FISHER_PATH}"; exit 1; }

# ===========================================================================
# Step 2: 诊断
#
# 五组数，各挡一类错误：
#   A) metadata 自检 —— 估计量定义、池指纹、N、口径有没有真的传上去。
#      这些错了 F 仍会写出一个合法文件，只有 metadata 能证明它是对的。
#   B) 与 C 的层集合对比 —— 必须是**同一批模块名**，否则两个方法约束的不是同一批层。
#   C) 数值健康 —— F 是平方和，逐元素必须 >= 0；NaN/Inf；以及"零元素比例"
#      （F=0 的权重在 EWC 下完全不受约束，这个比例太高说明 20k 行不够）。
#   D) 估计量健康 —— ESS / length_exponent / zero_supervision_rows。
#      这三个数决定 F 是不是真的建立在 20000 条上，而不是被少数长答案主导。
#   E) λ 起点 —— 1/mean。EWC 的 λ 和 onereplay 的 λ 不可比，必须独立 sweep。
# ===========================================================================
echo ""
echo "==== Step 2: 诊断 ===="
python - "${FISHER_PATH}" "${COV_PATH}" "${POOL_HASH}" "${MAXLEN}" "${TARGET_MODULES}" \
  "${IF_RUN}" "${IF_CKPT}" "${POOL_FP_ROWS}" <<'PY'
import json
import math
import sys
from collections import defaultdict
from pathlib import Path

import torch

(
    fisher_path,
    cov_path,
    want_fp,
    want_max_len,
    want_modules_raw,
    want_model,
    ckpt,
    want_rows,
) = sys.argv[1:9]
want_max_len = int(want_max_len)
want_modules = [item for item in want_modules_raw.split(",") if item]
want_rows = int(want_rows)

payload = torch.load(fisher_path, map_location="cpu")
fishers = payload["fishers"]
meta = payload.get("metadata", {})
counts = payload.get("counts", {})

problems: list[str] = []

# ---------------------------------------------------------------- A) metadata
print("[A] metadata 自检")
print(f"  estimator          : {meta.get('estimator')}")
print(f"  loss_reduction     : {meta.get('loss_reduction')}   supervision: {meta.get('supervision')}")
print(f"  per_example_backward: {meta.get('per_example_backward')}")
print(f"  num_examples (N)   : {meta.get('num_examples')}")
print(f"  model_name         : {meta.get('model_name')}")
print(f"  pool_fingerprint   : {meta.get('pool_fingerprint')}")
print(f"  max_len / trunc    : {meta.get('max_len')} / {meta.get('truncation_side')}")
print(f"  use_bf16           : {meta.get('use_bf16')}")
print(f"  target_modules     : {','.join(meta.get('target_modules', []))}")

if meta.get("per_example_backward") is not True:
    problems.append(
        "per_example_backward 不是 True —— 对 batch 求和的梯度再平方算的是 (Σg)²，"
        "不是 Σg²，那不是 Fisher"
    )
if str(meta.get("model_name", "")) != want_model:
    problems.append(f"model_name={meta.get('model_name')} != 本作业的基座 {want_model}")
if str(meta.get("pool_fingerprint", "")) != want_fp:
    problems.append(
        f"pool_fingerprint={meta.get('pool_fingerprint')} != Step 0 算的 {want_fp}"
    )
if int(meta.get("max_len", -1)) != want_max_len:
    problems.append(f"max_len={meta.get('max_len')} != {want_max_len}")
if str(meta.get("truncation_side", "")) != "left":
    problems.append(
        f"truncation_side={meta.get('truncation_side')} != left。右截断先切答案，"
        "被切干净的行 supervised token 数为 0、贡献 0，会静默稀释 F"
    )
if int(meta.get("use_bf16", -1)) != 0:
    problems.append("use_bf16 != 0：梯度被舍入到 8 位尾数才平方，F 带约 1% 噪声底")
if int(meta.get("num_examples", 0)) != want_rows:
    problems.append(
        f"N={meta.get('num_examples')} != 池行数 {want_rows}。F 和 C 必须吃同样多的行"
    )

# ------------------------------------------------------- B) 层集合 vs C
print("\n[B] 层覆盖")
num_layers = int(json.loads((Path(ckpt) / "config.json").read_text())["num_hidden_layers"])
expected = sum(1 if item == "lm_head" else num_layers for item in want_modules)
print(f"  模块数             : {len(fishers)}  (期望 {expected} = "
      f"{num_layers} 层 x {len([m for m in want_modules if m != 'lm_head'])}"
      + (" + lm_head" if "lm_head" in want_modules else "") + ")")
if len(fishers) != expected:
    problems.append(
        f"模块数 {len(fishers)} != 期望 {expected}。--target_modules 里某个名字"
        "在这个模型上没命中（find_target_linear_module_names 是后缀匹配）"
    )

families: dict[str, list[str]] = defaultdict(list)
for name in fishers:
    families[name.split(".")[-1]].append(name)
for family in sorted(families):
    shapes = {tuple(fishers[name].shape) for name in families[family]}
    print(f"    {family:<12} {len(families[family]):>4} 个   shape={sorted(shapes)}")

if Path(cov_path).is_file():
    cov_keys = set(torch.load(cov_path, map_location="cpu")["covariances"])
    fisher_keys = set(fishers)
    if cov_keys == fisher_keys:
        print(f"  与 C 的层集合     : 完全一致（{len(cov_keys)} 个模块）ok")
    else:
        only_c = sorted(cov_keys - fisher_keys)[:5]
        only_f = sorted(fisher_keys - cov_keys)[:5]
        problems.append(
            f"F 和 C 的层集合不同。只有 C 有: {only_c}；只有 F 有: {only_f}。"
            "两个方法必须约束同一批层，否则比较的是覆盖范围而不是权重矩阵"
        )
else:
    print(f"  与 C 的层集合     : 跳过（{cov_path} 不存在）")

# -------------------------------------------------------- C) 数值健康
print("\n[C] 数值健康")
total_elements = sum(matrix.numel() for matrix in fishers.values())
bad_finite: list[str] = []
negative: list[str] = []
zero_elements = 0
family_mean: dict[str, list[float]] = defaultdict(list)
global_max = 0.0
weighted_sum = 0.0
for name, matrix in fishers.items():
    matrix = matrix.float()
    if not torch.isfinite(matrix).all():
        bad_finite.append(name)
        continue
    minimum = float(matrix.min())
    if minimum < 0.0:
        negative.append(f"{name}({minimum:.3e})")
    zero_elements += int((matrix == 0).sum())
    weighted_sum += float(matrix.sum())
    global_max = max(global_max, float(matrix.max()))
    family_mean[name.split(".")[-1]].append(float(matrix.mean()))

mean_magnitude = weighted_sum / max(total_elements, 1)
print(f"  元素总数           : {total_elements / 1e9:.3f}G "
      f"({total_elements * 4 / 1024 ** 3:.2f} GiB fp32)")
print(f"  mean / max         : {mean_magnitude:.4e} / {global_max:.4e}")
print(f"  零元素比例         : {zero_elements / max(total_elements, 1) * 100:.2f}%")
print("    F=0 的权重在 EWC 下完全不受约束。比例很高说明 20k 行没能激活那部分参数。")
if bad_finite:
    problems.append(f"有 NaN/Inf 的层: {bad_finite[:5]}")
if negative:
    problems.append(
        f"有负元素的层: {negative[:5]}。F 是梯度平方的均值，逐元素必然 >= 0，"
        "出负数说明累加过程出了问题"
    )
print("  各家族 mean（量级差异是正常的，梯度尺度本身按层类型分布）:")
for family in sorted(family_mean):
    values = family_mean[family]
    print(f"    {family:<12} {sum(values) / len(values):.4e}")

# ------------------------------------------------------- D) 估计量健康
print("\n[D] 估计量健康")
report = meta.get("length_weighting", {})
if report:
    print(json.dumps(report, indent=2, ensure_ascii=False))
    examples = float(report.get("examples", 0) or 0)
    ess = float(report.get("effective_sample_size", 0) or 0)
    ess_ratio = float(report.get("ess_ratio", 0) or 0)
    zero_rows = float(report.get("zero_supervision_rows", 0) or 0)
    exponent = float(report.get("length_exponent", float("nan")))
    print()
    print(f"  ESS = {ess:.0f} / {examples:.0f}  ({ess_ratio:.3f})")
    print("    「F 实际建立在多少条样本上」。ESS 远小于 N 意味着少数长答案主导了估计，")
    print("    那 F 描述的就不是这 20k 行的平均敏感度，而是那几条的。")
    if ess_ratio < 0.05:
        problems.append(
            f"ess_ratio={ess_ratio:.3f} < 0.05：F 几乎只由 {ess:.0f} 条样本决定。"
            "EWC 的对照仍然能跑，但要在报告里写明这件事"
        )
    print(f"  zero_supervision_rows = {zero_rows:.0f}")
    print("    这些行没有任何被监督的 token，贡献 0 但仍计入 N（add_empty）。")
    print("    左截断下应当接近 0；数值明显不为 0 说明 targets 里有空值或截断口径不对。")
    if zero_rows > 0.01 * max(examples, 1.0):
        problems.append(
            f"zero_supervision_rows={zero_rows:.0f} 超过 1% 的行没有监督 token，"
            "F 被静默稀释了这么多"
        )
    if not math.isnan(exponent):
        print(f"  length_exponent = {exponent:.3f}")
        print("    ||g_n||² ~ T_n^a 的拟合指数。逐 token 梯度互不相关给 a=1，")
        print("    完全对齐给 a=2。落在 1-2 之间是正常的；明显超出 2 值得回头看数据。")
else:
    problems.append("metadata 里没有 length_weighting，无法判断估计量是否健康")

if meta.get("prompt_prefix_mismatches"):
    print(f"\n  prompt_prefix_mismatches = {meta['prompt_prefix_mismatches']}")
    print("    这些行的 prompt 渲染不是完整渲染的干净 token 前缀，mask 退化到共同前缀。")
    print("    少量正常（chat template 的边界 token）；成千上万条就要查 template 了。")

counts_values = set(counts.values())
if len(counts_values) > 1:
    problems.append(f"各层的 example 计数不一致: {sorted(counts_values)[:5]}")

# ---------------------------------------------------------- E) λ 起点
print("\n[E] EWC 的 λ 起点")
print(f"  F 的 mean = {mean_magnitude:.4e}  ->  1/mean = {1.0 / max(mean_magnitude, 1e-30):.4e}")
print("  从这个量级起，按十倍一档往两边扩。")
print("  **不要借用 onereplay 的 λ**：F 是梯度平方、C 是激活二阶矩，量级差好几个数量级。")
print("  train.py 的 --regularizer help 原话: the two scales are not comparable and")
print("  need separate sweeps。EWC 臂要自己跑一遍 lambda_probe。")

print()
if problems:
    print("=" * 72)
    for item in problems:
        print(f"!! {item}")
    print("=" * 72)
    raise SystemExit("诊断未通过")
print("诊断全部通过。")
PY

FISHER_SIZE="$(du -h "${FISHER_PATH}" | cut -f1)"
echo ""
echo "========================================================================"
cat <<SUMMARY
产物:
  F_if = ${FISHER_PATH}   (${FISHER_SIZE})
    模型  : ${IF_CKPT}
    池子  : ${POOL_FILE}  (${POOL_FP_ROWS} 行)
    指纹  : ${POOL_HASH}
    scope : ${FISHER_SCOPE}  (${TARGET_MODULES})

现在 Part 2 的三种保护手段共用同一批 20k 旧知识，指纹都是
  ${POOL_HASH}
接到 Stage 2 训练上分别是:
  onereplay  --regularizer onereplay --cov_path ${COV_PATH} --replay_lambda <λ_or>
  ewc        --regularizer ewc --fisher_path ${FISHER_PATH} --replay_lambda <λ_ewc>
  replay     --replay_data_files ${POOL_FILE} --replay_max_len ${MAXLEN}

λ_or 和 λ_ewc 必须**各自独立** sweep，量级不可互借（见上面 [E]）。

EWC 臂的 Stage 2 训练脚本还没写。它和 96 号（onereplay 臂）只差正则那几行，
所以接下来要么给 96 号加一个 ARM=ewc 分支，要么照 96 号复制一份。
SUMMARY
echo "========================================================================"
echo "Job finished at: $(date)"
