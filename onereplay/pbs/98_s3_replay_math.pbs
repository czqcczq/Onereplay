#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N s3_math_rp
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# !! 已被 96 号的 ARM=replay 取代，不要再投这一份 !!
#
# replay 现在是 96/100/103 的第四条臂，和 vanilla / onereplay / ewc 同脚本、同结果树、
# 同一道 check_config_consistency 闸门：
#
#   qsub -v MODE=train,ARM=replay,SOURCE=if onereplay/pbs/96_s3_train_math.pbs
#
# 0.5/0.5 的混合和 ACCUM 翻倍都在那边自动换算（REPLAY_PER_BATCH=BATCH/2，
# --accumulation_size 传 ACCUM*2），所以四条臂每次更新的新任务行数都是 64。
# 本文件只作为那一轮的历史记录保留，下面是它与现行配方的差异：
#
# ---- 以下为旧说明 ----
#
# 这份还停在 Qwen3-1.7B-Base 那一轮。
#
# 改名成 s3_* 只是让它和同阶段的脚本排在一起，**内容没有跟着 96 号一起更新**。
# 与 96_s3_train_math.pbs 的现行配方逐项对照：
#
#             98 号（本文件）        96 号（vanilla/onereplay/ewc 三臂）
#   模型      Qwen3-1.7B-Base        Qwen3-4B-Base
#   BATCH     4                      2
#   ACCUM     128                    64        -> 有效 batch 512 vs 128
#   MAXLEN    4096                   2048
#   EPOCHS    3                      1
#   数据      numina_math_50k        numina_math_100k
#   来源      写死 Model-IF-FLAN     SOURCE=if|cs 可切
#   缺        --lr_scheduler / --warmup_ratio / --decode_stop_on_im_end
#
# 而且它写的是另一棵树（results_part2_if2numina，连模型名都没带），也**没有
# check_config_consistency 闸门**——96 号那三臂之间的配置漂移会在开 GPU 前被拦下，
# 这里不会。照现状投出去，replay 臂的数字和另外三臂不可比，而且没有任何提示。
#
# 要用它就得先对齐上面整张表，并把结果树并进 96 号那棵。
# =============================================================================
# Stage 3 replay 臂: Model-IF --NuminaMath-CoT--> Model-IF-Math，用重放保护 IF
#
#     batch 级严格混合：每个 micro-batch = 2 行 Numina + 2 行 FLAN(20k 池)
#     BATCH=4 与 vanilla / onereplay 一致，ACCUM 从 64 抬到 128
#
# 这是 onereplay 的另一条主要对照。三条臂的差别只在「旧知识怎么用」：
#   onereplay  把 20k 行压成 C = E[x xᵀ]，训练时只算 tr(ΔW C ΔWᵀ)，语料不再碰
#   ewc        把 20k 行压成对角 Fisher，同理
#   replay     **保留语料**，训练时真的再训一遍其中的行
# 三者吃的是同一批 20k 行（同一个 jsonl、同一个池指纹），所以比较的是"怎么用"，
# 不是"用了多少"。
#
# =============================================================================
# 【混合方式的取舍：行占比 vs 损失占比。换 Numina 之后结论变了，两版都留档】
#
# 先说这条臂唯一的陷阱。SFTTrainer.compute_task_loss 返回的是 HF 的 outputs.loss，
# 也就是**整个 micro-batch 的监督 token 池化平均**：
#     loss = (Σ_新任务token CE + Σ_replaytoken CE) / (n_新 + n_replay)
# 所以一行 replay 对梯度的权重是它的 **token 占比**，不是行占比。batch_mix.py 把这
# 件事写在 _mean_supervised_tokens 的 docstring 里：
#     "A row's share of the batch is not its share of the loss ... a batch that is
#      half replay *rows* is half replay *loss* only when both sides have similar
#      answer lengths."
#
# -----------------------------------------------------------------------------
# 【OpenR1 时代：batch 级不可用，只能退到数据级 + BATCH=1】
#
# 那时新任务答案 P50 = 3767 token，FLAN targets P50 = 18 token，长度比约 209:1：
#     1 new + 1 replay 的"行数 1:1"  ->  replay 只占约 0.7% 的损失
# 等于没开。所以上一版退到数据级（--replay_ratio）+ BATCH=1：每个 micro-batch 只有
# 一行，梯度贡献都是 1/ACCUM，于是"损失占比 == 行占比"。代价是行占比封顶在
# pool/train = 20000/45334 = 0.441 -> 30.6%，因为数据级是**追加**，而池子不能扩。
#
# -----------------------------------------------------------------------------
# 【换 NuminaMath-CoT 之后：长度差塌了一个数量级，batch 级重新可用】
#
# Numina 答案 P50 = 351 token（均值约 400），长度比从 209:1 降到约 19.5:1。这改变了
# 取舍，但**没有让 token 池化消失**：
#     行占比 50%  ->  损失占比约 5-7%     （OpenR1 时代是 0.7%）
# 高了一个数量级，但绝不是 50%。本脚本因此选 batch 级 2 新 + 2 旧，理由是：
#   - 行占比能精确配到 50%，数据级封顶 28.8%（池子 20k / 训练 49500）够不着；
#   - batch 级**循环**使用池子，任意比例都到得了，不必扩池（扩池会让 replay 比 C
#     多看旧知识，和 onereplay 的比较就不成立了）；
#   - 严格组成，没有数据级那种 ±4 行的二项波动。
#
# **读结果时必须同时报这两个数**，只说"50% replay"会高估这条臂投入的旧知识。
# BatchMixedReplayLoader.describe() 在训练开头把两个都打出来：
#     replay share of rows=0.5000, of supervised tokens=0.0xxx
# 以那一行的实测值为准，上面的 5-7% 只是按均值估的。
#
# -----------------------------------------------------------------------------
# 【ACCUM 必须从 64 抬到 128】
#
# --batch_size 是 micro-batch 的**总行数**，所以每步只有 BATCH - REPLAY_PER_BATCH = 2
# 行新任务：
#     新任务行数/更新 = (ACCUM / BATCH) x 2 = (128/4) x 2 = 64   ok，与 96 号一致
# ACCUM 留在 64 的话每次更新只有 32 行新任务，这条臂就"少学了新任务"，而
# 「保住了旧能力」和「少学了新任务」在结果表上长得一模一样。Step 0 会算并断言。
#
# -----------------------------------------------------------------------------
# 【开销：epoch 墙钟约是 96 号的 2 倍，排 walltime 时别忘了】
#
# 每步开销与 96 号 vanilla 相近（同样 4 行，批内补齐长度由那 2 行 Numina 决定，2 行
# FLAN 是搭车的），但每步只吃 2 行新任务，所以同样的新任务预算要 2 倍步数：
#     本臂      49500 / 2 = 24750 步/epoch
#     96 号     49500 / 4 = 12375 步/epoch
# 这就是 batch 级相对数据级的真实价格 —— 短的 FLAN 行被补齐到 Numina 的长度，那部分
# 计算是补零。Step 0 会用真实行数把这笔账打出来。
#
# -----------------------------------------------------------------------------
# 【replay_max_len 必须等于 C 的 max_len，不是等于新任务的 max_len】
#
# 1536。理由和 83 号第 78-85 行一样：C 是在 max_len 1536 下采的，replay 若只给 512，
# 它保护的旧知识就**严格少于**罚项编码的旧知识，两条臂比的就不只是"怎么用"了。
# Step 0 会读 C 文件的 metadata.max_len 并硬比对。
# 顺带：截断保留的是**最后** max_len 个 token，所以超长行会丢掉问题、留下答案，
# 把"问答复习"变成"裸续写"。FLAN 在 1536 下 P100 都进得去，这里不是问题。
#
# -----------------------------------------------------------------------------
# 【为什么单独一个文件，而不是给 96 号加 ARM=replay】
#
# 96 号的 vanilla / onereplay / ewc 三条臂共用逐字相同的 BATCH/ACCUM，那是"只改一个
# 变量"的结构保证。replay 臂虽然 BATCH 相同，但 ACCUM 必须从 64 抬到 128（否则每次
# 更新只有 32 行新任务），塞进去就破坏了那个保证，也会让 96 号里"三条臂逐字相同"的
# 注释失真。81(onereplay)/82(ewc)/83(replay) 当年分文件也是同一个理由。
#
# -----------------------------------------------------------------------------
# 【前置】计算节点无外网
#   1) Model-IF-FLAN checkpoint   94 号 MODE=train 的产物（现在是 3 epoch 那一版）
#   2) NuminaMath 数据池          prepare_numina_math.py 的产物，与 96 号同一个目录
#   3) 20k 旧知识池               94 号的 flan_v2_if_50k_replay.jsonl（本臂直接读它）
#   4) C_if                       95 号的产物（只用来对 max_len / 池指纹，不参与训练）
#                                 注意它在 CF_ROOT 下，不在本线的 RESULTS_ROOT 下
#   5) 数学评测集 + IFEval 输入
#
# 【用法】
#   # 先看计划和前置检查，不碰 GPU
#   qsub -v DRY_RUN=1 onereplay/pbs/98_s3_replay_math.pbs
#
#   # 冒烟：70 步，看峰值显存 + describe() 打的那两个占比
#   qsub -v MODE=smoke onereplay/pbs/98_s3_replay_math.pbs
#
#   # 正式训练（步数是 96 号的 2 倍，先看 Step 0 的调度账再定要不要拆作业）
#   qsub -v MODE=train,DO_EVAL=0 onereplay/pbs/98_s3_replay_math.pbs
#
#   # 评测（拆两半，加起来装不进一个 24h）
#   qsub -v MODE=eval,DO_IF=0 onereplay/pbs/98_s3_replay_math.pbs
#   qsub -v MODE=eval,DO_MATH=0 onereplay/pbs/98_s3_replay_math.pbs
#
#   # 便宜地把链路跑通
#   qsub -v MODE=train,MAX_TRAIN_SAMPLES=2000,EPOCHS=1,DO_EVAL=0 \
#     onereplay/pbs/98_s3_replay_math.pbs
#
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id>
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/98_s3_replay_math.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_p2rp_${JOBTAG}}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_p2rp_${JOBTAG}}"
  EXTRA_BIND=""
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_p2rp_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME IF_LINE_ROOT IF_CKPT_DIR IF_LR IF_RUN IF_CKPT
    MATH_DATASET RESULTS_ROOT CF_ROOT DATASET_CACHE METRICS_DIR CKPT_DIR
    POOL_FILE POOL_ROWS_EXPECT COV_PATH COV_SCOPE REQUIRE_COV
    MODE DRY_RUN DO_TRAIN DO_EVAL DO_MATH DO_IF SEED FORCE_TRAIN FORCE_EVAL
    EPOCHS LR BATCH ACCUM MAXLEN VAL_FRAC MAXVAL TARGET_MODULES
    REPLAY_RATIO REPLAY_PER_BATCH REPLAY_MAXLEN REPLAY_POOL_SIZE REPLAY_SAMPLE_SEED
    REPLAY_INPUT_COLUMN REPLAY_TARGET_COLUMN
    SMOKE_STEPS MAX_TRAIN_SAMPLES LOG_EVERY
    GSM8K_DATA MATH500_DATA MATH_MAX_NEW_TOKENS MATH_BATCH
    IFEVAL_INPUT MAX_NEW_TOKENS EVAL_BATCH
    FB_DATA FB_CATEGORIES FB_MAX_NEW_TOKENS FB_BATCH FB_GROUP_LIMIT
    EVAL_LIMIT
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e --nv -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv

cd "${REPO_ROOT}"
# ---- Stage 1 / IF 线（94 号）的产物：基座和旧知识池都在这里 ----
IF_LINE_ROOT="${IF_LINE_ROOT:-${REPO_ROOT}/results_part1_if_flanv2}"
IF_CKPT_DIR="${IF_CKPT_DIR:-${IF_LINE_ROOT}/checkpoints}"
# 与 95 号采 C、97 号采 F 读的是同一个文件。这是三条臂"吃同一批旧知识"的物理保证。
POOL_FILE="${POOL_FILE:-${IF_LINE_ROOT}/datasets/flan_v2_if_50k_replay.jsonl}"
POOL_ROWS_EXPECT="${POOL_ROWS_EXPECT:-20000}"

# ---- 新任务池：NuminaMath-CoT 50k，与 96 号读同一个目录，只读不重建 ----
MATH_DATASET="${MATH_DATASET:-${REPO_ROOT}/datasets/numina_math_50k}"

# ---- Part 2 的结果树，与 96 号同一棵（与 OpenR1 那轮分开）----
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_part2_if2numina}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
export HF_DATASETS_CACHE="${DATASET_CACHE}"
METRICS_DIR="${METRICS_DIR:-${RESULTS_ROOT}/metrics}"
CKPT_DIR="${CKPT_DIR:-${RESULTS_ROOT}/checkpoints}"

# ---- C_if / F_if 所在的采集树。95/97 号采的是旧知识 IF 侧，与新任务换不换数据集无关 ----
CF_ROOT="${CF_ROOT:-${REPO_ROOT}/results_part2_if2math}"

# ---- C_if：本臂**不用**它训练，只用它的 metadata 对 max_len 和池指纹 ----
COV_SCOPE="${COV_SCOPE:-full}"
COV_PATH="${COV_PATH:-${CF_ROOT}/cov/cov_if_flanv2_20k_${COV_SCOPE}.pt}"
REQUIRE_COV="${REQUIRE_COV:-1}"

MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B-Base}"

MODE="${MODE:-train}"
DRY_RUN="${DRY_RUN:-0}"
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
DO_MATH="${DO_MATH:-1}"
DO_IF="${DO_IF:-1}"
SEED="${SEED:-1}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"

# ---- 训练超参 ----
# BATCH=4，与 96 号三条臂相同。--batch_size 是 micro-batch 的**总行数**，
# new_per_batch = BATCH - REPLAY_PER_BATCH = 2，所以每步是 2 新 + 2 旧。
BATCH="${BATCH:-4}"
# 128：accum_steps = ACCUM/BATCH = 32，每步 2 行新任务 -> 64 行/更新，与 96 号一致。
# 公式 ACCUM = 64 x BATCH / (BATCH - REPLAY_PER_BATCH)。Step 0 会算并断言。
# 不配平的话这条臂就是"少学了新任务"，而它和"保住了旧能力"在结果表上长得一样。
ACCUM="${ACCUM:-128}"
# 4096：与 96 号同值。Numina 全序列 max=2810，4096 下截断 0 行。
MAXLEN="${MAXLEN:-4096}"
# 3：与 96 号 / 91 号同样的新任务预算，数学分才能并排读。
EPOCHS="${EPOCHS:-3}"
# 必须与 96 号三条臂用同一个值（96 号默认 5e-5）
LR="${LR:-5e-5}"
VAL_FRAC="${VAL_FRAC:-0.01}"
MAXVAL="${MAXVAL:-200}"
TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj,lm_head}"
MAX_TRAIN_SAMPLES="${MAX_TRAIN_SAMPLES:-0}"
LOG_EVERY="${LOG_EVERY:-500}"
SMOKE_STEPS="${SMOKE_STEPS:-70}"

# ---- replay：batch 级严格混合（已从数据级切过来，理由见下）----
# 0 = 关掉数据级混合。train.py 会拒绝同时给 --replay_ratio 和 --replay_per_batch。
REPLAY_RATIO="${REPLAY_RATIO:-0}"
# 2 = 每个 micro-batch 从 BATCH 行里划 2 行给 replay，于是 2 新 + 2 旧，**行占比恰好
# 50%**。数据级做不到这一点：它是追加，上限 = pool/train = 20000/49500 = 0.404，
# 行占比最多 28.8%，而且池子不能扩（扩了 replay 就比 C 多看了旧知识）。batch 级**循环**
# 使用池子，所以任意比例都够得着。
#
# 代价要写清楚，别在读结果时忘了：`outputs.loss` 是 micro-batch 内所有监督 token 的
# 池化平均，所以一行的梯度权重是它的 **token 占比**而不是行占比。FLAN targets P50=18
# （均值约 30），Numina 答案 P50=351（均值约 400），于是
#     行占比 50%  ->  监督 token 占比只有约 5-7%
# 换 Numina 已经把它从 OpenR1 时代的约 0.7% 抬高了一个数量级（长度比 209:1 降到
# 19.5:1），但**它不是 50%**。BatchMixedReplayLoader.describe() 会在启动时把这两个数
# 都打出来（"replay share of rows=... , of supervised tokens=..."），以那个实测值为准。
REPLAY_PER_BATCH="${REPLAY_PER_BATCH:-2}"
# 1536 = C 的 max_len，不是新任务的 4096。Step 0 会和 C 文件硬比对。
REPLAY_MAXLEN="${REPLAY_MAXLEN:-1536}"
# 与 95 号 collect_cov 的 --max_samples 对齐，保证 replay 看到的就是 C 的那批行。
# 池文件本身正好 20000 行，所以这里等于"取全部"。batch 级是循环取用：
# 每 epoch 消耗 steps_per_epoch x 2 = 49500 行，相当于把 20k 池子过 2.5 遍。
# 这是有意的（batch_mix.py 的模块 docstring 写了）：池子必须恰好是产生 C 的那批行，
# 扩池会让 replay 比 C 多看旧知识，比较就不成立了。
REPLAY_POOL_SIZE="${REPLAY_POOL_SIZE:-20000}"
REPLAY_SAMPLE_SEED="${REPLAY_SAMPLE_SEED:-1}"
# gold targets，与 C / F 看到的答案是同一批（本线不做自蒸馏）
REPLAY_INPUT_COLUMN="${REPLAY_INPUT_COLUMN:-inputs}"
REPLAY_TARGET_COLUMN="${REPLAY_TARGET_COLUMN:-targets}"

# ---- 评测：与 96 号同预算 ----
GSM8K_DATA="${GSM8K_DATA:-${REPO_ROOT}/datasets/math/gsm8k_test.jsonl}"
MATH500_DATA="${MATH500_DATA:-${REPO_ROOT}/datasets/math/math500_test.jsonl}"
# 4096：与 96 号同值。Numina 训练答案 P50=351 / max=2666，4096 绰绰有余；8192 是
# OpenR1 时代的遗留，而 91 号实测提到 8192 并没有改善 MATH-500（撞上限的行是陷在
# 重复循环里，任何 cap 都填得满）。
MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS:-4096}"
# 128：与 96 号同值。cap=4096 下 KV cache 0.49 GiB/条，128 占 50%（8192 时代 128 要占
# 92%，所以那时是 96）。完整算术见 91 号同名变量。换 batch 会让贪心输出微小漂移，
# 所以不能各臂各调 —— 要改就四个脚本一起改，且在跑第一个 run 之前改。
MATH_BATCH="${MATH_BATCH:-128}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-1024}"
EVAL_BATCH="${EVAL_BATCH:-32}"
FB_DATA="${FB_DATA:-}"
FB_CATEGORIES="${FB_CATEGORIES:-}"
FB_MAX_NEW_TOKENS="${FB_MAX_NEW_TOKENS:-2048}"
FB_BATCH="${FB_BATCH:-16}"
FB_GROUP_LIMIT="${FB_GROUP_LIMIT:-0}"
EVAL_LIMIT="${EVAL_LIMIT:-0}"

mkdir -p "${METRICS_DIR}" "${CKPT_DIR}" "${DATASET_CACHE}" "${RESULTS_ROOT}/map_cache"

# ===========================================================================
# Step 0: 前置检查
# ===========================================================================
echo "==== Step 0: 前置检查 ===="

# ---- 混合方式与更新预算的硬断言 ----
if (( REPLAY_PER_BATCH < 1 )); then
  echo "REPLAY_PER_BATCH=${REPLAY_PER_BATCH}：本脚本走 batch 级严格混合，要求 >= 1。"
  echo "0 会退回数据级（--replay_ratio），而数据级的行占比上限只有 pool/train ="
  echo "20000/49500 = 0.404 -> 28.8%，到不了 50%。"
  exit 1
fi
if [[ "${REPLAY_RATIO}" != "0" ]]; then
  echo "REPLAY_RATIO=${REPLAY_RATIO}：走 batch 级时它必须是 0。"
  echo "train.py 会拒绝同时收到 --replay_per_batch 和 --replay_ratio（两套混合方案）。"
  exit 1
fi
if (( BATCH <= REPLAY_PER_BATCH )); then
  echo "BATCH=${BATCH} <= REPLAY_PER_BATCH=${REPLAY_PER_BATCH}：没有新任务行了。"
  echo "--batch_size 是 micro-batch 的**总行数**，new_per_batch = BATCH - REPLAY_PER_BATCH。"
  exit 1
fi

# 新任务行数/更新 = (ACCUM / BATCH) x (BATCH - REPLAY_PER_BATCH)，必须等于 96 号的 64。
# batch 级是严格组成，没有二项波动，所以这是精确值而不是期望值。
WANT_NEW_PER_UPDATE="${WANT_NEW_PER_UPDATE:-64}"
read -r NEW_PER_BATCH ROW_SHARE NEW_PER_UPDATE WANT_ACCUM <<EOF
$(python - "${BATCH}" "${REPLAY_PER_BATCH}" "${ACCUM}" "${WANT_NEW_PER_UPDATE}" <<'PY'
import sys

batch, per_batch, accum, want = (int(value) for value in sys.argv[1:5])
new_per_batch = batch - per_batch
row_share = per_batch / batch
new_per_update = (accum // batch) * new_per_batch
print(f"{new_per_batch} {row_share:.4f} {new_per_update} {want * batch // new_per_batch}")
PY
)
EOF
echo "混合方式           : batch 级严格组成（--replay_per_batch ${REPLAY_PER_BATCH}）"
echo "  micro-batch      : ${NEW_PER_BATCH} 新 + ${REPLAY_PER_BATCH} 旧 = ${BATCH} 行"
echo "  replay 行占比    : ${ROW_SHARE}  (严格值，不是期望值)"
echo "  replay 损失占比  : **远低于行占比**，约 5-7%"
echo "                     loss 按监督 token 池化平均，FLAN targets 均值约 30 token、"
echo "                     Numina 答案均值约 400。启动时 describe() 打的"
echo "                     'of supervised tokens=' 才是实测值，以它为准。"
echo "  新任务行数/更新  : ${NEW_PER_UPDATE} (96 号三条臂是 ${WANT_NEW_PER_UPDATE})"
if (( NEW_PER_UPDATE != WANT_NEW_PER_UPDATE )); then
  echo ""
  echo "!! ACCUM=${ACCUM} 与 BATCH=${BATCH}/REPLAY_PER_BATCH=${REPLAY_PER_BATCH} 不配平。"
  echo "   新任务行数/更新 = (ACCUM/BATCH) x (BATCH-REPLAY_PER_BATCH) = ${NEW_PER_UPDATE}，"
  echo "   而 96 号的 vanilla / onereplay / ewc 是 ${WANT_NEW_PER_UPDATE}。"
  echo "   把 ACCUM 调到 ${WANT_ACCUM}。"
  echo "   不配平的话这条臂就是'少学了新任务'，而它和'保住了旧能力'在结果表上一样。"
  exit 1
fi

# ---- 解析 Stage 1 checkpoint（与 95/96/97 号同一套逻辑）----
if [[ -z "${IF_CKPT:-}" ]]; then
  if [[ -n "${IF_LR:-}" ]]; then
    IF_RUN="${IF_RUN:-part1_if_flanv2_lr${IF_LR}_seed${SEED}}"
    IF_CKPT="${IF_CKPT_DIR}/${IF_RUN}"
  else
    mapfile -t _CANDS < <(
      find "${IF_CKPT_DIR}" -maxdepth 1 -mindepth 1 -type d \
        -name "part1_if_flanv2_lr*_seed${SEED}" 2>/dev/null | sort
    )
    if (( ${#_CANDS[@]} == 0 )); then
      echo "在 ${IF_CKPT_DIR} 下找不到 part1_if_flanv2_lr*_seed${SEED}"
      echo "先跑 94 号 MODE=train，或传 IF_CKPT=/abs/path"
      exit 1
    fi
    if (( ${#_CANDS[@]} > 1 )); then
      echo "命中多个 Stage 1 checkpoint，必须显式选一个（要与 96 号用的同一个）:"
      for _c in "${_CANDS[@]}"; do echo "  ${_c}"; done
      exit 1
    fi
    IF_CKPT="${_CANDS[0]}"
    IF_RUN="$(basename "${IF_CKPT}")"
  fi
fi
IF_RUN="${IF_RUN:-$(basename "${IF_CKPT}")}"
[[ -d "${IF_CKPT}" ]] || { echo "缺 Stage 1 checkpoint（基座）: ${IF_CKPT}"; exit 1; }
[[ -f "${IF_CKPT}/config.json" ]] || { echo "${IF_CKPT} 不是可加载的模型目录"; exit 1; }

RUN="s3_math_replay_lr${LR}_rb${REPLAY_PER_BATCH}_seed${SEED}"
CKPT="${CKPT_DIR}/${RUN}"

# ---- 新任务池 ----
if [[ "${MODE}" != "eval" ]]; then
  [[ -d "${MATH_DATASET}" ]] || {
    echo "缺 NuminaMath 池: ${MATH_DATASET}（prepare_numina_math.py 的产物，本线不重建）"
    exit 1
  }
fi

# ---- batch 级的调度账：步数、池子循环次数、墙钟相对 96 号的倍数 ----
# 容量在 batch 级不是约束（池子循环取用），所以这里不拦，只是把几个容易被忽略的
# 后果先算出来 —— 尤其是 steps/epoch 翻倍，它直接决定 walltime 够不够。
if [[ "${MODE}" != "eval" ]]; then
  python - "${MATH_DATASET}" "${VAL_FRAC}" "${POOL_ROWS_EXPECT}" \
           "${BATCH}" "${REPLAY_PER_BATCH}" "${EPOCHS}" <<'PY'
import sys

from datasets import load_from_disk

path, val_frac = sys.argv[1], float(sys.argv[2])
pool_rows, batch, per_batch, epochs = (int(value) for value in sys.argv[3:7])
new_per_batch = batch - per_batch

dataset = load_from_disk(path)
if hasattr(dataset, "keys"):
    dataset = dataset["train"] if "train" in dataset else dataset[list(dataset.keys())[0]]
total = len(dataset)
# train.py 先切 validation 再交给 loader，所以分母是切完之后的行数。
val_rows = round(total * val_frac)
train_rows = total - val_rows

# BatchMixedReplayLoader: steps_per_epoch = len(new) // new_per_batch，尾巴丢掉。
steps = train_rows // new_per_batch
dropped = train_rows - steps * new_per_batch
replay_rows = steps * per_batch

print(f"新任务池           : {total} 行 -> val {val_rows} / train {train_rows}")
print(f"  micro-batch      : {new_per_batch} 新 + {per_batch} 旧")
print(f"  steps/epoch      : {steps}（丢掉尾部 {dropped} 行，不足一个 micro-batch）")
print(f"  replay 行/epoch  : {replay_rows}，池子 {pool_rows} 行 "
      f"-> 循环 {replay_rows / pool_rows:.2f} 遍/epoch")
print("    循环是有意的：池子必须恰好是产生 C 的那 20k 行，扩池会让 replay 比 C")
print("    多看旧知识，和 onereplay 的比较就不成立了。")
# 96 号 vanilla 每步吃 batch 行新任务，本臂每步只吃 new_per_batch 行 —— 同样的
# 新任务预算下步数是它的 batch/new_per_batch 倍，而每步开销相近（批内补齐长度由
# 长的 Numina 行决定）。这是 batch 级混合真正的价格。
print(f"  墙钟             : 约为 96 号同 epoch 数的 {batch / new_per_batch:.1f} 倍 "
      f"({steps} 步 vs {train_rows // batch} 步)")
print(f"  {epochs} epoch 合计 : {steps * epochs} 步 —— 对着 walltime 核一遍再投")
PY
fi

# ---- 旧知识池 ----
if [[ "${MODE}" != "eval" ]]; then
  [[ -f "${POOL_FILE}" ]] || {
    echo "缺 20k 旧知识池: ${POOL_FILE}（94 号 MODE=data 的产物）"
    exit 1
  }
  POOL_ROWS_ACTUAL="$(wc -l < "${POOL_FILE}")"
  echo "旧知识池           : ${POOL_FILE}"
  echo "  行数             : ${POOL_ROWS_ACTUAL} (期望 ${POOL_ROWS_EXPECT})"
  if [[ "${POOL_ROWS_ACTUAL}" != "${POOL_ROWS_EXPECT}" ]]; then
    echo "行数与期望不符 —— 这会让 replay 和 C/F 不同池，三条臂的对照直接失效。"
    echo "确认这就是 95/97 号用过的那个池的话，传 POOL_ROWS_EXPECT=${POOL_ROWS_ACTUAL}。"
    exit 1
  fi

  # 池指纹：与 95/97 号同参重算，用来和 C 文件里记的对比。
  POOL_FP="$(python -m onereplay.scripts.check_old_knowledge_pool \
    --data_files "${POOL_FILE}" --dataset_split train \
    --cache_dir "${DATASET_CACHE}" --streaming 0 \
    --input_column "${REPLAY_INPUT_COLUMN}" --target_column "${REPLAY_TARGET_COLUMN}" \
    --require_target 1 \
    --max_samples 0 --sample_shuffle 0 --sample_seed "${REPLAY_SAMPLE_SEED}" \
    --label if_flanv2_20k | tail -n 1)"
  echo "${POOL_FP}"
  POOL_HASH="${POOL_FP##*fingerprint=}"

  # ---- 与 C 的一致性：max_len 和池指纹 ----
  # 本臂不用 C 训练，但两条臂必须"从同样多的旧知识里保护"。C 在 1536 下采的，
  # replay 若给 512 就是保护了严格更少的旧知识（83 号第 78-85 行同一个道理）。
  if [[ -f "${COV_PATH}" ]]; then
    python - "${COV_PATH}" "${IF_RUN}" "${POOL_HASH}" "${REPLAY_MAXLEN}" <<'PY'
import sys

import torch

cov_path, want_model, want_fp, want_replay_max_len = sys.argv[1:5]
want_replay_max_len = int(want_replay_max_len)

meta = torch.load(cov_path, map_location="cpu").get("metadata", {})
print(f"C_if 的口径: {cov_path}")
bad = []
for label, got, want in (
    ("model_name", str(meta.get("model_name", "")), want_model),
    ("pool_fingerprint", str(meta.get("pool_fingerprint", "")), want_fp),
    ("max_len vs replay_max_len", int(meta.get("max_len", -1)), want_replay_max_len),
):
    flag = "ok" if got == want else "!! 不一致"
    print(f"  {label:<26} C={got}")
    print(f"  {'':<26} replay={want}   {flag}")
    if got != want:
        bad.append(label)

if bad:
    raise SystemExit(
        f"\n!! 与 C 不一致的项: {', '.join(bad)}\n"
        "replay 与 onereplay 的对照要求两者从**同一批、同样长度预算**的旧知识里保护。\n"
        "  model_name 不一致  -> 两条臂的起点权重不是同一个模型\n"
        "  指纹不一致         -> 吃的不是同一批 20k 行\n"
        "  max_len 不一致     -> replay 看到的旧知识严格少于/多于罚项编码的\n"
        "改本作业的参数，或重采 C。"
    )
print("与 C 的口径一致（同模型、同池、同 max_len）：ok")
PY
  elif [[ "${REQUIRE_COV}" == "1" ]]; then
    echo "缺 C_if: ${COV_PATH}"
    echo "本臂不用 C 训练，但默认要求它存在以对齐 max_len 和池指纹。"
    echo "只想单独跑 replay 基线的话传 REQUIRE_COV=0。"
    exit 1
  else
    echo "!! REQUIRE_COV=0：跳过与 C 的一致性检查。池指纹 = ${POOL_HASH}"
  fi
fi

echo ""
echo "========================================================================"
echo "Part 2 replay 臂: Model-IF-FLAN --NuminaMath-CoT--> Model-IF-Math"
echo "  基座           : ${IF_CKPT}"
echo "  新任务池       : ${MATH_DATASET}"
echo "  旧知识池       : ${POOL_FILE:-(eval 模式不读)}"
echo "                   ${REPLAY_TARGET_COLUMN} 列（gold），pool_size=${REPLAY_POOL_SIZE}"
echo "  混合           : batch 级 --replay_per_batch ${REPLAY_PER_BATCH}"
echo "                   ${NEW_PER_BATCH} 新 + ${REPLAY_PER_BATCH} 旧，行占比 ${ROW_SHARE}（严格值）"
echo "                   损失占比远低于此（token 池化平均），看日志 describe() 的实测"
echo "  超参           : epochs=${EPOCHS} lr=${LR} batch=${BATCH} accum=${ACCUM}"
echo "                   maxlen=${MAXLEN} replay_max_len=${REPLAY_MAXLEN}"
echo "                   新任务行数/更新 = ${NEW_PER_UPDATE}（与 96 号的 ${WANT_NEW_PER_UPDATE} 一致）"
echo "  预计训练时长   : 约为 96 号的 2 倍（步数翻倍，上面的调度账里有实算）"
echo "  run 名         : ${RUN}"
echo "========================================================================"
if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只做前置检查，不训练不评测。"
  echo "Job finished at: $(date)"
  exit 0
fi
# =============================================================================
# 训练封装
#
# 与 96 号的 train_one 相比只多了 replay 那一段，且**没有任何正则参数** ——
# 本臂靠真的再训旧数据来保护，不靠罚项。--replay_lambda 0
# --measure_replay_when_lambda_zero 0 明确关掉 penalty 路径（否则默认 measure=1
# 会加载 C 并每步求值，这条臂的时间和显存就不是 replay 的了）。
#
#   $1 run  $2 epochs  $3 save_path  $4 max_steps  $5 save  $6 log_every
# =============================================================================
train_one () {
  local run="$1" epochs="$2" save_path="$3"
  local max_steps="${4:-0}" do_save="${5:-1}" log_every="${6:-${LOG_EVERY}}"

  mkdir -p "${RESULTS_ROOT}/map_cache/${run}"
  echo "==== train ${run} (${NEW_PER_BATCH}new+${REPLAY_PER_BATCH}replay lr=${LR} max_steps=${max_steps}) ===="
  # --eval_batch_size 用 BATCH，与 96 号三条臂一致。validation 是纯新任务的
  # （train.py 在混 replay 之前就切好了 val），而 val_loss 是按 batch 平均的，所以
  # eval_batch_size 不同会让数值有微小偏移 —— 必须同值，
  # calibrate_lambda 的 matched plasticity 要用到这一点。
  python -m onereplay.scripts.train --paradigm sft --full_finetune 1 \
    --model_dir "${IF_CKPT_DIR}" --model_name "${IF_RUN}" --seed "${SEED}" \
    --dataset_path "${MATH_DATASET}" \
    --epochs "${epochs}" --lr "${LR}" \
    --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
    --max_len "${MAXLEN}" \
    --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" \
    --eval_batch_size "${BATCH}" \
    --max_train_samples "${MAX_TRAIN_SAMPLES}" \
    --target_modules "${TARGET_MODULES}" \
    --map_cache_dir "${RESULTS_ROOT}/map_cache/${run}" \
    --replay_ratio 0 \
    --replay_per_batch "${REPLAY_PER_BATCH}" \
    --replay_data_files "${POOL_FILE}" \
    --replay_input_column "${REPLAY_INPUT_COLUMN}" \
    --replay_target_column "${REPLAY_TARGET_COLUMN}" \
    --replay_pool_size "${REPLAY_POOL_SIZE}" \
    --replay_sample_seed "${REPLAY_SAMPLE_SEED}" \
    --replay_max_len "${REPLAY_MAXLEN}" \
    --replay_lambda 0 --measure_replay_when_lambda_zero 0 \
    --max_steps "${max_steps}" --log_every "${log_every}" \
    --save "${do_save}" --save_path "${save_path}" \
    --metrics_path "${METRICS_DIR}/${run}.jsonl" 2>&1 | tee "${TMPDIR}/${run}.log"

  # ---- 从日志里断言 replay 真的混进去了 ----
  # BatchMixedReplayLoader.describe() 打的是它真正组成的 micro-batch，而不是我们传了
  # 什么。传参与实际不一致（比如池子被过滤空）不会报错，只会静默变成 vanilla。
  local want_mix="batch-level replay: ${NEW_PER_BATCH} new + ${REPLAY_PER_BATCH} replay"
  if ! grep -qF "${want_mix}" "${TMPDIR}/${run}.log"; then
    echo "!! 日志里找不到 batch 级混合那一行:"
    echo "   ${want_mix}"
    echo "   replay 可能根本没混进去 —— 这条臂就退化成 vanilla 了。"
    grep -iF "replay" "${TMPDIR}/${run}.log" | head -n 20 || true
    return 1
  fi
  # 数据级不该出现：两套方案只能开一个，同时开 train.py 会抛错，但万一默认值漂了
  # 就会静默走成另一条路，行占比也就不是 50% 了。
  if grep -qE "replay: [0-9]+ new-task \+ [0-9]+ replay = [0-9]+ rows" "${TMPDIR}/${run}.log"; then
    echo "!! 日志里出现了数据级混合 —— --replay_ratio 没关掉。"
    echo "   数据级的行占比上限只有 28.8%，不是本臂要的 50%。"
    return 1
  fi
  local want_rlen="replay pool: tokenizing at max_len=${REPLAY_MAXLEN} (new task stays at ${MAXLEN})"
  if ! grep -qF "${want_rlen}" "${TMPDIR}/${run}.log"; then
    echo "!! 日志里找不到 replay 的 max_len 那一行:"
    echo "   ${want_rlen}"
    grep -F "replay pool" "${TMPDIR}/${run}.log" || true
    return 1
  fi
  echo "batch 级混合与 replay_max_len 与传参一致：ok"
  echo "---- 实际的组成与两个占比 ----"
  # 这一行是本臂最重要的输出：行占比是 0.50，token 占比才是 replay 真正拿到的权重。
  grep -F "replay share of rows" "${TMPDIR}/${run}.log" || true
  grep -F "batch-level replay:" "${TMPDIR}/${run}.log" || true
  grep -F "pool[" "${TMPDIR}/${run}.log" || true
  grep -F "replay targets:" "${TMPDIR}/${run}.log" || true
}

# =============================================================================
# MODE=smoke：70 步、不保存。这条臂的冒烟要盯三件事：
#
#   1) **峰值显存**。micro-batch 仍是 4 行，但其中 2 行是 FLAN@1536，而 collate 补齐
#      到批内最长，长度由 Numina 那 2 行决定 —— 所以峰值应当**略低于** 96 号 vanilla
#      的同批次值，且没有 C 的 6.58 GiB 和 W0 的 3.20 GiB。明显更高就是哪里配错了。
#   2) **每步时间**应当与 96 号 vanilla 接近（同样 4 行、同样的批内长度上界）。
#      但 steps/epoch 是它的 2 倍（49500/2 = 24750 对 49500/4 = 12375），因为每步只
#      吃 2 行新任务 —— **本臂的 epoch 墙钟约是 96 号的 2 倍**，排 walltime 时按这个算。
#   3) **两个占比那一行**真的出现了（train_one 里已经断言）。重点看
#      "of supervised tokens="：行占比 0.50 是配出来的，token 占比才是 replay 实际
#      拿到的梯度权重，预期约 0.05-0.07。
# =============================================================================
if [[ "${MODE}" == "smoke" ]]; then
  train_one "smoke_p2_replay" 1 "${CKPT_DIR}/smoke_p2_replay" "${SMOKE_STEPS}" 0 10

  echo ""
  echo "==== 冒烟自检 ===="
  python - "${METRICS_DIR}/smoke_p2_replay.jsonl" "${REPLAY_MAXLEN}" \
           "${REPLAY_PER_BATCH}" "${WANT_NEW_PER_UPDATE}" <<'PY'
import json
import sys

path = sys.argv[1]
want_rlen, want_per_batch, want_new = (int(value) for value in sys.argv[2:5])
rows = [
    json.loads(line)
    for line in open(path, encoding="utf-8").read().splitlines()
    if line.strip()
]
epochs = [row for row in rows if row.get("record_type") == "epoch"]
if not epochs:
    raise SystemExit("缺 epoch 记录，冒烟没跑完")
last = epochs[-1]

for key, label, fmt in (
    ("train_task_loss", "task_loss", "{:.6f}"),
    ("tokens_per_sec", "tokens/s", "{:.0f}"),
    ("sec_per_step", "sec/step", "{:.3f}"),
    ("covariance_memory_gb", "C 常驻 GiB", "{:.2f}"),
    ("reference_memory_gb", "W0 常驻 GiB", "{:.2f}"),
):
    value = last.get(key)
    print(f"  {label:<16}{fmt.format(value) if isinstance(value, (int, float)) else '-'}")
for key in sorted(k for k in last if "peak" in k and "memory" in k):
    print(f"  {key:<16}{last[key]}")

problems = []
if last.get("covariance_memory_gb"):
    problems.append(
        f"这条臂常驻了 {last['covariance_memory_gb']:.2f} GiB 的 C —— "
        "--measure_replay_when_lambda_zero 0 没生效。replay 臂不该加载任何 penalty 矩阵。"
    )
if not last.get("replay_per_batch"):
    problems.append(
        f"metrics 里 replay_per_batch={last.get('replay_per_batch')}，应当是 {want_per_batch}。"
        "为 0 说明走回了数据级混合，行占比到不了 50%。"
    )
elif int(last["replay_per_batch"]) != want_per_batch:
    problems.append(
        f"metrics 里 replay_per_batch={last['replay_per_batch']} != {want_per_batch}"
    )
if last.get("replay_ratio"):
    problems.append(
        f"metrics 里 replay_ratio={last['replay_ratio']}，应当是 0（两套混合只能开一个）。"
    )
if last.get("new_per_update") is not None and int(last["new_per_update"]) != want_new:
    problems.append(
        f"metrics 里 new_per_update={last['new_per_update']} != {want_new}（96 号的值）。"
        "少学新任务和保住旧能力在结果表上长得一样，不能放过。"
    )
if last.get("replay_max_len") is not None and int(last["replay_max_len"]) != want_rlen:
    problems.append(f"metrics 里 replay_max_len={last['replay_max_len']} != {want_rlen}")

print()
if problems:
    for item in problems:
        print(f"!! {item}")
    raise SystemExit("冒烟自检未通过")
print("冒烟自检通过。")
print("接下来人工对两个数:")
print("  peak memory  应**略低于** 96 号 vanilla 的同批次值：micro-batch 同为 4 行，")
print("               但有 2 行是短的 FLAN，且本臂不加载任何 penalty 矩阵")
print("               （没有 C 的 6.58 GiB、没有 W0 的 3.20 GiB）。明显更高就查配置。")
print("  sec/step     应与 96 号 vanilla 接近（同样 4 行、批内长度上界由 Numina 行决定）。")
print("               别拿它当省时间的信号：本臂每步只吃 2 行新任务，步数是 96 号的")
print("               2 倍，epoch 墙钟因此也是 2 倍。")
print("  日志开头的 'replay share of rows=..., of supervised tokens=...' 要抄进结果表。")
print("               rows 是 0.50，tokens 预期约 0.05-0.07 —— 后者才是 replay 的实际权重。")
PY
  exit 0
fi

# =============================================================================
# MODE=train
# =============================================================================
if [[ "${MODE}" == "train" && "${DO_TRAIN}" == "1" ]]; then
  if [[ -d "${CKPT}" && "${FORCE_TRAIN}" != "1" ]]; then
    echo "跳过训练：${CKPT} 已存在（FORCE_TRAIN=1 可强制重训）"
  else
    train_one "${RUN}" "${EPOCHS}" "${CKPT}" 0 1 "${LOG_EVERY}"

    echo ""
    echo "==== 训练自检: ${RUN} ===="
    python - "${METRICS_DIR}/${RUN}.jsonl" "${NEW_PER_UPDATE}" <<'PY'
import json
import sys

path, new_per_update = sys.argv[1], int(sys.argv[2])
rows = [
    json.loads(line)
    for line in open(path, encoding="utf-8").read().splitlines()
    if line.strip()
]
epochs = [row for row in rows if row.get("record_type") == "epoch"]
if not epochs:
    raise SystemExit(f"{path} 里没有 epoch 记录，训练没跑完")

print(f"{'epoch':>6}{'task_loss':>13}{'val_loss':>12}{'tok/s':>10}{'sec/step':>10}")
for row in epochs:
    print(
        f"{row['epoch']:>6}{row['train_task_loss']:>13.6f}"
        + (f"{row['val_loss']:>12.6f}" if row.get("val_loss") is not None else f"{'-':>12}")
        + f"{row.get('tokens_per_sec', 0):>10.0f}{row.get('sec_per_step', 0):>10.3f}"
    )

problems = []
last = epochs[-1]
if last.get("covariance_memory_gb"):
    problems.append("replay 臂常驻了 C，penalty 路径没关干净")
print()
print("注意 val_loss 是**纯新任务**的（train.py 在混 replay 之前就切好了 val），")
print("所以它和 96 号三条臂逐字可比 —— calibrate_lambda 的 matched plasticity 用得上它。")
print(f"每次更新的新任务行数是 {new_per_update}，与 96 号的 64 一致（Step 0 已断言）。")
print("batch 级是严格组成，没有二项波动：每一步都恰好是 2 新 + 2 旧。")
print("但 replay 的**损失**占比不是 0.50 —— loss 按监督 token 池化平均，看训练日志")
print("开头 describe() 打的 'of supervised tokens='，那才是 replay 真正的梯度权重。")
if problems:
    for item in problems:
        print(f"!! {item}")
    raise SystemExit("训练自检未通过")
print("训练自检通过。")
PY
  fi
  echo ""
  echo "checkpoint 是完整权重目录: --model_dir ${CKPT_DIR} --model_name ${RUN}"
fi
# =============================================================================
# MODE=eval：与 96 号同一套预算、同一个结果树，所以汇总表能把四行放在一起读
#   if_anchor / vanilla / onereplay / replay
# =============================================================================
if [[ "${MODE}" == "eval" || ( "${MODE}" == "train" && "${DO_EVAL}" == "1" ) ]]; then
  METRICS=""
  if [[ "${DO_MATH}" == "1" ]]; then
    if [[ -f "${GSM8K_DATA}" ]]; then METRICS="${METRICS},gsm8k"; else echo "跳过 GSM8K：缺 ${GSM8K_DATA}"; fi
    if [[ -f "${MATH500_DATA}" ]]; then METRICS="${METRICS},math500"; else echo "跳过 MATH-500：缺 ${MATH500_DATA}"; fi
  fi
  if [[ "${DO_IF}" == "1" ]]; then
    if [[ -f "${IFEVAL_INPUT}" ]]; then METRICS="${METRICS},ifeval"; else echo "跳过 IFEval：缺 ${IFEVAL_INPUT}"; fi
    METRICS="${METRICS},followbench"
  fi
  METRICS="${METRICS#,}"
  [[ -n "${METRICS}" ]] || { echo "没有可用指标（DO_MATH/DO_IF 都关了？）"; exit 1; }

  if [[ ! -d "${CKPT}" ]]; then
    echo "跳过评测：checkpoint 不存在 ${CKPT}（先跑 MODE=train）"
  else
    pending=0
    for m in ${METRICS//,/ }; do
      [[ -f "${RESULTS_ROOT}/${m}/${RUN}/summary.json" ]] || pending=1
    done
    if [[ "${pending}" == "0" && "${FORCE_EVAL}" != "1" ]]; then
      echo "跳过评测 ${RUN}：${METRICS} 都已有 summary（FORCE_EVAL=1 强制重评）"
    else
      fb_data_arg=(); fb_cats_arg=()
      [[ -n "${FB_DATA}" ]] && fb_data_arg=(--followbench_data "${FB_DATA}")
      [[ -n "${FB_CATEGORIES}" ]] && fb_cats_arg=(--followbench_categories "${FB_CATEGORIES}")

      echo "==== eval ${RUN} (${METRICS}) ===="
      python -m onereplay.scripts.evaluate \
        --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
        --adapter_path "${CKPT}" --run_name "${RUN}" \
        --metrics "${METRICS}" --out_dir "${RESULTS_ROOT}" --seed "${SEED}" \
        --limit "${EVAL_LIMIT}" \
        --max_new_tokens "${MAX_NEW_TOKENS}" \
        --eval_batch_size "${EVAL_BATCH}" --math_batch_size "${MATH_BATCH}" \
        --gsm8k_data_path "${GSM8K_DATA}" \
        --math500_data_path "${MATH500_DATA}" \
        --math_max_new_tokens "${MATH_MAX_NEW_TOKENS}" \
        --ifeval_input "${IFEVAL_INPUT}" \
        --followbench_max_new_tokens "${FB_MAX_NEW_TOKENS}" \
        --followbench_batch_size "${FB_BATCH}" \
        --followbench_group_limit "${FB_GROUP_LIMIT}" \
        "${fb_data_arg[@]}" "${fb_cats_arg[@]}" \
        --map_cache_dir "${RESULTS_ROOT}/map_cache/eval_seed${SEED}"
    fi
  fi

  # -------------------------------------------------------------------------
  # 汇总：与 96 号同一段代码、同一棵结果树，所以四条臂自动排在一张表里。
  # 每个分数右边紧跟它自己的响应词数中位数（理由见 96 号）。
  # -------------------------------------------------------------------------
  python - "${RESULTS_ROOT}" <<'PY' || true
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
METRICS = ("gsm8k", "math500", "ifeval", "followbench")

names: set[str] = set()
for metric in METRICS:
    directory = root / metric
    if directory.is_dir():
        names.update(path.name for path in directory.iterdir() if path.is_dir())
if not names:
    print("\n没有可汇总的 summary.json")
    raise SystemExit(0)


def sort_key(name: str):
    if name == "if_anchor":
        rank = 0
    elif "vanilla" in name:
        rank = 1
    elif "onereplay" in name:
        rank = 2
    elif "replay" in name:
        rank = 3
    else:
        rank = 4
    return (rank, name)


def load(metric: str, name: str):
    path = root / metric / name / "summary.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else None


def words_p50(metric: str, name: str):
    path = root / metric / name / "responses.jsonl"
    if not path.is_file():
        return None
    counts = []
    with path.open(encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                counts.append(len(str(json.loads(line).get("response", "")).split()))
    if not counts:
        return None
    counts.sort()
    return counts[len(counts) // 2]


def pct(payload, key, width):
    if payload is None or payload.get(key) is None:
        return "-".rjust(width)
    return f"{payload[key] * 100:.1f}".rjust(width)


def num(value, width, fmt="{:.0f}"):
    return ("-" if value is None else fmt.format(value)).rjust(width)


print()
print("=" * 108)
print("Part 2: Model-IF-FLAN --NuminaMath-CoT--> Model-IF-Math   四条臂")
print("  左半 = 新任务学到多少   右半 = 旧能力保留多少   words = 该指标自己的响应词数中位数")
print("=" * 108)
print(f"{'run':<44}{'GSM8K':>8}{'MATH500':>9}{'IFEval':>8}{'words':>7}{'FB HSR':>8}{'words':>7}")
for name in sorted(names, key=sort_key):
    fb = load("followbench", name)
    levels = [fb.get(f"rule_hsr_level_{level}") for level in range(1, 6)] if fb else []
    levels = [value for value in levels if value is not None]
    fb_mean = f"{sum(levels) / len(levels) * 100:.1f}".rjust(8) if levels else "-".rjust(8)
    print(
        f"{name:<44}"
        + pct(load("gsm8k", name), "accuracy", 8)
        + pct(load("math500", name), "accuracy", 9)
        + pct(load("ifeval", name), "strict_prompt_accuracy", 8)
        + num(words_p50("ifeval", name), 7)
        + fb_mean
        + num(words_p50("followbench", name), 7)
    )

print()
print("读 replay 这一行时要同时给出三个附加数字:")
print("  1) **行占比 50%，但损失占比只有约 5-7%**（batch 级 2 新 + 2 旧）。")
print("     行占比是严格配出来的；loss 是 micro-batch 内监督 token 的池化平均，而")
print("     FLAN targets 均值约 30 token、Numina 答案均值约 400，所以 replay 实际拿到")
print("     的梯度权重远小于 50%。以训练日志 describe() 里 'of supervised tokens=' 为准。")
print("     换 Numina 已把它从 OpenR1 时代的约 0.7% 抬高了一个数量级，但它不是 50%：")
print("     报告里写 '50% replay' 会高估这条臂投入的旧知识。")
print("  2) **墙钟约为 96 号的 2 倍**：每步只吃 2 行新任务，同样的新任务预算要 2 倍步数。")
print("     每步开销与 96 号 vanilla 相近，所以这个倍数几乎全部来自步数。")
print("     对比时注意 onereplay 的正则只占约 0.13% 计算 —— 它几乎是免费的。")
print("  3) **常驻显存**：replay 为 0（不存任何矩阵），onereplay 为 C 6.58 GiB +")
print("     W0 3.20 GiB。但 replay 要留着 20k 行语料。这个 trade-off 是两条方法的")
print("     核心区别，和分数一样重要。")
print()
print("**IF 分数升降先看 words 再谈能力**（见 96 号 / results_log 2026-09-12 第 8c 节）。")
print("**FB HSR 只有 rule 那一半**（350/820 行、70/164 组），不要写成 FollowBench 全量分。")
PY
fi

echo ""
echo "========================================================================"
echo "产物:"
echo "  checkpoint : ${CKPT}"
echo "  metrics    : ${METRICS_DIR}/${RUN}.jsonl"
echo "  评测       : ${RESULTS_ROOT}/{gsm8k,math500,ifeval,followbench}/${RUN}/summary.json"
echo ""
echo "Part 2 现在的四条臂（全部共用同一批 20k FLAN 旧知识）:"
echo "  if_anchor                                       Stage 2 的起点（before）"
echo "  s3_math_vanilla_lr${LR}_seed${SEED}                    无保护（遗忘的标尺）"
echo "  s3_math_onereplay_lr${LR}_lam<λ>_seed${SEED}       C_if 罚项"
echo "  ${RUN}   真的重放旧数据"
echo "  (EWC 臂用 97 号采的 F，训练脚本还没写)"
