#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_opctre
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/logs/onereplay/
#
# =============================================================================
# NUS Hopper (PBS + Singularity): OPC-educational 代码线训练 + 评测
#   训 C_mix(if + C_code_opc) 的 OneReplay run -> 跑 HumanEval/MBPP（+可选 IF 侧）
#
# 与 42 号（Magicoder 代码线）逐字同构：训练集仍是 commonsense_170k，超参与 C_if
# 生产 run 完全一致，**唯一变量是 --cov_path**。42 与本脚本之间只差 C_code 的来源
# （Magicoder 广义代码指令  vs  opc-sft-stage2/educational_instruct，后者与 MBPP/
#   HumanEval 同形），因此两条线可以并排读。
#
# -----------------------------------------------------------------------------
# 为什么换到 OPC-educational
#   原设计（42）里保护池是 Magicoder，与 HE/MBPP 只是"同为代码"的弱相关。这一版
#   刻意让保护池与评测集**强相关**：educational_instruct 的题面/函数签名/断言风格与
#   MBPP、HumanEval 高度一致，50 号建池时还把一半改写成 HumanEval 风格 stub。主张是
#   保护方向越贴近评测分布，C_code 收回被 commonsense SFT 破坏的代码能力就越多，
#   pass@1 上应能看到比 Magicoder 线更明显的回收。
#
#   对照列（与 42 一致，便于交叉比较）：
#     base      两端参照
#     vanilla   未保护的另一端（commonsense SFT，无正则）
#     cif       纯 C_if（balanced 那份 adapter，与 42 共用同一个，不重训）
#     cifcode   本脚本新训的 C_if + C_code_opc 等权混合  <- 本线的主角
#
#   读法：cifcode(opc) vs cif 量"OPC 的 C_code 有没有用"；cifcode(opc) vs 42 的
#   cifcode(magicoder) 量"把保护池换成与评测同形的语料，回收是否更强"。
#
# -----------------------------------------------------------------------------
# !! run 名带 _opcedu，绝不能和 42 的 Magicoder adapter 撞名
#   42 的 CODE_MIX_RUN 是 cs_onereplay_ifcode_lam..._regonce（不带 tag）。若本脚本沿用
#   同名，FORCE_TRAIN=0 会因"adapter 已存在"直接跳过训练、评到 Magicoder 的那份模型。
#   所以这里 CODE_RUN/CODE_MIX_RUN 都加 _opcedu 中缀。cif/vanilla 是共享基线，保持原名。
#
# -----------------------------------------------------------------------------
# !! pass@1 的量程注意（同 39/42 号的功效分析）
#   MBPP 500 题的配对可分辨下限约 3.30pp，HumanEval 164 题更差。本线赌的是"强相关
#   保护池能把回收推到量程之上"，但若回收仍小于量程，pass@1 可能测不出显著差异，
#   届时仍需代码 CE 探针（40 号那套思路）当主量具。先看 pass@1 与失败分桶：语法错误
#   那一桶被压回多少，是 CE 之外唯一能给机制解释的证据。
#
# -----------------------------------------------------------------------------
# !! 判分口径（都在 onereplay/eval/code_exec.py）——2026-08-31 修掉两个判错 bug
#   1) 清洗按题型分流。MBPP 走 AST 白名单（保留 import 与所有顶层 def，只丢尾部
#      print / __main__ / 模型自造 assert）；HumanEval 保留函数体缩进，装配时按
#      "哪种缩进能编译"归一化。旧口径两处都反了：在第一个 '\ndef ' 处截断，把以
#      import 开头的 MBPP 程序腰斩；strip() 吃掉函数体首行缩进，把 HumanEval 正解
#      变成 'return' outside function。实测 MBPP 腰斩率 10-31%、HumanEval 去缩进
#      致死率 0.6-16%，足以翻转结论符号。
#   2) 黑名单只拦文件/进程/网络：os、subprocess、socket、requests、urllib、shutil、
#      open(、exec(、eval(、__import__。sys / pathlib / pickle 已放开——执行本身
#      在带超时的子进程里，这三个不构成真实风险。绝对分数仍略低于公开报告值。
#   3) MBPP split 默认 validation（90 题），本脚本显式传 test（500 题）。
#   !! 修复前后的代码结果不可混用。旧 run 用 onereplay/scripts/rejudge_code_eval.py
#      重判：HumanEval 可精确复原（损伤只是首行缩进），MBPP 被腰斩的正文已永久丢失，
#      必须重新生成。修后 responses.jsonl 会同时存 raw，以后改判分不必再重跑。
#
# -----------------------------------------------------------------------------
# 用法（推荐两阶段）:
#   1) 粗扫：每个 λ 只训 200 optimizer steps；HumanEval 全部 164 题、MBPP 前 200 题
#      qsub -v 'SCAN_MODE=1,LAMBDAS=1e-2 2e-2 3e-2 1e-1' \
#        onereplay/pbs/52_opc_code_train_eval.pbs
#      扫描产物带 _scan_ms200 后缀，评测写进 results_limit200，不污染正式结果。
#   2) 从扫描中选 λ（例 3e-2），完整训 3 epoch + 正式评完整 HE/MBPP：
#      qsub -v LAMBDA=3e-2 onereplay/pbs/52_opc_code_train_eval.pbs
#
#   拆两次提交（各自可续跑，训练很久时建议）:
#     只训练:   DO_EVAL=0
#     只评测:   DO_TRAIN=0
#   也训纯 C_code 对照:  TRAIN_KINDS="code mix"
#   固定基线默认只评 cif；方法 run 由 LAMBDAS × TRAIN_KINDS 自动展开
#   顺带出失败分桶:      DO_ANALYZE=1（默认关；也可评完在登录节点单独跑，见文末）
#   补 IF 侧（确认没为了代码牺牲 IF）: WITH_IF=1
#   用 50 号 trace 建议的 λ_mix: LAMBDA=<值>（注意 run 名会随之改变）
#   更快但更噪的粗扫: SCAN_MODE=1 SCAN_MAX_STEPS=100 SCAN_LIMIT=100
#
# 前置条件:
#   1) 50 号已产出 MIX_COV=cov_if_code_opcedu20k_mix_qv.pt（和 CODE_COV，若要训纯 C_code）。
#   2) 代码评测数据就位: ${CODE_DATA_DIR}/humaneval_test.parquet、mbpp_full/
#   3) 训练需要 commonsense_170k: ${CS_DATASET}
#   4) cif 基线 adapter 已在 42/35 号训过（cs_onereplay_balanced_...），本脚本只复用不重训。
#   5) 日志目录先建好: mkdir -p /scratch/weiliu87/logs/onereplay
#
# walltime: 训练一个 run（commonsense170k / 3 epoch）约 10~14h，评测 (164+500) 题
#   约 1~2h/run。两件都做建议拆两次提交。
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/52_opc_code_train_eval.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    # 写成 if 而不是 `[[ -f x ]] && source x && break`：后者在第一个候选不存在时
    # 整条 && 列表返回 1，set -e 会当场把作业干掉（坑 #18）。
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      if [[ -f "${_init}" ]]; then
        source "${_init}"
        break
      fi
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME CS_DATASET RESULTS_ROOT CODE_DATA_DIR OUT_DIR
    DO_TRAIN DO_EVAL FORCE_TRAIN FORCE_EVAL TRAIN_KINDS DO_ANALYZE
    SEED EPOCHS LR BATCH ACCUM MAXLEN VAL_FRAC MAXVAL TARGET_MODULES
    LAMBDA LAMBDAS IF_LAMBDA SCAN_MODE SCAN_MAX_STEPS SCAN_LIMIT MAX_STEPS
    WALLTIME_SEC RESERVE_SEC ESTIMATE_SEC
    IDENTITY_COV REG_ONCE SAVE TAG CODE_COV MIX_COV
    VANILLA_RUN IF_RUN MODELS
    CODE_MAX_NEW_TOKENS TIMEOUT LIMIT MBPP_SPLIT MBPP_CONFIG
    WITH_IF IFEVAL_INPUT MULTIIF_INPUT MULTIIF_LANG MULTIIF_LIMIT
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, torch.__file__, 'cuda', torch.cuda.is_available(), torch.cuda.device_count())"

# ---- 项目路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results}"
CS_DATASET="${CS_DATASET:-${REPO_ROOT}/datasets/commonsense_170k_hf}"
CODE_DATA_DIR="${CODE_DATA_DIR:-${REPO_ROOT}/datasets/code}"
ADAPTERS="${RESULTS_ROOT}/adapters"

# ---- 阶段开关 ----
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"
DO_ANALYZE="${DO_ANALYZE:-0}"        # 后置分析默认不跑，作业只出 pass@1；见文末
# 默认只训 mix：主张只需要 cif vs cifcode 这一组对照，纯 C_code 是可选控制。
TRAIN_KINDS="${TRAIN_KINDS:-mix}"

# ---- 训练超参（与 C_if 生产 run 逐字一致，唯一变量是 C）----
SEED="${SEED:-1}"
EPOCHS="${EPOCHS:-3}"
LR="${LR:-1e-4}"
BATCH="${BATCH:-8}"
ACCUM="${ACCUM:-64}"
MAXLEN="${MAXLEN:-512}"
VAL_FRAC="${VAL_FRAC:-0.01}"
MAXVAL="${MAXVAL:-1000}"
TARGET_MODULES="${TARGET_MODULES:-q_proj,v_proj}"   # 必须与采 C 时一致（坑 #1）
LAMBDA="${LAMBDA:-3e-2}"

# ---- 两阶段 λ 选择 ----
# SCAN_MODE=1：每个 λ 只训 SCAN_MAX_STEPS 个 optimizer steps，并在每个 benchmark
# 前 SCAN_LIMIT 题上粗评。adapter/run 名自动加 _scan_ms...，绝不会挡住后续正式训练。
# SCAN_MODE=0：只跑 LAMBDA（除非显式传 LAMBDAS），完整训练 EPOCHS 个 epoch。
SCAN_MODE="${SCAN_MODE:-0}"
SCAN_MAX_STEPS="${SCAN_MAX_STEPS:-200}"
SCAN_LIMIT="${SCAN_LIMIT:-200}"
if [[ "${SCAN_MODE}" == "1" ]]; then
  # C_mix 在真实 cif ΔW 下约为 C_if 惩罚的 1.252 倍，等效中心约 0.03/1.252=0.024。
  LAMBDAS="${LAMBDAS:-1e-2 2e-2 3e-2 1e-1}"
  MAX_STEPS="${MAX_STEPS:-${SCAN_MAX_STEPS}}"
  RUN_SUFFIX="_scan_ms${MAX_STEPS}"
else
  LAMBDAS="${LAMBDAS:-${LAMBDA}}"
  MAX_STEPS="${MAX_STEPS:-0}"
  RUN_SUFFIX=""
fi
IDENTITY_COV="${IDENTITY_COV:-0}"
REG_ONCE="${REG_ONCE:-1}"
SAVE="${SAVE:-1}"

# ---- walltime 守卫（扫描多 λ 时才有意义）----
# 每训一个 λ 前估算剩余时间，不够就干净停在下一个 λ 之前，绝不半截被杀（半截 adapter
# 若残留会被"已存在就跳过"误当完成）。原样重投即续跑。
WALLTIME_SEC="${WALLTIME_SEC:-86400}"    # 与 #PBS -l walltime=24:00:00 对齐
if [[ "${SCAN_MODE}" == "1" ]]; then
  RESERVE_SEC="${RESERVE_SEC:-18000}"    # 扫完后给 4 个 λ 的子集评测预留约 5h
  ESTIMATE_SEC="${ESTIMATE_SEC:-12000}"  # 200 steps 的首个 λ 粗估约 3.3h
else
  RESERVE_SEC="${RESERVE_SEC:-7200}"     # 单个正式 run 的完整 HE/MBPP 评测预留 2h
  ESTIMATE_SEC="${ESTIMATE_SEC:-50000}"  # 完整 3 epoch 粗估约 14h
fi

# ---- 协方差（默认名对齐 50 号 PBS 的产物）----
TAG="${TAG:-opcedu20k}"
CODE_COV="${CODE_COV:-${RESULTS_ROOT}/cov/cov_code_${TAG}_qv.pt}"
MIX_COV="${MIX_COV:-${RESULTS_ROOT}/cov/cov_if_code_${TAG}_mix_qv.pt}"

# ---- 固定基线 run 名 ----
VANILLA_RUN="${VANILLA_RUN:-cs_vanilla_seed${SEED}}"
# 见坑 #8：Hopper 上纯 C_if 是 balanced 那份，不是 32 号默认的 RWTH 名字。
# cif 与 42 共用同一 adapter；它固定在自己训练时的 λ（IF_LAMBDA），不随本线 λ 扫描变。
IF_LAMBDA="${IF_LAMBDA:-3e-2}"
IF_RUN="${IF_RUN:-cs_onereplay_balanced_lam${IF_LAMBDA}_seed${SEED}_regonce}"

# ---- 方法 run 名：随 λ 变，扫描时每个 λ 前重算一次 ----
# !! _opcedu 中缀是关键：不带它会和 42 的 Magicoder adapter 撞名，评到错的模型。
# 扫描下 CODE_RUN/CODE_MIX_RUN 不接受环境覆盖（多个 λ 无法用单一名字），一律从 LAMBDA 生成。
set_method_runs () {
  CODE_RUN="cs_onereplay_code_opcedu_lam${LAMBDA}_seed${SEED}_regonce${RUN_SUFFIX}"
  CODE_MIX_RUN="cs_onereplay_ifcode_opcedu_lam${LAMBDA}_seed${SEED}_regonce${RUN_SUFFIX}"
}
set_method_runs   # 先用网格首个 λ 初始化，供各处引用

# 方法 kind -> 评测短名：mix=cifcode，code=ccode。评测哪些方法由 TRAIN_KINDS 决定。
kind_to_short () { case "$1" in mix) echo cifcode ;; code) echo ccode ;; *) echo "" ;; esac; }

# MODELS 只列**固定基线**（不随 λ 变的那些）。方法 run（cifcode/ccode）由 λ 网格 ×
# TRAIN_KINDS 自动展开评测，不要往这里写。base/vanilla 的代码结果 39/42 已产出、同目录会
# 被自动跳过；默认只留 cif 这个核心对照，想补进表就 MODELS="base vanilla cif"。
MODELS="${MODELS:-cif}"

# ---- 代码评测参数（与 39 号一致，所有 run 必须同预算才可比）----
MBPP_CONFIG="${MBPP_CONFIG:-full}"
MBPP_SPLIT="${MBPP_SPLIT:-test}"
CODE_MAX_NEW_TOKENS="${CODE_MAX_NEW_TOKENS:-512}"
TIMEOUT="${TIMEOUT:-10}"
if [[ "${SCAN_MODE}" == "1" ]]; then
  LIMIT="${LIMIT:-${SCAN_LIMIT}}"
else
  LIMIT="${LIMIT:-0}"
fi

HUMANEVAL_FILE="${CODE_DATA_DIR}/humaneval_test.parquet"
MBPP_DIR="${CODE_DATA_DIR}/mbpp_${MBPP_CONFIG}"

# ---- 可选 IF/CS 侧 ----
WITH_IF="${WITH_IF:-0}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"
MULTIIF_INPUT="${MULTIIF_INPUT:-${REPO_ROOT}/onereplay/third_party/Multi-IF/multiIF_20241018.csv}"
MULTIIF_LANG="${MULTIIF_LANG:-English}"
MULTIIF_LIMIT="${MULTIIF_LIMIT:-0}"

# LIMIT>0 的产物只覆盖前 N 题，写进正式目录会被"已有 summary.json 就跳过"的逻辑
# 当成完整结果挡住后续正式评测（坑 #7）。这里自动改道。
OUT_DIR="${OUT_DIR:-${RESULTS_ROOT}}"
if [[ "${LIMIT}" != "0" ]]; then
  OUT_DIR="${OUT_DIR}_limit${LIMIT}"
fi

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
mkdir -p "${ADAPTERS}" "${RESULTS_ROOT}/metrics" "${OUT_DIR}" \
         "${RESULTS_ROOT}/map_cache/eval_code_seed${SEED}"

echo "TAG=${TAG}  CODE_COV=${CODE_COV}  MIX_COV=${MIX_COV}"
echo "SCAN_MODE=${SCAN_MODE} MAX_STEPS=${MAX_STEPS} RUN_SUFFIX=${RUN_SUFFIX} LIMIT=${LIMIT}"
echo "λ 网格=${LAMBDAS}  IF_LAMBDA=${IF_LAMBDA}  SEED=${SEED}  OUT_DIR=${OUT_DIR}"
echo "基线 MODELS=${MODELS}  方法 TRAIN_KINDS=${TRAIN_KINDS}  WITH_IF=${WITH_IF}"

# ===========================================================================
# 训练：循环 TRAIN_KINDS
# ===========================================================================
train_one () {
  local kind=$1
  local cov_path run
  case "${kind}" in
    code) cov_path="${CODE_COV}"; run="${CODE_RUN}" ;;
    mix)  cov_path="${MIX_COV}";  run="${CODE_MIX_RUN}" ;;
    *)    echo "未知 TRAIN_KIND=${kind}，可选 code / mix"; return 1 ;;
  esac

  if [[ "${FORCE_TRAIN}" != "1" && -d "${ADAPTERS}/${run}" ]]; then
    echo "跳过训练 ${run}：adapter 已存在（FORCE_TRAIN=1 可强制重训）"
    return 0
  fi
  [[ -f "${cov_path}" ]] || { echo "缺协方差 ${cov_path}（先跑 50 号）"; return 1; }
  [[ -d "${CS_DATASET}" ]] || { echo "缺 commonsense_170k: ${CS_DATASET}"; return 1; }
  mkdir -p "${RESULTS_ROOT}/map_cache/${run}"

  echo "==== train ${kind}: ${run} (cov=${cov_path} lam=${LAMBDA}) ===="
  python -m onereplay.scripts.train --paradigm sft \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
    --dataset_path "${CS_DATASET}" \
    --epochs "${EPOCHS}" --lr "${LR}" --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
    --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" --max_len "${MAXLEN}" \
    --target_modules "${TARGET_MODULES}" \
    --map_cache_dir "${RESULTS_ROOT}/map_cache/${run}" \
    --cov_path "${cov_path}" --replay_lambda "${LAMBDA}" \
    --identity_cov "${IDENTITY_COV}" --reg_once_per_update "${REG_ONCE}" \
    --max_steps "${MAX_STEPS}" \
    --save "${SAVE}" --save_path "${ADAPTERS}/${run}" \
    --metrics_path "${RESULTS_ROOT}/metrics/${run}.jsonl"
}

if [[ "${DO_TRAIN}" == "1" ]]; then
  LAST_LAMBDA_SEC="${ESTIMATE_SEC}"
  for LAMBDA in ${LAMBDAS}; do
    set_method_runs

    # walltime 守卫：只在这个 λ 确实还有 adapter 要训、且剩余时间不够时才停手。
    need_train=0
    for kind in ${TRAIN_KINDS}; do
      case "${kind}" in code) r="${CODE_RUN}" ;; mix) r="${CODE_MIX_RUN}" ;; *) r="" ;; esac
      if [[ -n "${r}" && ( "${FORCE_TRAIN}" == "1" || ! -d "${ADAPTERS}/${r}" ) ]]; then
        need_train=1
      fi
    done
    if (( need_train == 1 )); then
      REMAINING=$(( WALLTIME_SEC - SECONDS - RESERVE_SEC ))
      if (( REMAINING < LAST_LAMBDA_SEC )); then
        echo "########################################################################"
        echo "walltime 守卫：已用 ${SECONDS}s，剩余 ${REMAINING}s，不够再训一个 λ（约 ${LAST_LAMBDA_SEC}s）。"
        echo "停在 λ=${LAMBDA} 之前。原样重投即续跑（已完成的自动跳过）:"
        echo "  qsub -v LAMBDAS='${LAMBDAS}' onereplay/pbs/52_opc_code_train_eval.pbs"
        echo "########################################################################"
        break
      fi
    fi

    LAMBDA_START="${SECONDS}"
    echo "==== λ=${LAMBDA} 训练（已用 ${SECONDS}s）===="
    for kind in ${TRAIN_KINDS}; do
      train_one "${kind}"
    done
    LAMBDA_SEC=$(( SECONDS - LAMBDA_START ))
    # 只有真正训满的才拿来预估下一个；跳过训练的那几秒会把守卫骗过去。
    if (( LAMBDA_SEC > 600 )); then LAST_LAMBDA_SEC="${LAMBDA_SEC}"; fi
    echo "λ=${LAMBDA} 训练用时 ${LAMBDA_SEC}s"
  done
else
  echo "DO_TRAIN=0：跳过训练"
fi

# ===========================================================================
# 评测
# ===========================================================================
resolve_adapter () {
  case "$1" in
    base)     echo "" ;;
    vanilla)  echo "${ADAPTERS}/${VANILLA_RUN}" ;;
    cif)      echo "${ADAPTERS}/${IF_RUN}" ;;
    ccode)    echo "${ADAPTERS}/${CODE_RUN}" ;;
    cifcode)  echo "${ADAPTERS}/${CODE_MIX_RUN}" ;;
    *)        echo "" ;;
  esac
}

resolve_name () {
  case "$1" in
    base)     echo "base" ;;
    vanilla)  echo "${VANILLA_RUN}" ;;
    cif)      echo "${IF_RUN}" ;;
    ccode)    echo "${CODE_RUN}" ;;
    cifcode)  echo "${CODE_MIX_RUN}" ;;
    *)        echo "$1" ;;
  esac
}

pending_metrics () {
  local name=$1; shift
  local out="" m
  for m in "$@"; do
    if [[ "${FORCE_EVAL}" != "1" && -f "${OUT_DIR}/${m}/${name}/summary.json" ]]; then
      echo "已有结果，跳过 ${m}/${name}" >&2
      continue
    fi
    out="${out},${m}"
  done
  echo "${out#,}"
}

if [[ "${DO_EVAL}" == "1" ]]; then
  CODE_AVAIL=""
  if [[ -f "${HUMANEVAL_FILE}" ]]; then
    CODE_AVAIL="${CODE_AVAIL} humaneval"
  else
    echo "跳过 humaneval：缺 ${HUMANEVAL_FILE}（先在登录节点跑 download_code_data）"
  fi
  if [[ -d "${MBPP_DIR}" ]]; then
    CODE_AVAIL="${CODE_AVAIL} mbpp"
  else
    echo "跳过 mbpp：缺 ${MBPP_DIR}（先在登录节点跑 download_code_data）"
  fi
  CODE_AVAIL="${CODE_AVAIL# }"
  [[ -n "${CODE_AVAIL}" ]] || { echo "两份代码数据都不在，先下载"; exit 1; }

  IF_AVAIL=""
  if [[ "${WITH_IF}" == "1" ]]; then
    IF_AVAIL="ifeval commonsense"
    if [[ -f "${MULTIIF_INPUT}" ]]; then
      IF_AVAIL="${IF_AVAIL} multiif"
    else
      echo "跳过 multiif：缺 ${MULTIIF_INPUT}"
    fi
    [[ -d "${CS_DATASET}" ]] || echo "警告: commonsense 评测缺 ${CS_DATASET}"
  fi
  echo "CODE_AVAIL=[${CODE_AVAIL}]  IF_AVAIL=[${IF_AVAIL}]"

  # -------------------------------------------------------------------------
  # 判分链路自检：这套 exec-in-subprocess 的沙箱要是不通，整个作业跑完只会得到
  # 一片 0 分，很难看出是模型差还是判分坏了。39 号加的，保留。
  # -------------------------------------------------------------------------
  python - <<'PY'
from onereplay.eval.code_exec import evaluate_assert_program, evaluate_entry_point_program

ok, err = evaluate_assert_program("def add(a, b):\n    return a + b\n", ["assert add(1, 2) == 3"], 5.0)
print(f"自检 MBPP 路径      : passed={ok} error={err!r}")
program = "def add(a, b):\n    return a + b\n"
test = "def check(candidate):\n    assert candidate(1, 2) == 3\n"
ok2, err2 = evaluate_entry_point_program(program, "add", test, 5.0)
print(f"自检 HumanEval 路径 : passed={ok2} error={err2!r}")
if not (ok and ok2):
    raise SystemExit("判分沙箱不通（多半是容器里 multiprocessing 起不来），先修这个再评测")
print("判分链路 OK")
PY

  eval_one () {
    local short=$1
    local name adapter cp ip
    name="$(resolve_name "${short}")"
    adapter="$(resolve_adapter "${short}")"
    if [[ -n "${adapter}" && ! -d "${adapter}" ]]; then
      echo "跳过评测 ${short}：缺 adapter ${adapter}"
      return 0
    fi

    # shellcheck disable=SC2086
    cp="$(pending_metrics "${name}" ${CODE_AVAIL})"
    if [[ -n "${cp}" ]]; then
      echo "==== eval code: ${name} (${cp}) ===="
      python -m onereplay.scripts.evaluate \
        --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
        --adapter_path "${adapter}" --run_name "${name}" \
        --metrics "${cp}" --out_dir "${OUT_DIR}" --seed "${SEED}" \
        --limit "${LIMIT}" \
        --code_max_new_tokens "${CODE_MAX_NEW_TOKENS}" --timeout "${TIMEOUT}" \
        --humaneval_data_file "${HUMANEVAL_FILE}" \
        --mbpp_dataset_path "${MBPP_DIR}" --dataset_split "${MBPP_SPLIT}" \
        --cache_dir "${JOB_TMPDIR}/hf_datasets"
    else
      echo "跳过代码评测 ${name}：所有代码指标都已有结果"
    fi

    if [[ "${WITH_IF}" == "1" && -n "${IF_AVAIL}" ]]; then
      # shellcheck disable=SC2086
      ip="$(pending_metrics "${name}" ${IF_AVAIL})"
      if [[ -n "${ip}" ]]; then
        echo "==== eval IF/CS: ${name} (${ip}) ===="
        python -m onereplay.scripts.evaluate \
          --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
          --adapter_path "${adapter}" --run_name "${name}" \
          --metrics "${ip}" --out_dir "${OUT_DIR}" --seed "${SEED}" \
          --dataset_path "${CS_DATASET}" \
          --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" --max_len "${MAXLEN}" \
          --map_cache_dir "${RESULTS_ROOT}/map_cache/eval_code_seed${SEED}" \
          --ifeval_input "${IFEVAL_INPUT}" \
          --multiif_input "${MULTIIF_INPUT}" --multiif_language "${MULTIIF_LANG}" \
          --multiif_limit "${MULTIIF_LIMIT}"
      else
        echo "跳过 IF/CS 评测 ${name}：所有 IF/CS 指标都已有结果"
      fi
    fi
  }

  DIAG_RUNS=""

  # 固定基线（默认 cif，可选 base/vanilla）——只评一次，不随 λ 变。
  for m in ${MODELS}; do
    eval_one "${m}"
    DIAG_RUNS="${DIAG_RUNS},$(resolve_name "${m}")"
  done

  # 方法 run：λ 网格 × TRAIN_KINDS 展开，每个 λ 重算 run 名再评。
  for LAMBDA in ${LAMBDAS}; do
    set_method_runs
    for kind in ${TRAIN_KINDS}; do
      short="$(kind_to_short "${kind}")"
      [[ -n "${short}" ]] || { echo "未知 TRAIN_KIND=${kind}，评测跳过"; continue; }
      eval_one "${short}"
      DIAG_RUNS="${DIAG_RUNS},$(resolve_name "${short}")"
    done
  done

  # -------------------------------------------------------------------------
  # 失败原因分桶 + 语法错误成因取证 + 配对 McNemar
  #   这是本脚本真正的看点：语法错误那一桶被压回去多少。分析覆盖上面评过的所有 run
  #   （基线 + 每个 λ 的方法 run），baseline 固定为 base（其结果 39/42 已在同目录）。
  # -------------------------------------------------------------------------
  if [[ "${DO_ANALYZE}" == "1" ]]; then
    python -m onereplay.scripts.analyze_code_failures \
      --results_root "${OUT_DIR}" --metrics "${CODE_AVAIL// /,}" \
      --runs "${DIAG_RUNS#,}" --baseline base --inspect 5 || true
  fi

  set +x
  echo "========================================================================"
  echo "怎么读："
  echo "  1) **主量具不在这里。** pass@1 的量程不够测保护（MBPP 3.30pp vs 预期救回"
  echo "     2.28pp），训完必须跑 40 号代码 CE 探针，看 cifcode 把漂移倍数压回多少，"
  echo "     以及 bootstrap 里 cif vs cifcode 的配对差是否显著。"
  echo "  2) 失败分桶要另跑（命令见下）：vanilla 的语法错误是 base 的 21 倍（MBPP 2 -> 43"
  echo "     题），cifcode 若把这一桶压回接近 base，就是「保住了输出结构」的直接机制证据。"
  echo "     断言失败那一桶本来就持平，它继续持平是预期，不是发现。"
  echo "  3) 若开了 WITH_IF：确认 cifcode 的 IFEval 没比 cif 差 —— C_mix 的主张是"
  echo "     同时保住两边，为代码牺牲 IF 不算成功。"
  echo "  4) 绝对分数低于公开报告值（判分器有黑名单且会在第一个 '\\ndef ' 处截断），"
  echo "     对比有效，绝对值不要外引。"
  echo ""
  echo "产物: ${OUT_DIR}/{humaneval,mbpp}/<run_name>/{summary.json,responses.jsonl}"
  echo "      ${OUT_DIR}/{humaneval,mbpp}_summary.csv（append，以 summary.json 为唯一真相）"
  echo ""
  echo "本作业只出 pass@1（DO_ANALYZE=0）。失败分桶 / 语法错误取证 / 配对 McNemar"
  echo "读的是上面已落盘的 responses.jsonl，纯 CPU 几秒，在登录节点上补即可："
  echo "  python -m onereplay.scripts.analyze_code_failures \\"
  echo "    --results_root ${OUT_DIR} --metrics ${CODE_AVAIL// /,} \\"
  echo "    --runs <run1,run2,...> --baseline base --inspect 5"
  echo "要让本作业自己跑，投递前设 DO_ANALYZE=1。"
  set -x
else
  echo "DO_EVAL=0：跳过评测"
fi

set +x
echo "Job finished at: $(date)"
