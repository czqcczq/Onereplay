#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_8b_ewc_ds
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# NUS Hopper: Qwen3-8B EWC 臂 —— 单域保护（训练 + 按域评测）
#
# 与 70 号（OneReplay）逐字同构，只换一件事：拿什么矩阵去加权 ΔW。
#
#     OneReplay   R = tr(ΔW C ΔWᵗ)      C = E[x xᵗ]        输入的二阶矩
#     EWC         R = Σ_ij F_ij ΔW_ij²   F = E[(∂L/∂W)²]    梯度的二阶矩
#
# 两份矩阵是在同一批行上采的（68 号采 C，69 号采 F），所以这条臂回答的问题很窄：
# 「同样的旧知识，编码成输入协方差还是编码成 Fisher，哪个保得住？」
# 69 号的 Step 3 已经把两边的 pool_fingerprint 比过一次，本脚本的 Step 1 再比一次
# —— 那是这条对比唯一的公平性凭据，比一次不够，因为 F 可能在两次投递之间被重采。
#
# -----------------------------------------------------------------------------
# !! λ 完全不通用，连数量级都不通用
#   F 是平方梯度的均值，落在比 C 低好几个数量级的地方。70 号那套 λ 搬过来会让
#   罚项等于不存在。起点取 1/mean(F)（69 号采完时打过，Step 1 会再打一次），
#   然后**按十倍**展开扫，不是 0.5x/1x/2x —— 那个步长是给 OneReplay 的，
#   因为 C 的 λ 已经知道在哪个十倍档里了，而 F 这边连档位都是估的。
#
#   Step 1 会打印 λ × mean(F)，训练自检会打印每个 epoch 的 λR/task_loss。
#
# -----------------------------------------------------------------------------
# !! 定档位：传 LAMBDAS 进扫描模式（本臂比 70 号更需要它）
#   一个作业里对网格上每个 λ 各跑 PROBE_STEPS 步（默认 300），不评测、不存
#   adapter，末尾打两张对照表。分隔符用冒号最稳，qsub -v 自己按逗号切:
#       LAMBDAS=0:<0.01x>:<0.1x>:<1x>:<10x>       （x = 1/mean(F)）
#
#   网格里带一个 λ=0 是刻意的，它是这两张表的标尺。λ=0 时 ΔW 完全不受约束，测出
#   来的 R 就是「这个域上罚项本来会有多大」，于是
#       想要 λR/task_loss ≈ 目标占比  =>  λ ≈ 目标占比 x task_loss / R(λ=0)
#   这个反推值与 1/mean(F) 差几个十倍，就是「F 的大质量落在 ΔW 其实没走的方向上」
#   这件事有多严重 —— 1/mean(F) 假设 ΔW 各向同性，实测的 R 不假设。
#
#   !! 短跑能回答什么、不能回答什么
#   能：档位差了几个十倍；罚项有没有真的接上（每个 λ 都会 grep 一次层覆盖那句，
#       外加一句"罚项不是来自 C"）；R/R(λ=0)——λ 把 ΔW 的能量压掉了多少。
#   不能：定最终的 λ。ACCUM=64 下 300 步只有约 37 次参数更新，3 个 epoch 是约 6
#       万次；R 只依赖 ΔW，此刻 ΔW 还几乎没长起来，所以 λR/task_loss 这个**绝对
#       值**系统性偏小，只能当下界读。选点仍然要靠完整 run 的 val_loss + retention。
#
#   这张表还有一个专门的用途：EWC 最后输给 OneReplay 时，它是区分两种原因的证据
#   —— λ 根本没扫到有效区间（表里全是 R/R(0)≈1），还是扫到了、罚项确实起作用了
#   但保留仍然更差。后者才是关于 Fisher 这个量本身的结论。
#
#   扫描的代价：每个 λ 都是一次独立的 train.py 调用，各自重读一遍约 25.9 GiB 的
#   F、重新加载 8B 权重、重新 tokenize 一遍数据集。网格控制在 3-5 个点。
#
# -----------------------------------------------------------------------------
# !! 短跑的 run 名带 _probe 后缀，不与正式结果落进同一个 metrics 文件
#   metrics jsonl 是追加写的。若短跑与正式 run 同名，300 步那条 epoch 记录会和
#   3-epoch 那条排在一个文件里，自检读 epochs[-1]、汇总读最后一条，两边都可能拿
#   到错的那条。判据不只看 PROBE：手工传 MAX_STEPS / EPOCHS 也算短跑。
#
# -----------------------------------------------------------------------------
# !! F 的层覆盖必须 ⊇ LoRA 的层覆盖（与 70 号同一个坑）
#   regularizer 对找不到罚项矩阵的层是**静默跳过**的：它把这些层记进
#   missing_layers，训练照跑、loss 照降，只在第一步的 stdout 上留一行
#       regularizer covers {used} layers; no penalty matrix for {missing} layers
#   metrics jsonl 里没有这个数。所以本脚本设了两道闸：
#     Step 1  直接读 F 文件的 key 和形状，数层数、核对每一类的 (out, in)
#     自检 1  从训练日志里 grep 那一行，要求 missing == 0
#   拿 69 号 qv 版的 F 去训 all-linear 会让罚项只覆盖 2/7 的层，两道闸都会拦。
#
# -----------------------------------------------------------------------------
# !! F 的形状是 (out, in)，C 是 (in, in)
#   两种文件都是 {模块名: 张量}，互换只会在 matmul 深处报形状错，甚至在方阵层上
#   静默给出另一个罚项。regularizer 的 _check_fisher_shape 会拦，但那是训练开始
#   之后的事；Step 1 在读文件时就按这张表核对：
#       q_proj (4096, 4096)   k_proj (1024, 4096)   v_proj (1024, 4096)
#       o_proj (4096, 4096)   gate_proj (12288, 4096)   up_proj (12288, 4096)
#       down_proj (4096, 12288)
#   注意 k/v 是 1024 行（GQA：8 个 kv 头 × 128），不是 4096。
#
# -----------------------------------------------------------------------------
# 显存：F 比 C 小，所以「常驻开销」不是这两个方法的分界线
#   F 每层一份 (out, in)，全 7 类 × 36 层合计约 25.9 GiB（fp32）；
#   C 每层一份 (in, in)，同样覆盖是 33.75 GiB。
#   真正的差别在**采集**：C 只要前向，F 要逐条样本反向（69 号的 walltime 就是
#   这么来的）。汇总表会把两者并排打出来，别把 EWC 说成"更省"。
#   H200 143 GB 上：权重约 16 GiB + F 约 26 GiB + 激活/优化器约 15 GiB，够。
#
# -----------------------------------------------------------------------------
# IDENTITY_COV 在本臂无意义
#   --identity_cov 1 是把 C 换成单位矩阵的 L2 对照，train.py 在 ewc 分支上会直接
#   抛异常。要那个消融就去 70 号传 IDENTITY_COV=1。Step 0 提前拦下来，
#   免得排队几小时才在第一步崩。
#
# -----------------------------------------------------------------------------
# 评测口径按域走（与 70/71 号相同）
#       DOMAIN=if    评 ifeval + gsm8k + math500 + humaneval + mbpp
#       DOMAIN=math  评 ifeval + gsm8k + math500
#       DOMAIN=code  评 ifeval + humaneval + mbpp
#
# -----------------------------------------------------------------------------
# 投递前要有的东西
#   1) ${MODEL_DIR}/Qwen3-8B
#   2) 69 号产出的本域 F（fisher_*_8b_all.pt）
#   3) 68 号产出的本域 C —— 本臂不用它训练，只读它的 pool_fingerprint 来证明
#      F 和 C 是同一批行。真没有就传 SKIP_FP_CHECK=1，但那样这条对比就没有凭据。
#   4) ${DS_DATASET} = datasets/dialogsum_sft_hf
#   5) 74 号的 base 与 vanilla 已评完
#
# 投递（DRY_RUN=1 是默认，先看计划）:
#   第一步 先扫档位（一个作业跑完整个网格，不评测不存 adapter，约 1-2h）:
#   qsub -v DRY_RUN=0,DOMAIN=if,LAMBDAS=0:<0.01x>:<0.1x>:<1x>:<10x> onereplay/pbs/72_...
#   第二步 照扫描表定档位，按十倍各投一次正式 run（λ 在 run 名里，不会互相覆盖）:
#   qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=<1x>    onereplay/pbs/82_qwen3_8b_gold_ewc_ds.pbs
#   qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=<0.1x> ...   /   LAMBDA=<10x>
#   单点短跑（= 只有一个 λ 的扫描，没有 λ=0 那把尺子）:
#   qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=<起点>,PROBE=1 onereplay/pbs/72_...
#   拆两次投（训练与评测分开）:
#   qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=...,DO_EVAL=0  ...   然后   DO_TRAIN=0
#
#   若本站点 qsub 不吃 -v（63 号文件头有过这个记录），就直接改「阶段开关」段的
#   默认值再投。
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/82_qwen3_8b_gold_ewc_ds.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME DS_DATASET RESULTS_ROOT MATH_DATA_DIR CODE_DATA_DIR
    DATASET_CACHE OUT_DIR
    DRY_RUN DO_TRAIN DO_EVAL FORCE_TRAIN FORCE_EVAL PROBE ALLOW_DRIFT FISHER_DIAG
    DOMAIN LAMBDA LAMBDAS PROBE_STEPS PROBE_LOG_EVERY SKIP_FP_CHECK
    FISHER_PATH IF_FISHER MATH_FISHER CODE_FISHER
    COV_PATH IF_COV MATH_COV CODE_COV
    REGULARIZER IDENTITY_COV REG_ONCE NORM_BY_LAYERS ONEREPLAY_METRICS
    SEED EPOCHS LR BATCH ACCUM MAXLEN VAL_FRAC MAXVAL
    TARGET_MODULES LORA_RANK LORA_ALPHA LORA_DROPOUT
    EVAL_BATCH SAVE MAX_STEPS RUN_TAG RUN VANILLA_RUN
    MATH500_FILE GSM8K_FILE HUMANEVAL_FILE MBPP_DIR MBPP_SPLIT IFEVAL_INPUT
    MATH_MAX_NEW_TOKENS CODE_MAX_NEW_TOKENS IF_MAX_NEW_TOKENS
    MATH_BATCH CODE_BATCH IFEVAL_BATCH
    TIMEOUT LIMIT DIAG_LEN WITH_BASE WITH_VANILLA EXTRA_MODELS
    MIN_HOST_FREE_GIB
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：那会把当前 shell 替换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的训练与评测。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

# ---- 项目路径：写 8B 自己的目录，与 1.7B 那批彻底隔离 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-8B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results/qwen3-8b}"
DS_DATASET="${DS_DATASET:-${REPO_ROOT}/datasets/dialogsum_sft_hf}"
MATH_DATA_DIR="${MATH_DATA_DIR:-${REPO_ROOT}/datasets/math}"
CODE_DATA_DIR="${CODE_DATA_DIR:-${REPO_ROOT}/datasets/code}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
ADAPTERS="${RESULTS_ROOT}/adapters"
COV_DIR="${RESULTS_ROOT}/cov"
FISHER_DIR="${RESULTS_ROOT}/fisher"
TRAIN_LOG_DIR="${RESULTS_ROOT}/train_logs"
export HF_DATASETS_CACHE="${DATASET_CACHE}"

# ---- 阶段开关 ----
DRY_RUN="${DRY_RUN:-1}"          # 默认只做前置检查与 F 诊断，不训练不评测
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"
PROBE="${PROBE:-0}"             # 1 = 300 步短跑，只看罚项量级
ALLOW_DRIFT="${ALLOW_DRIFT:-0}"  # 1 = 容忍与 74 号不一致的超参（会打印偏差清单）
FISHER_DIAG="${FISHER_DIAG:-1}"  # 1 = 算 mean(F)/max(F)（会把整份 F 过一遍盘）
SKIP_FP_CHECK="${SKIP_FP_CHECK:-0}"  # 1 = 不比 F 与 C 的池指纹（那就没有公平性凭据）
WITH_BASE="${WITH_BASE:-0}"      # base/vanilla 由 74 号评过，默认不重评
WITH_VANILLA="${WITH_VANILLA:-0}"

# ---- 保护域：决定 F、run 名与评测口径 ----
DOMAIN="${DOMAIN:-}"
case "${DOMAIN}" in
  if|math|code) ;;
  "")
    echo "!! 必须指定 DOMAIN（if / math / code）。"
    echo "   例: qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=1e2 ${SELF_PATH}"
    exit 1
    ;;
  *)
    echo "!! DOMAIN=${DOMAIN} 不认识，只能是 if / math / code（本轮不做 mix）"
    exit 1
    ;;
esac

# ---- 训练超参：与 74 号逐字一致；LR 是唯一有意留的自由度 ----
SEED="${SEED:-1}"
EPOCHS="${EPOCHS:-2}"
LR="${LR:-2e-4}"                 # 74 号若因 lr=2e-4 崩溃回落 1e-4，本臂必须跟着回落
BATCH="${BATCH:-8}"
ACCUM="${ACCUM:-64}"             # 每次更新 64 行新任务
EVAL_BATCH="${EVAL_BATCH:-8}"    # 钉住，否则 val_loss 与 74 号及其余各臂不可比
MAXLEN="${MAXLEN:-1024}"
VAL_FRAC="${VAL_FRAC:-0.04}"
MAXVAL="${MAXVAL:-1000}"
LORA_RANK="${LORA_RANK:-16}"
LORA_ALPHA="${LORA_ALPHA:-32}"
LORA_DROPOUT="${LORA_DROPOUT:-0.05}"
TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj}"
SAVE="${SAVE:-1}"
MAX_STEPS="${MAX_STEPS:-0}"

# ---- 正则化 ----
REGULARIZER="${REGULARIZER:-ewc}"
LAMBDA="${LAMBDA:-}"             # 没有默认值，见文件头
REG_ONCE="${REG_ONCE:-1}"        # 罚项每次参数更新算一次，不是每个 micro-batch
NORM_BY_LAYERS="${NORM_BY_LAYERS:-1}"   # λ 的换算是在这个前提下做的，改了 λ 就换了尺子
IDENTITY_COV="${IDENTITY_COV:-0}" # 本臂只能是 0，见文件头；Step 0 会拦

# 69 号的三份 F。名字里的 _8b_all 是与 1.7B 的 _qv 版区分的唯一标记。
IF_FISHER="${IF_FISHER:-${FISHER_DIR}/fisher_flan_chat_20k_8b_all.pt}"
MATH_FISHER="${MATH_FISHER:-${FISHER_DIR}/fisher_math_metamath30k_gold_8b_all.pt}"
CODE_FISHER="${CODE_FISHER:-${FISHER_DIR}/fisher_code_opcedu20k_gold_8b_all.pt}"
# 68 号的三份 C。本臂不用它训练，只读它的 pool_fingerprint 证明 F 与 C 同池。
IF_COV="${IF_COV:-${COV_DIR}/cov_flan_chat_20k_8b_all.pt}"
MATH_COV="${MATH_COV:-${COV_DIR}/cov_math_metamath30k_gold_8b_all.pt}"
CODE_COV="${CODE_COV:-${COV_DIR}/cov_code_opcedu20k_gold_8b_all.pt}"
case "${DOMAIN}" in
  if)   FISHER_PATH="${FISHER_PATH:-${IF_FISHER}}"   ; COV_PATH="${COV_PATH:-${IF_COV}}"   ;;
  math) FISHER_PATH="${FISHER_PATH:-${MATH_FISHER}}" ; COV_PATH="${COV_PATH:-${MATH_COV}}" ;;
  code) FISHER_PATH="${FISHER_PATH:-${CODE_FISHER}}" ; COV_PATH="${COV_PATH:-${CODE_COV}}" ;;
esac

# ---- λ 扫描 ----
# 传 LAMBDAS 就进扫描模式：网格上每个 λ 各跑 MAX_STEPS 步，不评测不存 adapter，
# 末尾打对照表。分隔符接受冒号 / 逗号 / 空格（qsub -v 自己按逗号切，冒号最稳）。
# 本臂的网格按十倍走，见文件头。
LAMBDAS="${LAMBDAS:-}"
PROBE_STEPS="${PROBE_STEPS:-300}"
PROBE_LOG_EVERY="${PROBE_LOG_EVERY:-50}"   # 要看趋势，默认 500 步一打就只剩一个点
SWEEP=0
LAMBDA_LIST=()
if [[ -n "${LAMBDAS}" ]]; then
  SWEEP=1
  PROBE=1
  read -r -a LAMBDA_LIST <<< "${LAMBDAS//[,:]/ }"
  if (( ${#LAMBDA_LIST[@]} == 0 )); then
    echo "!! LAMBDAS='${LAMBDAS}' 切不出任何 λ"; exit 1
  fi
fi

if [[ "${PROBE}" == "1" ]]; then
  SAVE=0
  [[ "${MAX_STEPS}" == "0" ]] && MAX_STEPS="${PROBE_STEPS}"
  EPOCHS=1                       # 300 步 x 3 个 epoch 没有额外信息，只是等三倍时间
  DO_EVAL=0
  echo "PROBE=1：SAVE=0 MAX_STEPS=${MAX_STEPS} EPOCHS=1 DO_EVAL=0，只看罚项量级"
fi
if (( SWEEP == 1 )); then
  echo "λ 扫描模式：网格 = ${LAMBDA_LIST[*]}（共 ${#LAMBDA_LIST[@]} 点，每点 ${MAX_STEPS} 步）"
fi

# ---- run 名：域与 λ 都编进去，扫 λ 时不会互相覆盖 ----
RUN_TAG="${RUN_TAG:-r${LORA_RANK}all}"
# 短跑的记录不能落进正式 run 的名下（文件头说明了为什么）。预算也编进后缀，这样
# 300 步与 2000 步两种短跑之间也不会互相覆盖。
SHORT_RUN=0
if [[ "${MAX_STEPS}" != "0" || "${EPOCHS}" != "2" ]]; then
  SHORT_RUN=1
fi
run_name_for () {
  local name="ds_ewc_8b_${DOMAIN}gold_${RUN_TAG}_lam${1}_lr${LR}_seed${SEED}_regonce"
  if (( SHORT_RUN == 1 )); then
    name="${name}_probe${MAX_STEPS}s${EPOCHS}e"
  fi
  printf '%s' "${name}"
}
if (( SWEEP == 1 )) && [[ -z "${LAMBDA}" ]]; then
  # 扫描模式下每个 λ 各有自己的 run 名；这个只用来给 Step 1 的临时报告命名。
  RUN="${RUN:-$(run_name_for sweep)}"
else
  RUN="${RUN:-$(run_name_for "${LAMBDA}")}"
fi
if (( SHORT_RUN == 1 )); then
  echo "短跑（max_steps=${MAX_STEPS} epochs=${EPOCHS}）：run 名带 _probe 后缀，与正式结果分开存"
fi
# train.py 的默认 log_every=500 比一次短跑的总步数还大，那样连一行 step 日志都拿
# 不到（trainer 只在 step%log_every==0 或最后一步打），λR 的趋势就无从看起。
if (( SHORT_RUN == 1 )); then
  LOG_EVERY="${LOG_EVERY:-${PROBE_LOG_EVERY}}"
else
  LOG_EVERY="${LOG_EVERY:-500}"
fi
# 74 号的 vanilla：分母。名字必须按同一套规则拼，否则末尾的对照表读不到它。
VANILLA_RUN="${VANILLA_RUN:-ds_vanilla_8b_${RUN_TAG}_lr${LR}_ep${EPOCHS}_seed${SEED}}"
TRAIN_LOG="${TRAIN_LOG_DIR}/${RUN}.train.log"

# ---- 评测数据 ----
MATH500_FILE="${MATH500_FILE:-${MATH_DATA_DIR}/math500_test.jsonl}"
GSM8K_FILE="${GSM8K_FILE:-${MATH_DATA_DIR}/gsm8k_test.jsonl}"
HUMANEVAL_FILE="${HUMANEVAL_FILE:-${CODE_DATA_DIR}/humaneval_test.parquet}"
MBPP_DIR="${MBPP_DIR:-${CODE_DATA_DIR}/mbpp_full}"
MBPP_SPLIT="${MBPP_SPLIT:-test}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"

# ---- 解码预算与解码 batch：74 号定的口径，所有臂必须逐字相同 ----
MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS:-4096}"
CODE_MAX_NEW_TOKENS="${CODE_MAX_NEW_TOKENS:-512}"
IF_MAX_NEW_TOKENS="${IF_MAX_NEW_TOKENS:-768}"
MATH_BATCH="${MATH_BATCH:-32}"
CODE_BATCH="${CODE_BATCH:-64}"
IFEVAL_BATCH="${IFEVAL_BATCH:-32}"

TIMEOUT="${TIMEOUT:-10}"
LIMIT="${LIMIT:-0}"
DIAG_LEN="${DIAG_LEN:-1}"
EXTRA_MODELS="${EXTRA_MODELS:-}" # "name;/abs/path" 用 | 分隔，额外要评的已有 run
MIN_HOST_FREE_GIB="${MIN_HOST_FREE_GIB:-4}"   # F 之外还要留给主机的余量

# 按域决定评哪些指标（文档 09-09 第一节的口径）
case "${DOMAIN}" in
  if)   DOMAIN_METRICS="ifeval gsm8k math500 humaneval mbpp" ;;
  math) DOMAIN_METRICS="ifeval gsm8k math500" ;;
  code) DOMAIN_METRICS="ifeval humaneval mbpp" ;;
esac

# LIMIT>0 的产物只覆盖前 N 题，写进正式目录会被"已有 summary.json 就跳过"当成完整结果。
OUT_DIR="${OUT_DIR:-${RESULTS_ROOT}}"
if [[ "${LIMIT}" != "0" ]]; then
  OUT_DIR="${OUT_DIR}_limit${LIMIT}"
fi

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺基座模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
mkdir -p "${ADAPTERS}" "${RESULTS_ROOT}/metrics" "${OUT_DIR}" "${DATASET_CACHE}" "${TRAIN_LOG_DIR}"

set +x
echo "========================================================================"
echo "Qwen3-8B EWC 臂：保护 ${DOMAIN}"
echo "  run      = ${RUN}"
echo "  分母     = base / ${VANILLA_RUN}   (74 号产出)"
echo "  对手     = 70 号 OneReplay 同域（同批行，只差用 F 还是用 C 加权 ΔW）"
echo "  F        = ${FISHER_PATH}"
echo "  同池参照 = ${COV_PATH}   skip_check=${SKIP_FP_CHECK}"
if (( SWEEP == 1 )); then
  echo "  λ 网格   = ${LAMBDA_LIST[*]}   (扫描，每点 ${MAX_STEPS} 步)"
else
  echo "  λ        = ${LAMBDA}"
fi
echo "             reg_once=${REG_ONCE}  normalize_by_layers=${NORM_BY_LAYERS}"
echo "             regularizer=${REGULARIZER}（λ 与 70 号完全不通用，按十倍扫）"
echo "  LoRA     = r${LORA_RANK} alpha${LORA_ALPHA} dropout${LORA_DROPOUT}"
echo "             targets=${TARGET_MODULES}"
echo "  训练     = LR ${LR} / EPOCHS ${EPOCHS} / BATCH ${BATCH} / ACCUM ${ACCUM}(行/更新) / MAXLEN ${MAXLEN}"
echo "             eval_batch ${EVAL_BATCH} / seed ${SEED} / max_steps ${MAX_STEPS}"
echo "  评测     = ${DOMAIN_METRICS}"
echo "             预算 math ${MATH_MAX_NEW_TOKENS} / code ${CODE_MAX_NEW_TOKENS} / ifeval ${IF_MAX_NEW_TOKENS}"
echo "             batch math ${MATH_BATCH} / code ${CODE_BATCH} / ifeval ${IFEVAL_BATCH}"
echo "  阶段     = train:${DO_TRAIN} eval:${DO_EVAL} probe:${PROBE} DRY_RUN=${DRY_RUN}"
echo "  OUT_DIR  = ${OUT_DIR}"
echo "========================================================================"

# ===========================================================================
# Step 0: 与 74 号的对齐检查（纯 bash，秒级）
#   delta 只有在「除了正则项之外一切相同」时才是这个方法的效果。
# ===========================================================================
echo "==== Step 0: 对齐检查 ===="

if (( SWEEP == 1 )); then
  # 网格允许 λ=0（那是标尺行：只测 R 不加罚），但不允许负数或非数字。
  for lam in "${LAMBDA_LIST[@]}"; do
    python -c "import sys; sys.exit(0 if float('${lam}') >= 0 else 1)" 2>/dev/null || {
      echo "!! LAMBDAS 里的 '${lam}' 不是非负数"
      exit 1
    }
  done
  echo "λ 网格 ${#LAMBDA_LIST[@]} 个点都合法: ${LAMBDA_LIST[*]}"
  case " ${LAMBDA_LIST[*]} " in
    *" 0 "*|*" 0.0 "*) ;;
    *) echo "warning: 网格里没有 λ=0。那一行是标尺（R(λ=0) 与 task_loss 的基准），"
       echo "         没有它就只能读绝对量级，读不到 R/R(0) 和反推的 λ 建议。" ;;
  esac
else
  [[ -n "${LAMBDA}" ]] || {
    echo "!! LAMBDA 为空。它没有默认值是刻意的：F 的量级比 C 低好几个数量级，"
    echo "   70 号那套 λ 搬过来等于没有罚项。"
    echo "   起点取 1/mean(F)（69 号采完时打过，Step 1 会再打一次），按十倍展开扫。"
    echo "   连档位都没底就先扫一遍（围绕 1/mean(F) 各上下两个十倍）:"
    echo "   LAMBDAS=0:<0.01x>:<0.1x>:<1x>:<10x>"
    exit 1
  }
  python -c "import sys; sys.exit(0 if float('${LAMBDA}') > 0 else 1)" || {
    echo "!! LAMBDA=${LAMBDA} 不是正数。λ=0 就是 vanilla，那是 74 号的事。"
    echo "   要把 λ=0 当扫描的标尺行，用 LAMBDAS 而不是 LAMBDA。"
    exit 1
  }
fi
if [[ "${IDENTITY_COV}" == "1" ]]; then
  echo "!! IDENTITY_COV=1 在 EWC 臂上无意义：它是把 C 换成单位矩阵的 L2 对照，"
  echo "   train.py 的 ewc 分支会直接抛异常。要那个消融就去 70 号:"
  echo "   qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=<...>,IDENTITY_COV=1 \\"
  echo "        onereplay/pbs/70_qwen3_8b_gold_onereplay.pbs"
  exit 1
fi
[[ -d "${DS_DATASET}" ]] || { echo "缺 DialogSum 训练池: ${DS_DATASET}"; exit 1; }
[[ -f "${FISHER_PATH}" ]] || {
  echo "!! 缺 F: ${FISHER_PATH}"
  echo "   先跑 69 号采本域的 F（那是逐条样本反向，比采 C 慢得多，先看它的 ETA）。"
  exit 1
}
case "${FISHER_PATH}" in
  *_qv.pt)
    echo "!! FISHER_PATH 以 _qv.pt 结尾，那是只覆盖 q_proj/v_proj 的 F。"
    echo "   拿它训 all-linear 会让正则只覆盖 2/7 的层，训练照跑、loss 照降。"
    exit 1
    ;;
  cov_*|*/cov_*)
    echo "!! FISHER_PATH 看起来是一份 C（文件名以 cov_ 开头）。"
    echo "   C 是 (in, in)、F 是 (out, in)，方阵层上互换不会报错只会给出另一个罚项。"
    exit 1
    ;;
esac
# 同池凭据：F 与 C 的 pool_fingerprint 必须相等，否则这条对比比的不只是 F vs C。
if [[ "${SKIP_FP_CHECK}" == "1" ]]; then
  echo "warning: SKIP_FP_CHECK=1，不比 F 与 C 的池指纹。"
  echo "         「同一批旧知识，两种编码」这个前提就没有凭据了，结论只能当参考。"
elif [[ ! -f "${COV_PATH}" ]]; then
  echo "!! 缺 C: ${COV_PATH}"
  echo "   本臂不用它训练，只读它 metadata 里的 pool_fingerprint 来证明 F 与 C 同池。"
  echo "   68 号还没跑就先跑它；确实要先跑 EWC 就传 SKIP_FP_CHECK=1。"
  exit 1
fi
if (( ACCUM % BATCH != 0 )); then
  echo "ACCUM=${ACCUM} 不能被 BATCH=${BATCH} 整除，每次更新的行数会被静默取整"; exit 1
fi

# 74 号钉下来的值。LR 不在其中：它是有意留的自由度，但必须与被比的 vanilla 同值。
DRIFT=()
[[ "${TARGET_MODULES}" == "q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj" ]] \
  || DRIFT+=("target_modules=${TARGET_MODULES}（74 号: all-linear 七类）")
[[ "${LORA_RANK}"    == "16"   ]] || DRIFT+=("lora_rank=${LORA_RANK}（74 号: 16）")
[[ "${LORA_ALPHA}"   == "32"   ]] || DRIFT+=("lora_alpha=${LORA_ALPHA}（74 号: 32）")
[[ "${LORA_DROPOUT}" == "0.05" ]] || DRIFT+=("lora_dropout=${LORA_DROPOUT}（74 号: 0.05）")
[[ "${BATCH}"        == "8"    ]] || DRIFT+=("batch_size=${BATCH}（74 号: 8）")
[[ "${ACCUM}"        == "64"   ]] || DRIFT+=("accumulation_size=${ACCUM}（74 号: 64）")
[[ "${EVAL_BATCH}"   == "8"    ]] || DRIFT+=("eval_batch_size=${EVAL_BATCH}（74 号: 8，val_loss 靠它可比）")
[[ "${MAXLEN}"       == "1024" ]] || DRIFT+=("max_len=${MAXLEN}（74 号: 1024，对话比 CS 的短指令长）")
[[ "${VAL_FRAC}"     == "0.04" ]] || DRIFT+=("val_fraction=${VAL_FRAC}（74 号: 0.04，12460 行的 1% 只切出 125 行）")
[[ "${MAXVAL}"       == "1000" ]] || DRIFT+=("max_val_samples=${MAXVAL}（74 号: 1000）")
if [[ "${PROBE}" != "1" ]]; then
  [[ "${EPOCHS}"   == "2" ]] || DRIFT+=("epochs=${EPOCHS}（74 号: 2，val_loss 在 epoch 2 触底）")
  [[ "${MAX_STEPS}" == "0" ]] || DRIFT+=("max_steps=${MAX_STEPS}（正式 run 应为 0）")
fi
[[ "${REGULARIZER}" == "ewc" ]] || DRIFT+=("regularizer=${REGULARIZER}（本脚本是 EWC 臂）")
[[ "${REG_ONCE}"    == "1" ]] || DRIFT+=("reg_once_per_update=${REG_ONCE}（应为 1）")
[[ "${NORM_BY_LAYERS}" == "1" ]] || DRIFT+=("normalize_replay_by_layers=${NORM_BY_LAYERS}（λ 的换算以 1 为前提）")

if (( ${#DRIFT[@]} > 0 )); then
  echo "与 74 号不一致的项:"
  for item in "${DRIFT[@]}"; do echo "  - ${item}"; done
  if [[ "${ALLOW_DRIFT}" != "1" ]]; then
    echo "!! 这些偏差会让 delta 里混进第二个变量。确实要改就传 ALLOW_DRIFT=1，"
    echo "   并把偏差写进结果表。停。"
    exit 1
  fi
  echo "ALLOW_DRIFT=1：继续，但上面每一条都要写进结果表。"
else
  echo "训练超参与 74 号逐字一致。"
fi

if [[ ! -f "${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl" ]]; then
  echo "warning: 找不到 ${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl"
  echo "         74 号的 vanilla（LR=${LR}）还没跑完，本臂现在没有可比的分母。"
  echo "         若 74 号回落到了 LR=1e-4，本臂也要传 LR=1e-4。"
fi
for f in "${IFEVAL_INPUT}" "${MATH500_FILE}" "${GSM8K_FILE}" "${HUMANEVAL_FILE}"; do
  [[ -f "${f}" ]] || echo "warning: 缺评测数据 ${f}（相关指标会被跳过）"
done
[[ -d "${MBPP_DIR}" ]] || echo "warning: 缺 MBPP 目录 ${MBPP_DIR}（该指标会被跳过）"

# ===========================================================================
# Step 1: F 的层覆盖断言 + 量级/显存预检 + 与 C 的池指纹比对
#   这是本脚本存在的主要理由。regularizer 对找不到罚项矩阵的层静默跳过，所以
#   「训练跑通」并不能说明正则真的覆盖了 252 层。
#   顺带把 λ 的起点算出来：F 的量级不能靠猜，1/mean(F) 是唯一有依据的起点。
# ===========================================================================
echo "==== Step 1: F 前置检查 ===="
if (( SWEEP == 1 )); then
  LAMBDA_GRID="${LAMBDA_LIST[*]}"
else
  LAMBDA_GRID="${LAMBDA}"
fi
export MODEL_DIR MODEL_NAME FISHER_PATH COV_PATH TARGET_MODULES LAMBDA LAMBDA_GRID DOMAIN
export FISHER_DIAG NORM_BY_LAYERS MIN_HOST_FREE_GIB SKIP_FP_CHECK
FISHER_REPORT_FILE="${TMPDIR}/fisher_preflight_${RUN}.txt"

if ! python - <<'PY' 2>&1 | tee "${FISHER_REPORT_FILE}"; then
import json
import math
import os
from pathlib import Path

import torch

model_dir = Path(os.environ["MODEL_DIR"]) / os.environ["MODEL_NAME"]
with open(model_dir / "config.json") as handle:
    cfg = json.load(handle)

hidden = cfg["hidden_size"]
inter = cfg["intermediate_size"]
layers = cfg["num_hidden_layers"]
heads = cfg["num_attention_heads"]
kv_heads = cfg.get("num_key_value_heads", heads)
head_dim = cfg.get("head_dim", hidden // heads)

# F_l 与权重同形，是 (out, in)。C 是 (in, in) —— 这张表就是把两者分开的判据，
# 同时也是「这份 F 是不是这个模型的」的判据（1.7B 的 hidden 是 2048）。
# k/v 在 GQA 下只有 kv_heads x head_dim 行，不是 hidden。
weight_shape = {
    "q_proj": (heads * head_dim, hidden),
    "k_proj": (kv_heads * head_dim, hidden),
    "v_proj": (kv_heads * head_dim, hidden),
    "o_proj": (hidden, heads * head_dim),
    "gate_proj": (inter, hidden),
    "up_proj": (inter, hidden),
    "down_proj": (hidden, inter),
    "lm_head": (cfg["vocab_size"], hidden),
}
targets = [item.strip() for item in os.environ["TARGET_MODULES"].split(",") if item.strip()]
unknown = [item for item in targets if item not in weight_shape]
if unknown:
    raise SystemExit(f"!! 未知模块名: {unknown}")
expect = sum(1 if item == "lm_head" else layers for item in targets)


def class_of(name):
    return name.rsplit(".", 1)[-1]


def load(path):
    try:
        return torch.load(path, map_location="cpu", mmap=True)
    except (TypeError, RuntimeError):
        # mmap 不可用就整份读进内存。训练时反正也要读一遍。
        return torch.load(path, map_location="cpu")


fisher_path = os.environ["FISHER_PATH"]
payload = load(fisher_path)
if isinstance(payload, dict) and "covariances" in payload and "fishers" not in payload:
    raise SystemExit(
        f"!! {fisher_path} 里是 covariances，不是 fishers。这是一份 C，"
        "本臂要的是 69 号采的 F。"
    )
fishers = payload["fishers"] if "fishers" in payload else payload
meta = payload.get("metadata", {}) if isinstance(payload, dict) else {}

print(f"F            = {fisher_path}")
print(f"config       = hidden {hidden} / intermediate {inter} / layers {layers} / "
      f"heads {heads} / kv_heads {kv_heads} / head_dim {head_dim}")
print(f"estimator    = {meta.get('estimator')}")
print(f"               loss_reduction={meta.get('loss_reduction')} "
      f"supervision={meta.get('supervision')} per_example_backward={meta.get('per_example_backward')}")
print(f"               use_bf16={meta.get('use_bf16')}（0 才是对的：bf16 会给平方梯度加约 1% 噪声底）")
print(f"metadata     = num_examples={meta.get('num_examples')} pool_rows={meta.get('pool_rows')} "
      f"max_len={meta.get('max_len')}")
print(f"               pool_fingerprint={meta.get('pool_fingerprint')}")
print(f"               model={meta.get('model_name')} target_modules={meta.get('target_modules')}")
print(f"层数         = {len(fishers)} / 期望 {expect} ({len(targets)} 类 x {layers} 层)")

failures = []
if len(fishers) != expect:
    got = sorted({class_of(key) for key in fishers})
    failures.append(
        f"层覆盖 {len(fishers)} != {expect}；F 里的模块类是 {got}。"
        "regularizer 对缺罚项矩阵的层静默跳过，拿这份去训等于只约束其中一部分。"
    )

got_classes = {class_of(key) for key in fishers}
missing_classes = sorted(set(targets) - got_classes)
extra_classes = sorted(got_classes - set(targets))
if missing_classes:
    failures.append(f"F 里缺这些模块类: {missing_classes}（LoRA 会挂上去但没有 F）")
if extra_classes:
    print(f"note: F 里多出 {extra_classes}，LoRA 不覆盖它们，正则用不到（不致命）")

print()
print("---- 形状核对（F 与权重同形 (out, in)；C 是 (in, in)，互换会在这里被抓到）")
print(f"{'module':<12}{'层数':>6}{'期望 (out, in)':>22}{'实际':>22}")
bad_dims = []
for cls in targets:
    keys = [key for key in fishers if class_of(key) == cls]
    want = weight_shape[cls]
    actual = tuple(fishers[keys[0]].shape) if keys else None
    print(f"{cls:<12}{len(keys):>6}{str(want):>22}{str(actual):>22}")
    for key in keys:
        if tuple(fishers[key].shape) != want:
            bad_dims.append(f"{key}: {tuple(fishers[key].shape)} 期望 {want}")
if bad_dims:
    failures.append(
        "形状不符（很可能拿到了 C 或别的模型的 F）: " + "; ".join(bad_dims[:4])
        + (f" ...共 {len(bad_dims)} 处" if len(bad_dims) > 4 else "")
    )

fisher_bytes = sum(mat.numel() * 4 for mat in fishers.values())  # 训练里统一升 fp32
weight_bytes = sum(p.stat().st_size for p in model_dir.glob("*.safetensors"))
gpu_total = (
    torch.cuda.get_device_properties(0).total_memory if torch.cuda.is_available() else 0
)
print()
print("---- 显存/内存预检")
print(f"F (fp32 常驻卡上)   {fisher_bytes / 2**30:7.2f} GiB")
print(f"权重 (bf16, 按盘上算) {weight_bytes / 2**30:7.2f} GiB")
if gpu_total:
    headroom = (gpu_total - fisher_bytes - weight_bytes) / 2**30
    print(f"卡上总容量           {gpu_total / 2**30:7.2f} GiB -> 余给激活/优化器 {headroom:.2f} GiB")
    if headroom < 8:
        failures.append(
            f"扣掉 F 与权重只剩 {headroom:.2f} GiB 给激活，几乎肯定 OOM。"
            "去掉 gate/up_proj（两者合占 F 一半）或换更大的卡。"
        )

# EWCRegularizer.from_path 先把整份 payload 读到 CPU 再逐层搬上卡，所以有一瞬间
# 主机上有完整一份。MemAvailable 不够的话进程会被 OOM killer 杀掉。
mem_available = 0
try:
    for line in Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            mem_available = int(line.split()[1]) * 1024
            break
except OSError:
    pass
if mem_available:
    need = fisher_bytes + float(os.environ["MIN_HOST_FREE_GIB"]) * 2**30
    print(f"主机 MemAvailable    {mem_available / 2**30:7.2f} GiB "
          f"(需要 >= {need / 2**30:.2f} GiB)")
    if mem_available < need:
        failures.append(
            f"主机可用内存 {mem_available / 2**30:.2f} GiB 装不下 F 的一份中转拷贝 "
            f"{fisher_bytes / 2**30:.2f} GiB，torch.load 会被 OOM killer 杀掉"
        )

# ---- 与 C 的池指纹比对：这条对比唯一的公平性凭据 ----
print()
if os.environ["SKIP_FP_CHECK"] == "1":
    print("SKIP_FP_CHECK=1：不与 C 比池指纹，「同一批行、两种编码」没有凭据。")
else:
    cov_meta = load(os.environ["COV_PATH"]).get("metadata", {})
    f_fp = meta.get("pool_fingerprint")
    c_fp = cov_meta.get("pool_fingerprint")
    print(f"F 的 pool_fingerprint = {f_fp}   rows={meta.get('pool_rows')}")
    print(f"C 的 pool_fingerprint = {c_fp}   rows={cov_meta.get('pool_rows')}")
    if not f_fp or not c_fp:
        failures.append(
            "F 或 C 的 metadata 里没有 pool_fingerprint，无法证明两者同池。"
            "可能是更早的脚本产的；重采，或传 SKIP_FP_CHECK=1 并在结果里注明。"
        )
    elif f_fp != c_fp:
        failures.append(
            f"池指纹不等（F {f_fp} vs C {c_fp}）。F 和 C 不是在同一批行上采的，"
            "这条对比里混进了「看的旧知识不同」这第二个变量。"
            "先核对 69/68 两边的 max_samples / sample_seed / sample_shuffle / 答案列。"
        )
    else:
        print("  -> 指纹一致，F 与 C 同池。这条臂与 70 号的差别只在 F vs C。")
    if meta.get("max_len") != cov_meta.get("max_len"):
        failures.append(
            f"max_len 不同（F {meta.get('max_len')} vs C {cov_meta.get('max_len')}）："
            "两边截断掉的 token 不一样，同一批行也看到了不同的内容。"
        )

# ---- 量级：λ 的起点只能从这里来 ----
if os.environ.get("FISHER_DIAG", "1") == "1":
    print()
    print("---- 量级（mean(F) = 全部元素的平均，λ 的起点取 1/mean）")
    per_class = {}
    totals = 0.0
    counts = 0
    overall_max = 0.0
    for key, mat in fishers.items():
        wide = mat.double()
        total = float(wide.sum())
        per_class.setdefault(class_of(key), []).append((total, mat.numel(), float(mat.max())))
        totals += total
        counts += mat.numel()
        overall_max = max(overall_max, float(mat.max()))
    print(f"{'module':<12}{'层数':>6}{'mean(F)':>16}{'max(F)':>16}")
    for cls in targets:
        rows = per_class.get(cls, [])
        if rows:
            csum = sum(item[0] for item in rows)
            cnum = sum(item[1] for item in rows)
            cmax = max(item[2] for item in rows)
            print(f"{cls:<12}{len(rows):>6}{csum / max(cnum, 1):>16.4e}{cmax:>16.4e}")
    mean_f = totals / max(counts, 1)
    print(f"{'全部':<12}{len(fishers):>6}{mean_f:>16.4e}{overall_max:>16.4e}")

    saved = (meta.get("fisher_scale") or {})
    if saved:
        print(f"69 号存下的 fisher_scale: mean={saved.get('mean'):.4e} max={saved.get('max'):.4e}")
        if saved.get("mean") and mean_f > 0:
            ratio = mean_f / float(saved["mean"])
            if not (0.99 < ratio < 1.01):
                failures.append(
                    f"这里算出的 mean(F)={mean_f:.4e} 与文件里记的 {saved['mean']:.4e} "
                    f"差 {ratio:.3f}x。文件可能被改过或读错了 key。"
                )

    # 扫描模式下这是整个网格，单点模式下只有一个元素。
    grid = [item for item in os.environ.get("LAMBDA_GRID", "").split() if item]
    print()
    if mean_f > 0:
        suggest = 1.0 / mean_f
        print(f"1/mean(F) = {suggest:.4e}   <- 起点")
        print(f"{'λ':>14}{'距起点几个十倍':>18}{'λ x mean(F)':>18}")
        for item in grid:
            lam = float(item)
            if lam > 0:
                decades = f"{math.log10(lam / suggest):+.2f}"
            else:
                decades = "-inf"
            print(f"{lam:>14.4e}{decades:>18}{lam * mean_f:>18.4e}")
        print("normalize_by_layers=1 已把层数除掉，所以这个乘积就是罚项的量级。")
        print("λR/task_loss 落在 0.01~1 之间算有效，远小于 0.01 就是罚项形同虚设，")
        print("大于 1 就是把模型锁死了。这个比值由扫描表或训练自检给出。")
        far = [
            item for item in grid
            if float(item) > 0 and abs(math.log10(float(item) / suggest)) > 4
        ]
        if far:
            print(f"!! 这些 λ 距 1/mean(F) 超过 4 个十倍: {far}")
            print("   先扫一遍看 λR/task_loss 落在哪，再决定正式跑哪三档。")
        print(f"MEAN_F={mean_f:.6e}")
    else:
        failures.append("mean(F) = 0：F 全是零，69 号那次采集没有产生梯度，重采。")

    # F 实际靠多少条样本撑着。远小于 num_examples 就说明它被少数长答案主导了。
    lw = meta.get("length_weighting") or {}
    if lw:
        print()
        print("---- 估计量诊断（69 号 Step 3 打过，这里再打一次以便和结果表放在一起）")
        print(f"examples={lw.get('examples')}  effective_sample_size={lw.get('effective_sample_size')}")
        print(f"ess_ratio={lw.get('ess_ratio')}   <- F 实际靠多少比例的样本撑着")
        print(f"length_exponent={lw.get('length_exponent')}   "
              "(1 = 逐 token 梯度不相关, 2 = 完全同向)")
        print(f"supervised tokens: mean={lw.get('mean_supervised_tokens')} "
              f"median={lw.get('median_supervised_tokens')} max={lw.get('max_supervised_tokens')}")
        print(f"zero_supervision_rows={lw.get('zero_supervision_rows')}")
        ess_ratio = lw.get("ess_ratio")
        if ess_ratio is not None and ess_ratio < 0.05:
            print(f"!! ess_ratio={ess_ratio:.4f} < 0.05：F 基本由极少数样本决定。"
                  "这不阻止训练，但结论里必须写上这个数 —— EWC 输给 OneReplay 时，")
            print("   「F 估得不准」和「Fisher 这个量本身不如 C」要分开说。")
else:
    print("FISHER_DIAG=0：跳过量级扫描（省一次整份 F 的读盘），只做 key/shape 检查。")

print()
if failures:
    print("!! F 前置检查未通过:")
    for item in failures:
        print(f"   - {item}")
    raise SystemExit(1)
print(f"F 前置检查通过。EXPECT_LAYERS={expect}")
PY
  echo "!! Step 1 未通过，不进入训练。"
  exit 1
fi

EXPECT_LAYERS="$(grep -o 'EXPECT_LAYERS=[0-9]*' "${FISHER_REPORT_FILE}" | tail -n 1)"
EXPECT_LAYERS="${EXPECT_LAYERS#EXPECT_LAYERS=}"
[[ -n "${EXPECT_LAYERS}" ]] || { echo "!! 没解析到 EXPECT_LAYERS，训练后的层数断言会失效。停。"; exit 1; }
echo "训练后要在日志里核对的层数: ${EXPECT_LAYERS}"

# FISHER_DIAG=0 时报告里没有这一行，表会把预测那一列打成 '-'，不影响实测列。
# || true 是必须的：grep 没匹配时退出码 1，在 set -e 下会把整个作业带走。
MEAN_F="$(grep -o 'MEAN_F=[0-9.eE+-]*' "${FISHER_REPORT_FILE}" | tail -n 1 || true)"
MEAN_F="${MEAN_F#MEAN_F=}"

if [[ "${DRY_RUN}" == "1" ]]; then
  echo ""
  echo "DRY_RUN=1：以上为计划与前置检查，未训练未评测。"
  if (( SWEEP == 1 )); then
    echo "确认无误后: qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDAS=${LAMBDAS//[ ,]/:} ${SELF_PATH}"
  else
    echo "确认无误后: qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=${LAMBDA} ${SELF_PATH}"
    echo "λ 的档位没底就先扫: qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDAS=0:<0.1x>:<1x>:<10x> ${SELF_PATH}"
  fi
  echo "Job finished at: $(date)"
  exit 0
fi

# ===========================================================================
# λ 扫描（PROBE，一个作业跑完整个网格）
#   每个 λ 各跑 MAX_STEPS 步，不存 adapter、不评测，末尾两张对照表 + 反推的 λ
#   建议。目的是把 F 的档位定下来，不是定最终的 λ——文件头写了为什么短跑的
#   λR/task_loss 只能当下界读。本臂尤其需要它：F 这边连档位都是估的。
# ===========================================================================
if (( SWEEP == 1 )); then
  SWEEP_TABLE="${TMPDIR}/lambda_sweep_${DOMAIN}_$$.tsv"
  : > "${SWEEP_TABLE}"
  SWEEP_FAIL=()
  # 一个共享的 map_cache：tokenize 与 λ 无关，而 commonsense.py 那边写死了
  # load_from_cache_file=False，每个 λ 反正都要重 tokenize 一遍，共享只是省磁盘。
  SWEEP_MAP_CACHE="${RESULTS_ROOT}/map_cache/sweep_${RUN_TAG}_maxlen${MAXLEN}_seed${SEED}"
  mkdir -p "${SWEEP_MAP_CACHE}"

  for lam in "${LAMBDA_LIST[@]}"; do
    probe_run="$(run_name_for "${lam}")"
    probe_log="${TRAIN_LOG_DIR}/${probe_run}.train.log"
    probe_metrics="${RESULTS_ROOT}/metrics/${probe_run}.jsonl"
    # 短跑的 jsonl 每次从头写：同一个 λ 投两次时，追加会让下面的表读到上一次的行。
    rm -f "${probe_metrics}"
    # λ=0 是标尺行，只测 R 不加罚；其余点不需要这个开关（λ>0 时必然会加载）。
    if python -c "import sys; sys.exit(0 if float('${lam}') > 0 else 1)"; then
      MEASURE_ZERO=0
    else
      MEASURE_ZERO=1
    fi
    echo ""
    echo "==== sweep: λ=${lam}, ${MAX_STEPS} 步 -> ${probe_run} ===="
    # 一个点崩了不该把整张表带走：记下来，继续下一个 λ，末尾统一报。
    TRAIN_RC=0
    set -x
    python -m onereplay.scripts.train --paradigm sft \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
      --dataset_path "${DS_DATASET}" \
      --epochs "${EPOCHS}" --lr "${LR}" --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
      --eval_batch_size "${EVAL_BATCH}" \
      --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" --max_len "${MAXLEN}" \
      --lora_rank "${LORA_RANK}" --lora_alpha "${LORA_ALPHA}" --lora_dropout "${LORA_DROPOUT}" \
      --target_modules "${TARGET_MODULES}" \
      --map_cache_dir "${SWEEP_MAP_CACHE}" \
      --max_steps "${MAX_STEPS}" --log_every "${LOG_EVERY}" \
      --regularizer "${REGULARIZER}" \
      --fisher_path "${FISHER_PATH}" --replay_lambda "${lam}" \
      --measure_replay_when_lambda_zero "${MEASURE_ZERO}" \
      --cov_path "" --identity_cov 0 \
      --normalize_replay_by_layers "${NORM_BY_LAYERS}" \
      --reg_once_per_update "${REG_ONCE}" \
      --save 0 \
      --metrics_path "${probe_metrics}" 2>&1 | tee "${probe_log}" || TRAIN_RC=$?
    set +x
    # 层覆盖每个 λ 都查一遍：只查第一个的话，后面某次加载出问题就看不出来。
    # 顺带查一句 F 的来源：cov_path 传的是空串，别让它悄悄退回协方差那条路。
    if (( TRAIN_RC != 0 )); then
      SWEEP_FAIL+=("λ=${lam}: train.py 退出码 ${TRAIN_RC}，见 ${probe_log}")
    elif ! grep -qF -- \
      "regularizer covers ${EXPECT_LAYERS} layers; no penalty matrix for 0 layers" \
      "${probe_log}"; then
      SWEEP_FAIL+=("λ=${lam}: 日志里没有 'regularizer covers ${EXPECT_LAYERS} layers; no penalty matrix for 0 layers'")
    elif grep -qF -- "covariance matrices from" "${probe_log}"; then
      SWEEP_FAIL+=("λ=${lam}: 日志里出现了 'covariance matrices from'，罚项来自 C 而不是 F")
    fi
    printf '%s\t%s\t%s\n' "${lam}" "${probe_metrics}" "${probe_log}" >> "${SWEEP_TABLE}"
  done

  echo ""
  echo "========================================================================"
  echo "λ 扫描汇总：保护 ${DOMAIN}   F=${FISHER_PATH}"
  echo "每点 ${MAX_STEPS} 步 x batch ${BATCH} / accum ${ACCUM}（约 $(( MAX_STEPS * BATCH / ACCUM )) 次参数更新）"
  echo "========================================================================"
  SUMMARY_RC=0
  SWEEP_TABLE="${SWEEP_TABLE}" MEAN_F="${MEAN_F}" \
  WANT_STEPS="${MAX_STEPS}" WANT_UPDATES="$(( MAX_STEPS * BATCH / ACCUM ))" \
  python - <<'PY' || SUMMARY_RC=$?
import json
import math
import os
import re

STEP_RE = re.compile(
    r"step (\d+)/(\d+) task_loss=([0-9.eE+-]+) replay_reg=([0-9.eE+-]+)"
)


def last_epoch_record(path):
    found = None
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                if not line.strip():
                    continue
                row = json.loads(line)
                if row.get("epoch") is not None:
                    found = row
    return found


def step_points(path):
    """日志里每个 log_every 记录点的 (step, task_loss, R)。"""
    points = []
    if os.path.isfile(path):
        with open(path, encoding="utf-8", errors="replace") as handle:
            for line in handle:
                match = STEP_RE.search(line)
                if match:
                    points.append(
                        (int(match.group(1)), float(match.group(3)), float(match.group(4)))
                    )
    return points


def cell(value, spec="12.4e"):
    return f"{'-':>{spec.split('.')[0]}}" if value is None else f"{value:>{spec}}"


mean_f = os.environ.get("MEAN_F", "").strip()
mean_f = float(mean_f) if mean_f else None
suggest = 1.0 / mean_f if mean_f else None

rows = []
with open(os.environ["SWEEP_TABLE"], encoding="utf-8") as handle:
    for line in handle:
        parts = line.rstrip("\n").split("\t")
        if len(parts) == 3:
            rows.append(parts)

records = []
for lam_str, metrics_path, log_path in rows:
    record = last_epoch_record(metrics_path)
    records.append(
        {
            "lam_str": lam_str,
            "lam": float(lam_str),
            "task": None if record is None else record.get("train_task_loss"),
            "reg": None if record is None else record.get("train_replay_reg"),
            "val": None if record is None else record.get("val_loss"),
            "points": step_points(log_path),
            "ok": record is not None,
        }
    )

dead = [item["lam_str"] for item in records if not item["ok"]]
if dead:
    print(f"!! 这些 λ 没有 epoch 记录（训练没跑完就退了，去对应的 train.log 里看）: {dead}")

print()
print("---- 表 A: 罚项量级（λR/task 的绝对值是下界，看的是趋势与相对关系）")
print(
    f"{'λ':>12}{'距1/mean(F)':>14}{'λxmean(F)':>14}{'R':>13}{'λR':>13}"
    f"{'λR/task':>12}{'λR/task@首':>13}{'λR/task@末':>13}"
)
for item in records:
    lam, reg, task = item["lam"], item["reg"], item["task"]
    decades = "-" if (suggest is None or lam <= 0) else f"{math.log10(lam / suggest):+.2f}"
    predicted = None if mean_f is None else lam * mean_f
    lam_reg = None if reg is None else lam * reg
    ratio = None if (lam_reg is None or not task) else lam_reg / task
    first = last = None
    if item["points"]:
        _, t_first, r_first = item["points"][0]
        _, t_last, r_last = item["points"][-1]
        first = lam * r_first / t_first if t_first else None
        last = lam * r_last / t_last if t_last else None
    print(
        f"{lam:>12.4e}{decades:>14}{cell(predicted, '14.4e')}{cell(reg, '13.4e')}"
        f"{cell(lam_reg, '13.4e')}{cell(ratio, '12.4e')}"
        f"{cell(first, '13.4e')}{cell(last, '13.4e')}"
    )

ref = next((item for item in records if item["lam"] == 0.0 and item["ok"]), None)
print()
print("---- 表 B: 罚项对新任务的代价（Δ 都是相对 λ=0 那一行）")
print(
    f"{'λ':>12}{'task_loss':>13}{'Δtask':>12}{'val_loss':>13}"
    f"{'Δval':>12}{'R/R(λ=0)':>12}"
)
for item in records:
    d_task = d_val = r_ratio = None
    if ref is not None:
        if item["task"] is not None and ref["task"] is not None:
            d_task = item["task"] - ref["task"]
        if item["val"] is not None and ref["val"] is not None:
            d_val = item["val"] - ref["val"]
        if item["reg"] is not None and ref["reg"]:
            r_ratio = item["reg"] / ref["reg"]
    print(
        f"{item['lam']:>12.4e}{cell(item['task'], '13.6f')}{cell(d_task, '12.4e')}"
        f"{cell(item['val'], '13.6f')}{cell(d_val, '12.4e')}{cell(r_ratio, '12.4f')}"
    )

print()
if ref is None or not ref["task"] or not ref["reg"]:
    print("网格里没有可用的 λ=0 标尺行，反推不了 λ。下次把 0 加进 LAMBDAS。")
else:
    t0, r0 = ref["task"], ref["reg"]
    print(f"---- λ 反推（标尺: λ=0 时 task_loss={t0:.6f}, R={r0:.6e}）")
    print("λ ≈ 目标占比 x task_loss / R(λ=0)：")
    for target in (1e-2, 3e-2, 1e-1, 3e-1, 1.0):
        print(f"   λR/task_loss = {target:>7.0e}  ->  λ ≈ {target * t0 / r0:.4e}")
    if suggest:
        print()
        print(f"对比 1/mean(F) = {suggest:.4e}：那是各向同性假设下的起点，"
              "上面这些是实测 R 反推的。")
        print("两者差几个十倍，就是「F 的大质量落在 ΔW 没走的方向上」这件事有多严重。")
    print()
    print(f"!! 这些数只在 {os.environ['WANT_STEPS']} 步（约 "
          f"{os.environ['WANT_UPDATES']} 次参数更新）这个时点上成立。ΔW 还在长，R 会")
    print("   继续变大而 task_loss 会继续降，所以同一个 λ 到训练末期的实际占比会比")
    print("   这里大。要挑档位就往这张表偏小的一侧取。")

print()
print("---- 怎么读这两张表")
print("1. R/R(λ=0) ≈ 1 的那些 λ 完全没约束住 ΔW，不用再花完整 run 去试。")
print("2. λR/task@末 已经 >1 的那些 λ 罚项在主导 loss，也可以直接排除。")
print("3. 剩下的区间里挑一个档位，再按十倍上下各扫一档跑完整 run（本臂是十倍，")
print("   不是 70 号的 0.5x/2x：F 这边连档位都是估的）。")
print("4. EWC 最后输给 OneReplay 时，这张表是区分两种原因的证据：λ 根本没扫到有效")
print("   区间（表里全是 R/R(0)≈1），还是扫到了、罚项确实起作用了但保留仍然更差。")

if dead:
    # 训练退出码是 0 却没写下 epoch 记录，说明它在写 metrics 之前就结束了。
    raise SystemExit(1)
PY

  echo ""
  if (( ${#SWEEP_FAIL[@]} > 0 )); then
    echo "!! 扫描过程中的断言失败:"
    for item in "${SWEEP_FAIL[@]}"; do echo "   - ${item}"; done
    echo "   层覆盖没对上的那些点，R 是残缺 F 算出来的；崩掉的那些点整行都无效。"
    echo "   两种情况都不能拿表里的数去定 λ。"
    echo "Job finished at: $(date)"
    exit 1
  fi
  if (( SUMMARY_RC != 0 )); then
    echo "!! 汇总脚本退出码 ${SUMMARY_RC}：有 λ 缺 epoch 记录（表里那一行是 '-'），"
    echo "   原因见上面的 '没有 epoch 记录' 那句和对应的 train.log。"
    echo "Job finished at: $(date)"
    exit 1
  fi
  echo "扫描完成。每个 λ 的层覆盖都是 ${EXPECT_LAYERS} 层，罚项都来自 F。"
  echo "定了档位之后投正式 run（三次，互不覆盖）:"
  echo "   qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=<0.1x> ${SELF_PATH}"
  echo "   qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=<1x>   ${SELF_PATH}"
  echo "   qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=<10x>  ${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi
set -x

# ===========================================================================
# 训练
#   profile 保持 0：它每阶段插 cuda synchronize，会污染要上报的墙钟。
#   peak memory / epoch wall time / covariance_memory_gb 不开 profile 也照样
#   写进 metrics jsonl（EWC 时 covariance_memory_gb 记的就是 F 的常驻大小）。
#
#   --cov_path ""：build_regularizer 在 ewc 分支上只看 fisher_path，cov_path
#   完全不参与。但它的默认值指向 1.7B 的一个路径，留着会被记进 metrics 让人
#   以为这条 run 读过 C。显式清空。
# ===========================================================================
if [[ "${DO_TRAIN}" == "1" ]]; then
  if [[ "${FORCE_TRAIN}" != "1" && "${SAVE}" == "1" && -d "${ADAPTERS}/${RUN}" ]]; then
    echo "跳过训练 ${RUN}：adapter 已存在（FORCE_TRAIN=1 可强制重训）"
  else
    mkdir -p "${RESULTS_ROOT}/map_cache/${RUN}"
    echo "==== train: ${RUN} (F=${FISHER_PATH} λ=${LAMBDA}) ===="
    # 训练输出同时留一份文件：层覆盖那句只在 stdout 上，metrics jsonl 里没有。
    python -m onereplay.scripts.train --paradigm sft \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
      --dataset_path "${DS_DATASET}" \
      --epochs "${EPOCHS}" --lr "${LR}" --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
      --eval_batch_size "${EVAL_BATCH}" \
      --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" --max_len "${MAXLEN}" \
      --lora_rank "${LORA_RANK}" --lora_alpha "${LORA_ALPHA}" --lora_dropout "${LORA_DROPOUT}" \
      --target_modules "${TARGET_MODULES}" \
      --map_cache_dir "${RESULTS_ROOT}/map_cache/${RUN}" \
      --max_steps "${MAX_STEPS}" --log_every "${LOG_EVERY}" \
      --regularizer "${REGULARIZER}" \
      --fisher_path "${FISHER_PATH}" --replay_lambda "${LAMBDA}" \
      --cov_path "" --identity_cov 0 \
      --normalize_replay_by_layers "${NORM_BY_LAYERS}" \
      --reg_once_per_update "${REG_ONCE}" \
      --save "${SAVE}" --save_path "${ADAPTERS}/${RUN}" \
      --metrics_path "${RESULTS_ROOT}/metrics/${RUN}.jsonl" 2>&1 | tee "${TRAIN_LOG}"
  fi
fi

# ===========================================================================
# 训练自检 1：日志里的运行期证据
#   train.py 启动时会把全部 args 打出来，trainer 在第一步打出正则的实际层覆盖。
#   这两处是「命令行传对了」和「F 真的对上了 LoRA 层」的唯一证据，metrics
#   jsonl 里都没有。所以这里查文件而不是查 jsonl。
# ===========================================================================
set +x
if [[ -f "${TRAIN_LOG}" ]]; then
  echo "==== 训练自检 1: 日志 (${TRAIN_LOG}) ===="
  LOG_FAIL=()
  assert_log () {
    if ! grep -qF -- "$1" "${TRAIN_LOG}"; then
      LOG_FAIL+=("找不到 '$1'   <- $2")
    else
      echo "  ok  $1"
    fi
  }
  # 这一句是全脚本最重要的断言：正则实际覆盖了多少层。
  assert_log "regularizer covers ${EXPECT_LAYERS} layers; no penalty matrix for 0 layers" \
    "正则没有覆盖全部 ${EXPECT_LAYERS} 层。F 与 LoRA 的层集合没对上，方法被削掉了一部分。"
  # 走的是 EWC 分支才会打 "Fisher matrices"；走成协方差分支会打 "covariance matrices"。
  assert_log "Fisher matrices from ${FISHER_PATH}" \
    "没有从 ${FISHER_PATH} 加载 F。要么路径没传进去，要么走了协方差分支。"
  assert_log "TARGET_MODULES=${TARGET_MODULES}" "LoRA/正则的层覆盖与 74 号不同"
  assert_log "LORA_RANK=${LORA_RANK}" "rank 与 74 号不同"
  assert_log "LORA_ALPHA=${LORA_ALPHA}" "alpha 与 74 号不同（scale=α/r 变了，λ 的尺子也变了）"
  assert_log "LORA_DROPOUT=${LORA_DROPOUT}" "dropout 与 74 号不同"
  assert_log "MAX_LEN=${MAXLEN}" "新任务的 token 预算与 74 号不同"
  assert_log "NORMALIZE_REPLAY_BY_LAYERS=${NORM_BY_LAYERS}" \
    "层归一化开关与 λ 换算的前提不符，λ 的量级会整体偏掉一个 ${EXPECT_LAYERS} 倍"
  assert_log "REGULARIZER=ewc" "跑的不是 EWC"
  assert_log "FISHER_PATH=${FISHER_PATH}" "命令行里的 fisher_path 与本次要用的不符"
  # 反向断言：走成协方差分支的话日志里必然有这一句。
  if grep -q "covariance matrices from" "${TRAIN_LOG}"; then
    LOG_FAIL+=("日志里出现了 'covariance matrices from'   <- 加载的是 C 不是 F，这条 run 作废。")
  fi
  if (( ${#LOG_FAIL[@]} > 0 )); then
    echo ""
    echo "!! 日志自检失败:"
    for item in "${LOG_FAIL[@]}"; do echo "   - ${item}"; done
    echo "   （若这是一次续跑、日志来自上一次投递，先确认它对应的就是当前 run）"
    exit 1
  fi
  echo "日志自检通过。"
else
  echo "note: 没有 ${TRAIN_LOG}，跳过日志自检（DO_TRAIN=0 或 adapter 是上一次投递训的）"
fi

# ===========================================================================
# 训练自检 2：metrics jsonl 里的配置与罚项量级
#   penalty_path 是这里最要紧的一项：train.py 在 ewc 分支上把它记成 fisher_path，
#   所以它既能证明"用的是 F 不是 C"，又能证明用的是**本域**那份 F。
#   λR/task_loss 是 λ 扫描真正要看的量（罚项在总 loss 里的占比）。
#   文档 2.2 节定的主表口径是「同等或更好的 val loss 下旧能力保留更多」，
#   所以 val_loss 必须和 vanilla 并排出现，不能只报 delta。
# ===========================================================================
METRICS_FILE="${RESULTS_ROOT}/metrics/${RUN}.jsonl"
if [[ -f "${METRICS_FILE}" ]]; then
  echo "==== 训练自检 2: metrics (${METRICS_FILE}) ===="
  RUN_METRICS="${METRICS_FILE}" \
  VANILLA_METRICS="${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl" \
  ONEREPLAY_METRICS="${ONEREPLAY_METRICS:-}" \
  WANT_LAMBDA="${LAMBDA}" WANT_FISHER="${FISHER_PATH}" WANT_REG="${REGULARIZER}" \
  WANT_ACCUM="${ACCUM}" WANT_EVAL_BATCH="${EVAL_BATCH}" WANT_EPOCHS="${EPOCHS}" \
  WANT_REG_ONCE="${REG_ONCE}" \
  VANILLA_NAME="${VANILLA_RUN}" \
  python - <<'PY'
import json
import os


def load_epochs(path):
    rows = []
    if not path or not os.path.isfile(path):
        return rows
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if not line.strip():
                continue
            row = json.loads(line)
            if row.get("epoch") is not None:
                rows.append(row)
    return rows


epochs = load_epochs(os.environ["RUN_METRICS"])
if not epochs:
    raise SystemExit(f"{os.environ['RUN_METRICS']} 里没有 epoch 记录，训练没跑完一个 epoch")
last = epochs[-1]

want_lambda = float(os.environ["WANT_LAMBDA"])
want_fisher = os.environ["WANT_FISHER"]
want_epochs = int(os.environ["WANT_EPOCHS"])

# train.py 把罚项的来源文件统一记成 penalty_path（EWC 时就是 fisher_path），
# 不是 fisher_path 这个名字。字段名对不上会读到 None 而不是报错。
penalty_path = str(last.get("penalty_path") or "")

print(f"records         = {len(epochs)} 条 epoch 记录（含历史追加），最后一条 epoch={last.get('epoch')}")
print(f"regularizer     = {last.get('regularizer')}")
print(f"penalty_path    = {penalty_path}")
print(f"replay_lambda   = {last.get('replay_lambda')} (want {want_lambda})")
print(f"reg_once        = {last.get('reg_once_per_update')}")
print(f"accumulation    = {last.get('accumulation_size')} (want {os.environ['WANT_ACCUM']})")
print(f"eval_batch_size = {last.get('eval_batch_size')} (want {os.environ['WANT_EVAL_BATCH']})")
# 这个字段名沿用 C 那边，EWC 时记的是 F 的常驻大小（约 25.9 GiB，比 C 小）。
print(f"F 常驻显存      = {last.get('covariance_memory_gb')} GB")

failures = []
if str(last.get("regularizer")) != os.environ["WANT_REG"]:
    failures.append(f"regularizer={last.get('regularizer')}，不是 {os.environ['WANT_REG']}")
if abs(float(last.get("replay_lambda") or 0.0) - want_lambda) > 1e-12:
    failures.append(f"λ 记录为 {last.get('replay_lambda')}，与本次要求的 {want_lambda} 不符")
if not penalty_path:
    failures.append(
        "metrics 里没有 penalty_path。train.py 的 extra_record 改过字段名的话这个"
        "自检就形同虚设，先去核对再重训"
    )
elif penalty_path != want_fisher:
    failures.append(f"penalty_path 记录为 {penalty_path}，不是本次要用的 {want_fisher}")
elif "_qv" in os.path.basename(penalty_path):
    failures.append(f"penalty_path {penalty_path!r} 是 qv 版，只覆盖 2/7 的层")
elif os.path.basename(penalty_path).startswith("cov_"):
    failures.append(
        f"penalty_path {penalty_path!r} 是一份 C。这条 run 名叫 ewc 但罚项来自协方差。"
    )
if int(last.get("reg_once_per_update") or 0) != int(os.environ["WANT_REG_ONCE"]):
    failures.append(f"reg_once_per_update={last.get('reg_once_per_update')}")
if int(last.get("accumulation_size") or 0) != int(os.environ["WANT_ACCUM"]):
    failures.append(f"accumulation_size={last.get('accumulation_size')}，与 74 号不符")
if int(last.get("eval_batch_size") or 0) != int(os.environ["WANT_EVAL_BATCH"]):
    failures.append(f"eval_batch_size={last.get('eval_batch_size')}，val_loss 与其余臂不可比")
if int(last.get("epoch") or 0) != want_epochs:
    failures.append(f"最后一条记录是 epoch {last.get('epoch')}，没跑满 {want_epochs} 个 epoch")

def cell(value, spec=".6f", width=14):
    """None 也要占位：缺字段时表格不能错列，否则一眼看不出是哪一列缺。"""

    return f"{'-' if value is None else format(value, spec):>{width}}"


print()
print("---- 罚项量级与新任务性能")
print(f"{'epoch':>6}{'task_loss':>14}{'R':>14}{'λR':>14}{'λR/task':>12}{'val_loss':>14}")
tail = epochs[-want_epochs:] if len(epochs) >= want_epochs else epochs
for row in tail:
    task = row.get("train_task_loss")
    lam_reg = row.get("train_lambda_reg")
    ratio = (lam_reg / task) if (task and lam_reg is not None) else None
    print(
        f"{row.get('epoch'):>6}"
        + cell(task)
        + cell(row.get("train_replay_reg"), ".4e")
        + cell(lam_reg, ".4e")
        + cell(ratio, ".4f", 12)
        + cell(row.get("val_loss"))
    )
if not (last.get("train_replay_reg") or 0) > 0:
    failures.append(
        "train_replay_reg = 0：罚项没有起作用。F 加载了但一层都没对上，"
        "或者 λ 被吃掉了。这一臂等于 vanilla，别拿去当结果。"
    )

ratios = [
    row["train_lambda_reg"] / row["train_task_loss"]
    for row in tail
    if row.get("train_task_loss") and row.get("train_lambda_reg") is not None
]
if ratios:
    worst = max(ratios)
    if worst < 1e-3:
        print()
        print(f"!! λR/task_loss 最大只有 {worst:.2e}：罚项形同虚设，这条 run 与 vanilla "
              "几乎没有区别。λ 至少再调大三个十倍。")
    elif worst > 5:
        print()
        print(f"!! λR/task_loss 到了 {worst:.2f}：罚项主导了 loss，模型被锁死。"
              "评测分数不是保护效果，λ 调小若干十倍再看。")

vanilla = load_epochs(os.environ.get("VANILLA_METRICS", ""))
print()
if vanilla:
    v_last = vanilla[-1]
    print(f"vanilla ({os.environ['VANILLA_NAME']}) val_loss = {v_last.get('val_loss')}")
    print(f"本臂                                   val_loss = {last.get('val_loss')}")
    if v_last.get("val_loss") and last.get("val_loss"):
        delta = last["val_loss"] - v_last["val_loss"]
        print(f"差值 = {delta:+.6f}  （<=0 就是新任务没被罚项拖慢，主表要的就是这一点）")
    print(f"墙钟 train_sec 本臂 {last.get('train_sec')} / vanilla {v_last.get('train_sec')}")
    print(f"峰值显存 本臂 {last.get('peak_memory_gb')} / vanilla {v_last.get('peak_memory_gb')}")
else:
    print("note: 找不到 vanilla 的 metrics，val_loss 没有分母。74 号跑完再回来看这一行。")

# 与 OneReplay 同域那条并排。不传 ONEREPLAY_METRICS 就跳过，不是必须的。
one = load_epochs(os.environ.get("ONEREPLAY_METRICS", ""))
if one:
    o_last = one[-1]
    print()
    print("---- 与 70 号 OneReplay 同域并排（F vs C，同一批行）")
    print(f"{'':<12}{'val_loss':>12}{'train_sec':>12}{'peak_GB':>10}{'常驻_GB':>10}{'λ':>12}")
    for name, row in (("OneReplay", o_last), ("EWC", last)):
        print(
            f"{name:<12}"
            + cell(row.get("val_loss"), ".6f", 12)
            + cell(row.get("train_sec"), ".0f", 12)
            + cell(row.get("peak_memory_gb"), ".2f", 10)
            + cell(row.get("covariance_memory_gb"), ".2f", 10)
            + cell(row.get("replay_lambda"), ".2e", 12)
        )
    print("两条的 λ 不可直接比大小：F 与 C 的量级差好几个十倍，看 λR/task_loss 才有意义。")

if failures:
    print()
    print("!! 训练自检失败:")
    for item in failures:
        print(f"   - {item}")
    raise SystemExit(1)
print()
print("训练自检通过。")
PY
else
  echo "note: 没有 ${METRICS_FILE}，跳过 metrics 自检"
fi
set -x

# ===========================================================================
# 评测：按域走口径，解码预算与 batch 与 74 号逐字相同
# ===========================================================================
if [[ "${DO_EVAL}" != "1" ]]; then
  echo "DO_EVAL=0：跳过评测。评测单独投: qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=${LAMBDA},DO_TRAIN=0 ${SELF_PATH}"
  set +x
  echo "Job finished at: $(date)"
  exit 0
fi

# 缺哪个数据就跳过哪个指标（数据没搬全时不至于整个作业白挂）。
AVAIL=""
for m in ${DOMAIN_METRICS}; do
  case "${m}" in
    ifeval)    [[ -f "${IFEVAL_INPUT}"   ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 ifeval：缺 ${IFEVAL_INPUT}" ;;
    gsm8k)     [[ -f "${GSM8K_FILE}"     ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 gsm8k：缺 ${GSM8K_FILE}" ;;
    math500)   [[ -f "${MATH500_FILE}"   ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 math500：缺 ${MATH500_FILE}" ;;
    humaneval) [[ -f "${HUMANEVAL_FILE}" ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 humaneval：缺 ${HUMANEVAL_FILE}" ;;
    mbpp)      [[ -d "${MBPP_DIR}"       ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 mbpp：缺 ${MBPP_DIR}" ;;
  esac
done
AVAIL="${AVAIL# }"
if [[ -z "${AVAIL}" ]]; then
  echo "本域要评的指标一个数据都没找到，跳过评测"
  set +x
  echo "Job finished at: $(date)"
  exit 0
fi
echo "AVAIL=[${AVAIL}]"

# base 的 adapter 路径是空串：evaluate.py 认这个，直接加载裸模型。
# base 与 vanilla 默认不重评（74 号已经评过、结果就在同一个 OUT_DIR 里）。
EVAL_SPECS="${RUN};${ADAPTERS}/${RUN}"
if [[ "${WITH_BASE}" == "1" ]]; then
  EVAL_SPECS="base;|${EVAL_SPECS}"
fi
if [[ "${WITH_VANILLA}" == "1" ]]; then
  EVAL_SPECS="${EVAL_SPECS}|${VANILLA_RUN};${ADAPTERS}/${VANILLA_RUN}"
fi
if [[ -n "${EXTRA_MODELS}" ]]; then
  EVAL_SPECS="${EVAL_SPECS}|${EXTRA_MODELS}"
fi

pending_metrics () {
  # $1=run_name, 其余=候选 metric。已有 summary.json 的跳过，除非 FORCE_EVAL=1。
  local name=$1; shift
  local out=""
  for m in "$@"; do
    if [[ "${FORCE_EVAL}" == "1" || ! -f "${OUT_DIR}/${m}/${name}/summary.json" ]]; then
      out="${out}${out:+,}${m}"
    fi
  done
  echo "${out}"
}

EVAL_NAMES=()
IFS='|' read -ra SPECS <<< "${EVAL_SPECS}"
for spec in "${SPECS[@]}"; do
  name="${spec%%;*}"
  adapter="${spec#*;}"
  if [[ -n "${adapter}" && ! -d "${adapter}" ]]; then
    echo "跳过评测 ${name}：找不到 adapter ${adapter}"
    continue
  fi
  EVAL_NAMES+=("${name}")
  # shellcheck disable=SC2086
  mp="$(pending_metrics "${name}" ${AVAIL})"
  if [[ -z "${mp}" ]]; then
    echo "跳过评测 ${name}：所有指标都已有结果（FORCE_EVAL=1 可重评）"
    continue
  fi
  echo "==== eval: ${name} (${mp}) ===="
  # 一次调用跑完本域所有指标：runner 只加载一次模型，8B 的加载不便宜。
  python -m onereplay.scripts.evaluate \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    --adapter_path "${adapter}" --run_name "${name}" \
    --metrics "${mp}" --out_dir "${OUT_DIR}" --seed "${SEED}" \
    --limit "${LIMIT}" \
    --math_max_new_tokens "${MATH_MAX_NEW_TOKENS}" \
    --code_max_new_tokens "${CODE_MAX_NEW_TOKENS}" \
    --max_new_tokens "${IF_MAX_NEW_TOKENS}" \
    --math_batch_size "${MATH_BATCH}" \
    --code_batch_size "${CODE_BATCH}" \
    --ifeval_batch_size "${IFEVAL_BATCH}" \
    --math500_data_path "${MATH500_FILE}" \
    --gsm8k_data_path "${GSM8K_FILE}" \
    --humaneval_data_file "${HUMANEVAL_FILE}" \
    --mbpp_dataset_path "${MBPP_DIR}" --dataset_split "${MBPP_SPLIT}" \
    --ifeval_input "${IFEVAL_INPUT}" \
    --timeout "${TIMEOUT}" \
    --cache_dir "${TMPDIR}/hf_datasets"
done

# ---------------------------------------------------------------------------
# 长度/截断诊断
#   两个用途：
#   1) 预算够不够 —— hit-cap 接近 0 且 P99 远低于 cap 就说明富余，可以调小省时间；
#      反过来 hit-cap 高就必须调大后**所有臂全部重评**，截断偏差跨 run 不均匀。
#   2) 罚项有没有把模型锁死 —— λ 太大时输出会变短变呆，P50 相对 base/vanilla
#      暴跌就是这个信号，此时分数高低都不作数。
#   no-answer 那一列对 gsm8k 就是「缺 '####' 的比例」，文档 6.3 要求单列报它。
# ---------------------------------------------------------------------------
length_diagnostic () {
  python - "${MODEL_DIR}/${MODEL_NAME}" "$@" <<'PY'
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

model_path, specs = sys.argv[1], sys.argv[2:]
tokenizer = AutoTokenizer.from_pretrained(model_path)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


print("==== response length / truncation diagnostic ====")
for spec in specs:
    path, cap = spec.rsplit(":", 1)
    cap = int(cap)
    file = Path(path)
    if not file.is_file():
        continue
    rows = [json.loads(line) for line in file.open(encoding="utf-8") if line.strip()]
    if not rows:
        continue
    # 各 metric 的字段名不同：数学写 response，代码写 raw，ifeval 写 response。
    texts = [row.get("response", row.get("raw", "")) for row in rows]
    lengths = sorted(
        len(tokenizer(text, add_special_tokens=False)["input_ids"]) for text in texts
    )
    hit_cap = sum(length >= cap - 8 for length in lengths)
    if "prediction" in rows[0]:
        missing = sum(row.get("prediction") in (None, "") for row in rows)
        miss_label = f"no-answer={missing} ({missing / len(rows):.1%}) "
    else:
        miss_label = ""
    label = f"{file.parent.parent.name}/{file.parent.name}"
    print(
        f"{label:>66}: n={len(rows)} cap={cap} {miss_label}"
        f"hit-cap={hit_cap} ({hit_cap / len(rows):.1%}) "
        f"P50={pct(lengths, 50)} P90={pct(lengths, 90)} P99={pct(lengths, 99)} "
        f"max={lengths[-1]}"
    )
print("")
print("读法 1（预算）: hit-cap 接近 0 且 P99 远低于 cap => 可以调小 cap 省时间。")
print("读法 2（λ 过大）: 本臂 P50 相对 base/vanilla 暴跌 => 罚项把模型锁死了，")
print("                 这种情况下分数不是保护效果，扫小一档 λ 再看。")
PY
}

if [[ "${DIAG_LEN}" == "1" ]]; then
  DIAG_SPECS=()
  # base 与 vanilla 的 responses.jsonl 是 74 号留下的，一起打出来才能比 P50。
  DIAG_RUNS=("base" "${VANILLA_RUN}" "${RUN}")
  for name in "${DIAG_RUNS[@]}"; do
    for m in ${AVAIL}; do
      case "${m}" in
        gsm8k|math500) cap="${MATH_MAX_NEW_TOKENS}" ;;
        humaneval|mbpp) cap="${CODE_MAX_NEW_TOKENS}" ;;
        *) cap="${IF_MAX_NEW_TOKENS}" ;;
      esac
      DIAG_SPECS+=("${OUT_DIR}/${m}/${name}/responses.jsonl:${cap}")
    done
  done
  length_diagnostic "${DIAG_SPECS[@]}"
fi

# ---------------------------------------------------------------------------
# 汇总：base / vanilla / 本臂并排
#   delta_base 是遗忘量（负数越大越坏），delta_van 是本臂相对 vanilla 救回来
#   多少（正数越大越好）。后者才是这个方法的效果，前者只是标尺。
# ---------------------------------------------------------------------------
set +x
echo ""
echo "========================================================================"
echo "结果汇总：保护 ${DOMAIN}   EWC λ=${LAMBDA}"
echo "F = ${FISHER_PATH}"
echo "========================================================================"
OUT_DIR="${OUT_DIR}" RUN_NAME="${RUN}" VANILLA_NAME="${VANILLA_RUN}" \
METRIC_NAMES="${AVAIL}" \
RUN_METRICS="${RESULTS_ROOT}/metrics/${RUN}.jsonl" \
VANILLA_METRICS="${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl" \
python - <<'PY'
import json
import os
from pathlib import Path

out_dir = Path(os.environ["OUT_DIR"])
run_name = os.environ["RUN_NAME"]
vanilla_name = os.environ["VANILLA_NAME"]
metric_names = os.environ["METRIC_NAMES"].split()

# 各 metric 的主分数字段名不同，按这个顺序取第一个命中的。
SCORE_KEYS = ("accuracy", "pass_at_1", "strict_prompt_accuracy")


def read_score(metric, name):
    path = out_dir / metric / name / "summary.json"
    if not path.is_file():
        return None
    payload = json.loads(path.read_text(encoding="utf-8"))
    for key in SCORE_KEYS:
        if key in payload:
            return payload[key]
    return None


def cell(value, spec=".4f", width=10):
    return f"{'-' if value is None else format(value, spec):>{width}}"


print(f"{'metric':<12}{'base':>10}{'vanilla':>10}{'ewc':>11}{'d_base(pp)':>12}{'d_van(pp)':>11}")
print("-" * 66)
for metric in metric_names:
    base = read_score(metric, "base")
    van = read_score(metric, vanilla_name)
    ours = read_score(metric, run_name)
    d_base = (ours - base) * 100 if (base is not None and ours is not None) else None
    d_van = (ours - van) * 100 if (van is not None and ours is not None) else None
    print(
        f"{metric:<12}"
        + cell(base)
        + cell(van)
        + cell(ours, ".4f", 11)
        + cell(d_base, "+.2f", 12)
        + cell(d_van, "+.2f", 11)
    )


def last_epoch(path):
    if not path or not os.path.isfile(path):
        return {}
    rows = []
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                row = json.loads(line)
                if row.get("epoch") is not None:
                    rows.append(row)
    return rows[-1] if rows else {}


ours_m = last_epoch(os.environ.get("RUN_METRICS"))
van_m = last_epoch(os.environ.get("VANILLA_METRICS"))
print()
print("新任务性能与开销（主表必须带上 val_loss，见文档 2.2 节第 1 条）:")
print(f"{'':<14}{'val_loss':>12}{'train_sec':>12}{'peak_mem_GB':>13}{'F_mem_GB':>10}")
for label, row in (("vanilla", van_m), ("ewc", ours_m)):
    print(
        f"{label:<14}"
        + cell(row.get("val_loss"), ".6f", 12)
        + cell(row.get("train_sec"), ".0f", 12)
        + cell(row.get("peak_memory_gb"), ".2f", 13)
        + cell(row.get("covariance_memory_gb"), ".2f", 10)
    )
if ours_m.get("val_loss") and van_m.get("val_loss"):
    delta = ours_m["val_loss"] - van_m["val_loss"]
    print(f"val_loss 差值 = {delta:+.6f}")
    if delta <= 0:
        print("  <= 0：新任务没被罚项拖慢，上面的 d_van 可以直接当保护效果读。")
    else:
        print("  > 0：新任务学得更差了，d_van 里有一部分是'少学了'而不是'保住了'。")
        print("       报结果时必须同时给这两个数，否则就是拿新任务性能换旧能力。")
PY

