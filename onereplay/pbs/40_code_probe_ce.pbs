#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_codeprobece
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o /scratch/weiliu87/logs/onereplay/
#
# =============================================================================
# NUS Hopper (PBS + Singularity): 代码侧的 held-out CE 探针
#   对已有 checkpoint 在固定语料上算交叉熵。只做前向，不生成，全程约 20-40 分钟。
#   这是 37 号（数学探针）的代码孪生版，口径、脚本、bootstrap 全部复用。
#
# -----------------------------------------------------------------------------
# 为什么要这个（和 37 号同一个理由，方向相反）
#   39 号已经拿到代码侧唯一一处显著结果：MBPP vanilla 掉 3.80pp（p=0.0319）。但
#   失败分桶显示这 3.8pp 全是语法错误暴涨 21 倍扛下来的，断言失败纹丝不动——也就是
#   "格式坏了、算法没坏"。pass@1 只有 500 题，配对量程 3.30pp，若 OneReplay 消除
#   60% 只救回约 2.28pp，低于量程，根本测不出保护效果（要 80% 功效需约 2100 题）。
#
#   CE 探针把这件事从"勉强能发现伤害"升级成"能测量保护"：它在数学侧把 1.67pp 的
#   不显著差异变成了 7.5 倍的清晰漂移，纯 CPU/GPU 前向，几十分钟一趟。
#
# -----------------------------------------------------------------------------
# 探针语料从哪来：不生成，复用 39 号的产物 + 源数据集重建 prompt
#   代码的 responses.jsonl 只存 completion（已过 cleanup_completion 清洗），没有
#   prompt、没有原始输出。所以 Step0 用 build_code_probe：
#     * 从 ${CODE_DATA_DIR} 的 humaneval parquet / mbpp save_to_disk 重建 prompt
#       （用 metric 自己的 build_prompt / build_mbpp_prompt，逐字一致）
#     * 按 task_id join 回 base 的 completion，用清洗后的 completion 作 target
#   用清洗后的 completion 作 target 其实更干净（target 是"合法且能解题的代码"，
#   preamble 和尾部垃圾已剥掉），但要在论文里标明 target 是 post-cleanup。
#
#   探针题目和 benchmark 题目完全相同，所以"同一批题上 CE 动了 X 倍、语法错误涨了
#   21 倍、断言失败没动"是关于同一个集合的陈述。
#
# -----------------------------------------------------------------------------
# 免费红利：cif / cmix 是数学/IF 侧的正则 checkpoint，采它们时还没有 C_code。
#   把它们也在代码探针上跑一遍 = 跨领域泛化的数据点：
#     它们若对代码也有可观保护  => C 的主导方向共享得比第四章估计的还多
#     基本没用                  => 正好证明 C_code 是必要的，是 C_code 实验的动机铺垫
#
#   cifcode（41/42 号产出的 C_if + C_code 等权混合）也在默认 MODELS 里。adapter 还
#   不存在时只会打一行「跳过」，训完重投就自动带上。最关键的一对比较是
#   cif vs cifcode —— 它的配对差与双侧 p 值由 bootstrap 给出（默认关，见文末命令）。
#
# -----------------------------------------------------------------------------
# 口径与 37 号 / 训练期探针完全一致（score_probe_ce 没有重写任何 loss）
#   只对 assistant token 求 CE、token 加权平均、enable_thinking=False、shuffle=False、
#   左 padding。所以打出来的数和 37 号、和 metrics jsonl 的 probe_* 字段可并排读。
#   **所有 run 必须用同一个 MAX_LEN 才可比。** 代码回答比数学短，2048 一般绰绰有余，
#   Step0 会打印 target token 分位数、Step1 会打印顶到 MAX_LEN 的行数供核对。
#
# -----------------------------------------------------------------------------
# 用法:
#   qsub onereplay/pbs/40_code_probe_ce.pbs
#
#   只重建语料不打分:   SKIP_SCORE=1
#   只打分不重建语料:   SKIP_BUILD=1
#   换模型集合:         MODELS="base vanilla cmix"
#   加大 max_len:       MAX_LEN=4096（显存不够就把 PROBE_BATCH 降到 4）
#   顺带出误差棒:       DO_BOOTSTRAP=1（默认关；也可评完在登录节点单独跑，见文末）
#
# 前置条件:
#   1) 39 号产物: ${RESULTS_ROOT}/{humaneval,mbpp}/base/responses.jsonl
#   2) 代码源数据（登录节点用 download_code_data 下好）:
#      ${CODE_DATA_DIR}/humaneval_test.parquet、${CODE_DATA_DIR}/mbpp_full/
#   3) adapter 就位: ${RESULTS_ROOT}/adapters/{cs_vanilla_seed1,
#      cs_onereplay_balanced_lam3e-2_seed1_regonce,
#      cs_onereplay_ifmath_lam3e-2_seed1_regonce}
#   4) 日志目录先建好: mkdir -p /scratch/weiliu87/logs/onereplay
#
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/40_code_probe_ce.pbs}"

IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    # 写成 if 而不是 `[[ -f x ]] && source x && break`：后者在第一个候选不存在时
    # 整条 && 列表返回 1，set -e 会当场把作业干掉（坑 #18）。既有 31/32/37/39 号
    # 沿用的是旧写法，只因 Hopper 上 module 一直是已定义的、这段从没真正执行过。
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      if [[ -f "${_init}" ]]; then
        source "${_init}"
        break
      fi
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME RESULTS_ROOT PROBE_DIR CODE_DATA_DIR
    MODELS VANILLA_RUN IF_RUN MIX_RUN CODE_MIX_RUN SEED
    MBPP_SPLIT MAX_LEN PROBE_BATCH PROBE_SIZE CAP
    ROW_BATCH VERIFY_AGG BOOT_REPS BOOT_COMPARE
    SKIP_BUILD SKIP_SCORE DO_BOOTSTRAP
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"

  echo "Image           : ${IMAGE}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv

# ---- 项目路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results}"
ADAPTERS="${ADAPTERS:-${RESULTS_ROOT}/adapters}"
CODE_DATA_DIR="${CODE_DATA_DIR:-${REPO_ROOT}/datasets/code}"
# 单开一个目录，别和 37 号的数学探针 scores.jsonl / per_row 混在一起。
PROBE_DIR="${PROBE_DIR:-${RESULTS_ROOT}/probe_ce_code}"
CORPUS_DIR="${PROBE_DIR}/corpora"
SCORES="${PROBE_DIR}/scores.jsonl"

HUMANEVAL_FILE="${CODE_DATA_DIR}/humaneval_test.parquet"
MBPP_SPLIT="${MBPP_SPLIT:-test}"       # 见 39 号：默认的 validation 只有 90 题
MBPP_DIR="${CODE_DATA_DIR}/mbpp_full"

# ---- run 名（见 37/35 号文件头：Hopper 上纯 C_if 是 balanced 那份）----
SEED="${SEED:-1}"
VANILLA_RUN="${VANILLA_RUN:-cs_vanilla_seed${SEED}}"
IF_RUN="${IF_RUN:-cs_onereplay_balanced_lam3e-2_seed${SEED}_regonce}"
MIX_RUN="${MIX_RUN:-cs_onereplay_ifmath_lam3e-2_seed${SEED}_regonce}"
# 42 号训出来的 C_if + C_code 混合。列在默认 MODELS 里是有意的：adapter 还不存在时
# 下面的循环只打一行「跳过」，一旦 42 号训完，重投本作业就自动把它带上，不用手改。
CODE_MIX_RUN="${CODE_MIX_RUN:-cs_onereplay_ifcode_lam3e-2_seed${SEED}_regonce}"
MODELS="${MODELS:-base vanilla cif cmix cifcode}"

# ---- 探针参数（所有 run 必须一致）----
MAX_LEN="${MAX_LEN:-2048}"
PROBE_BATCH="${PROBE_BATCH:-8}"
PROBE_SIZE="${PROBE_SIZE:-0}"     # 0 = 用整个语料
CAP="${CAP:-512}"                 # responses.jsonl 生成时的 code_max_new_tokens（见 39 号）
ROW_BATCH="${ROW_BATCH:-4}"       # 逐行那一遍的 batch；vocab 15 万，别调太大
VERIFY_AGG="${VERIFY_AGG:-1}"     # 1 = 顺带用 evaluate_probe 核对逐行求和是否一致
BOOT_REPS="${BOOT_REPS:-10000}"
SKIP_BUILD="${SKIP_BUILD:-0}"
SKIP_SCORE="${SKIP_SCORE:-0}"
DO_BOOTSTRAP="${DO_BOOTSTRAP:-0}"    # 误差棒默认不跑，作业只出 CE 点估计；见文末
PER_ROW_DIR="${PROBE_DIR}/per_row"

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
mkdir -p "${CORPUS_DIR}"

# ---------------------------------------------------------------------------
# Step 0: 由 39 号的 base/responses.jsonl + 源数据集重建探针语料（纯 CPU，几秒）
# ---------------------------------------------------------------------------
if [[ "${SKIP_BUILD}" != "1" ]]; then
  echo "==== Step0 build code probe corpora -> ${CORPUS_DIR} ===="
  BUILD_ARGS=()
  # humaneval / mbpp 各自的 base responses；缺哪个就跳哪个（其余照跑）。
  # 用 if 而不是 `[[ ... ]] && arr+=(...)`：后者在文件不存在时整条 && 列表返回 1，
  # set -e 会直接把作业干掉（19 号踩过）。
  HE_RESP="${RESULTS_ROOT}/humaneval/base/responses.jsonl"
  MB_RESP="${RESULTS_ROOT}/mbpp/base/responses.jsonl"
  if [[ -f "${HE_RESP}" && -f "${HUMANEVAL_FILE}" ]]; then
    BUILD_ARGS+=(--responses "humaneval=${HE_RESP}")
  else
    echo "跳过 humaneval：缺 ${HE_RESP} 或 ${HUMANEVAL_FILE}"
  fi
  if [[ -f "${MB_RESP}" && -d "${MBPP_DIR}" ]]; then
    BUILD_ARGS+=(--responses "mbpp=${MB_RESP}")
  else
    echo "跳过 mbpp：缺 ${MB_RESP} 或 ${MBPP_DIR}"
  fi
  if [[ ${#BUILD_ARGS[@]} -eq 0 ]]; then
    echo "两个 base responses.jsonl 都不在（或缺源数据），无法建语料"; exit 1
  fi
  BUILD_ARGS+=(
    --humaneval_data_file "${HUMANEVAL_FILE}"
    --mbpp_dataset_path "${MBPP_DIR}" --mbpp_split "${MBPP_SPLIT}"
    --out_dir "${CORPUS_DIR}" --model_path "${MODEL_DIR}/${MODEL_NAME}"
    --cap "${CAP}" --cache_dir "${JOB_TMPDIR}/hf_datasets"
  )

  python -m onereplay.scripts.build_code_probe "${BUILD_ARGS[@]}"
else
  echo "SKIP_BUILD=1：沿用已有语料 ${CORPUS_DIR}"
fi

# ---------------------------------------------------------------------------
# Step 1: 逐个 checkpoint 打分
# ---------------------------------------------------------------------------
resolve_path () {
  case "$1" in
    base)    echo "" ;;
    vanilla) echo "${ADAPTERS}/${VANILLA_RUN}" ;;
    cif)     echo "${ADAPTERS}/${IF_RUN}" ;;
    cmix)    echo "${ADAPTERS}/${MIX_RUN}" ;;
    cifcode) echo "${ADAPTERS}/${CODE_MIX_RUN}" ;;
    *)       echo "" ;;
  esac
}

resolve_name () {
  case "$1" in
    base)    echo "base" ;;
    vanilla) echo "${VANILLA_RUN}" ;;
    cif)     echo "${IF_RUN}" ;;
    cmix)    echo "${MIX_RUN}" ;;
    cifcode) echo "${CODE_MIX_RUN}" ;;
    *)       echo "$1" ;;
  esac
}

if [[ "${SKIP_SCORE}" != "1" ]]; then
  PROBES=""
  for corpus in probe_humaneval_base probe_mbpp_base; do
    file="${CORPUS_DIR}/${corpus}.jsonl"
    [[ -f "${file}" ]] || continue
    short="${corpus#probe_}"; short="${short%_base}"
    PROBES="${PROBES},${short}=${file}"
  done
  PROBES="${PROBES#,}"
  [[ -n "${PROBES}" ]] || { echo "没有可用的探针语料"; exit 1; }
  echo "PROBES=${PROBES}"

  # 重跑时先挪走旧结果：scores.jsonl 是 append 的，混着两次的行没法读。
  # per_row 也要清：文件名不含 max_len，换了参数重跑会留下口径不同的旧行，
  # 而 bootstrap 只看行数对不对得上，混进去不会报错（11 号踩过）。
  if [[ -f "${SCORES}" ]]; then
    STAMP="$(date +%Y%m%d_%H%M%S)"
    mv "${SCORES}" "${SCORES}.${STAMP}.bak"
    if [[ -d "${PER_ROW_DIR}" ]]; then
      mv "${PER_ROW_DIR}" "${PER_ROW_DIR}_${STAMP}.bak"
    fi
  fi
  mkdir -p "${PER_ROW_DIR}"

  for short in ${MODELS}; do
    name="$(resolve_name "${short}")"
    path="$(resolve_path "${short}")"
    if [[ -n "${path}" && ! -d "${path}" ]]; then
      echo "跳过 ${short}：缺 ${path}"
      continue
    fi
    python -m onereplay.scripts.score_probe_ce \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
      --adapter_path "${path}" --run_name "${name}" \
      --probes "${PROBES}" \
      --max_len "${MAX_LEN}" --batch_size "${PROBE_BATCH}" \
      --row_batch_size "${ROW_BATCH}" --verify_aggregate "${VERIFY_AGG}" \
      --probe_size "${PROBE_SIZE}" \
      --map_cache_dir "${JOB_TMPDIR}/probe_map_${short}" \
      --per_row_dir "${PER_ROW_DIR}" \
      --out "${SCORES}"
  done
fi

# ---------------------------------------------------------------------------
# Step 1b: 配对 bootstrap
#   CE 表本身能说 base->vanilla 漂了多少、cif/cmix 消除了多少，但没有误差棒就分不清
#   真实排序和几次同向的抛硬币。重采样单位是行，且同一组重采样索引施加到所有 run
#   上（配对），因为各 run 打的是同一批行，方差里"这一行本来就难"那部分是共享的，
#   作差就抵消了。纯 CPU，几十秒。
# ---------------------------------------------------------------------------
if [[ "${DO_BOOTSTRAP}" == "1" ]]; then
  # bootstrap_probe_ce 会报这个列表里**每一个有序对**的配对差与双侧 p 值。
  # 代码线最关键的那一对是 cif vs cifcode：它决定「C_code 是否必要」。
  # 列表里不存在的 run 会被自动忽略（它按 per_row 目录里实际有的文件求交集）。
  BOOT_COMPARE="${BOOT_COMPARE:-${IF_RUN},${MIX_RUN},${CODE_MIX_RUN}}"
  python -m onereplay.scripts.bootstrap_probe_ce \
    --per_row_dir "${PER_ROW_DIR}" \
    --base base --vanilla "${VANILLA_RUN}" \
    --compare "${BOOT_COMPARE}" \
    --replicates "${BOOT_REPS}" --seed "${SEED}" \
    --out "${PROBE_DIR}/bootstrap.json" || true
fi

# ---------------------------------------------------------------------------
# Step 2: 汇成对照表，并把 CE 折算成"相对 base 的倍数"
# ---------------------------------------------------------------------------
set +x
python - "${SCORES}" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
if not path.is_file():
    print(f"没有 {path}，跳过汇总")
    raise SystemExit(0)

rows = [json.loads(line) for line in path.open(encoding="utf-8") if line.strip()]
if not rows:
    raise SystemExit(0)

probes = [k[len("probe_"):] for k in rows[0] if k.startswith("probe_")]
base = next((r for r in rows if r["run_name"] == "base"), None)

print()
print("=" * 100)
print(f"代码侧 held-out CE（max_len={rows[0]['max_len']}，token 加权平均，越低越接近 base）")
print("=" * 100)

header = f"{'run':<48}" + "".join(f"{p:>16}" for p in probes)
print("\n" + header)
for row in rows:
    line = f"{row['run_name']:<48}"
    for p in probes:
        value = row.get(f"probe_{p}")
        line += f"{value:>16.5f}" if value is not None else f"{'--':>16}"
    print(line)

if base is not None:
    print(f"\n相对 base 的倍数（1.00 = 完全没动）")
    print(header)
    for row in rows:
        line = f"{row['run_name']:<48}"
        for p in probes:
            value, ref = row.get(f"probe_{p}"), base.get(f"probe_{p}")
            line += f"{value / ref:>16.3f}" if value and ref else f"{'--':>16}"
        print(line)

print(f"\n{'run':<48}" + "".join(f"{p + '@max_len':>18}" for p in probes))
for row in rows:
    line = f"{row['run_name']:<48}"
    for p in probes:
        cut, total = row.get(f"{p}_rows_at_max_len"), row.get(f"{p}_rows")
        line += f"{f'{cut}/{total}':>18}" if total else f"{'--':>18}"
    print(line)

print()
print("参照：39 号里 MBPP vanilla 相对 base 掉 3.80pp（p=0.0319），全靠语法错误涨 21 倍，")
print("断言失败纹丝不动。CE 若在 vanilla 上明显大于 1，就把这件'格式坏了、算法没坏'的事")
print("量化成了连续信号；cif/cmix 若把倍数压回接近 1，说明数学/IF 侧的 C 跨领域也保护了")
print("代码的输出结构；若没压回，正好证明 C_code 是必要的。")
print("最后一张表是顶到 max_len 的行数：代码回答短，占比应当很低，高了说明 MAX_LEN 设小了。")
PY

echo "========================================================================"
echo "产物:"
echo "  语料  : ${CORPUS_DIR}/probe_*.jsonl + manifest.json"
echo "  分数  : ${SCORES}（每个 run 一行）"
echo "  逐行  : ${PER_ROW_DIR}/<run>__<corpus>.jsonl（bootstrap 的输入，已落盘）"
echo ""
echo "本作业只出 CE 点估计（DO_BOOTSTRAP=0）。误差棒与 cif vs cifcode 的配对差读的是"
echo "上面的逐行文件，不上 GPU，纯 CPU 几十秒，在登录节点上补即可："
echo "  python -m onereplay.scripts.bootstrap_probe_ce \\"
echo "    --per_row_dir ${PER_ROW_DIR} --base base --vanilla ${VANILLA_RUN} \\"
echo "    --compare ${IF_RUN},${MIX_RUN},${CODE_MIX_RUN} \\"
echo "    --out ${PROBE_DIR}/bootstrap.json"
echo "要让本作业自己跑，投递前设 DO_BOOTSTRAP=1。"
echo "Job finished at: $(date)"
