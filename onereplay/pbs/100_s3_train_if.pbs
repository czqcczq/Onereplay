      fi
    fi
  fi

  # -------------------------------------------------------------------------
  # 汇总：主表 + （SOURCE=cs 时）常识八子集分解 + FollowBench 分级曲线。
  #
  # 主表左半 = 旧能力保留、右半 = 新任务学到多少，**每个生成式分数右边紧跟它自己的
  # 响应词数中位数**。这不是锦上添花：本线的输出长度往变长变杂的方向漂（Conifer 答案
  # p50 = 144 词、54.7% 带列表），而 IFEval/FollowBench 里相当一部分约束本质在量长度
  # （Part 1 第 8c 节），数学侧的 \boxed{} 抽取和常识侧的 extract_label 更是直接受害。
  # 分数和 words 分开看就会把长度漂移读成能力变化。
  #
  # SOURCE=cs 的 acc_logprob 是唯一不需要配 words 读的数（闭集排序、不解码）。
  #
  # words 用 len(response.split()) 从各自的 responses.jsonl 现算，与 followbench 的
  # response_shape 同一个定义，所以 fb 那列和它 summary.json 里的 response_words_p50 一致。
  # -------------------------------------------------------------------------
  python - "${RESULTS_ROOT}" "${SOURCE}" <<'PY' || true
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
source = sys.argv[2]
OLD = ("gsm8k", "math500") if source == "math" else ("commonsense_qa",)
METRICS = OLD + ("ifeval", "followbench")

names: set[str] = set()
for metric in METRICS:
    directory = root / metric
    if directory.is_dir():
        names.update(path.name for path in directory.iterdir() if path.is_dir())
if not names:
    print("\n没有可汇总的 summary.json")
    raise SystemExit(0)


def sort_key(name: str):
    # anchor 在最上面（它是 before 那一行），然后 vanilla，然后 protected 臂按 λ 排。
    rank = 0 if name.endswith("_anchor") else (1 if "vanilla" in name else 2)
    return (rank, name)


order = sorted(names, key=sort_key)


def load(metric: str, name: str):
    path = root / metric / name / "summary.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else None


def words_p50(metric: str, name: str):
    path = root / metric / name / "responses.jsonl"
    if not path.is_file():
        return None
    counts = []
    with path.open(encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                counts.append(len(str(json.loads(line).get("response", "")).split()))
    if not counts:
        return None
    counts.sort()
    return counts[len(counts) // 2]


def pct(payload, key, width):
    if payload is None or payload.get(key) is None:
        return "-".rjust(width)
    return f"{payload[key] * 100:.1f}".rjust(width)


def num(value, width, fmt="{:.0f}"):
    return ("-" if value is None else fmt.format(value)).rjust(width)


print()
print("=" * 116)
print(f"Stage 3: Model-{source} --Conifer--> Model-{source}-IF")
print("  左半 = 旧能力保留多少   右半 = 新任务学到多少   words = 该指标自己的响应词数中位数")
if source == "cs":
    print("  CS 那四列都是八任务宏平均。logp 是主口径；gen 只能配着 parse 读；rand 是塌缩后的地板。")
else:
    print("  数学两列必须配着上面那张 length diagnostic 的 hit-cap / no-answer 读。")
print("=" * 116)
if source == "math":
    print(
        f"{'run':<40}{'GSM8K':>8}{'words':>7}{'MATH500':>9}{'words':>7}"
        f"{'IFEval':>8}{'words':>7}{'FB HSR':>8}{'words':>7}"
    )
else:
    print(
        f"{'run':<40}{'CS logp':>9}{'CS gen':>8}{'parse':>7}{'rand':>7}"
        f"{'IFEval':>8}{'words':>7}{'FB HSR':>8}{'words':>7}"
    )
for name in order:
    ifeval = load("ifeval", name)
    fb = load("followbench", name)
    levels = [fb.get(f"rule_hsr_level_{level}") for level in range(1, 6)] if fb else []
    levels = [value for value in levels if value is not None]
    fb_mean = f"{sum(levels) / len(levels) * 100:.1f}".rjust(8) if levels else "-".rjust(8)
    if source == "math":
        gsm8k = load("gsm8k", name)
        math500 = load("math500", name)
        old_cells = (
            pct(gsm8k, "accuracy", 8)
            + num(words_p50("gsm8k", name), 7)
            + pct(math500, "accuracy", 9)
            + num(words_p50("math500", name), 7)
        )
    else:
        cs = load("commonsense_qa", name)
        old_cells = (
            pct(cs, "average_acc_logprob", 9)
            + pct(cs, "average_acc_gen", 8)
            + pct(cs, "average_parse_rate", 7)
            + pct(cs, "average_random_baseline", 7)
        )
    print(
        f"{name:<40}"
        + old_cells
        + pct(ifeval, "strict_prompt_accuracy", 8)
        + num(words_p50("ifeval", name), 7)
        + fb_mean
        + num(words_p50("followbench", name), 7)
    )

# 宏平均会把「某一个子任务塌了」摊平，而遗忘往往不是均匀的 —— 哪个子任务先塌是这条线
# 能给出的一个额外发现，所以单独列一张。
if source == "cs":
    cs_rows = [(name, load("commonsense_qa", name)) for name in order]
    cs_rows = [(name, payload) for name, payload in cs_rows if payload]
    if cs_rows:
        tasks = sorted({task for _, payload in cs_rows for task in payload.get("tasks", [])})
        print()
        print("=" * 116)
        print("常识八子集的 acc_logprob 分解（%，最后一列是宏平均，就是主表的 CS logp）")
        print("=" * 116)
        header = "".join(task[:9].rjust(10) for task in tasks)
        print(f"{'run':<34}{header}{'AVG':>9}")
        for name, payload in cs_rows:
            cells = "".join(
                pct(payload.get("per_task", {}).get(task), "acc_logprob", 10) for task in tasks
            )
            print(f"{name:<34}{cells}" + pct(payload, "average_acc_logprob", 9))
        missing = {
            name: payload["tasks_missing"]
            for name, payload in cs_rows
            if payload.get("tasks_missing")
        }
        if missing:
            print()
            print(f"!! 有 run 少评了子集: {missing}")
            print("   AVERAGE 是宏平均，子集不同的两行之间那一列不可比。补齐后重看。")

old_name = "数学分" if source == "math" else "CS logp"
print()
print("怎么读:")
print(f"  遗忘量  = {source}_anchor 的 {old_name} − 该臂的 {old_name}")
print(f"  保护效果 = onereplay 的 {old_name} − vanilla 的 {old_name}")
print("  代价    = vanilla 的 IF 分 − onereplay 的 IF 分（保护换来的可塑性损失）")
print("  三个数要一起看：只报第二个而不报第三个，等于用「少学新任务」冒充「保住旧能力」。")
print()
if source == "math":
    print("**数学分数必须配着上面那张 length diagnostic 的 hit-cap / no-answer 读。** 保留目标")
    print("是长 CoT 推理，而 Conifer 把输出推长推杂：vanilla 可能因为格式跑偏、走不到")
    print("\\boxed{} 而数学分虚低（看着像遗忘），protected 臂把权重拉回 Model-Math、倾向保住")
    print("数学文体。Part 3 那轮实测过这个陷阱：三条臂 acc_all 差到 0.098/0.144/0.456，但在都")
    print("吐出 \\boxed 的公共子集上是 0.345/0.318/0.664 —— 差距大半来自格式和截断。")
else:
    print("**CS logp 是主口径，而且它是三条线里唯一不受输出长度影响的保留指标**：闭集排序、")
    print("不解码、不正则匹配，所以遗忘量可以直接读，不像数学分要配着 hit-cap 才有可比性。")
    print("这是本来源的方法学优势，写结果时值得点明。")
    print()
    print("**CS gen 掉了不等于遗忘。** 它测的是「还会不会按训练格式作答」，而 Stage 2 必然把")
    print("输出从 7-8 个 token 推长推杂（Conifer 答案 p50 = 144 词），所以 gen 和 parse 一起")
    print("掉是预期行为。只有 logp 掉了才是常识能力掉了。两者分道扬镳时看诊断表的 agree。")
    print()
    print("**rand 那一列是地板不是零。** 候选集只有 2-5 个，塌成单一 label 的模型也能拿到这个")
    print("分数（宏平均约 35%）。CS logp 掉到 rand 附近 = 塌了，不是「还剩三分之一能力」。")
    print("配着诊断表的 mode 那一列看：接近 1 就是塌缩确认。")
print()
print("**IF 分数升降先看 words 再谈能力。** 新任务把输出往变长变杂推，而 IFEval/FollowBench")
print("里不少约束本质在量长度（见 results_log/2026-09-12 第 8c 节）。")
print()
print("**FB HSR 不是 FollowBench 全量分数**：只有 rule 那一半（350/820 行、70/164 组），")
print("style 类覆盖为 0，format 类只覆盖 2/30，example 类还有 2 组是退化的。judge 那")
print("470 行要在有网的地方过 judge_followbench.py 才能补齐 164 组（见 92 号文件头）。")

# FollowBench 的价值在分级曲线而不是单值：它报的是模型在第几级开始塌。本线里它是
# **新任务**的曲线，读的是「学会了到第几级」而不是「保住了到第几级」。
fb_rows = [(name, load("followbench", name)) for name in order]
fb_rows = [(name, payload) for name, payload in fb_rows if payload]
if fb_rows:
    print()
    print("=" * 108)
    print("FollowBench rule 侧分级曲线（HSR %，CSL 是 0-5 的级数）")
    print("=" * 108)
    print(f"{'run':<40}{'L1':>7}{'L2':>7}{'L3':>7}{'L4':>7}{'L5':>7}{'CSL':>8}{'empty':>7}")
    for name, payload in fb_rows:
        cells = "".join(pct(payload, f"rule_hsr_level_{level}", 7) for level in range(1, 6))
        print(
            f"{name:<40}{cells}"
            + num(payload.get("rule_csl"), 8, "{:.2f}")
            + num(payload.get("response_empty"), 7)
        )
PY
fi

