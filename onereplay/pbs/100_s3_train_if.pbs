    else
      # 格式/塌缩：分辨「忘了常识」「忘了格式」「塌成猜一个词」三件事。
      #
      # math 那边的 hit-cap 诊断在这里没有对应物 —— 主口径 acc_logprob 不解码，没有
      # 右删失可言。逐 task 打，因为候选集大小和塌缩程度按 task 差很多（boolq 只有
      # true/false，hellaswag 有四个 ending）：
      #
      #   parse_rate 掉 + logprob 没掉  -> 忘的是**格式**不是常识。Conifer 把输出从
      #                                    7-8 个 token 推到 144 词，extract_label
      #                                    抽不到那个 label。acc_gen 的下降不是遗忘证据。
      #   agree（logprob 与 gen 一致率）-> 两个 scorer 在多少行上给出同一个 label。它掉
      #                                    说明生成路径开始答非所问，而排序路径还知道答案。
      #   mode share（众数占比）        -> 接近 1 = 预测塌成单一 label，模型在猜不在答。
      #                                    这种模型的 acc 会停在 random_baseline 附近而
      #                                    不是 0，不看这一列会把「塌了」读成「还剩一半」。
      #   hit-cap                       -> 撞 CS_MAX_NEW_TOKENS 的行。答案只要 7-8 个
      #                                    token，撞上限就是格式漂移的证据。
      DIAG_FILE="${RESULTS_ROOT}/commonsense_qa/${DIAG_NAME}/responses.jsonl"
      if [[ -f "${DIAG_FILE}" ]]; then
        python - "${MODEL_DIR}/${MODEL_NAME}" "${CS_MAX_NEW_TOKENS}" "${DIAG_FILE}" <<'PY'
import collections
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

model_path, cap, path = sys.argv[1], int(sys.argv[2]), Path(sys.argv[3])
tokenizer = AutoTokenizer.from_pretrained(model_path, trust_remote_code=True)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


by_task: dict[str, list[dict]] = collections.defaultdict(list)
with path.open(encoding="utf-8") as handle:
    for line in handle:
        if line.strip():
            row = json.loads(line)
            by_task[str(row.get("task", "?"))].append(row)

print(f"==== commonsense 生成侧诊断 (cap={cap})  {path.parent.name} ====")
print(
    f"{'task':<16}{'n':>6}{'parse':>8}{'agree':>8}{'mode':>8}"
    f"{'mode_lbl':>11}{'hit-cap':>9}{'tokP50':>8}{'tokP90':>8}{'max':>6}"
)
for task in sorted(by_task):
    rows = by_task[task]
    total = len(rows)
    # gen 那一路关掉时 responses.jsonl 里没有 response/gen_pred 字段，这几列打 '-'。
    has_gen = "gen_pred" in rows[0]
    has_logprob = "logprob_pred" in rows[0]

    if has_gen:
        lengths = sorted(
            len(tokenizer(str(row.get("response", "")), add_special_tokens=False)["input_ids"])
            for row in rows
        )
        parsed = sum(1 for row in rows if row.get("gen_pred"))
        hit_cap = sum(1 for length in lengths if length >= cap - 2)
        parse_cell = f"{parsed / total:.3f}".rjust(8)
        cap_cell = f"{hit_cap / total:.1%}".rjust(9)
        len_cells = f"{pct(lengths, 50):>8}{pct(lengths, 90):>8}{lengths[-1]:>6}"
    else:
        parse_cell, cap_cell = "-".rjust(8), "-".rjust(9)
        len_cells = f"{'-':>8}{'-':>8}{'-':>6}"

    if has_gen and has_logprob:
        both = [row for row in rows if row.get("gen_pred")]
        agree = sum(1 for row in both if row["gen_pred"] == row["logprob_pred"])
        agree_cell = (f"{agree / len(both):.3f}" if both else "-").rjust(8)
    else:
        agree_cell = "-".rjust(8)

    # 众数按主口径的预测算（logprob 没跑就退回 gen）。
    key = "logprob_pred" if has_logprob else ("gen_pred" if has_gen else None)
    if key:
        counts = collections.Counter(str(row.get(key, "")) for row in rows)
        label, count = counts.most_common(1)[0]
        mode_cell = f"{count / total:.3f}".rjust(8)
        mode_label = (label or "<empty>")[:10].rjust(11)
    else:
        mode_cell, mode_label = "-".rjust(8), "-".rjust(11)

    print(f"{task:<16}{total:>6}{parse_cell}{agree_cell}{mode_cell}{mode_label}{cap_cell}{len_cells}")

print()
print("怎么读:")
print("  parse 掉而 summary 里的 acc_logprob 没掉 => 忘的是**格式**不是常识。这正是本线")
print("    预期会发生的事（Conifer 把输出从 7-8 个 token 推到 144 词），所以主口径是 logprob。")
print("  mode 接近 1 => 预测塌成单一 label（mode_lbl 那一列就是它）。这种模型的 acc 会停在")
print("    random_baseline 附近而不是 0，只看 acc 会把「塌了」读成「还剩一半能力」。")
print("  agree 明显低于 1 => 两个 scorer 分道扬镳，生成路径已经不在答这道题了。")
print("  hit-cap 非零 => 答案只要 7-8 个 token 却撞上 cap，模型在滔滔不绝。**不要**因此调大")
print("    CS_MAX_NEW_TOKENS：那是格式漂移的证据，不是预算不够；调了还得所有臂一起重评。")
