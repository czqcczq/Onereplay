#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_8b_or
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=36:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# NUS Hopper: Qwen3-8B OneReplay 臂 —— 单域保护（训练 + 按域评测）
#
# 67 号给出 base / vanilla 的分母，68 号给出这一臂唯一的输入 C。本脚本一次跑
# 一个「保护域 x 一个 λ」，训练 + 该域口径的评测，最后把 base / vanilla / 本臂
# 并排打出来。
#
# -----------------------------------------------------------------------------
# 本轮矩阵里的位置
#
#   保护域各自独立，本轮不做 mix。三个域 x 三个 λ（0.5x / 1x / 2x）= 9 次投递，
#   每次只改 DOMAIN 与 LAMBDA 两个变量，run 名把两者都编进去，互不覆盖。
#
#   评测口径按域走（文档 09-09 第一节）：
#       DOMAIN=if    评 ifeval + gsm8k + math500 + humaneval + mbpp
#       DOMAIN=math  评 ifeval + gsm8k + math500
#       DOMAIN=code  评 ifeval + humaneval + mbpp
#   if always on：数学分数被格式主导（文档 2.2 节），没有 IFEval 就分不清
#   「数学掉了」和「不知道该用什么格式答题」。
#
# -----------------------------------------------------------------------------
# !! LAMBDA 没有默认值，必须显式传
#   1.7B 的 3e-2 不能搬：hidden 2048->4096 让 tr(C) 大致翻倍，同一个 λ 在两版 C
#   下的实际约束强度不是一个量。68 号 Step 4 会在 q_proj/v_proj 这个两边都有的
#   子集上算 mean tr(C)/d 的比值，按约束强度 ∝ λ x tr(C) 反推每个域的等强度 λ。
#
#   拿那个值当扫描中心点，扫 0.5x / 1x / 2x。它只是一阶近似：
#   normalize_by_layers 已把层数差异除掉、scale=α/r 两边都是 2，但训练后 A/B 的
#   实际尺度不是 trace 能预测的。
#
#   本脚本 Step 1 会重算本域 C 的 mean tr(C)/d 并打印 λ x mean tr(C)/d，那是罚项
#   的量级；训练自检还会打印每个 epoch 的 λR/task_loss。三个 λ 点的这个比值应该
#   大致线性，1x 点上就已经 >1（罚项主导 loss）说明中心点选大了。
#
# -----------------------------------------------------------------------------
# !! 这一臂最容易静默失败的地方：C 的层覆盖
#   regularizer 对找不到 C 的层是静默 continue 的，只记进 missing_layers，不抛
#   异常。拿 1.7B 那批 qv 版 C 去训 all-linear，正则只覆盖 2/7 的层，训练照跑、
#   loss 照降，要到看结果时才发现方法被削掉一大半。
#
#   两道关卡，都在本脚本里：
#     Step 1（训练前）  从 C 文件读 key 与 shape，断言层数 == 7 x 36 == 252、
#                       模块类集合 == TARGET_MODULES、每类的方阵维度 == 本模型
#                       config 的输入维度（这一条同时挡住 1.7B 的 hidden 2048）
#     训练后            grep 训练日志里的
#                       "regularizer covers 252 layers; no penalty matrix for 0 layers"
#                       —— 那是 PEFT 包出来的 LoRA 层与 C 真正对上的唯一证据，
#                       前者是文件层面的检查，后者是运行期的
#
# -----------------------------------------------------------------------------
# !! 训练超参必须与 67 号逐字相同
#   r16 / alpha32 / dropout0.05 / all-linear 七类 / epochs 3 / batch 8 /
#   accum 64（行/更新）/ eval_batch 8 / maxlen 512 / seed 1。
#   任何一项偏了，delta 里就混进了「配置不同」这个第二变量。Step 0 会逐项比对，
#   不符就退出；确实要改就传 ALLOW_DRIFT=1，并把偏差写进结果表。
#
#   LR 是唯一有意留的自由度：67 号若因 lr=2e-4 崩溃会回落 1e-4，本臂必须跟着回落。
#   VANILLA_RUN 是按 LR 拼出来的，Step 0 找不到对应 vanilla 的 metrics 就会警告
#   —— 那说明你在和一个还不存在的分母比。
#
# -----------------------------------------------------------------------------
# 显存与内存
#   GPU（H200 143 GB）: 权重 bf16 16.4 + C fp32 33.75 + LoRA/Adam ~1 + 激活
#                       ≈ 55 GB
#   主机内存          : load_covariance_file 先把整个 payload 读到 CPU 再逐层
#                       搬上卡，所以有一瞬间 CPU 上有完整一份 33.75 GiB。
#                       Step 1 会读 /proc/meminfo 的 MemAvailable 比一下。
#
#   罚项本身在 LoRA 路径上是 rank x rank 的，约一步的 1.6%，reg_once_per_update=1
#   之后每次更新只算一次。C 的 33.75 GB 常驻才是 OneReplay 真正的开销，它会写进
#   metrics 的 covariance_memory_gb。
#
# -----------------------------------------------------------------------------
# 时间与拆投
#   训练 3 epoch 约 10~20 h（8B / 170k 行 / batch 8，H200 上没有实测过），
#   评测按域不同：if 域五个指标最重，math 4096 tokens 那两个占大头。
#   walltime 给了 36 h。排不上或想稳一点就拆两次投：
#       第一次 DO_EVAL=0   只训练
#       第二次 DO_TRAIN=0  只评测
#   两边都能续跑：adapter 已存在跳过训练，summary.json 已存在跳过评测。
#
# -----------------------------------------------------------------------------
# 投递前要有的东西
#   1) ${MODEL_DIR}/Qwen3-8B                （post-trained 版，不是 -Base）
#   2) 68 号产出的本域 C，落在 results/qwen3-8b/cov/
#   3) ${CS_DATASET} = datasets/commonsense_170k_hf
#   4) 本域要用到的评测数据（缺哪个跳过哪个指标，只警告）
#   5) 67 号的 base 与 vanilla 已评完（否则末尾的对照表只有本臂一列）
#
# 投递（DRY_RUN=1 是默认，先看计划）:
#   qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=1.5e-2  onereplay/pbs/70_qwen3_8b_gold_onereplay.pbs
#   qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=7.5e-3  onereplay/pbs/70_qwen3_8b_gold_onereplay.pbs
#   qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=3e-2    onereplay/pbs/70_qwen3_8b_gold_onereplay.pbs
#   短跑看罚项量级（300 步，不保存不评测）:
#   qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=1.5e-2,PROBE=1 onereplay/pbs/70_...
#   L2 对照臂（C 换成单位矩阵，隔离协方差结构的贡献）:
#   qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=...,IDENTITY_COV=1 onereplay/pbs/70_...
#
#   若本站点 qsub 不吃 -v（63 号文件头有过这个记录），就直接改下面「阶段开关」
#   与「正则化」两段的默认值再投。
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/70_qwen3_8b_gold_onereplay.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME CS_DATASET RESULTS_ROOT MATH_DATA_DIR CODE_DATA_DIR
    DATASET_CACHE OUT_DIR
    DRY_RUN DO_TRAIN DO_EVAL FORCE_TRAIN FORCE_EVAL PROBE ALLOW_DRIFT COV_DIAG
    DOMAIN LAMBDA COV_PATH IF_COV MATH_COV CODE_COV
    REGULARIZER IDENTITY_COV REG_ONCE NORM_BY_LAYERS
    SEED EPOCHS LR BATCH ACCUM MAXLEN VAL_FRAC MAXVAL
    TARGET_MODULES LORA_RANK LORA_ALPHA LORA_DROPOUT
    EVAL_BATCH SAVE MAX_STEPS RUN_TAG RUN VANILLA_RUN
    MATH500_FILE GSM8K_FILE HUMANEVAL_FILE MBPP_DIR MBPP_SPLIT IFEVAL_INPUT
    MATH_MAX_NEW_TOKENS CODE_MAX_NEW_TOKENS IF_MAX_NEW_TOKENS
    MATH_BATCH CODE_BATCH IFEVAL_BATCH
    TIMEOUT LIMIT DIAG_LEN WITH_BASE WITH_VANILLA EXTRA_MODELS
    MIN_HOST_FREE_GIB
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：那会把当前 shell 替换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的训练与评测。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

# ---- 项目路径：写 8B 自己的目录，与 1.7B 那批彻底隔离 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-8B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results/qwen3-8b}"
CS_DATASET="${CS_DATASET:-${REPO_ROOT}/datasets/commonsense_170k_hf}"
MATH_DATA_DIR="${MATH_DATA_DIR:-${REPO_ROOT}/datasets/math}"
CODE_DATA_DIR="${CODE_DATA_DIR:-${REPO_ROOT}/datasets/code}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
ADAPTERS="${RESULTS_ROOT}/adapters"
COV_DIR="${RESULTS_ROOT}/cov"
TRAIN_LOG_DIR="${RESULTS_ROOT}/train_logs"
export HF_DATASETS_CACHE="${DATASET_CACHE}"

# ---- 阶段开关 ----
DRY_RUN="${DRY_RUN:-1}"          # 默认只做前置检查与 C 诊断，不训练不评测
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"
PROBE="${PROBE:-0}"             # 1 = 300 步短跑，只看罚项量级
ALLOW_DRIFT="${ALLOW_DRIFT:-0}"  # 1 = 容忍与 67 号不一致的超参（会打印偏差清单）
COV_DIAG="${COV_DIAG:-1}"        # 1 = 读 C 的对角线算 trace（会把整份 C 过一遍盘）
WITH_BASE="${WITH_BASE:-0}"      # base/vanilla 由 67 号评过，默认不重评
WITH_VANILLA="${WITH_VANILLA:-0}"

# ---- 保护域：决定 C、run 名与评测口径 ----
DOMAIN="${DOMAIN:-}"
case "${DOMAIN}" in
  if|math|code) ;;
  "")
    echo "!! 必须指定 DOMAIN（if / math / code）。"
    echo "   例: qsub -v DRY_RUN=0,DOMAIN=if,LAMBDA=1.5e-2 ${SELF_PATH}"
    exit 1
    ;;
  *)
    echo "!! DOMAIN=${DOMAIN} 不认识，只能是 if / math / code（本轮不做 mix）"
    exit 1
    ;;
esac

# ---- 训练超参：与 67 号逐字一致；LR 是唯一有意留的自由度 ----
SEED="${SEED:-1}"
EPOCHS="${EPOCHS:-3}"
LR="${LR:-2e-4}"                 # 67 号若因 lr=2e-4 崩溃回落 1e-4，本臂必须跟着回落
BATCH="${BATCH:-8}"
ACCUM="${ACCUM:-64}"             # 每次更新 64 行新任务
EVAL_BATCH="${EVAL_BATCH:-8}"    # 钉住，否则 val_loss 与 67 号及其余各臂不可比
MAXLEN="${MAXLEN:-512}"
VAL_FRAC="${VAL_FRAC:-0.01}"
MAXVAL="${MAXVAL:-1000}"
LORA_RANK="${LORA_RANK:-16}"
LORA_ALPHA="${LORA_ALPHA:-32}"
LORA_DROPOUT="${LORA_DROPOUT:-0.05}"
TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj}"
SAVE="${SAVE:-1}"
MAX_STEPS="${MAX_STEPS:-0}"

# ---- 正则化 ----
REGULARIZER="${REGULARIZER:-onereplay}"
LAMBDA="${LAMBDA:-}"             # 没有默认值，见文件头
REG_ONCE="${REG_ONCE:-1}"        # 罚项每次参数更新算一次，不是每个 micro-batch
NORM_BY_LAYERS="${NORM_BY_LAYERS:-1}"   # λ 的换算是在这个前提下做的，改了 λ 就换了尺子
IDENTITY_COV="${IDENTITY_COV:-0}" # 1 = C 换成单位矩阵，退化成 L2 对照臂

# 68 号的三份 C。名字里的 _8b_all 是与 1.7B 的 _qv 版区分的唯一标记。
IF_COV="${IF_COV:-${COV_DIR}/cov_flan_chat_20k_8b_all.pt}"
MATH_COV="${MATH_COV:-${COV_DIR}/cov_math_metamath30k_gold_8b_all.pt}"
CODE_COV="${CODE_COV:-${COV_DIR}/cov_code_opcedu20k_gold_8b_all.pt}"
case "${DOMAIN}" in
  if)   COV_PATH="${COV_PATH:-${IF_COV}}" ;;
  math) COV_PATH="${COV_PATH:-${MATH_COV}}" ;;
  code) COV_PATH="${COV_PATH:-${CODE_COV}}" ;;
esac

if [[ "${PROBE}" == "1" ]]; then
  SAVE=0
  [[ "${MAX_STEPS}" == "0" ]] && MAX_STEPS=300
  EPOCHS=1                       # 300 步 x 3 个 epoch 没有额外信息，只是等三倍时间
  DO_EVAL=0
  echo "PROBE=1：SAVE=0 MAX_STEPS=${MAX_STEPS} EPOCHS=1 DO_EVAL=0，只看罚项量级"
fi

# ---- run 名：域与 λ 都编进去，扫 λ 时不会互相覆盖 ----
RUN_TAG="${RUN_TAG:-r${LORA_RANK}all}"
RUN="${RUN:-cs_onereplay_8b_${DOMAIN}gold_${RUN_TAG}_lam${LAMBDA}_lr${LR}_seed${SEED}_regonce}"
if [[ "${IDENTITY_COV}" == "1" ]]; then
  RUN="${RUN}_idcov"             # L2 对照臂，绝不能覆盖真 C 那一版的 adapter
fi
# 67 号的 vanilla：分母。名字必须按同一套规则拼，否则末尾的对照表读不到它。
VANILLA_RUN="${VANILLA_RUN:-cs_vanilla_8b_${RUN_TAG}_lr${LR}_seed${SEED}}"
TRAIN_LOG="${TRAIN_LOG_DIR}/${RUN}.train.log"

# ---- 评测数据 ----
MATH500_FILE="${MATH500_FILE:-${MATH_DATA_DIR}/math500_test.jsonl}"
GSM8K_FILE="${GSM8K_FILE:-${MATH_DATA_DIR}/gsm8k_test.jsonl}"
HUMANEVAL_FILE="${HUMANEVAL_FILE:-${CODE_DATA_DIR}/humaneval_test.parquet}"
MBPP_DIR="${MBPP_DIR:-${CODE_DATA_DIR}/mbpp_full}"
MBPP_SPLIT="${MBPP_SPLIT:-test}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"

# ---- 解码预算与解码 batch：67 号定的口径，所有臂必须逐字相同 ----
MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS:-4096}"
CODE_MAX_NEW_TOKENS="${CODE_MAX_NEW_TOKENS:-512}"
IF_MAX_NEW_TOKENS="${IF_MAX_NEW_TOKENS:-768}"
MATH_BATCH="${MATH_BATCH:-32}"
CODE_BATCH="${CODE_BATCH:-64}"
IFEVAL_BATCH="${IFEVAL_BATCH:-32}"

TIMEOUT="${TIMEOUT:-10}"
LIMIT="${LIMIT:-0}"
DIAG_LEN="${DIAG_LEN:-1}"
EXTRA_MODELS="${EXTRA_MODELS:-}" # "name;/abs/path" 用 | 分隔，额外要评的已有 run
MIN_HOST_FREE_GIB="${MIN_HOST_FREE_GIB:-4}"   # C 之外还要留给主机的余量

# 按域决定评哪些指标（文档 09-09 第一节的口径）
case "${DOMAIN}" in
  if)   DOMAIN_METRICS="ifeval gsm8k math500 humaneval mbpp" ;;
  math) DOMAIN_METRICS="ifeval gsm8k math500" ;;
  code) DOMAIN_METRICS="ifeval humaneval mbpp" ;;
esac

# LIMIT>0 的产物只覆盖前 N 题，写进正式目录会被"已有 summary.json 就跳过"当成完整结果。
OUT_DIR="${OUT_DIR:-${RESULTS_ROOT}}"
if [[ "${LIMIT}" != "0" ]]; then
  OUT_DIR="${OUT_DIR}_limit${LIMIT}"
fi

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺基座模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
mkdir -p "${ADAPTERS}" "${RESULTS_ROOT}/metrics" "${OUT_DIR}" "${DATASET_CACHE}" "${TRAIN_LOG_DIR}"

set +x
echo "========================================================================"
echo "Qwen3-8B OneReplay 臂：保护 ${DOMAIN}"
echo "  run      = ${RUN}"
echo "  分母     = base / ${VANILLA_RUN}   (67 号产出)"
echo "  C        = ${COV_PATH}"
echo "  λ        = ${LAMBDA}   reg_once=${REG_ONCE}  normalize_by_layers=${NORM_BY_LAYERS}"
echo "             identity_cov=${IDENTITY_COV}  regularizer=${REGULARIZER}"
echo "  LoRA     = r${LORA_RANK} alpha${LORA_ALPHA} dropout${LORA_DROPOUT}"
echo "             targets=${TARGET_MODULES}"
echo "  训练     = LR ${LR} / EPOCHS ${EPOCHS} / BATCH ${BATCH} / ACCUM ${ACCUM}(行/更新) / MAXLEN ${MAXLEN}"
echo "             eval_batch ${EVAL_BATCH} / seed ${SEED} / max_steps ${MAX_STEPS}"
echo "  评测     = ${DOMAIN_METRICS}"
echo "             预算 math ${MATH_MAX_NEW_TOKENS} / code ${CODE_MAX_NEW_TOKENS} / ifeval ${IF_MAX_NEW_TOKENS}"
echo "             batch math ${MATH_BATCH} / code ${CODE_BATCH} / ifeval ${IFEVAL_BATCH}"
echo "  阶段     = train:${DO_TRAIN} eval:${DO_EVAL} probe:${PROBE} DRY_RUN=${DRY_RUN}"
echo "  OUT_DIR  = ${OUT_DIR}"
echo "========================================================================"

# ===========================================================================
# Step 0: 与 67 号的对齐检查（纯 bash，秒级）
#   delta 只有在「除了正则项之外一切相同」时才是这个方法的效果。
# ===========================================================================
echo "==== Step 0: 对齐检查 ===="

[[ -n "${LAMBDA}" ]] || {
  echo "!! LAMBDA 为空。它没有默认值是刻意的：1.7B 的 3e-2 不能搬到 8B。"
  echo "   去 68 号 Step 4 的输出里取本域的等强度 λ，围绕它扫 0.5x / 1x / 2x。"
  exit 1
}
python -c "import sys; sys.exit(0 if float('${LAMBDA}') > 0 else 1)" || {
  echo "!! LAMBDA=${LAMBDA} 不是正数。λ=0 就是 vanilla，那是 67 号的事。"
  exit 1
}
[[ -d "${CS_DATASET}" ]] || { echo "缺 commonsense_170k: ${CS_DATASET}"; exit 1; }
[[ -f "${COV_PATH}" ]] || {
  echo "!! 缺 C: ${COV_PATH}"
  echo "   先跑 68 号采本域的 C（DRY_RUN=1 会先做空间预检）。"
  exit 1
}
case "${COV_PATH}" in
  *_qv.pt)
    echo "!! COV_PATH 以 _qv.pt 结尾，那是 1.7B 那批只覆盖 q_proj/v_proj 的 C。"
    echo "   拿它训 all-linear 会让正则只覆盖 2/7 的层，训练照跑、loss 照降。"
    exit 1
    ;;
esac
if (( ACCUM % BATCH != 0 )); then
  echo "ACCUM=${ACCUM} 不能被 BATCH=${BATCH} 整除，每次更新的行数会被静默取整"; exit 1
fi

# 67 号钉下来的值。LR 不在其中：它是有意留的自由度，但必须与被比的 vanilla 同值。
DRIFT=()
[[ "${TARGET_MODULES}" == "q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj" ]] \
  || DRIFT+=("target_modules=${TARGET_MODULES}（67 号: all-linear 七类）")
[[ "${LORA_RANK}"    == "16"   ]] || DRIFT+=("lora_rank=${LORA_RANK}（67 号: 16）")
[[ "${LORA_ALPHA}"   == "32"   ]] || DRIFT+=("lora_alpha=${LORA_ALPHA}（67 号: 32）")
[[ "${LORA_DROPOUT}" == "0.05" ]] || DRIFT+=("lora_dropout=${LORA_DROPOUT}（67 号: 0.05）")
[[ "${BATCH}"        == "8"    ]] || DRIFT+=("batch_size=${BATCH}（67 号: 8）")
[[ "${ACCUM}"        == "64"   ]] || DRIFT+=("accumulation_size=${ACCUM}（67 号: 64）")
[[ "${EVAL_BATCH}"   == "8"    ]] || DRIFT+=("eval_batch_size=${EVAL_BATCH}（67 号: 8，val_loss 靠它可比）")
[[ "${MAXLEN}"       == "512"  ]] || DRIFT+=("max_len=${MAXLEN}（67 号: 512）")
[[ "${VAL_FRAC}"     == "0.01" ]] || DRIFT+=("val_fraction=${VAL_FRAC}（67 号: 0.01，改了 val 划分就变了）")
[[ "${MAXVAL}"       == "1000" ]] || DRIFT+=("max_val_samples=${MAXVAL}（67 号: 1000）")
if [[ "${PROBE}" != "1" ]]; then
  [[ "${EPOCHS}"   == "3" ]] || DRIFT+=("epochs=${EPOCHS}（67 号: 3）")
  [[ "${MAX_STEPS}" == "0" ]] || DRIFT+=("max_steps=${MAX_STEPS}（正式 run 应为 0）")
fi
[[ "${REGULARIZER}" == "onereplay" ]] || DRIFT+=("regularizer=${REGULARIZER}（本脚本是 OneReplay 臂）")
[[ "${REG_ONCE}"    == "1" ]] || DRIFT+=("reg_once_per_update=${REG_ONCE}（应为 1）")
[[ "${NORM_BY_LAYERS}" == "1" ]] || DRIFT+=("normalize_replay_by_layers=${NORM_BY_LAYERS}（λ 的换算以 1 为前提）")

if (( ${#DRIFT[@]} > 0 )); then
  echo "与 67 号不一致的项:"
  for item in "${DRIFT[@]}"; do echo "  - ${item}"; done
  if [[ "${ALLOW_DRIFT}" != "1" ]]; then
    echo "!! 这些偏差会让 delta 里混进第二个变量。确实要改就传 ALLOW_DRIFT=1，"
    echo "   并把偏差写进结果表。停。"
    exit 1
  fi
  echo "ALLOW_DRIFT=1：继续，但上面每一条都要写进结果表。"
else
  echo "训练超参与 67 号逐字一致。"
fi

if [[ ! -f "${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl" ]]; then
  echo "warning: 找不到 ${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl"
  echo "         67 号的 vanilla（LR=${LR}）还没跑完，本臂现在没有可比的分母。"
  echo "         若 67 号回落到了 LR=1e-4，本臂也要传 LR=1e-4。"
fi
for f in "${IFEVAL_INPUT}" "${MATH500_FILE}" "${GSM8K_FILE}" "${HUMANEVAL_FILE}"; do
  [[ -f "${f}" ]] || echo "warning: 缺评测数据 ${f}（相关指标会被跳过）"
done
[[ -d "${MBPP_DIR}" ]] || echo "warning: 缺 MBPP 目录 ${MBPP_DIR}（该指标会被跳过）"

# ===========================================================================
# Step 1: C 的层覆盖断言 + 量级/显存预检
#   这是本脚本存在的主要理由。regularizer 对找不到 C 的层静默跳过，所以
#   「训练跑通」并不能说明正则真的覆盖了 252 层。
# ===========================================================================
echo "==== Step 1: C 前置检查 ===="
export MODEL_DIR MODEL_NAME COV_PATH TARGET_MODULES LAMBDA DOMAIN COV_DIAG
export IDENTITY_COV NORM_BY_LAYERS MIN_HOST_FREE_GIB
COV_REPORT_FILE="${TMPDIR}/cov_preflight_${RUN}.txt"

if ! python - <<'PY' 2>&1 | tee "${COV_REPORT_FILE}"; then
import json
import os
from pathlib import Path

import torch

model_dir = Path(os.environ["MODEL_DIR"]) / os.environ["MODEL_NAME"]
with open(model_dir / "config.json") as handle:
    cfg = json.load(handle)

hidden = cfg["hidden_size"]
inter = cfg["intermediate_size"]
layers = cfg["num_hidden_layers"]
heads = cfg["num_attention_heads"]
head_dim = cfg.get("head_dim", hidden // heads)

# C_l 是该层**输入**维度的方阵。这张表同时是「这份 C 是不是这个模型的」的判据：
# 1.7B 的 hidden 是 2048，拿它的 C 来训 8B 会在这里被拦下。
in_dim = {
    "q_proj": hidden,
    "k_proj": hidden,
    "v_proj": hidden,
    "o_proj": heads * head_dim,
    "gate_proj": hidden,
    "up_proj": hidden,
    "down_proj": inter,
    "lm_head": hidden,
}
targets = [item.strip() for item in os.environ["TARGET_MODULES"].split(",") if item.strip()]
unknown = [item for item in targets if item not in in_dim]
if unknown:
    raise SystemExit(f"!! 未知模块名: {unknown}")
expect = sum(1 if item == "lm_head" else layers for item in targets)


def class_of(name):
    return name.rsplit(".", 1)[-1]


cov_path = os.environ["COV_PATH"]
try:
    payload = torch.load(cov_path, map_location="cpu", mmap=True)
except (TypeError, RuntimeError):
    # mmap 不可用就整份读进内存。33.75 GiB，训练时反正也要读一遍。
    payload = torch.load(cov_path, map_location="cpu")
covs = payload["covariances"] if "covariances" in payload else payload
meta = payload.get("metadata", {}) if isinstance(payload, dict) else {}

print(f"C            = {cov_path}")
print(f"config       = hidden {hidden} / intermediate {inter} / layers {layers} / head_dim {head_dim}")
print(f"metadata     = pool_rows={meta.get('pool_rows')} max_len={meta.get('max_len')}")
print(f"               cov_accum_device={meta.get('cov_accum_device')} "
      f"normalization={meta.get('cov_normalization')}")
print(f"               pool_fingerprint={meta.get('pool_fingerprint')}")
print(f"               model={meta.get('model_name')}")
print(f"层数         = {len(covs)} / 期望 {expect} ({len(targets)} 类 x {layers} 层)")

failures = []
if len(covs) != expect:
    got = sorted({class_of(key) for key in covs})
    failures.append(
        f"层覆盖 {len(covs)} != {expect}；C 里的模块类是 {got}。"
        "regularizer 对缺 C 的层静默跳过，拿这份去训等于只约束其中一部分。"
    )

got_classes = {class_of(key) for key in covs}
missing_classes = sorted(set(targets) - got_classes)
extra_classes = sorted(got_classes - set(targets))
if missing_classes:
    failures.append(f"C 里缺这些模块类: {missing_classes}（LoRA 会挂上去但没有 C）")
if extra_classes:
    print(f"note: C 里多出 {extra_classes}，LoRA 不覆盖它们，正则用不到（不致命）")

bad_dims = []
for key, mat in covs.items():
    cls = class_of(key)
    want = in_dim.get(cls)
    if want is not None and mat.shape[-1] != want:
        bad_dims.append(f"{key}: {tuple(mat.shape)} 期望 ({want}, {want})")
if bad_dims:
    failures.append(
        "维度不符（很可能是别的模型的 C）: " + "; ".join(bad_dims[:4])
        + (f" ...共 {len(bad_dims)} 处" if len(bad_dims) > 4 else "")
    )

cov_bytes = sum(mat.numel() * 4 for mat in covs.values())  # 训练里统一升 fp32
weight_bytes = sum(p.stat().st_size for p in model_dir.glob("*.safetensors"))
gpu_total = (
    torch.cuda.get_device_properties(0).total_memory if torch.cuda.is_available() else 0
)
print()
print("---- 显存/内存预检")
print(f"C (fp32 常驻卡上)   {cov_bytes / 2**30:7.2f} GiB")
print(f"权重 (bf16, 按盘上算) {weight_bytes / 2**30:7.2f} GiB")
if gpu_total:
    headroom = (gpu_total - cov_bytes - weight_bytes) / 2**30
    print(f"卡上总容量           {gpu_total / 2**30:7.2f} GiB -> 余给激活/优化器 {headroom:.2f} GiB")
    if headroom < 8:
        failures.append(
            f"扣掉 C 与权重只剩 {headroom:.2f} GiB 给激活，几乎肯定 OOM。"
            "去掉 down_proj（占 C 六成）或换更大的卡。"
        )

# load_covariance_file 先把整份 payload 读到 CPU 再逐层搬上卡，所以有一瞬间
# 主机上有完整一份。MemAvailable 不够的话进程会被 OOM killer 杀掉。
mem_available = 0
try:
    for line in Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            mem_available = int(line.split()[1]) * 1024
            break
except OSError:
    pass
if mem_available:
    need = cov_bytes + float(os.environ["MIN_HOST_FREE_GIB"]) * 2**30
    print(f"主机 MemAvailable    {mem_available / 2**30:7.2f} GiB "
          f"(需要 >= {need / 2**30:.2f} GiB)")
    if mem_available < need:
        failures.append(
            f"主机可用内存 {mem_available / 2**30:.2f} GiB 装不下 C 的一份中转拷贝 "
            f"{cov_bytes / 2**30:.2f} GiB，torch.load 会被 OOM killer 杀掉"
        )

if os.environ.get("COV_DIAG", "1") == "1":
    print()
    print("---- 量级（mean tr(C)/d = 每个方向的平均能量，跨维度可比）")
    per_class = {}
    for key, mat in covs.items():
        per_class.setdefault(class_of(key), []).append(
            float(torch.diagonal(mat).float().mean())
        )
    print(f"{'module':<12}{'层数':>6}{'mean tr(C)/d':>18}")
    for cls in targets:
        vals = per_class.get(cls, [])
        if vals:
            print(f"{cls:<12}{len(vals):>6}{sum(vals) / len(vals):>18.4e}")
    all_vals = [v for vals in per_class.values() for v in vals]
    overall = sum(all_vals) / len(all_vals)
    qv = [v for cls in ("q_proj", "v_proj") for v in per_class.get(cls, [])]
    lam = float(os.environ["LAMBDA"])
    print(f"{'全部':<12}{len(all_vals):>6}{overall:>18.4e}")
    if qv:
        print(f"{'qv 子集':<12}{len(qv):>6}{sum(qv) / len(qv):>18.4e}"
              "   <- 与 68 号 Step 4 / 1.7B 换算用的就是这一列")
    print()
    print(f"λ = {lam:.4e}   λ x mean tr(C)/d = {lam * overall:.4e}")
    print("normalize_by_layers=1 已把层数除掉，所以这个乘积就是罚项的量级。")
    print("训练自检会打印每个 epoch 的 λR/task_loss；三个 λ 点上它应该大致线性。")
    if os.environ.get("IDENTITY_COV") == "1":
        print("!! IDENTITY_COV=1：真正用的 C 是单位矩阵，上面这些 trace 只作参照。")
else:
    print("COV_DIAG=0：跳过对角线扫描（省一次整份 C 的读盘），只做 key/shape 检查。")

print()
if failures:
    print("!! C 前置检查未通过:")
    for item in failures:
        print(f"   - {item}")
    raise SystemExit(1)
print(f"C 前置检查通过。EXPECT_LAYERS={expect}")
PY
  echo "!! Step 1 未通过，不进入训练。"
  exit 1
fi

EXPECT_LAYERS="$(grep -o 'EXPECT_LAYERS=[0-9]*' "${COV_REPORT_FILE}" | tail -n 1)"
EXPECT_LAYERS="${EXPECT_LAYERS#EXPECT_LAYERS=}"
[[ -n "${EXPECT_LAYERS}" ]] || { echo "!! 没解析到 EXPECT_LAYERS，训练后的层数断言会失效。停。"; exit 1; }
echo "训练后要在日志里核对的层数: ${EXPECT_LAYERS}"

if [[ "${DRY_RUN}" == "1" ]]; then
  echo ""
  echo "DRY_RUN=1：以上为计划与前置检查，未训练未评测。"
  echo "确认无误后: qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=${LAMBDA} ${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi
set -x

# ===========================================================================
# 训练
#   profile 保持 0：它每阶段插 cuda synchronize，会污染要上报的墙钟。
#   peak memory / epoch wall time / covariance_memory_gb 不开 profile 也照样
#   写进 metrics jsonl。
# ===========================================================================
if [[ "${DO_TRAIN}" == "1" ]]; then
  if [[ "${FORCE_TRAIN}" != "1" && "${SAVE}" == "1" && -d "${ADAPTERS}/${RUN}" ]]; then
    echo "跳过训练 ${RUN}：adapter 已存在（FORCE_TRAIN=1 可强制重训）"
  else
    mkdir -p "${RESULTS_ROOT}/map_cache/${RUN}"
    echo "==== train: ${RUN} (C=${COV_PATH} λ=${LAMBDA}) ===="
    # 训练输出同时留一份文件：层覆盖那句只在 stdout 上，metrics jsonl 里没有。
    python -m onereplay.scripts.train --paradigm sft \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
      --dataset_path "${CS_DATASET}" \
      --epochs "${EPOCHS}" --lr "${LR}" --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
      --eval_batch_size "${EVAL_BATCH}" \
      --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" --max_len "${MAXLEN}" \
      --lora_rank "${LORA_RANK}" --lora_alpha "${LORA_ALPHA}" --lora_dropout "${LORA_DROPOUT}" \
      --target_modules "${TARGET_MODULES}" \
      --map_cache_dir "${RESULTS_ROOT}/map_cache/${RUN}" \
      --max_steps "${MAX_STEPS}" \
      --regularizer "${REGULARIZER}" \
      --cov_path "${COV_PATH}" --replay_lambda "${LAMBDA}" \
      --identity_cov "${IDENTITY_COV}" \
      --normalize_replay_by_layers "${NORM_BY_LAYERS}" \
      --reg_once_per_update "${REG_ONCE}" \
      --save "${SAVE}" --save_path "${ADAPTERS}/${RUN}" \
      --metrics_path "${RESULTS_ROOT}/metrics/${RUN}.jsonl" 2>&1 | tee "${TRAIN_LOG}"
  fi
fi

# ===========================================================================
# 训练自检 1：日志里的运行期证据
#   train.py 启动时会把全部 args 打出来，trainer 在第一步打出正则的实际层覆盖。
#   这两处是「命令行传对了」和「C 真的对上了 LoRA 层」的唯一证据，metrics
#   jsonl 里都没有。所以这里查文件而不是查 jsonl。
# ===========================================================================
set +x
if [[ -f "${TRAIN_LOG}" ]]; then
  echo "==== 训练自检 1: 日志 (${TRAIN_LOG}) ===="
  LOG_FAIL=()
  assert_log () {
    if ! grep -qF -- "$1" "${TRAIN_LOG}"; then
      LOG_FAIL+=("找不到 '$1'   <- $2")
    else
      echo "  ok  $1"
    fi
  }
  # 这一句是全脚本最重要的断言：正则实际覆盖了多少层。
  assert_log "regularizer covers ${EXPECT_LAYERS} layers; no penalty matrix for 0 layers" \
    "正则没有覆盖全部 ${EXPECT_LAYERS} 层。C 与 LoRA 的层集合没对上，方法被削掉了一部分。"
  assert_log "TARGET_MODULES=${TARGET_MODULES}" "LoRA/正则的层覆盖与 67 号不同"
  assert_log "LORA_RANK=${LORA_RANK}" "rank 与 67 号不同"
  assert_log "LORA_ALPHA=${LORA_ALPHA}" "alpha 与 67 号不同（scale=α/r 变了，λ 的尺子也变了）"
  assert_log "LORA_DROPOUT=${LORA_DROPOUT}" "dropout 与 67 号不同"
  assert_log "MAX_LEN=${MAXLEN}" "新任务的 token 预算与 67 号不同"
  assert_log "NORMALIZE_REPLAY_BY_LAYERS=${NORM_BY_LAYERS}" \
    "层归一化开关与 λ 换算的前提不符，λ 的量级会整体偏掉一个 ${EXPECT_LAYERS} 倍"
  assert_log "REGULARIZER=${REGULARIZER}" "跑的不是 OneReplay"
  assert_log "IDENTITY_COV=${IDENTITY_COV}" "identity 对照开关与 run 名不符"
  if (( ${#LOG_FAIL[@]} > 0 )); then
    echo ""
    echo "!! 日志自检失败:"
    for item in "${LOG_FAIL[@]}"; do echo "   - ${item}"; done
    echo "   （若这是一次续跑、日志来自上一次投递，先确认它对应的就是当前 run）"
    exit 1
  fi
  echo "日志自检通过。"
else
  echo "note: 没有 ${TRAIN_LOG}，跳过日志自检（DO_TRAIN=0 或 adapter 是上一次投递训的）"
fi

# ===========================================================================
# 训练自检 2：metrics jsonl 里的配置与罚项量级
#   除了核对配置，这里还输出 λ 扫描真正要看的东西：
#   λR/task_loss（罚项在总 loss 里的占比）与 val_loss（新任务性能）。
#   文档 2.2 节定的主表口径是「同等或更好的 val loss 下旧能力保留更多」，
#   所以 val_loss 必须和 vanilla 并排出现，不能只报 delta。
# ===========================================================================
METRICS_FILE="${RESULTS_ROOT}/metrics/${RUN}.jsonl"
if [[ -f "${METRICS_FILE}" ]]; then
  echo "==== 训练自检 2: metrics (${METRICS_FILE}) ===="
  RUN_METRICS="${METRICS_FILE}" \
  VANILLA_METRICS="${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl" \
  WANT_LAMBDA="${LAMBDA}" WANT_COV="${COV_PATH}" WANT_REG="${REGULARIZER}" \
  WANT_ACCUM="${ACCUM}" WANT_EVAL_BATCH="${EVAL_BATCH}" WANT_EPOCHS="${EPOCHS}" \
  WANT_IDENTITY="${IDENTITY_COV}" WANT_REG_ONCE="${REG_ONCE}" \
  VANILLA_NAME="${VANILLA_RUN}" \
  python - <<'PY'
import json
import os


def load_epochs(path):
    rows = []
    if not path or not os.path.isfile(path):
        return rows
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if not line.strip():
                continue
            row = json.loads(line)
            if row.get("epoch") is not None:
                rows.append(row)
    return rows


epochs = load_epochs(os.environ["RUN_METRICS"])
if not epochs:
    raise SystemExit(f"{os.environ['RUN_METRICS']} 里没有 epoch 记录，训练没跑完一个 epoch")
last = epochs[-1]

want_lambda = float(os.environ["WANT_LAMBDA"])
want_cov = os.environ["WANT_COV"]
want_epochs = int(os.environ["WANT_EPOCHS"])

# train.py 把罚项的来源文件统一记成 penalty_path（EWC 时是 fisher_path，其余是
# cov_path），不是 cov_path 这个名字。字段名对不上会读到 None 而不是报错。
penalty_path = str(last.get("penalty_path") or "")

print(f"records         = {len(epochs)} 条 epoch 记录（含历史追加），最后一条 epoch={last.get('epoch')}")
print(f"regularizer     = {last.get('regularizer')}")
print(f"penalty_path    = {penalty_path}")
print(f"replay_lambda   = {last.get('replay_lambda')} (want {want_lambda})")
print(f"identity_cov    = {last.get('identity_cov')}")
print(f"reg_once        = {last.get('reg_once_per_update')}")
print(f"accumulation    = {last.get('accumulation_size')} (want {os.environ['WANT_ACCUM']})")
print(f"eval_batch_size = {last.get('eval_batch_size')} (want {os.environ['WANT_EVAL_BATCH']})")
print(f"C 常驻显存      = {last.get('covariance_memory_gb')} GB")

failures = []
if str(last.get("regularizer")) != os.environ["WANT_REG"]:
    failures.append(f"regularizer={last.get('regularizer')}，不是 {os.environ['WANT_REG']}")
if abs(float(last.get("replay_lambda") or 0.0) - want_lambda) > 1e-12:
    failures.append(f"λ 记录为 {last.get('replay_lambda')}，与本次要求的 {want_lambda} 不符")
if not penalty_path:
    failures.append(
        "metrics 里没有 penalty_path。train.py 的 extra_record 改过字段名的话这个"
        "自检就形同虚设，先去核对再重训"
    )
elif penalty_path != want_cov:
    failures.append(f"penalty_path 记录为 {penalty_path}，不是本次要用的 {want_cov}")
elif "_qv" in os.path.basename(penalty_path):
    failures.append(f"penalty_path {penalty_path!r} 是 qv 版 C，只覆盖 2/7 的层")
if int(last.get("identity_cov") or 0) != int(os.environ["WANT_IDENTITY"]):
    failures.append(f"identity_cov={last.get('identity_cov')}，与 run 名不符")
if int(last.get("reg_once_per_update") or 0) != int(os.environ["WANT_REG_ONCE"]):
    failures.append(f"reg_once_per_update={last.get('reg_once_per_update')}")
if int(last.get("accumulation_size") or 0) != int(os.environ["WANT_ACCUM"]):
    failures.append(f"accumulation_size={last.get('accumulation_size')}，与 67 号不符")
if int(last.get("eval_batch_size") or 0) != int(os.environ["WANT_EVAL_BATCH"]):
    failures.append(f"eval_batch_size={last.get('eval_batch_size')}，val_loss 与其余臂不可比")
if int(last.get("epoch") or 0) != want_epochs:
    failures.append(f"最后一条记录是 epoch {last.get('epoch')}，没跑满 {want_epochs} 个 epoch")

def cell(value, spec=".6f", width=14):
    """None 也要占位：缺字段时表格不能错列，否则一眼看不出是哪一列缺。"""

    return f"{'-' if value is None else format(value, spec):>{width}}"


print()
print("---- 罚项量级与新任务性能")
print(f"{'epoch':>6}{'task_loss':>14}{'R':>14}{'λR':>14}{'λR/task':>12}{'val_loss':>14}")
tail = epochs[-want_epochs:] if len(epochs) >= want_epochs else epochs
for row in tail:
    task = row.get("train_task_loss")
    lam_reg = row.get("train_lambda_reg")
    ratio = (lam_reg / task) if (task and lam_reg is not None) else None
    print(
        f"{row.get('epoch'):>6}"
        + cell(task)
        + cell(row.get("train_replay_reg"), ".4e")
        + cell(lam_reg, ".4e")
        + cell(ratio, ".4f", 12)
        + cell(row.get("val_loss"))
    )
if not (last.get("train_replay_reg") or 0) > 0:
    failures.append(
        "train_replay_reg = 0：罚项没有起作用。C 加载了但一层都没对上，"
        "或者 λ 被吃掉了。这一臂等于 vanilla，别拿去当结果。"
    )

vanilla = load_epochs(os.environ.get("VANILLA_METRICS", ""))
print()
if vanilla:
    v_last = vanilla[-1]
    print(f"vanilla ({os.environ['VANILLA_NAME']}) val_loss = {v_last.get('val_loss')}")
    print(f"本臂                                   val_loss = {last.get('val_loss')}")
    if v_last.get("val_loss") and last.get("val_loss"):
        delta = last["val_loss"] - v_last["val_loss"]
        print(f"差值 = {delta:+.6f}  （<=0 就是新任务没被罚项拖慢，主表要的就是这一点）")
    print(f"墙钟 train_sec 本臂 {last.get('train_sec')} / vanilla {v_last.get('train_sec')}")
    print(f"峰值显存 本臂 {last.get('peak_memory_gb')} / vanilla {v_last.get('peak_memory_gb')}")
else:
    print("note: 找不到 vanilla 的 metrics，val_loss 没有分母。67 号跑完再回来看这一行。")

if failures:
    print()
    print("!! 训练自检失败:")
    for item in failures:
        print(f"   - {item}")
    raise SystemExit(1)
print()
print("训练自检通过。")
PY
else
  echo "note: 没有 ${METRICS_FILE}，跳过 metrics 自检"
fi
set -x

# ===========================================================================
# 评测：按域走口径，解码预算与 batch 与 67 号逐字相同
# ===========================================================================
if [[ "${DO_EVAL}" != "1" ]]; then
  echo "DO_EVAL=0：跳过评测。评测单独投: qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=${LAMBDA},DO_TRAIN=0 ${SELF_PATH}"
  set +x
  echo "Job finished at: $(date)"
  exit 0
fi

# 缺哪个数据就跳过哪个指标（数据没搬全时不至于整个作业白挂）。
AVAIL=""
for m in ${DOMAIN_METRICS}; do
  case "${m}" in
    ifeval)    [[ -f "${IFEVAL_INPUT}"   ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 ifeval：缺 ${IFEVAL_INPUT}" ;;
    gsm8k)     [[ -f "${GSM8K_FILE}"     ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 gsm8k：缺 ${GSM8K_FILE}" ;;
    math500)   [[ -f "${MATH500_FILE}"   ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 math500：缺 ${MATH500_FILE}" ;;
    humaneval) [[ -f "${HUMANEVAL_FILE}" ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 humaneval：缺 ${HUMANEVAL_FILE}" ;;
    mbpp)      [[ -d "${MBPP_DIR}"       ]] && AVAIL="${AVAIL} ${m}" || echo "跳过 mbpp：缺 ${MBPP_DIR}" ;;
  esac
done
AVAIL="${AVAIL# }"
if [[ -z "${AVAIL}" ]]; then
  echo "本域要评的指标一个数据都没找到，跳过评测"
  set +x
  echo "Job finished at: $(date)"
  exit 0
fi
echo "AVAIL=[${AVAIL}]"

# base 的 adapter 路径是空串：evaluate.py 认这个，直接加载裸模型。
# base 与 vanilla 默认不重评（67 号已经评过、结果就在同一个 OUT_DIR 里）。
EVAL_SPECS="${RUN};${ADAPTERS}/${RUN}"
if [[ "${WITH_BASE}" == "1" ]]; then
  EVAL_SPECS="base;|${EVAL_SPECS}"
fi
if [[ "${WITH_VANILLA}" == "1" ]]; then
  EVAL_SPECS="${EVAL_SPECS}|${VANILLA_RUN};${ADAPTERS}/${VANILLA_RUN}"
fi
if [[ -n "${EXTRA_MODELS}" ]]; then
  EVAL_SPECS="${EVAL_SPECS}|${EXTRA_MODELS}"
fi

pending_metrics () {
  # $1=run_name, 其余=候选 metric。已有 summary.json 的跳过，除非 FORCE_EVAL=1。
  local name=$1; shift
  local out=""
  for m in "$@"; do
    if [[ "${FORCE_EVAL}" == "1" || ! -f "${OUT_DIR}/${m}/${name}/summary.json" ]]; then
      out="${out}${out:+,}${m}"
    fi
  done
  echo "${out}"
}

EVAL_NAMES=()
IFS='|' read -ra SPECS <<< "${EVAL_SPECS}"
for spec in "${SPECS[@]}"; do
  name="${spec%%;*}"
  adapter="${spec#*;}"
  if [[ -n "${adapter}" && ! -d "${adapter}" ]]; then
    echo "跳过评测 ${name}：找不到 adapter ${adapter}"
    continue
  fi
  EVAL_NAMES+=("${name}")
  # shellcheck disable=SC2086
  mp="$(pending_metrics "${name}" ${AVAIL})"
  if [[ -z "${mp}" ]]; then
    echo "跳过评测 ${name}：所有指标都已有结果（FORCE_EVAL=1 可重评）"
    continue
  fi
  echo "==== eval: ${name} (${mp}) ===="
  # 一次调用跑完本域所有指标：runner 只加载一次模型，8B 的加载不便宜。
  python -m onereplay.scripts.evaluate \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    --adapter_path "${adapter}" --run_name "${name}" \
    --metrics "${mp}" --out_dir "${OUT_DIR}" --seed "${SEED}" \
    --limit "${LIMIT}" \
    --math_max_new_tokens "${MATH_MAX_NEW_TOKENS}" \
    --code_max_new_tokens "${CODE_MAX_NEW_TOKENS}" \
    --max_new_tokens "${IF_MAX_NEW_TOKENS}" \
    --math_batch_size "${MATH_BATCH}" \
    --code_batch_size "${CODE_BATCH}" \
    --ifeval_batch_size "${IFEVAL_BATCH}" \
    --math500_data_path "${MATH500_FILE}" \
    --gsm8k_data_path "${GSM8K_FILE}" \
    --humaneval_data_file "${HUMANEVAL_FILE}" \
    --mbpp_dataset_path "${MBPP_DIR}" --dataset_split "${MBPP_SPLIT}" \
    --ifeval_input "${IFEVAL_INPUT}" \
    --timeout "${TIMEOUT}" \
    --cache_dir "${TMPDIR}/hf_datasets"
done

# ---------------------------------------------------------------------------
# 长度/截断诊断
#   两个用途：
#   1) 预算够不够 —— hit-cap 接近 0 且 P99 远低于 cap 就说明富余，可以调小省时间；
#      反过来 hit-cap 高就必须调大后**所有臂全部重评**，截断偏差跨 run 不均匀。
#   2) 罚项有没有把模型锁死 —— λ 太大时输出会变短变呆，P50 相对 base/vanilla
#      暴跌就是这个信号，此时分数高低都不作数。
#   no-answer 那一列对 gsm8k 就是「缺 '####' 的比例」，文档 6.3 要求单列报它。
# ---------------------------------------------------------------------------
length_diagnostic () {
  python - "${MODEL_DIR}/${MODEL_NAME}" "$@" <<'PY'
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

model_path, specs = sys.argv[1], sys.argv[2:]
tokenizer = AutoTokenizer.from_pretrained(model_path)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


print("==== response length / truncation diagnostic ====")
for spec in specs:
    path, cap = spec.rsplit(":", 1)
    cap = int(cap)
    file = Path(path)
    if not file.is_file():
        continue
    rows = [json.loads(line) for line in file.open(encoding="utf-8") if line.strip()]
    if not rows:
        continue
    # 各 metric 的字段名不同：数学写 response，代码写 raw，ifeval 写 response。
    texts = [row.get("response", row.get("raw", "")) for row in rows]
    lengths = sorted(
        len(tokenizer(text, add_special_tokens=False)["input_ids"]) for text in texts
    )
    hit_cap = sum(length >= cap - 8 for length in lengths)
    if "prediction" in rows[0]:
        missing = sum(row.get("prediction") in (None, "") for row in rows)
        miss_label = f"no-answer={missing} ({missing / len(rows):.1%}) "
    else:
        miss_label = ""
    label = f"{file.parent.parent.name}/{file.parent.name}"
    print(
        f"{label:>66}: n={len(rows)} cap={cap} {miss_label}"
        f"hit-cap={hit_cap} ({hit_cap / len(rows):.1%}) "
        f"P50={pct(lengths, 50)} P90={pct(lengths, 90)} P99={pct(lengths, 99)} "
        f"max={lengths[-1]}"
    )
print("")
print("读法 1（预算）: hit-cap 接近 0 且 P99 远低于 cap => 可以调小 cap 省时间。")
print("读法 2（λ 过大）: 本臂 P50 相对 base/vanilla 暴跌 => 罚项把模型锁死了，")
print("                 这种情况下分数不是保护效果，扫小一档 λ 再看。")
PY
}

if [[ "${DIAG_LEN}" == "1" ]]; then
  DIAG_SPECS=()
  # base 与 vanilla 的 responses.jsonl 是 67 号留下的，一起打出来才能比 P50。
  DIAG_RUNS=("base" "${VANILLA_RUN}" "${RUN}")
  for name in "${DIAG_RUNS[@]}"; do
    for m in ${AVAIL}; do
      case "${m}" in
        gsm8k|math500) cap="${MATH_MAX_NEW_TOKENS}" ;;
        humaneval|mbpp) cap="${CODE_MAX_NEW_TOKENS}" ;;
        *) cap="${IF_MAX_NEW_TOKENS}" ;;
      esac
      DIAG_SPECS+=("${OUT_DIR}/${m}/${name}/responses.jsonl:${cap}")
    done
  done
  length_diagnostic "${DIAG_SPECS[@]}"
fi

# ---------------------------------------------------------------------------
# 汇总：base / vanilla / 本臂并排
#   delta_base 是遗忘量（负数越大越坏），delta_van 是本臂相对 vanilla 救回来
#   多少（正数越大越好）。后者才是这个方法的效果，前者只是标尺。
# ---------------------------------------------------------------------------
set +x
echo ""
echo "========================================================================"
echo "结果汇总：保护 ${DOMAIN}   λ=${LAMBDA}"
echo "========================================================================"
OUT_DIR="${OUT_DIR}" RUN_NAME="${RUN}" VANILLA_NAME="${VANILLA_RUN}" \
METRIC_NAMES="${AVAIL}" \
RUN_METRICS="${RESULTS_ROOT}/metrics/${RUN}.jsonl" \
VANILLA_METRICS="${RESULTS_ROOT}/metrics/${VANILLA_RUN}.jsonl" \
python - <<'PY'
import json
import os
from pathlib import Path

out_dir = Path(os.environ["OUT_DIR"])
run_name = os.environ["RUN_NAME"]
vanilla_name = os.environ["VANILLA_NAME"]
metric_names = os.environ["METRIC_NAMES"].split()

# 各 metric 的主分数字段名不同，按这个顺序取第一个命中的。
SCORE_KEYS = ("accuracy", "pass_at_1", "strict_prompt_accuracy")


def read_score(metric, name):
    path = out_dir / metric / name / "summary.json"
    if not path.is_file():
        return None
    payload = json.loads(path.read_text(encoding="utf-8"))
    for key in SCORE_KEYS:
        if key in payload:
            return payload[key]
    return None


def cell(value, spec=".4f", width=10):
    return f"{'-' if value is None else format(value, spec):>{width}}"


print(f"{'metric':<12}{'base':>10}{'vanilla':>10}{'onereplay':>11}{'d_base(pp)':>12}{'d_van(pp)':>11}")
print("-" * 66)
for metric in metric_names:
    base = read_score(metric, "base")
    van = read_score(metric, vanilla_name)
    ours = read_score(metric, run_name)
    d_base = (ours - base) * 100 if (base is not None and ours is not None) else None
    d_van = (ours - van) * 100 if (van is not None and ours is not None) else None
    print(
        f"{metric:<12}"
        + cell(base)
        + cell(van)
        + cell(ours, ".4f", 11)
        + cell(d_base, "+.2f", 12)
        + cell(d_van, "+.2f", 11)
    )


def last_epoch(path):
    if not path or not os.path.isfile(path):
        return {}
    rows = []
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                row = json.loads(line)
                if row.get("epoch") is not None:
                    rows.append(row)
    return rows[-1] if rows else {}


ours_m = last_epoch(os.environ.get("RUN_METRICS"))
van_m = last_epoch(os.environ.get("VANILLA_METRICS"))
print()
print("新任务性能与开销（主表必须带上 val_loss，见文档 2.2 节第 1 条）:")
print(f"{'':<14}{'val_loss':>12}{'train_sec':>12}{'peak_mem_GB':>13}{'C_mem_GB':>10}")
for label, row in (("vanilla", van_m), ("onereplay", ours_m)):
    print(
        f"{label:<14}"
        + cell(row.get("val_loss"), ".6f", 12)
        + cell(row.get("train_sec"), ".0f", 12)
        + cell(row.get("peak_memory_gb"), ".2f", 13)
        + cell(row.get("covariance_memory_gb"), ".2f", 10)
    )
if ours_m.get("val_loss") and van_m.get("val_loss"):
    delta = ours_m["val_loss"] - van_m["val_loss"]
    print(f"val_loss 差值 = {delta:+.6f}")
    if delta <= 0:
        print("  <= 0：新任务没被罚项拖慢，上面的 d_van 可以直接当保护效果读。")
    else:
        print("  > 0：新任务学得更差了，d_van 里有一部分是'少学了'而不是'保住了'。")
        print("       报结果时必须同时给这两个数，否则就是拿新任务性能换旧能力。")
PY

echo ""
echo "========================================================================"
echo "接下来要做的三件事（文档 6.3 节）"
echo "========================================================================"
echo "1) 把格式退化和知识退化拆开 —— 光看准确率分不清这两件事:"
echo "   python -m onereplay.scripts.score_retention_subset \\"
echo "     --results_root ${OUT_DIR} --metrics ${AVAIL// /,} \\"
echo "     --runs base,${VANILLA_RUN},${RUN} --baseline base"
echo "   python -m onereplay.scripts.analyze_code_failures \\"
echo "     --results_root ${OUT_DIR} --metrics humaneval,mbpp \\"
echo "     --runs base,${VANILLA_RUN},${RUN} --baseline base"
echo "   （GSM8K 缺 '####' 的比例看上面长度诊断里的 no-answer 那一列）"
echo ""
echo "2) 显著性（配对 McNemar，题量小的时候尤其要看）:"
echo "   python -m onereplay.scripts.compare_significance \\"
echo "     --results_root ${OUT_DIR} --metrics ${AVAIL// /,} \\"
echo "     --runs base,${VANILLA_RUN},${RUN} --baseline ${VANILLA_RUN}"
echo ""
echo "3) 把 λ 扫完再下结论。本次是其中一个点:"
echo "   qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=<0.5x> ${SELF_PATH}"
echo "   qsub -v DRY_RUN=0,DOMAIN=${DOMAIN},LAMBDA=<2x>   ${SELF_PATH}"
echo "   三个点的 λR/task_loss 应该大致线性；若 1x 就已经 >1，中心点选大了。"
echo "   λ 写在 run 名里，不会互相覆盖。"
echo ""
echo "产物:"
echo "  adapter   : ${ADAPTERS}/${RUN}"
echo "  开销/loss : ${RESULTS_ROOT}/metrics/${RUN}.jsonl"
echo "  训练日志  : ${TRAIN_LOG}"
echo "  汇总      : ${OUT_DIR}/<metric>_summary.csv"
echo "  逐题      : ${OUT_DIR}/<metric>/${RUN}/responses.jsonl"
echo ""
echo "本轮的口径，其余各臂必须逐字相同才可比:"
echo "  LoRA r${LORA_RANK} alpha${LORA_ALPHA} dropout${LORA_DROPOUT} targets=${TARGET_MODULES}"
echo "  train lr=${LR} epochs=${EPOCHS} batch=${BATCH} accum=${ACCUM} maxlen=${MAXLEN} eval_batch=${EVAL_BATCH}"
echo "  decode math ${MATH_MAX_NEW_TOKENS}/${MATH_BATCH} code ${CODE_MAX_NEW_TOKENS}/${CODE_BATCH} ifeval ${IF_MAX_NEW_TOKENS}/${IFEVAL_BATCH}"
echo "Job finished at: $(date)"
