#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_mgld_rp
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/logs/onereplay/
#
# =============================================================================
# NUS Hopper: 数学线 gold-target 消融 —— replay 臂（训练 + 数学评测）
#   与 45 号的 cs_replaymix_ifmath_4n4r_rows50-50_seed1 逐字相同，唯一变量是
#   --replay_target_column：
#     45 号  targets       两个池都训在 base 自己生成的答案上
#     本脚本 gold_targets  两个池都训在语料原本的答案上
#   配比保持 4n4r，行权重保持 50/50（45 号的 rows 臂；tokens 臂 0.8/0.2 不在本消融里，
#   它换的是配比这个变量，和 gold 消融混在一起就不是受控对照了）。
#
# -----------------------------------------------------------------------------
# 这条臂在整个消融里的位置
#   gold 消融一共三条臂，分三个脚本投，互不依赖，可以同时排队：
#     63  OneReplay  --cov_path    C_mix_gold
#     64  EWC        --fisher_path F_mix_gold_half
#     65（本脚本）replay --replay_target_column gold_targets
#
#   为什么这条臂要换：文献里 experience replay 的定义是复习**原始训练数据**，所以
#   标准基线本该是 gold。自蒸馏那版是给 OneReplay 用的「信息匹配」对照，可以有，
#   但不能顶替标准基线。换过来之后三条臂消费的是同一批旧知识的同一种答案。
#
# -----------------------------------------------------------------------------
# !! 一个参数同时切两个池，这正是想要的
#   --replay_mix_files 里 if 和 math 两份都是 generate_replay_targets.py 的产物，
#   两份都带 gold_targets 列：if 池的 gold 是 FLAN 原始答案，math 池的 gold 是
#   MetaMath 的 response 字段（一整段带推理过程的解答，不是一个裸数字）。所以一个
#   --replay_target_column 就把两个域同时切到 gold。
#
#   行集不受影响：load_self_distilled_pool 按 truncated 列丢行，与读哪一列无关。
#   gold 臂与自蒸馏臂因此逐行对齐、同序，只有答案文本不同。
#
# !! math 侧是两个文件，不是一个
#   ${SELF_DISTILL_MATH} 是一个通配符，匹配 31 号产出的 canonical + rephrased 两个
#   视角的 jsonl。datasets 的 data_files 会把 glob 展开，两份合起来才是完整的
#   MetaMath30k 池；写死其中一份等于把池砍掉一半，与 45 号不可比。Step 0 的存在性
#   检查因此用 compgen -G 而不是 -f。
#
# -----------------------------------------------------------------------------
# !! 预期这一臂会变弱，而且这不是把对比做偏了 —— 但必须把 token 占比一起报出来
#   loss 是按 supervised token 平均的，行数不是它的单位。08-28 的 stat_replay_pools
#   实测（max_len 2048 下）:
#       FLAN 自蒸馏      17,429 行可用，每行 90.0 个 supervised token
#       MetaMath 自蒸馏  25,114 行可用，每行 357.1 个
#   而 Commonsense 的目标只有 7.0 个 token（"the correct answer is option1" 这类）。
#   代进 4n4r / 行权重 50-50，回放侧吃掉的 supervised token 约 97%，比 IF 线自蒸馏
#   那版实测的 93.16% 还高。也就是说自蒸馏 replay 基线的 retention 优势里，有很大
#   一块是「几乎没在学新任务」换来的。
#
#   换 gold 之后这个占比会掉，replay 基线会跟着变弱——这是 target 长度变了，不是
#   gold 这个做法本身更差。数学域的 gold（MetaMath response）是完整解答，比代码域的
#   gold 长得多，所以掉的幅度应当明显小于代码线，但具体多少要实测。
#   行占比 50% 不等于梯度占比 50%。Step 0b 会用真实 tokenizer 把两版的占比都量出来，
#   **这两个数必须并排写进结果表**，否则分数会被误读成方法上的差距。
#
# -----------------------------------------------------------------------------
# !! 怎么确认它真的训在 gold 上
#   metrics jsonl 里没有 replay_target_column 这个字段，所以自检查不到它。证据有三处：
#     1) Step 0a 打印的 flavor，应为 "gold-target (column gold_targets ...)"
#     2) 训练日志里 build_replay_pools 打印的 "replay targets: ..."，同上
#     3) Step 0b 量出的 gold token 数，与训练日志里的 train_tokens 量级要对得上
#   若看到 "self-distilled"，说明 --replay_target_column 没传进去，这一臂等于重跑 45 号。
#
# -----------------------------------------------------------------------------
# !! 训练超参必须与 45 号逐字相同，否则消融不成立
#   BATCH=8（4 新 + 4 回放）、ACCUM=128（16 步 x 4 = 64 行新任务/更新，与 32/48/63/64
#   的 ACCUM=64 等价）、EVAL_BATCH=8、EPOCHS=3、LR=1e-4、MAXLEN=512。
#   REPLAY_MAX_LEN=2048 只作用于回放行，有两个理由：C_math 是在 2048 下采的，回放行
#   截到 512 就等于在保护比惩罚项更少的旧知识；而且训练期截断保留的是**最后**
#   max_len 个 token，MetaMath 池在 512 下有 21.6% 被截断、其中 16.2% 连题目都没了，
#   退化成无题干的数学续写。2048 下该池 0% 截断（prompt+target 最大 2008）。
#   FLAN 侧 prompt+target 最大 503，设 2048 对它逐字无影响。
#   --replay_lambda 0 且 --measure_replay_when_lambda_zero 0：这一臂没有罚项，连协
#   方差都不该加载，否则白付一份显存和每步计算。
#
# -----------------------------------------------------------------------------
# 预算与拆投
#   回放行长约 4 倍，单步比 63/64 重；45 号估过单臂 3 epoch 约 5~8 h，再加数学评测
#   （math500 500 题 + gsm8k 1319 题，cap 4096）约 3~5 h。装得进 24 h，但估值不确定
#   度不小（取决于 padding 分布）。保险起见可以拆两次投：先 DO_EVAL=0 只训练，再
#   DO_TRAIN=0 只评测。两边都能续跑，超时后原样再投即可。
#   OOM 时的退档顺序：REPLAY_MAX_LEN 1024（峰值砍半，但要在结果里记下 4.8% 的截断率）
#   -> 再动 BATCH/REPLAY_PER_BATCH（ACCUM 要同步改，保证新任务行/更新仍是 64）。
#
# -----------------------------------------------------------------------------
# 用法（**本站点 qsub 不吃命令行变量**，开关改「阶段开关」段的默认值）
#   qsub onereplay/pbs/65_math_gold_replay.pbs
#
#   DRY_RUN=1   只打印 run 名、flavor 和 token 占比测算，不训练不评测（建议先跑）
#   DO_TRAIN=0 / DO_EVAL=0 / FORCE_TRAIN=1 / FORCE_EVAL=1
#
# 前置条件
#   1) ${SELF_DISTILL_IF}   = results/replay/flan_selfdistill_20000_seed1.jsonl
#   2) ${SELF_DISTILL_MATH} = results/replay/metamath_cmath_30k_*_selfdistill_seed1.jsonl
#      （31 号产物，canonical + rephrased 两个视角）
#      本脚本读它们的 gold_targets 列，不重新生成任何语料
#   3) ${CS_DATASET} = datasets/commonsense_170k_hf
#   4) 数学评测数据 ${MATH_DATA_DIR}/{math500,gsm8k}_test.jsonl
#   5) mkdir -p /scratch/weiliu87/logs/onereplay
#
# 本臂不依赖 62 号与混合步骤：它不用 C 也不用 F，可以和它们并行排队。
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/65_math_gold_replay.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME CS_DATASET RESULTS_ROOT MATH_DATA_DIR DATASET_CACHE OUT_DIR
    DRY_RUN DO_TRAIN DO_EVAL FORCE_TRAIN FORCE_EVAL
    SEED EPOCHS LR BATCH ACCUM MAXLEN VAL_FRAC MAXVAL TARGET_MODULES
    EVAL_BATCH SAVE MAX_STEPS
    REPLAY_PER_BATCH REPLAY_MAX_LEN SELF_DISTILL_IF SELF_DISTILL_MATH
    GOLD_COLUMN W_IF_ROWS W_MATH_ROWS RUN_TAG
    MODELS EXTRA_MODELS
    MATH500_FILE GSM8K_FILE AMC_FILE AIME_FILE WITH_AMC_AIME
    MATH_MAX_NEW_TOKENS LIMIT DIAG_LEN
    WITH_IF IFEVAL_INPUT
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # 不能用 exec：那会把当前 shell 替换掉，上面的 cleanup trap 就跟着没了。
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的训练与评测。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

# ---- 项目路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results}"
CS_DATASET="${CS_DATASET:-${REPO_ROOT}/datasets/commonsense_170k_hf}"
MATH_DATA_DIR="${MATH_DATA_DIR:-${REPO_ROOT}/datasets/math}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
ADAPTERS="${RESULTS_ROOT}/adapters"
export HF_DATASETS_CACHE="${DATASET_CACHE}"

# ---- 阶段开关 ----
DRY_RUN="${DRY_RUN:-1}"          # 默认只打印计划与 token 占比，确认无误后改 0
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"

# ---- 训练超参：与 45 号逐字一致，唯一变量是 target 列 ----
SEED="${SEED:-1}"
EPOCHS="${EPOCHS:-3}"
LR="${LR:-1e-4}"
BATCH="${BATCH:-8}"
ACCUM="${ACCUM:-128}"            # 行数：16 步 x 4 行新任务 = 64 行/更新，与 63/64 一致
EVAL_BATCH="${EVAL_BATCH:-8}"    # 钉住，否则 val_loss 与 45/63/64 不可比
MAXLEN="${MAXLEN:-512}"
VAL_FRAC="${VAL_FRAC:-0.01}"
MAXVAL="${MAXVAL:-1000}"
TARGET_MODULES="${TARGET_MODULES:-q_proj,v_proj}"
SAVE="${SAVE:-1}"
MAX_STEPS="${MAX_STEPS:-0}"

# ---- 回放设定 ----
REPLAY_PER_BATCH="${REPLAY_PER_BATCH:-4}"     # 4n4r
REPLAY_MAX_LEN="${REPLAY_MAX_LEN:-2048}"      # 只作用于回放行，见文件头
SELF_DISTILL_IF="${SELF_DISTILL_IF:-${RESULTS_ROOT}/replay/flan_selfdistill_20000_seed1.jsonl}"
# 通配符：canonical + rephrased 两个视角，两份合起来才是完整的 MetaMath30k 池。
SELF_DISTILL_MATH="${SELF_DISTILL_MATH:-${RESULTS_ROOT}/replay/metamath_cmath_30k_*_selfdistill_seed1.jsonl}"
GOLD_COLUMN="${GOLD_COLUMN:-gold_targets}"    # 本消融的全部改动就这一行
W_IF_ROWS="${W_IF_ROWS:-0.5}"
W_MATH_ROWS="${W_MATH_ROWS:-0.5}"

NEW_PER_BATCH=$(( BATCH - REPLAY_PER_BATCH ))

# ---- run 名：与 45 号同一套命名，多一个 _gold 段 ----
# 权重归一化成整数百分比进名字，改了配比必然改名，不会出现两批不同配比的结果落进
# 同一个 adapter / summary 行。别把 50-50 写死。
RUN_TAG="${RUN_TAG:-gold}"
weight_tag () {
  awk -F, -v spec="$1" 'BEGIN{
    n = split(spec, w, ",")
    s = 0
    for (i = 1; i <= n; i++) s += w[i]
    out = ""
    for (i = 1; i <= n; i++) out = out (i > 1 ? "-" : "") sprintf("%d", w[i] / s * 100 + 0.5)
    print out
  }'
}
RUN="cs_replaymix_ifmath_${RUN_TAG}_${NEW_PER_BATCH}n${REPLAY_PER_BATCH}r_rows$(weight_tag "${W_IF_ROWS},${W_MATH_ROWS}")_seed${SEED}"

# ---- 评测：与 32/33/45/48 同口径，所有 run 必须同预算才可比 ----
MATH500_FILE="${MATH500_FILE:-${MATH_DATA_DIR}/math500_test.jsonl}"
GSM8K_FILE="${GSM8K_FILE:-${MATH_DATA_DIR}/gsm8k_test.jsonl}"
AMC_FILE="${AMC_FILE:-${MATH_DATA_DIR}/amc_test.jsonl}"
AIME_FILE="${AIME_FILE:-${MATH_DATA_DIR}/aime_test.jsonl}"
WITH_AMC_AIME="${WITH_AMC_AIME:-0}"          # AMC(83)/AIME(60) 接近地板，数学线已判为放弃
MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS:-4096}"   # 必须与 32/45/48 同值才可比
LIMIT="${LIMIT:-0}"
DIAG_LEN="${DIAG_LEN:-1}"

WITH_IF="${WITH_IF:-0}"
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"

MODELS="${MODELS:-}"
EXTRA_MODELS="${EXTRA_MODELS:-}"

OUT_DIR="${OUT_DIR:-${RESULTS_ROOT}}"
if [[ "${LIMIT}" != "0" ]]; then
  OUT_DIR="${OUT_DIR}_limit${LIMIT}"
fi

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
if (( ACCUM % BATCH != 0 )); then
  echo "ACCUM=${ACCUM} 不能被 BATCH=${BATCH} 整除，每次更新的行数会被静默取整"; exit 1
fi
# 每次更新的新任务行数必须是 64，否则这一臂和 63/64 走的不是同一条优化轨迹。
# 放在训练前算一遍：训练后的自检要等十几小时才会报同一件事。
NEW_PER_UPDATE=$(( (ACCUM / BATCH) * NEW_PER_BATCH ))
if (( NEW_PER_UPDATE != 64 )); then
  echo "新任务行/更新=${NEW_PER_UPDATE}，与 63/64 的 64 不符；调 ACCUM 或 REPLAY_PER_BATCH"
  exit 1
fi
mkdir -p "${ADAPTERS}" "${RESULTS_ROOT}/metrics" "${OUT_DIR}" "${DATASET_CACHE}"

echo "run      = ${RUN}"
echo "配比     = ${NEW_PER_BATCH}n${REPLAY_PER_BATCH}r, 行权重 if=${W_IF_ROWS} math=${W_MATH_ROWS}, 读列=${GOLD_COLUMN}"
echo "micro-batch=${BATCH} (${NEW_PER_BATCH} 新 + ${REPLAY_PER_BATCH} 回放), accum_steps=$(( ACCUM / BATCH )), 新任务行/更新=${NEW_PER_UPDATE}"
echo "回放截断 = ${REPLAY_MAX_LEN}（新任务留在 ${MAXLEN}）"
echo "IF   corpus: ${SELF_DISTILL_IF}"
echo "MATH corpus: ${SELF_DISTILL_MATH}"
echo "OUT_DIR  = ${OUT_DIR}"
echo "对照(自蒸馏版, 45 号): cs_replaymix_ifmath_${NEW_PER_BATCH}n${REPLAY_PER_BATCH}r_rows50-50_seed${SEED}"

# ===========================================================================
# Step 0: 前置检查 + flavor + gold 池的 token 占比实测
# ===========================================================================
echo "==== Step 0: 前置检查 ===="
[[ -f "${SELF_DISTILL_IF}" ]] || { echo "缺 IF 自蒸馏语料: ${SELF_DISTILL_IF}"; exit 1; }
# glob 要留给 datasets/python 展开，这里只确认至少匹配到一个文件。
if ! compgen -G "${SELF_DISTILL_MATH}" > /dev/null; then
  echo "缺 MetaMath 自蒸馏语料: ${SELF_DISTILL_MATH}（31 号产物，两个视角）"
  exit 1
fi
[[ -d "${CS_DATASET}" ]] || { echo "缺 commonsense_170k: ${CS_DATASET}"; exit 1; }

echo "==== Step 0a: 确认这一臂会训在哪种答案上 ===="
# 训练时 build_replay_pools 会打同一行。这里先打一次，配置错了立刻停，
# 不用等训练起来才发现。
python - "${SELF_DISTILL_IF}" "${SELF_DISTILL_MATH}" "${GOLD_COLUMN}" <<'PY'
import argparse
import sys

from onereplay.data.replay import replay_target_flavor

if_path, math_path, column = sys.argv[1:4]
args = argparse.Namespace(
    replay_self_distill_file="",
    replay_mix_files=f"if={if_path},math={math_path}",
    replay_target_column=column,
)
flavor = replay_target_flavor(args)
print(f"replay targets: {flavor}")
if "gold" not in flavor:
    raise SystemExit(
        f"这一臂会训在 {flavor} 上，不是 gold。--replay_target_column 没生效的话，"
        "本作业等于重跑一遍 45 号。"
    )
print("OK: 这一臂训在 gold 答案上")
PY

echo "==== Step 0b: 量 gold 池的 supervised token，算真实的梯度占比 ===="
python - "${MODEL_DIR}/${MODEL_NAME}" "${SELF_DISTILL_IF}" "${SELF_DISTILL_MATH}" \
         "${GOLD_COLUMN}" "${REPLAY_MAX_LEN}" "${NEW_PER_BATCH}" "${REPLAY_PER_BATCH}" \
         "${W_IF_ROWS}" "${W_MATH_ROWS}" <<'PY'
import glob
import json
import sys

from transformers import AutoTokenizer

model_path, if_pattern, math_pattern, column, max_len = sys.argv[1:6]
max_len = int(max_len)
new_per_batch, replay_per_batch = int(sys.argv[6]), int(sys.argv[7])
w_if, w_math = float(sys.argv[8]), float(sys.argv[9])

# Measured on the IF line; Commonsense targets are things like
# "the correct answer is option1". Quoted so the arithmetic below is
# reproducible without launching a training job.
NEW_TASK_TOKENS = 7.0
SAMPLE = 4000

tokenizer = AutoTokenizer.from_pretrained(model_path)


def mean_supervised(pattern, column):
    """Mean answer tokens per usable row, capped at max_len like training does.

    The math pool is two files (canonical + rephrased) and the two views differ
    in phrasing, so the sample budget is split evenly across whatever the glob
    matches instead of being spent entirely on the first file.
    """

    paths = sorted(glob.glob(pattern)) or [pattern]
    per_file = max(1, SAMPLE // len(paths))
    texts = []
    for path in paths:
        taken = 0
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                if not line.strip():
                    continue
                row = json.loads(line)
                # Training drops truncated rows and empty answers; so must this.
                if row.get("truncated"):
                    continue
                text = str(row.get(column) or "").strip()
                if not text:
                    continue
                texts.append(text)
                taken += 1
                if taken >= per_file:
                    break
    if not texts:
        return 0.0, 0
    encoded = tokenizer(texts, add_special_tokens=False)["input_ids"]
    capped = [min(len(ids), max_len) for ids in encoded]
    return sum(capped) / len(capped), len(capped)


means = {}
for label, pattern in (("if", if_pattern), ("math", math_pattern)):
    for col in ("targets", column):
        mean, n = mean_supervised(pattern, col)
        means[(label, col)] = mean
        tag = "自蒸馏" if col == "targets" else "gold   "
        print(f"{label:>4} {tag} 平均 supervised token = {mean:7.1f}  (采样 {n} 行)")

if_sd, math_sd = means[("if", "targets")], means[("math", "targets")]
if_gold, math_gold = means[("if", column)], means[("math", column)]


def token_share(if_len, math_len):
    """replay 占一个 micro-batch 里全部 supervised token 的比例。"""

    replay_tokens = replay_per_batch * (w_if * if_len + w_math * math_len)
    new_tokens = new_per_batch * NEW_TASK_TOKENS
    return replay_tokens / (replay_tokens + new_tokens)


print(f"\n配比 {new_per_batch}n{replay_per_batch}r, 行权重 if={w_if} math={w_math}, "
      f"新任务每行 {NEW_TASK_TOKENS} token")
print(f"  自蒸馏: replay 占 supervised token {token_share(if_sd, math_sd):.2%}")
print(f"  gold  : replay 占 supervised token {token_share(if_gold, math_gold):.2%}")
print(
    "\n这两个数必须并排写进结果表。行占比 50% 不等于梯度占比 50%：按 08-28 的池统计\n"
    "（FLAN 90.0 / MetaMath 357.1 token 每行）自蒸馏那版约 97%，也就是说 replay 基线的\n"
    "retention 有一大块是没在学新任务换来的。gold 版掉多少，决定了这一臂的分数该怎么读。\n"
    "训练时 BatchMixedReplayLoader 会打印同样的份额，可以对上。"
)
PY

if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只做前置检查与 token 占比测算，不训练不评测。"
  echo "确认 Step 0a 说的是 gold、Step 0b 的占比合理之后，把默认值改 0 再投。"
  echo "Job finished at: $(date)"
  exit 0
fi

# ===========================================================================
# 训练
# ===========================================================================
if [[ "${DO_TRAIN}" == "1" ]]; then
  if [[ "${FORCE_TRAIN}" != "1" && "${SAVE}" == "1" && -d "${ADAPTERS}/${RUN}" ]]; then
    echo "跳过训练 ${RUN}：adapter 已存在（FORCE_TRAIN=1 可强制重训）"
  else
    mkdir -p "${RESULTS_ROOT}/map_cache/${RUN}"
    echo "==== train: ${RUN} (${GOLD_COLUMN}, ${NEW_PER_BATCH}n${REPLAY_PER_BATCH}r) ===="
    python -m onereplay.scripts.train --paradigm sft \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" --seed "${SEED}" \
      --dataset_path "${CS_DATASET}" \
      --epochs "${EPOCHS}" --lr "${LR}" --batch_size "${BATCH}" --accumulation_size "${ACCUM}" \
      --eval_batch_size "${EVAL_BATCH}" \
      --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" --max_len "${MAXLEN}" \
      --target_modules "${TARGET_MODULES}" \
      --map_cache_dir "${RESULTS_ROOT}/map_cache/${RUN}" \
      --max_steps "${MAX_STEPS}" \
      --replay_lambda 0 --measure_replay_when_lambda_zero 0 \
      --replay_per_batch "${REPLAY_PER_BATCH}" \
      --replay_max_len "${REPLAY_MAX_LEN}" \
      --replay_mix_files "if=${SELF_DISTILL_IF},math=${SELF_DISTILL_MATH}" \
      --replay_mix_weights "${W_IF_ROWS},${W_MATH_ROWS}" \
      --replay_target_column "${GOLD_COLUMN}" \
      --replay_drop_truncated 1 \
      --replay_cache_dir "${DATASET_CACHE}" \
      --save "${SAVE}" --save_path "${ADAPTERS}/${RUN}" \
      --metrics_path "${RESULTS_ROOT}/metrics/${RUN}.jsonl"

    echo "==== 训练自检: ${RUN} ===="
    python - "${RESULTS_ROOT}/metrics/${RUN}.jsonl" "${W_IF_ROWS},${W_MATH_ROWS}" \
             "${REPLAY_MAX_LEN}" "${REPLAY_PER_BATCH}" <<'PY'
import json
import sys

path, want_weights, want_max_len, want_replay_per_batch = sys.argv[1:5]
want_max_len = int(want_max_len)
want_replay_per_batch = int(want_replay_per_batch)

epochs = []
with open(path, encoding="utf-8") as handle:
    for line in handle:
        if not line.strip():
            continue
        row = json.loads(line)
        if row.get("epoch") is not None:
            epochs.append(row)
if not epochs:
    raise SystemExit(f"{path} 里没有 epoch 记录，训练没有跑完一个 epoch")
last = epochs[-1]

print(f"epochs done        = {len(epochs)}")
print(f"replay_mix_labels  = {last.get('replay_mix_labels')}")
print(f"replay_mix_weights = {last.get('replay_mix_weights')} (want {want_weights})")
print(f"replay_max_len     = {last.get('replay_max_len')} (want {want_max_len})")
print(f"replay_per_batch   = {last.get('replay_per_batch')} (want {want_replay_per_batch})")
print(f"batch_size         = {last.get('batch_size')} (micro-batch)")
print(f"eval_batch_size    = {last.get('eval_batch_size')} (want 8, 见文件头)")
print(f"new_per_update     = {last.get('new_per_update')} (want 64)")
print(f"replay_lambda      = {last.get('replay_lambda')} (want 0)")
print(f"train_tokens       = {last.get('train_tokens')}")
print(f"val_loss           = {last.get('val_loss')}")
print(
    "\n注: metrics 里没有 replay_target_column 这个字段，所以这里查不到它。"
    "\n    确认训在 gold 上要看 Step 0a 和训练日志里的 'replay targets: ...' 那行，"
    "\n    以及 train_tokens 与 Step 0b 的 gold 预测量级是否对得上。"
)

failures = []
if int(last.get("new_per_update") or 0) != 64:
    failures.append(
        f"新任务行/更新={last.get('new_per_update')}，与 63/64 的 64 不符，"
        "这一臂走的不是同一条优化轨迹"
    )
if float(last.get("replay_lambda") or 0.0) != 0.0:
    failures.append("replay_lambda 不为 0，这一臂混进了正则项，就不再是纯 replay 基线")
if int(last.get("replay_per_batch") or 0) != want_replay_per_batch:
    failures.append(
        f"replay_per_batch={last.get('replay_per_batch')}，与本次要求的 {want_replay_per_batch} 不符"
    )
if int(last.get("replay_max_len") or 0) != want_max_len:
    failures.append(
        f"replay_max_len={last.get('replay_max_len')}，与本次要求的 {want_max_len} 不符；"
        "回放行截得比采 C 时短就等于保护了更少的旧知识"
    )
got = [float(piece) for piece in (last.get("replay_mix_weights") or "").split(",") if piece]
asked = [float(piece) for piece in want_weights.split(",") if piece]
asked = [weight / sum(asked) for weight in asked] if asked else []
if len(got) != len(asked) or any(abs(a - b) > 1e-3 for a, b in zip(got, asked)):
    failures.append(f"记录的域配比 {got} 与本臂要求的 {asked} 不一致")

if failures:
    print("\n训练自检失败:")
    for item in failures:
        print(f"  - {item}")
    raise SystemExit(1)
print("\n训练自检通过")
PY
  fi
else
  echo "DO_TRAIN=0：跳过训练"
fi

# ===========================================================================
# 评测：math500 + gsm8k（+ 可选 amc/aime、IFEval），与 32/33/45/48 同口径
# ===========================================================================
if [[ "${DO_EVAL}" != "1" ]]; then
  echo "DO_EVAL=0：跳过评测"
  set +x
  echo "Job finished at: $(date)"
  exit 0
fi

EVAL_SPECS="${RUN};${ADAPTERS}/${RUN}"
for m in ${MODELS}; do EVAL_SPECS="${EVAL_SPECS}|${m};${ADAPTERS}/${m}"; done
if [[ -n "${EXTRA_MODELS}" ]]; then
  EVAL_SPECS="${EVAL_SPECS}|${EXTRA_MODELS}"
fi

# 缺哪个数据文件就跳过哪个指标（数据没搬全时不至于整个作业白挂）。
MATH_AVAIL=""
if [[ -f "${MATH500_FILE}" ]]; then MATH_AVAIL="${MATH_AVAIL} math500"; else echo "跳过 math500：缺 ${MATH500_FILE}"; fi
if [[ -f "${GSM8K_FILE}"  ]]; then MATH_AVAIL="${MATH_AVAIL} gsm8k";   else echo "跳过 gsm8k：缺 ${GSM8K_FILE}"; fi
if [[ "${WITH_AMC_AIME}" == "1" ]]; then
  if [[ -f "${AMC_FILE}"  ]]; then MATH_AVAIL="${MATH_AVAIL} amc";  else echo "跳过 amc：缺 ${AMC_FILE}"; fi
  if [[ -f "${AIME_FILE}" ]]; then MATH_AVAIL="${MATH_AVAIL} aime"; else echo "跳过 aime：缺 ${AIME_FILE}"; fi
fi
MATH_AVAIL="${MATH_AVAIL# }"
if [[ -z "${MATH_AVAIL}" ]]; then
  echo "找不到任何数学评测数据（${MATH500_FILE} / ${GSM8K_FILE}），跳过评测"
  set +x
  echo "Job finished at: $(date)"
  exit 0
fi
echo "MATH_AVAIL=[${MATH_AVAIL}]"

pending_metrics () {
  # $1=run_name, 其余=候选 metric。已有 summary.json 的跳过，除非 FORCE_EVAL=1。
  local name=$1; shift
  local out=""
  for m in "$@"; do
    if [[ "${FORCE_EVAL}" == "1" || ! -f "${OUT_DIR}/${m}/${name}/summary.json" ]]; then
      out="${out}${out:+,}${m}"
    fi
  done
  echo "${out}"
}

EVAL_NAMES=()
IFS='|' read -ra SPECS <<< "${EVAL_SPECS}"
for spec in "${SPECS[@]}"; do
  name="${spec%%;*}"
  adapter="${spec#*;}"
  if [[ ! -d "${adapter}" ]]; then
    echo "跳过评测 ${name}：找不到 adapter ${adapter}"
    continue
  fi
  EVAL_NAMES+=("${name}")
  # shellcheck disable=SC2086
  mp="$(pending_metrics "${name}" ${MATH_AVAIL})"
  if [[ -z "${mp}" ]]; then
    echo "跳过数学评测 ${name}：所有数学指标都已有结果（FORCE_EVAL=1 可重评）"
  else
    echo "==== eval math: ${name} (${mp}) ===="
    python -m onereplay.scripts.evaluate \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
      --adapter_path "${adapter}" --run_name "${name}" \
      --metrics "${mp}" --out_dir "${OUT_DIR}" --seed "${SEED}" \
      --math_max_new_tokens "${MATH_MAX_NEW_TOKENS}" --limit "${LIMIT}" \
      --math500_data_path "${MATH500_FILE}" \
      --gsm8k_data_path "${GSM8K_FILE}" \
      --amc_data_path "${AMC_FILE}" \
      --aime_data_path "${AIME_FILE}"
  fi

  if [[ "${WITH_IF}" == "1" ]]; then
    ip="$(pending_metrics "${name}" ifeval)"
    if [[ -n "${ip}" ]]; then
      echo "==== eval IF: ${name} ===="
      python -m onereplay.scripts.evaluate \
        --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
        --adapter_path "${adapter}" --run_name "${name}" \
        --metrics ifeval --out_dir "${OUT_DIR}" --seed "${SEED}" \
        --ifeval_input "${IFEVAL_INPUT}"
    fi
  fi
done

# ---------------------------------------------------------------------------
# 长度/截断诊断：用 responses.jsonl 反查 MATH_MAX_NEW_TOKENS 够不够
#   no-answer : 没抽出答案的比例；hit-cap : 生成长度顶到上限的比例。
# ---------------------------------------------------------------------------
length_diagnostic () {
  python - "${MODEL_DIR}/${MODEL_NAME}" "${MATH_MAX_NEW_TOKENS}" "$@" <<'PY'
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

model_path, cap, paths = sys.argv[1], int(sys.argv[2]), sys.argv[3:]
tokenizer = AutoTokenizer.from_pretrained(model_path)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


print(f"==== response length / truncation diagnostic (cap={cap}) ====")
for path in paths:
    file = Path(path)
    if not file.is_file():
        continue
    rows = [json.loads(line) for line in file.open(encoding="utf-8") if line.strip()]
    if not rows:
        continue
    lengths = sorted(
        len(tokenizer(row.get("response", ""), add_special_tokens=False)["input_ids"])
        for row in rows
    )
    missing = sum(row.get("prediction") in (None, "") for row in rows)
    hit_cap = sum(length >= cap - 8 for length in lengths)
    label = f"{file.parent.parent.name}/{file.parent.name}"
    print(
        f"{label:>52}: n={len(rows)} "
        f"no-answer={missing} ({missing / len(rows):.1%}) "
        f"hit-cap={hit_cap} ({hit_cap / len(rows):.1%}) "
        f"P50={pct(lengths, 50)} P90={pct(lengths, 90)} P99={pct(lengths, 99)} max={lengths[-1]}"
    )
print("hit-cap 接近 0 且 P99 明显低于 cap => 预算够用；否则提高 MATH_MAX_NEW_TOKENS 后重评。")
PY
}

if [[ "${DIAG_LEN}" == "1" && ${#EVAL_NAMES[@]} -gt 0 ]]; then
  DIAG_FILES=()
  for m in ${MATH_AVAIL}; do
    for name in "${EVAL_NAMES[@]}"; do
      DIAG_FILES+=("${OUT_DIR}/${m}/${name}/responses.jsonl")
    done
  done
  length_diagnostic "${DIAG_FILES[@]}"
fi

set +x
echo "========================================================================"
echo "run   : ${RUN}"
echo "汇总  : ${OUT_DIR}/<metric>_summary.csv"
echo "逐题  : ${OUT_DIR}/<metric>/${RUN}/responses.jsonl"
echo "所有 run 必须用同一个 MATH_MAX_NEW_TOKENS=${MATH_MAX_NEW_TOKENS} 才可比。"
echo "GSM8K 要同时报 production 与 strict（缺 '####' 的比例），见任务3 文档 5.2 节。"
echo ""
echo "对照读法（同一份 CSV，自蒸馏版不用重评）:"
echo "  自蒸馏 cs_replaymix_ifmath_${NEW_PER_BATCH}n${REPLAY_PER_BATCH}r_rows50-50_seed${SEED}   <- 45 号"
echo "  gold   ${RUN}"
echo "  写结果表时把 Step 0b 的两个 token 占比一起写上，否则分数会被误读。"
echo ""
echo "整体分数之外，务必再看 base 答对子集上的保留率:"
echo "  python -m onereplay.scripts.score_retention_subset \\"
echo "    --results_root ${OUT_DIR} --metrics gsm8k,math500 \\"
echo "    --runs base,cs_vanilla_seed${SEED},${RUN} --baseline base"
echo "Job finished at: $(date)"
