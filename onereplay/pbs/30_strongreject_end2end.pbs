#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N or_strongreject
#PBS -j oe
#PBS -k oed
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/logs/onereplay/
#
# =============================================================================
# NUS Hopper (PBS + Singularity): 问题 1 StrongREJECT 越狱补充评测
#   生成 + StrongREJECT 官方微调 autograder 评分 + 配对统计，一次跑完。
#
# 由 onereplay/slurm/30_strongreject_end2end.slurm 迁移而来。评测算法逐字一致，
# 改动只在集群层（照 pbs/33、pbs/42 与本目录 28_safety_end2end.pbs）：
#   1) PBS 指令替代 SBATCH；提交用 qsub。
#   2) 计算在 Singularity 容器里跑，venv 在容器内激活；脚本把自己在容器里再跑一遍。
#   3) zsh -> bash：`read -rA` 改 `read -ra`。
#   4) 路径迁到 /scratch，用独立的 results_safety 树，adapter 取从 RWTH 搬来的那份。
#
# -----------------------------------------------------------------------------
# 本脚本把 base / vanilla / EWC(λ=3e2) / Replay(4n4r) / OneReplay(λ=3e-2) 五条
# 一起测（RWTH 上一条都没跑完，迁移也没搬 SR 结果，所以五条全新生成）。
#   run 名与 28 号逐字相同，两套判分口径（WildGuard vs StrongREJECT）才对得上。
#   SR track 每条 forbidden prompt 生成 direct + 5 个越狱外壳版本；生成结果写到独立
#   的 SR_ROOT，避免覆盖 A/B/C 的 responses.jsonl。
#
#   grader（qylu4156/strongreject-15k-v1）是 LoRA，只有 adapter_model.safetensors，
#   它的冻结底座 google/gemma-2b（gated）要在 HF cache 里（登录节点已下），judge
#   脚本靠 adapter_config.json 里的 repo id 离线解析。
#
#   断点续跑：已有 summary.json 的 run 跳过生成（约 2.7h/run，五条约 14h），已有
#   scored_sr.jsonl 的 run 跳过评分（FORCE_GEN=1 / FORCE_SCORE=1 强制重跑）。超时被
#   砍后原样再投即可接着跑。完成标记用 summary.json 而非边写边追加的 responses.jsonl。
#
# 用法:
#   mkdir -p /scratch/weiliu87/logs/onereplay      # qsub 前必须存在，且在仓库外
#   qsub onereplay/pbs/30_strongreject_end2end.pbs
#   只做前置检查、不真跑:  改下方 DRY_RUN 默认值为 1 再 qsub
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id> / gstat
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/30_strongreject_end2end.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  EXTRA_BIND="-B /local_ssd:/local_ssd"
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_onereplay_${JOBTAG}}"
else
  EXTRA_BIND=""
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_onereplay_${JOBTAG}}"
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_onereplay_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      if [[ -f "${_init}" ]]; then
        source "${_init}"
        break
      fi
    done
  fi
  module load singularity

  # -e/--cleanenv 会清环境，只有 SINGULARITYENV_/APPTAINERENV_ 前缀的变量能进容器。
  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME RESULTS_ROOT SEED
    SAFETY_RAW STRONGREJECT_CSV ITW_PATH NUM_ITW_TEMPLATES NUM_SR SR_WRAP
    SR_PROMPTS SAFETY_MAX_NEW_TOKENS
    SR_MODEL_DIR SR_MODEL_NAME SR_BATCH SR_BASE
    SR_ROOT SR_JUDGE_OUT SR_REPORT
    RUNS FORCE_GEN FORCE_SCORE DO_ANALYZE DRY_RUN
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。以下是真正的评测。
# =============================================================================
set -x

source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
# 离线：模型和数据都在本地盘（gemma-2b 底座也在 HF cache），禁止任何联网调用。
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c "import torch; print('torch', torch.__version__, torch.__file__, 'cuda', torch.cuda.is_available(), torch.cuda.device_count())"

# ---- 项目路径 ----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
MODEL_NAME="${MODEL_NAME:-Qwen3-1.7B}"
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_safety}"
SEED="${SEED:-1}"

# ---- StrongREJECT 数据 + 越狱外壳来源（prompts 已搬时非必需）----
SAFETY_RAW="${SAFETY_RAW:-${REPO_ROOT}/datasets/safety}"
STRONGREJECT_CSV="${STRONGREJECT_CSV:-${SAFETY_RAW}/strongreject_dataset.csv}"
ITW_PATH="${ITW_PATH:-${SAFETY_RAW}/in_the_wild_jailbreak.csv}"
NUM_ITW_TEMPLATES="${NUM_ITW_TEMPLATES:-3}"
NUM_SR="${NUM_SR:-0}"            # 0 = 全部 313 条
SR_WRAP="${SR_WRAP:-1}"          # 1 = 同时生成越狱外壳版本
SR_PROMPTS="${SR_PROMPTS:-${RESULTS_ROOT}/safety_prompts/strongreject_prompts.jsonl}"
SAFETY_MAX_NEW_TOKENS="${SAFETY_MAX_NEW_TOKENS:-256}"

# ---- StrongREJECT grader（strongreject-grader，LoRA；底座 gemma-2b 在 HF cache）----
SR_MODEL_DIR="${SR_MODEL_DIR:-${MODEL_DIR}}"
SR_MODEL_NAME="${SR_MODEL_NAME:-strongreject-grader}"
SR_BATCH="${SR_BATCH:-16}"
# grader 的 base 权重位置。留空 = 用 adapter_config.json 里的 google/gemma-2b，
# 靠 HF cache 离线解析；若 cache 里没有，就设成本地 base 模型目录。
SR_BASE="${SR_BASE:-}"

# ---- 生成结果与评分/分析输出（独立目录，避免覆盖 A/B/C）----
SR_ROOT="${SR_ROOT:-${RESULTS_ROOT}/strongreject}"
SR_JUDGE_OUT="${SR_JUDGE_OUT:-${RESULTS_ROOT}/strongreject_scored}"
SR_REPORT="${SR_REPORT:-${SR_JUDGE_OUT}/strongreject_analysis.json}"

FORCE_GEN="${FORCE_GEN:-0}"       # 1 = 即使已有 responses 也重新生成
FORCE_SCORE="${FORCE_SCORE:-0}"   # 1 = 即使已有 scored_sr.jsonl 也重新评分
DO_ANALYZE="${DO_ANALYZE:-1}"
DRY_RUN="${DRY_RUN:-0}"

cd "${REPO_ROOT}"
[[ -d "${MODEL_DIR}/${MODEL_NAME}" ]] || { echo "缺模型: ${MODEL_DIR}/${MODEL_NAME}"; exit 1; }
# grader 权重自检：查实际文件而不仅仅目录（空目录会让 offline 加载假通过后报错）。
SR_GRADER_DIR="${SR_MODEL_DIR}/${SR_MODEL_NAME}"
[[ -f "${SR_GRADER_DIR}/adapter_model.safetensors" || -f "${SR_GRADER_DIR}/config.json" ]] || {
  echo "缺 grader 权重: ${SR_GRADER_DIR}/(adapter_model.safetensors|config.json)"
  echo "先在登录节点下好（接受 Gemma 授权 + 登录后）:"
  echo "  python -m onereplay.scripts.download_safety_data --only_sr 1 --model_dir ${MODEL_DIR} --out_dir ${SAFETY_RAW}"
  exit 1
}
# StrongREJECT CSV 只有需要重建 prompts 时才必须；prompts 已搬来则不强求。
if [[ ! -f "${SR_PROMPTS}" ]]; then
  [[ -f "${STRONGREJECT_CSV}" ]] || { echo "缺 StrongREJECT CSV 且无现成 prompts: ${STRONGREJECT_CSV}"; exit 1; }
fi

# ---- 构建 StrongREJECT prompts 文件（缺失时才生成）----
if [[ ! -f "${SR_PROMPTS}" ]]; then
  echo "==== build strongreject prompts -> ${SR_PROMPTS} ===="
  itw_arg=(); [[ "${SR_WRAP}" == "1" && -f "${ITW_PATH}" ]] && itw_arg=(--itw_path "${ITW_PATH}" --num_itw_templates "${NUM_ITW_TEMPLATES}")
  python -m onereplay.scripts.prepare_safety_data \
    --strongreject_path "${STRONGREJECT_CSV}" \
    --num_sr "${NUM_SR}" --sr_wrap "${SR_WRAP}" \
    "${itw_arg[@]}" \
    --output_path "${SR_PROMPTS}"
else
  echo "已有 prompts，跳过构建: ${SR_PROMPTS}"
fi

# ---- 待评模型（run_name;adapter_path，adapter 为空即 base）----
#   五条一起测；run 名与 28 号逐字相同。adapter 从 results_safety/adapters 解析。
RUNS="${RUNS:-base;|vanilla_seed${SEED};${RESULTS_ROOT}/adapters/cs_vanilla_seed${SEED}|ewc_lam3e2_seed${SEED};${RESULTS_ROOT}/adapters/cs_ewc_lam3e2_seed${SEED}|replaymix_4n4r_seed${SEED};${RESULTS_ROOT}/adapters/cs_replaymix_4n4r_seed${SEED}|onereplay_lam3e-2_seed${SEED};${RESULTS_ROOT}/adapters/cs_onereplay_lam3e-2_seed${SEED}_regonce}"

IFS='|' read -ra run_specs <<< "${RUNS}"

# ---------------------------------------------------------------------------
# 前置检查：adapter 目录名 + 各 run 已完成到哪一步
# ---------------------------------------------------------------------------
echo "========================================================================"
echo "现有 adapter（${RESULTS_ROOT}/adapters）:"
ls -1 "${RESULTS_ROOT}/adapters" 2>/dev/null || echo "  (目录不存在)"
echo ""
printf "%-30s %-8s %-8s %s\n" "run_name" "生成" "评分" "adapter"
missing_adapter=0
for spec in "${run_specs[@]}"; do
  name="${spec%%;*}"
  adapter="${spec#*;}"
  gen_state="待跑"
  if [[ "${FORCE_GEN}" != "1" && -f "${SR_ROOT}/safety/${name}/summary.json" ]]; then
    gen_state="已有"
  fi
  score_state="待跑"
  if [[ "${FORCE_SCORE}" != "1" && -s "${SR_JUDGE_OUT}/${name}/scored_sr.jsonl" ]]; then
    score_state="已有"
  fi
  if [[ -n "${adapter}" && ! -d "${adapter}" ]]; then
    printf "%-30s %-8s %-8s %s\n" "${name}" "${gen_state}" "${score_state}" "!! 缺 ${adapter}"
    missing_adapter=1
  else
    printf "%-30s %-8s %-8s %s\n" "${name}" "${gen_state}" "${score_state}" "${adapter:-<裸 base>}"
  fi
done
echo "========================================================================"

if [[ "${missing_adapter}" == "1" ]]; then
  echo "有 adapter 目录不存在。核对 run 名后用 RUNS=... 覆盖，或确认迁移是否漏搬。"
  exit 1
fi

if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只做前置检查，不生成也不评分。"
  echo "Job finished at: $(date)"
  exit 0
fi

run_sr_gen () {
  local name=$1
  local adapter=$2
  local -a adapter_arg=()
  if [[ -n "${adapter}" ]]; then adapter_arg=(--adapter_path "${adapter}"); fi

  local done_marker="${SR_ROOT}/safety/${name}/summary.json"
  if [[ "${FORCE_GEN}" != "1" && -f "${done_marker}" ]]; then
    echo "==== strongreject gen: ${name} (跳过，已有 ${done_marker}) ===="
    return 0
  fi

  echo "==== strongreject gen: ${name} ===="
  python -m onereplay.scripts.evaluate \
    --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
    "${adapter_arg[@]}" --run_name "${name}" \
    --metrics safety --out_dir "${SR_ROOT}" --seed "${SEED}" \
    --safety_prompts "${SR_PROMPTS}" \
    --safety_max_new_tokens "${SAFETY_MAX_NEW_TOKENS}"
}

# ---- 阶段 1：逐模型生成；只把还没评分的 run 收进评分清单 ----
RESP_LIST=""
RUN_NAMES=""
for spec in "${run_specs[@]}"; do
  name="${spec%%;*}"
  adapter="${spec#*;}"
  run_sr_gen "${name}" "${adapter}"
  if [[ -z "${RUN_NAMES}" ]]; then RUN_NAMES="${name}"; else RUN_NAMES="${RUN_NAMES},${name}"; fi
  if [[ "${FORCE_SCORE}" != "1" && -s "${SR_JUDGE_OUT}/${name}/scored_sr.jsonl" ]]; then
    echo "已有评分结果，跳过 grade: ${name}"
    continue
  fi
  resp="${SR_ROOT}/safety/${name}/responses.jsonl"
  if [[ -z "${RESP_LIST}" ]]; then RESP_LIST="${resp}"; else RESP_LIST="${RESP_LIST},${resp}"; fi
done

# ---- 阶段 2：StrongREJECT grader 一次性评分待评的所有 run ----
if [[ -n "${RESP_LIST}" ]]; then
  echo "==== strongreject grade: ${RESP_LIST} ===="
  base_arg=()
  if [[ -n "${SR_BASE}" ]]; then base_arg=(--judge_base "${SR_BASE}"); fi
  python -m onereplay.scripts.judge_strongreject \
    --responses "${RESP_LIST}" \
    --judge_model_dir "${SR_MODEL_DIR}" --judge_model_name "${SR_MODEL_NAME}" \
    "${base_arg[@]}" \
    --out_dir "${SR_JUDGE_OUT}" \
    --batch_size "${SR_BATCH}"
else
  echo "==== strongreject grade: 所有 run 都已评分，跳过（FORCE_SCORE=1 可强制重评）===="
fi

# ---- 阶段 2b：重建总汇总（judge 只写本次评的那几个 run）----
echo "==== rebuild ${SR_JUDGE_OUT}/strongreject_all_runs.json ===="
python - "${SR_JUDGE_OUT}" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
overall = {}
for summary_path in sorted(root.glob("*/strongreject_summary.json")):
    summary = json.loads(summary_path.read_text(encoding="utf-8"))
    run_name = summary.pop("run_name", summary_path.parent.name)
    # 与 judge_strongreject 写出的形状一致：只留 summarize_run 的字段
    summary.pop("num_scored", None)
    summary.pop("binary_threshold", None)
    overall[run_name] = summary
(root / "strongreject_all_runs.json").write_text(
    json.dumps(overall, ensure_ascii=False, indent=2), encoding="utf-8"
)
print(f"汇总了 {len(overall)} 个 run: {sorted(overall)}")
PY

# ---- 阶段 3：配对统计分析（均值差 bootstrap + 二值化 McNemar + 攻击增益）----
if [[ "${DO_ANALYZE}" == "1" ]]; then
  echo "==== strongreject analyze -> ${SR_REPORT} ===="
  # 生成产物已落盘；即使统计一步出错也不该把跑了 ~14h 的作业判失败，故 || true 兜底。
  python -m onereplay.scripts.analyze_strongreject \
    --scored "${SR_JUDGE_OUT}/*/scored_sr.jsonl" \
    --runs "${RUN_NAMES}" \
    --out_path "${SR_REPORT}" || true
fi

set +x
echo "产物: ${SR_ROOT}/safety/<run>/{summary.json,responses.jsonl}"
echo "      ${SR_JUDGE_OUT}/<run>/scored_sr.jsonl、${SR_JUDGE_OUT}/strongreject_all_runs.json"
echo "      配对统计: ${SR_REPORT}"
echo "Job finished at: $(date)"
