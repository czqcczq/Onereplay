#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N s3_cs
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/weiliu87/student/czq/Onereplay/logs
#
# =============================================================================
# Stage 3 / 新任务 = Commonsense170k: Model-<SOURCE> --Commonsense170k--> Model-<SOURCE>-CS
#
#     Model-IF / Model-Math ---- Commonsense170k 100k @ 512 ----> Model-X-CS
#                           \                              /
#                            \---- λ·tr(ΔW C_X ΔWᵀ) ------/
#
#     评测  新任务学到多少: commonsense_qa 八个测试集
#           旧能力保留多少: SOURCE=if -> IFEval + FollowBench / SOURCE=math -> GSM8K + MATH-500
#     四行  <source>_anchor (Stage 1 产物 = Stage 3 起点) / vanilla / onereplay / ewc
#
# 这是 Stage 3 三条线里"新任务 = 常识"那一条。另两条是 96 号（新任务 = math）和
# 100 号（新任务 = IF）。三条线的代码形态刻意保持一致，改任何一条的结构要同时改三条。
#
# 大部分逻辑照抄 93 号（同一个数据池、同一套 BATCH/ACCUM/MAXLEN、同一套常识评测
# 预算），下面只讲**不一样的地方**和**为什么**。
#
# -----------------------------------------------------------------------------
# 【与 93 号的四处结构性差别】
#
# 1) 基座不是 Qwen3-4B-Base，而是某条 Stage 1 线训出来的模型（见下面 SOURCE）。
#    train.py 从 --model_dir/--model_name 拼路径加载，全量 checkpoint 是完整权重 +
#    tokenizer，所以直接把 Stage 1 的输出目录当基座传进去，一行代码都不用改。
#
# 2) 加了正则：--cov_path C_X --replay_lambda λ（或 --fisher_path F_X）。93 号是
#    --replay_lambda 0 --measure_replay_when_lambda_zero 0（build_regularizer 返回
#    None，纯 vanilla）。
#
# 3) 多了一条 vanilla 臂，而且它是**必须**的，不是可选对照。
#    「onereplay 保住了旧能力」这句话只有和「不保护会掉多少」并排才有内容。而且各臂
#    必须同 LR / 同 EPOCHS / 同 seed / 同数据池，否则差异里混进别的东西。
#
# 4) 评测多了旧能力那一半，那才是本作业的主指标。新任务侧（commonsense_qa）只是
#    用来做 matched plasticity 的对照量。
#
# -----------------------------------------------------------------------------
# 【这条线为什么值得跑：新任务的输出形态在碾压旧能力的输出形态】
#
# Commonsense170k（LLM-Adapters, arXiv 2304.01933）那 100k 行只教一件事 —— 读完题
# 输出 "the correct answer is <label>"，监督 token 只有 7-8 个（IF 线约 330、math 线
# P50=351）。这是一个极窄、极单一的输出分布，会把模型的输出形态整体塌到 7 个 token。
#
# 而 SOURCE=if 时旧能力考的恰恰是「按任意自然语言约束写长回答」，SOURCE=math 时考的
# 是「写出完整推理再落 \boxed{}」—— 两者都需要输出预算。也就是说新任务的形态本身就
# 在挤压旧能力的形态，这条线因此是三条 Stage 3 线里**遗忘压力最大**的一条。
#
# 如果这条线的 vanilla 确实掉得多，那 onereplay/ewc 之间才有可分辨的空间，
# 「保住的是能力」这句话才有信息量。
#
# -----------------------------------------------------------------------------
# 【采集这一步不需要做：C_X 和 F_X 早就有了】
#
# 罚项是 λ·tr(ΔW C ΔWᵀ)，ΔW = W − W0，W0 是 train.py 在训练开始时从**加载进来的模型**
# 快照的（build_regularizer 之后紧跟 snapshot_reference_weights）。本脚本的基座是某条
# Stage 1 线的产物，所以 W0 = 那个 checkpoint 的权重，C 必须在同一个模型上采 —— 这正是
# 95 号（IF）和 99 号（math）做的事（--model_name = Stage 1 的 run 名）。
#
# 「旧知识侧」（Stage 1 的模型 + 它自己那个 20k 旧知识池）和「新任务换成什么」完全无关，
# 所以这两个文件跨 Stage 3 三条线复用是**正确的**，不是偷懒 —— 换新任务不改变 W0，也
# 不改变旧知识池。这条线因此只有训练 + 评测两件事要做。
#
# Step 0 仍然会读 C/F 的 metadata 把 model_name 和本作业的基座名对表，不一致就退出：
# 这挡的是最贵的错误（拿 Base 上采的 C 配 Stage 1 的 W0，不报错、loss 曲线正常、
# 保护静默变弱）。
#
# 还会打印两个 max_len 并说明它们**本来就不该相等**：C/F 采在旧知识池自己的预算上
# （if 线 2048、math 线 2048），新任务 Commonsense 在 512 训练。罚项只经过 ΔW 与 C
# 相乘，序列长度不需要一致，需要一致的是模型。本线是 C 的预算(2048) > 新任务的
# 预算(512)，方向和 96 号相反，两个都合法。
#
# -----------------------------------------------------------------------------
# 【--reg_impl analytic 不是调优选项，是这条线的必需项】
#
# train.py 的默认是 autograd。全量微调下两条路径算的是同一个罚项，但内存不同，而
# regularizer.py resolve_full_layers 的注释把道理记下来了：analytic 路径**按层**把
# W0 casts 成 fp32，只留一层临时量；autograd 那条会把整个 W0 的 fp32 副本留一整轮。
# 在 Qwen3-4B-Base 上那是 16.1 GiB fp32 叠在 8.0 GiB bf16 之上。
#
# 而且 analytic 天然一次更新只注入一次罚项梯度，与 --reg_once_per_update 1 一致
# （传 0 会直接报错，train.py 里有显式检查）。
#
# -----------------------------------------------------------------------------
# 【正则的计算开销在本线占比比 96 号高，但仍可忽略】
#
# analytic 每次优化器更新做一遍 2λ·ΔW·C，Qwen3-4B-Base 的 253 个模块合计约 8 TFLOP。
# 本线一次更新的训练计算是 64 行 x 约 120 token x 6 x 4.02e9 ≈ 0.19 PFLOP，所以正则
# 占**几个百分点**（96 号那边序列长 4 倍、只占约 0.13%）。仍然可忽略，而且
# reg_once_per_update=1 下一次更新只算一遍，不是每个 micro-batch 各算一遍。
# 各臂的墙钟时间应当基本相同；实测差很多先怀疑显存压力导致的分配器抖动。
#
# -----------------------------------------------------------------------------
# 【λ 怎么定：本线有一个真正对口的历史起点】
#
# 44 号那个 7.5e-3 是**新任务 = Commonsense @ 512** 时定的 —— 和本线的新任务逐字相同
# （同一个数据、同一个 max_len、同一个 all-linear full scope）。约束强度要和 task_loss
# 比才有意义，而 task_loss 的绝对尺度由新任务决定，所以这次历史值是**同尺度**的，不像
# 96 号（Numina@2048）那样只能当量级参考。
#
# 差别只剩三件：44 号的 C 采在 Base 上（本线采在 Stage 1 的模型上），模型从 1.7B 换成
# 4B，trace(C) 因此不同。所以 7.5e-3 是个好起点，但**仍要跑一次 MODE=lambda_probe
# 确认**，判据还是那个：λ·R 落在 task_loss 的 1%~10%。
#
# 三步走，都在本脚本里：
#
#   1) MODE=lambda_probe  短跑几档 λ，打印 λ·R 与 task_loss 的比值。
#      metrics jsonl 里的字段名是 train_lambda_reg（= λ·R）和 train_task_loss。
#
#   2) 各档跑完整训练，看 val_loss（新任务的可塑性）和旧能力分数（保留多少）。
#
#   3) **matched plasticity**：报结果时各臂应当在同一个新任务 val_loss 上比，
#      否则「onereplay 保住了旧能力」可能只是因为它少学了新任务。仓库里有现成工具，
#      它把 val_loss(λ) = floor + a·λ^b 拟合出来再反解：
#
#        python -m onereplay.scripts.calibrate_lambda \
#          --results_root ${RESULTS_ROOT} \
#          --pattern 's3_cs_onereplay_lr*_lam*_seed1' \
#          --floor_run s3_cs_vanilla_lr<LR>_seed1 \
#          --target <vanilla 的 val_loss>
#
#      floor 必须是同配置的 vanilla run —— λ→0 收敛到的就是它，没有 floor 这个拟合
#      没有锚点、会系统性过冲（calibrate_lambda 的 docstring 里写了这件事）。
#
# λ 写进 run 名，所以换 λ 不会覆盖已有 checkpoint。
#
# -----------------------------------------------------------------------------
# 【读结果的纪律】
#
# 1) **SOURCE=if 时报任何 IF 分数必须同时报响应词数中位数。** 这是 Part 1 第 8c 节的
#    口径，在本线尤其要紧：新任务会把输出压到 7-8 token，而 IFEval/FollowBench 里
#    不少约束本质在量长度。一个塌成 7 个 token 的模型在长度类约束上会**系统性**失分，
#    这是遗忘的表现之一，但要和「能力还在只是变短了」分开说。
#    本脚本的汇总表默认每个生成式分数右边紧跟它自己的 words 中位数。
#
# 2) **SOURCE=math 时数学分数必须配着 hit-cap 读。** 删失是长度相关的：任何让输出
#    变短的干预都会让更多行在预算内收尾、数学分因此上升，会被误读成「该方法保住了
#    数学能力」。而本线的新任务恰好就是在把输出压短。评测末尾的 length diagnostic
#    就是为这件事准备的。
#
# 3) **不评 IFBench**（与 96/100/102 号一致）：Part 1 第 8c 节结论是 IFBench 三个家族
#    测长篇散文的涌现统计量、对输出长度极度敏感，而本线恰好是长度剧烈变化的一条线，
#    那 161 条对遗忘研究是纯噪声源。
#
# 4) **FollowBench 只有 rule 那一半**（350/820 行、70/164 组，style 类覆盖为 0）。
#    不要写成「FollowBench = xx%」。judge 那 470 行落到 judge_inputs.jsonl，要在有网
#    的地方过 judge_followbench.py。详见 92 号文件头的三条纪律。
#
# 5) 新任务侧（commonsense_qa）看两路：acc_logprob 是闭集排序（不解码，不受长度影响），
#    acc_gen + parse_rate 是「学没学会那个输出模板」。**anchor 那一行的 parse_rate
#    接近 0 是预期的**：Stage 1 的模型从没见过 "the correct answer is" 这个模板，
#    它的 acc_gen 低不代表它不会常识，看 acc_logprob。
#
# -----------------------------------------------------------------------------
# 【前置】计算节点无外网
#   1) Stage 1 checkpoint          SOURCE=if -> 94 号 / SOURCE=math -> 91 号的 MODE=train 产物
#                                  （不传 SRC_LR 时自动 glob）
#   2) C_X (+ F_X for ewc)         SOURCE=if -> 95 号 / SOURCE=math -> 99 号的产物
#                                  **已有，本线不需要重采**
#   3) Commonsense170k 数据池       93 号 MODE=data 的产物
#                                  results_part1_cs_${MODEL_NAME}/datasets/commonsense_100k
#   4) 常识评测集                   ${REPO_ROOT}/datasets/commonsense_eval/<task>/test.json
#                                  （LLM-Adapters 的 dataset/ 目录，八个子集约 10MB，
#                                   93 号文件头有 git clone + cp 那两行）
#   5) SOURCE=if 的旧能力：IFEval 输入随仓库自带；FollowBench 完全 vendored
#      SOURCE=math 的旧能力：${REPO_ROOT}/datasets/math/{gsm8k,math500}_test.jsonl
#   6) mkdir -p ${REPO_ROOT}/logs
#
# 【用法】ARM 一次只跑一条。训练是 100k 行 @512（1547 次更新，3-5h），新任务评测
#         便宜（八个集 1-1.5h），旧能力评测贵（IF 两个数据集 3-4h；math 侧约 1h）。
#         所以拆法：**训练 + 新任务评测放一个作业，旧能力评测另开**。
#
#   # 0) 只打印计划和前置检查，不碰 GPU（**先跑这个**）
#   qsub -v DRY_RUN=1 onereplay/pbs/103_s3_train_cs.pbs
#   qsub -v DRY_RUN=1,SOURCE=math onereplay/pbs/103_s3_train_cs.pbs
#
#   # 1) 冒烟：vanilla + 一条 protected 臂各 70 步，看 peak memory 和
#   #    「covers N layers」那行。**这一步定 BATCH，必须在任何正式臂之前做完。**
#   #
#   #    要用 ARM=ewc：三臂里它最吃显存（只有 autograd 路径，所有覆盖层的 fp32
#   #    DeltaW 活到 backward 返回），拿 vanilla 或 onereplay 探出来的余量是假的。
#   #    这里的 λ 只是个标量乘数、不影响显存，所以还没标定 λ 也可以先探，随便给一个。
#   qsub -v MODE=smoke,ARM=ewc,LAMBDA=1e7 onereplay/pbs/103_s3_train_cs.pbs
#   # 默认 BATCH=8 是按 4B 架构估的保守值（见下面 BATCH 那一段的表）。想提到 16 就先
#   # 实测这一档，过了再三臂一起用；不过按估算它只剩约 9 GiB 余量，别抱期望。
#   qsub -v MODE=smoke,ARM=ewc,LAMBDA=1e7,BATCH=16 onereplay/pbs/103_s3_train_cs.pbs
#
#   # 2) 选 λ（短跑几档，只看 λ·R / task_loss 的比值）
#   #    ！两条臂的 λ 要各标一次，靠 PROBE_ARM 区分，grid 不通用（见下面 PROBE_ARM 一节）
#   #    起点建议 7.5e-3：44 号是在同一个新任务(Commonsense@512)上定的，同尺度
#   qsub -v MODE=lambda_probe onereplay/pbs/103_s3_train_cs.pbs
#   # 已经单独交了完整 vanilla 的话，probe 里那档 λ=0 可以省掉
#   qsub -v MODE=lambda_probe,PROBE_VANILLA=0 onereplay/pbs/103_s3_train_cs.pbs
#   # 只验一个 λ（最快，约 20 次更新）
#   qsub -v MODE=lambda_probe,PROBE_VANILLA=0,LAMBDA_GRID=7.5e-3 \
#     onereplay/pbs/103_s3_train_cs.pbs
#
#   # 2b) 标定 EWC 的 λ。不传 LAMBDA_GRID 时会读 F 文件，围绕 1/mean(F) 现算三档
#   #     （x0.1 / x1 / x10），所以第一次扫不需要你先知道 F 的量级。
#   qsub -v MODE=lambda_probe,PROBE_ARM=ewc,PROBE_VANILLA=0 \
#     onereplay/pbs/103_s3_train_cs.pbs
#   # 看完表后只验一档（比值要落在 task_loss 的 1%~10%）
#   qsub -v MODE=lambda_probe,PROBE_ARM=ewc,PROBE_VANILLA=0,LAMBDA_GRID=1.2e7 \
#     onereplay/pbs/103_s3_train_cs.pbs
#
#   # 3) vanilla 臂（必须跑，是遗忘的标尺）。训练+新任务评测同作业，旧能力评测另开。
#   qsub -v MODE=train,ARM=vanilla,DO_OLD=0 onereplay/pbs/103_s3_train_cs.pbs
#   qsub -v MODE=eval,ARM=vanilla,DO_CS=0 onereplay/pbs/103_s3_train_cs.pbs
#
#   # 4) onereplay 臂（λ 用第 2 步选出来的）
#   qsub -v MODE=train,ARM=onereplay,LAMBDA=7.5e-3,DO_OLD=0 onereplay/pbs/103_s3_train_cs.pbs
#   qsub -v MODE=eval,ARM=onereplay,LAMBDA=7.5e-3,DO_CS=0 onereplay/pbs/103_s3_train_cs.pbs
#
#   # 4b) ewc 臂（λ 用第 2b 步选出来的；ARM=ewc 不接受默认 λ，不传会直接退出）
#   qsub -v MODE=train,ARM=ewc,LAMBDA=1.2e7,DO_OLD=0 onereplay/pbs/103_s3_train_cs.pbs
#   qsub -v MODE=eval,ARM=ewc,LAMBDA=1.2e7,DO_CS=0 onereplay/pbs/103_s3_train_cs.pbs
#
#   # 5) Stage 3 的起点也要评一遍，它是所有对照的「before」那一行
#   qsub -v MODE=eval,ARM=anchor onereplay/pbs/103_s3_train_cs.pbs
#
#   # 换来源：上面每一条都加 SOURCE=math 就是「从 Model-Math 出发」那一组
#   qsub -v MODE=train,ARM=vanilla,SOURCE=math,DO_OLD=0 onereplay/pbs/103_s3_train_cs.pbs
#
#   # SOURCE=if 默认按 conifer 那条 IF 池找基座。如果 IF 线是按 94 号的**脚本默认值**
#   # （IF_SOURCE=flan）训的，加这一个变量，W0 路径和 run 前缀会一起切过去
#   qsub -v DRY_RUN=1,IF_SOURCE_TAG=flanv2 onereplay/pbs/103_s3_train_cs.pbs
#
#   # 便宜地把链路跑通
#   qsub -v MODE=train,ARM=onereplay,MAX_TRAIN_SAMPLES=4000,EPOCHS=1,DO_EVAL=0 \
#     onereplay/pbs/103_s3_train_cs.pbs
#
# 查看/管理: qstat -ans1 / qstat -f <job_id> / qdel <job_id>
# =============================================================================

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/Onereplay}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/onereplay/pbs/103_s3_train_cs.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
if [[ -d "/local_ssd/${SCRATCH_USER}" ]]; then
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_p5cs_${JOBTAG}}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_p5cs_${JOBTAG}}"
  EXTRA_BIND=""
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${ONEREPLAY_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_p5cs_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR
    MODEL_DIR MODEL_NAME SRC_LINE_ROOT SRC_CKPT_DIR SRC_LR SRC_RUN SRC_CKPT
    # SOURCE 一转发，容器内的 case 会重新派生出其余来源相关的值，所以只有可被用户
    # 覆盖的那几个（带 :- 的）需要跟着转发。
    SOURCE IF_SOURCE_TAG SRC_RUN_PREFIX COV_BASENAME FISHER_BASENAME SRC_POOL_FILE
    REPLAY_PER_BATCH REPLAY_INPUT_COLUMN REPLAY_TARGET_COLUMN
    REPLAY_POOL_SIZE REPLAY_SAMPLE_SEED
    CS_LINE_ROOT CS_DATASET RESULTS_ROOT DATASET_CACHE METRICS_DIR CKPT_DIR
    CF_ROOT COV_PATH COV_SCOPE FISHER_PATH
    MODE ARM DRY_RUN DO_TRAIN DO_EVAL DO_CS DO_OLD SEED FORCE_TRAIN FORCE_EVAL
    ALLOW_CONFIG_DRIFT
    EPOCHS LR BATCH ACCUM MAXLEN VAL_FRAC MAXVAL TARGET_MODULES
    LR_SCHEDULER WARMUP_RATIO STOP_ON_IM_END
    SYSTEM_PROMPT SYSTEM_PROMPT_PRESET OLD_SYSTEM_PROMPT
    LAMBDA LAMBDA_GRID REG_IMPL REG_ONCE REG_ALLOW_TF32 NORMALIZE_BY_LAYERS
    LAMBDA_GRID_ONEREPLAY EWC_GRID_MULTIPLIERS
    PROBE_MAX_STEPS SMOKE_STEPS MAX_TRAIN_SAMPLES LOG_EVERY PROBE_LOG_EVERY
    PROBE_VANILLA PROBE_ARM
    CS_EVAL_DIR CS_EVAL_TASKS CS_SCORING CS_MAX_NEW_TOKENS CS_BATCH CS_SCORE_BATCH
    DIAG_LEN
    GSM8K_DATA MATH500_DATA MATH_MAX_NEW_TOKENS MATH_BATCH
    IFEVAL_INPUT MAX_NEW_TOKENS EVAL_BATCH
    FB_DATA FB_CATEGORIES FB_MAX_NEW_TOKENS FB_BATCH FB_GROUP_LIMIT
    EVAL_LIMIT
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_ONEREPLAY_IN_CONTAINER=1
  export APPTAINERENV_ONEREPLAY_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e --nv -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Singularity args: ${SINGULARITY_FLAGS}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里。
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-true}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo "Python          : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv

cd "${REPO_ROOT}"

# ---- 原始 Base：evaluate.py 在 --adapter_path 为空时会加载它，本线只有它当占位 ----
# 这两个要定义在下面的结果树和 C/F 路径**之前** —— 它们都把 MODEL_NAME 拼进路径，
# 而 set -u 下引用还没定义的变量是 unbound variable，脚本会当场退出（而 bash -n
# 查不出来，因为那是运行期展开）。
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/models}"
# 全线模型，理由见 91 号同处。必须和 S1/S2 用的是同一个：W0 是 S1 的 checkpoint、
# C/F 是在那个 checkpoint 上采的，模型对不上这条线整个没有意义。
MODEL_NAME="${MODEL_NAME:-Qwen3-4B-Base}"

# ---- 旧能力来源：这条线唯一可换的东西 ----
#
# 新任务固定是 Commonsense170k，可换的是"从哪个 Stage 1 模型出发"。换来源要同时换
# 三样，少换一样都不会报错，只会静默产出一个没有意义的结果：
#   W0         基座 checkpoint，罚项的锚点
#   C / F      **在那个 checkpoint 上**采的二阶统计量
#   旧能力评测  "保留了多少"说的是哪个能力
# 所以三者由同一个 SOURCE 派生，不各自传参。
#
#   SOURCE=if    从 94 号的 Model-IF 出发，量常识训练吃掉多少指令跟随
#   SOURCE=math  从 91 号的 Model-Math 出发，量常识训练吃掉多少数学
#
# 结果树也带 SOURCE：两个来源的 anchor、vanilla、各臂会重名，共用一棵树会让
# evaluate 把两组分数追加进同一个 <metric>_summary.csv，而它们不可比。
SOURCE="${SOURCE:-if}"
case "${SOURCE}" in
  if|math) : ;;
  *) echo "SOURCE=${SOURCE} 无效，可选 if / math" >&2; exit 2 ;;
esac
ANCHOR_RUN="${SOURCE}_anchor"

# 每个来源的三样东西一起派生。SRC_RUN_PREFIX 是 Stage 1 那条线的 run 名前缀，用来
# 在 checkpoints/ 下 glob 出基座；它必须和 S1 脚本里的 RUN= 逐字对应，否则会找不到。
#   94 号 645 行  RUN="part1_if_${IF_SOURCE_TAG}_lr${LR}_seed${SEED}"
#   91 号 776 行  RUN="part1_math_lr${LR}_seed${SEED}"
# C/F 的文件名沿用 95 / 99 号硬编码的那个（95 号 401-402 行、99 号 425/432 行），
# scope 默认 full 两边也一致。**95 号的文件名里写死了 flanv2 字样，即使实际训的是
# conifer 也还叫那个名** —— 名字误导，但路径对得上，别去"修"它，改了已采好的 C/F
# 就找不到了。
#
# 【SOURCE=if 与 94/95 号当前默认值不一致，投作业前必须确认这一条】
# 94 号 396 行的默认是 IF_SOURCE=flan（→ tag=flanv2、树 results_part1_flanv2_*、
# run 前缀 part1_if_flanv2），95 号 338/440 行也把 flanv2 树和 glob 写死了。这里默认
# 按 conifer 派生（96 号同样），因为实际那轮 IF 线是用 -v IF_SOURCE=conifer 跑的、
# 采 C/F 时也给 95 号传了 IF_LINE_ROOT/IF_RUN override。两种情况下 C/F 的文件名都是
# flanv2 字样，所以文件名分不出基座是哪个池 —— 唯一的判据是 W0 的路径。
# 如果 IF 线其实是按 94 号默认值（flan）训的，传 IF_SOURCE_TAG=flanv2 即可，W0 和
# run 前缀会一起切过去。两者配错的后果不是报错而是"W0 来自 conifer 而 C/F 采自
# flanv2"这种静默无意义，靠 Step 0 的 C metadata 对表兜底（不一致直接退出）。
case "${SOURCE}" in
  if)
    # 94 号把 IF 池分成三条 source，tag 直接进结果树和 run 名（flan→flanv2 /
    # conifer / mix→ifmix）。留成一个旋钮，换池只改这一个值、两条路径一起跟着走。
    IF_SOURCE_TAG="${IF_SOURCE_TAG:-ifmix}"
    SRC_LINE_ROOT="${SRC_LINE_ROOT:-${REPO_ROOT}/results_part1_${IF_SOURCE_TAG}_${MODEL_NAME}}"
    SRC_RUN_PREFIX="${SRC_RUN_PREFIX:-part1_if_${IF_SOURCE_TAG}}"
    CF_ROOT="${CF_ROOT:-${REPO_ROOT}/results_stage2_if_${MODEL_NAME}}"
    # C/F 文件名跟着 tag 走，与 95 号同一套命名。以前三条 source 采出来的都叫
    # cov_if_flanv2_20k，文件名分不出基座是哪个池 —— W0 从这里取、C/F 也从这里取，
    # 两者错配不会报错，只会静默算出无意义的罚项。
    COV_BASENAME="${COV_BASENAME:-cov_if_${IF_SOURCE_TAG}_20k}"
    FISHER_BASENAME="${FISHER_BASENAME:-fisher_if_${IF_SOURCE_TAG}_20k}"
    # ARM=replay 读的 20k 池：**必须是 C/F 采集时读的同一个文件**（95 号 MODE=pool）。
    case "${IF_SOURCE_TAG}" in
      flanv2)  SRC_POOL_BASE="flan_v2_if_100k" ;;
      conifer) SRC_POOL_BASE="conifer_if_full" ;;
      ifmix)   SRC_POOL_BASE="if_mix" ;;
      *) echo "未知 IF_SOURCE_TAG=${IF_SOURCE_TAG}，可选 flanv2/conifer/ifmix"; exit 2 ;;
    esac
    SRC_POOL_FILE="${SRC_POOL_FILE:-${SRC_LINE_ROOT}/datasets/${SRC_POOL_BASE}_replay.jsonl}"
    # 旧能力：**不评 ifbench**，与 94/96 号一致，理由见文件头第 3 条纪律
    OLD_METRICS_ALL="ifeval,followbench"
    OLD_LABEL="IF"
    ;;
  math)
    SRC_LINE_ROOT="${SRC_LINE_ROOT:-${REPO_ROOT}/results_part1_numina_${MODEL_NAME}}"
    SRC_RUN_PREFIX="${SRC_RUN_PREFIX:-part1_math}"
    CF_ROOT="${CF_ROOT:-${REPO_ROOT}/results_stage2_math_${MODEL_NAME}}"
    COV_BASENAME="${COV_BASENAME:-cov_math_numina_20k}"
    FISHER_BASENAME="${FISHER_BASENAME:-fisher_math_numina_20k}"
    # ARM=replay 读的 20k 池：**必须是 C/F 采集时读的同一个文件**（99 号 MODE=pool 的
    # 产物）。它落在 REPO_ROOT/datasets 下而不是结果树里，因为 math 训练池是共享的。
    SRC_POOL_FILE="${SRC_POOL_FILE:-${REPO_ROOT}/datasets/numina_math_100k_replay.jsonl}"
    OLD_METRICS_ALL="gsm8k,math500"
    OLD_LABEL="Math"
    ;;
esac
SRC_CKPT_DIR="${SRC_CKPT_DIR:-${SRC_LINE_ROOT}/checkpoints}"

# ---- 新任务数据池：Commonsense170k 采样 100k，93 号 MODE=data 的产物，只读不重建 ----
# 它在 93 号的结果树下（那边 CS_DATASET="${RESULTS_ROOT}/datasets/commonsense_100k"，
# RESULTS_ROOT 带 MODEL_NAME），所以这里也要带 MODEL_NAME —— 93 号换模型时旧树还在，
# 不带就会静默读到另一个模型那轮的池子。
# **本线不重建池**：换一遍就等于换了数据，Part 1 的 Model-CS 分数不再可比，而
# prepare_commonsense 的 balanced 采样只在 CS_SOURCE/DROP_UNPARSABLE/SEED 全同时
# 才复现同一批行。
CS_LINE_ROOT="${CS_LINE_ROOT:-${REPO_ROOT}/results_part1_cs_${MODEL_NAME}}"
CS_DATASET="${CS_DATASET:-${CS_LINE_ROOT}/datasets/commonsense_100k}"

# ---- Stage 3 自己的结果树 ----
# 按 SOURCE 和 MODEL_NAME 分根：evaluate 会把分数追加进 ${RESULTS_ROOT}/<metric>_summary.csv，
# 共用一棵树会把不同来源/不同模型的结果混进同一个文件，而它们不可比。
RESULTS_ROOT="${RESULTS_ROOT:-${REPO_ROOT}/results_stage3_${SOURCE}2cs_${MODEL_NAME}}"
DATASET_CACHE="${DATASET_CACHE:-${RESULTS_ROOT}/dataset_cache}"
export HF_DATASETS_CACHE="${DATASET_CACHE}"
METRICS_DIR="${METRICS_DIR:-${RESULTS_ROOT}/metrics}"
CKPT_DIR="${CKPT_DIR:-${RESULTS_ROOT}/checkpoints}"

# ---- C / F：95（IF）或 99（math）号的产物，采集树与结果树分开 ----
#
# **CF_ROOT 带 MODEL_NAME 是关键**：C/F 是在某个具体 checkpoint 上采的二阶统计量，
# 读错模型的 C/F 不会报错、训练照样跑、罚项照样算出一个数，只是保护方向完全无意义。
# 采集脚本那边也带 MODEL_NAME，所以两边一起换模型就自动对上。CF_ROOT 和两个 BASENAME
# 都在上面按 SOURCE 派生了，这里只拼 scope。
#
# scope 对 C 和 F 是同一个变量：两者必须覆盖同一批层，否则 onereplay 和 ewc 两条臂
# 保护的参数集不同，比出来的不是正则方式的差别。
COV_SCOPE="${COV_SCOPE:-full}"
COV_PATH="${COV_PATH:-${CF_ROOT}/cov/${COV_BASENAME}_${COV_SCOPE}.pt}"
FISHER_PATH="${FISHER_PATH:-${CF_ROOT}/fisher/${FISHER_BASENAME}_${COV_SCOPE}.pt}"

# ---- 模式与臂 ----
MODE="${MODE:-train}"
# vanilla   无保护，遗忘的标尺（必须跑）
# onereplay C_X 保护
# ewc       F_X 保护（onereplay 的正则对照臂）
# anchor    不训练，只评 Stage 3 的起点（所有对照的 before 那一行）
ARM="${ARM:-onereplay}"
DRY_RUN="${DRY_RUN:-0}"
DO_TRAIN="${DO_TRAIN:-1}"
DO_EVAL="${DO_EVAL:-1}"
# 评测拆两半，靠这两个开关拆到不同作业：
#   DO_CS   新任务（commonsense_qa 八个测试集，1-1.5h）
#   DO_OLD  旧能力保留（SOURCE=if 是 IFEval+FollowBench 3-4h，本线的主指标；
#           SOURCE=math 是 GSM8K+MATH-500 约 1h）
# 一个 24h 作业装不下 训练 + 两半评测，所以默认都开但推荐「训练 + DO_CS」一个作业、
# DO_OLD 另开。
DO_CS="${DO_CS:-1}"
DO_OLD="${DO_OLD:-1}"
SEED="${SEED:-1}"
# 1 = 允许本次的 batch/accum/lr 和同一棵结果树下已训完的臂不一致（只警告不拦）。
# 默认 0，理由见 MODE=train 那处的配置闸门。
ALLOW_CONFIG_DRIFT="${ALLOW_CONFIG_DRIFT:-0}"
FORCE_TRAIN="${FORCE_TRAIN:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"

# ---- 训练超参：与 93 号逐字对齐（BATCH 除外，见下），改任何一个都会让 Part 1 的
#      对照失效 ----
#
# 【BATCH 由最吃显存的那条臂决定，这一条不能按臂调】
#
# 三臂要做的是性能开销对照，所以 batch / accum / maxlen / epochs 必须逐字相同。
# 一旦让 vanilla 用 16、protected 臂因为 OOM 退到 8，那个 16 的 vanilla 就作废了，
# 得重跑。所以默认值取的是**三臂里最紧的那一条能过的值**，不是 vanilla 能过的值。
#
# 最紧的是 ewc，不是 onereplay —— 这一点反直觉，按 C(20.8 GiB) 比 F(16.1 GiB) 大去
# 推会推错。原因是 **EWC 只有 autograd 路径**（见下面 REG_IMPL 那处）：
#   onereplay  full_covariance_grad_ 带 @torch.no_grad()，逐层算完 del，峰值 = 一层
#   ewc        full_fisher_regularizer 每层 weight.float() 进计算图，所有覆盖层的
#              fp32 DeltaW 活到 backward 返回。1.7B 上 197 层实测 4.35 GiB，4B 的
#              253 层按参数量折算约 10.3 GiB
#
# 【本线的 MAXLEN=512 让激活那一项小 4 倍，这是和另两条 Stage 3 线唯一的实质差别】
#
# 常驻部分与序列长度无关，Qwen3-4B-Base 上是（静态 = 权重+梯度+Adam，全 bf16）：
#     静态 32.2 + W0 快照 bf16 8.0 + F fp32 16.1 + EWC 正则临时量 10.3 = 66.6 GiB
# 激活+logits 与 BATCH x MAXLEN 成正比，参考点是 96 号那张表的一格：MAXLEN=2048 下
# BATCH=2 约 32.3 GiB，也就是约 8.1 GiB / (1024 token x batch)。本线 MAXLEN=512，
# 所以同一个 BATCH 下激活只有 96 号的 1/4：每 BATCH 约 4.0 GiB。
#
#                         vanilla    ewc    onereplay
#   静态                     32.2   32.2       32.2
#   W0 快照 bf16                -    8.0        8.0
#   F fp32 / C fp32             -   16.1       20.8
#   正则临时量                   -   10.3       ~0.2
#   激活+logits @ BATCH=8    32.3   32.3       32.3
#   峰值                    ~64.5  ~98.9      ~93.5
#   峰值 @ BATCH=16         ~96.8 ~131.2     ~125.8   <- ewc 只剩约 9 GiB 余量
#
# 所以默认 8，而不是 93 号的 16。BATCH=16 那一档的 ewc 峰值和 96 号 BATCH=4 那一档
# （131.1 GiB）一样只剩约 9 GiB 余量，而 96 号已经因为这个余量拒绝过它。
#
# **和 93 号的可比性不受影响**：ACCUM=64 不动，一次更新仍然是 64 行，只是
# accumulation_steps 从 4 变 8，梯度在数学上等价（94 号把 BATCH 从 8 降到 4 时用的
# 是同一个论证）。顺便对一下账：vanilla 那一列 BATCH=16 是 96.8 GiB，正是 93 号文件头
# 记的"三条线峰值都在约 97 GB" —— S1 只有 vanilla 一条臂，所以它能用 16。
#
# **上面整张表是估算**（激活系数是从 1.5B 那轮实测的 100 GiB 反推的，误差 ±15%），
# 要动 BATCH 必须先实测，别直接排 24h 作业：
#
#     qsub -v MODE=smoke,ARM=ewc,BATCH=16,LAMBDA=<随便一个> onereplay/pbs/103_....pbs
#
# smoke 会跑 vanilla + ewc 两臂并把两边所有 peak*memory* 字段并排打出来。**必须用
# ARM=ewc**：拿 vanilla 探等于没探，那 96.8 GiB 永远过。过了就三臂一起用新值。
BATCH="${BATCH:-8}"
ACCUM="${ACCUM:-64}"

# ---- ARM=replay 的混合参数 ----
# 0.5/0.5 严格 batch 级混合：每个 micro-batch 一半新任务、一半旧知识。
# **--replay_per_batch 是绝对行数不是比例**，train.py 内部 new_per_batch = BATCH - 它，
# 所以对半分就是 BATCH/2，micro-batch 总行数仍是 BATCH —— 激活显存和 vanilla 同量，
# 又没有 C/F 常驻，所以 replay 是四条臂里最省显存的那条，不会成为 BATCH 的瓶颈。
REPLAY_PER_BATCH="${REPLAY_PER_BATCH:-$(( BATCH / 2 ))}"
# 20k 池的两列。95/99/101 号 MODE=pool 落的 jsonl 统一是 {inputs, targets, ...}，
# 也正是 collect_cov / collect_fisher 的 --input_column/--target_column 默认值。
REPLAY_INPUT_COLUMN="${REPLAY_INPUT_COLUMN:-inputs}"
REPLAY_TARGET_COLUMN="${REPLAY_TARGET_COLUMN:-targets}"
# 取满 20k。与 C/F 的口径一致：三条臂吃的是同一批行。
REPLAY_POOL_SIZE="${REPLAY_POOL_SIZE:-20000}"
REPLAY_SAMPLE_SEED="${REPLAY_SAMPLE_SEED:-1}"
# replay 臂的 micro-batch 只有一半是新任务，所以传给 train.py 的 --accumulation_size
# 要翻倍才凑得够同样的 ACCUM 行新数据。这样每次更新的新任务量和 vanilla 逐字相同，
# 总更新次数也相同（loader 的 epoch 由新任务数据定义，旧知识池是循环复用的）。
# 代价是每次更新过两倍的行，**墙钟时间约为 vanilla 的两倍**，排 walltime 要算进去。
# train.py 会打一行
#     `accumulation: N steps x M new-task rows = <ACCUM> new-task rows per update`
# 四条臂这一行末尾的数字必须相同，不同就说明这里的换算和实际不一致，停下来查。
if [[ "${ARM}" == "replay" ]]; then
  if (( BATCH % 2 != 0 )); then
    echo "ARM=replay 要求 BATCH 是偶数（对半分），当前 BATCH=${BATCH}"
    exit 1
  fi
  ACCUM_TRAIN=$(( ACCUM * 2 ))
else
  ACCUM_TRAIN="${ACCUM}"
fi
# 512：与 93 号同值（那边 MODE=data 的长度报告定的）。截断是保尾丢头，本数据的尾巴
# 是答案加 "Answer format: a/b/c" 那一行，所以截断的行不会丢答案也不会丢候选集。
# 改它要连 93 号一起改，否则新任务 val_loss 与 Part 1 的 Model-CS 不可比。
MAXLEN="${MAXLEN:-512}"
# 1 epoch，与 93 号当前默认一致，这样 Model-X-CS 和 Part 1 的 Model-CS 吃的是同样的
# 新任务预算，常识分可以并排读。100k 行 / 64 = 约 1547 次优化器更新。
EPOCHS="${EPOCHS:-1}"
# **各臂必须同 LR**，这是比较的前提。LR 写进 run 名，train 和 eval 要传同一个值。
# 5e-5 是三条 Stage 1 线统一的配方值（93 号同处），不是本线自己扫出来的。
LR="${LR:-5e-5}"
# cosine + warmup 0.1，与 91/93/94 号统一（分别在它们的 823 / 540 / 708 行）。这一项
# 之前**整个 Stage 3 都漏了**，而 train.py 在没有 --lr_scheduler 时是裸 Adam 恒定 LR：
# 三臂之间仍然自洽（都是恒定），但新任务的学习曲线和 Stage 1 那条线不是一个配方，
# "这批数据能教会这个能力"的结论就接不到这里。93 号的原话：warmup 不是可选项。
# 96 / 100 / 103 三条线已经一起补上，所以三条 Stage 3 线之间仍然可互比。
#
# 它同时也是 λ 的前提：λ·R 与 task_loss 的比值随 LR 曲线变，用恒定 LR 标出来的 λ
# 搬到 cosine 上未必还落在 1%~10% 区间。所以改这一项之后 lambda_probe 要重跑。
LR_SCHEDULER="${LR_SCHEDULER:-cosine}"
WARMUP_RATIO="${WARMUP_RATIO:-0.1}"
VAL_FRAC="${VAL_FRAC:-0.01}"
# 1000：与 93 号同值。本线监督 span 只有 7-8 个 token，val_loss 很不灵敏，样本给多点。
MAXVAL="${MAXVAL:-1000}"
# 全量微调下 --target_modules 不决定哪些参数训练（全都训），只在 LoRA 路径有用。
# 罚项的覆盖范围由 **C 文件的键** 决定，不由这个参数决定。保持与 93 号一致便于对照。
TARGET_MODULES="${TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj,lm_head}"
MAX_TRAIN_SAMPLES="${MAX_TRAIN_SAMPLES:-0}"

# ---- system 消息：**两侧不同，各自对齐 S1，不能共用一个** ----
# 这条线同时评新任务（常识）和旧能力，而这两侧在 S1 里是在不同的 system 下测出来的。
# 共用一个值会让其中一侧的分数和 S1 的基线不可比，而"持续训练后涨了多少 / 保留了多少"
# 全靠和那个基线比：
#   常识侧 = 93 号的值，一条中性助手消息。训练渲染也用它（新任务就是 Commonsense），
#            与 93 号逐字一致；commonsense_qa 的两路打分也用它。
#   旧能力 = 它在 S1 时的那个值：
#            SOURCE=if    94 号的中性助手消息，和 93 号**完全相同**
#            SOURCE=math  91 号的 \boxed{} 指令。拿中性消息去评 math500 会让分数虚低
#                         —— 那个指标的答案提取依赖 \boxed{}，不要求就不一定写。
# 代价是两侧分两次 evaluate 调用、模型加载两次（SOURCE=if 时两侧恰好同值，仍然保持
# 拆分结构：三条线代码形态一致，而且 metric 列表本来就要分组）。那点加载时间换的是
# 分数可比，值得。
SYSTEM_PROMPT="${SYSTEM_PROMPT:-You are a helpful assistant.}"
# math 那条指令的文本里有逗号，而 qsub -v 用逗号分隔变量，没法直接传 OLD_SYSTEM_PROMPT，
# 这就是要一个 preset 开关的原因。preset 逻辑与 91 / 96 / 99 号逐字相同：Qwen2.5-Math
# 留空（它的模板自己注入那条指令），其他模型补齐。这几个脚本必须一起改。
SYSTEM_PROMPT_PRESET="${SYSTEM_PROMPT_PRESET:-auto}"
if [[ -z "${OLD_SYSTEM_PROMPT:-}" ]]; then
  case "${SOURCE}" in
    if)
      # 94 号的值。改它要连 94 号一起改，否则旧能力保留分没有可比的 before。
      OLD_SYSTEM_PROMPT="You are a helpful assistant."
      ;;
    math)
      case "${SYSTEM_PROMPT_PRESET}" in
        none) ;;
        math) OLD_SYSTEM_PROMPT="Please reason step by step, and put your final answer within \\boxed{}." ;;
        auto)
          if [[ "${MODEL_NAME}" != *Math* ]]; then
            OLD_SYSTEM_PROMPT="Please reason step by step, and put your final answer within \\boxed{}."
          fi
          ;;
        *) echo "SYSTEM_PROMPT_PRESET 只能是 auto / math / none，得到 '${SYSTEM_PROMPT_PRESET}'" >&2; exit 2 ;;
      esac
      ;;
  esac
fi
OLD_SYSTEM_PROMPT="${OLD_SYSTEM_PROMPT:-}"
LOG_EVERY="${LOG_EVERY:-500}"

# ---- 正则 ----
# λ 是否由用户显式给出。ewc 臂没有可辩护的默认值（F 的量级由数据决定，见文件头），
# 所以要能区分"用了默认值"和"用户真的传了"，不能让 onereplay 的 7.5e-3 静默漏到 ewc。
LAMBDA_WAS_SET=0
[[ -n "${LAMBDA:-}" ]] && LAMBDA_WAS_SET=1
# 7.5e-3 来自 44 号，而 44 号的新任务就是 Commonsense@512 —— 和本线**同尺度**，
# 所以这个起点比 96 号那边的历史值可靠得多（见文件头「λ」一节）。
# 但仍然**不要当结论用**，先跑 MODE=lambda_probe 确认比值。
LAMBDA="${LAMBDA:-7.5e-3}"
# 空 = 按 PROBE_ARM 自动生成：onereplay 用下面这三档，ewc 由 1/mean(F) 现算。
LAMBDA_GRID="${LAMBDA_GRID:-}"
LAMBDA_GRID_ONEREPLAY="${LAMBDA_GRID_ONEREPLAY:-1e-3 7.5e-3 5e-2}"
# ewc 的 grid 围绕 1/mean(F) 取几档（十倍一档）。乘数写在这里，中心值现算。
EWC_GRID_MULTIPLIERS="${EWC_GRID_MULTIPLIERS:-0.1 1 10}"
# analytic 是本线的必需项，理由见文件头（autograd 会多留一份 16.1 GiB 的 fp32 W0）。
REG_IMPL="${REG_IMPL:-analytic}"
REG_ONCE="${REG_ONCE:-1}"
REG_ALLOW_TF32="${REG_ALLOW_TF32:-1}"
NORMALIZE_BY_LAYERS="${NORMALIZE_BY_LAYERS:-1}"
# λ probe：数的是 micro-batch，更新次数 = PROBE_MAX_STEPS / (ACCUM/BATCH) = /8。
# 160 步 = 20 次更新 = 1280 行。probe 只要看 λ·R 与 task_loss 的**量级比**，20 次更新
# 够了（R 在前几次更新里就从 0 长到稳定量级）；它不是 LR sweep，不需要比末值。
PROBE_MAX_STEPS="${PROBE_MAX_STEPS:-160}"
PROBE_LOG_EVERY="${PROBE_LOG_EVERY:-8}"
# probe 里那条 λ=0 的短跑。它**不是** calibrate_lambda 要的地板（那个必须是完整
# EPOCHS 的 vanilla run），只是让你在同样 20 次更新下看到「罚项把 task_loss 推高了
# 多少」。选 λ 靠的 λ·R/task_loss 比值只用到 protected 臂自己的两个数，所以已经
# 单独交了完整 vanilla 的话，这条可以关掉，省 1/4 的 probe 时间。
PROBE_VANILLA="${PROBE_VANILLA:-1}"
# MODE=lambda_probe 扫哪条臂。两条臂的 λ 各有自己的尺子（C 是激活二阶矩、F 是梯度
# 平方，量级差好几个数量级），所以要分两次 probe，不能共用一个 grid。
PROBE_ARM="${PROBE_ARM:-onereplay}"
SMOKE_STEPS="${SMOKE_STEPS:-70}"

# ---- 评测：常识侧（新任务）与 93 号同预算，旧能力侧与它自己的 S1 线同预算 ----
# 八个 LLM-Adapters 测试集，布局 <dir>/<task>/test.json。93 号文件头有 clone + cp 两行。
CS_EVAL_DIR="${CS_EVAL_DIR:-${REPO_ROOT}/datasets/commonsense_eval}"
# 空 = 跑全部八个（boolq piqa social_i_qa hellaswag winogrande ARC-Easy ARC-Challenge
# openbookqa，约 22.4k 行）。HellaSwag 一个集 10042 行、占约 45%，想先便宜地过链路就
# 显式列几个。**正式结果必须是八个全跑**：AVERAGE 是宏平均，少一个集就换了指标定义。
CS_EVAL_TASKS="${CS_EVAL_TASKS:-}"
# both = logprob + gen 两路都算，一次模型加载共用。本线两路各回答一个问题：
#   logprob  闭集排序，不受输出长度影响，新任务真正学到多少常识
#   gen      那个输出模板学没学会；它的 accuracy 只能和 parse_rate 一起读
CS_SCORING="${CS_SCORING:-both}"
# 答案只有 7-8 个 token，32 足够收尾（与 93 号同值）。**不要为了看长输出把它调大**：
# 各臂必须同值，改了就得所有臂一起重评。
CS_MAX_NEW_TOKENS="${CS_MAX_NEW_TOKENS:-32}"
CS_BATCH="${CS_BATCH:-32}"
# logprob 那一路的瓶颈和解码不同：它要 materialize 一个 [batch, seq, 151936] 的 logit
# 张量、且完全不复用 KV cache，所以单独一个更小的默认值（与 93 号同值）。
CS_SCORE_BATCH="${CS_SCORE_BATCH:-8}"
# 评测末尾打诊断表。**两侧都必须看它**：
#   常识侧（新任务）：parse_rate / logprob 与 gen 的一致率 / 预测众数占比 / hit-cap。
#     parse 低说明新格式**没学会**，不是旧格式忘了；anchor 那一行接近 0 是预期的。
#   SOURCE=math 的旧能力侧：响应长度与 hit-cap。删失是长度相关的，而本线的新任务
#     正在把输出压短 —— 不看 hit-cap 就会把「逃出截断」读成「保住了数学能力」。
#   SOURCE=if 的旧能力侧：响应词数中位数直接进汇总表，紧跟每个 IF 分数。
DIAG_LEN="${DIAG_LEN:-1}"
# ---- SOURCE=math 的旧能力评测集（91 号同处的值）----
GSM8K_DATA="${GSM8K_DATA:-${REPO_ROOT}/datasets/math/gsm8k_test.jsonl}"
MATH500_DATA="${MATH500_DATA:-${REPO_ROOT}/datasets/math/math500_test.jsonl}"
# 2048 / 128：与 91 和 96 号同值。Numina 训练答案 P50=351 / P90=778 / max=2666，正常
# 收尾的响应离 2048 还有距离；batch 给大值是因为 generate 整批等最慢那行、墙钟正比于
# **批数**，而 decode 是权重带宽瓶颈。完整算术见 91 号同名变量。
MATH_MAX_NEW_TOKENS="${MATH_MAX_NEW_TOKENS:-2048}"
MATH_BATCH="${MATH_BATCH:-128}"
# ---- SOURCE=if 的旧能力评测集（94 号同处的值）----
IFEVAL_INPUT="${IFEVAL_INPUT:-${REPO_ROOT}/onereplay/third_party/instruction_following_eval/data/input_data.jsonl}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-1024}"
EVAL_BATCH="${EVAL_BATCH:-32}"
FB_DATA="${FB_DATA:-}"
FB_CATEGORIES="${FB_CATEGORIES:-}"
# 1024 而不是 2048：这是 94 号的值，而 anchor 那一行的 FollowBench 分数应当与 94 号
# 逐字相同（同 checkpoint、同 greedy 解码、同 batch），生成预算不同就对不上了。
# 96 号原来是 2048，已经一并改成 1024，所以三条 Stage 3 线的 IF 旧能力分现在可互比。
# 那个 2048 曾被记成"窗口所限"，但 Qwen3 的 max_position_embeddings 是 32768（本地
# Qwen3-1.7B-Base 的 config 实测）—— 91/93/94 里"上下文硬上限 4096"讲的是
# Qwen2.5-Math-1.5B，换模型后已不适用。取 1024 的真实理由只是与 94 号对齐。
FB_MAX_NEW_TOKENS="${FB_MAX_NEW_TOKENS:-1024}"
# 不回落到 EVAL_BATCH：example 类的 prompt P90=2516 / max=5019 token，KV 不是一个量级。
FB_BATCH="${FB_BATCH:-16}"
# FollowBench 不读全局 --limit（metric 只认 group_limit），截它只能用这个，而且按**组**。
FB_GROUP_LIMIT="${FB_GROUP_LIMIT:-0}"
EVAL_LIMIT="${EVAL_LIMIT:-0}"

# ---- 解码停止条件：**这一项之前整个 Stage 3 都漏了** ----
# chat template 以 <|im_end|> 收尾，但 evaluate.py 的 --decode_stop_on_im_end 默认是
# 0，于是模型吐出 <|im_end|> 之后 generate 不停，继续写下一轮对话；skip_special_tokens
# 再把那段续写拼在答案后面。后果不只是"和 91/93/94 不可比"，而是判分本身错了：
# SOURCE=if 时 IFEval 的"不要用逗号"、"回答分三段"这类约束会被续写的内容违反；
# 本线的新任务 commonsense_qa 更脆，它的监督 span 只有 7-8 个 token，续写会直接
# 淹掉那个短答案。91/93/94 三条 S1 线都固定传 1，这里跟上。
#
# 93 号的原话：一个表里的所有 arm 必须同值。所以它不按臂区分，也不该改。
STOP_ON_IM_END="${STOP_ON_IM_END:-1}"

mkdir -p "${METRICS_DIR}" "${CKPT_DIR}" "${DATASET_CACHE}" "${RESULTS_ROOT}/map_cache"

# ===========================================================================
# Step 0: 前置检查
# ===========================================================================
echo "==== Step 0: 前置检查 ===="

# ---- 解析 Stage 1 checkpoint（与 95/99 号同一套逻辑，必须选到同一个模型）----
if [[ -z "${SRC_CKPT:-}" ]]; then
  if [[ -n "${SRC_LR:-}" ]]; then
    SRC_RUN="${SRC_RUN:-${SRC_RUN_PREFIX}_lr${SRC_LR}_seed${SEED}}"
    SRC_CKPT="${SRC_CKPT_DIR}/${SRC_RUN}"
  else
    mapfile -t _CANDS < <(
      find "${SRC_CKPT_DIR}" -maxdepth 1 -mindepth 1 -type d \
        -name "${SRC_RUN_PREFIX}_lr*_seed${SEED}" 2>/dev/null | sort
    )
    if (( ${#_CANDS[@]} == 0 )); then
      echo "在 ${SRC_CKPT_DIR} 下找不到 ${SRC_RUN_PREFIX}_lr*_seed${SEED}"
      echo "先跑 Stage 1（SOURCE=if -> 94 号 / SOURCE=math -> 91 号）MODE=train，"
      echo "或传 SRC_CKPT=/abs/path"
      exit 1
    fi
    if (( ${#_CANDS[@]} > 1 )); then
      echo "命中多个 Stage 1 checkpoint，必须显式选一个（它是基座也是 W0）:"
      for _c in "${_CANDS[@]}"; do echo "  ${_c}"; done
      echo "传 SRC_LR=<lr> 或 SRC_CKPT=<绝对路径>；**必须与采 C 时选的那个一致**"
      exit 1
    fi
    SRC_CKPT="${_CANDS[0]}"
    SRC_RUN="$(basename "${SRC_CKPT}")"
  fi
fi
SRC_RUN="${SRC_RUN:-$(basename "${SRC_CKPT}")}"
[[ -d "${SRC_CKPT}" ]] || { echo "缺 Stage 1 checkpoint（基座）: ${SRC_CKPT}"; exit 1; }
[[ -f "${SRC_CKPT}/config.json" ]] || { echo "${SRC_CKPT} 不是可加载的模型目录"; exit 1; }

# ---- run 名 ----
# λ 进名字，所以换 λ 不会覆盖；ARM 进名字，所以各臂不会互相覆盖。SOURCE 不进名字，
# 它已经分在 RESULTS_ROOT 上了（与 96 号同一个约定）。
case "${ARM}" in
  vanilla)   RUN="s3_cs_vanilla_lr${LR}_seed${SEED}" ;;
  onereplay) RUN="s3_cs_onereplay_lr${LR}_lam${LAMBDA}_seed${SEED}" ;;
  ewc)       RUN="s3_cs_ewc_lr${LR}_lam${LAMBDA}_seed${SEED}" ;;
  # replay 没有 λ，混合比例进名字：换比例不会覆盖上一次的结果。
  replay)    RUN="s3_cs_replay_lr${LR}_r${REPLAY_PER_BATCH}of${BATCH}_seed${SEED}" ;;
  anchor)    RUN="${ANCHOR_RUN}" ;;
  *) echo "未知 ARM=${ARM}，可选 vanilla / onereplay / ewc / replay / anchor"; exit 1 ;;
esac

# ewc 臂不接受默认 λ。onereplay 的 7.5e-3 在 F 的尺子上毫无意义（差好几个数量级），
# 静默套用会烧掉一个 24h 作业。MODE=lambda_probe,PROBE_ARM=ewc 会现算 grid。
if [[ "${ARM}" == "ewc" && "${MODE}" != "eval" && "${LAMBDA_WAS_SET}" != "1" ]]; then
  echo "!! ARM=ewc 必须显式传 LAMBDA。"
  echo "   onereplay 的默认值 7.5e-3 是 C 那把尺子上的数，F 是梯度平方，量级完全不同。"
  echo "   先跑: qsub -v MODE=lambda_probe,PROBE_ARM=ewc,PROBE_VANILLA=0 ${SELF_PATH}"
  echo "   它会读 ${FISHER_PATH} 的 mean(F)，围绕 1/mean(F) 现算 grid 并打印比值表。"
  exit 1
fi
CKPT="${CKPT_DIR}/${RUN}"

# ---- 数据池 ----
if [[ "${ARM}" != "anchor" && "${MODE}" != "eval" ]]; then
  [[ -d "${CS_DATASET}" ]] || {
    echo "缺 Commonsense170k 池: ${CS_DATASET}"
    echo "它是 93 号 MODE=data 的产物（--mode sampled --sample_strategy balanced"
    echo "--pool_size 100000）。本线不重建池：换池就换了数据，Part 1 的 Model-CS"
    echo "分数也不再可比。"
    exit 1
  }
fi

# ---- 这次到底要用哪个矩阵 ----
# ARM 只管正式训练；MODE=smoke 和 MODE=lambda_probe 各有自己的臂选择，所以三者分开
# 解析。缺文件要在加载模型之前就报出来，别等 GPU 排到了才失败。
case "${ARM}" in
  onereplay|ewc) SMOKE_ARM="${ARM}" ;;
  *)             SMOKE_ARM="onereplay" ;;
esac
NEEDS_COV=0
NEEDS_FISHER=0
if [[ "${MODE}" != "eval" ]]; then
  case "${MODE}" in
    lambda_probe) CHECK_ARM="${PROBE_ARM}" ;;
    smoke)        CHECK_ARM="${SMOKE_ARM}" ;;
    *)            CHECK_ARM="${ARM}" ;;
  esac
  if [[ "${CHECK_ARM}" == "onereplay" ]]; then NEEDS_COV=1; fi
  if [[ "${CHECK_ARM}" == "ewc" ]]; then NEEDS_FISHER=1; fi
fi

# replay 臂读的是 20k 池本身而不是 C/F，但读的必须是同一份文件，所以这里一起查。
if [[ "${ARM}" == "replay" && "${MODE}" != "eval" ]]; then
  [[ -f "${SRC_POOL_FILE}" ]] || {
    echo "缺 ${OLD_LABEL} 的 20k 旧知识池: ${SRC_POOL_FILE}"
    echo "它是 95 / 99 / 101 号 MODE=pool 的产物，和 C/F 读的是同一个文件。"
    exit 1
  }
  _POOL_ROWS="$(wc -l < "${SRC_POOL_FILE}")"
  if [[ "${_POOL_ROWS}" != "${REPLAY_POOL_SIZE}" ]]; then
    echo "20k 池行数 ${_POOL_ROWS} != REPLAY_POOL_SIZE=${REPLAY_POOL_SIZE}"
    echo "  C/F 是按全池采的；replay 只取前 ${REPLAY_POOL_SIZE} 行的话，三条臂"
    echo "  吃的就不是同一批行了。对齐它，或显式传 REPLAY_POOL_SIZE=${_POOL_ROWS}。"
    exit 1
  fi
fi

if (( NEEDS_COV )); then
  [[ -f "${COV_PATH}" ]] || {
    echo "缺 C_${SOURCE}: ${COV_PATH}"
    echo "它是 SOURCE=if -> 95 号 / SOURCE=math -> 99 号的产物，应当早就有了。"
    exit 1
  }
  # C 必须是在**本作业的基座**上采的。metadata 里的 model_name 是 collect_cov 的
  # --model_name，采集脚本传的就是 Stage 1 的 run 名，所以两边应当逐字相等。
  # 这条检查挡的是最贵的错误：拿 Base 上采的 C 配 Stage 1 的 W0。
  python - "${COV_PATH}" "${SRC_RUN}" "${MAXLEN}" <<'PY'
import sys

import torch

cov_path, want_model, new_task_max_len = sys.argv[1], sys.argv[2], int(sys.argv[3])
payload = torch.load(cov_path, map_location="cpu")
meta = payload.get("metadata", {})
covariances = payload["covariances"]

got_model = str(meta.get("model_name", ""))
cov_max_len = meta.get("max_len")
print("C 的 metadata:")
print(f"  model_name       = {got_model}")
print(f"  pool_rows        = {meta.get('pool_rows')}")
print(f"  pool_fingerprint = {meta.get('pool_fingerprint')}")
print(f"  target_modules   = {','.join(meta.get('target_modules', []))}")
print(f"  层数             = {len(covariances)}")
# 这两个 max_len **本来就不该相等**，写出来免得后面有人当 bug 修。
# C 是旧知识（IF 线的 FLAN/Conifer 行、math 线的 Numina 行）的隐状态二阶矩，用的是
# 旧任务的预算（两条线都是 2048）；新任务 Commonsense 在 512 下训练。罚项只经过
# ΔW 与 C 相乘，两边的序列长度不需要一致，需要一致的是**模型**（下面那条检查）。
# 方向与 96 号相反：那条线是 C 的预算 <= 新任务的预算，本线是 C(2048) > 新任务(512)。
print(f"  max_len          = {cov_max_len}  (采 C 时旧知识池的预算)")
print(f"  新任务 max_len   = {new_task_max_len}  (本作业训练的预算；两者不必相等)")

if got_model != want_model:
    raise SystemExit(
        f"\n!! C 是在 {got_model!r} 上采的，本作业的基座是 {want_model!r}。\n"
        "罚项是 tr(ΔW C ΔWᵀ) 且 ΔW = W - W0，W0 就是基座权重，所以 C 必须和基座\n"
        "同一个模型。不一致的话隐状态分布对不上，保护会变弱且无法解释 —— 而且\n"
        "不会报错、loss 曲线也正常。\n"
        "要么重采对应的 C，要么把 SRC_LR/SRC_CKPT 指到 C 对应的那个 checkpoint。"
    )
print("\nC 与基座是同一个模型：ok")
print(f"C 常驻显存 = {sum(m.numel() for m in covariances.values()) * 4 / 1024 ** 3:.2f} GiB "
      "(fp32, move_covariances_to_device 一次性搬上去)")
PY
fi

if (( NEEDS_FISHER )); then
  [[ -f "${FISHER_PATH}" ]] || {
    echo "缺 F_${SOURCE}: ${FISHER_PATH}"
    echo "它是 SOURCE=if -> 95 号 / SOURCE=math -> 99 号的产物，应当早就有了。"
    exit 1
  }
  # 和 C 那边同一个理由：F 是 W0 处的曲率，采在别的模型上就不是这个 W0 的曲率。
  # 额外多一条：F 的池指纹必须等于 C 的。EWC 与 onereplay 的整个对照建立在"两者
  # 吃的是同一批旧知识行"之上，指纹不等的话比的就是数据而不是加权矩阵。
  python - "${FISHER_PATH}" "${SRC_RUN}" "${MAXLEN}" "${COV_PATH}" <<'PY'
import sys
from pathlib import Path

import torch

fisher_path, want_model, new_task_max_len, cov_path = sys.argv[1:5]
new_task_max_len = int(new_task_max_len)
payload = torch.load(fisher_path, map_location="cpu")
meta = payload.get("metadata", {})
fishers = payload["fishers"]

got_model = str(meta.get("model_name", ""))
elements = sum(matrix.numel() for matrix in fishers.values())
print("F 的 metadata:")
print(f"  model_name       = {got_model}")
print(f"  estimator        = {meta.get('estimator')}")
print(f"  num_examples (N) = {meta.get('num_examples')}")
print(f"  pool_fingerprint = {meta.get('pool_fingerprint')}")
print(f"  target_modules   = {','.join(meta.get('target_modules', []))}")
print(f"  层数             = {len(fishers)}")
print(f"  max_len          = {meta.get('max_len')}  (采 F 时旧知识池的预算)")
print(f"  新任务 max_len   = {new_task_max_len}  (本作业训练的预算；两者不必相等)")

problems = []
if got_model != want_model:
    problems.append(
        f"F 是在 {got_model!r} 上采的，本作业的基座是 {want_model!r}。\n"
        "   罚项是 sum_ij F_ij (W-W0)_ij² 且 W0 就是基座权重，所以 F 必须和基座同一个\n"
        "   模型。不一致不会报错、loss 曲线也正常，但曲率对不上，保护无法解释。"
    )
if meta.get("per_example_backward") is not True:
    problems.append(
        "per_example_backward 不是 True —— 对 batch 求和的梯度再平方算的是 (Σg)²，"
        "不是 Σg²，那不是 Fisher"
    )

# 与 C 的交叉校验。C 不在场（例如只跑 ewc 臂）就跳过，不当成错误。
if Path(cov_path).is_file():
    cov_payload = torch.load(cov_path, map_location="cpu")
    cov_meta = cov_payload.get("metadata", {})
    cov_fp = str(cov_meta.get("pool_fingerprint", ""))
    fisher_fp = str(meta.get("pool_fingerprint", ""))
    if cov_fp and cov_fp == fisher_fp:
        print(f"\nF 与 C 的池指纹一致: {cov_fp[:16]}...  ok")
    else:
        problems.append(
            f"F 的池指纹 {fisher_fp} != C 的 {cov_fp}。两者看到的不是同一批旧知识，\n"
            "   「onereplay vs EWC」就退化成「谁看到了哪些数据」的比较。"
        )
    cov_keys = set(cov_payload["covariances"])
    if cov_keys == set(fishers):
        print(f"F 与 C 的层集合一致: {len(cov_keys)} 个模块  ok")
    else:
        problems.append(
            f"F 与 C 的层集合不同（只有 C: {sorted(cov_keys - set(fishers))[:3]}，"
            f"只有 F: {sorted(set(fishers) - cov_keys)[:3]}）。"
            "两条臂必须约束同一批层。"
        )
else:
    print(f"\n（{cov_path} 不在，跳过与 C 的交叉校验）")

if problems:
    print()
    raise SystemExit("!! " + "\n!! ".join(problems))

# EWC 走的是 autograd 路径（EWCRegularizer 没有 accumulate_grad，也就没有 injects_grad），
# 所以 reg_once_per_update=1 下罚项在每个 accumulation 窗口的**第一个** micro-batch
# 上进图、backward 之后就释放。常驻的只有 F 本身和 W0 快照。
mean_f = sum(float(m.float().sum()) for m in fishers.values()) / max(elements, 1)
print(f"\nF 常驻显存 = {elements * 4 / 1024 ** 3:.2f} GiB (fp32)")
print(f"mean(F)    = {mean_f:.4e}   ->  1/mean(F) = {1.0 / max(mean_f, 1e-30):.4e}")
print("  ^ EWC 的 λ 起点。这个数和 onereplay 的 λ **不可比**，必须自己 sweep。")
PY
fi

# ---- 评测数据在**训练之前**查 ----
# 缺了不能只是警告 —— 放到 eval 那一步才发现，意味着先白烧掉几小时训练。
# 常识那八个 test.json 不随仓库走（是 LLM-Adapters 的原始文件），旧能力侧的数据按
# SOURCE 不同。只在这次真的会评测时查。
if [[ "${MODE}" == "eval" || ( "${MODE}" == "train" && "${DO_EVAL}" == "1" ) ]]; then
  if [[ "${DO_CS}" == "1" && ! -d "${CS_EVAL_DIR}" ]]; then
    echo "!! 缺常识评测数据目录: ${CS_EVAL_DIR}"
    echo "   它是新任务侧的分数（「学到了多少」那一半）。在有网节点上准备："
    echo "     git clone --depth 1 https://github.com/AGI-Edgerunners/LLM-Adapters"
    echo "     cp -r LLM-Adapters/dataset ${CS_EVAL_DIR}"
    echo "   布局 <dir>/<task>/test.json，八个子目录约 10MB。"
    echo "   只想评旧能力保留侧请传 DO_CS=0；只想训练请传 DO_EVAL=0。"
    exit 1
  fi
  if [[ "${DO_OLD}" == "1" ]]; then
    case "${SOURCE}" in
      if)
        if [[ ! -f "${IFEVAL_INPUT}" ]]; then
          echo "!! 找不到 IFEval 输入: ${IFEVAL_INPUT}"
          echo "   它是本线主指标（IF 旧能力保留）的一半，不能静默跳过。"
          echo "   本来随仓库自带（onereplay/third_party/instruction_following_eval/data/），先查路径。"
          echo "   只想评新任务请传 DO_OLD=0；只想训练请传 DO_EVAL=0。"
          exit 1
        fi
        ;;
      math)
        if [[ ! -f "${GSM8K_DATA}" || ! -f "${MATH500_DATA}" ]]; then
          echo "!! 缺数学评测集（旧能力保留侧）:"
          echo "   ${GSM8K_DATA}"
          echo "   ${MATH500_DATA}"
          echo "   91 号读的也是这两个文件。只想评新任务请传 DO_OLD=0。"
          exit 1
        fi
        ;;
    esac
  fi
fi

if (( ACCUM % BATCH != 0 )); then
  echo "ACCUM=${ACCUM} 必须能被 BATCH=${BATCH} 整除"
  echo "（accumulation_steps = ACCUM // BATCH 是整除，否则「一次更新 ${ACCUM} 行」不成立）"
  exit 1
fi

echo ""
echo "========================================================================"
echo "Stage 3: Model-${OLD_LABEL} --Commonsense170k--> Model-${OLD_LABEL}-CS   (full finetune)"
echo "  MODE / ARM     : ${MODE} / ${ARM}"
if [[ "${MODE}" == "lambda_probe" ]]; then
# probe 不看 ARM，它扫的是 PROBE_ARM。这一行免得下面的"保护"栏被读成本次扫的对象。
echo "  本次扫的臂     : PROBE_ARM=${PROBE_ARM}（ARM=${ARM} 在 probe 模式下不参与）"
fi
if [[ "${MODE}" == "smoke" ]]; then
echo "  本次冒烟的臂   : vanilla + ${SMOKE_ARM}"
fi
echo "  旧能力来源     : SOURCE=${SOURCE}  (旧能力 = ${OLD_LABEL})"
echo "  基座 (= W0)    : ${SRC_CKPT}"
echo "  新任务池       : ${CS_DATASET}"
if [[ "${ARM}" == "onereplay" ]]; then
echo "  保护           : C_${SOURCE} = ${COV_PATH}"
echo "                   λ=${LAMBDA} reg_impl=${REG_IMPL} once_per_update=${REG_ONCE}"
echo "                   normalize_by_layers=${NORMALIZE_BY_LAYERS} tf32=${REG_ALLOW_TF32}"
elif [[ "${ARM}" == "ewc" ]]; then
echo "  保护           : F_${SOURCE} = ${FISHER_PATH}"
echo "                   λ=${LAMBDA} (EWC 自己的尺子，与 onereplay 的 λ 不可比)"
echo "                   once_per_update=${REG_ONCE} normalize_by_layers=${NORMALIZE_BY_LAYERS}"
echo "                   reg_impl 不适用：EWC 只有 autograd 路径"
elif [[ "${ARM}" == "vanilla" ]]; then
echo "  保护           : 无（--replay_lambda 0 --measure_replay_when_lambda_zero 0）"
echo "                   这条臂是遗忘的标尺，onereplay 的结论离不开它"
else
echo "  保护           : 不适用（anchor 只评测 Stage 3 的起点，不训练）"
fi
echo "  超参           : epochs=${EPOCHS} lr=${LR} batch=${BATCH} accum=${ACCUM} maxlen=${MAXLEN}"
echo "                   batch 由最吃显存的 ewc 臂决定，三臂必须相同（见配置闸门）"
echo "  一次更新       : ${ACCUM} 行 = $(( ACCUM / BATCH )) 个 micro-batch"
echo "  system (常识)  : ${SYSTEM_PROMPT:-<空>}"
echo "                   训练渲染 + commonsense_qa 都用它，与 93 号对齐"
echo "  system (旧能力): ${OLD_SYSTEM_PROMPT:-<空>}"
echo "                   SOURCE=if 时与 93/94 号同值；SOURCE=math 时是 91 号的 boxed 指令"
echo "  评测           : cs=${DO_CS} (commonsense_qa 新任务, tasks=${CS_EVAL_TASKS:-<全部八个>})"
echo "                   scoring=${CS_SCORING}；acc_gen 只配 parse_rate 读"
echo "                   旧能力=${DO_OLD} (${OLD_METRICS_ALL})"
echo "  run 名         : ${RUN}"
echo "  checkpoint     : ${CKPT}"
echo "  结果树         : ${RESULTS_ROOT}"
echo "========================================================================"
# =============================================================================
# 三臂配置一致性闸门
#
# 三臂的产出是性能开销对照，所以 batch / accum / lr / 总更新次数必须逐字相同。这个
# 检查要在训练**之前**跑：一旦让第二条臂用不同的 batch 跑完，两条臂就都得重跑，而那
# 是两个 24h 作业。典型的出错方式是先用 vanilla 试到 BATCH=16 能过，再投 ewc 时 OOM
# 退到 8 —— 那个 16 的 vanilla 当场作废。
#
# 比较对象是同一棵结果树下**已经训完**的其他臂的 metrics（epoch 记录里带 batch_size
# 等字段，见 train.py 的 extra_record）。第一条臂没有参照，直接放行。
#
# total_updates 一起比是为了抓 epochs 和数据量的差异：它们不在 epoch 记录里单独出现，
# 但任一个变了 total_updates 就变。
#
# 确实要故意跑不同配置（比如单独做一次 batch 敏感性实验）就传 ALLOW_CONFIG_DRIFT=1，
# 那样只警告不拦。别为了让作业跑起来而传它 —— 拦住的正是会让你重跑的那件事。
#
# DRY_RUN=1 也跑这一步：它属于前置检查，在不碰 GPU 的时候就该看到。
# =============================================================================
check_config_consistency () {
  python - "${METRICS_DIR}" "${RUN}" "${BATCH}" "${ACCUM}" "${LR}" \
    "${ALLOW_CONFIG_DRIFT}" <<'PY'
import glob
import json
import os
import sys

metrics_dir, this_run, batch, accum, lr, allow = sys.argv[1:7]
allow = allow == "1"

# 只比这几个：它们直接决定 per-step 时间和峰值显存，也就是三臂唯一要对齐的东西。
# lr 在里面是因为它写进 run 名，配置漂了但 run 名没漂会让结果表读错。
WATCHED = {
    "batch_size": int(batch),
    # 比 new_per_update 而不是 accumulation_size：replay 臂的 micro-batch 只有一半是
    # 新任务，它的 --accumulation_size 是别人的两倍，但**每次更新的新任务行数**一样。
    # 后者才是"各臂吃到同样多新数据"这件事的不变量，train.py 已经把它记进 metrics
    # （非 replay 臂等于 accumulation_size，replay 臂等于 accum_steps x new_per_batch）。
    # 拿 accumulation_size 比会把一个正确的 replay 臂判成漂移。
    "new_per_update": int(accum),
    "lr": float(lr),
}


def last_epoch(path):
    row = None
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                parsed = json.loads(line)
                if parsed.get("record_type") == "epoch":
                    row = parsed
    except (OSError, json.JSONDecodeError):
        return None
    return row


others = []
for path in sorted(glob.glob(os.path.join(metrics_dir, "*.jsonl"))):
    name = os.path.basename(path)[: -len(".jsonl")]
    # 跳过自己、以及 smoke / probe 那些故意用短配置的短跑。
    if name == this_run or name.startswith(("smoke_", "probe_")):
        continue
    row = last_epoch(path)
    if row is not None:
        others.append((name, row))

if not others:
    print("配置闸门: 这棵树下还没有训完的其他臂，本次配置将成为后续臂的基准。")
    print(f"  batch_size={batch} new_per_update={accum} lr={lr}")
    raise SystemExit(0)

drift = []
for name, row in others:
    for key, want in WATCHED.items():
        got = row.get(key)
        if got is None:
            continue
        if isinstance(want, float):
            same = abs(float(got) - want) <= 1e-12
        else:
            same = int(got) == want
        if not same:
            drift.append((name, key, got, want))

# 本次的 total_updates 在训练前还不知道（要等 loader 建好），所以它只能在已有各臂
# 之间交叉比。它们若彼此不同，"和基准比"这件事就已经没有基准了。
by_updates = {}
for name, row in others:
    value = row.get("total_updates")
    if value is not None:
        by_updates.setdefault(value, []).append(name)

print(f"配置闸门: 对照 {len(others)} 条已训完的臂")
for name, row in others:
    print(
        f"  {name:<36} batch={row.get('batch_size')} "
        f"accum={row.get('accumulation_size')} "
        f"new/upd={row.get('new_per_update')} lr={row.get('lr')} "
        f"updates={row.get('total_updates')}"
    )
# accum 那一列 replay 臂会是别人的两倍，这是对的；要看齐的是 new/upd 这一列。
print(f"  {'(本次) ' + this_run:<36} new/upd={accum} lr={lr} batch={batch}")

if not drift and len(by_updates) <= 1:
    print("  -> 一致，可以训练。")
    raise SystemExit(0)

print()
if drift:
    print("!! 本次配置和已训完的臂不一致：")
    for name, key, got, want in drift:
        print(f"   {name}: {key} = {got}，本次要用 {want}")
if len(by_updates) > 1:
    print("!! 已训完的各臂之间 total_updates 就已经不一致，本次用什么配置都没有基准：")
    for value, names in sorted(by_updates.items()):
        print(f"   total_updates={value:<8} {', '.join(names)}")
    print("   这通常是 epochs 或 MAX_TRAIN_SAMPLES 中途改过。")
print()
if allow:
    print("ALLOW_CONFIG_DRIFT=1，只警告不拦。这些臂之间的开销数字不可比。")
    raise SystemExit(0)
print("三臂的开销对照要求这些值逐字相同。要么改回上面已有的值，要么换一棵结果树")
print("（传 RESULTS_ROOT=...）把这次实验和已有的分开。确实要故意跑不同配置就传")
print("ALLOW_CONFIG_DRIFT=1。")
raise SystemExit(1)
PY
}

if [[ "${DRY_RUN}" == "1" ]]; then
  echo "DRY_RUN=1：只做前置检查，不训练不评测。"
  echo ""
  check_config_consistency || exit 1
  echo ""
  echo "Job finished at: $(date)"
  exit 0
fi
# =============================================================================
# 共用训练封装
#
# 各臂的唯一差别是最后那几行正则参数，其余逐字相同 —— 这是「只改一个变量」的
# 工程实现。vanilla 必须传 --measure_replay_when_lambda_zero 0：只传 λ=0 的话
# build_regularizer 仍会加载 C 并每步求值（默认 measure=1），那测出来的时间和显存
# 就不是 vanilla 的了（train.py 里有一段专门 warn 这件事）。
#
#   $1 run  $2 arm  $3 epochs  $4 lambda  $5 save_path  $6 max_steps  $7 save  $8 log_every
# =============================================================================
train_one () {
  local run="$1" arm="$2" epochs="$3" lam="$4" save_path="$5"
  local max_steps="${6:-0}" do_save="${7:-1}" log_every="${8:-${LOG_EVERY}}"

  local -a reg_args=()
  case "${arm}" in
    onereplay)
      reg_args=(
        --regularizer onereplay
        --cov_path "${COV_PATH}"
        --replay_lambda "${lam}"
        --identity_cov 0
        --reg_impl "${REG_IMPL}"
        --reg_once_per_update "${REG_ONCE}"
        --reg_allow_tf32 "${REG_ALLOW_TF32}"
        --normalize_replay_by_layers "${NORMALIZE_BY_LAYERS}"
      )
      ;;
    ewc)
      # 与 onereplay 只差加权矩阵：F 的对角经验 Fisher 换掉 C，罚项从
      # tr(ΔW C ΔWᵀ) 变成 sum_ij F_ij ΔW_ij²。其余训练参数逐字相同。
      #
      # 刻意**不传** --reg_impl / --reg_allow_tf32：EWCRegularizer 没有
      # accumulate_grad，analytic 路径对它不存在（那条路是给 C 的矩阵乘写的），
      # 传了会被静默忽略，反而让日志看起来像开了 analytic。EWC 只有 autograd。
      # --identity_cov 也不能传 1：train.py 会直接报错（它是 C 那条路的 L2 对照）。
      reg_args=(
        --regularizer ewc
        --fisher_path "${FISHER_PATH}"
        --replay_lambda "${lam}"
        --reg_once_per_update "${REG_ONCE}"
        --normalize_replay_by_layers "${NORMALIZE_BY_LAYERS}"
      )
      ;;
    vanilla)
      reg_args=(--replay_lambda 0 --measure_replay_when_lambda_zero 0)
      ;;
    replay)
      # 没有正则项（--replay_lambda 0，和 vanilla 同款），旧知识靠**真的再训一遍**。
      # --replay_ratio 0 是必须的：per_batch 和 ratio 是两套口径，ratio 非 0 会让
      # 混合比例由它决定而不是由 replay_per_batch 决定。
      # --replay_max_len 跟 MAXLEN 同值：旧知识池的行如果按更短的预算截断，
      # C/F 看到的序列和 replay 训的序列就不是一回事了。
      reg_args=(
        --replay_lambda 0 --measure_replay_when_lambda_zero 0
        --replay_ratio 0
        --replay_per_batch "${REPLAY_PER_BATCH}"
        --replay_data_files "${SRC_POOL_FILE}"
        --replay_input_column "${REPLAY_INPUT_COLUMN}"
        --replay_target_column "${REPLAY_TARGET_COLUMN}"
        --replay_pool_size "${REPLAY_POOL_SIZE}"
        --replay_sample_seed "${REPLAY_SAMPLE_SEED}"
        --replay_max_len "${MAXLEN}"
      )
      ;;
    *)
      echo "train_one 不支持 arm=${arm}"; return 1
      ;;
  esac

  mkdir -p "${RESULTS_ROOT}/map_cache/${run}"
  echo "==== train ${run} (arm=${arm} lr=${LR} lam=${lam} max_steps=${max_steps}) ===="
  python -m onereplay.scripts.train --paradigm sft --full_finetune 1 \
    --model_dir "${SRC_CKPT_DIR}" --model_name "${SRC_RUN}" --seed "${SEED}" \
    --dataset_path "${CS_DATASET}" \
    --epochs "${epochs}" --lr "${LR}" \
    --batch_size "${BATCH}" --accumulation_size "${ACCUM_TRAIN}" \
    --max_len "${MAXLEN}" \
    --val_fraction "${VAL_FRAC}" --max_val_samples "${MAXVAL}" \
    --eval_batch_size "${BATCH}" \
    --max_train_samples "${MAX_TRAIN_SAMPLES}" \
    --target_modules "${TARGET_MODULES}" \
    --system_prompt "${SYSTEM_PROMPT}" \
    --lr_scheduler "${LR_SCHEDULER}" --warmup_ratio "${WARMUP_RATIO}" \
    --map_cache_dir "${RESULTS_ROOT}/map_cache/${run}" \
    "${reg_args[@]}" \
    --max_steps "${max_steps}" --log_every "${log_every}" \
    --save "${do_save}" --save_path "${save_path}" \
    --metrics_path "${METRICS_DIR}/${run}.jsonl"
}

# =============================================================================
# MODE=smoke：两条臂各跑几十步、不保存。这一步要盯三件事：
#
#   1) 「regularizer covers N layers; no penalty matrix for M layers」
#      N 必须是 C 的层数（Qwen3-4B-Base 的 full scope 是 36 层 x 7 + lm_head = 253，
#      以 Step 0 打印的层数为准），**M 必须是 0**。M 非 0 说明 C 的键和模型的模块名
#      对不上，罚项在偷偷少覆盖几层，而这不会报错。
#   2) peak memory。这是本 mode 最重要的产出，**三臂共用的 BATCH 由它定**。
#      上面 BATCH 那处按架构估的是 ewc ~98.9 GiB @ BATCH=8 / ~131 GiB @ BATCH=16，
#      估算误差 ±15%，所以要动 BATCH 必须先看这里的实测值。
#      **探显存必须 ARM=ewc**：它走 autograd、所有覆盖层的 fp32 DeltaW 活到 backward
#      返回，是三臂里最紧的一条。拿 vanilla 探等于没探 —— vanilla 连 W0 快照、
#      F、正则临时量这三项（合计 34.4 GiB）都不占，探出来的余量是假的。
#   3) 两条臂的 tokens_per_sec 应当基本相同（正则每次更新只算一遍，占几个百分点）。
#      差很多就是显存压力导致的分配器抖动，不是正则本身贵。
#
# λ 在这里只是个标量乘数、不影响显存和层覆盖，所以**还没标定 λ 也可以先探**，
# 随便给一个（ARM=ewc 仍然要求显式传，那是防呆不是防显存）。
# =============================================================================
if [[ "${MODE}" == "smoke" ]]; then
  # SMOKE_ARM 跟着 ARM：ARM=ewc 时冒烟的是 vanilla + ewc。EWC 走 autograd（没有
  # analytic 路径），显存曲线和 onereplay 不是一回事，所以那条臂**必须自己冒烟一次**，
  # 不能拿 onereplay 的 peak memory 代替。
  echo "冒烟臂: vanilla + ${SMOKE_ARM}"
  train_one "smoke_p5_vanilla" vanilla 1 0 "${CKPT_DIR}/smoke_p5_vanilla" \
    "${SMOKE_STEPS}" 0 10
  train_one "smoke_p5_${SMOKE_ARM}" "${SMOKE_ARM}" 1 "${LAMBDA}" \
    "${CKPT_DIR}/smoke_p5_${SMOKE_ARM}" "${SMOKE_STEPS}" 0 10

  echo ""
  echo "==== 冒烟自检 ===="
  python - "${METRICS_DIR}/smoke_p5_vanilla.jsonl" "${METRICS_DIR}/smoke_p5_${SMOKE_ARM}.jsonl" \
    "${SMOKE_ARM}" <<'PY'
import json
import sys


def last_epoch(path):
    rows = []
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if line:
                    row = json.loads(line)
                    if row.get("record_type") == "epoch":
                        rows.append(row)
    except FileNotFoundError:
        return None
    return rows[-1] if rows else None


vanilla, protected = (last_epoch(path) for path in sys.argv[1:3])
arm = sys.argv[3]
if vanilla is None or protected is None:
    raise SystemExit("缺 metrics，冒烟没跑完")

print(f"{'':<26}{'vanilla':>16}{arm:>16}")
for key, label, fmt in (
    ("train_task_loss", "task_loss", "{:.6f}"),
    ("train_replay_reg", "R (未乘 λ)", "{:.4e}"),
    ("train_lambda_reg", "λ·R", "{:.4e}"),
    ("tokens_per_sec", "tokens/s", "{:.0f}"),
    ("covariance_memory_gb", "罚项矩阵常驻 GiB", "{:.2f}"),
    ("reference_memory_gb", "W0 常驻 GiB", "{:.2f}"),
):
    def cell(row):
        value = row.get(key)
        return (fmt.format(value) if isinstance(value, (int, float)) else "-").rjust(16)
    print(f"{label:<26}{cell(vanilla)}{cell(protected)}")

peak_keys = [k for k in protected if "peak" in k and "memory" in k]
for key in sorted(peak_keys):
    print(f"{key:<26}{str(vanilla.get(key, '-')):>16}{str(protected.get(key, '-')):>16}")
if arm == "ewc":
    print()
    print("EWC 走 autograd：罚项在每个 accumulation 窗口的第一个 micro-batch 上进图，")
    print("backward 之后释放。峰值应当比 onereplay(analytic) 高一些——那条路按层转 fp32，")
    print("这条路整轮持有。高多少看上面的实测，别按估计值排作业。")
else:
    print()
    print("!! 这次冒烟的不是 ewc 臂。**BATCH 不能靠这次的峰值定**：ewc 多占 W0 快照 +")
    print("   F + 正则临时量约 34 GiB。定 BATCH 请重跑 MODE=smoke,ARM=ewc。")

ratio = None
task = protected.get("train_task_loss")
lam_reg = protected.get("train_lambda_reg")
if task and lam_reg:
    ratio = lam_reg / task
    print(f"\nλ·R / task_loss = {ratio:.4f}")
    if ratio < 0.01:
        print("  -> 罚项不到任务损失的 1%，λ 大概偏小（几乎等于没开保护）")
    elif ratio > 0.5:
        print("  -> 罚项超过任务损失的一半，λ 大概偏大（会明显牺牲新任务）")
    else:
        print("  -> 量级合理，可以从这个 λ 附近开 grid")

speed = None
if vanilla.get("tokens_per_sec") and protected.get("tokens_per_sec"):
    speed = protected["tokens_per_sec"] / vanilla["tokens_per_sec"]
    print(f"{arm} / vanilla 吞吐比 = {speed:.3f}")
    if speed < 0.9:
        print("  -> 慢了 10% 以上。正则每次更新只算一遍，先怀疑显存压力。")
PY
  echo ""
  echo "还要回到上面的训练日志里人工确认一行:"
  echo "  regularizer covers <N> layers; no penalty matrix for <M> layers"
  echo "  N 必须等于罚项矩阵的层数，**M 必须是 0**。M 非 0 = 矩阵的键与模型模块名对不上。"
  exit 0
fi

# =============================================================================
# MODE=lambda_probe：选 λ 的第一步
#
# 只回答一个问题：**λ·R 和 task_loss 差几个数量级。** 不回答「哪个 λ 更好」——
# 那要跑完整训练看旧能力分数和 val_loss。
#
# 本线的起点比另两条线可靠：44 号那个 7.5e-3 就是在**同一个新任务**（Commonsense @ 512、
# full all-linear scope）上定的，task_loss 的绝对尺度相同，所以它是同尺度的历史值而
# 不只是量级参考。差别只在 C 采在哪个模型上（44 号是 Base 的 1.7B，本线是 4B 的 Stage 1
# 产物），trace(C) 与 ΔW 的早期增长速度都可能不同 —— 所以还是要确认一次，只是大概率
# 一档就中。
#
# PROBE_MAX_STEPS 数的是 micro-batch，更新次数要除以 ACCUM/BATCH=8。默认 160 步
# = 20 次更新。这对量级判断够了（R 从 0 开始长，前几次更新就到稳定量级），但**不足以
# 判断谁的 val_loss 更低** —— 别拿这里的 val_loss 排序做决定，本线的 val_loss 尤其钝：
# 监督 span 只有 7-8 个 token，且 val 是按行切的。
#
# -----------------------------------------------------------------------------
# 【PROBE_ARM：两条臂的 λ 必须各标一次】
#
# λ·R 要落在 task_loss 的 1%~10%，这个判据对两条臂是同一个。但达到它的 λ 数值不是
# 同一个量级，因为 R 的定义不同：
#     onereplay  R = tr(ΔW C ΔWᵀ)，C 是激活的二阶矩 E[x xᵀ]
#     ewc        R = Σ F_ij ΔW_ij²，F 是逐参数梯度平方的均值
# F 的元素普遍是很小的数（mean(F) 常在 1e-8 量级），所以 λ_ewc 的起点是 1/mean(F)，
# 可能是 1e7 这种数。把 onereplay 的 7.5e-3 套到 ewc 上等于没开保护，反之等于不学
# 新任务 —— 两种错误都要烧掉一个 24h 作业才看得见，所以脚本强制 ARM=ewc 显式传 λ。
#
# PROBE_ARM=ewc 时若没传 LAMBDA_GRID，下面会读 F 文件现算 1/mean(F)，按
# EWC_GRID_MULTIPLIERS 展开成三档。这样 grid 中心来自数据本身，不是猜的。
# =============================================================================
if [[ "${MODE}" == "lambda_probe" ]]; then
  case "${PROBE_ARM}" in
    onereplay|ewc) : ;;
    *) echo "PROBE_ARM=${PROBE_ARM} 无效，可选 onereplay / ewc"; exit 1 ;;
  esac

  # ---- grid：用户给了就用，没给按臂生成 ----
  if [[ -z "${LAMBDA_GRID}" ]]; then
    if [[ "${PROBE_ARM}" == "onereplay" ]]; then
      LAMBDA_GRID="${LAMBDA_GRID_ONEREPLAY}"
      echo "LAMBDA_GRID 未指定，用 onereplay 的默认三档（中心 7.5e-3 来自 44 号，同新任务）"
    else
      echo "LAMBDA_GRID 未指定，按 1/mean(F) x {${EWC_GRID_MULTIPLIERS}} 现算"
      LAMBDA_GRID="$(python - "${FISHER_PATH}" "${EWC_GRID_MULTIPLIERS}" <<'PY'
import sys

import torch

payload = torch.load(sys.argv[1], map_location="cpu")
fishers = payload["fishers"]
total = sum(float(matrix.float().sum()) for matrix in fishers.values())
elements = sum(matrix.numel() for matrix in fishers.values())
mean_f = total / max(elements, 1)
if mean_f <= 0:
    raise SystemExit("mean(F) <= 0，F 文件不对（全零？先看采集脚本的诊断）")
center = 1.0 / mean_f
# 1/mean(F) 让 Σ F ΔW² 的量级回到 ΣΔW² 附近，也就是把 EWC 摆到"和 L2 同量级"的
# 起点上。它只是个有依据的起点，不是答案——落到 1%~10% 区间靠下面那张表。
# 打到 stderr：stdout 要原样当 grid 用，多一个字都会进 for 循环。
print(f"mean(F)={mean_f:.6e}  1/mean(F)={center:.6e}", file=sys.stderr)
print(" ".join(f"{center * float(m):.4e}" for m in sys.argv[2].split()))
PY
)"
    fi
  fi
  echo "PROBE_ARM=${PROBE_ARM}  grid=${LAMBDA_GRID}"
  echo "每档 ${PROBE_MAX_STEPS} micro-batch = $(( PROBE_MAX_STEPS / (ACCUM / BATCH) )) 次优化器更新 = $(( PROBE_MAX_STEPS * BATCH )) 行"
  if [[ "${PROBE_VANILLA}" == "1" ]]; then
    echo "先跑一档 vanilla 当同步长下的 λ=0 参照"
    train_one "probe_p5_vanilla" vanilla 1 0 "${CKPT_DIR}/probe_p5_vanilla" \
      "${PROBE_MAX_STEPS}" 0 "${PROBE_LOG_EVERY}"
  else
    echo "PROBE_VANILLA=0：跳过 probe 里的 λ=0 那一档。"
    echo "选 λ 的 λ·R/task_loss 比值只用 ${PROBE_ARM} 臂自己的数，不需要它。"
    echo "但 calibrate_lambda 的 floor 必须是**完整 EPOCHS** 的 vanilla run，别拿这条顶替。"
  fi
  for lam in ${LAMBDA_GRID}; do
    train_one "probe_p5_${PROBE_ARM}_lam${lam}" "${PROBE_ARM}" 1 "${lam}" \
      "${CKPT_DIR}/probe_p5_${PROBE_ARM}_lam${lam}" "${PROBE_MAX_STEPS}" 0 "${PROBE_LOG_EVERY}"
  done

  echo ""
  echo "==== λ probe 汇总（${PROBE_MAX_STEPS} micro-batch = $(( PROBE_MAX_STEPS / (ACCUM / BATCH) )) 次更新）===="
  python - "${METRICS_DIR}" "${LAMBDA_GRID}" "${PROBE_ARM}" "${OLD_LABEL}" <<'PY'
import json
import sys
from pathlib import Path

metrics_dir = Path(sys.argv[1])
grid = sys.argv[2].split()
arm = sys.argv[3]
old_label = sys.argv[4]


def last_epoch(path: Path):
    if not path.is_file():
        return None
    rows = [
        json.loads(line)
        for line in path.read_text(encoding="utf-8").splitlines()
        if line.strip()
    ]
    rows = [row for row in rows if row.get("record_type") == "epoch"]
    return rows[-1] if rows else None


floor = last_epoch(metrics_dir / "probe_p5_vanilla.jsonl")
floor_loss = floor.get("train_task_loss") if floor else None
floor_val = floor.get("val_loss") if floor else None

print(f"{'lambda':>10}{'task_loss':>13}{'R':>13}{'λ·R':>13}{'λ·R/task':>11}{'val_loss':>11}")
if floor is not None:
    print(f"{'0 (vanilla)':>10}{floor_loss:>13.6f}{'-':>13}{'-':>13}{'-':>11}"
          + (f"{floor_val:>11.6f}" if floor_val is not None else f"{'-':>11}"))

rows = []
for lam in grid:
    record = last_epoch(metrics_dir / f"probe_p5_{arm}_lam{lam}.jsonl")
    if record is None:
        print(f"{lam:>10}{'  (缺 metrics)':<40}")
        continue
    task = record.get("train_task_loss")
    reg = record.get("train_replay_reg")
    lam_reg = record.get("train_lambda_reg")
    val = record.get("val_loss")
    ratio = (lam_reg / task) if (task and lam_reg) else None
    rows.append((lam, ratio))
    print(
        f"{lam:>10}{task:>13.6f}"
        + (f"{reg:>13.4e}" if reg is not None else f"{'-':>13}")
        + (f"{lam_reg:>13.4e}" if lam_reg is not None else f"{'-':>13}")
        + (f"{ratio:>11.4f}" if ratio is not None else f"{'-':>11}")
        + (f"{val:>11.6f}" if val is not None else f"{'-':>11}")
    )

print()
print("怎么读这张表:")
print("  * R 那一列在各档之间应当接近（同样 20 次更新、同样的数据，ΔW 的量级相仿），")
print("    λ·R 主要随 λ 线性变。R 差很多说明大 λ 已经明显改变了轨迹。")
print("  * 选 λ·R/task 落在 0.01~0.10 的那一档当 grid 中心：罚项要能改变优化方向")
print("    （太小等于没开保护），又不能盖住任务信号（太大等于不学新任务）。")
inside = [lam for lam, ratio in rows if ratio is not None and 0.01 <= ratio <= 0.10]
if inside:
    print(f"  * 本次落在该区间的: {' '.join(inside)}")
else:
    print("  * 本次没有一档落在该区间，按比值线性外推调整 grid 再跑一次（λ·R ∝ λ）。")
print()
print("**这张表不决定最终 λ。** 20 次更新的 val_loss 没有判别力，别用它排序。定稿要:")
print(f"  1) 选出的 λ 跑完整 EPOCHS，和 vanilla 比 {old_label} 分数（这才是保留能力的证据）")
print(f"       qsub -v MODE=train,ARM={arm},LAMBDA=<选出的值>,DO_OLD=0 <本脚本>")
print(f"       然后 qsub -v MODE=eval,ARM={arm},LAMBDA=<同上>,DO_CS=0 <本脚本>")
print("  2) 报结果时用 matched plasticity —— 各臂在同一个新任务 val_loss 上比:")
print("       python -m onereplay.scripts.calibrate_lambda \\")
print("         --results_root <RESULTS_ROOT> \\")
print(f"         --pattern 's3_cs_{arm}_lr*_lam*_seed1' \\")
print("         --floor_run s3_cs_vanilla_lr<LR>_seed1 --target <vanilla val_loss>")
if arm == "ewc":
    print()
    print("注意：onereplay 与 ewc 各自标定出的 λ 之间**没有可比性**，不要因为一个是")
    print("1e7、一个是 1e-2 就觉得哪条臂更强。可比的是两者在同一个 val_loss 上")
    print(f"（matched plasticity）各保住了多少 {old_label} 分数。")
PY
  exit 0
fi

# =============================================================================
# MODE=train：正式训练
# =============================================================================
if [[ "${MODE}" == "train" && "${DO_TRAIN}" == "1" ]]; then
  if [[ "${ARM}" == "anchor" ]]; then
    echo "ARM=anchor 不训练（它就是 Stage 3 的起点 Model-${OLD_LABEL}）。用 MODE=eval 评它。"
  elif [[ -d "${CKPT}" && "${FORCE_TRAIN}" != "1" ]]; then
    echo "跳过训练：${CKPT} 已存在（FORCE_TRAIN=1 可强制重训）"
  else
    # 训练之前拦一次。失败就不开 GPU —— 拦住的是"跑完才发现和别的臂不可比"。
    check_config_consistency || exit 1
    echo ""
    train_one "${RUN}" "${ARM}" "${EPOCHS}" "${LAMBDA}" "${CKPT}" 0 1

    echo ""
    echo "==== 训练自检: ${RUN} ===="
    python - "${METRICS_DIR}/${RUN}.jsonl" "${ARM}" "${LAMBDA}" "${ACCUM}" <<'PY'
import json
import sys

path, arm, want_lambda, want_accum = sys.argv[1], sys.argv[2], float(sys.argv[3]), int(sys.argv[4])
rows = [
    json.loads(line)
    for line in open(path, encoding="utf-8").read().splitlines()
    if line.strip()
]
epochs = [row for row in rows if row.get("record_type") == "epoch"]
if not epochs:
    raise SystemExit(f"{path} 里没有 epoch 记录，训练没跑完")

problems = []
last = epochs[-1]
print(f"{'epoch':>6}{'task_loss':>13}{'val_loss':>12}{'R':>13}{'λ·R':>13}{'tok/s':>10}")
for row in epochs:
    print(
        f"{row['epoch']:>6}{row['train_task_loss']:>13.6f}"
        + (f"{row['val_loss']:>12.6f}" if row.get("val_loss") is not None else f"{'-':>12}")
        + (f"{row['train_replay_reg']:>13.4e}" if row.get("train_replay_reg") else f"{'-':>13}")
        + (f"{row['train_lambda_reg']:>13.4e}" if row.get("train_lambda_reg") else f"{'-':>13}")
        + f"{row.get('tokens_per_sec', 0):>10.0f}"
    )

got_lambda = last.get("replay_lambda")
if arm == "onereplay":
    if got_lambda != want_lambda:
        problems.append(f"metrics 里的 replay_lambda={got_lambda} != 传入的 {want_lambda}")
    if not last.get("train_replay_reg"):
        problems.append(
            "train_replay_reg 是 0 或缺失 —— 罚项没有真的在算。"
            "检查 --cov_path 是否被加载（日志里应有 'loaded N covariance matrices'）"
        )
    if not last.get("reference_memory_gb"):
        problems.append(
            "reference_memory_gb 是 0 —— W0 快照没建，全量微调的 ΔW 无从算起。"
            "日志里应有 'full finetune: froze W0 for N layers'"
        )
elif arm == "vanilla":
    if got_lambda:
        problems.append(f"vanilla 臂的 replay_lambda 应当是 0，实际 {got_lambda}")
    if last.get("covariance_memory_gb"):
        problems.append(
            f"vanilla 臂却常驻了 {last['covariance_memory_gb']:.2f} GiB 的 C —— "
            "--measure_replay_when_lambda_zero 0 没生效，这条臂的时间和显存不是 vanilla 的"
        )

print()
if problems:
    for item in problems:
        print(f"!! {item}")
    raise SystemExit("训练自检未通过")
print("训练自检通过。")
PY
  fi
  echo ""
  echo "checkpoint 是完整权重目录，可以直接当下一阶段的基座："
  echo "  --model_dir ${CKPT_DIR} --model_name ${RUN}"
fi
# =============================================================================
# MODE=eval：新任务 (commonsense_qa 八个测试集) 与旧能力 (按 SOURCE 定)
#
# 一次 evaluate 调用只加载模型一次，请求的指标共用。DO_CS / DO_OLD 把两半拆到不同
# 作业，因为加起来装不进一个 24h walltime（新任务侧 1-1.5h，IF 旧能力侧 3-4h，
# 再加 3-5h 训练）。
#
# 全量 checkpoint 直接传 --adapter_path：runner 的 load_eval_model 先用
# is_lora_adapter_dir 判断，没有 adapter_config.json 就把该目录当完整模型加载。
# ARM=anchor 时 --adapter_path 指向 Stage 1 的 checkpoint，评的就是 Stage 3 的起点。
# =============================================================================
if [[ "${MODE}" == "eval" || ( "${MODE}" == "train" && "${DO_EVAL}" == "1" ) ]]; then
  # 两侧分开攒，因为它们要用不同的 --system_prompt（见上面 SYSTEM_PROMPT 那处），而
  # evaluate.py 一次调用只接受一个。DO_CS=1,DO_OLD=0 这种常用拆法下仍然只有一次调用，
  # 只有两侧都开时才会加载模型两次。SOURCE=if 时两侧的 system 恰好同值，但仍然保持
  # 拆分结构：三条 Stage 3 线代码形态一致，而且 metric 列表本来就要分组。
  CS_METRICS=""
  OLD_METRICS=""
  if [[ "${DO_CS}" == "1" ]]; then
    # 前置检查已经拦过缺目录，这里再兜一次。
    if [[ -d "${CS_EVAL_DIR}" ]]; then
      CS_METRICS="commonsense_qa"
    else
      echo "!! 缺常识评测数据目录: ${CS_EVAL_DIR} —— 它是新任务侧的分数，不能跳过。"
      exit 1
    fi
  fi
  if [[ "${DO_OLD}" == "1" ]]; then
    # 旧能力指标由 SOURCE 决定（见上面的 case）。IFEval 和两个数学集要检查输入文件；
    # FollowBench 的数据和判分器完全 vendored，没有可检查的前置文件。
    for _m in ${OLD_METRICS_ALL//,/ }; do
      case "${_m}" in
        ifeval)
          if [[ ! -f "${IFEVAL_INPUT}" ]]; then
            echo "跳过 IFEval：未找到 ${IFEVAL_INPUT}"
            continue
          fi
          ;;
        gsm8k)
          if [[ ! -f "${GSM8K_DATA}" ]]; then
            echo "跳过 GSM8K：未找到 ${GSM8K_DATA}"
            continue
          fi
          ;;
        math500)
          if [[ ! -f "${MATH500_DATA}" ]]; then
            echo "跳过 MATH-500：未找到 ${MATH500_DATA}"
            continue
          fi
          ;;
      esac
      OLD_METRICS="${OLD_METRICS},${_m}"
    done
  fi
  OLD_METRICS="${OLD_METRICS#,}"
  METRICS="${CS_METRICS}${CS_METRICS:+,}${OLD_METRICS}"
  METRICS="${METRICS%,}"
  [[ -n "${METRICS}" ]] || { echo "没有可用指标（DO_CS/DO_OLD 都关了？），评测退出"; exit 1; }

  if [[ "${FB_GROUP_LIMIT}" != "0" ]]; then
    echo "!! FB_GROUP_LIMIT=${FB_GROUP_LIMIT}：FollowBench 冒烟模式，产出的 summary 只覆盖每类前"
    echo "   ${FB_GROUP_LIMIT} 组，不是正式结果。"
  fi
  if [[ "${EVAL_LIMIT}" != "0" ]]; then
    echo "!! EVAL_LIMIT=${EVAL_LIMIT} 截的是 commonsense_qa / ifeval / gsm8k / math500"
    echo "   （commonsense_qa 是**每个 task** 截前 ${EVAL_LIMIT} 行）。截过的分数不是正式结果。"
    if [[ "${METRICS}" == *followbench* ]]; then
      echo "   FollowBench 不读全局 --limit，要截它请用 FB_GROUP_LIMIT（按阶梯组，不能按行 ——"
      echo "   CSL 的分母假设一组完整的 L1..L5）。"
    fi
  fi
  if [[ -n "${CS_EVAL_TASKS}" && "${METRICS}" == *commonsense_qa* ]]; then
    echo "!! CS_EVAL_TASKS=${CS_EVAL_TASKS}：只评这几个子集。AVERAGE 是**宏平均**，子集不同的两个"
    echo "   run 之间那一列不可比，正式结果必须八个全跑。"
  fi

  # 一次 evaluate 调用 = 一侧的指标 + 那一侧的 system prompt。
  run_eval_side () {
    local name="$1" ckpt="$2" side_metrics="$3" side_system="$4"
    [[ -n "${side_metrics}" ]] || return 0
    local -a ckpt_arg=()
    if [[ -n "${ckpt}" ]]; then ckpt_arg=(--adapter_path "${ckpt}"); fi

    # 只有请求的指标**全部**已有结果才跳过，否则拆开跑时第二批会被第一批挡掉。
    local pending=0 m
    for m in ${side_metrics//,/ }; do
      if [[ ! -f "${RESULTS_ROOT}/${m}/${name}/summary.json" ]]; then
        pending=1
      fi
    done
    if [[ "${pending}" == "0" && "${FORCE_EVAL}" != "1" ]]; then
      echo "跳过评测 ${name}：${side_metrics} 都已有 summary（FORCE_EVAL=1 强制重评）"
      return 0
    fi

    local -a fb_data_arg=() fb_cats_arg=()
    if [[ -n "${FB_DATA}" ]]; then fb_data_arg=(--followbench_data "${FB_DATA}"); fi
    if [[ -n "${FB_CATEGORIES}" ]]; then fb_cats_arg=(--followbench_categories "${FB_CATEGORIES}"); fi

    echo "==== eval ${name} (${side_metrics}) ===="
    echo "     system: ${side_system:-<空>}"
    python -m onereplay.scripts.evaluate \
      --model_dir "${MODEL_DIR}" --model_name "${MODEL_NAME}" \
      "${ckpt_arg[@]}" --run_name "${name}" \
      --metrics "${side_metrics}" --out_dir "${RESULTS_ROOT}" --seed "${SEED}" \
      --limit "${EVAL_LIMIT}" \
      --system_prompt "${side_system}" \
      --decode_stop_on_im_end "${STOP_ON_IM_END}" \
      --max_new_tokens "${MAX_NEW_TOKENS}" \
      --eval_batch_size "${EVAL_BATCH}" \
      --cs_eval_dir "${CS_EVAL_DIR}" \
      --cs_eval_tasks "${CS_EVAL_TASKS}" \
      --cs_scoring "${CS_SCORING}" \
      --cs_max_new_tokens "${CS_MAX_NEW_TOKENS}" \
      --cs_batch_size "${CS_BATCH}" \
      --cs_score_batch_size "${CS_SCORE_BATCH}" \
      --gsm8k_data_path "${GSM8K_DATA}" \
      --math500_data_path "${MATH500_DATA}" \
      --math_max_new_tokens "${MATH_MAX_NEW_TOKENS}" \
      --math_batch_size "${MATH_BATCH}" \
      --ifeval_input "${IFEVAL_INPUT}" \
      --followbench_max_new_tokens "${FB_MAX_NEW_TOKENS}" \
      --followbench_batch_size "${FB_BATCH}" \
      --followbench_group_limit "${FB_GROUP_LIMIT}" \
      "${fb_data_arg[@]}" "${fb_cats_arg[@]}" \
      --map_cache_dir "${RESULTS_ROOT}/map_cache/eval_seed${SEED}"
  }

  run_eval () {
    local name="$1" ckpt="$2"
    run_eval_side "${name}" "${ckpt}" "${CS_METRICS}" "${SYSTEM_PROMPT}"
    run_eval_side "${name}" "${ckpt}" "${OLD_METRICS}" "${OLD_SYSTEM_PROMPT}"
  }

  case "${ARM}" in
    anchor)
      # Stage 3 的起点。Stage 1 已经评过它的旧能力指标，但那些结果落在
      # results_part1_* 的树里；重评一次是为了让本线的表自成一体，而且 Stage 1
      # 根本没评过它的 commonsense_qa（IF 线和 math 线都不测常识）。
      # 旧能力那几个分数应当与 Stage 1 逐字相同（同 checkpoint、同 greedy 解码、
      # 同 batch、同生成预算）—— 不同就说明有个口径变了，先查清楚再往下读。
      run_eval "${ANCHOR_RUN}" "${SRC_CKPT}"
      ;;
    *)
      if [[ -d "${CKPT}" ]]; then
        run_eval "${RUN}" "${CKPT}"
      else
        echo "跳过 ${RUN}：checkpoint 不存在（先跑 MODE=train,ARM=${ARM}）"
      fi
      ;;
  esac

  if [[ "${ARM}" == "anchor" ]]; then DIAG_NAME="${ANCHOR_RUN}"; else DIAG_NAME="${RUN}"; fi

  # -------------------------------------------------------------------------
  # 常识侧（新任务）诊断。逐 task 打，因为候选集大小按 task 差很多（boolq 只有
  # true/false，hellaswag 有四个 ending）：
  #
  #   parse_rate  gen 那一路抽到 label 的比例 = 那个输出模板学会了没有。
  #               **anchor 这一列接近 0 是预期的** —— Stage 1 的模型从没见过
  #               "the correct answer is <label>"，它会写一段自然语言解释。
  #   agree       logprob 与 gen 给出同一个 label 的比例。
  #   mode share  预测众数占比。接近 1 = 塌成单一 label，模型在猜不在答，这种模型的
  #               acc 会停在 random_baseline 附近而不是 0。
  #   hit-cap     撞 CS_MAX_NEW_TOKENS 的行。训练后的模型只需 7-8 个 token，撞上限
  #               说明它还在按旧能力的习惯滔滔不绝（新格式没学到位）。
  # -------------------------------------------------------------------------
  if [[ "${DIAG_LEN}" == "1" && "${DO_CS}" == "1" ]]; then
    DIAG_FILE="${RESULTS_ROOT}/commonsense_qa/${DIAG_NAME}/responses.jsonl"
    if [[ -f "${DIAG_FILE}" ]]; then
      python - "${MODEL_DIR}/${MODEL_NAME}" "${CS_MAX_NEW_TOKENS}" "${DIAG_FILE}" <<'PY'
import collections
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

model_path, cap, path = sys.argv[1], int(sys.argv[2]), Path(sys.argv[3])
tokenizer = AutoTokenizer.from_pretrained(model_path, trust_remote_code=True)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


by_task: dict[str, list[dict]] = collections.defaultdict(list)
with path.open(encoding="utf-8") as handle:
    for line in handle:
        if line.strip():
            row = json.loads(line)
            by_task[str(row.get("task", "?"))].append(row)

print(f"==== commonsense 生成侧诊断 (cap={cap})  {path.parent.name} ====")
print(
    f"{'task':<16}{'n':>6}{'parse':>8}{'agree':>8}{'mode':>8}"
    f"{'mode_lbl':>11}{'hit-cap':>9}{'tokP50':>8}{'tokP90':>8}{'max':>6}"
)
for task in sorted(by_task):
    rows = by_task[task]
    total = len(rows)
    # gen 那一路关掉时 responses.jsonl 里没有 response/gen_pred 字段，这几列打 '-'。
    has_gen = "gen_pred" in rows[0]
    has_logprob = "logprob_pred" in rows[0]

    if has_gen:
        lengths = sorted(
            len(tokenizer(str(row.get("response", "")), add_special_tokens=False)["input_ids"])
            for row in rows
        )
        parsed = sum(1 for row in rows if row.get("gen_pred"))
        hit_cap = sum(1 for length in lengths if length >= cap - 2)
        parse_cell = f"{parsed / total:.3f}".rjust(8)
        cap_cell = f"{hit_cap / total:.1%}".rjust(9)
        len_cells = f"{pct(lengths, 50):>8}{pct(lengths, 90):>8}{lengths[-1]:>6}"
    else:
        parse_cell, cap_cell = "-".rjust(8), "-".rjust(9)
        len_cells = f"{'-':>8}{'-':>8}{'-':>6}"

    if has_gen and has_logprob:
        both = [row for row in rows if row.get("gen_pred")]
        agree = sum(1 for row in both if row["gen_pred"] == row["logprob_pred"])
        agree_cell = (f"{agree / len(both):.3f}" if both else "-").rjust(8)
    else:
        agree_cell = "-".rjust(8)

    # 众数按闭集排序的预测算（logprob 没跑就退回 gen）。
    key = "logprob_pred" if has_logprob else ("gen_pred" if has_gen else None)
    if key:
        counts = collections.Counter(str(row.get(key, "")) for row in rows)
        label, count = counts.most_common(1)[0]
        mode_cell = f"{count / total:.3f}".rjust(8)
        mode_label = (label or "<empty>")[:10].rjust(11)
    else:
        mode_cell, mode_label = "-".rjust(8), "-".rjust(11)

    print(f"{task:<16}{total:>6}{parse_cell}{agree_cell}{mode_cell}{mode_label}{cap_cell}{len_cells}")

print()
print("怎么读（常识在本线是**新任务**，不是保留侧）:")
print("  parse 低 + hit-cap 高 => 新格式还没学到位，模型仍按旧能力的习惯写长回答。")
print("    **anchor 这一行本来就该是这样**（它没见过那个模板），不是 bug。")
print("  mode 接近 1 => 预测塌成单一 label（mode_lbl 那一列就是它）。这种模型的 acc 会停在")
print("    random_baseline 附近而不是 0，只看 acc 会把「塌了」读成「学到了一半」。")
print("  agree 明显低于 1 => 两个 scorer 分道扬镳，生成路径还没对齐到闭集答案上。")
PY
    fi
  fi

  # -------------------------------------------------------------------------
  # SOURCE=math 的旧能力侧长度/截断诊断：数学分数只有配着 hit-cap 才能读。
  # hit-cap 接近 0 且 P99 明显低于 cap => 预算够用，accuracy 是能力；hit-cap 还高
  # => 分数被右删失，而删失率随输出长度变、各臂的输出长度又不同，于是臂间不可比。
  # 本线尤其危险：新任务把输出压到 7-8 token，这个方向会让更多数学响应"逃出截断"，
  # 数学分因此上升，很容易被读成「该方法保住了数学能力」。
  # -------------------------------------------------------------------------
  if [[ "${DIAG_LEN}" == "1" && "${DO_OLD}" == "1" && "${SOURCE}" == "math" ]]; then
    DIAG_FILES=()
    for diag_metric in gsm8k math500; do
      diag_file="${RESULTS_ROOT}/${diag_metric}/${DIAG_NAME}/responses.jsonl"
      [[ -f "${diag_file}" ]] && DIAG_FILES+=("${diag_file}")
    done
    if [[ ${#DIAG_FILES[@]} -gt 0 ]]; then
      python - "${MODEL_DIR}/${MODEL_NAME}" "${MATH_MAX_NEW_TOKENS}" "${DIAG_FILES[@]}" <<'PY'
import json
import sys
from pathlib import Path

from transformers import AutoTokenizer

model_path, cap = sys.argv[1], int(sys.argv[2])
tokenizer = AutoTokenizer.from_pretrained(model_path, trust_remote_code=True)


def pct(values, q):
    return values[min(len(values) - 1, int(round(q / 100 * (len(values) - 1))))]


print(f"==== response length / truncation diagnostic (cap={cap}) ====")
for path in sys.argv[3:]:
    file = Path(path)
    if not file.is_file():
        continue
    rows = [json.loads(line) for line in file.open(encoding="utf-8") if line.strip()]
    if not rows:
        continue
    lengths = sorted(
        len(tokenizer(row.get("response", ""), add_special_tokens=False)["input_ids"])
        for row in rows
    )
    missing = sum(row.get("prediction") in (None, "") for row in rows)
    hit_cap = sum(length >= cap - 8 for length in lengths)
    label = f"{file.parent.parent.name}/{file.parent.name}"
    print(
        f"{label:>48}: n={len(rows)} "
        f"no-answer={missing} ({missing / len(rows):.1%}) "
        f"hit-cap={hit_cap} ({hit_cap / len(rows):.1%}) "
        f"P50={pct(lengths, 50)} P90={pct(lengths, 90)} P99={pct(lengths, 99)} max={lengths[-1]}"
    )
print("hit-cap 接近 0 且 P99 明显低于 cap => 预算够用。hit-cap 仍高时**先判断是不是重复")
print("循环**（撞上限那些行的尾部 distinct-shingle 低到约 0.1 就是）—— 那种情况加 cap 没用，")
print("91 号实测 4096->8192 一分没涨。确认是真写不完再提 cap，且**所有臂一起重评**。")
print("no-answer 高而 hit-cap 低 => 模型没写 \\boxed{}，先确认 system prompt 是 91 号那条。")
PY
    fi
  fi

  # -------------------------------------------------------------------------
  # 汇总：三张表。
  #
  # 第一张是主表：左半新任务（常识，学到多少），右半旧能力保留（本线主指标）。
  # **每个生成式分数右边紧跟它自己的响应词数中位数** —— 新任务会把输出压到 7-8 个
  # token，而 IFEval/FollowBench 里不少约束本质在量长度（Part 1 第 8c 节）、数学侧
  # 的删失率也随长度变，分数和 words 分开看就会把长度塌缩读成别的东西。
  # CS logp 是唯一不需要配 words 读的数（闭集排序、不解码）。
  #
  # 第二张是常识八个子任务的 acc_logprob 分解（新任务学得均不均匀）。
  # 第三张是 FollowBench 的分级曲线（旧能力在第几级开始塌），只有 SOURCE=if 才有。
  #
  # words 用 len(response.split()) 从各自的 responses.jsonl 现算，与 followbench 的
  # response_shape 同一个定义，所以 fb 那列和它 summary.json 里的 response_words_p50 一致。
  # -------------------------------------------------------------------------
  python - "${RESULTS_ROOT}" "${SOURCE}" "${OLD_METRICS_ALL}" "${ANCHOR_RUN}" <<'PY' || true
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
source = sys.argv[2]
old_metrics = [item for item in sys.argv[3].split(",") if item]
anchor_run = sys.argv[4]
METRICS = ["commonsense_qa"] + old_metrics

names: set[str] = set()
for metric in METRICS:
    directory = root / metric
    if directory.is_dir():
        names.update(path.name for path in directory.iterdir() if path.is_dir())
if not names:
    print("\n没有可汇总的 summary.json")
    raise SystemExit(0)


def sort_key(name: str):
    # anchor 在最上面（它是 before 那一行），然后 vanilla，然后 onereplay/ewc 按 λ 排。
    rank = 0 if name == anchor_run else (1 if "vanilla" in name else 2)
    return (rank, name)


order = sorted(names, key=sort_key)


def load(metric: str, name: str):
    path = root / metric / name / "summary.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else None


def words_p50(metric: str, name: str):
    path = root / metric / name / "responses.jsonl"
    if not path.is_file():
        return None
    counts = []
    with path.open(encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                counts.append(len(str(json.loads(line).get("response", "")).split()))
    if not counts:
        return None
    counts.sort()
    return counts[len(counts) // 2]


def pct(payload, key, width):
    if payload is None or payload.get(key) is None:
        return "-".rjust(width)
    return f"{payload[key] * 100:.1f}".rjust(width)


def num(value, width, fmt="{:.0f}"):
    return ("-" if value is None else fmt.format(value)).rjust(width)


print()
print("=" * 116)
print(f"Stage 3: Model-{source.upper()} --Commonsense170k--> Model-{source.upper()}-CS")
print("  左半 = 新任务学到多少(常识)   右半 = 旧能力保留多少(主指标)")
print("  words = 该指标自己的响应词数中位数。CS 那几列是八任务宏平均；")
print("  CS logp 是闭集排序（不受长度影响），CS gen 只能配着 parse 读，rand 是塌缩后的地板。")
print("=" * 116)

if source == "if":
    header = (
        f"{'run':<40}{'CS logp':>9}{'CS gen':>8}{'parse':>7}{'rand':>7}"
        f"{'IFEval':>8}{'words':>7}{'FB HSR':>8}{'words':>7}"
    )
else:
    header = (
        f"{'run':<40}{'CS logp':>9}{'CS gen':>8}{'parse':>7}{'rand':>7}"
        f"{'GSM8K':>8}{'words':>7}{'MATH500':>9}{'words':>7}"
    )
print(header)
for name in order:
    cs = load("commonsense_qa", name)
    row = (
        f"{name:<40}"
        + pct(cs, "average_acc_logprob", 9)
        + pct(cs, "average_acc_gen", 8)
        + pct(cs, "average_parse_rate", 7)
        + pct(cs, "average_random_baseline", 7)
    )
    if source == "if":
        ifeval = load("ifeval", name)
        fb = load("followbench", name)
        levels = [fb.get(f"rule_hsr_level_{level}") for level in range(1, 6)] if fb else []
        levels = [value for value in levels if value is not None]
        fb_mean = f"{sum(levels) / len(levels) * 100:.1f}".rjust(8) if levels else "-".rjust(8)
        row += (
            pct(ifeval, "strict_prompt_accuracy", 8)
            + num(words_p50("ifeval", name), 7)
            + fb_mean
            + num(words_p50("followbench", name), 7)
        )
    else:
        row += (
            pct(load("gsm8k", name), "accuracy", 8)
            + num(words_p50("gsm8k", name), 7)
            + pct(load("math500", name), "accuracy", 9)
            + num(words_p50("math500", name), 7)
        )
    print(row)

# 新任务学得均不均匀：宏平均会把「某一个子任务没学会」摊平。
cs_rows = [(name, load("commonsense_qa", name)) for name in order]
cs_rows = [(name, payload) for name, payload in cs_rows if payload]
if cs_rows:
    tasks = sorted({task for _, payload in cs_rows for task in payload.get("tasks", [])})
    print()
    print("=" * 116)
    print("常识八子集的 acc_logprob 分解（%，最后一列是宏平均，就是主表的 CS logp）")
    print("=" * 116)
    task_header = "".join(task[:9].rjust(10) for task in tasks)
    print(f"{'run':<34}{task_header}{'AVG':>9}")
    for name, payload in cs_rows:
        cells = "".join(
            pct(payload.get("per_task", {}).get(task), "acc_logprob", 10) for task in tasks
        )
        print(f"{name:<34}{cells}" + pct(payload, "average_acc_logprob", 9))
    missing = {
        name: payload["tasks_missing"]
        for name, payload in cs_rows
        if payload.get("tasks_missing")
    }
    if missing:
        print()
        print(f"!! 有 run 少评了子集: {missing}")
        print("   AVERAGE 是宏平均，子集不同的两行之间那一列不可比。补齐后重看。")

print()
print("怎么读:")
print(f"  遗忘量  = {anchor_run} 的旧能力分 − 该臂的旧能力分")
print("  保护效果 = onereplay 的旧能力分 − vanilla 的旧能力分")
print("  代价    = vanilla 的 CS logp − onereplay 的 CS logp（保护换来的可塑性损失）")
print("  三个数要一起看：只报第二个而不报第三个，等于用「少学新任务」冒充「保住旧能力」。")
print()
print("**第一件要确认的事是 vanilla 的旧能力分到底掉了多少。** 本线预期掉得多：新任务的")
print("监督只有 7-8 个 token、输出形态极窄，会把模型整体压短。掉得够多，后面各臂的比较")
print("才有分辨力；如果 vanilla 已经接近 anchor，这条线就区分不出保护方法（102 号那个")
print("方向就是这样），结论要写成「该方向不构成遗忘压力」而不是「三个方法都有效」。")
print()
print("**分数升降先看 words 再谈能力。** 输出长度会被新任务往变短的方向压。words 塌到")
print("个位数而旧能力分还在，说明那些题本来就不需要长输出；两个一起掉时要说清楚")
print("「不会做了」和「已经写不长」是两件事（见 results_log/2026-09-12 第 8c 节）。")
print()
print("**CS 那几列是新任务侧，不是保留侧。** parse 低说明那个输出模板没学会（anchor")
print("本来就该低）；rand 是地板不是零 —— 候选集只有 2-5 个，塌成单一 label 也能拿到约 35%。")
if source == "math":
    print()
    print("**数学分数必须配着上面那张 length diagnostic 的 hit-cap 读。** 删失率随输出长度变，")
    print("而本线的新任务正在把输出压短 —— 任何「逃出截断」都会把数学分推上去。")
else:
    print()
    print("**FB HSR 不是 FollowBench 全量分数**：只有 rule 那一半（350/820 行、70/164 组），")
    print("style 类覆盖为 0，format 类只覆盖 2/30，example 类还有 2 组是退化的。judge 那")
    print("470 行要在有网的地方过 judge_followbench.py 才能补齐 164 组（见 92 号文件头）。")

# FollowBench 的价值在分级曲线而不是单值：它报的是模型在第几级开始塌。
fb_rows = [(name, load("followbench", name)) for name in order]
fb_rows = [(name, payload) for name, payload in fb_rows if payload]
if fb_rows:
    print()
    print("=" * 108)
    print("FollowBench rule 侧分级曲线（HSR %，CSL 是 0-5 的级数）")
    print("=" * 108)
    print(f"{'run':<40}{'L1':>7}{'L2':>7}{'L3':>7}{'L4':>7}{'L5':>7}{'CSL':>8}{'empty':>7}")
    for name, payload in fb_rows:
        cells = "".join(pct(payload, f"rule_hsr_level_{level}", 7) for level in range(1, 6))
        print(
            f"{name:<40}{cells}"
            + num(payload.get("rule_csl"), 8, "{:.2f}")
            + num(payload.get("response_empty"), 7)
        )
PY
fi

echo ""
echo "========================================================================"
echo "产物:"
echo "  checkpoint : ${CKPT}"
echo "  metrics    : ${METRICS_DIR}/${RUN}.jsonl"
echo "  评测       : ${RESULTS_ROOT}/{commonsense_qa,${OLD_METRICS_ALL}}/<run>/summary.json"
echo "  逐行输出   : ${RESULTS_ROOT}/commonsense_qa/<run>/responses.jsonl  (诊断表读的就是它)"
echo "  汇总 csv   : ${RESULTS_ROOT}/<metric>_summary.csv"
echo "               commonsense_qa 那份是**每 run 每 task 一行 + AVERAGE 行**，不是一行一 run"
echo ""
echo "完整的一轮需要这几个 run，缺任何一个结论都不成立:"
echo "  ${ANCHOR_RUN}                                    Stage 3 的起点（before）"
echo "  s3_cs_vanilla_lr${LR}_seed${SEED}                 无保护（遗忘的标尺）"
echo "  s3_cs_onereplay_lr${LR}_lam${LAMBDA}_seed${SEED}  C_${SOURCE} 保护"
echo "  s3_cs_ewc_lr${LR}_lam<λ_ewc>_seed${SEED}          F_${SOURCE} 保护（λ 与 onereplay 不可比）"
if [[ "${SOURCE}" == "if" ]]; then
echo ""
echo "FollowBench 的 judge 那半边（470 行，要在有网的地方跑）:"
echo "  python -m onereplay.scripts.judge_followbench \\"
echo "    --input ${RESULTS_ROOT}/followbench/${RUN}/judge_inputs.jsonl \\"
echo "    --output ${RESULTS_ROOT}/followbench/${RUN}/judge_outputs.jsonl --api_key ..."
fi
echo "Job finished at: $(date)"
