#!/bin/bash
#PBS -P CFP03-SF-101
#PBS -N kres_smoke
#PBS -j oe
#PBS -k oed
#PBS -q autox
#PBS -l select=1:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o /scratch/weiliu87/student/czq/con-pretrain/logs
#
# =============================================================================
# CPT Stage 2 冒烟：在真基座 + 真 C 上跑几十步，把三个还没定的数一次量出来
#
#   1) micro_batch 定 16 还是 8。probe_batch_sizing.py 估的是 80 GB / 45 GB，误差
#      ±40%，所以必须实测显存峰值。global_batch 固定 512，grad_accum 跟着变（32 / 64）。
#   2) clip 触发率。--kres.inject_before_clip 这个选择只有在裁剪真的触发时才有意义；
#      触发率是 0 的话注入点放哪边完全等价，那条讨论就可以从论文里删掉。
#   3) λ 的量级。惩罚梯度在 λ=1 时的范数 |g_reg| 与 |g_lm| 的比值直接给出 λ 的标定：
#      要让惩罚占 LM 梯度的 ρ，就取 λ = ρ·|g_lm|/|g_reg|。见文末的 caveat。
#
# 顺带把两件一直没验的事做掉：混合 dataloader 在真 chunk 上跑通（此前全是合成数据），
# 以及 --resume 带着正则器能不能接上（W₀ 必须来自基座文件而不是漂移后的权重）。
#
# -----------------------------------------------------------------------------
# 语料的选择只影响 λ 那一项
#
#   要量的三个数里，显存和吞吐与语料无关；|g_lm| 和 clip 触发率轻微相关；只有 λ 的
#   标定强相关。所以 DATA_DIR 默认指新域 Biomed 的 train。若它还没就位，可以退回
#   seg00（FineWeb-Edu）先把前两项量出来，但那时 λ 只当量级参考——在基座见过的分布
#   上训，ΔW 比在新域上小得多，据此反算的 λ 会偏大。汇总会检测并标注这种情况。
#
#   产出的 checkpoint 是垃圾，跑完就删。这不是一次训练。
#
# -----------------------------------------------------------------------------
# !! --train.max_steps 不生效
#   这份 fit() 的循环只看由 max_tokens 推出的 max_iters。限制步数只能设
#   max_tokens = 步数 × global_batch_size × seq_len。本脚本按 STEPS 自己算，
#   同时把这个数写进临时 plan 的 train_max_tokens（pretrain.py 会核对两者一致）。
#
# !! 临时 plan
#   正式的 replay_plan.json 要三段齐了才能生成，而冒烟只有 seg00。所以脚本自己在
#   JOB_TMPDIR 里造一份只描述本次冒烟的 plan。它**不能**被后续正式训练使用，跑完
#   随 JOB_TMPDIR 一起删掉。
#
# -----------------------------------------------------------------------------
# 用法
#
#   qsub -v PREFLIGHT_ONLY=1 con-pretrain/pbs/02_smoke_pretrain.pbs
#       只做前置检查，不上 GPU。第一次先跑这个。
#
#   qsub con-pretrain/pbs/02_smoke_pretrain.pbs
#       完整冒烟：4 个 run（micro_batch 16/8 × 有无正则）+ 1 个续跑验证，约 40 分钟。
#
#   qsub -v MICRO_BATCHES="16" ...     只测一个档位
#   qsub -v STEPS=100 ...              跑更长（λ 的标定会更准，因为漂移更大）
#   qsub -v DATA_DIR=.../fineweb_edu/seg00 ...  新域还没就位时的退路
#   qsub -v DO_RESUME=0 ...            跳过续跑验证
#
# 前置条件
#   1) model/<基座>/{lit_model.pth,model_config.yaml} 就位
#   2) data/chunks/biomed/{train,val}/index.json 就位
#   3) cov/seg00.pt 就位（01_collect_cov_fineweb.pbs 的产物）
#   4) litgpt-src 已更新到 fork 的 open-sci-cpt 分支最新提交并 pip install -e
#      （preflight 会拿脚本自己的参数表对一遍，版本偏旧直接报错）
# =============================================================================

set -euo pipefail

# ---- 集群侧固定路径（要换位置改这里）----
REPO_ROOT="${REPO_ROOT:-/scratch/weiliu87/student/czq/con-pretrain}"
VENV="${VENV:-${REPO_ROOT}/.venv}"
CACHE_ROOT="${CACHE_ROOT:-/scratch/weiliu87/cache/huggingface}"
SELF_PATH="${SELF_PATH:-${REPO_ROOT}/pbs/02_smoke_pretrain.pbs}"
IMAGE="${IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif}"

JOBTAG="${PBS_JOBID:-local$$}"
SCRATCH_USER="${SCRATCH_USER:-weiliu87}"
# 原来只在 /local_ssd/$USER 已存在时才用它，而那个目录一般要自己建，于是永远走
# /scratch 那条分支。/scratch 是并行文件系统，删一个还开着的文件不会真删，只留个
# .__dpc 占位——日志里那一堆 "Device or resource busy: '.__dpc...'" 就是
# multiprocessing 的临时目录终结器撞上这个。改成先试着建，建得出来就用本地盘。
if mkdir -p "/local_ssd/${SCRATCH_USER}" 2>/dev/null; then
  JOB_TMPDIR="${JOB_TMPDIR:-/local_ssd/${SCRATCH_USER}/tmp_kres_${JOBTAG}}"
  EXTRA_BIND="-B /local_ssd:/local_ssd"
else
  JOB_TMPDIR="${JOB_TMPDIR:-/scratch/${SCRATCH_USER}/cache/tmp_kres_${JOBTAG}}"
  EXTRA_BIND=""
fi

# =============================================================================
# 外层：裸计算节点。只负责起容器，然后把这个脚本本身在容器里再跑一遍。
# =============================================================================
if [[ "${KRES_IN_CONTAINER:-0}" != "1" ]]; then
  echo "Job started at: $(date)"
  echo "Running on node: $(hostname)"
  echo "Job ID: ${PBS_JOBID:-local}"
  cd "${PBS_O_WORKDIR:-${REPO_ROOT}}"

  [[ -f "${SELF_PATH}" ]] || { echo "找不到脚本自身: ${SELF_PATH}（改 SELF_PATH 或 REPO_ROOT）"; exit 1; }
  [[ -f "${IMAGE}" ]] || { echo "找不到容器镜像: ${IMAGE}"; exit 1; }

  mkdir -p "${JOB_TMPDIR}"
  cleanup () {
    if [[ -n "${JOB_TMPDIR}" && "${JOB_TMPDIR}" == */tmp_kres_* ]]; then
      rm -rf --one-file-system "${JOB_TMPDIR}" || true
      echo "cleanup: removed ${JOB_TMPDIR}"
    fi
  }
  trap cleanup EXIT INT TERM

  if ! command -v module >/dev/null 2>&1; then
    for _init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash /etc/profile.d/lmod.sh; do
      [[ -f "${_init}" ]] && source "${_init}" && break
    done
  fi
  module load singularity

  FORWARD_VARS=(
    REPO_ROOT VENV CACHE_ROOT JOB_TMPDIR SELF_PATH
    MODEL_DIR DATA_DIR VAL_DIR COV_PATH OUT_ROOT LOG_DIR
    STEPS MICRO_BATCHES GLOBAL_BATCH SEQ_LEN PEAK_LR MIN_LR WARMUP_STEPS
    WEIGHT_DECAY BETAS OPTIMIZER_JSON
    LAMBDA_PROBE NUM_WORKERS SEED PREFLIGHT_ONLY DO_RESUME DO_BASELINE
    PBS_JOBID
  )
  for _v in "${FORWARD_VARS[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
      export "SINGULARITYENV_${_v}=${!_v}"
      export "APPTAINERENV_${_v}=${!_v}"
    fi
  done
  export SINGULARITYENV_KRES_IN_CONTAINER=1
  export APPTAINERENV_KRES_IN_CONTAINER=1

  SINGULARITY_FLAGS="${SINGULARITY_FLAGS:--e -B /scratch:/scratch ${EXTRA_BIND}}"
  echo "Image           : ${IMAGE}"
  echo "Job TMPDIR      : ${JOB_TMPDIR}"
  # shellcheck disable=SC2086
  singularity exec ${SINGULARITY_FLAGS} "${IMAGE}" bash "${SELF_PATH}"
  echo "Job finished at: $(date)"
  exit 0
fi

# =============================================================================
# 内层：容器里
# =============================================================================
source "${VENV}/bin/activate"

export HF_HOME="${CACHE_ROOT}"
export XDG_CACHE_HOME="${CACHE_ROOT}"
export TORCH_HOME="${CACHE_ROOT}/torch"
export TMPDIR="${JOB_TMPDIR}"
mkdir -p "${HF_HOME}" "${TORCH_HOME}" "${TMPDIR}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
export USER="${USER:-$(whoami)}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

# ---- 可调项（qsub -v 不生效时直接改这里）----
MODEL_DIR="${MODEL_DIR:-${REPO_ROOT}/model/open-sci-ref-v0.02-0.4b-fineweb-edu-1.4t-300B-4096}"
# 默认就用新域（Biomed）的 train/val：λ 的标定强依赖语料，见文件头那段
DATA_DIR="${DATA_DIR:-${REPO_ROOT}/data/chunks/biomed/train}"
VAL_DIR="${VAL_DIR:-${REPO_ROOT}/data/chunks/biomed/val}"
COV_PATH="${COV_PATH:-${REPO_ROOT}/cov/seg00.pt}"
OUT_ROOT="${OUT_ROOT:-${JOB_TMPDIR}/smoke_out}"

STEPS="${STEPS:-60}"                    # optimizer step 数。PhaseTimer 前 20 步算 warmup
MICRO_BATCHES="${MICRO_BATCHES:-16 8}"
GLOBAL_BATCH="${GLOBAL_BATCH:-512}"
SEQ_LEN="${SEQ_LEN:-4096}"
PEAK_LR="${PEAK_LR:-3e-4}"
MIN_LR="${MIN_LR:-3e-5}"
WEIGHT_DECAY="${WEIGHT_DECAY:-0.1}"
BETAS="${BETAS:-0.9, 0.95}"
# 5 而不是正式的 2000：冒烟要在 peak LR 上测梯度范数和裁剪触发率。warmup 里 LR 接近 0，
# 权重几乎不动，ΔW≈0 于是惩罚梯度也≈0，三个数一个都量不到
WARMUP_STEPS="${WARMUP_STEPS:-5}"
# 用 λ=1 探针而不是某个猜的值：accumulate_grad 的 scale 是 λ/N，所以 λ=1 时报出来的
# |g_reg| 就是未缩放的 ‖dR/dW‖/N，任何目标比例都能由它直接反算
LAMBDA_PROBE="${LAMBDA_PROBE:-1.0}"
# 1 而不是 2：实测 fwd_bwd 占一个 optimizer step 的 98.2%，取数根本不是瓶颈，第二个
# worker 换不来吞吐。而它是要花代价的——MixedReplayLoader 给**每条流**各建一个
# StreamingDataLoader，8B replay 臂有 4 条流，in-flight 的共享内存张量数是
# 流数 × num_workers × prefetch_factor，2 个 worker 就是 16 份。603854 那次
# mb8_reg 正是被 "Too many open files in system" 打死的。
NUM_WORKERS="${NUM_WORKERS:-1}"
SEED="${SEED:-42}"
PREFLIGHT_ONLY="${PREFLIGHT_ONLY:-0}"
DO_RESUME="${DO_RESUME:-1}"
DO_BASELINE="${DO_BASELINE:-1}"

# optimizer 必须整个当 JSON 传，**不能**写成 --optimizer.class_path + --optimizer.init_args.lr。
# setup() 里 optimizer 的类型标注是 `str | dict`，是个无结构的 Dict，jsonargparse 于是
# 把点分子键拍平：--optimizer.init_args.lr 3e-4 变成 {"class_path": ..., "lr": "3e-4"}，
# init_args 这一层根本不存在，而 instantiate_torch_optimizer 的 dict 分支硬取
# optimizer["init_args"] -> KeyError: 'init_args'。顺带一提拍平后 lr 还成了**字符串**，
# 就算那一层在也会把 '3e-4' 喂给 AdamW。JSON 形式两个毛病都没有（已用 --print_config 验过）。
OPTIMIZER_JSON="${OPTIMIZER_JSON:-{\"class_path\": \"torch.optim.AdamW\", \"init_args\": {\"lr\": ${PEAK_LR}, \"weight_decay\": ${WEIGHT_DECAY}, \"betas\": [${BETAS}]}}}"

MAX_TOKENS=$(( STEPS * GLOBAL_BATCH * SEQ_LEN ))
SMOKE_PLAN="${JOB_TMPDIR}/smoke_plan.json"
# 日志**不能**放 JOB_TMPDIR：那个目录在 cleanup trap 里被删，作业一结束就没了，
# 而要查的恰恰是失败的那次。第一版就是这么写的，结果四个 run 全挂却无从查起
LOG_DIR="${LOG_DIR:-${REPO_ROOT}/logs/smoke_${JOBTAG}}"
mkdir -p "${LOG_DIR}" "${OUT_ROOT}"

cd "${REPO_ROOT}"

echo "========================================================================"
echo "MODEL_DIR = ${MODEL_DIR}"
echo "DATA_DIR  = ${DATA_DIR}"
echo "COV_PATH  = ${COV_PATH}"
echo "STEPS=${STEPS} global_batch=${GLOBAL_BATCH} seq_len=${SEQ_LEN} -> max_tokens=${MAX_TOKENS}"
echo "micro_batch 候选: ${MICRO_BATCHES}   peak_lr=${PEAK_LR} min_lr=${MIN_LR} warmup=${WARMUP_STEPS}"
echo "========================================================================"
echo "Python : $(which python)"
python --version
nvidia-smi --query-gpu=name,memory.total --format=csv

# 文件句柄的余量。603854 那次 mb8_reg 死在 "Too many open files in system (23)"——
# errno 23 是 ENFILE，即**全系统**的 file table 满了，不是本进程的 ulimit（那是 EMFILE=24）。
# 节点是共享的，所以耗尽的可能是邻居也可能是我们自己；不打这几个数就永远只能猜。
# fd_report 在每个 run 前后各调一次，看它是不是随 run 单调涨——涨就是我们在漏。
ulimit -n "$(ulimit -Hn)" 2>/dev/null || true
fd_report () {
  # file-nr 三列：已分配、已分配但空闲、上限
  local nr; nr="$(cat /proc/sys/fs/file-nr 2>/dev/null || echo '? ? ?')"
  local shm; shm="$(ls /dev/shm 2>/dev/null | wc -l)"
  local mine; mine="$(ls /proc/self/fd 2>/dev/null | wc -l)"
  echo "fd: 系统 file-nr=[${nr}]  /dev/shm 条目=${shm}  本进程 fd=${mine}  ulimit -n=$(ulimit -n)"
}
fd_report

# ===========================================================================
# Step 0: Preflight（纯 CPU）
# ===========================================================================
echo ""
echo "==== Step 0: preflight ===="

if [[ -e "${REPO_ROOT}/litgpt" ]]; then
  echo "FAILED: ${REPO_ROOT}/litgpt 存在，会遮蔽已安装的 litgpt 包。删掉或改名 litgpt-src。"
  exit 1
fi
[[ -f "${MODEL_DIR}/model_config.yaml" ]] || { echo "缺 ${MODEL_DIR}/model_config.yaml"; exit 1; }
[[ -f "${MODEL_DIR}/lit_model.pth" ]]     || { echo "缺 ${MODEL_DIR}/lit_model.pth（HF→litgpt 转换没做）"; exit 1; }
[[ -f "${DATA_DIR}/index.json" ]]         || { echo "缺 ${DATA_DIR}/index.json（chunk 没生成）"; exit 1; }
[[ -f "${VAL_DIR}/index.json" ]]          || { echo "缺 ${VAL_DIR}/index.json"; exit 1; }
[[ -f "${COV_PATH}" ]]                    || { echo "缺 ${COV_PATH}（先跑 01_collect_cov_fineweb.pbs）"; exit 1; }

# 把「跑到一半才发现」的失败全部前移：装的 litgpt 够不够新、认不认这个基座、CLI 解不
# 解析得了自定义 data module（--data 走 jsonargparse 的子类解析，路径写错只会在启动时
# 报，但那时容器已经起了、GPU 也占了）、C 的目标层数与模型对不对得上。
python - "${MODEL_DIR}" "${COV_PATH}" "${SELF_PATH}" <<'PY'
import re
import sys
from pathlib import Path

import torch

import litgpt
from litgpt.config import Config

model_dir, cov_path, self_path = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
print(f"python  {sys.version.split()[0]}")
print(f"litgpt  {litgpt.__file__}")
print(f"torch   {torch.__version__}  cuda={torch.cuda.is_available()}")

# 装的 litgpt 比本脚本旧，是这套流程最容易犯也最难查的错：litgpt 源码不在 con-pretrain
# 里（目录同名会遮蔽 python 包），它单独躺在 litgpt-src、从 fork 的 open-sci-cpt 分支
# 拉。本地改完忘了推、或集群忘了 pull，脚本传的新参数就会被 jsonargparse 拒掉——报的是
# 一屏 usage 加一句 "Unrecognized arguments"，而 usage 里恰好**不**列缺的那个参数，
# 看起来像脚本写错了参数名。四个 run 会各自这么挂一次。
#
# 检查方式是从脚本自己的命令行里把 --train.* / --kres.* 抠出来，对着**已装**的
# dataclass 比。这样加新参数不用同步改检查。本地那份 check_smoke_pbs.py 做的是同一件
# 事，但它 import 的是开发工作区的 litgpt，正好照不到版本偏差这一维。
script = "\n".join(
    ln for ln in self_path.read_text(encoding="utf-8").splitlines() if not ln.lstrip().startswith("#")
)
from litgpt.args import KresArgs, TrainArgs

missing = []
for prefix, cls in (("--train.", TrainArgs), ("--kres.", KresArgs)):
    for name in sorted(set(re.findall(rf"{re.escape(prefix)}(\w+)", script))):
        if name not in cls.__dataclass_fields__:
            missing.append(f"{prefix}{name}（{cls.__name__} 里没有）")
if missing:
    raise SystemExit(
        "装的 litgpt 缺这些参数，比本脚本旧：\n  " + "\n  ".join(missing) + "\n\n"
        "去 litgpt-src 更新到 fork 的 open-sci-cpt 最新提交：\n"
        "  cd <litgpt-src> && git pull\n"
        "（pip install -e 装的是软链，拉完不用重装。分支没接上就先 git remote -v 看清 fork "
        "的别名叫什么——别名是每个克隆私有的，别照抄。若是本地根本没推上去，先在本地 litgpt "
        "工作区提交并 push。）"
    )
print(f"args    --train.* / --kres.* 全部存在于已装的 litgpt")
if not torch.cuda.is_available():
    raise SystemExit("CUDA 不可用，先查 -l select=1:ngpus=1 有没有生效")

cfg = Config.from_file(model_dir / "model_config.yaml")
try:
    Config.from_name(cfg.name)
except ValueError:
    raise SystemExit(f"litgpt 注册表里没有 {cfg.name!r}，装的是未打补丁的上游 litgpt")
print(f"config  name={cfg.name} n_layer={cfg.n_layer} n_embd={cfg.n_embd}")

# 自定义 data module 必须能被 import 到——CLI 用的是同一个点分路径
from kres.replay_data import ReplayMixedData  # noqa: F401
print("data    kres.replay_data.ReplayMixedData 可导入")

# C 的键集与本模型的目标层清单双向比对。这一步等于把 build_regularizer 里那条硬断言
# 提前到上 GPU 之前：C 少了几层不会报错，只会让惩罚静默变小
from kres.covariance import load_covariance_payload, target_names_from_linears
from kres.regularizer import canonical_name
from litgpt.model import GPT

with torch.device("meta"):
    model = GPT(cfg)
linear_names = [canonical_name(n) for n, m in model.named_modules() if isinstance(m, torch.nn.Linear)]
targets = set(target_names_from_linears(linear_names, cfg.n_layer, False))

payload = load_covariance_payload(cov_path)
cov_keys = set(payload["covariances"])
meta = payload.get("metadata", {})
print(f"C       {cov_path.name}: {len(cov_keys)} 层，模型目标层 {len(targets)} 层"
      f"（tokens={meta.get('tokens', '?')}, dtype={meta.get('forward_dtype', '?')}）")
if cov_keys != targets:
    raise SystemExit(
        f"C 的键集与模型目标层对不上。\n"
        f"  C 有模型没有: {sorted(cov_keys - targets)[:5]}\n"
        f"  模型有 C 没有: {sorted(targets - cov_keys)[:5]}\n"
        f"采 C 时的 --include-lm-head 必须与训练时的 --kres.include_lm_head 一致"
    )
print("        键集双向一致")
PY

# 临时 plan。正式的要三段齐了才能生成，这里只描述本次冒烟
python - "${SMOKE_PLAN}" "${DATA_DIR}" "${MAX_TOKENS}" <<'PY'
import json
import sys
from pathlib import Path

out, data_dir, max_tokens = Path(sys.argv[1]), sys.argv[2], int(sys.argv[3])
# 只有 no_replay 一条臂：冒烟要量的是成本与梯度尺度，这两项与 replay 无关，而 C 臂
# 本身就是零重放的，正好是要标定 λ 的那条
plan = {
    "_note": "02_smoke_pretrain.pbs 自动生成，只供本次冒烟，不要用于正式训练",
    "segments": [],
    "arms": [{
        "name": "smoke", "segments": [], "replay_dirs": [], "cov_dirs": [],
        "replay_tokens": 0, "new_tokens": max_tokens, "train_max_tokens": max_tokens,
    }],
}
out.write_text(json.dumps(plan, ensure_ascii=False, indent=2), encoding="utf-8")
print(f"plan    {out}（no_replay，预算 {max_tokens:,} token）")
PY

for MB in ${MICRO_BATCHES}; do
  if (( GLOBAL_BATCH % MB != 0 )); then
    echo "FAILED: global_batch=${GLOBAL_BATCH} 不能被 micro_batch=${MB} 整除"; exit 1
  fi
  echo "  micro_batch=${MB} -> grad_accum=$(( GLOBAL_BATCH / MB ))"
done

if [[ "${PREFLIGHT_ONLY}" == "1" ]]; then
  echo "PREFLIGHT_ONLY=1：只做前置检查，不上 GPU。"
  echo "Job finished at: $(date)"
  exit 0
fi

# ===========================================================================
# Step 1: run 矩阵
# ===========================================================================
run_one () {
  local tag="$1" mb="$2" use_cov="$3" resume="$4"
  local out="${OUT_ROOT}/${tag}"
  local log="${LOG_DIR}/${tag}.log"
  mkdir -p "${out}"

  # `python -m litgpt` 而不是 `litgpt`：后者是 pip 装的 console script，只有它没被
  # 装上（或 venv 的 bin 不在 PATH 上）时，四个 run 会各自以 command not found 秒挂，
  # 日志里空空如也。前面的 preflight 验的是 `import litgpt` 能不能成，与这个是两回事
  local -a cmd=(
    python -m litgpt pretrain "$(basename "${MODEL_DIR}")"
    --out_dir "${out}"
    --data kres.replay_data.ReplayMixedData
    --data.plan_path "${SMOKE_PLAN}"
    --data.arm smoke
    --data.new_data_path "${DATA_DIR}"
    --data.val_data_path "${VAL_DIR}"
    --data.num_workers "${NUM_WORKERS}"
    --data.seed "${SEED}"
    --train.global_batch_size "${GLOBAL_BATCH}"
    --train.micro_batch_size "${mb}"
    --train.max_tokens "${MAX_TOKENS}"
    --train.max_norm 1.0
    --train.lr_schedule wsd
    --train.lr_cooldown_fraction 0.2
    --train.lr_warmup_steps "${WARMUP_STEPS}"
    --train.min_lr "${MIN_LR}"
    --train.save_interval "$(( STEPS / 2 ))"
    --train.log_interval 1
    --optimizer "${OPTIMIZER_JSON}"
    --eval.interval 1000000
    --eval.initial_validation false
    --eval.final_validation false
    --logger_name csv
    --seed "${SEED}"
    --kres.profile true
    --kres.log_grad_norms true
  )
  # --resume 与 --initial_checkpoint_dir 在 validate_args 里互斥，所以两条路只能走一条
  if [[ -n "${resume}" ]]; then
    cmd+=(--resume "${resume}")
  else
    cmd+=(--initial_checkpoint_dir "${MODEL_DIR}")
  fi
  if [[ "${use_cov}" == "1" ]]; then
    cmd+=(
      --kres.cov_path "${COV_PATH}"
      --kres.replay_lambda "${LAMBDA_PROBE}"
      # 续跑段模型权重已漂移，W₀ 只能从基座文件读；首段给了也无害（走的是快照+逐比特验证）
      --kres.base_checkpoint "${MODEL_DIR}/lit_model.pth"
      --kres.inject_before_clip true
    )
  fi

  echo ""
  echo "------------------------------------------------------------------------"
  echo "RUN ${tag}: micro_batch=${mb} grad_accum=$(( GLOBAL_BATCH / mb )) cov=${use_cov}${resume:+ resume}"
  echo "  ${cmd[*]}"
  echo "------------------------------------------------------------------------"
  # OOM 与其它失败要区别对待。OOM 本身就是这次要测的结论之一（micro_batch 太大），
  # 记下来继续测下一档；其它失败几乎一定是配置问题，而四个 run 用的是同一套配置，
  # 继续跑只是把同一个错误重复三遍、再用一屏「?」把它盖掉——第一版就是这么丢掉现场的。
  # 所以非 OOM 立刻停，并把日志尾巴打到 stdout（PBS 的 .o 文件里就能直接看到原因）。
  fd_report
  if "${cmd[@]}" 2>&1 | tee "${log}"; then
    echo "RUN ${tag}: ok"
    fd_report
  elif grep -q "CUDA out of memory" "${log}"; then
    echo "RUN ${tag}: OOM —— 这一档装不下，本身就是结论，继续下一档"
    fd_report
  elif grep -q "Too many open files" "${log}"; then
    # 与配置错误分开处理：这个不是「配置写错了」，是句柄耗尽，而节点是共享的，
    # 换个时间跑可能就过了。停下来同样是对的（后面的 run 只会更缺句柄），但要
    # 说清楚该看什么，别让人去翻配置
    echo ""
    echo "RUN ${tag}: 文件句柄耗尽（errno 23 = ENFILE，全系统的 file table 满了，"
    echo "  不是本进程的 ulimit）。对照上面每个 run 前后的 fd: 行——"
    echo "  file-nr 第一列随 run 单调涨 = 我们自己在漏，降 NUM_WORKERS（当前"
    echo "  ${NUM_WORKERS}）或减少并发的流数；一开始就很高 = 节点上别的作业占的，换个时间重投。"
    fd_report
    echo "日志：${log}"
    echo "---- 最后 40 行 ----"
    tail -40 "${log}"
    exit 1
  else
    echo ""
    echo "RUN ${tag}: 非 OOM 失败，后面几个 run 是同一套配置只会同样失败，就此停下。"
    echo "日志：${log}（不在 JOB_TMPDIR 里，作业结束后仍在）"
    echo "---- 最后 40 行 ----"
    tail -40 "${log}"
    exit 1
  fi
}

for MB in ${MICRO_BATCHES}; do
  [[ "${DO_BASELINE}" == "1" ]] && run_one "mb${MB}_base" "${MB}" 0 ""
  run_one "mb${MB}_reg" "${MB}" 1 ""
done

# ===========================================================================
# Step 2: 续跑验证
#   6 小时 walltime 下单臂要续 4~5 次，而续跑段有一条只在真续跑里才走得到的逻辑：
#   --resume 与 --initial_checkpoint_dir 互斥，所以续跑段不执行 load_raw，模型权重
#   来自检查点、已经漂移。这时若还从模型上快照 W₀，惩罚就从「留在基座附近」变成
#   「留在当下别动」——λ 越大越像是学不动，而不是遗忘更少。自测里用的是构造出来的
#   漂移权重，这里是第一次在真检查点上验。
# ===========================================================================
if [[ "${DO_RESUME}" == "1" ]]; then
  FIRST_MB="${MICRO_BATCHES%% *}"
  CKPT_DIR="${OUT_ROOT}/mb${FIRST_MB}_reg"
  LAST_CKPT="$(find "${CKPT_DIR}" -maxdepth 1 -type d -name 'step-*' | sort | head -1 || true)"
  if [[ -n "${LAST_CKPT}" && -f "${LAST_CKPT}/lit_model.pth" ]]; then
    echo ""
    echo "==== Step 2: 从 ${LAST_CKPT} 续跑 ===="
    run_one "mb${FIRST_MB}_resume" "${FIRST_MB}" 1 "${LAST_CKPT}/lit_model.pth"
  else
    echo ""
    echo "==== Step 2: 跳过续跑验证 ===="
    echo "  ${CKPT_DIR} 下没有 step-* 检查点。save_interval=$(( STEPS / 2 ))，"
    echo "  说明那个 run 没跑到一半就失败了，先看它的日志。"
  fi
fi

# ===========================================================================
# Step 3: 汇总
# ===========================================================================
echo ""
echo "==== Step 3: 汇总 ===="
python - "${LOG_DIR}" "${GLOBAL_BATCH}" "${SEQ_LEN}" "${LAMBDA_PROBE}" "${DATA_DIR}" <<'PY'
import re
import sys
from pathlib import Path

import torch

log_dir, gbs, seq_len, lam, data_dir = Path(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3]), float(sys.argv[4]), sys.argv[5]
total_gb = torch.cuda.get_device_properties(0).total_memory / 1024**3

RE_MEM = re.compile(r"peak GPU memory\s+:\s+([\d.]+) GiB allocated")
# 判余量必须看 reserved 而不是 allocated：OOM 发生在 allocator 向驱动要不到新段的时候，
# 而 reserved 是它已经占住的量。两者的差就是碎片，本项目实测约 8 GiB（差 6 个百分点），
# 按 allocated 判会把一个 83% 的档位报成 78%
RE_MEM_RES = re.compile(r"peak GPU memory\s+:\s+[\d.]+ GiB allocated / ([\d.]+) GiB reserved")
RE_STEP = re.compile(r"per-step time\s+:\s+([\d.]+) ms")
RE_TPS = re.compile(r"throughput\s+:\s+([\d.]+) tokens/s")
RE_TRAIN = re.compile(
    r"\| R: ([\d.eE+-]+) \|g_lm\|: ([\d.]+|nan) \|g_reg\|: ([\d.eE+-]+) clip: (\d+)%/(\d+)%"
)
# 基线臂没有 R 和 |g_reg|，日志里是「| |g_lm|: ... clip: ...」。两条正则互斥：
# 正则臂那行 |g_lm| 前面是「| R:」，不会出现管道-空格-管道的形状
RE_CLIP_BASE = re.compile(r"\| \|g_lm\|: ([\d.]+|nan) clip: (\d+)%/(\d+)%")
RE_ACCUM = re.compile(r"grad_accum\s+:\s+(\d+)")

runs = {}
for log in sorted(log_dir.glob("*.log")):
    text = log.read_text(encoding="utf-8", errors="replace")
    trains = RE_TRAIN.findall(text)
    bases = RE_CLIP_BASE.findall(text)
    runs[log.stem] = {
        "mem": float(m.group(1)) if (m := RE_MEM.search(text)) else None,
        "mem_res": float(m.group(1)) if (m := RE_MEM_RES.search(text)) else None,
        "ms": float(m.group(1)) if (m := RE_STEP.search(text)) else None,
        "tps": float(m.group(1)) if (m := RE_TPS.search(text)) else None,
        "accum": int(m.group(1)) if (m := RE_ACCUM.search(text)) else None,
        # 取最后一条：ΔW 随训练增长，最后一条的漂移最接近真实情形
        "last": trains[-1] if trains else None,
        "last_base": bases[-1] if bases else None,
        "n_train_lines": len(trains),
        "oom": "CUDA out of memory" in text,
    }

print(f"GPU 总显存 {total_gb:.0f} GiB\n")
print(f"{'run':<18}{'accum':>6}{'allocated':>12}{'reserved':>12}{'占比':>7}{'per-step':>11}{'tokens/s':>12}")
print("-" * 80)
for name, r in runs.items():
    if r["oom"]:
        print(f"{name:<18}{'':>6}{'OOM':>12}")
        continue
    mem = f"{r['mem']:.1f} GiB" if r["mem"] else "?"
    res = f"{r['mem_res']:.1f} GiB" if r["mem_res"] else "?"
    # 占比按 reserved 算——那才是决定会不会 OOM 的量
    pct = f"{r['mem_res'] / total_gb:.0%}" if r["mem_res"] else "?"
    ms = f"{r['ms']:.0f} ms" if r["ms"] else "?"
    tps = f"{r['tps']:,.0f}" if r["tps"] else "?"
    print(f"{name:<18}{r['accum'] or '?':>6}{mem:>12}{res:>12}{pct:>7}{ms:>11}{tps:>12}")
print("\n占比一列按 reserved 算：OOM 是 allocator 向驱动要不到新段，而不是张量总量超标。")

# ---- micro_batch 建议 ----
print("\n---- micro_batch ----")
ok = {n: r for n, r in runs.items() if n.endswith("_reg") and not r["oom"] and r["mem_res"] and r["tps"]}
if ok:
    # 留两成余量：这里量到的是本次配置的峰值，不含后续可能加的东西（训练中开 val、
    # 更长的 eval batch），也不含跨节点时 NCCL 的通信缓冲。贴着上限跑，OOM 会发生
    # 在第 4 小时而不是第 1 分钟
    safe = {n: r for n, r in ok.items() if r["mem_res"] < 0.8 * total_gb}
    if safe:
        best = max(safe, key=lambda n: safe[n]["tps"])
        print(f"建议 {best}：reserved {safe[best]['mem_res']:.1f} GiB"
              f"（{safe[best]['mem_res'] / total_gb:.0%}），{safe[best]['tps']:,.0f} tokens/s")
        if len(ok) > 1:
            other = [n for n in ok if n != best]
            for n in other:
                d = (safe[best]["tps"] / ok[n]["tps"] - 1) if ok[n]["tps"] else 0
                print(f"  对比 {n}：reserved {ok[n]['mem_res']:.1f} GiB，慢 {-d:.0%}" if d < 0
                      else f"  对比 {n}：reserved {ok[n]['mem_res']:.1f} GiB，快的那个多 {d:.0%} 吞吐")
    else:
        over = min(ok, key=lambda n: ok[n]["mem_res"])
        print(f"所有档位的 reserved 都超过 {0.8 * total_gb:.0f} GiB 的安全线"
              f"（最低的是 {over} 的 {ok[over]['mem_res']:.1f} GiB）。")
        print("能跑完不等于安全：这次没 OOM，换一批长文档或者中途开一次 val 就可能炸。")
        print("往下降一档 micro_batch 再测；吞吐的损失通常远小于显存的下降。")
else:
    print("没有可用的正则 run，看上面的日志")

# ---- 裁剪触发率与 λ ----
print("\n---- 裁剪触发率与 λ 标定 ----")
print("clip 两个数：累计率 / 最后一个 log 区间内的率。累计率会把 warmup 的暂态一直")
print("摊进后面，只看它分不清裁剪是开头几步的事还是全程都在发生。\n")

# 基线臂的触发率是底噪：loss spike 本来就会把范数顶过 max_norm，不减掉它，
# 正则臂那个百分比说明不了任何事
base_rate = None
for name, r in runs.items():
    if not r["last_base"]:
        continue
    g_lm, clip, clip_w = float(r["last_base"][0]), int(r["last_base"][1]), int(r["last_base"][2])
    base_rate = clip if base_rate is None else max(base_rate, clip)
    print(f"{name}（基线，无惩罚）：|g_lm|={g_lm:.3f}  clip={clip}%/{clip_w}%")
if base_rate is None:
    print("（没有基线 run 的裁剪数据，正则臂的触发率无从归因——基线 run 要带 "
          "--kres.log_grad_norms true）")

for name, r in runs.items():
    if not r["last"]:
        continue
    R, g_lm, g_reg, clip, clip_w = r["last"]
    g_lm, g_reg, clip, clip_w = float(g_lm), float(g_reg), int(clip), int(clip_w)
    print(f"\n{name}（最后一条，共 {r['n_train_lines']} 条日志）：")
    print(f"  R={float(R):.3e}  |g_lm|={g_lm:.3f}  |g_reg|={g_reg:.3e}（λ={lam}）  clip={clip}%/{clip_w}%")
    excess = None if base_rate is None else clip - base_rate
    if excess is not None:
        print(f"  减去基线 {base_rate}% 后，归因到惩罚的触发 ≈ {excess}%")
    if clip == 0:
        print("  → 裁剪一次都没触发：--kres.inject_before_clip 放哪边完全等价，")
        print("    论文里那段关于注入点的讨论可以删掉。")
    elif excess is not None and excess <= 2:
        print("  → 触发率与基线持平：裁剪是 loss spike 引起的，不是惩罚推上去的。")
        print("    各臂的裁剪行为可比，λ 的语义没有被裁剪扭曲。")
    else:
        print(f"  → 裁剪触发 {clip}%：注入点的选择有实际影响，保持 inject_before_clip=true")
        print("    （裁剪对整个梯度做同一个标量缩放，先注入才能精确保住 LM 与惩罚的比例）")
        print("    但触发率明显高于基线时还有个更麻烦的后果：惩罚把总范数顶过 max_norm，")
        print("    整个梯度被按比例缩小，等于学新域的那部分也一起被压掉了。C 臂会在遗忘上")
        print("    好看、在新域上难看，而原因是裁剪伪影不是方法本身。调小 λ 或抬 max_norm。")
    if g_reg > 0 and g_lm > 0:
        # |g_reg| 里已经乘过 λ（full_covariance_grad_ 的 scale=λ/层数），别再乘一次
        ratio = g_reg / g_lm
        print(f"  惩罚/LM 梯度比 = {ratio:.3f}（λ={lam} 时）")
        print("  注入梯度对 λ 线性，所以要让这个比值等于 ρ：")
        for rho in (0.03, 0.1, 0.3):
            print(f"      ρ={rho:<5} → λ ≈ {lam * rho / ratio:.3g}")
        print("  这是最后一步的瞬时值，不是稳态值。ΔW 还在涨，比值会继续上升，直到惩罚")
        print("  梯度与任务梯度平衡。短 run 标出来的 λ 偏大，正式跑要往下留余量。")
    else:
        print("  |g_reg| 是 0：ΔW 还没长起来（步数太少或 LR 太低），λ 标不出来")

print("""
  ⚠ 这组 λ 只是量级下界，不能直接拿去跑正式实验。惩罚梯度正比于 ΔW，而冒烟只跑了
    几十步、漂移远小于正式训练的几千步，所以据此反算的 λ 偏大。
    正式的做法：baseline（No Replay）臂本来就要跑，跑完拿它终态的 ΔW 反算 λ，
    零额外成本且用的是真实漂移量。""")
# 这条只在真的没用新域数据时才响。无条件打印的话它会变成每次都在的固定噪音，
# 而固定噪音是不会被读的
if "biomed" not in data_dir.lower():
    print(f"""
  ⚠⚠ 数据源是 {data_dir}，不是新域。在基座见过的分布上训，ΔW 比在新域上小得多，
     上面这组 λ 的偏差比正常情况还要大一截，只能当数量级看。显存与吞吐两项不受影响。""")

# ---- 正式作业的耗时投影 ----
print("\n---- 正式作业耗时投影 ----")
base = next((r for n, r in runs.items() if n.endswith("_base") and r["tps"]), None)
reg = next((r for n, r in runs.items() if n.endswith("_reg") and r["tps"]), None)
if base and reg:
    print(f"正则开销：{base['tps'] / reg['tps'] - 1:+.1%} 吞吐（{base['tps']:,.0f} → {reg['tps']:,.0f} tokens/s）")
for label, tokens, r in [
    ("No Replay (8B)", 8e9, base), ("协方差正则 (8B)", 8e9, reg),
    ("Replay 1B (9B)", 9e9, base), ("Replay 4B (12B)", 12e9, base), ("Replay 8B (16B)", 16e9, base),
]:
    if not r or not r["tps"]:
        continue
    h = tokens / r["tps"] / 3600
    print(f"  {label:<20}{h:>6.1f} h   walltime 建议 {max(2, int(h * 1.3) + 1)}:00:00"
          f"（6h 一段则 {-(-h // 6):.0f} 段）")

# ---- 续跑 ----
print("\n---- 续跑 ----")
res = next((r for n, r in runs.items() if n.endswith("_resume")), None)
if res is None:
    print("没跑（DO_RESUME=0 或前一个 run 没产出检查点）")
elif res["oom"] or not res["last"]:
    print("续跑 run 没能跑起来，看它的日志")
else:
    print(f"续跑跑出了 {res['n_train_lines']} 条训练日志，最后 |g_lm|={res['last'][1]}")
    print("还要人工确认日志里这两行：")
    print("  1) 'kres: ... W₀来源=基座文件（续跑）'  ——不是「模型快照」")
    print("  2) '数据流（臂 smoke）计划 … 实际 …'    ——实际量应当接上而不是从 0 重来")
PY

echo ""
echo "========================================================================"
echo "冒烟结束。产物（垃圾 checkpoint）随 JOB_TMPDIR 一起删除。"
echo "按上面的结论改两处："
echo "  1) 各正式 PBS 里的 --train.micro_batch_size"
echo "  2) λ 先按投影的量级准备，正式值等 baseline 臂跑完再反算"
echo "Job finished at: $(date)"
